---
// The Joner shop front (Lee, 9 Nov 2026): four doors as expanding panels (option D + T1), each its own shop. Apparel is the Shopify
// store at shop.jonerfootball.com (the one apparel store, Lee 9 Nov 2026); books, programs and training resources keep their own pages (the scanning
// app will take over Training resources).
import BaseLayout from '../layouts/BaseLayout.astro'
import ProductCard from '../components/shop/ProductCard.astro'
import ShopPanels, { type ShopDoor } from '../components/shop/ShopPanels.astro'
import { getShopProducts } from '../lib/shopify'
import '../styles/shop-store.css'

const doors: ShopDoor[] = [
  { href: 'https://shop.jonerfootball.com/', label: 'Apparel', sub: 'Tees, tanks, shorts and caps', img: '/images/shop/apparel/20-urban-court.webp', pos: 'center 25%' },
  { href: '/books', label: 'Books', sub: 'Joner Football Presents', img: '/images/shop/books/joner-football-greatest-goal-scorers-preorder.jpg' },
  { href: '/shop/training-programs', label: 'Training programs', sub: 'Follow a plan at home', img: '/images/shop/shop-training.webp', pos: '70% center' },
  { href: '/shop/resources-accessories', label: 'Training resources', sub: 'Tools for players and coaches', img: '/images/shop/resources-accessories/scanning-training-tool.webp' },
]
const best = (await getShopProducts()).filter((p) => p.available).slice(0, 4)

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Joner Football Shop',
  description: 'The Joner Football shop: apparel, books, training programs and training resources.',
  url: 'https://jonerfootball.com/shop',
}

import SanityPageRenderer from '../components/sanity/SanityPageRenderer.astro'
import { fetchSanityPage } from '../lib/sanityPages'
import { shouldReplaceSanityPage } from '../lib/sanityPageUtils'

const sanityPage = await fetchSanityPage('shop')
---

{shouldReplaceSanityPage(sanityPage) ? (
  <SanityPageRenderer page={sanityPage} />
) : (
<BaseLayout
  title="Shop | Joner Football"
  description="The Joner Football shop: apparel, books, training programs and training resources."
  schema={schema}
>
  <main class="st">
    <h1 class="st-front-title">Joner Shop</h1>
    <ShopPanels doors={doors} />

    {best.length > 0 && (
      <section class="st-wrap" aria-labelledby="st-best">
        <div class="st-head">
          <h2 id="st-best" class="st-title">Best sellers</h2>
          <a href="https://shop.jonerfootball.com/" class="st-all">Shop all apparel</a>
        </div>
        <div class="st-grid">
          {best.map((p, i) => <ProductCard product={p} eager={i < 2} />)}
        </div>
      </section>
    )}
    <p class="st-trust">Secure checkout by Shopify</p>
  </main>
</BaseLayout>
)}
