---
// The Joner shop front (Lee, 9 Nov 2026): four doors, each its own shop. Apparel is the Shopify
// store at /shop/apparel; books, programs and training resources keep their own pages (the scanning
// app will take over Training resources). Built to become shop.jonerfootball.com later.
import BaseLayout from '../layouts/BaseLayout.astro'
import ShopKit from '../components/shop/ShopKit.astro'
import ProductCard from '../components/shop/ProductCard.astro'
import { getShopProducts } from '../lib/shopify'
import '../styles/shop-store.css'

const doors = [
  { href: '/shop/apparel', label: 'Apparel', img: '/images/shop/apparel/20-urban-court.webp', pos: 'center 30%' },
  { href: '/books', label: 'Books', img: '/images/shop/books/joner-football-greatest-goal-scorers-preorder.jpg', pos: 'center' },
  { href: '/shop/training-programs', label: 'Training programs', img: '/images/shop/shop-training.webp', pos: 'center' },
  { href: '/shop/resources-accessories', label: 'Training resources', img: '/images/shop/resources-accessories/scanning-training-tool.webp', pos: 'center' },
]
const best = (await getShopProducts()).filter((p) => p.available).slice(0, 4)

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Joner Football Shop',
  description: 'The Joner Football shop: apparel, books, training programs and training resources.',
  url: 'https://jonerfootball.com/shop',
}

import SanityPageRenderer from '../components/sanity/SanityPageRenderer.astro'
import { fetchSanityPage } from '../lib/sanityPages'
import { shouldReplaceSanityPage } from '../lib/sanityPageUtils'

const sanityPage = await fetchSanityPage('shop')
---

{shouldReplaceSanityPage(sanityPage) ? (
  <SanityPageRenderer page={sanityPage} />
) : (
<BaseLayout
  title="Shop | Joner Football"
  description="The Joner Football shop: apparel, books, training programs and training resources."
  schema={schema}
>
  <main class="st">
    <h1 class="st-front-title">Joner Shop</h1>
    <nav class="st-hero st-four" aria-label="Shops">
      {doors.map((d, i) => (
        <a href={d.href} class="st-tile">
          <img src={d.img} alt="" style={`object-position: ${d.pos}`} loading="eager" />
          <span class="st-tile-text">
            <span class="st-tile-label">{d.label}</span>
            <span class="st-tile-cta">Shop now</span>
          </span>
        </a>
      ))}
    </nav>

    {best.length > 0 && (
      <section class="st-wrap" aria-labelledby="st-best">
        <div class="st-head">
          <h2 id="st-best" class="st-title">Best sellers</h2>
          <a href="/shop/apparel" class="st-all">Shop all apparel</a>
        </div>
        <div class="st-grid">
          {best.map((p, i) => <ProductCard product={p} eager={i < 2} />)}
        </div>
      </section>
    )}
    <p class="st-trust">Secure checkout by Shopify</p>
  </main>
  {best.length > 0 && <ShopKit />}
</BaseLayout>
)}
