---
import BaseLayout from '../layouts/BaseLayout.astro'
import SEOFAQ from '../components/SEOFAQ.astro'
import { oneToOneFaq } from '../data/jfp-one-to-one.js'
import GeoAnswers from '../components/GeoAnswers.astro'
import { faqSchema, webPageSchema, breadcrumbSchema } from '../lib/seoSchema'



const trainingVideos = [
  {
    title: 'Training In Our Facility',
    id: 'eCmL9QiFtVk',
    start: 11,
  },
  {
    title: 'On Field Training',
    id: '-V88Iy1X-is',
    start: 466,
  },
  {
    title: 'Position Specific Training',
    id: 'l5__i4F-l_I',
    start: 0,
  },
  {
    title: 'Group Training HQ',
    id: 'ns7I4SzidyQ',
    start: 0,
  },
]

const trainingPrograms = [
  {
    label: 'JFP',
    title: 'JFP Program',
    subtitle: 'Small-group player development, ages 8+',
    href: '/training/jfp-program',
    circleImage: '/images/training/lee-coaching-action.webp',
    cardImage: '/images/training/lee-coaching-action.webp',
  },
  {
    label: 'PRO',
    title: 'Professional Training',
    subtitle: 'Elite detail for serious players',
    href: '/training/professional-training',
    circleImage: '/images/contact/lee-coaching-landscape.webp',
    cardImage: '/images/contact/lee-coaching-landscape.webp',
  },
  {
    label: 'JUNIORS',
    title: 'Joners Juniors',
    navLabel: 'Juniors',
    subtitle: 'Younger players building strong habits',
    href: '/jonersjuniors/',
    circleImage: '/images/training/joners-juniors-wheel.jpg',
    cardImage: '/images/training/joners-juniors-wheel.jpg',
  },
  {
    label: 'APP',
    title: 'JF App',
    subtitle: 'Train anywhere with the Joner Football App',
    href: '/app/',
    circleImage: '/images/training/jf-app-wheel.jpg',
    cardImage: '/images/training/jf-app-card-landscape.jpg',
  },
  {
    label: 'HQ',
    title: 'The HQ',
    subtitle: 'Indoor training facility in Belrose',
    href: '/hq/',
    circleImage: '/images/training/hq-wheel.jpg',
    cardImage: '/images/training/hq-wheel.jpg',
  },
  {
    label: 'GAME ANALYSIS',
    title: 'Game Analysis',
    subtitle: "Detailed feedback on a player's game",
    href: '/training/game-analysis',
    circleImage: '/images/training/jf-game-analysis-generated.jpg',
    cardImage: '/images/training/jf-game-analysis-generated.jpg',
  },
]

const localBizSchema = {
  "@context": "https://schema.org",
  "@type": "SportsActivityLocation",
  "name": "Joner Football HQ",
  "description": "Joner Football's Sydney training base in Belrose. Indoor football training facility for JFP small-group coaching, professional training, Joners Juniors and game analysis.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Unit 2, 20 Narabang Way",
    "addressLocality": "Belrose",
    "addressRegion": "NSW",
    "postalCode": "2085",
    "addressCountry": "AU"
  },
  "telephone": "+61-426-885-924",
  "url": "https://jonerfootball.com/hq/",
  "parentOrganization": {
    "@type": "Organization",
    "@id": "https://jonerfootball.com/#organization",
    "name": "Joner Football"
  },
  "openingHours": "Mo-Sa",
  "priceRange": "$$"
}


const trainingSEOFAQs = [
  { q: 'Where is Joner Football training based?', a: 'Joner Football training is based around The HQ in Belrose, Sydney, with programs for players who want sharper technique and clearer coaching.' },
  { q: 'What football training programs are available?', a: 'Training options include JFP, professional training, Joners Juniors, game analysis, app training and other development pathways.' },
  { q: 'What ages can train with Joner Football in Sydney?', a: 'JFP small-group training starts from age 8, Joners Juniors covers younger players building first habits, and professional training supports serious teenage and senior players.' },
  { q: 'Can younger players train at Joner Football?', a: 'Yes. Joners Juniors and JFP give younger players a strong foundation with clear standards, better habits and coach-led technical work.' },
  oneToOneFaq,
  { q: 'How do I book Sydney football training?', a: 'Send the training enquiry form on this page with your player age and goals. The Joner Football team replies with the right pathway and available session times.' },
]

const trainingSchemas = [
  localBizSchema,
  webPageSchema({
    name: 'Sydney Football Training | Elite Coaching & Player Development',
    description: 'Train with Joner Football in Sydney. Improve technique, confidence and game impact through JFP, pro training, juniors and specialist coaching.',
    url: 'https://jonerfootball.com/training/',
  }),
  breadcrumbSchema([
    { name: 'Home', url: 'https://jonerfootball.com/' },
    { name: 'Sydney Football Training', url: 'https://jonerfootball.com/training/' },
  ]),
  faqSchema(trainingSEOFAQs),
]


import SanityPageRenderer from '../components/sanity/SanityPageRenderer.astro'
import BookNowButton from '../components/BookNowButton.astro'
import BookNowPanel from '../components/BookNowPanel.astro'
import { fetchSanityPage } from '../lib/sanityPages'
import { shouldReplaceSanityPage } from '../lib/sanityPageUtils'

const sanityPage = await fetchSanityPage('training')
import StickyMobileCta from '../components/StickyMobileCta.astro'
import { BOOKING_URL } from '../lib/booking'

// Redesign (Oct 2026): same content, links and enquiry form as before, in the
// newer site style (game analysis, reviews): full photo hero, black and white
// sections, italic display headings, square cards, Option C buttons.
const journey = [
  { id: 'joners-juniors', stage: 'Stage 1', title: 'Joners Juniors', copy: 'Foundation habits', href: '/jonersjuniors/', image: '/images/training/joners-juniors-wheel.jpg', alt: 'Joners Juniors training' },
  { stage: 'Flagship', title: 'JFP Program', copy: 'Small-group development', href: '/training/jfp-program', image: '/images/training/lee-coaching-action.webp', alt: 'Joner Football Performance training', main: true },
  { stage: 'Next level', title: 'Analysis & Feedback', copy: 'Clearer player decisions', href: '/training/game-analysis', image: '/images/training/jf-game-analysis-generated.jpg', alt: 'Joner Football game analysis' },
]
const inputClass = 'tr-input'
---

{shouldReplaceSanityPage(sanityPage) ? (
  <SanityPageRenderer page={sanityPage} />
) : (
<BaseLayout
  title="Sydney Football Training | Elite Coaching & Player Development"
  description="Train with Joner Football in Sydney. Improve technique, confidence and game impact through JFP, pro training, juniors and specialist coaching."
  schema={trainingSchemas}
  hideMobileAppCta={true}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/contact/lee-coaching-landscape.webp" fetchpriority="high" />
  </Fragment>

  <div class="tr-page">
    <!-- Hero -->
    <section class="tr-hero">
      <img class="tr-hero-img" src="/images/contact/lee-coaching-landscape.webp" alt="Lee Jones coaching at Joner Football" fetchpriority="high" />
      <div class="tr-hero-shade" aria-hidden="true"></div>
      <div class="tr-wrap tr-hero-content">
        <div class="tr-hero-copy">
          <p class="tr-eyebrow">Sydney training hub</p>
          <h1 class="tr-h1">Find the right <span class="tr-hook">training.</span></h1>
          <div class="tr-hero-cta">
            <BookNowButton size="lg" place="training-hero" />
            <a href="#choose-path" class="btn-outline">Compare programs</a>
          </div>
        </div>

      <div class="training-orbit mx-auto" aria-label="Joner Football training pathway wheel">
        <div class="training-orbit__ring" aria-hidden="true"></div>
        <div class="training-orbit__spin">
          {trainingPrograms.map((program, index) => (
            <a
              href={program.href}
              class={`training-orbit__node training-orbit__node--${index + 1}`}
              aria-label={`Open ${program.title}`}
            >
              <span class="training-orbit__node-content">
                <img src={program.circleImage} alt="" aria-hidden="true" class={`training-orbit__node-photo ${program.imageClass || ''}`} loading="lazy" />
                <span class="training-orbit__node-label">{program.label}</span>
                <span class="training-orbit__tooltip">{program.title}<small>{program.subtitle}</small></span>
              </span>
            </a>
          ))}
        </div>
        <div class="training-orbit__center">
          <img src="/images/joner-logo-white.png" alt="Joner Football" />
        </div>
      </div>
      </div>
    </section>

    <!-- Choose your training -->
    <section id="choose-path" class="tr-choose scroll-mt-24" aria-labelledby="training-next-step-title">
      <div class="tr-wrap">
        <p class="tr-kicker">What we offer</p>
        <h2 id="training-next-step-title" class="tr-h2">Choose your training.</h2>
        <div class="tr-cards" aria-label="Choose your Joner Football training path">
          {trainingPrograms.map((program) => (
            <a id={program.label === 'PRO' ? 'pro-training' : undefined} href={program.href} class="tr-card scroll-mt-24" aria-label={`View ${program.title}`}>
              <span class="tr-card-photo">
                <img src={program.cardImage || program.circleImage} alt="" aria-hidden="true" loading="lazy" />
                <span class="tr-card-badge">{program.label}</span>
              </span>
              <span class="tr-card-body">
                <span class="tr-card-title">{program.title}</span>
                <span class="tr-card-sub">{program.subtitle}</span>
              </span>
              <span class="tr-card-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- JFP pathway -->
    <section id="jfp" class="tr-journey scroll-mt-24" aria-labelledby="jfp-pathway-title">
      <div class="tr-wrap">
        <p class="tr-kicker">JFP pathway</p>
        <h2 id="jfp-pathway-title" class="tr-h2">The journey.</h2>
        <ol class="tr-steps" aria-label="JFP player pathway">
          {journey.map((step, i) => (
            <li>
              <a id={step.id} href={step.href} class:list={['tr-step', 'scroll-mt-24', step.main && 'tr-step--main']}>
                <span class="tr-step-photo"><img src={step.image} alt={step.alt} loading="lazy" /></span>
                <span class="tr-step-body">
                  <span class="tr-n">{String(i + 1).padStart(2, '0')} · {step.stage}</span>
                  <strong>{step.title}</strong>
                  <small>{step.copy}</small>
                </span>
              </a>
            </li>
          ))}
        </ol>
        <nav class="tr-also" aria-label="More training options">
          <a href="/app">JF App</a>
          <a href="/hq">The HQ</a>
          <a href="/training/professional-training">Professional Training</a>
          <a href="/training/game-analysis">Game Analysis</a>
        </nav>

        <BookNowPanel
          class="mt-10 md:mt-14"
          eyebrow="JFP bookings are open"
          heading="Book a spot in JFP"
          text="See the timetable, pick a group and apply for a spot straight away."
          place="training-jfp"
          secondary={{ label: 'More about the JFP program', href: '/training/jfp-program' }}
        />
      </div>
    </section>

    <!-- Training highlight videos -->
    <section class="tr-videos">
      <div class="tr-wrap">
        <p class="tr-kicker">See it in action</p>
        <h2 class="tr-h2">Training highlights.</h2>
        <p class="tr-swipe">Swipe for more</p>
        <div class="tr-video-row">
          {trainingVideos.map((video) => (
            <div class="tr-video">
              <div class="tr-video-frame">
                <iframe
                  srcdoc={`<style>*{padding:0;margin:0;overflow:hidden}html,body{height:100%;background:#0a0a0a}img,span{position:absolute;width:100%;top:0;bottom:0;margin:auto}img{height:100%;object-fit:cover}span{height:1.5em;text-align:center;font:48px/1.5 sans-serif;color:#fff;text-shadow:0 0 0.5em black}</style><a href=https://www.youtube.com/embed/${video.id}?autoplay=1&start=${video.start}><img src=https://img.youtube.com/vi/${video.id}/hqdefault.jpg alt='${video.title}'><span>&#x25BA;</span></a>`}
                  src={`https://www.youtube.com/embed/${video.id}?start=${video.start}`}
                  title={`${video.title}, Joner Football`}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
              <p class="tr-video-title">{video.title}</p>
            </div>
          ))}
        </div>

        <div class="tr-links">
          <a href="/join" class="tr-link">
            <span>Continue your training at home with the Joner Football App</span>
            <strong>Download the App <span aria-hidden="true">→</span></strong>
          </a>
          <a href="/camps/" class="tr-link">
            <span>Take your development further at our global camps</span>
            <strong>View Camps <span aria-hidden="true">→</span></strong>
          </a>
        </div>
      </div>
    </section>

    <!-- Training enquiry form -->
    <section id="jfp-form" class="tr-enquire scroll-mt-32">
      <div class="tr-wrap tr-enquire-layout">
        <div class="tr-enquire-copy">
          <p class="tr-kicker">Enquire</p>
          <h2 class="tr-h2">Start your training enquiry.</h2>
          <p>Tell us what you are looking for and the team will point you to the right Joner Football program.</p>
        </div>

        <form id="contact-smart-form" class="tr-form">
          <div class="tr-field">
            <label for="enquiryType">What can we help with?</label>
            <select id="enquiryType" name="enquiryType" required class={inputClass}>
              <option value="training-sydney">Training Enquiries (Sydney)</option>
              <option value="joners-juniors">Joners Juniors Enquiries</option>
              <option value="general">General Enquiries</option>
            </select>
            <p id="form-intro" class="tr-hint">Tell us about the player and what type of training you are looking for.</p>
          </div>

          <div class="tr-row">
            <input data-name-field type="text" name="name" placeholder="Full name" required aria-label="Your name" class={inputClass} />
            <input type="email" name="email" placeholder="Email address" required aria-label="Email address" class={inputClass} />
          </div>

          <div class="tr-row">
            <input type="tel" name="phone" placeholder="Phone number" required aria-label="Phone number" class={inputClass} />
            <select name="trainingLocation" aria-label="Preferred Sydney location" class={inputClass}>
              <option value="">Preferred Sydney location</option>
              <option>HQ (Belrose)</option>
              <option>North Turramurra</option>
              <option>Rydalmere Park</option>
              <option>Other</option>
            </select>
          </div>

          <div data-fields="training-sydney joners-juniors" class="tr-row">
            <input type="text" name="playerName" placeholder="Player name" aria-label="Player name" class={`conditional-required ${inputClass}`} />
            <input data-player-age-field type="text" name="playerAge" placeholder="Player age" aria-label="Player age" class={`conditional-required ${inputClass}`} />
          </div>

          <div data-fields="training-sydney" class="tr-row">
            <input type="text" name="playerLevel" placeholder="Player level or team" aria-label="Player level or team" class={inputClass} />
            <select name="trainingInterest" aria-label="Training interest" class={inputClass}>
              <option value="">Training interest</option>
              <option>Joner Football Performance</option>
              <option>Professional Training</option>
              <option>Private training</option>
              <option>Group training</option>
              <option>Game analysis</option>
              <option>Not sure yet</option>
            </select>
          </div>

          <div data-fields="joners-juniors" class="tr-row hidden">
            <select name="juniorProgram" aria-label="Program interest" class={inputClass}>
              <option value="">Program interest</option>
              <option>Joners Juniors</option>
              <option>Joner Football Performance pathway</option>
              <option>Not sure yet</option>
            </select>
            <input type="text" name="parentGoal" placeholder="Main goal for the player" aria-label="Main goal for the player" class={inputClass} />
          </div>

          <textarea name="message" placeholder="Message" required rows="5" aria-label="Message" class={`${inputClass} tr-textarea`}></textarea>

          <label class="tr-check">
            <input type="checkbox" name="marketingOptIn" value="true" />
            <span>Yes, send me Joner Football updates, offers, app news, camps, and training tips by email.</span>
          </label>

          <p id="contact-form-status" class="hidden font-body text-sm"></p>
          <button type="submit" class="btn-red tr-submit">Send Training Enquiry</button>
        </form>
      </div>
    </section>

  <script is:inline>
    (function () {
      var options = {
        'training-sydney': {
          intro: 'Tell us about the player and what type of training you are looking for.',
          button: 'Send Training Enquiry'
        },
        'general': {
          intro: 'Ask us anything and the team will point you in the right direction.',
          button: 'Send General Enquiry'
        },
        'joners-juniors': {
          intro: 'For parents enquiring about the Joners Juniors program.',
          button: 'Send Joners Juniors Enquiry'
        }
      };

      var form = document.getElementById('contact-smart-form');
      if (!form) return;
      var typeSelect = form.querySelector('[name="enquiryType"]');
      var intro = document.getElementById('form-intro');
      var submit = form.querySelector('button[type="submit"]');
      var status = document.getElementById('contact-form-status');

      function setStatus(message, ok) {
        if (!status) return;
        status.textContent = message || '';
        status.className = message ? 'font-body text-sm ' + (ok ? 'text-green-400' : 'text-amber-400') : 'hidden font-body text-sm';
      }

      function syncNamePlaceholder() {
        var selected = typeSelect.value || 'training-sydney';
        var nameField = form.querySelector('[data-name-field]');
        var playerAgeField = form.querySelector('[data-player-age-field]');
        if (!nameField) return;
        if (selected !== 'training-sydney') {
          nameField.placeholder = 'Full name';
          return;
        }
        var age = playerAgeField ? parseInt(String(playerAgeField.value || '').replace(/[^0-9]/g, ''), 10) : NaN;
        nameField.placeholder = age >= 18 ? 'Full name' : 'Parent name';
      }

      function syncFields() {
        var selected = typeSelect.value || 'training-sydney';
        var config = options[selected] || options['training-sydney'];
        if (intro) intro.textContent = config.intro;
        if (submit) submit.textContent = config.button;

        form.querySelectorAll('[data-fields]').forEach(function (group) {
          var show = String(group.getAttribute('data-fields') || '').split(' ').indexOf(selected) !== -1;
          group.classList.toggle('hidden', !show);
          group.querySelectorAll('input, select, textarea').forEach(function (field) {
            field.disabled = !show;
            if (field.classList.contains('conditional-required')) field.required = show;
          });
        });
        syncNamePlaceholder();
      }

      typeSelect.addEventListener('change', function () {
        setStatus('', true);
        syncFields();
      });
      var playerAgeField = form.querySelector('[data-player-age-field]');
      if (playerAgeField) playerAgeField.addEventListener('input', syncNamePlaceholder);
      syncFields();

      form.addEventListener('submit', function (event) {
        event.preventDefault();
        setStatus('', true);
        var originalText = submit ? submit.textContent : 'Send Enquiry';
        var formData = new FormData(form);
        var emailInput = form.querySelector('input[name="email"]');

        if (window.JonerEmailGuard && emailInput) {
          var validation = window.JonerEmailGuard.validateEmail(formData.get('email'));
          window.JonerEmailGuard.setFeedback(emailInput, validation);
          if (!validation.valid) {
            emailInput.reportValidity();
            return;
          }
        }

        if (submit) {
          submit.disabled = true;
          submit.textContent = 'Sending...';
          submit.classList.add('opacity-70', 'cursor-not-allowed');
        }

        var payload = {};
        formData.forEach(function (value, key) {
          if (!(value instanceof File)) payload[key] = value;
        });
        if (payload.trainingLocation) payload.location = payload.trainingLocation;
        payload.marketingOptIn = formData.get('marketingOptIn') === 'true';

        var tokenPromise = window.JonerRecaptcha && window.JonerRecaptcha.getToken
          ? window.JonerRecaptcha.getToken('contact')
          : Promise.resolve('');

        tokenPromise.then(function (token) {
          payload.recaptchaToken = token;
          return fetch('/api/contact-enquiry', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
        })
        .then(function (response) { return response.json(); })
        .then(function (data) {
          if (!data || !data.success) throw new Error((data && data.error) || 'Could not send enquiry.');
          form.reset();
          syncFields();
          setStatus('Done. Your enquiry has been sent.', true);
        })
        .catch(function (error) {
          setStatus(error && error.message ? error.message : 'Could not send enquiry. Please try again.', false);
        })
        .finally(function () {
          if (submit) {
            submit.disabled = false;
            submit.textContent = originalText;
            submit.classList.remove('opacity-70', 'cursor-not-allowed');
          }
        });
      });
    })();
  </script>


    <!-- App CTA -->
    <section class="tr-app">
      <div class="tr-wrap tr-app-inner">
        <div>
          <p class="tr-kicker">Anywhere</p>
          <h2 class="tr-h2">Train anywhere, anytime.</h2>
          <p>Supplement your sessions with 1,500+ drills on the Joner Football App.</p>
        </div>
        <a href="/app" class="btn-red tr-app-btn">Try the World's #1 Football App Free</a>
      </div>
    </section>
  </div>

  <GeoAnswers
    title="Sydney football training, explained fast."
    intro="The short version for parents and players looking for football training in Sydney."
    blocks={[
      {
        heading: 'Who this is for',
        body: 'Sydney players from age 8 up and their parents. From juniors building first habits to serious players chasing representative and professional standards.',
      },
      {
        heading: 'What you get',
        body: 'Coach-led technical training at The HQ in Belrose and on field: JFP small-group development, professional training, Joners Juniors and game analysis. Every pathway is built around touch, striking and game impact.',
      },
      {
        heading: 'Why it works',
        body: 'The same coaching detail that built Joner Football a global audience is delivered in person. Small groups, clear standards and technical work players can repeat at home through the app.',
      },
      {
        heading: 'Best next step',
        body: 'Send the training enquiry with your player age and goals. The team replies with the right pathway. Players outside Sydney can train the same way through the Joner Football App.',
      },
    ]}
    links={[
      { label: 'The HQ in Belrose', href: '/hq' },
      { label: 'JFP Program', href: '/training/jfp-program' },
      { label: 'Joners Juniors', href: '/jonersjuniors/' },
      { label: 'Football camps', href: '/camps' },
      { label: 'The football training app', href: '/app' },
    ]}
  />

  <SEOFAQ
    title="Questions about Sydney football training."
    items={trainingSEOFAQs}
  />

  <StickyMobileCta href={BOOKING_URL} label="Book now" />

  <style>
    .tr-page { --jf-red: #E8000D; --font-display: var(--font-heading, Anton, Impact, sans-serif); background: #000; color: #fff; overflow: hidden; }
    .tr-wrap { width: min(1120px, calc(100% - 32px)); margin: 0 auto; }
    .tr-kicker, .tr-eyebrow { margin: 0 0 12px; font-family: var(--font-display); font-style: italic; font-weight: 600; font-size: 13px; letter-spacing: .2em; text-transform: uppercase; color: var(--jf-red); }
    .tr-eyebrow { color: #fff; }
    .tr-h2 { margin: 0; font-family: var(--font-display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: clamp(2.1rem, 5vw, 3.4rem); line-height: 1; }

    /* Hero */
    .tr-hero { position: relative; min-height: 80dvh; display: flex; align-items: center; padding: 72px 0 56px; overflow: hidden; }
    .tr-hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
    .tr-hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.2) 0%, rgba(0,0,0,.12) 40%, rgba(0,0,0,.88) 100%), linear-gradient(90deg, rgba(0,0,0,.7), rgba(0,0,0,0) 70%); }
    .tr-hero-content { position: relative; display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 40px; align-items: center; }
    .tr-hero-copy { min-width: 0; }
    .tr-hero .tr-h1 { font-size: clamp(2.8rem, 7vw, 5.6rem); }

    /* Training wheel (restored from the previous hero, Lee 18 Oct 2026) */
    @keyframes training-orbit-spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    @keyframes training-orbit-counter {
      from { transform: rotate(0deg); }
      to { transform: rotate(-360deg); }
    }

    .training-orbit {
