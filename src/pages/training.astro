    .training-orbit__node--1 { transform: rotate(0deg) translateX(min(31vw, 202px)) rotate(0deg); }
    .training-orbit__node--2 { transform: rotate(60deg) translateX(min(31vw, 202px)) rotate(-60deg); }
    .training-orbit__node--3 { transform: rotate(120deg) translateX(min(31vw, 202px)) rotate(-120deg); }
    .training-orbit__node--4 { transform: rotate(180deg) translateX(min(31vw, 202px)) rotate(-180deg); }
    .training-orbit__node--5 { transform: rotate(240deg) translateX(min(31vw, 202px)) rotate(-240deg); }
    .training-orbit__node--6 { transform: rotate(300deg) translateX(min(31vw, 202px)) rotate(-300deg); }

    .training-orbit__tooltip {
      pointer-events: none;
      position: absolute;
      left: 50%;
      top: calc(100% + 14px);
      z-index: 20;
      width: max-content;
      max-width: 190px;
      transform: translateX(-50%) translateY(6px);
      border: 1px solid rgba(255,255,255,0.2);
