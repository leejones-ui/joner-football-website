---
import BaseLayout from '../layouts/BaseLayout.astro'
import EmailCapture from '../components/EmailCapture.astro'


const trainingPrograms = [
  {
    label: 'JFP',
    title: 'JFP Program',
    subtitle: 'Small-group player development, ages 8+',
    href: '/training/jfp-program',
    circleImage: '/images/training/lee-coaching-action.webp',
  },
  {
    label: 'PRO',
    title: 'Professional Training',
    subtitle: 'Elite detail for serious players',
    href: '/training/professional-training',
    circleImage: '/images/contact/lee-coaching-landscape.webp',
  },
  {
    label: 'JUNIORS',
    title: 'Joners Juniors',
    navLabel: 'Juniors',
    subtitle: 'Younger players building strong habits',
    href: '/training/joners-juniors',
    circleImage: '/images/training/joners-juniors-wheel.jpg',
  },
  {
    label: 'APP',
    title: 'JF App',
    subtitle: 'Train anywhere with the Joner Football App',
    href: '/app',
    circleImage: '/images/training/jf-app-wheel.jpg',
  },
  {
    label: 'HQ',
    title: 'The HQ',
    subtitle: 'Indoor training facility in Belrose',
    href: '/hq',
    circleImage: '/images/training/hq-wheel.jpg',
  },
  {
    label: 'GAME ANALYSIS',
    title: 'Game Analysis',
    subtitle: 'Video review and tactical feedback',
    href: '/training/game-analysis',
    circleImage: '/images/app/app-desktop-mockup.png',
    imageClass: 'training-orbit__node-photo--contain',
  },
]

const localBizSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Joner Football HQ",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Unit 2, 20 Narabang Way",
    "addressLocality": "Belrose",
    "addressRegion": "NSW",
    "postalCode": "2085",
    "addressCountry": "AU"
  },
  "telephone": "+61-426-885-924",
  "url": "https://jonerfootball.com/hq",
  "openingHours": "Mo-Sa",
  "priceRange": "$$"
}
---

<BaseLayout
  title="Sydney Training Programs | Joner Football"
  description="Sydney football training programs at Joner Football. JFP Performance program, professional training, and Joners Juniors. Indoor facility at Belrose. Ages 8+."
  schema={localBizSchema}
>

  <!-- Hero -->
  <section class="relative min-h-[calc(100vh-80px)] w-full overflow-hidden bg-joner-black py-12 sm:py-16 lg:py-20">
    <div class="absolute inset-0">
      <img src="/images/contact/lee-coaching-landscape.webp" alt="Lee Jones coaching at Joner Football" class="h-full w-full object-cover object-center" />
    </div>
    <div class="absolute inset-0 bg-gradient-to-b from-joner-black/58 via-joner-black/24 to-joner-black/70 lg:bg-gradient-to-r lg:from-joner-black/82 lg:via-joner-black/48 lg:to-joner-black/18"></div>

    <div class="relative z-10 mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:min-h-[calc(100vh-180px)] lg:grid-cols-[0.9fr_1.1fr] lg:gap-10 lg:px-8">
      <div class="max-w-2xl pt-8 lg:pt-0">
        <p class="mb-4 font-heading text-sm uppercase tracking-[0.28em] text-joner-red">Sydney Training Hub</p>
        <h1 class="mb-5 max-w-[9ch] font-heading text-4xl font-bold uppercase leading-[1.02] tracking-wide text-white sm:max-w-[10ch] sm:text-6xl sm:leading-[0.98] lg:text-7xl">
          Find The Right Training
        </h1>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href="#choose-path" class="btn-red self-start text-center text-sm">Compare Programs</a>
        </div>
      </div>

      <div class="training-orbit mx-auto" aria-label="Joner Football training pathway wheel">
        <div class="training-orbit__ring" aria-hidden="true"></div>
        <div class="training-orbit__spin">
          {trainingPrograms.map((program, index) => (
            <a
              href={program.href}
              class={`training-orbit__node training-orbit__node--${index + 1}`}
              aria-label={`Open ${program.title}`}
              title={`${program.title}: ${program.subtitle}`}
            >
              <span class="training-orbit__node-content">
                <img src={program.circleImage} alt="" aria-hidden="true" class={`training-orbit__node-photo ${program.imageClass || ''}`} loading="lazy" />
                <span class="training-orbit__node-label">{program.label}</span>
                <span class="training-orbit__tooltip">{program.title}<small>{program.subtitle}</small></span>
              </span>
            </a>
          ))}
        </div>
        <div class="training-orbit__center">
          <img src="/images/joner-logo-white.png" alt="Joner Football" />
        </div>
      </div>
    </div>
  </section>

  <!-- Choose your next step -->
  <section id="choose-path" class="training-next-step scroll-mt-24" aria-labelledby="training-next-step-title">
    <div class="training-next-step__content">
      <header class="training-next-step__header">
        <p class="training-next-step__eyebrow">What We Offer</p>
        <h2 id="training-next-step-title" class="training-next-step__title">
          <span>Choose Your</span>
          <span>Next Step</span>
        </h2>
        <span class="training-next-step__rule" aria-hidden="true"></span>
      </header>

      <div class="training-next-step__grid" aria-label="Choose your Joner Football training path">
        {trainingPrograms.map((program) => (
          <a href={program.href} class="training-next-step__card" aria-label={`View ${program.title}`}>
            <img src={program.circleImage} alt="" aria-hidden="true" loading="lazy" class="training-next-step__card-bg" />
            <span class="training-next-step__shade" aria-hidden="true"></span>
            <span class="training-next-step__badge">{program.label}</span>
            <span class="training-next-step__body">
              <span class="training-next-step__card-title">{program.title}</span>
              <span class="training-next-step__card-subtitle">{program.subtitle}</span>
            </span>
            <span class="training-next-step__arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== TRAINING HIGHLIGHT VIDEOS ===== -->
  <section class="bg-joner-black py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <p class="text-joner-red font-heading text-sm uppercase tracking-widest mb-3">See It In Action</p>
        <h2 class="font-heading text-3xl md:text-5xl font-bold text-white uppercase">Training Highlights</h2>
      </div>

      <p class="md:hidden text-gray-500 text-xs uppercase tracking-[0.2em] font-heading text-center mb-4">Swipe highlights</p>
      <div class="flex gap-5 overflow-x-auto pb-4 snap-x snap-mandatory md:grid md:grid-cols-3 md:overflow-visible md:pb-0 scrollbar-hide">
        <!-- How I Coach -->
        <div class="flex-shrink-0 w-[82vw] snap-center md:w-auto">
          <div class="relative w-full" style="aspect-ratio: 16/9;">
            <iframe
              srcdoc="<style>*{padding:0;margin:0;overflow:hidden}html,body{height:100%;background:#0a0a0a}img,span{position:absolute;width:100%;top:0;bottom:0;margin:auto}span{height:1.5em;text-align:center;font:48px/1.5 sans-serif;color:#fff;text-shadow:0 0 0.5em black}</style><a href=https://www.youtube.com/embed/D13QAvWlZWg?autoplay=1><img src=https://img.youtube.com/vi/D13QAvWlZWg/hqdefault.jpg alt='How I Coach'><span>&#x25BA;</span></a>"
              src="https://www.youtube.com/embed/D13QAvWlZWg"
              title="How I Coach, Joner Football"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              class="absolute inset-0 w-full h-full border border-gray-800"
            ></iframe>
          </div>
          <p class="font-heading text-white text-sm uppercase tracking-wider mt-3">How I Coach</p>
        </div>

        <!-- Pro Soccer Drills -->
        <div class="flex-shrink-0 w-[82vw] snap-center md:w-auto">
          <div class="relative w-full" style="aspect-ratio: 16/9;">
            <iframe
              srcdoc="<style>*{padding:0;margin:0;overflow:hidden}html,body{height:100%;background:#0a0a0a}img,span{position:absolute;width:100%;top:0;bottom:0;margin:auto}span{height:1.5em;text-align:center;font:48px/1.5 sans-serif;color:#fff;text-shadow:0 0 0.5em black}</style><a href=https://www.youtube.com/embed/1a1EOdqwF54?autoplay=1><img src=https://img.youtube.com/vi/1a1EOdqwF54/hqdefault.jpg alt='Pro Soccer Drills'><span>&#x25BA;</span></a>"
              src="https://www.youtube.com/embed/1a1EOdqwF54"
              title="Pro Soccer Drills, Joner Football"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              class="absolute inset-0 w-full h-full border border-gray-800"
            ></iframe>
          </div>
          <p class="font-heading text-white text-sm uppercase tracking-wider mt-3">Pro Soccer Drills</p>
        </div>

        <!-- Passing Drill Combo -->
        <div class="flex-shrink-0 w-[82vw] snap-center md:w-auto">
          <div class="relative w-full" style="aspect-ratio: 16/9;">
            <iframe
              srcdoc="<style>*{padding:0;margin:0;overflow:hidden}html,body{height:100%;background:#0a0a0a}img,span{position:absolute;width:100%;top:0;bottom:0;margin:auto}span{height:1.5em;text-align:center;font:48px/1.5 sans-serif;color:#fff;text-shadow:0 0 0.5em black}</style><a href=https://www.youtube.com/embed/J8uguy9_OQ4?autoplay=1><img src=https://img.youtube.com/vi/J8uguy9_OQ4/hqdefault.jpg alt='Passing Drill Combo'><span>&#x25BA;</span></a>"
              src="https://www.youtube.com/embed/J8uguy9_OQ4"
              title="Passing Drill Combo, Joner Football"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              class="absolute inset-0 w-full h-full border border-gray-800"
            ></iframe>
          </div>
          <p class="font-heading text-white text-sm uppercase tracking-wider mt-3">Passing Drill Combo</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Cross-links -->
  <section class="bg-joner-black py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="border border-gray-800 p-6 text-center hover:border-joner-red transition-colors">
          <p class="text-gray-300 font-body text-sm mb-3">Continue your training at home with the Joner Football App</p>
          <a href="/app" class="text-joner-red font-heading text-sm uppercase tracking-wider hover:underline">Download the App</a>
        </div>
        <div class="border border-gray-800 p-6 text-center hover:border-joner-red transition-colors">
          <p class="text-gray-300 font-body text-sm mb-3">Take your development further at our global camps</p>
          <a href="/camps" class="text-joner-red font-heading text-sm uppercase tracking-wider hover:underline">View Camps</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Training Enquiry Form -->
  <section id="training-form" class="bg-joner-black py-16 md:py-24 scroll-mt-32">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8 text-center">
        <p class="mb-3 font-heading text-sm uppercase tracking-[0.24em] text-joner-red">Enquire</p>
        <h2 class="font-heading text-3xl uppercase tracking-wide text-white sm:text-4xl">Start Your Training Enquiry</h2>
        <p class="mx-auto mt-4 max-w-2xl font-body text-base leading-relaxed text-gray-400">
          Tell us what you are looking for and the team will point you to the right Joner Football program.
        </p>
      </div>

      <form id="contact-smart-form" class="space-y-5 border border-gray-800 bg-joner-gray p-5 md:p-8">
        <div>
          <label for="enquiryType" class="mb-2 block font-heading text-xs uppercase tracking-[0.22em] text-gray-400">What can we help with?</label>
          <select id="enquiryType" name="enquiryType" required class="min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white focus:border-joner-red focus:outline-none">
            <option value="training-sydney">Training Enquiries (Sydney)</option>
            <option value="joners-juniors">Joners Juniors Enquiries</option>
            <option value="general">General Enquiries</option>
          </select>
          <p id="form-intro" class="mt-3 font-body text-sm text-gray-400">Tell us about the player and what type of training you are looking for.</p>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <input data-name-field type="text" name="name" placeholder="Full name" required class="min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
          <input type="email" name="email" placeholder="Email address" required class="min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <input type="tel" name="phone" placeholder="Phone number" required class="min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
          <select name="trainingLocation" class="min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white focus:border-joner-red focus:outline-none">
            <option value="">Preferred Sydney location</option>
            <option>HQ (Belrose)</option>
            <option>North Turramurra</option>
            <option>Rydalmere Park</option>
            <option>Other</option>
          </select>
        </div>

        <div data-fields="training-sydney joners-juniors" class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <input type="text" name="playerName" placeholder="Player name" class="conditional-required min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
          <input data-player-age-field type="text" name="playerAge" placeholder="Player age" class="conditional-required min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
        </div>

        <div data-fields="training-sydney" class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <input type="text" name="playerLevel" placeholder="Player level or team" class="min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
          <select name="trainingInterest" class="min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white focus:border-joner-red focus:outline-none">
            <option value="">Training interest</option>
            <option>Joner Football Performance</option>
            <option>Professional Training</option>
            <option>Private training</option>
            <option>Group training</option>
            <option>Game analysis</option>
            <option>Not sure yet</option>
          </select>
        </div>

        <div data-fields="joners-juniors" class="grid hidden grid-cols-1 gap-4 sm:grid-cols-2">
          <select name="juniorProgram" class="min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white focus:border-joner-red focus:outline-none">
            <option value="">Program interest</option>
            <option>Joners Juniors</option>
            <option>Joner Football Performance pathway</option>
            <option>Not sure yet</option>
          </select>
          <input type="text" name="parentGoal" placeholder="Main goal for the player" class="min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
        </div>

        <textarea name="message" placeholder="Message" required rows="5" class="w-full resize-none border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none"></textarea>

        <label class="flex gap-3 border border-gray-800 bg-joner-black/60 p-4 font-body text-sm leading-relaxed text-gray-300">
          <input type="checkbox" name="marketingOptIn" value="true" class="mt-1 h-4 w-4 shrink-0 accent-joner-red" />
          <span>Yes, send me Joner Football updates, offers, app news, camps, and training tips by email.</span>
        </label>

        <p id="contact-form-status" class="hidden font-body text-sm"></p>
        <button type="submit" class="btn-red w-full text-sm">Send Training Enquiry</button>
      </form>
    </div>
  </section>

  <script is:inline>
    (function () {
      var options = {
        'training-sydney': {
          intro: 'Tell us about the player and what type of training you are looking for.',
          button: 'Send Training Enquiry'
        },
        'general': {
          intro: 'Ask us anything and the team will point you in the right direction.',
          button: 'Send General Enquiry'
        },
        'joners-juniors': {
          intro: 'For parents enquiring about the Joners Juniors program.',
          button: 'Send Joners Juniors Enquiry'
        }
      };

      var form = document.getElementById('contact-smart-form');
      if (!form) return;
      var typeSelect = form.querySelector('[name="enquiryType"]');
      var intro = document.getElementById('form-intro');
      var submit = form.querySelector('button[type="submit"]');
      var status = document.getElementById('contact-form-status');

      function setStatus(message, ok) {
        if (!status) return;
        status.textContent = message || '';
        status.className = message ? 'font-body text-sm ' + (ok ? 'text-green-400' : 'text-amber-400') : 'hidden font-body text-sm';
      }

      function syncNamePlaceholder() {
        var selected = typeSelect.value || 'training-sydney';
        var nameField = form.querySelector('[data-name-field]');
        var playerAgeField = form.querySelector('[data-player-age-field]');
        if (!nameField) return;
        if (selected !== 'training-sydney') {
          nameField.placeholder = 'Full name';
          return;
        }
        var age = playerAgeField ? parseInt(String(playerAgeField.value || '').replace(/[^0-9]/g, ''), 10) : NaN;
        nameField.placeholder = age >= 18 ? 'Full name' : 'Parent name';
      }

      function syncFields() {
        var selected = typeSelect.value || 'training-sydney';
        var config = options[selected] || options['training-sydney'];
        if (intro) intro.textContent = config.intro;
        if (submit) submit.textContent = config.button;

        form.querySelectorAll('[data-fields]').forEach(function (group) {
          var show = String(group.getAttribute('data-fields') || '').split(' ').indexOf(selected) !== -1;
          group.classList.toggle('hidden', !show);
          group.querySelectorAll('input, select, textarea').forEach(function (field) {
            field.disabled = !show;
            if (field.classList.contains('conditional-required')) field.required = show;
          });
        });
        syncNamePlaceholder();
      }

      typeSelect.addEventListener('change', function () {
        setStatus('', true);
        syncFields();
      });
      var playerAgeField = form.querySelector('[data-player-age-field]');
      if (playerAgeField) playerAgeField.addEventListener('input', syncNamePlaceholder);
      syncFields();

      form.addEventListener('submit', function (event) {
        event.preventDefault();
        setStatus('', true);
        var originalText = submit ? submit.textContent : 'Send Enquiry';
        var formData = new FormData(form);
        var emailInput = form.querySelector('input[name="email"]');

        if (window.JonerEmailGuard && emailInput) {
          var validation = window.JonerEmailGuard.validateEmail(formData.get('email'));
          window.JonerEmailGuard.setFeedback(emailInput, validation);
          if (!validation.valid) {
            emailInput.reportValidity();
            return;
          }
        }

        if (submit) {
          submit.disabled = true;
          submit.textContent = 'Sending...';
          submit.classList.add('opacity-70', 'cursor-not-allowed');
        }

        var payload = {};
        formData.forEach(function (value, key) {
          if (!(value instanceof File)) payload[key] = value;
        });
        if (payload.trainingLocation) payload.location = payload.trainingLocation;
        payload.marketingOptIn = formData.get('marketingOptIn') === 'true';

        var tokenPromise = window.JonerRecaptcha && window.JonerRecaptcha.getToken
          ? window.JonerRecaptcha.getToken('contact')
          : Promise.resolve('');

        tokenPromise.then(function (token) {
          payload.recaptchaToken = token;
          return fetch('/api/contact-enquiry', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
        })
        .then(function (response) { return response.json(); })
        .then(function (data) {
          if (!data || !data.success) throw new Error((data && data.error) || 'Could not send enquiry.');
          form.reset();
          syncFields();
          setStatus('Done. Your enquiry has been sent.', true);
        })
        .catch(function (error) {
          setStatus(error && error.message ? error.message : 'Could not send enquiry. Please try again.', false);
        })
        .finally(function () {
          if (submit) {
            submit.disabled = false;
            submit.textContent = originalText;
            submit.classList.remove('opacity-70', 'cursor-not-allowed');
          }
        });
      });
    })();
  </script>

  <!-- App CTA -->
  <section class="bg-joner-red py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="font-heading text-2xl md:text-4xl font-bold text-white uppercase mb-4">
        Train Anywhere, Anytime
      </h2>
      <p class="text-white/80 font-body mb-6">
        Supplement your sessions with 1,500+ drills on the Joner Football App.
      </p>
      <a href="/app" class="bg-white text-joner-red font-heading text-base uppercase tracking-wider px-8 py-4 hover:bg-gray-100 transition-colors inline-block">
        Try the World's #1 Football App Free
      </a>
    </div>
  </section>


  <style>
    @keyframes training-orbit-spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    @keyframes training-orbit-counter {
      from { transform: rotate(0deg); }
      to { transform: rotate(-360deg); }
    }

    .training-orbit {
      position: relative;
      width: min(78vw, 520px);
      aspect-ratio: 1;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.16);
      background: rgba(26,26,26,0.84);
      box-shadow: 0 28px 80px rgba(0,0,0,0.5), inset 0 0 0 1px rgba(227,6,19,0.24);
    }

    .training-orbit__ring {
      position: absolute;
      inset: 13%;
      border-radius: 999px;
      border: 1px dashed rgba(255,255,255,0.22);
    }

    .training-orbit__spin {
      position: absolute;
      inset: 0;
      animation: training-orbit-spin 24s linear infinite;
    }

    .training-orbit:hover .training-orbit__spin {
      animation-play-state: paused;
    }

    .training-orbit__node {
      position: absolute;
      left: calc(50% - 49px);
      top: calc(50% - 49px);
      display: flex;
      width: 98px;
      height: 98px;
      align-items: center;
      justify-content: center;
      overflow: visible;
      border-radius: 999px;
      border: 2px solid rgba(255,255,255,0.72);
      background: #0A0A0A;
      color: #fff;
      font-family: Anton, Impact, sans-serif;
      font-size: 0.88rem;
      letter-spacing: 0.06em;
      text-decoration: none;
