---
import BaseLayout from '../../layouts/BaseLayout.astro'

const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'Joner Football Online Coaches Course and Mentorship',
  description: 'Application-based Joner Football online coaches course and mentorship. Maximum 25 spots available.',
  provider: {
    '@type': 'Organization',
    name: 'Joner Football',
    url: 'https://jonerfootball.com',
  },
  url: 'https://jonerfootball.com/workshops/coaches-course',
  courseMode: 'online',
}
---

<BaseLayout
  title="Online Coaches Course | Joner Football"
  description="Apply for the Joner Football Online Coaches Course and Mentorship. Coming soon, maximum 25 spots available."
  canonical="https://jonerfootball.com/workshops/coaches-course/"
  schema={courseSchema}
>
  <main class="bg-joner-black text-white">
    <section class="bg-joner-black pt-10 pb-12 md:pt-16 md:pb-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-black">
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(227,6,19,0.2),transparent_56%)] pointer-events-none"></div>
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,rgba(255,255,255,0.07),transparent_60%)] pointer-events-none"></div>

          <div class="relative z-10 grid min-h-[560px] grid-cols-1 lg:grid-cols-2">
            <div class="flex flex-col justify-center px-6 py-10 sm:px-10 sm:py-14 lg:p-14">
              <p class="mb-4 font-heading text-xs uppercase tracking-[0.25em] text-joner-red sm:text-sm">Coming Soon</p>
              <h1 class="mb-6 bg-gradient-to-b from-white via-neutral-100 to-neutral-500 bg-clip-text font-heading text-5xl font-bold uppercase leading-[0.9] text-transparent sm:text-6xl md:text-7xl lg:text-8xl">
                Online Coaches<br />Course
              </h1>
              <p class="mb-8 max-w-xl font-body text-base leading-relaxed text-neutral-300 sm:text-lg">
                Joner Football Online Coaches Course and Mentorship. Apply below and tell us about your coaching journey. Maximum 25 spots available.
              </p>
              <a href="#apply" class="btn-red w-fit text-sm">Apply For A Spot</a>
            </div>

            <div class="relative min-h-[360px] bg-joner-gray lg:min-h-0">
              <img src="/images/coaches-only/dsc05109-hero.webp" alt="Joner Football coaching the coaches session" class="absolute inset-0 h-full w-full object-cover opacity-55" loading="eager" />
              <div class="absolute inset-0 bg-gradient-to-t from-black via-black/55 to-transparent lg:bg-gradient-to-r lg:from-black/20 lg:via-black/55 lg:to-black/80"></div>
              <div class="absolute bottom-6 left-6 right-6 rounded-xl border border-white/10 bg-black/70 p-5 backdrop-blur-sm">
                <p class="mb-2 font-heading text-xs uppercase tracking-[0.25em] text-joner-red">Application Only</p>
                <p class="font-heading text-2xl uppercase leading-tight text-white">We will respond with more information.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-joner-black py-12 md:py-20">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
          <div class="rounded-lg border border-white/10 bg-white/5 p-6">
            <p class="mb-2 font-heading text-sm uppercase tracking-widest text-joner-red">01</p>
            <h2 class="font-heading text-2xl uppercase leading-tight text-white">Course</h2>
            <p class="mt-3 font-body text-sm leading-relaxed text-neutral-400">Learn the Joner Football coaching standards, session ideas and methodology.</p>
          </div>
          <div class="rounded-lg border border-white/10 bg-white/5 p-6">
            <p class="mb-2 font-heading text-sm uppercase tracking-widest text-joner-red">02</p>
            <h2 class="font-heading text-2xl uppercase leading-tight text-white">Mentorship</h2>
            <p class="mt-3 font-body text-sm leading-relaxed text-neutral-400">Built for coaches who want more detail, clarity and direction in their coaching journey.</p>
          </div>
          <div class="rounded-lg border border-white/10 bg-white/5 p-6">
            <p class="mb-2 font-heading text-sm uppercase tracking-widest text-joner-red">03</p>
            <h2 class="font-heading text-2xl uppercase leading-tight text-white">25 Spots</h2>
            <p class="mt-3 font-body text-sm leading-relaxed text-neutral-400">A limited first intake so the team can keep the experience high quality.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="apply" class="scroll-mt-24 bg-joner-gray py-16 md:py-24">
      <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
        <div class="mb-8 text-center">
          <p class="mb-3 font-heading text-sm uppercase tracking-[0.24em] text-joner-red">Apply Below</p>
          <h2 class="font-heading text-3xl uppercase tracking-wide text-white sm:text-4xl">Register Interest</h2>
          <p class="mx-auto mt-4 max-w-xl font-body text-base leading-relaxed text-gray-400">Provide as much information as you can about yourself and your coaching journey.</p>
        </div>

        <form data-brevo-form data-form-name="coaches-course-application" data-list-id="11" class="space-y-4 border border-gray-800 bg-joner-black p-5 md:p-8">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <input type="text" name="full_name" placeholder="Full name" required class="min-h-[52px] w-full border border-gray-700 bg-joner-gray px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
            <input type="email" name="email" placeholder="Email address" required class="min-h-[52px] w-full border border-gray-700 bg-joner-gray px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
          </div>
          <input type="tel" name="phone" placeholder="Phone number" class="min-h-[52px] w-full border border-gray-700 bg-joner-gray px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
          <select name="coaching_experience" required class="min-h-[52px] w-full border border-gray-700 bg-joner-gray px-4 py-3 font-body text-base text-white focus:border-joner-red focus:outline-none">
            <option value="" disabled selected>Coaching experience</option>
            <option>New coach</option>
            <option>Grassroots coach</option>
            <option>Academy coach</option>
            <option>Private coach</option>
            <option>Professional or semi-professional environment</option>
          </select>
          <textarea name="coaching_journey" placeholder="Tell us about your coaching journey" required rows="6" class="w-full resize-none border border-gray-700 bg-joner-gray px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none"></textarea>
          <button type="submit" class="btn-red w-full text-sm">Apply For Coaches Course</button>
        </form>
      </div>
    </section>
  </main>
</BaseLayout>
