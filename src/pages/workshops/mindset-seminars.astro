---
import BaseLayout from '../../layouts/BaseLayout.astro'
import SanityPageExtras from '../../components/sanity/SanityPageExtras.astro'

const seminarSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'Mindset Seminars, Joner Football',
  description: 'Coming soon mindset seminars for football players, coaches and parents.',
  organizer: {
    '@type': 'Organization',
    name: 'Joner Football',
    url: 'https://jonerfootball.com',
  },
  url: 'https://jonerfootball.com/workshops/mindset-seminars',
  eventAttendanceMode: 'https://schema.org/MixedEventAttendanceMode',
}

import SanityPageRenderer from '../../components/sanity/SanityPageRenderer.astro'
import { fetchSanityPage } from '../../lib/sanityPages'
import { getSanityText, shouldReplaceSanityPage } from '../../lib/sanityPageUtils'

const sanityPage = await fetchSanityPage('mindset-seminars')
const pageTitle = sanityPage?.seo?.title || 'Mindset Seminars | Joner Football'
const pageDescription = sanityPage?.seo?.description || 'Joner Football Mindset Seminars are coming soon. Register interest for players, coaches and parents.'
const heroEyebrow = getSanityText(sanityPage?.heroEyebrow, 'Coming Soon')
const heroHeadline = getSanityText(sanityPage?.heroHeadline, 'Mindset Seminars')
const heroSubheadline = getSanityText(sanityPage?.heroSubheadline, 'The mental side of football. For players, coaches and parents. Register interest and we will let you know when the next seminar is ready.')
---

{shouldReplaceSanityPage(sanityPage) ? (
  <SanityPageRenderer page={sanityPage} />
) : (
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={sanityPage?.seo?.canonicalUrl || 'https://jonerfootball.com/workshops/mindset-seminars/'}
  ogImage={sanityPage?.seo?.imageUrl || undefined}
  noindex={Boolean(sanityPage?.seo?.noIndex)}
  schema={seminarSchema}
>
  <main class="bg-joner-black text-white">
    <section class="bg-joner-black pt-10 pb-12 md:pt-16 md:pb-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-black">
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(227,6,19,0.2),transparent_56%)] pointer-events-none"></div>
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,rgba(255,255,255,0.07),transparent_60%)] pointer-events-none"></div>

          <div class="relative z-10 min-h-[560px] px-6 py-14 text-center sm:px-10 md:py-20 lg:px-14">
            <div class="mx-auto flex min-h-[460px] max-w-4xl flex-col items-center justify-center">
              <p class="mb-4 font-heading text-xs uppercase tracking-[0.25em] text-joner-red sm:text-sm">{heroEyebrow}</p>
              <h1 class="mb-6 bg-gradient-to-b from-white via-neutral-100 to-neutral-500 bg-clip-text font-heading text-5xl font-bold uppercase leading-[0.9] text-transparent sm:text-6xl md:text-7xl lg:text-8xl">
                {heroHeadline}
              </h1>
              <p class="mb-8 max-w-2xl font-body text-base leading-relaxed text-neutral-300 sm:text-lg">
                {heroSubheadline}
              </p>
              <a href="#contact" class="btn-red text-sm">Register Interest</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-joner-black py-12 md:py-20">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
          <div class="rounded-lg border border-white/10 bg-white/5 p-6">
            <p class="mb-2 font-heading text-sm uppercase tracking-widest text-joner-red">Players</p>
            <h2 class="font-heading text-2xl uppercase leading-tight text-white">Confidence</h2>
            <p class="mt-3 font-body text-sm leading-relaxed text-neutral-400">Support around pressure, confidence, preparation and football standards.</p>
          </div>
          <div class="rounded-lg border border-white/10 bg-white/5 p-6">
            <p class="mb-2 font-heading text-sm uppercase tracking-widest text-joner-red">Coaches</p>
            <h2 class="font-heading text-2xl uppercase leading-tight text-white">Environment</h2>
            <p class="mt-3 font-body text-sm leading-relaxed text-neutral-400">How coaching language and training standards shape player mindset.</p>
          </div>
          <div class="rounded-lg border border-white/10 bg-white/5 p-6">
            <p class="mb-2 font-heading text-sm uppercase tracking-widest text-joner-red">Parents</p>
            <h2 class="font-heading text-2xl uppercase leading-tight text-white">Support</h2>
            <p class="mt-3 font-body text-sm leading-relaxed text-neutral-400">Help players handle the ups and downs without adding unnecessary pressure.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="scroll-mt-24 bg-joner-gray py-16 md:py-24">
      <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
        <div class="mb-8 text-center">
          <p class="mb-3 font-heading text-sm uppercase tracking-[0.24em] text-joner-red">Contact Us</p>
          <h2 class="font-heading text-3xl uppercase tracking-wide text-white sm:text-4xl">Register Interest</h2>
          <p class="mx-auto mt-4 max-w-xl font-body text-base leading-relaxed text-gray-400">Leave your details and tell us what type of mindset seminar you are interested in.</p>
        </div>

        <form data-brevo-form data-form-name="mindset-seminars-interest" data-list-id="2" data-list-ids="2,45" class="space-y-4 border border-gray-800 bg-joner-black p-5 md:p-8">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <input type="text" name="full_name" placeholder="Full name" required class="min-h-[52px] w-full border border-gray-700 bg-joner-gray px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
            <input type="email" name="email" placeholder="Email address" required class="min-h-[52px] w-full border border-gray-700 bg-joner-gray px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
          </div>
          <input type="tel" name="phone" placeholder="Phone number" class="min-h-[52px] w-full border border-gray-700 bg-joner-gray px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
          <select name="role" required class="min-h-[52px] w-full border border-gray-700 bg-joner-gray px-4 py-3 font-body text-base text-white focus:border-joner-red focus:outline-none">
            <option value="" disabled selected>I am a...</option>
            <option>Player</option>
            <option>Coach</option>
            <option>Parent</option>
            <option>Club or organisation</option>
          </select>
          <textarea name="message" placeholder="What are you interested in?" required rows="6" class="w-full resize-none border border-gray-700 bg-joner-gray px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none"></textarea>
          <button type="submit" class="btn-red w-full text-sm">Register Interest</button>
        </form>
      </div>
    </section>
    <SanityPageExtras page={sanityPage} />
  </main>
</BaseLayout>
)}
