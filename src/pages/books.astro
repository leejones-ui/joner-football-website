---
import BaseLayout from '../layouts/BaseLayout.astro'

const books = [
  {
    title: 'Greatest Goal Scorers!',
    subtitle: 'including Messi, Ronaldo and Haaland!',
    cover: '/images/shop/greatest-goal-scorers/cover.jpg',
    detail: '/shop/greatest-goal-scorers/',
    paperback: 'https://www.penguin.com.au/books/joner-football-presents-greatest-goal-scorers-9781761359781',
    ebook: 'https://www.penguin.com.au/books/joner-football-presents-greatest-goal-scorers-9781761359798',
    international: 'https://www.readings.com.au/product/9781761359781',
  },
  {
    title: 'Midfield Masters!',
    subtitle: 'including Bellingham, De Bruyne and Modrić!',
    cover: '/images/books/midfield-masters/cover.jpg',
    detail: '/shop/midfield-masters/',
    paperback: 'https://www.penguin.com.au/books/joner-football-presents-midfield-masters-9781761359804',
    ebook: 'https://www.penguin.com.au/books/joner-football-presents-midfield-masters-9781761359811',
    international: 'https://www.readings.com.au/product/9781761359804',
  },
]

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Joner Football Books by Lee Jones',
  description: 'Official Joner Football books by Lee Jones for young footballers who want to learn from the greats and improve their game.',
  url: 'https://jonerfootball.com/books/',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: books.map((book, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `https://jonerfootball.com${book.detail}`,
      name: book.title,
    })),
  },
}
---

<BaseLayout
  title="Books by Lee Jones | Joner Football"
  description="Shop the official Joner Football books by Lee Jones, including Greatest Goal Scorers and Midfield Masters, in paperback or eBook."
  canonical="https://jonerfootball.com/books/"
  ogImage="https://jonerfootball.com/images/shop/greatest-goal-scorers/cover.jpg"
  schema={schema}
>
  <div class="books-page">
    <section class="books-hero">
      <div class="books-hero__inner">
        <p class="books-kicker">Official Joner Football books</p>
        <h1>Learn from the greats.<br /><span>Take it to the pitch.</span></h1>
        <p class="books-intro">Football books for young players who want to understand the best, master their moves and improve their own game.</p>
        <a class="books-jump" href="#choose-your-book">Choose your book</a>
      </div>
    </section>

    <section class="books-collection" id="choose-your-book" aria-labelledby="books-title">
      <div class="books-shell">
        <div class="books-heading">
          <p>Books by Lee Jones</p>
          <h2 id="books-title">Choose your book</h2>
        </div>

        <div class="books-grid">
          {books.map((book) => (
            <article class="book-card">
              <a class="book-card__cover-link" href={book.detail} aria-label={`View ${book.title}`}>
                <span class="live-badge">Available now</span>
                <img class="book-card__cover" src={book.cover} alt={`Cover of Joner Football presents: ${book.title}`} width="400" height="614" />
              </a>

              <div class="book-card__body">
                <h3><a href={book.detail}>{book.title}</a></h3>
                <p class="book-card__subtitle">{book.subtitle}</p>
                <p class="book-card__author">Lee Jones</p>

                <div class="book-card__options" aria-label={`Buy ${book.title}`}>
                  <a href={book.paperback} target="_blank" rel="noopener noreferrer">
                    <span>Paperback</span>
                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 5 7 7-7 7" /></svg>
                  </a>
                  <a href={book.ebook} target="_blank" rel="noopener noreferrer">
                    <span>EBook</span>
                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 5 7 7-7 7" /></svg>
                  </a>
                  <a class="international-option" href={book.international} target="_blank" rel="noopener noreferrer">
                    <span>International orders</span>
                    <small>Readings</small>
                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 5 7 7-7 7" /></svg>
                  </a>
                </div>

                <a class="all-retailers" href={book.detail}>View all retailers and book details</a>
              </div>
            </article>
          ))}

          <article class="book-card book-card--soon" aria-labelledby="coming-soon-title">
            <div class="book-card__cover-link book-card__cover-link--static">
              <span class="soon-badge">Coming soon</span>
              <img class="book-card__cover" src="/images/books/coming-soon/50-football-drills.png" alt="Concept cover for 50 Football Drills by Lee Jones, coming soon" width="1024" height="1536" />
            </div>
            <div class="book-card__body">
              <h3 id="coming-soon-title">50 Football Drills</h3>
              <p class="book-card__subtitle">A new Joner Football book for players and coaches.</p>
              <p class="book-card__author">Lee Jones</p>
              <div class="coming-soon-panel">
                <span>Coming soon</span>
                <small>More details will be announced here.</small>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .books-page {
    --red: #e8000d;
    --black: #080808;
    --white: #fff;
    --soft: #cccccc;
    background: var(--black);
    color: var(--white);
  }

  .books-page h1,
  .books-page h2,
  .books-page h3 {
    font-family: 'Anton', Impact, sans-serif;
    text-transform: uppercase;
  }

  .books-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    background:
      linear-gradient(90deg, rgba(8, 8, 8, 0.98) 0%, rgba(8, 8, 8, 0.88) 52%, rgba(8, 8, 8, 0.44) 100%),
      url('/images/shop/greatest-goal-scorers/cover.jpg') right 18% center / 440px auto no-repeat;
  }

  .books-hero::after {
    content: '';
    position: absolute;
    z-index: -1;
    right: 0;
    bottom: 0;
    width: 44%;
    height: 7px;
    background: var(--red);
  }

  .books-hero__inner {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding: clamp(88px, 12vw, 160px) 0 clamp(78px, 10vw, 132px);
  }

  .books-kicker,
  .books-heading > p {
    margin: 0 0 16px;
    color: var(--red);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .books-hero h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(48px, 7vw, 92px);
    line-height: 0.98;
    letter-spacing: 0.015em;
  }

  .books-hero h1 span { color: var(--red); }
  .books-intro { max-width: 610px; margin: 28px 0 34px; color: var(--soft); font-size: clamp(17px, 2vw, 21px); line-height: 1.55; }
  .books-jump {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 24px;
    border: 2px solid var(--red);
    background: var(--red);
    color: #fff;
    font-family: 'Anton', Impact, sans-serif;
    letter-spacing: 0.09em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background 160ms ease, color 160ms ease;
  }
  .books-jump:hover,
  .books-jump:focus-visible { background: #fff; color: var(--black); }

  .books-collection { padding: clamp(70px, 9vw, 120px) 0; }
  .books-shell { width: min(1180px, calc(100% - 40px)); margin: 0 auto; }
  .books-heading { display: block; margin-bottom: 44px; }
  .books-heading > p { margin-bottom: 7px; }
  .books-heading h2 { margin: 0; font-size: clamp(36px, 5vw, 62px); line-height: 1; }

  .books-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; align-items: start; }
  .book-card { overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.16); background: #111; }
  .book-card__cover-link { position: relative; display: grid; place-items: center; min-height: 470px; padding: 34px; background: #f2f2f2; }
  .book-card__cover-link--static { cursor: default; }
  .book-card__cover { display: block; width: min(100%, 250px); height: auto; object-fit: contain; box-shadow: 0 20px 34px rgba(0, 0, 0, 0.24); transition: transform 180ms ease; }
  a.book-card__cover-link:hover .book-card__cover { transform: translateY(-5px); }

  .live-badge,
  .soon-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 1;
    padding: 7px 10px;
    background: var(--red);
    color: #fff;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .soon-badge { background: var(--black); }

  .book-card__body { padding: 25px 22px 26px; }
  .book-card h3 { margin: 0; font-size: 28px; line-height: 1.08; letter-spacing: 0.03em; }
  .book-card h3 a { color: #fff; text-decoration: none; }
  .book-card h3 a:hover { color: var(--red); }
  .book-card__subtitle { min-height: 48px; margin: 10px 0 5px; color: var(--soft); font-size: 14px; line-height: 1.45; }
  .book-card__author { margin: 0 0 20px; color: #fff; font-size: 14px; font-weight: 700; }

  .book-card__options { display: grid; gap: 9px; }
  .book-card__options > a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    min-height: 49px;
    padding: 10px 13px;
    border: 1px solid rgba(255, 255, 255, 0.32);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: border-color 150ms ease, background 150ms ease;
  }
  .book-card__options > a:hover,
  .book-card__options > a:focus-visible { border-color: var(--red); background: rgba(232, 0, 13, 0.12); }
  .book-card__options svg { grid-column: 2; grid-row: 1 / span 2; width: 18px; fill: none; stroke: currentColor; stroke-width: 2; }
  .book-card__options small { color: #aaa; font-size: 11px; font-weight: 500; }
  .international-option { border-color: rgba(232, 0, 13, 0.72) !important; }

  .all-retailers { display: inline-block; margin-top: 18px; color: #fff; font-size: 12px; text-decoration: underline; text-decoration-color: var(--red); text-underline-offset: 4px; }
  .all-retailers:hover { color: var(--red); }

  .coming-soon-panel { display: grid; gap: 5px; min-height: 107px; padding: 20px; border: 1px solid rgba(232, 0, 13, 0.5); background: rgba(232, 0, 13, 0.08); }
  .coming-soon-panel span { color: #fff; font-family: 'Anton', Impact, sans-serif; font-size: 22px; letter-spacing: 0.08em; text-transform: uppercase; }
  .coming-soon-panel small { color: var(--soft); line-height: 1.4; }

  .books-page :global(a:focus-visible) { outline: 3px solid rgba(232, 0, 13, 0.45); outline-offset: 3px; }

  @media (max-width: 980px) {
    .books-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .book-card--soon { grid-column: 1 / -1; width: calc(50% - 12px); }
    .books-hero { background-size: 340px auto; }
  }

  @media (max-width: 650px) {
    .books-hero {
      background:
        linear-gradient(180deg, rgba(8, 8, 8, 0.35), rgba(8, 8, 8, 0.98) 54%),
        url('/images/shop/greatest-goal-scorers/cover.jpg') center 14% / 200px auto no-repeat;
    }
    .books-hero__inner { width: min(100% - 32px, 520px); padding: 260px 0 66px; text-align: center; }
    .books-hero h1 { font-size: clamp(42px, 13vw, 62px); }
    .books-intro { font-size: 16px; }
    .books-jump { width: 100%; }
    .books-shell { width: min(100% - 32px, 520px); }
    .books-heading { display: block; margin-bottom: 30px; text-align: center; }
    .books-heading h2 { font-size: 43px; }
    .books-grid { grid-template-columns: 1fr; gap: 22px; }
    .book-card--soon { grid-column: auto; width: auto; }
    .book-card__cover-link { min-height: 420px; padding: 30px; }
    .book-card__cover { width: min(100%, 230px); }
    .book-card__subtitle { min-height: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .book-card__cover,
    .books-jump { transition: none; }
  }
</style>
