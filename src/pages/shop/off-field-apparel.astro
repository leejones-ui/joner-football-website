---
import BaseLayout from '../../layouts/BaseLayout.astro'

const video = 'https://apparel.jonerfootball.com/app/uploads/2023/06/WEBSITE-TEASER-.mp4'
const shopifyStore = 'https://jonerfootball.myshopify.com'

let products = []
try {
  const response = await fetch(`${shopifyStore}/products.json?limit=250`)
  const data = await response.json()
  products = (data.products || []).map((product: any) => {
    const variants = product.variants || []
    const availableVariants = variants.filter((variant: any) => variant.available)
    const prices = variants
      .map((variant: any) => Number(variant.price))
      .filter((price: number) => Number.isFinite(price))
    const minPrice = prices.length ? Math.min(...prices) : null
    const image = product.images?.[0]?.src || '/images/shop/shop-apparel.webp'

    return {
      title: product.title,
      price: minPrice === null ? 'Price in Shopify' : `$${minPrice.toFixed(2)}`,
      image,
      href: `${shopifyStore}/products/${product.handle}`,
      available: availableVariants.length > 0,
    }
  })
} catch (error) {
  products = []
}
---

<BaseLayout title="Off Field Apparel | Joner Football Shop" description="Shop Joner Football off field apparel, hoodies, tees, tanks, shorts, hats, and lifestyle gear.">
  <main class="bg-white text-joner-black">
    <section class="bg-white border-b border-gray-200">
      <div class="px-4 md:px-8 py-5 flex items-center justify-between gap-4">
        <a href="/shop" class="font-heading uppercase text-xl tracking-widest">Joner Apparel</a>
      </div>
      <div class="bg-joner-black text-white text-center font-heading uppercase tracking-widest text-xs py-3">
        Free shipping for orders above A$150, Australia and worldwide
      </div>
    </section>

    <section class="grid grid-cols-1 lg:grid-cols-2">
      <div class="relative min-h-[48vh] lg:min-h-[68vh] overflow-hidden bg-joner-black">
        <video autoplay muted loop playsinline class="absolute inset-0 w-full h-full object-cover opacity-90">
          <source src={video} type="video/mp4" />
        </video>
      </div>
      <div class="flex items-center px-6 md:px-12 py-14 lg:py-0">
        <div>
          <p class="font-heading uppercase tracking-[0.25em] text-joner-red text-sm mb-5">Off Field</p>
          <h1 class="font-heading uppercase text-6xl md:text-8xl leading-none mb-6">Joner Apparel</h1>
          <p class="text-lg text-gray-700 max-w-xl mb-8">Official Joner Football off field apparel. Clean everyday gear for players, coaches, and parents.</p>
          <a href="https://apparel.jonerfootball.com/offfield/" target="_blank" rel="noopener" class="btn-red">Open Full Apparel Store</a>
        </div>
      </div>
    </section>

    <section class="px-4 md:px-8 py-8 md:py-12">
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-5 gap-y-10">
        {products.map((product) => (
          <a href={product.href} target="_blank" rel="noopener" class="group block">
            <div class="relative aspect-[2/3] overflow-hidden bg-gray-100 mb-4">
              {!product.available && <span class="absolute left-3 top-3 z-10 bg-joner-black text-white font-heading uppercase text-xs tracking-widest px-3 py-2">Sold Out</span>}
              <img src={product.image} alt={product.title} class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            </div>
            <h2 class="font-body text-base md:text-lg leading-tight text-joner-black group-hover:text-joner-red transition-colors">{product.title}</h2>
            <p class="font-heading text-base mt-2">{product.price}</p>
            <p class="text-xs text-gray-500 mt-1">{product.available ? 'Select options' : 'Currently unavailable'}</p>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
