---
import BaseLayout from '../../layouts/BaseLayout.astro'

const programs = [
  {
    title: 'Strength & Conditioning',
    price: 'USD 99.99',
    image: '/images/shop/training-programs/strength-conditioning.webp',
    href: 'https://app.jonerfootball.com/checkout/new?o=228904',
    text: 'A 12-week football-specific strength and conditioning plan for players who want to get stronger, sharper, and more explosive.',
  },
  {
    title: 'Fast Feet Program',
    price: 'USD 29.99',
    image: '/images/shop/training-programs/fast-feet-program.webp',
    href: 'https://app.jonerfootball.com/checkout/new?o=228903',
    text: 'Build quicker feet, sharper reactions, better balance, and cleaner touches with sessions players can follow from home or on the pitch.',
  },
  {
    title: '6 Weeks Passing & 1st Touch',
    price: 'USD 54.99',
    image: '/images/shop/training-programs/six-weeks-passing-first-touch.webp',
    href: 'https://app.jonerfootball.com/checkout/new?o=228901',
    text: 'Improve passing quality, first touch, body shape, receiving skills, and the technical details that make players cleaner on the ball.',
  },
  {
    title: '7 Day Dribbling Program',
    price: 'USD 39.99',
    image: '/images/shop/training-programs/dribbling-7-day-program.webp',
    href: 'https://app.jonerfootball.com/checkout/new?o=228825',
    text: 'A focused dribbling block for close control, changes of direction, ball manipulation, and confidence in 1v1 moments.',
  },
  {
    title: 'Juggling Program',
    price: 'USD 19.99',
    image: '/images/shop/training-programs/juggling-program.webp',
    href: 'https://app.jonerfootball.com/checkout/new?o=228824',
    text: 'Improve coordination, touch, control, and ball mastery with a simple juggling pathway players can repeat and track.',
  },
  {
    title: 'Score More Goals',
    price: 'USD 64.99',
    image: '/images/shop/training-programs/score-more-goals.webp',
    href: 'https://app.jonerfootball.com/checkout/new?o=228823',
    text: 'Finishing sessions built around technique, movement, striking detail, composure, and the habits that help players score more often.',
  },
  {
    title: 'Weak Foot Program',
    price: 'USD 54.99',
    image: '/images/shop/training-programs/weak-foot-program.webp',
    href: 'https://app.jonerfootball.com/checkout/new?o=228822',
    text: 'A 10-week plan to improve weak-foot control, passing, striking, confidence, and the ability to use both feet under pressure.',
  },
  {
    title: '100 Day Transformation Pack',
    price: 'USD 199.99',
    image: '/images/shop/training-programs/hundred-day-transformation-bundle.webp',
    href: 'https://app.jonerfootball.com/checkout/new?o=227739',
    text: 'The complete 100-day training pack for players who want structure across touch, dribbling, weak foot, finishing, speed, and conditioning.',
  },
]

import SanityPageRenderer from '../../components/sanity/SanityPageRenderer.astro'
import { fetchSanityPage } from '../../lib/sanityPages'
import { shouldReplaceSanityPage } from '../../lib/sanityPageUtils'

const sanityPage = await fetchSanityPage('shop-training-programs')
---

{shouldReplaceSanityPage(sanityPage) ? (
  <SanityPageRenderer page={sanityPage} />
) : (
<BaseLayout title="Training Programs | Joner Football Shop" description="Shop Joner Football training programs for sharper feet, better first touch, stronger finishing, weak foot work and clear at-home football training.">
  <main class="bg-joner-black text-white">
    <section class="relative overflow-hidden border-b border-white/10">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(220,0,0,0.35),transparent_34%),linear-gradient(135deg,#050505_0%,#111_52%,#050505_100%)]"></div>
      <div class="relative max-w-7xl mx-auto px-4 md:px-8 py-14 md:py-20">
        <div class="max-w-4xl">
          <p class="font-heading uppercase tracking-[0.28em] text-joner-red text-sm mb-4">Joner Football Shop</p>
          <h1 class="font-heading uppercase text-6xl md:text-8xl lg:text-9xl leading-none mb-6">Training Programs</h1>
          <p class="text-lg md:text-xl text-white/75 max-w-2xl leading-relaxed">Online training programs players can start straight away. Pick the exact program you need and checkout directly inside the Joner Football app.</p>
        </div>
      </div>
    </section>

    <section class="px-4 md:px-8 py-10 md:py-16">
      <div class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-7">
        {programs.map((program) => (
          <article class="group flex flex-col overflow-hidden rounded-none border border-white/10 bg-white text-joner-black shadow-2xl shadow-black/30">
            <a href={program.href} target="_blank" rel="noopener" class="block overflow-hidden bg-joner-black">
              <img src={program.image} alt={program.title} class="w-full aspect-[4/5] object-cover object-center transition-transform duration-500 group-hover:scale-105" loading="lazy" />
            </a>
            <div class="flex flex-1 flex-col p-5 md:p-6">
              <div class="mb-4 inline-flex w-fit items-center bg-joner-red px-4 py-2 font-heading uppercase tracking-[0.08em] text-white text-lg shadow-lg shadow-joner-red/25">{program.price}</div>
              <h2 class="font-heading uppercase text-2xl md:text-3xl leading-none mb-3">{program.title}</h2>
              <p class="text-sm leading-relaxed text-gray-600 mb-6">{program.text}</p>
              <a href={program.href} target="_blank" rel="noopener" class="btn-red mt-auto w-full text-center">Buy Now</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
)}
