---
import BaseLayout from '../../layouts/BaseLayout.astro'

const resources = [
  {
    title: 'Scanning Training Tool',
    price: 'AUD 79.99',
    image: '/images/shop/resources-accessories/scanning-training-tool.webp',
    href: 'https://buy.stripe.com/bJe00icKA49l35ZfpqgEg09',
    text: 'Reaction, turning, scanning, and decision-making training tools for players and coaches who want smarter sessions.',
  },
  {
    title: 'Numbers Tool',
    price: 'AUD 24.99',
    image: '/images/shop/resources-accessories/numbers-training-tool.webp',
    href: 'https://buy.stripe.com/cNieVccKA0X921VgtugEg0a',
    text: 'A number-recognition tool for sharper awareness, quicker decisions, and more game-realistic scanning habits.',
  },
]
---

<BaseLayout title="Resources And Accessories | Joner Football Shop" description="Shop Joner Football training resources and accessories, including scanning and number-recognition training tools.">
  <main class="bg-joner-black text-white">
    <section class="relative overflow-hidden border-b border-white/10">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(220,0,0,0.35),transparent_34%),linear-gradient(135deg,#050505_0%,#111_52%,#050505_100%)]"></div>
      <div class="relative max-w-7xl mx-auto px-4 md:px-8 py-14 md:py-20">
        <div class="max-w-4xl">
          <p class="font-heading uppercase tracking-[0.28em] text-joner-red text-sm mb-4">Joner Football Shop</p>
          <h1 class="font-heading uppercase text-6xl md:text-8xl lg:text-9xl leading-none mb-6">Resources & Accessories</h1>
          <p class="text-lg md:text-xl text-white/75 max-w-2xl leading-relaxed">Training tools and session resources built to help players scan earlier, react faster, and make better decisions.</p>
        </div>
      </div>
    </section>

    <section class="px-4 md:px-8 py-10 md:py-16">
      <div class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-7">
        {resources.map((resource) => (
          <article class="group flex flex-col overflow-hidden border border-white/10 bg-white text-joner-black shadow-2xl shadow-black/30">
            <a href={resource.href} target="_blank" rel="noopener" class="block overflow-hidden bg-joner-black">
              <img src={resource.image} alt={resource.title} class="w-full aspect-[4/5] object-cover object-center transition-transform duration-500 group-hover:scale-105" loading="lazy" />
            </a>
            <div class="flex flex-1 flex-col p-5 md:p-6">
              <div class="mb-4 inline-flex w-fit items-center bg-joner-red px-4 py-2 font-heading uppercase tracking-[0.08em] text-white text-lg shadow-lg shadow-joner-red/25">{resource.price}</div>
              <h2 class="font-heading uppercase text-3xl md:text-4xl leading-none mb-3">{resource.title}</h2>
              <p class="text-sm md:text-base leading-relaxed text-gray-600 mb-6">{resource.text}</p>
              <a href={resource.href} target="_blank" rel="noopener" class="btn-red mt-auto w-full text-center">Buy Now</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
