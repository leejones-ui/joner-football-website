---
import BaseLayout from '../../layouts/BaseLayout.astro'

const coming = ['Training kits', 'Balls', 'Cones', 'Player essentials']
---

<BaseLayout title="On Field Training Gear | Joner Football Shop" description="Joner Football on field training gear, kits, balls, cones, and pitch essentials. Coming soon.">
  <main class="bg-joner-black text-white">
    <section class="grid grid-cols-1 lg:grid-cols-2 min-h-[78vh]">
      <div class="flex items-center px-6 md:px-12 lg:px-16 py-16">
        <div class="max-w-xl">
          <p class="font-heading uppercase tracking-[0.25em] text-joner-red text-sm mb-5">Coming Soon</p>
          <h1 class="font-heading uppercase text-6xl md:text-8xl leading-none mb-6">On Field Training Gear</h1>
          <p class="text-xl text-gray-300 mb-8">A proper Joner Football training range for players who live on the pitch. This page is ready for products when the range drops.</p>
          <a href="/shop" class="btn-outline">Back To Shop</a>
        </div>
      </div>
      <div class="relative min-h-[55vh] lg:min-h-[78vh] overflow-hidden">
        <img src="/images/shop/shop-gear.webp" alt="Joner Football on field training gear" class="absolute inset-0 w-full h-full object-cover opacity-80" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></div>
      </div>
    </section>

    <section class="py-10 md:py-16 border-t border-gray-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-2 md:grid-cols-4 gap-4">
        {coming.map((item) => (
          <div class="bg-joner-gray border border-gray-800 p-6 text-center">
            <h2 class="font-heading uppercase text-2xl">{item}</h2>
          </div>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
