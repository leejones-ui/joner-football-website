---
import BaseLayout from '../layouts/BaseLayout.astro'
import FactsMarquee from '../components/FactsMarquee.astro'
import SEOFAQ from '../components/SEOFAQ.astro'
import GeoAnswers from '../components/GeoAnswers.astro'
import { faqSchema, webPageSchema, breadcrumbSchema } from '../lib/seoSchema'
import SanityPageExtras from '../components/sanity/SanityPageExtras.astro'
import PlayButtonVideo from '../components/PlayButtonVideo.astro'
import ScrollRevealSection from '../components/ScrollRevealSection.astro'
import CoachesHighlightsCarousel from '../components/CoachesHighlightsCarousel.astro'
import TestimonialsSlider from '../components/TestimonialsSlider.astro'

// Testimonials for teams = a mix (coaches, players and parents; from the bank)
const teamTestimonials = [
  { quote: 'Both my grassroots teams have massively benefited. I have been with you for years, thank you.', name: 'Matthew B.', role: 'Grassroots Coach' },
  { quote: 'Absolutely full of key coaching points, with the explanation of why things need to be coached a certain way. I have learned so much from you guys here.', name: 'Krzysztof S.', role: 'Coach, U11s' },
  { quote: 'Love the content on here so far. Looking forward to learning more to help both my teams.', name: 'Chris', role: 'Coach' },
  { quote: 'You are great, thanks for the help. This is the first video I saw in this app and it already helped.', name: 'Josh P.', role: 'Player' },
  { quote: 'Because of you and the content you provide, I now help local players aged 6 to 16 with their technical development. You have truly helped my players and me.', name: 'Matthew H.', role: 'Parent & Volunteer Coach' },
  { quote: 'Great drills. I used this for an 8 year old and adapted the spacing. We are on to day one of the dribbling challenge.', name: 'Carlos T.', role: 'Coach' },
]

// Sliding trust ticker facts (shared style with /app/for-coaches and /programmes)
const tickerFacts = [
  'Voted Top 10 In The World For Technical Training',
  '50,000+ Downloads',
  '15+ Countries',
  '2,000+ Training Videos',
  '20+ Years Coaching',
  'Grassroots To Professional Videos',
]

// Team feature carousel. Live text sits over the lower-left third so the
// supplied imagery stays clean and the feature copy remains responsive.
const teamSlides = [
  {
    image: '/images/teams/features/set-assignments.webp',
    title: 'Set Assignments',
    note: 'Send training tasks to every player from one place.',
    alt: 'A player completing football training beside the JF Teams assignment dashboard',
  },
  {
    image: '/images/teams/features/max-plan-for-all.webp',
    title: 'Max Plan For All',
    note: 'Give every coach and player access to the full Joner Football App.',
    alt: 'A coach with players beside the Joner Football App on phone and tablet',
  },
  {
    image: '/images/teams/features/leaderboard.webp',
    title: 'Leaderboard',
    note: 'Create accountability with points, rankings and healthy competition.',
    alt: 'Two football players competing beside the JF Teams leaderboard',
  },
  {
    image: '/images/teams/features/club-management.webp',
    title: 'Club Management',
    note: 'Manage every team and coach from one dashboard.',
    alt: 'A coach on the pitch beside the JF Teams club management dashboard',
  },
  {
    image: '/images/teams/features/ask-joner.webp',
    title: 'Ask Joner',
    note: 'Get direct access to Joner for session and player advice.',
    alt: 'A coach answering a player question in Ask Joner beside players on the pitch',
  },
]

// "Who is it for" scroll-reveal callouts (mirrors the coaches page)
const whoItsFor = [
  { label: 'Clubs', side: 'left', top: '26%' },
  { label: 'Teams', side: 'right', top: '44%' },
  { label: 'Academies', side: 'left', top: '64%' },
  { label: 'Full Organisation', side: 'right', top: '82%' }
]

const teamSEOFAQs = [
  { q: 'What is JF Teams?', a: 'JF Teams combines full Joner Football App access with a dedicated Teams Dashboard, giving players and coaches one connected platform for training, assignments, tracking, communication and planning.' },
  { q: 'How do coaches set work for players?', a: 'Coaches set assignments for the whole group to do at home. An assignment can come from the Joner Football App, a YouTube link, an external link, or a simple note written by the coach.' },
  { q: 'How do you track if players are actually doing it?', a: 'Players earn points on the team leaderboard when they complete an assignment, and they can upload photo proof of the work for extra points. That gives coaches real visibility instead of guessing whether homework sent by message was done.' },
  { q: 'What do coaches get with JF Teams?', a: 'Every coach gets the full Max Plan content library inside the Joner Football App, including detailed session plans, voice over training drills and hundreds of training videos. Coaches also get two session planners and Ask Joner, which is direct access to Lee Jones.' },
  { q: 'Can a large club manage multiple teams?', a: 'Yes. The managers dashboard lets you manage every team in your organisation from one place and assign coaches to specific teams.' },
  { q: 'How much does JF Teams cost?', a: 'Pricing depends on squad size and coach access. Email teams@jonerfootball.com or send the enquiry form with your numbers and Joner Football will come back with the right package for your club.' },
  { q: 'How does a club get started?', a: 'Email teams@jonerfootball.com or send the enquiry form with your club, squad size and coach numbers. Joner Football will book a demo and set up the cleanest option for your organisation.' },
]

const schema = [
  webPageSchema({
    name: 'JF Teams | Player And Coach Development For Clubs | Joner Football',
    description: 'JF Teams develops every player and supports every coach. Set assignments, track completion with points and photo proof, plan sessions and manage every team in one place.',
    url: 'https://jonerfootball.com/teams/',
  }),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'JF Teams',
    provider: { '@type': 'Organization', name: 'Joner Football' },
    serviceType: 'Football team training and player development platform',
    areaServed: 'Worldwide',
  },
  breadcrumbSchema([
    { name: 'Home', url: 'https://jonerfootball.com/' },
    { name: 'Football Training App', url: 'https://jonerfootball.com/app/' },
    { name: 'JF Teams', url: 'https://jonerfootball.com/teams/' },
  ]),
  faqSchema(teamSEOFAQs),
]

import SanityPageRenderer from '../components/sanity/SanityPageRenderer.astro'
import { fetchSanityPage } from '../lib/sanityPages'
import { getSanityText, shouldReplaceSanityPage } from '../lib/sanityPageUtils'

const sanityPage = await fetchSanityPage('teams')
const pageTitle = sanityPage?.seo?.title || 'JF Teams | Player And Coach Development For Clubs | Joner Football'
const pageDescription = sanityPage?.seo?.description || 'JF Teams develops every player and supports every coach. Set assignments, track completion, plan sessions and manage every team in one place.'
const heroEyebrow = getSanityText(sanityPage?.heroEyebrow, 'JF Teams')
const heroHeadline = getSanityText(sanityPage?.heroHeadline, 'Develop Every Player. Support Every Coach.')
---

{shouldReplaceSanityPage(sanityPage) ? (
  <SanityPageRenderer page={sanityPage} />
) : (
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={sanityPage?.seo?.canonicalUrl}
  ogImage={sanityPage?.seo?.imageUrl || undefined}
  noindex={Boolean(sanityPage?.seo?.noIndex)}
  schema={schema}
>

  <main class="teams-page bg-joner-black text-white">
    {/* HERO (full-bleed, mirrors the coaches hero, single CTA) */}
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 bg-joner-black">
        <video
          class="h-full w-full object-cover object-center"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster="/videos/team-training-web-hero-poster.jpg"
          aria-hidden="true"
        >
          <source src="/videos/team-training-web-hero.mp4" type="video/mp4" />
        </video>
        <div class="absolute inset-0 bg-gradient-to-r from-joner-black/95 via-joner-black/55 to-joner-black/15"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-joner-black/55 via-transparent to-transparent"></div>
      </div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center min-h-[440px] md:min-h-[520px] py-14 md:py-16">
        <div class="max-w-2xl">
          {/* The logo is the JF Teams eyebrow (reads JF TEAMS in red), so no duplicate text line under it */}
          <img src="/images/teams/logo/jf-teams-stacked-red.svg" alt={heroEyebrow} class="h-24 sm:h-28 md:h-32 w-auto mb-6" width="150" height="150" loading="eager" />
          <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl font-bold text-white uppercase leading-none mb-5">{heroHeadline}</h1>
          <p class="text-gray-200 font-body text-lg md:text-xl max-w-xl mb-7">Set the work and track who is actually doing it. Every coach gets the full Max Plan library, session planners and Ask Joner.</p>
          <div>
            <a href="#team-subscription-form" class="btn-red text-base px-8 py-4 inline-flex text-center">BOOK A DEMO</a>
          </div>
        </div>
      </div>
    </section>

    <FactsMarquee facts={tickerFacts} />

    {/* WATCH THIS FIRST. JF Teams demo video. */}
    <section class="bg-joner-black py-12 md:py-16">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
        <p class="mb-3 font-heading text-xs uppercase tracking-[0.28em] text-joner-red sm:text-sm">Watch This First</p>
        <h2 class="mb-6 font-heading text-2xl md:text-4xl font-bold uppercase leading-tight text-white">See how JF Teams work.</h2>
        <PlayButtonVideo src="/videos/jf-teams-demo-video.mp4" poster="/images/teams/jf-teams-demo-video-poster.jpg" label="Play the Joner Football Teams demo video" playPosition="top-right" />
      </div>
    </section>

    {/* SOLUTION: swipeable feature carousel with live lower-third text */}
    <CoachesHighlightsCarousel heading="What Your Squad Gets" slides={teamSlides} featureOverlay />

    {/* DASHBOARD OVERVIEW (full infographic supplied by Lee) */}
    <section id="teams-dashboard-overview" class="bg-joner-black pb-12 md:pb-20 scroll-mt-20" aria-labelledby="teams-dashboard-overview-heading">
      <h2 id="teams-dashboard-overview-heading" class="sr-only">Teams Dashboard Overview</h2>
      <p class="px-4 pb-3 font-heading text-xs uppercase tracking-[0.2em] text-white/70 md:hidden">Swipe to explore the dashboard</p>
      <div
        class="overflow-x-auto overscroll-x-contain border-y border-white/10 bg-[#f3f4f6]"
        role="region"
        aria-label="Scrollable Teams dashboard overview"
        tabindex="0"
      >
        <img
          src="/images/teams/teams-dashboard-overview.webp"
          alt="Teams Dashboard Overview showing the club manager home screen with callouts for the team calendar, Joner Football App access, session planner, Ask Joner, leaderboard, team chat, training assignments, multiple team management and player progress tracking"
          class="block h-auto w-full min-w-[1100px] md:min-w-0"
          width="2858"
          height="1600"
          loading="lazy"
        />
      </div>
    </section>

    {/* WHO IS IT FOR (scroll-reveal, mirrors the coaches page) */}
    <ScrollRevealSection
      eyebrow="WHO IS IT FOR?"
      heading="Built For Every Setup"
      mobileImage="/images/teams/who-its-for-mobile.jpg"
      desktopImage="/images/teams/who-its-for-desktop.jpg"
      items={whoItsFor}
      alt="Lee Jones coaching a team"
    />

    {/* WHO IS TEACHING YOU (matches the coaches page exactly: mobile baked graphic, desktop live text + photo) */}
    <section class="bg-joner-gray py-12 md:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        {/* MOBILE: complete graphic (heading, bio and quote baked in) */}
        <div class="lg:hidden">
          <img src="/images/teams/lee-teaching-mobile-teams.jpg" alt="Who is teaching you: Lee Jones, over 20 years coaching, founder of Joner Football, trusted by players and coaches worldwide" class="w-full rounded-2xl shadow-2xl" loading="lazy" />
          <div class="text-center mt-7">
            <a href="#team-subscription-form" class="btn-red text-base px-8 py-4 inline-flex">BOOK A DEMO</a>
          </div>
        </div>
        {/* DESKTOP: live text (matches the mobile graphic) + clean coaching photo */}
        <div class="hidden lg:grid grid-cols-2 gap-16">
          <div class="flex flex-col justify-center">
            <p class="text-joner-red font-heading text-sm uppercase tracking-widest mb-3">WHO IS TEACHING YOU</p>
            <h2 class="font-heading text-4xl md:text-5xl font-bold text-white uppercase leading-tight mb-4">LEE JONES.</h2>
            <p class="text-gray-300 font-body text-lg mb-4">Over 20 years coaching players, coaches, and parents around the world. From grassroots kids to professional players.</p>
            <p class="font-heading text-joner-red text-xl uppercase italic leading-snug mb-4">Built by Lee Jones, trusted by players and coaches worldwide.</p>
            <p class="text-gray-300 font-body text-base leading-relaxed mb-6">I have been coaching for 20 years and I get the same question every time. How do you develop players away from normal club training, and how do you track if they are actually doing it? That is exactly why I built JF Teams, so your players keep developing away from sessions and your coaches have a clear, trusted library behind them every week.</p>
            <blockquote class="border-l-4 border-joner-red pl-5 py-2 mb-8">
              <p class="font-heading text-xl md:text-2xl text-white italic leading-snug">"My intention with JF Teams has always been simple. Make player development more structured, more consistent, and easier to manage in one place."</p>
              <footer class="mt-3">
                <p class="font-heading text-base text-white not-italic">Lee Jones</p>
                <p class="text-[#999999] text-xs uppercase tracking-widest font-heading mt-1">Founder, Joner Football</p>
              </footer>
            </blockquote>
            <a href="#team-subscription-form" class="btn-red text-base px-8 py-4 inline-flex self-start">BOOK A DEMO</a>
          </div>
          <div class="overflow-hidden rounded-lg shadow-2xl">
            <img src="/images/teams/lee-about-desktop.jpg" alt="Lee Jones holding a ball at a Joner Football session" class="w-full h-full object-cover object-center" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    {/* TESTIMONIALS (mirrors the coaches page; reuses the existing coach feedback until club video testimonials come in) */}
    <TestimonialsSlider heading="Testimonials" items={teamTestimonials} />

    <aside class="border-y border-neutral-800 bg-black py-7 text-white" aria-label="Joner Football reviews">
      <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-4 px-4 sm:px-6 md:flex-row md:items-center lg:px-8">
        <p class="font-heading text-xl font-bold uppercase md:text-2xl">See verified player, parent, coach and team feedback.</p>
        <a href="/reviews/" class="btn-red shrink-0 px-7 py-4 text-center text-sm">READ ALL REVIEWS</a>
      </div>
    </aside>

    <!-- Contact Form -->
    <section id="team-subscription-form" class="bg-neutral-950 py-20 md:py-28 scroll-mt-24">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <div class="mb-12 text-center">
          <img src="/images/teams/logo/jf-teams-stacked-red.svg" alt="JF Teams" class="mx-auto h-16 md:h-20 w-auto mb-6" width="110" height="110" loading="lazy" />
          <h2 class="font-heading text-4xl font-black uppercase leading-none text-white sm:text-5xl">Book Your Team Demo</h2>
          <p class="mx-auto mt-5 max-w-xl font-body text-base leading-relaxed text-neutral-400">
            Tell us about your squad and we will show you exactly how it works. You can also email us at <a href="mailto:teams@jonerfootball.com" class="text-white underline underline-offset-4 hover:text-joner-red transition-colors">teams@jonerfootball.com</a> to see the packages.
          </p>
        </div>

      <form id="team-subscription-enquiry-form" class="space-y-6 border border-gray-800 bg-joner-black p-5 md:p-8">
        <input type="hidden" name="enquiryType" value="team-subscriptions" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="team-name" class="block text-white font-heading text-sm uppercase tracking-wider mb-2">Your Name</label>
            <input id="team-name" type="text" name="name" placeholder="Your name" required class="w-full bg-joner-gray border border-gray-700 text-white px-4 py-3 font-body text-base sm:text-sm focus:outline-none focus:border-joner-red placeholder-gray-500 min-h-[44px]" />
          </div>
          <div>
            <label for="team-club" class="block text-white font-heading text-sm uppercase tracking-wider mb-2">Club / Team</label>
            <input id="team-club" type="text" name="clubTeam" placeholder="Club or team name" required class="w-full bg-joner-gray border border-gray-700 text-white px-4 py-3 font-body text-base sm:text-sm focus:outline-none focus:border-joner-red placeholder-gray-500 min-h-[44px]" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="team-players" class="block text-white font-heading text-sm uppercase tracking-wider mb-2">Number of Players</label>
            <input id="team-players" type="number" name="numberOfPlayers" placeholder="e.g. 25" min="1" required class="w-full bg-joner-gray border border-gray-700 text-white px-4 py-3 font-body text-base sm:text-sm focus:outline-none focus:border-joner-red placeholder-gray-500 min-h-[44px]" />
          </div>
          <div>
            <label for="team-coaches" class="block text-white font-heading text-sm uppercase tracking-wider mb-2">Number of Coaches</label>
            <input id="team-coaches" type="number" name="numberOfCoaches" placeholder="e.g. 3" min="0" required class="w-full bg-joner-gray border border-gray-700 text-white px-4 py-3 font-body text-base sm:text-sm focus:outline-none focus:border-joner-red placeholder-gray-500 min-h-[44px]" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="team-phone" class="block text-white font-heading text-sm uppercase tracking-wider mb-2">Mobile Number</label>
            <input id="team-phone" type="tel" name="phone" placeholder="Mobile number" required class="w-full bg-joner-gray border border-gray-700 text-white px-4 py-3 font-body text-base sm:text-sm focus:outline-none focus:border-joner-red placeholder-gray-500 min-h-[44px]" />
          </div>
          <div>
            <label for="team-email" class="block text-white font-heading text-sm uppercase tracking-wider mb-2">Email</label>
            <input id="team-email" type="email" name="email" placeholder="Email address" required class="w-full bg-joner-gray border border-gray-700 text-white px-4 py-3 font-body text-base sm:text-sm focus:outline-none focus:border-joner-red placeholder-gray-500 min-h-[44px]" />
          </div>
        </div>

        <div>
          <label for="team-location" class="block text-white font-heading text-sm uppercase tracking-wider mb-2">Location</label>
          <input id="team-location" type="text" name="location" placeholder="City, state, country" required class="w-full bg-joner-gray border border-gray-700 text-white px-4 py-3 font-body text-base sm:text-sm focus:outline-none focus:border-joner-red placeholder-gray-500 min-h-[44px]" />
        </div>

        <p id="team-subscription-form-status" class="hidden font-body text-sm"></p>
        <button type="submit" class="btn-red w-full text-sm">Book My Demo</button>
      </form>
    </div>
  </section>
  </main>

  <script is:inline>
    (function () {
      var form = document.getElementById('team-subscription-enquiry-form');
      if (!form) return;
      var submit = form.querySelector('button[type="submit"]');
      var status = document.getElementById('team-subscription-form-status');
      var submitted = false;

      function setStatus(message, ok) {
        if (!status) return;
        status.textContent = message || '';
        status.className = message ? 'font-body text-sm ' + (ok ? 'text-green-400' : 'text-amber-400') : 'hidden font-body text-sm';
      }

      form.addEventListener('submit', function (event) {
        event.preventDefault();
        if (submitted) {
          setStatus('Your enquiry has already been sent. We will follow up with you shortly.', true);
          return;
        }
        setStatus('', true);
        var originalText = submit ? submit.textContent : 'Book My Demo';
        var formData = new FormData(form);
        var emailInput = form.querySelector('input[name="email"]');

        if (window.JonerEmailGuard && emailInput) {
          var validation = window.JonerEmailGuard.validateEmail(formData.get('email'));
          window.JonerEmailGuard.setFeedback(emailInput, validation);
          if (!validation.valid) {
            emailInput.reportValidity();
            return;
          }
        }

        if (submit) {
          submit.disabled = true;
          submit.textContent = 'Sending...';
          submit.classList.add('opacity-70', 'cursor-not-allowed');
        }

        var payload = {};
        formData.forEach(function (value, key) { payload[key] = value; });
        payload.marketingOptIn = true;
        payload.message = 'JF Teams demo request';
        payload.landing_page = window.location.href;
        payload.referrer = document.referrer || '';
        if (window.JonerTracking && typeof window.JonerTracking.collectTrackingParams === 'function') {
          window.JonerTracking.collectTrackingParams().forEach(function (value, key) {
            if (value) payload[key] = value;
          });
        }

        var tokenPromise = window.JonerRecaptcha && window.JonerRecaptcha.getToken
          ? window.JonerRecaptcha.getToken('contact')
          : Promise.resolve('');

        tokenPromise.then(function (token) {
          payload.recaptchaToken = token;
          return fetch('/api/contact-enquiry', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
        })
        .then(function (response) { return response.json(); })
        .then(function (data) {
          if (!data || !data.success) throw new Error((data && data.error) || 'Could not send enquiry.');
          submitted = true;
          if (window.JonerTracking && typeof window.JonerTracking.trackEvent === 'function') {
            window.JonerTracking.trackEvent('team_subscription_interest', {
              custom_data: {
                form_id: 'team-subscription-enquiry-form',
                page_path: '/teams',
                persistence_status: 'confirmed'
              },
              user_data: {
                email: payload.email,
                phone: payload.phone
              }
            });
          }
          form.reset();
          setStatus('Done. Your demo request has been sent. We will be in touch to book a time.', true);
        })
        .catch(function (error) {
          setStatus(error && error.message ? error.message : 'Could not send enquiry. Please try again.', false);
        })
        .finally(function () {
          if (submit && !submitted) {
            submit.disabled = false;
            submit.textContent = originalText;
            submit.classList.remove('opacity-70', 'cursor-not-allowed');
          } else if (submit && submitted) {
            submit.disabled = true;
            submit.textContent = 'Demo Requested';
          }
        });
      });
    })();
  </script>

  <GeoAnswers
    title="JF Teams, at a glance."
    intro="One platform connecting player development, coach development and team management."
    blocks={[
      {
        heading: 'Who this is for',
        body: 'For clubs, academies, schools and football organisations that want to extend player development beyond team sessions.',
      },
      {
        heading: 'What you get',
        body: 'Full Joner Football App access for every seat, plus the Teams Dashboard for assignments, tracking, communication, planning and team management.',
      },
      {
        heading: 'Why it works',
        body: 'Players train from the same content their coaches use. Coaches assign and track development, keeping training connected between team sessions.',
      },
      {
        heading: 'Best next step',
        body: 'Book a demo to see the platform in action. We will learn about your organisation and prepare a tailored proposal for your team.',
      },
    ]}
    ctaHref="#team-subscription-form"
    ctaLabel="Book A Demo"
    links={[
      { label: 'The football training app', href: '/app' },
      { label: 'App for coaches', href: '/app/for-coaches' },
      { label: '100 Day Programme', href: '/programmes' },
      { label: 'Coaches course', href: '/workshops/coaches-course' },
    ]}
  />

  <SEOFAQ
    title="Questions about JF Teams."
    intro="Everything you need to know about access, assignments, tracking, team management and getting started."
    items={teamSEOFAQs}
  />

  <SanityPageExtras page={sanityPage} />

  {/* Match the coaches/programmes display typography (Kanit italic), scoped to this page */}
  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Kanit:ital,wght@1,600;1,900&display=swap');
    .teams-page .font-heading,
    .teams-page :is(h1, h2, h3) {
      font-family: 'Kanit', 'Anton', Impact, sans-serif;
      font-style: italic;
    }
    .teams-page :is(h1, h2, h3) { font-weight: 900; letter-spacing: -0.015em; }
  </style>

</BaseLayout>
)}
