---
import BaseLayout from '../layouts/BaseLayout.astro'
import FactsMarquee from '../components/FactsMarquee.astro'
import SEOFAQ from '../components/SEOFAQ.astro'
import GeoAnswers from '../components/GeoAnswers.astro'
import { faqSchema, webPageSchema, breadcrumbSchema } from '../lib/seoSchema'
import SanityPageExtras from '../components/sanity/SanityPageExtras.astro'
import PlayButtonVideo from '../components/PlayButtonVideo.astro'
import ScrollRevealSection from '../components/ScrollRevealSection.astro'

// Sliding trust ticker facts (shared style with /app/for-coaches and /programmes)
const tickerFacts = [
  'Voted Top 10 In The World For Technical Training',
  '50,000+ Downloads',
  '15+ Countries',
  '1,500+ Training Videos',
  '20+ Years Coaching',
  'Grassroots To Professional Videos',
]

// Problem section cards (the days in between)
const problems = [
  { title: 'Training Nights Are Not Enough', body: 'Most players need more touches than team sessions can give them.' },
  { title: 'Off-Season Drop-Off Is Real', body: 'Players improve during the season, then lose rhythm when training stops.' },
  { title: 'Coaches Need A Way To Guide Homework', body: 'Without a clear plan, players either do nothing or train the wrong things.' }
]

// "Who is it for" scroll-reveal callouts (mirrors the coaches page)
const whoItsFor = [
  { label: 'Clubs', side: 'left', top: '26%' },
  { label: 'Teams', side: 'right', top: '44%' },
  { label: 'Academies', side: 'left', top: '64%' },
  { label: 'Full Organisation', side: 'right', top: '82%' }
]

const teamSEOFAQs = [
  { q: 'Can a full team use the Joner Football App?', a: 'Yes. Joner Football can support team and club subscriptions so every player gets access to the same training detail, programmes and app pathway.' },
  { q: 'Who are team subscriptions for?', a: 'They are built for clubs, academies, schools and coaches who want players doing better work between team sessions.' },
  { q: 'Do coaches get access with a team subscription?', a: 'Yes. Coach access is part of the setup, so coaches can use session plans, drills and coaching detail that match what their players train in the app.' },
  { q: 'How much does a team subscription cost?', a: 'Pricing depends on squad size and coach access. Send the enquiry form with your numbers and Joner Football will come back with the right option for your club.' },
  { q: 'How does a team get started?', a: 'Send an enquiry with your club, squad size and coach access needs. Joner Football will follow up with the cleanest setup for your players.' },
]

const schema = [
  webPageSchema({
    name: 'Football Team Training App | Club Subscriptions | Joner Football',
    description: 'Give your football team access to Joner Football training. Team subscriptions help players train with clearer drills, programmes and coach-led detail.',
    url: 'https://jonerfootball.com/teams/',
  }),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Joner Football Team Subscriptions',
    provider: { '@type': 'Organization', name: 'Joner Football' },
    serviceType: 'Football team training app subscription',
    areaServed: 'Worldwide',
  },
  breadcrumbSchema([
    { name: 'Home', url: 'https://jonerfootball.com/' },
    { name: 'Football Training App', url: 'https://jonerfootball.com/app/' },
    { name: 'Team Subscriptions', url: 'https://jonerfootball.com/teams/' },
  ]),
  faqSchema(teamSEOFAQs),
]

import SanityPageRenderer from '../components/sanity/SanityPageRenderer.astro'
import { fetchSanityPage } from '../lib/sanityPages'
import { getSanityText, shouldReplaceSanityPage } from '../lib/sanityPageUtils'

const sanityPage = await fetchSanityPage('teams')
const pageTitle = sanityPage?.seo?.title || 'Football Team Training App and Club Subscriptions | Joner Football'
const pageDescription = sanityPage?.seo?.description || 'Team and club subscriptions for the Joner Football App. Give players clear drills, coach resources and training to follow between sessions.'
const heroEyebrow = getSanityText(sanityPage?.heroEyebrow, 'Team and Club Subscriptions')
const heroHeadline = getSanityText(sanityPage?.heroHeadline, 'Train Your Whole Squad With One App')
---

{shouldReplaceSanityPage(sanityPage) ? (
  <SanityPageRenderer page={sanityPage} />
) : (
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={sanityPage?.seo?.canonicalUrl}
  ogImage={sanityPage?.seo?.imageUrl || undefined}
  noindex={Boolean(sanityPage?.seo?.noIndex)}
  schema={schema}
>

  <main class="teams-page bg-joner-black text-white">
    {/* HERO (full-bleed, mirrors the coaches hero, single CTA) */}
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 bg-joner-black">
        <video
          class="h-full w-full object-cover object-center"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster="/videos/team-training-web-hero-poster.jpg"
          aria-hidden="true"
        >
          <source src="/videos/team-training-web-hero.mp4" type="video/mp4" />
        </video>
        <div class="absolute inset-0 bg-gradient-to-r from-joner-black/95 via-joner-black/55 to-joner-black/15"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-joner-black/55 via-transparent to-transparent"></div>
      </div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center min-h-[440px] md:min-h-[520px] py-14 md:py-16">
        <div class="max-w-2xl">
          <p class="text-joner-red font-heading text-sm uppercase tracking-widest mb-5">{heroEyebrow}</p>
          <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl font-bold text-white uppercase leading-none mb-5">{heroHeadline}</h1>
          <p class="text-gray-200 font-body text-lg md:text-xl max-w-xl mb-7">Give your whole club one clean setup. Every player training between sessions.</p>
          <div>
            <a href="#team-subscription-form" class="btn-red text-base px-8 py-4 inline-flex text-center">BOOK A DEMO</a>
          </div>
        </div>
      </div>
    </section>

    <FactsMarquee facts={tickerFacts} />

    {/* WATCH THIS FIRST. Team subscriptions video. */}
    <section class="bg-joner-black py-12 md:py-16">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
        <p class="mb-3 font-heading text-xs uppercase tracking-[0.28em] text-joner-red sm:text-sm">Watch This First</p>
        <h2 class="mb-6 font-heading text-2xl md:text-4xl font-bold uppercase leading-tight text-white">See how team subscriptions work.</h2>
        <PlayButtonVideo src="/videos/team-subscriptions.mp4" poster="/images/teams/team-subs-thumbnail.jpg" label="Play the team subscriptions video" />
      </div>
    </section>

    {/* PROBLEM (the days in between) */}
    <section class="bg-joner-black py-16 md:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mb-10 md:mb-14">
          <p class="text-joner-red font-heading text-sm uppercase tracking-widest mb-4">THE REALITY</p>
          <h2 class="font-heading text-4xl md:text-6xl font-bold text-white uppercase leading-none mb-6">Team Training Is Not Enough</h2>
          <p class="font-body text-lg text-gray-300 max-w-2xl">Your players are with you 2 or 3 days a week. The days in between are where they pull ahead, or fall behind.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {problems.map((p) => (
            <article class="bg-joner-gray border border-gray-800 rounded-2xl p-6">
              <h3 class="font-heading text-xl text-white uppercase leading-tight mb-3 tracking-wide">{p.title}</h3>
              <p class="text-gray-300 font-body text-sm leading-relaxed">{p.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* WHO IS IT FOR (scroll-reveal, mirrors the coaches page) */}
    <ScrollRevealSection
      eyebrow="WHO IS IT FOR?"
      heading="Built For Every Setup"
      mobileImage="/images/teams/who-its-for-mobile.jpg"
      desktopImage="/images/teams/who-its-for-desktop.jpg"
      items={whoItsFor}
      alt="Lee Jones coaching a team"
    />

    {/* SOLUTION (how it works: whole squad in the app, private community, coach sends the work) */}
    <section class="bg-joner-black py-16 md:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mb-10 md:mb-14">
          <p class="text-joner-red font-heading text-sm uppercase tracking-widest mb-4">THE SOLUTION</p>
          <h2 class="font-heading text-4xl md:text-6xl font-bold text-white uppercase leading-none mb-6">One App For Your Whole Squad</h2>
          <p class="font-body text-lg text-gray-300 max-w-2xl">Every player training between sessions, a private space for your team, and you guiding the work. One clean setup.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          <article class="bg-joner-gray border border-gray-800 rounded-2xl p-6">
            <span class="inline-flex w-12 h-12 rounded-full bg-joner-red/10 text-joner-red items-center justify-center mb-4">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/></svg>
            </span>
            <h3 class="font-heading text-xl text-white uppercase leading-tight mb-3 tracking-wide">Every Player Gets The App</h3>
            <p class="text-gray-300 font-body text-sm leading-relaxed">The full Joner Football App for your whole squad. The 100 Day Programme, ball mastery, finishing and more, ready to train at home.</p>
          </article>

          <article class="bg-joner-gray border border-gray-800 rounded-2xl p-6">
            <span class="inline-flex w-12 h-12 rounded-full bg-joner-red/10 text-joner-red items-center justify-center mb-4">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </span>
            <h3 class="font-heading text-xl text-white uppercase leading-tight mb-3 tracking-wide">Your Own Team Community</h3>
            <p class="text-gray-300 font-body text-sm leading-relaxed">A private team space inside the app. One place for your squad to train together, in season and off.</p>
          </article>

          <article class="bg-joner-gray border border-gray-800 rounded-2xl p-6">
            <span class="inline-flex w-12 h-12 rounded-full bg-joner-red/10 text-joner-red items-center justify-center mb-4">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg>
            </span>
            <h3 class="font-heading text-xl text-white uppercase leading-tight mb-3 tracking-wide">You Send The Work</h3>
            <p class="text-gray-300 font-body text-sm leading-relaxed">Send drills, programmes and homework straight to your players. Guide exactly what they work on between sessions.</p>
          </article>
        </div>

        <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div class="rounded-2xl border border-gray-800 bg-joner-gray/40 p-6">
            <p class="font-heading text-joner-red text-sm uppercase tracking-widest mb-2">In Season</p>
            <p class="text-gray-300 font-body text-sm leading-relaxed">Send homework based on what each player needs that week.</p>
          </div>
          <div class="rounded-2xl border border-gray-800 bg-joner-gray/40 p-6">
            <p class="font-heading text-joner-red text-sm uppercase tracking-widest mb-2">Off Season</p>
            <p class="text-gray-300 font-body text-sm leading-relaxed">Assign programmes so players keep improving when the team is not training.</p>
          </div>
        </div>

        <div class="mt-12">
          <a href="#team-subscription-form" class="btn-red text-base px-8 py-4 inline-flex">BOOK A DEMO</a>
        </div>
      </div>
    </section>

    {/* WHO IS TEACHING YOU (clean photo + live text, responsive, no baked graphic) */}
    <section class="bg-joner-gray py-12 md:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
          <div class="order-2 lg:order-1 flex flex-col justify-center">
            <p class="text-joner-red font-heading text-sm uppercase tracking-widest mb-3">WHO IS TEACHING YOU</p>
            <h2 class="font-heading text-4xl md:text-5xl font-bold text-white uppercase leading-tight mb-4">LEE JONES.</h2>
            <p class="text-gray-300 font-body text-lg mb-6">Over 20 years coaching players, coaches, and parents around the world. From grassroots kids to professional players.</p>
            <blockquote class="border-l-4 border-joner-red pl-5 py-2 mb-8">
              <p class="font-heading text-xl md:text-2xl text-white italic leading-snug">"I built this app to spread the knowledge for all coaches around the world."</p>
              <footer class="mt-3">
                <p class="font-heading text-base text-white not-italic">Lee Jones</p>
                <p class="text-[#999999] text-xs uppercase tracking-widest font-heading mt-1">Founder, Joner Football</p>
              </footer>
            </blockquote>
            <a href="#team-subscription-form" class="btn-red text-base px-8 py-4 inline-flex self-start">BOOK A DEMO</a>
          </div>
          <div class="order-1 lg:order-2 overflow-hidden rounded-2xl shadow-2xl">
            <img src="/images/programmes/lee-hero-jf.jpg" alt="Lee Jones coaching at a Joner Football session" class="w-full h-full object-cover object-[70%_50%]" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Form -->
    <section id="team-subscription-form" class="bg-neutral-950 py-20 md:py-28 scroll-mt-24">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <div class="mb-12 text-center">
          <p class="mb-3 font-heading text-xs uppercase tracking-[0.28em] text-joner-red">Team Subscriptions</p>
          <h2 class="font-heading text-4xl font-black uppercase leading-none text-white sm:text-5xl">Book Your Team Demo</h2>
          <p class="mx-auto mt-5 max-w-xl font-body text-base leading-relaxed text-neutral-400">
            Tell us about your squad and we will show you exactly how it works.
          </p>
        </div>

      <form id="team-subscription-enquiry-form" class="space-y-6 border border-gray-800 bg-joner-black p-5 md:p-8">
        <input type="hidden" name="enquiryType" value="team-subscriptions" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="team-name" class="block text-white font-heading text-sm uppercase tracking-wider mb-2">Your Name</label>
            <input id="team-name" type="text" name="name" placeholder="Your name" required class="w-full bg-joner-gray border border-gray-700 text-white px-4 py-3 font-body text-base sm:text-sm focus:outline-none focus:border-joner-red placeholder-gray-500 min-h-[44px]" />
          </div>
          <div>
            <label for="team-club" class="block text-white font-heading text-sm uppercase tracking-wider mb-2">Club / Team</label>
            <input id="team-club" type="text" name="clubTeam" placeholder="Club or team name" required class="w-full bg-joner-gray border border-gray-700 text-white px-4 py-3 font-body text-base sm:text-sm focus:outline-none focus:border-joner-red placeholder-gray-500 min-h-[44px]" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="team-players" class="block text-white font-heading text-sm uppercase tracking-wider mb-2">Number of Players</label>
            <input id="team-players" type="number" name="numberOfPlayers" placeholder="e.g. 25" min="1" required class="w-full bg-joner-gray border border-gray-700 text-white px-4 py-3 font-body text-base sm:text-sm focus:outline-none focus:border-joner-red placeholder-gray-500 min-h-[44px]" />
          </div>
          <div>
            <label for="team-coaches" class="block text-white font-heading text-sm uppercase tracking-wider mb-2">Number of Coaches</label>
            <input id="team-coaches" type="number" name="numberOfCoaches" placeholder="e.g. 3" min="0" required class="w-full bg-joner-gray border border-gray-700 text-white px-4 py-3 font-body text-base sm:text-sm focus:outline-none focus:border-joner-red placeholder-gray-500 min-h-[44px]" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="team-phone" class="block text-white font-heading text-sm uppercase tracking-wider mb-2">Mobile Number</label>
            <input id="team-phone" type="tel" name="phone" placeholder="Mobile number" required class="w-full bg-joner-gray border border-gray-700 text-white px-4 py-3 font-body text-base sm:text-sm focus:outline-none focus:border-joner-red placeholder-gray-500 min-h-[44px]" />
          </div>
          <div>
            <label for="team-email" class="block text-white font-heading text-sm uppercase tracking-wider mb-2">Email</label>
            <input id="team-email" type="email" name="email" placeholder="Email address" required class="w-full bg-joner-gray border border-gray-700 text-white px-4 py-3 font-body text-base sm:text-sm focus:outline-none focus:border-joner-red placeholder-gray-500 min-h-[44px]" />
          </div>
        </div>

        <div>
          <label for="team-location" class="block text-white font-heading text-sm uppercase tracking-wider mb-2">Location</label>
          <input id="team-location" type="text" name="location" placeholder="City, state, country" required class="w-full bg-joner-gray border border-gray-700 text-white px-4 py-3 font-body text-base sm:text-sm focus:outline-none focus:border-joner-red placeholder-gray-500 min-h-[44px]" />
        </div>

        <p id="team-subscription-form-status" class="hidden font-body text-sm"></p>
        <button type="submit" class="btn-red w-full text-sm">Book My Demo</button>
      </form>
    </div>
  </section>
  </main>

  <script is:inline>
    (function () {
      var form = document.getElementById('team-subscription-enquiry-form');
      if (!form) return;
      var submit = form.querySelector('button[type="submit"]');
      var status = document.getElementById('team-subscription-form-status');
      var submitted = false;

      function setStatus(message, ok) {
        if (!status) return;
        status.textContent = message || '';
        status.className = message ? 'font-body text-sm ' + (ok ? 'text-green-400' : 'text-amber-400') : 'hidden font-body text-sm';
      }

      form.addEventListener('submit', function (event) {
        event.preventDefault();
        if (submitted) {
          setStatus('Your enquiry has already been sent. We will follow up with you shortly.', true);
          return;
        }
        setStatus('', true);
        var originalText = submit ? submit.textContent : 'Send Team Subscription Enquiry';
        var formData = new FormData(form);
        var emailInput = form.querySelector('input[name="email"]');

        if (window.JonerEmailGuard && emailInput) {
          var validation = window.JonerEmailGuard.validateEmail(formData.get('email'));
          window.JonerEmailGuard.setFeedback(emailInput, validation);
          if (!validation.valid) {
            emailInput.reportValidity();
            return;
          }
        }

        if (submit) {
          submit.disabled = true;
          submit.textContent = 'Sending...';
          submit.classList.add('opacity-70', 'cursor-not-allowed');
        }

        var payload = {};
        formData.forEach(function (value, key) { payload[key] = value; });
        payload.marketingOptIn = true;
        payload.message = 'Team subscription demo request';

        var tokenPromise = window.JonerRecaptcha && window.JonerRecaptcha.getToken
          ? window.JonerRecaptcha.getToken('contact')
          : Promise.resolve('');

        tokenPromise.then(function (token) {
          payload.recaptchaToken = token;
          return fetch('/api/contact-enquiry', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
        })
        .then(function (response) { return response.json(); })
        .then(function (data) {
          if (!data || !data.success) throw new Error((data && data.error) || 'Could not send enquiry.');
          submitted = true;
          form.reset();
          setStatus('Done. Your demo request has been sent. We will be in touch to book a time.', true);
        })
        .catch(function (error) {
          setStatus(error && error.message ? error.message : 'Could not send enquiry. Please try again.', false);
        })
        .finally(function () {
          if (submit && !submitted) {
            submit.disabled = false;
            submit.textContent = originalText;
            submit.classList.remove('opacity-70', 'cursor-not-allowed');
          } else if (submit && submitted) {
            submit.disabled = true;
            submit.textContent = 'Demo Requested';
          }
        });
      });
    })();
  </script>

  {/* CLOSING CTA (drives back to the demo form) */}
  <section class="bg-joner-black py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="font-heading text-3xl md:text-5xl font-bold text-white uppercase leading-none mb-4">
        See It For Your Squad
      </h2>
      <p class="text-neutral-300 font-body text-lg mb-8 max-w-xl mx-auto">
        Book a quick demo and we will show you exactly how it works for your team.
      </p>
      <a href="#team-subscription-form" class="btn-red text-base px-8 py-4 inline-block">
        Book A Demo
      </a>
    </div>
  </section>

  <GeoAnswers
    title="Team subscriptions, explained fast."
    intro="The short version for club coaches, academies and schools weighing up a team football training app."
    blocks={[
      {
        heading: 'Who this is for',
        body: 'Club coaches, academies, schools and associations that want every player in the squad training properly between team sessions, with one clean setup instead of dozens of individual accounts.',
      },
      {
        heading: 'What you get',
        body: 'Full Joner Football App access for every player, coach access with session plans and drills, and a shared training standard so the whole squad works on first touch, striking and 1v1 ability the same way.',
      },
      {
        heading: 'Why it works',
        body: 'Players only see their coach once or twice a week. A team subscription turns the days in between into structured development time, so players arrive at training sharper and games show it.',
      },
      {
        heading: 'Best next step',
        body: 'Book a team demo with your squad size and coach numbers. Joner Football shows you how it works and sets up the right club option, and you can explore the app yourself first to see what your players would train.',
      },
    ]}
    links={[
      { label: 'Book a demo', href: '#team-subscription-form' },
      { label: 'The football training app', href: '/app' },
      { label: 'App for coaches', href: '/app/for-coaches' },
      { label: '100 Day Programme', href: '/programmes' },
      { label: 'Coaches course', href: '/workshops/coaches-course' },
    ]}
  />

  <SEOFAQ
    title="Questions about team app access."
    intro="For clubs, academies and coaches who want every player training with a clearer plan."
    items={teamSEOFAQs}
  />

  <SanityPageExtras page={sanityPage} />

  {/* Match the coaches/programmes display typography (Kanit italic), scoped to this page */}
  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Kanit:ital,wght@1,600;1,900&display=swap');
    .teams-page .font-heading,
    .teams-page :is(h1, h2, h3) {
      font-family: 'Kanit', 'Anton', Impact, sans-serif;
      font-style: italic;
    }
    .teams-page :is(h1, h2, h3) { font-weight: 900; letter-spacing: -0.015em; }
  </style>

</BaseLayout>
)}
