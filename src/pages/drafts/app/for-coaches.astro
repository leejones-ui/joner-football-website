---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import StickyMobileCta from '../../../components/StickyMobileCta.astro'

const title = 'Coaches Only | Joner Football App'
const description = 'A dedicated Joner Football App tier for coaches who want session plans, coaching points, full training sessions, and the detail behind how Lee coaches.'
const checkoutUrl = 'https://app.jonerfootball.com/checkout/new?o=202578'
const categoryUrl = 'https://app.jonerfootball.com/categories/category-8-7szqoiq00'
const price = '$319.99 AUD per year'
const checkoutEvent = 'CoachesPageClickToCheckout'

const features = [
  ['App And Session Planner Walkthrough', 'See how Lee finds drills, builds sessions, manages difficulty, and plans with purpose.'],
  ['Session Planning', 'Structured coaching plans you can take into your own environment.'],
  ['Voice Over Series', 'Lee explains what he is looking for, why it works, and how to coach the detail.'],
  ['Coaching The Coaches', 'Practical coach development for better language, better standards, and better player outcomes.'],
  ['Full Training Sessions', 'Watch the complete flow of technical work, intensity, detail, and progression.'],
  ['Team Training', 'Ideas for managing groups while keeping individual technique at the centre.'],
  ['Coaching Professionals', 'See the detail and standards used with elite players.'],
  ['Extras', 'Extra resources and behind-the-scenes material to sharpen your coaching eye.']
]

const faqs = [
  ['Who is Coaches Only for?', 'Club coaches, private trainers, academy coaches, parents coaching teams, and anyone who wants more detail in sessions.'],
  ['Is this just drill videos?', 'No. The point is the coaching detail. You get session planning, coaching points, full sessions, voice-over explanations, and examples of Lee working with players.'],
  ['Why yearly only?', 'Coaching improvement needs repetition. The yearly plan gives coaches time to watch, apply, review, and build better habits.'],
  ['Can I use this for team training?', 'Yes. Coaches Only includes team training content and session ideas you can adapt for groups, squads, and private coaching environments.'],
  ['Does it include the rest of the app?', 'Yes. Coaches Only gives access to the coaches tier plus the wider Joner Football App content.'],
  ['Can I cancel?', 'Billing and cancellation are handled inside the Joner Football App platform.']
]

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Coaches Only',
  description,
  brand: { '@type': 'Brand', name: 'Joner Football' },
  offers: {
    '@type': 'Offer',
    price: '319.99',
    priceCurrency: 'AUD',
    url: checkoutUrl,
    availability: 'https://schema.org/InStock'
  }
}
---

<BaseLayout title={title} description={description} canonical="https://jonerfootball.com/drafts/app/for-coaches/" ogImage="https://jonerfootball.com/images/coaches-only/coaches-only-hero-updated.png" noindex={true} schema={schema}>
  <main class="bg-joner-black text-white">
    <section class="relative overflow-hidden border-b border-white/10">
      <div class="absolute inset-0">
        <img src="/images/coaches-only/dsc05109-hero.webp" alt="Lee Jones coaching players during a Joner Football session" class="h-full w-full object-cover opacity-[0.55]" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-r from-black via-black/90 to-black/40"></div>
      </div>
      <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-28 lg:px-8 lg:py-32">
        <div class="max-w-4xl">
          <p class="mb-4 font-heading text-xs uppercase tracking-[0.28em] text-joner-red">Coaches Only</p>
          <h1 class="font-heading text-5xl font-black uppercase leading-[0.88] text-white sm:text-6xl md:text-7xl lg:text-8xl">Every Session.<br />Every Detail.<br />Every Week.</h1>
          <p class="mt-7 max-w-2xl text-lg leading-relaxed text-neutral-200 sm:text-xl">For coaches who want better sessions, sharper detail, and a clear look at how Lee plans and coaches Joner Football standards.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href={checkoutUrl} target="_blank" rel="noopener noreferrer" class="btn-red text-base px-8 py-4 text-center" data-meta-checkout-event={checkoutEvent}>Start Coaches Only</a>
            <a href="#inside" class="btn-outline text-base px-8 py-4 text-center">See What Is Inside</a>
          </div>
          <p class="mt-4 text-sm font-semibold uppercase tracking-[0.16em] text-neutral-300">{price}. Cancel anytime.</p>
          <div class="mt-6 grid max-w-3xl grid-cols-1 gap-3 text-xs font-heading uppercase tracking-[0.18em] text-neutral-300 sm:grid-cols-3">
            <div class="border border-white/10 bg-black/55 px-4 py-3">Trusted by coaches in {/* TODO: ASK LEE: confirm country count. */} multiple countries</div>
            <div class="border border-white/10 bg-black/55 px-4 py-3">Full app access included</div>
            <div class="border border-white/10 bg-black/55 px-4 py-3">Built by Lee Jones</div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-black py-12">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="overflow-hidden border border-white/10 bg-white/[0.035] p-3">
          <video class="aspect-video w-full bg-black object-cover" controls playsinline poster="/images/coaches-only/coaches-only-hero-updated.png">
            <source src="/videos/coaches-only-intro.mp4" type="video/mp4" />
          </video>
          {/* TODO: ASK LEE: Add public/videos/coaches-only-intro.mp4 or choose the approved intro video. */}
        </div>
      </div>
    </section>

    <section class="bg-white py-20 text-black md:py-24">
      <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:px-8">
        <div>
          <p class="mb-4 font-heading text-xs uppercase tracking-[0.28em] text-joner-red">The Problem</p>
          <h2 class="font-heading text-4xl font-black uppercase leading-none sm:text-5xl md:text-6xl">Most coaches know drills. Fewer coach the detail.</h2>
        </div>
        <div class="space-y-5 text-lg leading-relaxed text-neutral-700">
          <p>A drill is only useful when the coach knows what to look for. Body shape. Timing. Weight of pass. Scanning. First touch. The details players feel straight away.</p>
          <p>Coaches Only is built for coaches who want more than a folder of exercises. It shows how Joner Football plans, explains, and raises the standard in a session.</p>
        </div>
      </div>
    </section>

    <section class="bg-joner-black py-20 md:py-24">
      <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:px-8 lg:items-center">
        <div>
          <p class="mb-4 font-heading text-xs uppercase tracking-[0.28em] text-joner-red">Who You Learn From</p>
          <h2 class="font-heading text-4xl font-black uppercase leading-none sm:text-5xl md:text-6xl">Lee Jones. Real sessions. Real standards.</h2>
          <p class="mt-6 text-lg leading-relaxed text-neutral-300">Watch how Lee coaches the game, not just the drill. The language, the detail, the corrections, and the standard behind the work.</p>
        </div>
        <div class="overflow-hidden border border-white/10 bg-white/[0.03] p-3">
          <img src="/images/about/lee-coaching-pitch.webp" alt="Lee Jones coaching players on the pitch" class="w-full object-cover" loading="lazy" />
          {/* TODO: ASK LEE: Replace with Lee coaching a professional player if preferred. */}
        </div>
      </div>
    </section>

    <section id="inside" class="bg-neutral-950 py-20 md:py-24 scroll-mt-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-12 max-w-3xl">
          <p class="mb-4 font-heading text-xs uppercase tracking-[0.28em] text-joner-red">Inside Coaches Only</p>
          <h2 class="font-heading text-4xl font-black uppercase leading-none sm:text-5xl md:text-6xl">Eight coach tools in one place.</h2>
        </div>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          {features.map(([heading, text], index) => (
            <article class="border border-white/10 bg-white/[0.035] p-6 transition hover:border-joner-red/80">
              <div class="mb-5 font-heading text-3xl font-black text-joner-red">{String(index + 1).padStart(2, '0')}</div>
              <h3 class="font-heading text-xl font-black uppercase text-white">{heading}</h3>
              <p class="mt-3 text-sm leading-relaxed text-neutral-400">{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-white py-20 text-black md:py-24">
      <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:px-8 lg:items-center">
        <div>
          <p class="mb-4 font-heading text-xs uppercase tracking-[0.28em] text-joner-red">Why Yearly Only</p>
          <h2 class="font-heading text-4xl font-black uppercase leading-none sm:text-5xl md:text-6xl">You do not become a better coach in one weekend.</h2>
        </div>
        <div class="space-y-5 text-lg leading-relaxed text-neutral-700">
          <p>Coaches Only is not built for one quick watch. It is built to sit beside your season, your weekly sessions, and your player development work.</p>
          <p>Watch a session. Take the idea to training. Come back. Review the detail. That is how coaching improves.</p>
          <a href={checkoutUrl} target="_blank" rel="noopener noreferrer" class="btn-red inline-flex text-base px-8 py-4 text-center" data-meta-checkout-event={checkoutEvent}>Start Coaches Only</a>
        </div>
      </div>
    </section>

    <section class="bg-neutral-950 py-20 md:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-12 max-w-3xl">
          <p class="mb-4 font-heading text-xs uppercase tracking-[0.28em] text-joner-red">Testimonials</p>
          <h2 class="font-heading text-4xl font-black uppercase leading-none sm:text-5xl">Coach proof needs Lee approval.</h2>
          <p class="mt-5 text-lg leading-relaxed text-neutral-300">This draft keeps the section ready without inventing coach quotes.</p>
        </div>
        <div class="border border-white/10 bg-white/[0.035] p-8">
          <p class="font-heading text-xl font-black uppercase text-white">TODO: ASK LEE: Add approved Coaches Only testimonials before this draft replaces the live page.</p>
        </div>
      </div>
    </section>

    <section class="bg-joner-black py-20 md:py-24">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <p class="mb-4 text-center font-heading text-xs uppercase tracking-[0.28em] text-joner-red">FAQ</p>
        <h2 class="mb-10 text-center font-heading text-4xl font-black uppercase leading-none sm:text-5xl">Questions Coaches Ask.</h2>
        <div class="space-y-4">
          {faqs.map(([q, a]) => (
            <details class="group border border-white/10 bg-white/[0.035] p-6">
              <summary class="cursor-pointer list-none font-heading text-xl font-black uppercase text-white">{q}<span class="float-right text-joner-red group-open:rotate-45">+</span></summary>
              <p class="mt-4 text-base leading-relaxed text-neutral-300">{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="relative overflow-hidden bg-black py-20 md:py-24">
      <div class="absolute inset-0 opacity-[0.25]" aria-hidden="true"><img src="/images/coaches-only/coaches-only-hero-updated.png" alt="" class="h-full w-full object-cover" /><div class="absolute inset-0 bg-black/80"></div></div>
      <div class="relative mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
        <p class="mb-4 font-heading text-xs uppercase tracking-[0.28em] text-joner-red">Coach With Purpose</p>
        <h2 class="font-heading text-4xl font-black uppercase leading-none sm:text-5xl md:text-7xl">Stop collecting drills. Start coaching better detail.</h2>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <a href={checkoutUrl} target="_blank" rel="noopener noreferrer" class="btn-red text-base px-8 py-4 text-center" data-meta-checkout-event={checkoutEvent}>Start Coaches Only</a>
          <a href={categoryUrl} target="_blank" rel="noopener noreferrer" class="btn-outline text-base px-8 py-4 text-center">Preview In The App</a>
        </div>
      </div>
    </section>

    <!-- TODO: ASK LEE: Confirm final Coaches Only checkout offer, intro video, country count, and approved coach testimonials before live replacement. -->
    <StickyMobileCta href={checkoutUrl} label="Join Now" eventName={checkoutEvent} />
  </main>
</BaseLayout>
