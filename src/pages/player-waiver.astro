---
import BaseLayout from '../layouts/BaseLayout.astro'

const title = 'JFP Player Info + Waiver Form'
const description = 'Complete the JFP Player Info + Waiver Form securely in Airtable before your player attends training.'
const airtableFormUrl = 'https://airtable.com/apphU4R0BtVIu5YqT/pagdSqWlCfZJyiPxq/form'
---

<BaseLayout title={title} description={description} noindex={true} hideMobileAppCta={true}>
  <main class="bg-joner-black text-white">
    <section class="relative overflow-hidden border-b border-white/10 bg-black">
      <div class="absolute inset-0 opacity-30">
        <img src="/images/home-storyboard/04-joner-way-dsc08725.webp" alt="" class="h-full w-full object-cover" loading="eager" />
      </div>
      <div class="absolute inset-0 bg-gradient-to-r from-black via-black/90 to-black/35"></div>
      <div class="relative mx-auto flex min-h-[48vh] max-w-6xl items-end px-5 pb-12 pt-24 sm:px-8 lg:px-10 lg:pb-16">
        <div class="max-w-3xl">
          <p class="font-heading text-sm uppercase tracking-[0.18em] text-joner-red">Joner Football Programmes</p>
          <h1 class="mt-4 font-heading text-5xl leading-[0.95] tracking-[0.04em] text-white sm:text-6xl lg:text-7xl">JFP player info + waiver form</h1>
          <p class="mt-5 max-w-2xl font-body text-lg leading-relaxed text-white/78">Parents and guardians must complete the JFP Player Info + Waiver Form in Airtable before the player attends training.</p>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-4xl px-5 py-12 sm:px-8 lg:px-10 lg:py-20">
      <div class="border-l-4 border-joner-red bg-white p-7 text-joner-black shadow-[0_30px_90px_rgba(0,0,0,.35)] sm:p-10">
        <p class="font-heading text-sm uppercase tracking-[0.18em] text-joner-red">Action required</p>
        <h2 class="mt-3 font-heading text-3xl uppercase tracking-[0.04em] sm:text-4xl">Complete the form in Airtable</h2>
        <p class="mt-5 max-w-2xl font-body text-base leading-relaxed text-gray-700">Use the official JFP Player Info + Waiver Form to provide the required player information. The form opens in Airtable and is the only place to submit it.</p>
        <a class="btn-red mt-8 inline-flex w-full items-center justify-center text-center sm:w-auto" href={airtableFormUrl} target="_blank" rel="noopener noreferrer">Open JFP Player Info + Waiver Form</a>
        <p class="mt-5 break-all font-body text-sm leading-relaxed text-gray-500">Airtable form: <a class="underline decoration-joner-red underline-offset-4" href={airtableFormUrl} target="_blank" rel="noopener noreferrer">{airtableFormUrl}</a></p>
      </div>
    </section>
  </main>
</BaseLayout>
