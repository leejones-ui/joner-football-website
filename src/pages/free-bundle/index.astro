---
import BaseLayout from '../../layouts/BaseLayout.astro'

const title = 'Free Football Training Videos | Joner Football'
const description = 'Get 14 free Joner Football videos for players, parents and coaches. Enter your email and choose what best describes you.'
const canonical = 'https://jonerfootball.com/free-bundle/'
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  hideMobileAppCta
>
  <main class="free-bundle-page">
    <section class="free-hero" aria-labelledby="free-bundle-title">
      <picture class="free-hero__picture" aria-hidden="true">
        <source media="(max-width: 859px)" srcset="/images/free-bundle/mobile-version-landing.webp" type="image/webp" />
        <source media="(max-width: 859px)" srcset="/images/free-bundle/mobile-version-landing.png" type="image/png" />
        <source srcset="/images/free-bundle/landing-page-hero.webp" type="image/webp" />
        <img src="/images/free-bundle/landing-page-hero.png" alt="" />
      </picture>
      <div class="free-hero__shade" aria-hidden="true"></div>

      <div class="free-hero__inner">
        <div class="free-panel">
          <div class="free-copy">
            <h1 id="free-bundle-title">Get 14 Free Videos</h1>
            <p class="free-subtitle">Player drills, coaching ideas &amp; parent help.</p>
          </div>

          <div class="free-card" aria-label="Free video email capture form">
            <form id="free-bundle-form" data-brevo-form data-brevo-custom novalidate>
              <label class="free-label" for="free-bundle-email">Email address</label>
              <input
                id="free-bundle-email"
                type="email"
                name="email"
                placeholder="you@example.com"
                autocomplete="email"
                required
              />

              <fieldset class="role-fieldset">
                <legend>What best describes you?</legend>
                <p>Choose more than one if needed.</p>
                <div class="role-grid">
                  <label class="role-option">
                    <input type="checkbox" name="roles" value="coach" />
                    <span>Coach</span>
                  </label>
                  <label class="role-option">
                    <input type="checkbox" name="roles" value="player" />
                    <span>Player</span>
                  </label>
                  <label class="role-option">
                    <input type="checkbox" name="roles" value="parent" />
                    <span>Parent</span>
                  </label>
                  <label class="role-option">
                    <input type="checkbox" name="roles" value="fan" />
                    <span>Football fan</span>
                  </label>
                </div>
              </fieldset>

              <button type="submit" class="free-submit btn-red">Send Me The Videos</button>
              <p id="free-bundle-status" class="free-status" aria-live="polite"></p>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    (function () {
      var HOT_APP_LEADS = 2;
      var COACHES_DATABASE = 39;
      var PLAYERS_APP_LEADS = 50;
      var PARENT_APP_LEADS = 51;
      var roleToListId = {
        coach: COACHES_DATABASE,
        player: PLAYERS_APP_LEADS,
        parent: PARENT_APP_LEADS
      };

      function validEmail(email) {
        return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(String(email || '').trim());
      }

      function setStatus(message, type) {
        var status = document.getElementById('free-bundle-status');
        if (!status) return;
        status.textContent = message || '';
        status.dataset.type = type || '';
      }

      function getUtmParams() {
        var params = new URLSearchParams(window.location.search);
        var out = {};
        ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach(function (key) {
          var value = params.get(key);
          if (value) out[key] = value;
        });
        return out;
      }

      var form = document.getElementById('free-bundle-form');
      if (!form) return;

      form.addEventListener('submit', function (event) {
        event.preventDefault();
        var emailInput = document.getElementById('free-bundle-email');
        var button = form.querySelector('button[type="submit"]');
        var email = emailInput ? emailInput.value.trim().toLowerCase() : '';
        var selectedRoles = Array.prototype.slice.call(form.querySelectorAll('input[name="roles"]:checked')).map(function (input) {
          return input.value;
        });

        if (!validEmail(email)) {
          setStatus('Enter a valid email address first.', 'error');
          if (emailInput) emailInput.focus();
          return;
        }

        if (!selectedRoles.length) {
          setStatus('Choose at least one option so I can send the right videos.', 'error');
          return;
        }

        var listIds = [HOT_APP_LEADS];
        selectedRoles.forEach(function (role) {
          if (roleToListId[role] && listIds.indexOf(roleToListId[role]) === -1) listIds.push(roleToListId[role]);
        });

        if (button) {
          button.disabled = true;
          button.textContent = 'Sending...';
        }
        setStatus('', '');

        var getToken = window.JonerRecaptcha && window.JonerRecaptcha.getToken
          ? window.JonerRecaptcha.getToken('subscribe')
          : Promise.resolve('');

        Promise.resolve(getToken)
          .then(function (recaptchaToken) {
            return fetch('/api/subscribe', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(Object.assign({
                email: email,
                listIds: listIds,
                roles: selectedRoles.join(','),
                source: 'free-bundle-follower',
                marketingConsent: true,
                recaptchaToken: recaptchaToken || ''
              }, getUtmParams()))
            });
          })
          .then(function (response) { return response.json().then(function (data) { return { ok: response.ok, data: data }; }); })
          .then(function (result) {
            if (!result.ok || !result.data || !result.data.success) throw new Error((result.data && result.data.error) || 'Could not send the videos yet.');
            var next = new URL('/free-bundle/watch/', window.location.origin);
            window.location.search.replace(/^\?/, '').split('&').filter(Boolean).forEach(function (pair) {
              var parts = pair.split('=');
              if (parts[0] && parts[0].indexOf('utm_') === 0) next.searchParams.set(decodeURIComponent(parts[0]), decodeURIComponent(parts[1] || ''));
            });
            next.searchParams.set('roles', selectedRoles.join(','));
            window.location.assign(next.toString());
          })
          .catch(function (error) {
            setStatus(error.message || 'Something went wrong. Try again.', 'error');
            if (button) {
              button.disabled = false;
              button.textContent = 'Send Me The Videos';
            }
          });
      });
    })();
  </script>

  <style is:global>
    .free-bundle-page {
      background: #000;
      color: #fff;
      min-height: 100vh;
    }

    .free-hero {
      position: relative;
      min-height: calc(100vh - 88px);
      overflow: hidden;
      display: grid;
      align-items: stretch;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      background: #000;
    }

    .free-hero__picture,
    .free-hero__picture img,
    .free-hero__shade {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    .free-hero__picture img {
      object-fit: cover;
      object-position: 35% center;
      opacity: 0.98;
    }

    .free-hero__shade {
      background:
        linear-gradient(180deg, rgba(0,0,0,0.46) 0%, rgba(0,0,0,0.18) 38%, rgba(0,0,0,0.78) 100%),
        linear-gradient(90deg, rgba(0,0,0,0.12) 0%, rgba(0,0,0,0.22) 46%, rgba(0,0,0,0.18) 100%);
    }


    .free-hero__inner {
      position: relative;
      z-index: 1;
      width: min(1180px, calc(100% - 28px));
      margin: 0 auto;
      padding: 26px 0 32px;
      display: flex;
      align-items: end;
    }

    .free-panel {
      width: 100%;
      display: grid;
      gap: 14px;
    }

    .free-copy {
      text-shadow: 0 6px 24px rgba(0,0,0,0.75);
    }

    .free-copy h1 {
      font-family: Arial Black, Arial, sans-serif;
      text-transform: uppercase;
      font-size: clamp(42px, 12vw, 104px);
      line-height: 0.86;
      letter-spacing: -0.06em;
      margin: 0 0 8px;
      max-width: 720px;
    }

    .free-subtitle {
      color: rgba(255,255,255,0.9);
      font-family: Arial, sans-serif;
      font-weight: 800;
      text-transform: uppercase;
      font-size: clamp(12px, 3.4vw, 17px);
      letter-spacing: 0.08em;
      line-height: 1.25;
      max-width: 560px;
      margin: 0;
    }

    .free-card {
      background: rgba(4, 4, 4, 0.82);
      border: 1px solid rgba(255,255,255,0.14);
      box-shadow: 0 24px 80px rgba(0,0,0,0.48);
      padding: 16px;
      backdrop-filter: blur(8px);
    }

    .free-label,
    .role-fieldset legend {
      display: block;
      color: #fff;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 11px;
      margin-bottom: 8px;
    }

    #free-bundle-form input[type='email'] {
      width: 100%;
      min-height: 54px;
      border: 1px solid rgba(255,255,255,0.2);
      background: #0d0d0d;
      color: #fff;
      padding: 0 15px;
      font-size: 16px;
      outline: none;
    }

    #free-bundle-form input[type='email']:focus {
      border-color: #E8000D;
      box-shadow: 0 0 0 3px rgba(232,0,13,0.18);
    }

    .role-fieldset {
      border: 0;
      padding: 0;
      margin: 16px 0 0;
    }

    .role-fieldset p {
      margin: -3px 0 10px;
      color: rgba(255,255,255,0.68);
      font-size: 13px;
    }

    .role-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 9px;
    }

    .role-option {
      min-width: 0;
      overflow: hidden;
      cursor: pointer;
    }

    .role-option input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .role-option span {
      display: grid;
      place-items: center;
      min-height: 50px;
      border: 1px solid rgba(255,255,255,0.42);
      border-radius: 999px;
      background: rgba(5,5,5,0.42);
      color: rgba(255,255,255,0.84);
      font-family: 'Anton', Impact, sans-serif;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 12px;
      text-align: center;
      min-width: 0;
      max-width: 100%;
      overflow: hidden;
      transition: border-color 160ms ease, background 160ms ease, color 160ms ease, transform 160ms ease;
    }

    .role-option:hover span {
      border-color: #E8000D;
      background: #E8000D;
      color: #fff;
    }

    .role-option input:checked + span {
      border-color: #E8000D;
      background: #E8000D;
      color: #fff;
      transform: translateY(-1px);
    }

    .free-submit {
      width: 100%;
      min-height: 58px;
      margin-top: 16px;
      border: 0;
      font-family: 'Anton', Impact, sans-serif;
      letter-spacing: 0.12em;
      font-size: clamp(13px, 3.4vw, 15px);
      white-space: nowrap;
      cursor: pointer;
    }

    .free-submit:disabled {
      opacity: 0.65;
      cursor: wait;
    }

    .free-status {
      min-height: 19px;
      margin: 10px 0 0;
      font-size: 13px;
      color: #fff;
    }

    .free-status[data-type='error'] {
      color: #ff6b6b;
    }

    @media (max-width: 859px) {
      .free-hero {
        min-height: calc(100svh - 78px);
      }

      .free-hero__picture img {
        object-position: center center;
      }

      .free-hero__shade {
        background:
          linear-gradient(180deg, rgba(0,0,0,0.08) 0%, rgba(0,0,0,0.10) 31%, rgba(0,0,0,0.50) 61%, rgba(0,0,0,0.82) 100%),
          linear-gradient(90deg, rgba(0,0,0,0.04) 0%, rgba(0,0,0,0.20) 100%);
      }

      .free-hero__inner {
        width: min(100% - 72px, 300px);
        padding-bottom: 28px;
      }


      .free-panel {
        gap: 12px;
      }

      .free-copy h1 {
        font-size: clamp(21px, 5.85vw, 24px);
        line-height: 0.95;
        letter-spacing: -0.02em;
        white-space: nowrap;
      }

      .free-subtitle {
        font-size: clamp(7px, 1.9vw, 8.4px);
        letter-spacing: 0.01em;
        line-height: 1.1;
        white-space: nowrap;
      }

      .free-card {
        padding: 14px;
        background: rgba(4, 4, 4, 0.78);
        overflow: hidden;
      }

      .role-grid {
        gap: 8px;
      }

      .role-option span {
        min-height: 46px;
        border-color: rgba(255, 255, 255, 0.52);
        padding: 0 8px;
        font-size: clamp(9.5px, 2.65vw, 11px);
        letter-spacing: 0.045em;
        white-space: nowrap;
      }

      .free-submit {
        font-size: clamp(11.5px, 3vw, 13px);
      }
    }

    @media (min-width: 860px) {
      .free-hero__picture img {
        object-position: center center;
      }

      .free-hero__shade {
        background:
          linear-gradient(90deg, rgba(0,0,0,0.08) 0%, rgba(0,0,0,0.04) 42%, rgba(0,0,0,0.18) 100%);
      }

      .free-hero__inner {
        align-items: center;
        justify-content: flex-end;
        padding: 58px 0;
      }

      .free-panel {
        width: min(470px, 40vw);
        margin-left: auto;
        gap: 18px;
      }

      .free-copy h1 {
        font-size: clamp(54px, 5.1vw, 88px);
      }

      .free-card {
        padding: 24px;
      }
    }
  </style>
</BaseLayout>
