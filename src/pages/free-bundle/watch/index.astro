---
import BaseLayout from '../../../layouts/BaseLayout.astro'

const title = 'Your Free Videos Are Ready | Joner Football'
const description = 'Your Joner Football free training videos are ready. Check your email or click below to watch.'
const canonical = 'https://jonerfootball.com/free-bundle/watch/'
const freeAppSectionUrl = 'https://app.jonerfootball.com/categories/category-vpi8uazway4?utm_source=free_bundle&utm_medium=thank_you_page&utm_campaign=free_bundle_followers&utm_content=open_free_section'
const coachesUrl = '/app/for-coaches/?utm_source=free_bundle&utm_medium=thank_you_page&utm_campaign=free_bundle_followers&utm_content=coaching_videos'
const playerUrl = 'https://app.jonerfootball.com/categories/category-qee31-z2mxo?utm_source=free_bundle&utm_medium=thank_you_page&utm_campaign=free_bundle_followers&utm_content=player_100_day_program'
const teamsUrl = '/teams/?utm_source=free_bundle&utm_medium=thank_you_page&utm_campaign=free_bundle_followers&utm_content=team_subscription'
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  noindex
  hideMobileAppCta
>
  <main class="bundle-watch-page">
    <section class="bundle-ready">
      <div class="bundle-ready__inner">
        <div class="bundle-hero-image">
          <img src="/images/free-bundle/free-bundle-hero.jpg" alt="Joner Football free training video bundle" onerror="this.closest('.bundle-hero-image').style.display='none'" />
        </div>
        <div class="bundle-ready__copy">
          <p class="ready-eyebrow">Free videos ready</p>
          <h1>Check Your Email</h1>
          <p class="ready-subtitle">
            I’ve sent the free bundle to your inbox. You can also click below and start watching now.
          </p>
          <div class="ready-actions">
            <a href={freeAppSectionUrl} target="_blank" rel="noopener noreferrer" class="ready-button ready-button--red">Open Free Videos</a>
          </div>
        </div>
      </div>
    </section>

    <section class="want-more" aria-labelledby="want-more-title">
      <div class="want-more__inner">
        <p class="ready-eyebrow">Want more?</p>
        <h2 id="want-more-title">Choose what fits you</h2>
        <div class="funnel-grid">
          <a href={coachesUrl} class="funnel-card">
            <span>Coaches</span>
            <strong>Coaching Videos</strong>
            <small>Session plans, coaching detail and ideas for your team.</small>
          </a>
          <a href={playerUrl} target="_blank" rel="noopener noreferrer" class="funnel-card">
            <span>Players</span>
            <strong>Player Videos</strong>
            <small>Start the 100 Day Program and train with structure.</small>
          </a>
          <a href={teamsUrl} class="funnel-card">
            <span>Clubs and teams</span>
            <strong>Team Subscription</strong>
            <small>Bring Joner Football training into your full team setup.</small>
          </a>
        </div>
      </div>
    </section>
  </main>

  <style is:global>
    .bundle-watch-page {
      min-height: 100vh;
      background: #000;
      color: #fff;
    }

    .bundle-ready {
      position: relative;
      overflow: hidden;
      border-bottom: 1px solid rgba(255,255,255,0.1);
      background:
        radial-gradient(circle at 50% 0%, rgba(232,0,13,0.35), transparent 34%),
        linear-gradient(135deg, #050505 0%, #111 50%, #000 100%);
    }

    .bundle-ready__inner,
    .want-more__inner {
      width: min(1120px, calc(100% - 32px));
      margin: 0 auto;
    }

    .bundle-ready__inner {
      padding: 38px 0 54px;
      display: grid;
      gap: 24px;
      align-items: center;
      text-align: center;
    }

    .bundle-hero-image {
      width: min(520px, 100%);
      margin: 0 auto;
      border: 1px solid rgba(255,255,255,0.14);
      background: #111;
      box-shadow: 0 26px 80px rgba(0,0,0,0.45);
      overflow: hidden;
    }

    .bundle-hero-image img {
      display: block;
      width: 100%;
      height: auto;
    }

    .ready-eyebrow {
      color: #E8000D;
      font-family: Arial Black, Arial, sans-serif;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      font-size: 12px;
      margin: 0 0 14px;
    }

    .bundle-ready h1,
    .want-more h2 {
      font-family: Arial Black, Arial, sans-serif;
      text-transform: uppercase;
      letter-spacing: -0.06em;
      line-height: 0.9;
      margin: 0;
    }

    .bundle-ready h1 {
      font-size: clamp(46px, 12vw, 102px);
    }

    .ready-subtitle {
      color: rgba(255,255,255,0.78);
      font-size: clamp(18px, 4vw, 24px);
      max-width: 670px;
      margin: 20px auto 0;
      line-height: 1.32;
    }

    .ready-actions {
      max-width: 420px;
      margin: 30px auto 0;
    }

    .ready-button {
      display: grid;
      place-items: center;
      min-height: 60px;
      padding: 0 22px;
      font-family: Arial Black, Arial, sans-serif;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      text-decoration: none;
    }

    .ready-button--red {
      background: #E8000D;
      color: #fff;
    }

    .want-more {
      padding: 48px 0 72px;
      background: #050505;
    }

    .want-more h2 {
      font-size: clamp(34px, 8vw, 72px);
      max-width: 780px;
      margin-bottom: 26px;
    }

    .funnel-grid {
      display: grid;
      gap: 14px;
    }

    .funnel-card {
      display: block;
      background: #111;
      border: 1px solid rgba(255,255,255,0.1);
      padding: 22px;
      color: #fff;
      text-decoration: none;
      transition: border-color 160ms ease, transform 160ms ease, background 160ms ease;
    }

    .funnel-card:hover {
      border-color: #E8000D;
      background: #151515;
      transform: translateY(-2px);
    }

    .funnel-card span {
      display: block;
      color: #E8000D;
      font-family: Arial Black, Arial, sans-serif;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      font-size: 11px;
      margin-bottom: 16px;
    }

    .funnel-card strong {
      display: block;
      font-family: Arial Black, Arial, sans-serif;
      text-transform: uppercase;
      font-size: 25px;
      line-height: 1;
      margin-bottom: 10px;
    }

    .funnel-card small {
      display: block;
      color: rgba(255,255,255,0.72);
      font-size: 15px;
      line-height: 1.45;
    }

    @media (min-width: 860px) {
      .bundle-ready__inner {
        grid-template-columns: minmax(320px, 0.82fr) minmax(0, 1fr);
        text-align: left;
        padding: 70px 0;
      }

      .ready-subtitle,
      .ready-actions {
        margin-left: 0;
      }

      .funnel-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }
  </style>
</BaseLayout>
