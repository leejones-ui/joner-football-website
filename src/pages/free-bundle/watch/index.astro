---
import BaseLayout from '../../../layouts/BaseLayout.astro'

const title = 'Your Free Videos Are Ready | Joner Football'
const description = 'Your Joner Football free training videos are ready. Check your email or click below to watch.'
const canonical = 'https://jonerfootball.com/free-bundle/watch/'
const freeAppSectionUrl = 'https://app.jonerfootball.com/categories/category-vpi8uazway4?utm_source=free_bundle&utm_medium=thank_you_page&utm_campaign=free_bundle_followers&utm_content=open_free_section'
const cognitiveBundleUrl = 'https://app.jonerfootball.com/checkout/new?o=228257&utm_source=free_bundle&utm_medium=thank_you_page&utm_campaign=free_bundle_followers&utm_content=cognitive_bundle'
const coachSessionPlanUrl = 'https://app.jonerfootball.com/checkout/new?o=226775&utm_source=free_bundle&utm_medium=thank_you_page&utm_campaign=free_bundle_followers&utm_content=free_session_plan_pack'
const soloTrainingPackUrl = 'https://app.jonerfootball.com/checkout/new?o=226774&utm_source=free_bundle&utm_medium=thank_you_page&utm_campaign=free_bundle_followers&utm_content=free_solo_training_pack'
const coachesUrl = '/app/for-coaches/?utm_source=free_bundle&utm_medium=thank_you_page&utm_campaign=free_bundle_followers&utm_content=coaching_videos'
const playerUrl = 'https://app.jonerfootball.com/categories/category-qee31-z2mxo?utm_source=free_bundle&utm_medium=thank_you_page&utm_campaign=free_bundle_followers&utm_content=player_100_day_program'
const teamsUrl = '/teams/?utm_source=free_bundle&utm_medium=thank_you_page&utm_campaign=free_bundle_followers&utm_content=team_subscription'

const freeBundleSteps = [
  {
    label: '3 Videos',
    title: 'Cognitive Bundle',
    subtitle: 'Free training videos to sharpen decision making.',
    href: cognitiveBundleUrl,
    image: '/images/free-bundle/cards/cognitive-bundle.jpg',
    external: true,
  },
  {
    label: 'Coaches',
    title: 'Session Plan Pack',
    subtitle: 'Free session plans to use with your players.',
    href: coachSessionPlanUrl,
    image: '/images/free-bundle/cards/session-plan-pack.jpg',
    external: true,
  },
  {
    label: 'Players',
    title: 'Solo Training Pack',
    subtitle: 'Free home training pack for sharper technique.',
    href: soloTrainingPackUrl,
    image: '/images/free-bundle/cards/solo-training-pack.jpg',
    external: true,
  },
]

const nextSteps = [
  {
    label: 'Players',
    title: 'Player Videos',
    subtitle: 'Train with structure and start the 100 Day Program.',
    href: playerUrl,
    image: '/images/blog/football-drills-at-home-player-action-image2.avif',
    external: true,
  },
  {
    label: 'Coaches',
    title: 'Coaching Videos',
    subtitle: 'Session ideas, coaching detail and better progressions.',
    href: coachesUrl,
    image: '/images/app/audience-coaches-thumbnail.avif',
  },
  {
    label: 'Teams',
    title: 'Team Subscriptions',
    subtitle: 'Bring Joner Football training into your full team setup.',
    href: teamsUrl,
    image: '/images/join-live/teams.webp',
  },
]
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  noindex
  hideMobileAppCta
>
  <main class="bundle-watch-page">
    <section class="bundle-ready" aria-labelledby="bundle-ready-title">
      <picture class="bundle-ready__picture" aria-hidden="true">
        <source media="(max-width: 859px)" srcset="/images/free-bundle/check-email-mobile-v2.webp" type="image/webp" />
        <source media="(max-width: 859px)" srcset="/images/free-bundle/check-email-mobile-v2.png" type="image/png" />
        <source srcset="/images/free-bundle/check-your-email-desktop.webp" type="image/webp" />
        <img src="/images/free-bundle/check-your-email-desktop.png" alt="" />
      </picture>
      <div class="bundle-ready__shade" aria-hidden="true"></div>

      <div class="bundle-ready__inner">
        <div class="bundle-ready__copy">
          <p class="ready-eyebrow">Free videos ready</p>
          <h1 id="bundle-ready-title">Check Your Email</h1>
          <p class="ready-subtitle">
            I’ve sent the free bundle to your inbox, or click below to start watching now.
          </p>
          <div class="ready-actions">
            <a href={freeAppSectionUrl} target="_blank" rel="noopener noreferrer" class="btn-red ready-button">Open Free Videos</a>
          </div>
        </div>
      </div>
    </section>

    <section class="want-more" aria-labelledby="want-more-title">
      <div class="want-more__inner">
        <header class="want-more__header">
          <h2 id="want-more-title">Want More</h2>
          <p>Choose what fits you</p>
          <span class="want-more__rule" aria-hidden="true"></span>
        </header>

        <p class="want-more__section-label">Free bundle links</p>
        <div class="next-step-grid" aria-label="Claim more free Joner Football bundles">
          {freeBundleSteps.map((step) => (
            <a
              href={step.href}
              class="next-step-card"
              target={step.external ? '_blank' : undefined}
              rel={step.external ? 'noopener noreferrer' : undefined}
              aria-label={`Claim ${step.title}`}
            >
              <img src={step.image} alt="" aria-hidden="true" loading="lazy" class="next-step-card__bg" />
              <span class="next-step-card__shade" aria-hidden="true"></span>
              <span class="next-step-card__badge">{step.label}</span>
              <span class="next-step-card__body">
                <span class="next-step-card__title">{step.title}</span>
                <span class="next-step-card__subtitle">{step.subtitle}</span>
              </span>
              <span class="next-step-card__arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>

        <p class="want-more__section-label want-more__section-label--second">Then pick your path</p>
        <div class="next-step-grid" aria-label="Choose your next Joner Football path">
          {nextSteps.map((step) => (
            <a
              href={step.href}
              class="next-step-card"
              target={step.external ? '_blank' : undefined}
              rel={step.external ? 'noopener noreferrer' : undefined}
              aria-label={`View ${step.title}`}
            >
              <img src={step.image} alt="" aria-hidden="true" loading="lazy" class="next-step-card__bg" />
              <span class="next-step-card__shade" aria-hidden="true"></span>
              <span class="next-step-card__badge">{step.label}</span>
              <span class="next-step-card__body">
                <span class="next-step-card__title">{step.title}</span>
                <span class="next-step-card__subtitle">{step.subtitle}</span>
              </span>
              <span class="next-step-card__arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <style is:global>
    .bundle-watch-page {
      min-height: 100vh;
      background: #000;
      color: #fff;
    }

    .bundle-ready {
      position: relative;
      min-height: calc(100svh - 88px);
      overflow: hidden;
      display: grid;
      align-items: center;
      border-bottom: 1px solid rgba(255,255,255,0.1);
      background: #000;
    }

    .bundle-ready__picture,
    .bundle-ready__picture img,
    .bundle-ready__shade {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    .bundle-ready__picture img {
      object-fit: cover;
      object-position: 62% center;
    }

    .bundle-ready__shade {
      background:
        radial-gradient(circle at 50% 45%, rgba(0,0,0,0.22) 0%, rgba(0,0,0,0.10) 34%, rgba(0,0,0,0.32) 100%),
        linear-gradient(180deg, rgba(0,0,0,0.04) 0%, rgba(0,0,0,0.06) 45%, rgba(0,0,0,0.42) 100%),
        linear-gradient(90deg, rgba(0,0,0,0.34) 0%, rgba(0,0,0,0.10) 52%, rgba(0,0,0,0.02) 100%);
    }

    .bundle-ready__inner,
    .want-more__inner {
      position: relative;
      z-index: 1;
      width: min(1120px, calc(100% - 32px));
      margin: 0 auto;
    }

    .bundle-ready__inner {
      padding: 60px 0;
    }

    .bundle-ready__copy {
      max-width: 720px;
      margin: 0 auto;
      text-align: center;
      text-shadow: 0 12px 34px rgba(0,0,0,0.78);
    }

    .ready-eyebrow {
      color: #E8000D;
      font-family: Anton, Impact, sans-serif;
      text-transform: uppercase;
      letter-spacing: 0.22em;
      font-size: 13px;
      margin: 0 0 14px;
    }

    .bundle-ready h1 {
      font-family: Anton, Impact, sans-serif;
      text-transform: uppercase;
      letter-spacing: 0.035em;
      line-height: 0.9;
      margin: 0;
      font-size: clamp(56px, 8vw, 112px);
      max-width: none;
    }

    .ready-subtitle {
      color: rgba(255,255,255,0.86);
      font-size: clamp(18px, 2.1vw, 25px);
      max-width: 660px;
      margin: 22px auto 0;
      line-height: 1.28;
      font-weight: 700;
    }

    .ready-actions {
      max-width: 360px;
      margin: 30px auto 0;
    }

    .ready-button {
      width: 100%;
      min-height: 68px;
      padding: 0 24px;
      font-size: 16px;
      letter-spacing: 0.08em;
    }

    .want-more {
      padding: 54px 0 78px;
      background: #050505;
    }

    .want-more__header {
      max-width: 650px;
      margin: 0 auto clamp(1.6rem, 3vw, 2.5rem);
      text-align: center;
    }

    .want-more h2 {
      margin: 0;
      color: #E30613;
      font-family: Anton, Impact, sans-serif;
      font-size: clamp(4rem, 7vw, 7.2rem);
      line-height: 0.88;
      letter-spacing: 0.035em;
      text-transform: uppercase;
      text-shadow: 0 1.2rem 2.6rem rgba(0,0,0,0.72);
    }

    .want-more__header p {
      margin: 0.9rem 0 0;
      color: #fff;
      font-family: Anton, Impact, sans-serif;
      font-size: clamp(1.35rem, 2.6vw, 2.25rem);
      line-height: 1;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .want-more__rule {
      display: block;
      width: 4.25rem;
      height: 3px;
      margin: 1.1rem auto 0;
      background: #E30613;
      box-shadow: 0 0 1rem rgba(227,6,19,0.48);
    }

    .want-more__section-label {
      margin: 0 auto 1rem;
      color: rgba(255,255,255,0.78);
      font-family: Anton, Impact, sans-serif;
      font-size: clamp(1rem, 1.7vw, 1.35rem);
      letter-spacing: 0.14em;
      text-align: center;
      text-transform: uppercase;
    }

    .want-more__section-label--second {
      margin-top: clamp(2rem, 4vw, 3rem);
    }

    .next-step-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(0.8rem, 1.2vw, 1rem);
    }

    .next-step-card {
      position: relative;
      display: flex;
      min-height: clamp(13rem, 17vw, 16rem);
      overflow: hidden;
      border: 1px solid rgba(255,255,255,0.34);
      border-radius: 0.55rem;
      background: #050505;
      color: #fff;
      text-decoration: none;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.16), 0 1rem 2.2rem rgba(0,0,0,0.32), 0 0 0 1px rgba(227,6,19,0.08);
      transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
    }

    .next-step-card::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      background: radial-gradient(circle at 82% 18%, rgba(227,6,19,0.22), transparent 30%), linear-gradient(135deg, rgba(255,255,255,0.14), transparent 34%);
      opacity: 0.72;
      mix-blend-mode: screen;
      transition: opacity 220ms ease;
    }

    .next-step-card:hover,
    .next-step-card:focus-visible {
      transform: translateY(-4px);
      border-color: rgba(255,255,255,0.72);
      box-shadow: inset 0 0 0 1px rgba(227,6,19,0.45), 0 1.35rem 2.75rem rgba(0,0,0,0.36), 0 0 2.2rem rgba(227,6,19,0.22);
      outline: none;
    }

    .next-step-card__bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center center;
      opacity: 0.95;
      filter: contrast(1.12) brightness(1.04) saturate(1.08);
      transition: opacity 220ms ease, transform 420ms ease, filter 220ms ease;
    }

    .next-step-card:hover .next-step-card__bg,
    .next-step-card:focus-visible .next-step-card__bg {
      opacity: 0.88;
      transform: scale(1.055);
      filter: contrast(1.16) brightness(1.08) saturate(1.12);
    }

    .next-step-card__shade {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(0,0,0,0), rgba(0,0,0,0.56)), linear-gradient(90deg, rgba(0,0,0,0.42), rgba(0,0,0,0.02));
    }

    .next-step-card__badge,
    .next-step-card__body,
    .next-step-card__arrow {
      position: relative;
      z-index: 2;
    }

    .next-step-card__badge {
      position: absolute;
      left: 1rem;
      top: 1rem;
      max-width: 7rem;
      font-family: Anton, Impact, sans-serif;
      font-size: 0.82rem;
      line-height: 0.9;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #fff;
      text-shadow: 0 2px 10px rgba(0,0,0,0.9);
    }

    .next-step-card__body {
      align-self: flex-end;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      padding: 4.3rem 1.2rem 1.15rem;
    }

    .next-step-card__title {
      font-family: Anton, Impact, sans-serif;
      font-size: clamp(1.7rem, 2.4vw, 2.4rem);
      line-height: 0.95;
      letter-spacing: 0.035em;
      text-transform: uppercase;
    }

    .next-step-card__subtitle {
      max-width: 18rem;
      font-family: Inter, system-ui, sans-serif;
      font-size: 0.84rem;
      line-height: 1.4;
      color: rgba(255,255,255,0.76);
    }

    .next-step-card__arrow {
      position: absolute;
      right: 1rem;
      bottom: 1rem;
      color: #E30613;
      font-family: Anton, Impact, sans-serif;
      font-size: 1.5rem;
    }

    @media (max-width: 859px) {
      .bundle-ready {
        min-height: calc(100svh - 78px);
        align-items: end;
      }

      .bundle-ready__picture img {
        object-position: center center;
      }

      .bundle-ready__shade {
        background:
          linear-gradient(180deg, rgba(0,0,0,0.12) 0%, rgba(0,0,0,0.12) 34%, rgba(0,0,0,0.72) 76%, rgba(0,0,0,0.94) 100%),
          linear-gradient(90deg, rgba(0,0,0,0.08) 0%, rgba(0,0,0,0.18) 100%);
      }

      .bundle-ready__inner {
        width: min(100% - 26px, 390px);
        padding: 0 0 30px;
      }

      .bundle-ready__copy {
        max-width: 330px;
        margin: 0;
        text-align: left;
        padding: 18px;
        background: rgba(4,4,4,0.60);
        border: 1px solid rgba(255,255,255,0.18);
        box-shadow: 0 22px 60px rgba(0,0,0,0.58);
        backdrop-filter: blur(8px) saturate(1.1);
        -webkit-backdrop-filter: blur(8px) saturate(1.1);
      }

      .ready-eyebrow {
        font-size: 10px;
        letter-spacing: 0.16em;
        margin-bottom: 9px;
      }

      .bundle-ready h1 {
        font-size: clamp(37px, 11vw, 46px);
        max-width: 7.6ch;
      }

      .ready-subtitle {
        font-size: 15px;
        margin-top: 14px;
        margin-left: 0;
        margin-right: 0;
      }

      .ready-actions {
        margin-top: 18px;
      }

      .want-more {
        padding: 42px 0 58px;
      }

      .want-more h2 {
        font-size: clamp(3.6rem, 16vw, 5.2rem);
      }

      .next-step-grid {
        grid-template-columns: 1fr;
        gap: 12px;
      }

      .next-step-card {
        min-height: 12.5rem;
      }
    }
  </style>
</BaseLayout>
