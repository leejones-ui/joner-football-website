---
import BaseLayout from '../../../layouts/BaseLayout.astro'

const title = 'Your Free Videos Are Ready | Joner Football'
const description = 'Your Joner Football free training videos are ready. Check your email and start with the free app section.'
const canonical = 'https://jonerfootball.com/free-bundle/watch/'
const freeAppSectionUrl = 'https://app.jonerfootball.com/categories/category-vpi8uazway4?utm_source=free_bundle&utm_medium=thank_you_page&utm_campaign=free_bundle_followers&utm_content=open_free_section'
const joinUrl = '/join/?utm_source=free_bundle&utm_medium=thank_you_page&utm_campaign=free_bundle_followers&utm_content=join_app_cta'
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  noindex
  hideMobileAppCta
>
  <main class="bundle-watch-page">
    <section class="bundle-ready">
      <div class="bundle-ready__inner">
        <p class="ready-eyebrow">You are in</p>
        <h1>Your Free Videos Are Ready</h1>
        <p class="ready-subtitle">
          Check your email for the bundle. You can also start with the Joner Football free section now.
        </p>
        <div class="ready-actions">
          <a href={freeAppSectionUrl} target="_blank" rel="noopener noreferrer" class="ready-button ready-button--red">Open Free Videos</a>
          <a href={joinUrl} class="ready-button ready-button--dark">See The Full App</a>
        </div>
      </div>
    </section>

    <section class="next-steps" aria-labelledby="next-steps-title">
      <div class="next-steps__inner">
        <div>
          <p class="ready-eyebrow">What happens next</p>
          <h2 id="next-steps-title">Start free. Train properly.</h2>
        </div>
        <div class="step-grid">
          <article>
            <span>1</span>
            <h3>Open your email</h3>
            <p>The free bundle email gives you the training videos and the next steps.</p>
          </article>
          <article>
            <span>2</span>
            <h3>Use the free section</h3>
            <p>Watch the videos, test the coaching style and start training with more structure.</p>
          </article>
          <article>
            <span>3</span>
            <h3>Go deeper in the app</h3>
            <p>The full app gives players, parents and coaches the plan behind the videos.</p>
          </article>
        </div>
      </div>
    </section>
  </main>

  <style is:global>
    .bundle-watch-page {
      min-height: 100vh;
      background: #000;
      color: #fff;
    }

    .bundle-ready {
      position: relative;
      overflow: hidden;
      border-bottom: 1px solid rgba(255,255,255,0.1);
      background:
        radial-gradient(circle at 50% 0%, rgba(232,0,13,0.35), transparent 34%),
        linear-gradient(135deg, #050505 0%, #111 50%, #000 100%);
    }

    .bundle-ready__inner,
    .next-steps__inner {
      width: min(1120px, calc(100% - 32px));
      margin: 0 auto;
    }

    .bundle-ready__inner {
      padding: 76px 0;
      text-align: center;
    }

    .ready-eyebrow {
      color: #E8000D;
      font-family: Arial Black, Arial, sans-serif;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      font-size: 12px;
      margin: 0 0 14px;
    }

    .bundle-ready h1,
    .next-steps h2 {
      font-family: Arial Black, Arial, sans-serif;
      text-transform: uppercase;
      letter-spacing: -0.06em;
      line-height: 0.9;
      margin: 0;
    }

    .bundle-ready h1 {
      font-size: clamp(42px, 11vw, 102px);
    }

    .ready-subtitle {
      color: rgba(255,255,255,0.78);
      font-size: clamp(18px, 4vw, 24px);
      max-width: 720px;
      margin: 22px auto 0;
      line-height: 1.32;
    }

    .ready-actions {
      display: flex;
      flex-direction: column;
      gap: 12px;
      max-width: 460px;
      margin: 32px auto 0;
    }

    .ready-button {
      display: grid;
      place-items: center;
      min-height: 58px;
      padding: 0 22px;
      font-family: Arial Black, Arial, sans-serif;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      text-decoration: none;
    }

    .ready-button--red {
      background: #E8000D;
      color: #fff;
    }

    .ready-button--dark {
      border: 1px solid rgba(255,255,255,0.22);
      color: #fff;
      background: rgba(255,255,255,0.04);
    }

    .next-steps {
      padding: 54px 0 72px;
      background: #050505;
    }

    .next-steps h2 {
      font-size: clamp(34px, 8vw, 70px);
      max-width: 760px;
      margin-bottom: 28px;
    }

    .step-grid {
      display: grid;
      gap: 14px;
    }

    .step-grid article {
      background: #111;
      border: 1px solid rgba(255,255,255,0.1);
      padding: 22px;
    }

    .step-grid span {
      display: grid;
      place-items: center;
      width: 34px;
      height: 34px;
      background: #E8000D;
      color: #fff;
      border-radius: 999px;
      font-family: Arial Black, Arial, sans-serif;
      margin-bottom: 18px;
    }

    .step-grid h3 {
      font-family: Arial Black, Arial, sans-serif;
      text-transform: uppercase;
      margin: 0 0 10px;
      font-size: 24px;
      line-height: 1;
    }

    .step-grid p {
      margin: 0;
      color: rgba(255,255,255,0.72);
      line-height: 1.5;
    }

    @media (min-width: 760px) {
      .ready-actions {
        flex-direction: row;
        justify-content: center;
        max-width: none;
      }

      .ready-button {
        min-width: 220px;
      }

      .step-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }
  </style>
</BaseLayout>
