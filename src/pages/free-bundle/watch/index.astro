---
import BaseLayout from '../../../layouts/BaseLayout.astro'

const title = 'Your Free Videos Are Ready | Joner Football'
const description = 'Your Joner Football free training videos are ready. Check your email or click below to watch.'
const canonical = 'https://jonerfootball.com/free-bundle/watch/'
const freeAppSectionUrl = 'https://app.jonerfootball.com/categories/category-vpi8uazway4?utm_source=free_bundle&utm_medium=thank_you_page&utm_campaign=free_bundle_followers&utm_content=open_free_section'
const cognitiveBundleUrl = 'https://app.jonerfootball.com/checkout/new?o=228257&utm_source=free_bundle&utm_medium=thank_you_page&utm_campaign=free_bundle_followers&utm_content=cognitive_bundle'
const coachSessionPlanUrl = 'https://app.jonerfootball.com/checkout/new?o=226775&utm_source=free_bundle&utm_medium=thank_you_page&utm_campaign=free_bundle_followers&utm_content=free_session_plan_pack'
const soloTrainingPackUrl = 'https://app.jonerfootball.com/checkout/new?o=226774&utm_source=free_bundle&utm_medium=thank_you_page&utm_campaign=free_bundle_followers&utm_content=free_solo_training_pack'
const coachesUrl = '/app/for-coaches/?utm_source=free_bundle&utm_medium=thank_you_page&utm_campaign=free_bundle_followers&utm_content=coaching_videos'
const playerUrl = 'https://app.jonerfootball.com/categories/category-qee31-z2mxo?utm_source=free_bundle&utm_medium=thank_you_page&utm_campaign=free_bundle_followers&utm_content=player_100_day_program'
const teamsUrl = '/teams/?utm_source=free_bundle&utm_medium=thank_you_page&utm_campaign=free_bundle_followers&utm_content=team_subscription'

const freeBundleSteps = [
  {
    label: '3 Videos',
    title: 'Cognitive Bundle',
    subtitle: 'Free training videos to sharpen decision making.',
    href: cognitiveBundleUrl,
    image: '/images/app/highlight-slide-1.png',
    external: true,
  },
  {
    label: 'Coaches',
    title: 'Session Plan Pack',
    subtitle: 'Free session plans to use with your players.',
    href: coachSessionPlanUrl,
    image: '/images/app/highlight-slide-3.png',
    external: true,
  },
  {
    label: 'Players',
    title: 'Solo Training Pack',
    subtitle: 'Free home training pack for sharper technique.',
    href: soloTrainingPackUrl,
    image: '/images/app/highlight-slide-2.png',
    external: true,
  },
]

const nextSteps = [
  {
    label: 'Players',
    title: 'Player Videos',
    subtitle: 'Train with structure and start the 100 Day Program.',
    href: playerUrl,
    image: '/images/free-bundle/player-videos-lee-coaching-ladder.webp',
    external: true,
  },
  {
    label: 'Coaches',
    title: 'Coaching Videos',
    subtitle: 'Session ideas, coaching detail and better progressions.',
    href: coachesUrl,
    image: '/images/app/audience-coaches-thumbnail.avif',
  },
  {
    label: 'Teams',
    title: 'Team Subscriptions',
    subtitle: 'Bring Joner Football training into your full team setup.',
    href: teamsUrl,
    image: '/images/join-live/teams.webp',
  },
]
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  noindex
  hideMobileAppCta
>
  <main class="bundle-watch-page">
    <section class="bundle-ready" aria-labelledby="bundle-ready-title">
      <picture class="bundle-ready__picture" aria-hidden="true">
        <source media="(max-width: 859px)" srcset="/images/free-bundle/check-email-mobile-v2.webp" type="image/webp" />
        <source media="(max-width: 859px)" srcset="/images/free-bundle/check-email-mobile-v2.png" type="image/png" />
        <source srcset="/images/free-bundle/check-your-email-desktop.webp" type="image/webp" />
        <img src="/images/free-bundle/check-your-email-desktop.png" alt="" />
      </picture>
      <div class="bundle-ready__shade" aria-hidden="true"></div>

      <div class="bundle-ready__inner">
        <div class="bundle-ready__copy">
          <p class="ready-eyebrow">Free videos ready</p>
          <h1 id="bundle-ready-title">Check Your Email</h1>
          <p class="ready-subtitle">
            I’ve sent the free bundle to your inbox, or click below to start watching now.
          </p>
          <div class="ready-actions">
            <a href={freeAppSectionUrl} target="_blank" rel="noopener noreferrer" class="btn-red ready-button">Open Free Videos</a>
          </div>
        </div>
      </div>
    </section>

    <section class="want-more" aria-labelledby="want-more-title">
      <div class="want-more__inner">
        <header class="want-more__header">
          <h2 id="want-more-title">Want More</h2>
          <p>Choose what fits you</p>
          <span class="want-more__rule" aria-hidden="true"></span>
        </header>

        <div class="watch-slider" data-watch-carousel>
          <p class="want-more__section-label">Free bundle links</p>
          <div class="watch-slider__track" aria-label="Claim more free Joner Football bundles" data-watch-track>
            {freeBundleSteps.map((step, index) => (
              <a
                href={step.href}
                class="next-step-card watch-slider__slide"
                target={step.external ? '_blank' : undefined}
                rel={step.external ? 'noopener noreferrer' : undefined}
                aria-label={`Claim ${step.title}`}
                data-watch-slide
                data-index={index}
              >
                <img src={step.image} alt="" aria-hidden="true" loading={index === 0 ? 'eager' : 'lazy'} class="next-step-card__bg" />
                <span class="next-step-card__shade" aria-hidden="true"></span>
                <span class="next-step-card__badge">{step.label}</span>
                <span class="next-step-card__body">
                  <span class="next-step-card__title">{step.title}</span>
                  <span class="next-step-card__subtitle">{step.subtitle}</span>
                </span>
                <span class="next-step-card__arrow" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
          <div class="watch-slider__dots" aria-hidden="true">
            {freeBundleSteps.map((_, index) => (
              <button type="button" class="watch-slider__dot" data-watch-dot data-dot-index={index} aria-label={`Go to free bundle ${index + 1}`}></button>
            ))}
          </div>
        </div>

        <div class="watch-slider watch-slider--second" data-watch-carousel>
          <p class="want-more__section-label want-more__section-label--second">Then pick your path</p>
          <div class="watch-slider__track" aria-label="Choose your next Joner Football path" data-watch-track>
            {nextSteps.map((step, index) => (
              <a
                href={step.href}
                class="next-step-card watch-slider__slide"
                target={step.external ? '_blank' : undefined}
                rel={step.external ? 'noopener noreferrer' : undefined}
                aria-label={`View ${step.title}`}
                data-watch-slide
                data-index={index}
              >
                <img src={step.image} alt="" aria-hidden="true" loading="lazy" class="next-step-card__bg" />
                <span class="next-step-card__shade" aria-hidden="true"></span>
                <span class="next-step-card__badge">{step.label}</span>
                <span class="next-step-card__body">
                  <span class="next-step-card__title">{step.title}</span>
                  <span class="next-step-card__subtitle">{step.subtitle}</span>
                </span>
                <span class="next-step-card__arrow" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
          <div class="watch-slider__dots" aria-hidden="true">
            {nextSteps.map((_, index) => (
              <button type="button" class="watch-slider__dot" data-watch-dot data-dot-index={index} aria-label={`Go to path ${index + 1}`}></button>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <style is:global>
    .bundle-watch-page {
      min-height: 100vh;
      background: #000;
      color: #fff;
    }

    .bundle-ready {
      position: relative;
      min-height: clamp(560px, 72svh, 650px);
      overflow: hidden;
      display: grid;
      align-items: center;
      border-bottom: 1px solid rgba(255,255,255,0.1);
      background: #000;
    }

    .bundle-ready__picture,
    .bundle-ready__picture img,
    .bundle-ready__shade {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    .bundle-ready__picture img {
      object-fit: cover;
      object-position: 62% center;
    }

    .bundle-ready__shade {
      background:
        radial-gradient(circle at 50% 45%, rgba(0,0,0,0.22) 0%, rgba(0,0,0,0.10) 34%, rgba(0,0,0,0.32) 100%),
        linear-gradient(180deg, rgba(0,0,0,0.04) 0%, rgba(0,0,0,0.06) 45%, rgba(0,0,0,0.42) 100%),
        linear-gradient(90deg, rgba(0,0,0,0.34) 0%, rgba(0,0,0,0.10) 52%, rgba(0,0,0,0.02) 100%);
    }

    .bundle-ready__inner,
    .want-more__inner {
      position: relative;
      z-index: 1;
      width: min(1120px, calc(100% - 32px));
      margin: 0 auto;
    }

    .bundle-ready__inner {
      padding: 34px 0;
    }

    .bundle-ready__copy {
      max-width: 880px;
      margin: 0 auto;
      text-align: center;
      text-shadow: 0 12px 34px rgba(0,0,0,0.78);
    }

    .ready-eyebrow {
      color: #E8000D;
      font-family: Anton, Impact, sans-serif;
      text-transform: uppercase;
      letter-spacing: 0.22em;
      font-size: 13px;
      margin: 0 0 14px;
    }

    .bundle-ready h1 {
      font-family: Anton, Impact, sans-serif;
      text-transform: uppercase;
      letter-spacing: 0.035em;
      line-height: 0.9;
      margin: 0;
      font-size: clamp(52px, 7vw, 86px);
      max-width: none;
    }

    .ready-subtitle {
      color: rgba(255,255,255,0.86);
      font-size: clamp(17px, 1.8vw, 22px);
      max-width: 640px;
      margin: 16px auto 0;
      line-height: 1.28;
      font-weight: 700;
    }

    .ready-actions {
      max-width: 360px;
      margin: 22px auto 0;
    }

    .ready-button {
      width: 100%;
      min-height: 58px;
      padding: 0 24px;
      font-size: 16px;
      letter-spacing: 0.08em;
    }

    .want-more {
      padding: 34px 0 78px;
      background: #050505;
    }

    .want-more__header {
      max-width: 650px;
      margin: 0 auto clamp(1.6rem, 3vw, 2.5rem);
      text-align: center;
    }

    .want-more h2 {
      margin: 0;
      color: #E30613;
      font-family: Anton, Impact, sans-serif;
      font-size: clamp(4rem, 7vw, 7.2rem);
      line-height: 0.88;
      letter-spacing: 0.035em;
      text-transform: uppercase;
      text-shadow: 0 1.2rem 2.6rem rgba(0,0,0,0.72);
    }

    .want-more__header p {
      margin: 0.9rem 0 0;
      color: #fff;
      font-family: Anton, Impact, sans-serif;
      font-size: clamp(1.35rem, 2.6vw, 2.25rem);
      line-height: 1;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .want-more__rule {
      display: block;
      width: 4.25rem;
      height: 3px;
      margin: 1.1rem auto 0;
      background: #E30613;
      box-shadow: 0 0 1rem rgba(227,6,19,0.48);
    }

    .want-more__section-label {
      margin: 0 auto 1rem;
      color: rgba(255,255,255,0.78);
      font-family: Anton, Impact, sans-serif;
      font-size: clamp(1rem, 1.7vw, 1.35rem);
      letter-spacing: 0.14em;
      text-align: center;
      text-transform: uppercase;
    }

    .want-more__section-label--second {
      margin-top: clamp(2rem, 4vw, 3rem);
    }

    .watch-slider {
      overflow: visible;
    }

    .watch-slider--second {
      margin-top: clamp(1.6rem, 3vw, 2.4rem);
    }

    .watch-slider__track {
      display: flex;
      gap: clamp(0.75rem, 1.4vw, 1rem);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: max(1rem, calc((100vw - 1120px) / 2));
      padding: 0 max(1rem, calc((100vw - 1120px) / 2)) 0.35rem;
      margin-inline: calc(50% - 50vw);
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }

    .watch-slider__track::-webkit-scrollbar {
      display: none;
    }

    .watch-slider__slide {
      flex: 0 0 min(86vw, 680px);
      aspect-ratio: 16 / 10;
      min-height: auto;
      scroll-snap-align: center;
      scroll-snap-stop: always;
    }

    .watch-slider__dots {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      margin-top: 1rem;
    }

    .watch-slider__dot {
      width: 8px;
      height: 8px;
      border: 0;
      border-radius: 999px;
      background: rgba(255,255,255,0.32);
      padding: 0;
      transition: width 220ms ease, background 220ms ease;
    }

    .watch-slider__dot[data-active='true'] {
      width: 26px;
      background: rgba(255,255,255,0.92);
    }

    .next-step-card {
      position: relative;
      display: flex;
      min-height: clamp(13rem, 17vw, 16rem);
      overflow: hidden;
      border: 1px solid rgba(255,255,255,0.34);
      border-radius: 0.55rem;
      background: #050505;
      color: #fff;
      text-decoration: none;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.16), 0 1rem 2.2rem rgba(0,0,0,0.32), 0 0 0 1px rgba(227,6,19,0.08);
      transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
    }

    .next-step-card::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      background: radial-gradient(circle at 82% 18%, rgba(227,6,19,0.22), transparent 30%), linear-gradient(135deg, rgba(255,255,255,0.14), transparent 34%);
      opacity: 0.72;
      mix-blend-mode: screen;
      transition: opacity 220ms ease;
    }

    .next-step-card:hover,
    .next-step-card:focus-visible {
      transform: translateY(-4px);
      border-color: rgba(255,255,255,0.72);
      box-shadow: inset 0 0 0 1px rgba(227,6,19,0.45), 0 1.35rem 2.75rem rgba(0,0,0,0.36), 0 0 2.2rem rgba(227,6,19,0.22);
      outline: none;
    }

    .next-step-card__bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center center;
      opacity: 0.95;
      filter: contrast(1.12) brightness(1.04) saturate(1.08);
      transition: opacity 220ms ease, transform 420ms ease, filter 220ms ease;
    }

    .next-step-card:hover .next-step-card__bg,
    .next-step-card:focus-visible .next-step-card__bg {
      opacity: 0.88;
      transform: scale(1.055);
      filter: contrast(1.16) brightness(1.08) saturate(1.12);
    }

    .next-step-card__shade {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(0,0,0,0), rgba(0,0,0,0.56)), linear-gradient(90deg, rgba(0,0,0,0.42), rgba(0,0,0,0.02));
    }

    .next-step-card__badge,
    .next-step-card__body,
    .next-step-card__arrow {
      position: relative;
      z-index: 2;
    }

    .next-step-card__badge {
      position: absolute;
      left: 1rem;
      top: 1rem;
      max-width: 7rem;
      font-family: Anton, Impact, sans-serif;
      font-size: 0.82rem;
      line-height: 0.9;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #fff;
      text-shadow: 0 2px 10px rgba(0,0,0,0.9);
    }

    .next-step-card__body {
      align-self: flex-end;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      padding: 4.3rem 1.2rem 1.15rem;
    }

    .next-step-card__title {
      font-family: Anton, Impact, sans-serif;
      font-size: clamp(1.7rem, 2.4vw, 2.4rem);
      line-height: 0.95;
      letter-spacing: 0.035em;
      text-transform: uppercase;
    }

    .next-step-card__subtitle {
      max-width: 18rem;
      font-family: Inter, system-ui, sans-serif;
      font-size: 0.84rem;
      line-height: 1.4;
      color: rgba(255,255,255,0.76);
    }

    .next-step-card__arrow {
      position: absolute;
      right: 1rem;
      bottom: 1rem;
      color: #E30613;
      font-family: Anton, Impact, sans-serif;
      font-size: 1.5rem;
    }

    @media (max-width: 859px) {
      .bundle-ready {
        min-height: clamp(520px, 74svh, 640px);
        align-items: end;
      }

      .bundle-ready__picture img {
        object-position: center center;
      }

      .bundle-ready__shade {
        background:
          linear-gradient(180deg, rgba(0,0,0,0.16) 0%, rgba(0,0,0,0.10) 34%, rgba(0,0,0,0.66) 78%, rgba(0,0,0,0.92) 100%),
          linear-gradient(90deg, rgba(0,0,0,0.20) 0%, rgba(0,0,0,0.08) 58%, rgba(0,0,0,0.10) 100%);
      }

      .bundle-ready__inner {
        width: min(100% - 28px, 390px);
        padding: 0 0 54px;
      }

      .bundle-ready__copy {
        max-width: 340px;
        margin: 0;
        text-align: left;
        padding: 0;
        background: transparent;
        border: 0;
        box-shadow: none;
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
      }

      .ready-eyebrow {
        font-size: 10px;
        letter-spacing: 0.16em;
        margin-bottom: 9px;
      }

      .bundle-ready h1 {
        font-size: clamp(37px, 11vw, 46px);
        max-width: 7.6ch;
      }

      .ready-subtitle {
        font-size: 15px;
        margin-top: 14px;
        margin-left: 0;
        margin-right: 0;
      }

      .ready-actions {
        margin-top: 18px;
      }

      .want-more {
        padding: 24px 0 58px;
      }

      .want-more h2 {
        font-size: clamp(3.6rem, 16vw, 5.2rem);
      }

      .watch-slider__track {
        scroll-padding-inline: 1rem;
        padding-inline: 1rem;
      }

      .watch-slider__slide {
        flex-basis: 88vw;
      }

      .next-step-card {
        min-height: 12.5rem;
      }
    }
  </style>

  <script>
    document.querySelectorAll('[data-watch-carousel]').forEach((carousel) => {
      const track = carousel.querySelector('[data-watch-track]')
      const slides = Array.from(carousel.querySelectorAll('[data-watch-slide]'))
      const dots = Array.from(carousel.querySelectorAll('[data-watch-dot]'))
      if (!track || !slides.length || !dots.length) return

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      let current = 0

      const setActive = (index) => {
        current = index
        dots.forEach((dot, dotIndex) => {
          dot.dataset.active = dotIndex === index ? 'true' : 'false'
        })
      }

      const goTo = (index) => {
        const target = slides[index]
        if (!target) return
        const offset = target.offsetLeft - (track.clientWidth - target.clientWidth) / 2
        track.scrollTo({ left: offset, behavior: reduced ? 'auto' : 'smooth' })
      }

      const updateFromScroll = () => {
        const trackCenter = track.scrollLeft + track.clientWidth / 2
        let bestIndex = 0
        let bestDistance = Number.POSITIVE_INFINITY

        slides.forEach((slide, index) => {
          const slideCenter = slide.offsetLeft + slide.clientWidth / 2
          const distance = Math.abs(trackCenter - slideCenter)
          if (distance < bestDistance) {
            bestDistance = distance
            bestIndex = index
          }
        })

        setActive(bestIndex)
      }

      let scrollTimer
      track.addEventListener('scroll', () => {
        if (scrollTimer) window.clearTimeout(scrollTimer)
        scrollTimer = window.setTimeout(updateFromScroll, 80)
      }, { passive: true })

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const index = Number(dot.dataset.dotIndex || 0)
          setActive(index)
          goTo(index)
        })
      })

      setActive(0)
    })
  </script>
</BaseLayout>
