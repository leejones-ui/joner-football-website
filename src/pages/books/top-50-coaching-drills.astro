---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { top50Book as book, samplePages, chapters, rules, isShopUrl } from '../../data/top50-book'

const pdfLive = isShopUrl(book.pdfUrl)
const paperbackLive = isShopUrl(book.paperbackUrl)
const pageUrl = `https://jonerfootball.com${book.page}`
const first = samplePages[0]

const offer = (price: string, url: string) => ({
  '@type': 'Offer',
  price,
  priceCurrency: 'AUD',
  availability: 'https://schema.org/InStock',
  url,
})

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: book.title,
  author: { '@type': 'Person', name: 'Lee Jones', url: 'https://jonerfootball.com/about/' },
  publisher: { '@type': 'Organization', name: 'Joner Football', url: 'https://jonerfootball.com/' },
  image: `https://jonerfootball.com${book.coverJpg}`,
  url: pageUrl,
  datePublished: book.releaseDate,
  inLanguage: 'en',
  about: 'Football (soccer) coaching drills',
  workExample: [
    {
      '@type': 'Book',
      bookFormat: 'https://schema.org/EBook',
      name: `${book.title} (PDF)`,
      ...(pdfLive ? { offers: offer('24.00', book.pdfUrl) } : {}),
    },
    {
      '@type': 'Book',
      bookFormat: 'https://schema.org/Paperback',
      name: `${book.title} (Paperback)`,
      ...(paperbackLive ? { offers: offer('55.00', book.paperbackUrl) } : {}),
    },
  ],
}

const pad = (n: number) => String(n).padStart(2, '0')
---

<BaseLayout
  title="Top 50 Coaching Drills by Lee Jones | Joner Football"
  description="My top 50 drills from 20 years of coaching. One page each, with diagrams, coaching points and a QR code to the video. Out now as a PDF and a paperback."
  canonical={pageUrl}
  ogImage={`https://jonerfootball.com${book.og}`}
  schema={schema}
  hideMobileAppCta
>
  <div class="t50" id="t50">
    <!-- 1. Hero -->
    <section class="hero" aria-labelledby="t50-title">
      <div class="shell hero__grid">
        <div class="hero__copy">
          <h1 id="t50-title" class="label label--red">Top 50 Coaching Drills <span>by Lee Jones</span></h1>
          <p class="hero__big">20 years of coaching.<br /><em>My top 50 drills.</em></p>
          <p class="hero__lede">I have worked on this book for a long time. These are the drills I love and use the most. One page each. Every drill on video.</p>

          <div class="buy-row">
            {pdfLive ? (
              <a class="btn btn--red" href={book.pdfUrl} target="_blank" rel="noopener noreferrer" data-book-cta="pdf-hero">Buy the PDF <b>{book.pdfPrice}</b></a>
            ) : (
              <span class="btn btn--red is-pending">Buy the PDF <b>{book.pdfPrice}</b></span>
            )}
            {paperbackLive ? (
              <a class="btn btn--line" href={book.paperbackUrl} target="_blank" rel="noopener noreferrer" data-book-cta="paperback-hero">Buy the paperback <b>{book.paperbackPrice}</b></a>
            ) : (
              <span class="btn btn--line is-pending">Buy the paperback <b>{book.paperbackPrice}</b></span>
            )}
          </div>
          <p class="hero__note">Out now as a PDF and a paperback.</p>
        </div>

        <div class="hero__book">
          <div class="book3d" id="book3d">
            <img src={book.cover} alt="Front cover of Top 50 Coaching Drills by Lee Jones" width="1100" height="1557" loading="eager" fetchpriority="high" decoding="async" />
          </div>
        </div>
      </div>
    </section>

    <!-- 2. A note from Lee -->
    <section class="note" aria-labelledby="note-title">
      <div class="shell note__grid">
        <figure class="note__photo rv">
          <img src={book.leePhoto} alt="Lee Jones coaching on one knee in front of goal" width="1400" height="2100" loading="lazy" decoding="async" />
        </figure>

        <div class="note__letter rv">
          <p class="label label--mono" id="note-title">A note from Lee</p>
          <p class="note__open">I have been working on this book for a long time.</p>
          <p>I've been coaching for 20 years. Young players, professionals and camps around the world.</p>
          <p>I went through every drill I use and picked my top 50. These are the drills I love and use the most. They are proven, and they all put technique above everything.</p>
          <p>Every drill gets one page. The setup from above, the drill in play and the progression. My coaching points, the common mistakes, and how to make it easier or harder.</p>
          <p>Then you scan the QR code and watch the real session.</p>
          <p>It is for coaches at every level, and for the players and parents who want to train properly.</p>
          <p class="note__pull">Never turn up to training without a plan again.</p>
          <p class="note__sign">Lee</p>
        </div>
      </div>
    </section>

    <!-- 3. Look inside -->
    <section class="inside" aria-labelledby="inside-title">
      <div class="shell">
        <div class="sec-head rv">
          <p class="label label--red">Look inside</p>
          <h2 id="inside-title">A complete drill.<br />One page.</h2>
          <p>Understand the setup, follow the action, then add the challenge. Here are six real pages from the book.</p>
        </div>

        <div class="viewer rv" id="viewer">
          <div class="viewer__tabs" role="tablist" aria-label="Sample pages">
            {samplePages.map((p, i) => (
              <button
                type="button"
                role="tab"
                class:list={['vtab', { 'is-on': i === 0 }]}
                aria-selected={i === 0 ? 'true' : 'false'}
                data-src={p.src}
                data-n={p.n}
                data-title={p.title}
                data-meta={`${p.chapter} · Ages ${p.age} · ${p.level}`}
                data-note={p.note}
              >
                <span class="vtab__n">{p.n}</span>
                <span class="vtab__t">{p.title}<small>{p.chapter}</small></span>
              </button>
            ))}
          </div>

          <button type="button" class="viewer__page" id="viewer-open" aria-label="Open this page full size">
            <img id="viewer-img" src={first.src} alt={`Drill ${first.n}, ${first.title}, from Top 50 Coaching Drills`} width="1400" height="1979" loading="lazy" decoding="async" />
            <span class="viewer__zoom">Tap to read it full size</span>
          </button>

          <aside class="viewer__note" aria-live="polite">
            <p class="viewer__drill"><span id="viewer-n">{first.n}</span> <span id="viewer-title">{first.title}</span></p>
            <p class="viewer__meta" id="viewer-meta">{`${first.chapter} · Ages ${first.age} · ${first.level}`}</p>
            <p class="label label--mono">Joner's notes</p>
            <blockquote id="viewer-quote">{first.note}</blockquote>
            <p class="viewer__by">My note on this drill, straight from the page.</p>
          </aside>
        </div>
      </div>
    </section>

    <!-- 4. Contents -->
    <section class="toc" aria-labelledby="contents-title">
      <div class="shell">
        <div class="sec-head sec-head--light rv">
          <p class="label label--red">Find your next drill</p>
          <h2 id="contents-title">Fifty drills.<br />Five chapters.</h2>
        </div>

        <div class="chapters">
          {chapters.map((c) => (
            <details class="chapter rv" open>
              <summary>
                <span class="chapter__n">{c.n}</span>
                <span class="chapter__name">{c.name}</span>
                <span class="chapter__count">{c.drills.length} drills</span>
              </summary>
              <p class="chapter__line">{c.line}</p>
              <ol>
                {c.drills.map((d, i) => (
                  <li><span>{pad(c.start + i)}</span>{d}</li>
                ))}
              </ol>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 5. Ten rules -->
    <section class="rules" aria-labelledby="rules-title">
      <div class="shell rules__grid">
        <div class="rules__side rv">
          <p class="label label--red">Ten rules I coach by</p>
          <h2 id="rules-title">Technique above everything.</h2>
          <dl class="focus">
            <div><dt>Energy</dt><dd>My number one rule.</dd></div>
            <div><dt>Confidence</dt><dd>Build it. Never break it.</dd></div>
            <div><dt>Detail</dt><dd>Coach the small things.</dd></div>
          </dl>
        </div>

        <ol class="rules__list">
          {rules.map(([head, text], i) => (
            <li class="rv">
              <span class="rules__n">{pad(i + 1)}</span>
              <div>
                <h3>{head}</h3>
                <p>{text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 6. Videos -->
    <section class="videos" aria-labelledby="videos-title">
      <div class="shell videos__grid rv">
        <h2 id="videos-title">Scan it.<br />Watch it.<br />Coach it.</h2>
        <div>
          <p class="videos__lede">Every drill has a QR code. Scan it and watch the real session.</p>
          <p class="videos__split"><b>37</b> videos are free. <b>13</b> are in the Joner Football App.</p>
        </div>
      </div>
    </section>

    <!-- 7. About Lee -->
    <section class="about" aria-labelledby="about-title">
      <div class="shell about__grid">
        <div class="about__copy rv">
          <p class="label label--mono">About me</p>
          <h2 id="about-title">The detail makes the difference.</h2>
          <p>I played for Everton as a junior and professionally for Wrexham. I am an A Licence coach, originally from the UK, and I now live in Sydney.</p>
          <p>I started Joner Football here in 2013 with a bag of balls. Today it is a training facility in Sydney, a following of over 2.5 million and one of football's largest coaching communities.</p>
          <p>My mission is simple. Help the next generation fall in love with the game, and give coaches the tools to teach it properly.</p>
        </div>
        <figure class="about__photo rv">
          <img src={book.hqPhoto} alt="Lee Jones outside the Joner Football training facility in Sydney" width="1400" height="936" loading="lazy" decoding="async" />
        </figure>
      </div>
    </section>

    <!-- 8. Buy -->
    <section class="buy" id="buy" aria-labelledby="buy-title">
      <div class="shell buy__grid">
        <div class="buy__covers rv">
          <img class="buy__back" src="/images/books/top-50-coaching-drills/back-cover.webp" alt="Back cover of Top 50 Coaching Drills" width="1000" height="1402" loading="lazy" decoding="async" />
          <img class="buy__cover" src={book.cover} alt="Top 50 Coaching Drills by Lee Jones" width="1100" height="1557" loading="lazy" decoding="async" />
        </div>
        <div class="rv">
          <h2 id="buy-title">Never turn up to training without a plan again.</h2>

          <div class="formats">
            <div class="format">
              <p class="format__name">PDF</p>
              <p class="format__price">{book.pdfPrice}</p>
              <p class="format__when">Out now. Download link emailed straight after checkout.</p>
              {pdfLive ? (
                <a class="btn btn--red" href={book.pdfUrl} target="_blank" rel="noopener noreferrer" data-book-cta="pdf">Buy the PDF</a>
              ) : (
                <span class="btn btn--red is-pending">Buy the PDF</span>
              )}
            </div>
            <div class="format">
              <p class="format__name">Paperback</p>
              <p class="format__price">{book.paperbackPrice}</p>
              <p class="format__when">Out now. Printed and posted to you.</p>
              {paperbackLive ? (
                <a class="btn btn--white" href={book.paperbackUrl} target="_blank" rel="noopener noreferrer" data-book-cta="paperback">Buy the paperback</a>
              ) : (
                <span class="btn btn--white is-pending">Buy the paperback</span>
              )}
            </div>
          </div>

          <p class="buy__more"><a href="/books/">All my books</a></p>
        </div>
      </div>
    </section>

    <!-- Phone: buy bar once the first screen has gone -->
    <div class="stickybuy" id="stickybuy" hidden>
      <p><b>Top 50 Coaching Drills</b><span>PDF {book.pdfPrice} · Paperback {book.paperbackPrice}</span></p>
      <a class="btn btn--red" href="#buy">Buy the book</a>
    </div>

    <!-- Full size page -->
    <dialog class="zoom" id="zoom" aria-label="Drill page, full size">
      <button type="button" class="zoom__close" id="zoom-close" aria-label="Close">Close</button>
      <div class="zoom__scroll"><img id="zoom-img" alt="" width="1400" height="1979" /></div>
    </dialog>
  </div>
</BaseLayout>

<script>
  const root = document.getElementById('t50')
  if (root) {
    root.classList.add('js')
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    // Reveal on scroll
    const items = root.querySelectorAll('.rv')
    if (reduce || !('IntersectionObserver' in window)) {
      items.forEach((el) => el.classList.add('in'))
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in')
              io.unobserve(e.target)
            }
          })
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
      )
      items.forEach((el) => io.observe(el))
    }

    // Sample page viewer
    const img = document.getElementById('viewer-img') as HTMLImageElement | null
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.vtab'))
    const set = (id: string, text: string) => {
      const el = document.getElementById(id)
      if (el) el.textContent = text
    }
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        if (!img || tab.classList.contains('is-on')) return
        tabs.forEach((t) => {
          t.classList.toggle('is-on', t === tab)
          t.setAttribute('aria-selected', t === tab ? 'true' : 'false')
        })
        const d = tab.dataset
        img.classList.add('is-swapping')
        const next = new Image()
        next.onload = () => {
          img.src = d.src || ''
          img.alt = `Drill ${d.n}, ${d.title}, from Top 50 Coaching Drills`
          img.classList.remove('is-swapping')
        }
        next.src = d.src || ''
        set('viewer-n', d.n || '')
        set('viewer-title', d.title || '')
        set('viewer-meta', d.meta || '')
        set('viewer-quote', d.note || '')
        tab.scrollIntoView({ block: 'nearest', inline: 'center', behavior: reduce ? 'auto' : 'smooth' })
      })
    })

    // Full size page
    const zoom = document.getElementById('zoom') as HTMLDialogElement | null
    const zoomImg = document.getElementById('zoom-img') as HTMLImageElement | null
    document.getElementById('viewer-open')?.addEventListener('click', () => {
      if (!zoom || !zoomImg || !img) return
      zoomImg.src = img.src
      zoomImg.alt = img.alt
      if (typeof zoom.showModal === 'function') zoom.showModal()
      else window.open(img.src, '_blank', 'noopener')
    })
    document.getElementById('zoom-close')?.addEventListener('click', () => zoom?.close())
    zoom?.addEventListener('click', (e) => {
      if (e.target === zoom) zoom.close()
    })

    // Contents: on a phone only the first chapter starts open
    if (window.matchMedia('(max-width: 760px)').matches) {
      root.querySelectorAll<HTMLDetailsElement>('.chapter').forEach((c, i) => {
        if (i > 0) c.open = false
      })
    }

    // The book turns a little towards the pointer
    const book = document.getElementById('book3d')
    const hero = root.querySelector<HTMLElement>('.hero')
    if (book && hero && !reduce && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      hero.addEventListener('pointermove', (e) => {
        const r = hero.getBoundingClientRect()
        const x = (e.clientX - r.left) / r.width - 0.5
        const y = (e.clientY - r.top) / r.height - 0.5
        book.style.setProperty('--ry', `${-24 + x * 16}deg`)
        book.style.setProperty('--rx', `${4 - y * 8}deg`)
      })
      hero.addEventListener('pointerleave', () => {
        book.style.removeProperty('--ry')
        book.style.removeProperty('--rx')
      })
    }

    // Phone buy bar
    const bar = document.getElementById('stickybuy')
    const buy = document.getElementById('buy')
    if (bar && hero && buy && 'IntersectionObserver' in window) {
      let heroGone = false
      let buySeen = false
      const paint = () => {
        bar.hidden = !(heroGone && !buySeen)
      }
      new IntersectionObserver(([e]) => {
        heroGone = !e.isIntersecting
        paint()
      }).observe(hero)
      new IntersectionObserver(([e]) => {
        buySeen = e.isIntersecting
        paint()
      }).observe(buy)
    }
  }
</script>

<style>
  .t50 {
    --red: #e8000d;
    --ink: #0a0a0a;
    --paper: #f3eee2;
    --paper-line: #d9d1bf;
    --soft: #c9c9c9;
    --serif: Georgia, 'Times New Roman', serif;
    --mono: 'Courier New', Courier, monospace;
    --sans: 'Inter', 'DM Sans', system-ui, sans-serif;
    --display: 'Anton', Impact, sans-serif;
    background: var(--ink);
    color: #fff;
    font-family: var(--sans);
    overflow-x: clip;
  }
  .shell { width: min(1240px, calc(100% - 40px)); margin: 0 auto; }
  h2 { font-family: var(--display); font-weight: 400; text-transform: uppercase; letter-spacing: 0.01em; line-height: 0.98; margin: 0; font-size: clamp(40px, 6vw, 84px); }
  p { margin: 0; }

  .label { margin: 0 0 18px; font-size: 13px; font-weight: 800; letter-spacing: 0.2em; text-transform: uppercase; line-height: 1.4; }
  .label--red { color: var(--red); }
  .label--mono { font-family: var(--mono); font-weight: 700; letter-spacing: 0.16em; color: var(--red); }

  /* Buttons */
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 56px; padding: 0 26px; border: 2px solid var(--red); font-family: var(--sans); font-weight: 800; font-size: 16px; line-height: 1.2; text-align: center; text-decoration: none; cursor: pointer; transition: background 160ms ease, color 160ms ease, border-color 160ms ease, transform 160ms ease; }
  .btn b { font-weight: 800; padding-left: 10px; border-left: 1px solid rgba(255, 255, 255, 0.45); }
  .btn--red { background: var(--red); color: #fff; }
  .btn--red:hover, .btn--red:focus-visible { background: #fff; border-color: #fff; color: var(--ink); }
  .btn--red:hover b, .btn--red:focus-visible b { border-left-color: rgba(0, 0, 0, 0.35); }
  .btn--line { background: transparent; color: #fff; border-color: rgba(255, 255, 255, 0.55); }
  .btn--line:hover, .btn--line:focus-visible { border-color: #fff; background: rgba(255, 255, 255, 0.1); }
  .btn--white { background: #fff; border-color: #fff; color: var(--ink); }
  .btn--white:hover, .btn--white:focus-visible { background: transparent; color: #fff; }
  .btn.is-pending { cursor: default; }
  a.btn:active { transform: translateY(1px); }

  /* 1. Hero */
  .hero { position: relative; isolation: isolate; padding: clamp(28px, 5vw, 72px) 0 clamp(56px, 8vw, 110px); overflow: hidden; }
  .hero::before { content: ''; position: absolute; z-index: -1; right: -10%; top: -20%; width: 70%; height: 140%; background: radial-gradient(closest-side, rgba(232, 0, 13, 0.34), rgba(232, 0, 13, 0) 70%); }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr); gap: clamp(24px, 5vw, 80px); align-items: center; }
  .hero h1 { font-family: var(--sans); margin: 0 0 22px; }
  .hero h1 span { color: #fff; }
  .hero__big { font-family: var(--display); text-transform: uppercase; font-size: clamp(52px, 8.2vw, 124px); line-height: 0.93; letter-spacing: 0.005em; }
  .hero__big em { font-style: normal; color: var(--red); }
  .hero__lede { max-width: 560px; margin-top: 26px; color: #e6e6e6; font-size: clamp(17px, 1.6vw, 21px); line-height: 1.55; }
  .buy-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .hero__note { margin-top: 18px; color: var(--soft); font-size: 14px; }

  .hero__book { display: grid; place-items: center; perspective: 1900px; padding: 20px 0; }
  .book3d { --w: min(430px, 34vw); --t: 26px; --ry: -24deg; --rx: 4deg; position: relative; width: var(--w); aspect-ratio: 1100 / 1557; transform-style: preserve-3d; transform: rotateX(var(--rx)) rotateY(var(--ry)); transition: transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  .book3d img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: translateZ(calc(var(--t) / 2)); border-radius: 2px 4px 4px 2px; box-shadow: inset 6px 0 10px -6px rgba(0, 0, 0, 0.7); }
  .book3d::before { content: ''; position: absolute; top: 1%; right: 0; width: var(--t); height: 98%; transform: translateX(calc(var(--t) / 2 - 2px)) rotateY(90deg); background: repeating-linear-gradient(90deg, #fff 0 1px, #d9d9d9 1px 2px); }
  .book3d::after { content: ''; position: absolute; inset: 0; transform: translateZ(calc(var(--t) / -2)); background: #050505; border-radius: 2px 4px 4px 2px; box-shadow: -30px 40px 70px rgba(0, 0, 0, 0.75), -8px 10px 20px rgba(0, 0, 0, 0.6); }

  /* 2. Note from Lee */
  .note { background: var(--paper); color: #1a1a1a; padding: clamp(56px, 8vw, 120px) 0; }
  .note__grid { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr); gap: clamp(28px, 6vw, 90px); align-items: start; }
  .note__photo { margin: 0; position: relative; }
  .note__photo img { display: block; width: 100%; height: auto; }
  .note__photo::after { content: ''; position: absolute; left: -14px; bottom: -14px; width: 46%; height: 10px; background: var(--red); }
  .note__letter { font-family: var(--serif); font-size: clamp(18px, 1.55vw, 21px); line-height: 1.65; max-width: 580px; }
  .note__letter p + p { margin-top: 1em; }
  .note__letter .label { margin-bottom: 22px; }
  .note__open { font-size: clamp(26px, 3vw, 38px); line-height: 1.22; color: #000; }
  .note__pull { margin-top: 1.5em !important; padding-top: 1.1em; border-top: 2px solid #1a1a1a; font-family: var(--display); text-transform: uppercase; font-size: clamp(28px, 3.4vw, 46px); line-height: 1.02; color: #000; }
  .note__sign { margin-top: 0.9em !important; font-style: italic; font-size: clamp(26px, 2.6vw, 34px); color: var(--red); }

  /* 3. Look inside */
  .inside { background: #fff; color: #111; padding: clamp(56px, 8vw, 120px) 0; }
  .sec-head { max-width: 760px; margin-bottom: clamp(28px, 4vw, 52px); }
  .sec-head p:not(.label) { margin-top: 18px; font-size: clamp(17px, 1.5vw, 20px); line-height: 1.55; color: #444; }
  .sec-head--light p:not(.label) { color: var(--soft); }

  .viewer { display: grid; grid-template-columns: minmax(0, 270px) minmax(0, 1fr) minmax(0, 300px); gap: clamp(20px, 3vw, 44px); align-items: start; }
  .viewer__tabs { display: grid; gap: 8px; position: sticky; top: 96px; }
  .vtab { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 12px; align-items: center; width: 100%; min-height: 64px; padding: 10px 14px 10px 10px; border: 1px solid #dcdcdc; background: #fff; color: #111; font: inherit; text-align: left; cursor: pointer; transition: border-color 150ms ease, background 150ms ease, color 150ms ease; }
  .vtab__n { display: grid; place-items: center; height: 44px; background: #111; color: #fff; font-family: var(--display); font-size: 20px; letter-spacing: 0.03em; transition: background 150ms ease; }
  .vtab__t { font-weight: 800; font-size: 15px; line-height: 1.25; }
