  </main>

  {/* Sticky mobile CTA: revealed once the user scrolls past the hero. Mirrors the /app pattern. */}
  <a href={checkoutUrl} target="_blank" rel="noopener noreferrer" class="coaches-mobile-cta btn-red" data-meta-checkout-event="CoachesPageMobileStickyClick">JOIN COACHES ONLY</a>

  <style>
    .coach-closer-stage-image {
      opacity: 0;
      transform: scale(0.94) translateY(14px);
      filter: blur(6px);
      pointer-events: none;
      will-change: opacity, transform, filter;
      transition: opacity 520ms cubic-bezier(0.32, 0.72, 0, 1), transform 720ms cubic-bezier(0.32, 0.72, 0, 1), filter 520ms cubic-bezier(0.32, 0.72, 0, 1);
    }
    .coach-closer-stage-image[data-active='true'] {
      opacity: 1;
      transform: scale(1) translateY(0);
      filter: blur(0);
    }
    .coach-closer-stage-glow {
      background: radial-gradient(60% 60% at 80% 20%, rgba(227, 6, 19, 0.10), transparent 60%), radial-gradient(50% 50% at 20% 80%, rgba(255, 255, 255, 0.04), transparent 60%);
      opacity: 0.85;
    }
    .coach-closer-pill-btn {
      background: #1c1c1c;
      transition: background-color 320ms cubic-bezier(0.32, 0.72, 0, 1), transform 320ms cubic-bezier(0.32, 0.72, 0, 1);
    }
    .coach-closer-pill-btn:hover { background: #252525; }
    .coach-closer-pill[data-open='true'] .coach-closer-pill-btn { background: #2a2a2a; }
    .coach-closer-icon { background: rgba(255, 255, 255, 0.15); transition: background-color 320ms cubic-bezier(0.32, 0.72, 0, 1); }
    .coach-closer-pill[data-open='true'] .coach-closer-icon { background: rgba(227, 6, 19, 0.85); }
    .coach-closer-plus { transition: transform 380ms cubic-bezier(0.32, 0.72, 0, 1); }
    .coach-closer-pill[data-open='true'] .coach-closer-plus { transform: rotate(45deg); }
    .coach-closer-panel { transition: grid-template-rows 520ms cubic-bezier(0.32, 0.72, 0, 1); }
    .coach-closer-pill[data-open='true'] .coach-closer-panel { grid-template-rows: 1fr; }
    .coach-closer-panel-content { opacity: 0; transform: translateY(10px); transition: opacity 460ms cubic-bezier(0.32, 0.72, 0, 1), transform 520ms cubic-bezier(0.32, 0.72, 0, 1); }
    .coach-closer-pill[data-open='true'] .coach-closer-panel-content { opacity: 1; transform: translateY(0); }
    .pl-13 { padding-left: 3.25rem; }

    @media (prefers-reduced-motion: reduce) {
      .coach-closer-stage-image,
      .coach-closer-pill-btn,
      .coach-closer-icon,
      .coach-closer-plus,
      .coach-closer-panel,
      .coach-closer-panel-content { transition: none !important; }
      .coach-closer-stage-image { filter: none; transform: none; }
    }

    @media (max-width: 767px) {
      .coaches-page { display: flex; flex-direction: column; }
      .coaches-page > section { order: 3; }
      .coaches-video { order: 1; padding-top: 2rem; }
      .coaches-hero { order: 2; }
      .coaches-video h2 { font-size: clamp(2rem, 10vw, 3.25rem); }
    }

    .coaches-mobile-cta {
      position: fixed; left: 0.75rem; right: 0.75rem; bottom: 0.75rem; z-index: 40;
      display: none;
      opacity: 0;
      transform: translateY(110%);
      pointer-events: none;
      transition: opacity 280ms ease, transform 360ms cubic-bezier(0.32, 0.72, 0, 1);
      box-shadow: 0 18px 38px rgba(0, 0, 0, 0.42);
      text-align: center;
    }
    .coaches-mobile-cta.is-revealed { opacity: 1; transform: translateY(0); pointer-events: auto; }
    @media (max-width: 1024px), (hover: none) and (pointer: coarse) {
      .coaches-mobile-cta { display: inline-flex; }
      body { padding-bottom: 90px; }
    }
  </style>

  <script is:inline>
    ;(function () {
      var buttons = Array.prototype.slice.call(document.querySelectorAll('[data-coach-pill-btn]'));
      var images = Array.prototype.slice.call(document.querySelectorAll('[data-coach-stage-image]'));
      if (!buttons.length || !images.length) return;

      function setCoachActive(id) {
        buttons.forEach(function (btn) {
          var targetId = btn.getAttribute('data-coach-pill-btn');
          var pill = btn.closest('.coach-closer-pill');
          var panel = pill ? pill.querySelector('.coach-closer-panel') : null;
          var isTarget = targetId === id;
          btn.setAttribute('aria-expanded', isTarget ? 'true' : 'false');
          if (pill) pill.setAttribute('data-open', isTarget ? 'true' : 'false');
          if (panel) panel.setAttribute('aria-hidden', isTarget ? 'false' : 'true');
        });
        images.forEach(function (img) {
          img.setAttribute('data-active', img.getAttribute('data-coach-stage-image') === id ? 'true' : 'false');
        });
      }

      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          setCoachActive(btn.getAttribute('data-coach-pill-btn') || '0');
        });
      });
    })();

    ;(function () {
      var cta = document.querySelector('.coaches-mobile-cta');
      if (!cta || !('IntersectionObserver' in window)) return;
      var isMobile = window.matchMedia && window.matchMedia('(max-width: 767px)').matches;
      var trigger = document.querySelector(isMobile ? '.coaches-video' : '.coaches-hero');
      if (!trigger) return;
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          cta.classList.toggle('is-revealed', !entry.isIntersecting);
        });
      }, { threshold: 0, rootMargin: '-40px 0px 0px 0px' });
      io.observe(trigger);
    })();
  </script>
</BaseLayout>
)}
