    {/* ========== 9. FINAL CTA ========== */}
    <section class="bg-joner-black py-20 md:py-28">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <p class="text-joner-red font-heading text-sm uppercase tracking-widest mb-4">COACH BETTER THIS WEEK</p>
        <h2 class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold text-white uppercase leading-none mb-6">
          COACH LIKE LEE.<br/>NOTHING HELD BACK.
