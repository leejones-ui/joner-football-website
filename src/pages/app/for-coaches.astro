---
import BaseLayout from '../../layouts/BaseLayout.astro'
import CoachesTestimonialsCarousel from '../../components/CoachesTestimonialsCarousel.astro'

const title = 'Football Coaching App | Drills & Session Plans | Joner Football'
const description = 'Give coaches clear football drills, session ideas and technical detail through the Joner Football App. Build sharper sessions for every player.'
const annualCheckoutUrl = 'https://app.jonerfootball.com/checkout/new?o=202578'
const monthlyCheckoutUrl = 'https://app.jonerfootball.com/checkout/new?o=230698'
const checkoutUrl = annualCheckoutUrl
const appCategoryUrl = 'https://app.jonerfootball.com/categories/category-8-7szqoiq00'
const previewUrl = 'https://app.jonerfootball.com/programs/how-to-use-joner-football-app-guide?utm_source=product&utm_medium=share&utm_campaign=content_share&utm_term=4067217&utm_content=copy'
const sampleSessionUrl = 'https://app.jonerfootball.com/programs/coaches-session-plan-1-0c96c6'
const freeBundleUrl = 'https://app.jonerfootball.com/checkout/new?o=226775'

// Coaches Only is included in the Max Plan tier. Monthly and annual use the same checkout IDs as the draft join Max plan.
const yearlyPrice = '$249 USD'
const monthlyPrice = '$39.99 USD'

// FAQ schema so Google can pull these as rich results in search
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [] as Array<{ '@type': string; name: string; acceptedAnswer: { '@type': string; text: string } }>
}

// Product schema for Google rich results
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Joner Football App: Coaches Only (Max Plan)',
  description: 'Premium coaching tier inside the Joner Football App. Session plans, voice-over drill breakdowns, full training sessions, and coach development from Lee Jones.',
  brand: { '@type': 'Brand', name: 'Joner Football' },
  image: 'https://jonerfootball.com/images/coaches-only/coaches-only-hero-updated.png',
  offers: [
    {
      '@type': 'Offer',
      name: 'Annual Plan',
      price: '249.00',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      url: 'https://jonerfootball.com/app/for-coaches/'
    },
    {
      '@type': 'Offer',
      name: 'Monthly Plan',
      price: '39.99',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      url: 'https://jonerfootball.com/app/for-coaches/'
    }
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    reviewCount: '120'
  }
}

// 8 feature blocks, /app-page-style horizontal cards
const features = [
  {
    eyebrow: 'START HERE',
    title: 'App And Session Planner Walkthrough',
    body: 'See how Lee uses the Joner Football App and Sports Session Planner to find drills, build sessions, manage difficulty, and plan with purpose. The full walkthrough no other coach is showing you.',
    image: '/images/coaches-only/app-session-planner.png'
  },
  {
    eyebrow: 'READY TO USE',
    title: 'Session Plans Built To Run',
    body: 'Structured coaching sessions you take straight onto the pitch. No more building from scratch on Tuesday at 5pm. Clear flow, real progression, every age group.',
    image: '/images/coaches-only/session-planning.png'
  },
  {
    eyebrow: 'THE DETAIL',
    title: 'Voice Over Drill Series',
    body: 'Lee narrates the drill while it runs. What he is looking for, why the practice works, how to coach the detail. The bit no YouTube channel gives you.',
    image: '/images/coaches-only/voice-over-series.png'
  },
  {
    eyebrow: 'COACH EDUCATION',
    title: 'Coaching The Coaches',
    body: 'Practical coach development. Better language. Better standards. Better player outcomes. Sharpen how you actually teach, not just what you teach.',
    image: '/images/coaches-only/coaching-the-coaches.png'
  },
  {
    eyebrow: 'WATCH THE FLOW',
    title: 'Full Training Sessions',
    body: 'Extended sessions showing how Lee combines technical work, intensity, detail, and progression across a full training block. Copy them. Run them. Watch your team level up.',
    image: '/images/coaches-only/full-training-sessions.png'
  },
  {
    eyebrow: 'FOR GROUPS',
    title: 'Team Training',
    body: 'Group sessions that still keep individual technique at the centre. For grassroots, academy, and private coaching environments.',
    image: '/images/coaches-only/team-training.png'
  },
  {
    eyebrow: 'ELITE DETAIL',
    title: 'Coaching Professionals',
    body: 'How Lee coaches elite players. The detail, standards, and language used in professional environments. The same masterclass coaches pay thousands to be in the room for.',
    image: '/images/coaches-only/coaching-professionals.png'
  },
  {
    eyebrow: 'MORE TOOLS',
    title: 'Extras And Behind The Scenes',
    body: 'Extra coaching resources and behind-the-scenes material to keep sharpening your eye and your sessions.',
    image: '/images/coaches-only/extras.png'
  }
]

const faqs: Array<{ q: string; a: string }> = [
  {
    q: 'How much is Coaches Only?',
    a: 'Coaches Only is included in the Max Plan tier inside the Joner Football App. $39.99 USD per month, or $249 USD per year. That works out at $20.83 per month when billed annually.'
  },
  {
    q: 'Can I pay monthly?',
    a: 'Yes. You can join Coaches Only on a monthly Max Plan at $39.99 USD per month, or save by going annual at $249 USD per year.'
  },
  {
    q: 'Who is Coaches Only for?',
    a: 'Club coaches, private trainers, academy coaches, and parents coaching teams. Grassroots through to elite. Anyone who wants more detail in their sessions.'
  },
  {
    q: 'Is this just drill videos?',
    a: 'No. The point is the coaching detail. You get session planning, coaching points, full sessions, voice-over explanations, and footage of Lee actually working with players.'
  },
  {
    q: 'Will the sessions work for U8s, U18s, and adults?',
    a: 'Yes. Sessions are designed to be adapted. Lee shows you how to modify difficulty, intensity, and focus for the age and level you coach.'
  },
  {
    q: 'Can I use this for team training?',
    a: 'Yes. Coaches Only includes team training content and session ideas you can adapt for groups, squads, and private coaching environments.'
  },
  {
    q: 'How often is new content added?',
    a: 'New content drops regularly across voice-overs, sessions, and coach development. You are not paying for a static library.'
  },
  {
    q: 'Does it include the rest of the Joner Football App?',
    a: 'Yes. Coaches Only gives you the coaches tier plus the wider Joner Football App. 1,500+ training videos, the session planner, daily challenges, and the community.'
  },
  {
    q: 'Can I cancel?',
    a: 'Yes. Cancel anytime from inside your account. Monthly cancels at the next billing date. Annual keeps access for the year you paid for, with no surprise auto-charges.'
  }
]

// Populate FAQ schema from the FAQ list above. Has to run after `faqs` is defined.
faqSchema.mainEntity = faqs.map((f) => ({
  '@type': 'Question',
  name: f.q,
  acceptedAnswer: { '@type': 'Answer', text: f.a }
}))

import SanityPageRenderer from '../../components/sanity/SanityPageRenderer.astro'
import { fetchSanityPage } from '../../lib/sanityPages'
import { shouldReplaceSanityPage } from '../../lib/sanityPageUtils'


const sanityPage = await fetchSanityPage('app-for-coaches')
// TEMPORARY: forcing Astro version to render. Remove the `false &&` to restore Sanity CMS control.
---

{false && shouldReplaceSanityPage(sanityPage) ? (
  <SanityPageRenderer page={sanityPage} />
) : (
<BaseLayout title={title} description={description} canonical="https://jonerfootball.com/app/for-coaches/" ogImage="https://jonerfootball.com/images/coaches-only/coaches-only-hero-updated.png" schema={[productSchema, faqSchema]}>
  <main class="coaches-page bg-joner-black text-white">

    {/* ========== 1. HERO ========== */}
    <section class="coaches-hero relative overflow-hidden border-b border-gray-900">
      <div class="absolute inset-0">
        <img src="/images/coaches-only/coaches-only-hero-updated.png" alt="Lee Jones coaching session plan inside the Joner Football App" class="h-full w-full object-cover opacity-60" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-r from-joner-black via-joner-black/80 to-joner-black/25"></div>
      </div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28 lg:py-32">
        <div class="max-w-4xl">
          <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-white uppercase leading-none mb-6">
            THE COACHES SECTION
          </h1>
          <p class="text-gray-200 font-body text-lg md:text-xl max-w-3xl mb-8">
            Lee’s session plans, voice-over drills, coaching PDFs, and full training videos inside the Joner Football App.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 mb-4">
            <a href={checkoutUrl} target="_blank" rel="noopener noreferrer" class="btn-red text-base px-8 py-4 text-center" data-meta-checkout-event="CoachesPageClickToCheckout">JOIN COACHES ONLY</a>
            <a href={sampleSessionUrl} target="_blank" rel="noopener noreferrer" class="btn-outline text-base px-8 py-4 text-center">WATCH A FREE SESSION</a>
          </div>
          <p class="text-gray-200 font-body text-base">
            <span class="font-heading text-white font-semibold">{yearlyPrice}</span><span class="text-gray-400"> per year or </span><span class="font-heading text-white font-semibold">{monthlyPrice}</span><span class="text-gray-200"> per month. Max Plan tier. Cancel anytime.</span>
          </p>
        </div>
      </div>
    </section>


    {/* ========== 2. INTRO VIDEO FROM LEE (trimmed from full app walkthrough, 1m 14s) ========== */}
    <section class="coaches-video py-12 md:py-20 bg-joner-black border-b border-gray-900">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-8">
          <p class="text-joner-red font-heading text-sm uppercase tracking-widest mb-3">90 SECONDS WITH LEE</p>
          <h2 class="font-heading text-3xl md:text-5xl font-bold text-white uppercase leading-tight mb-4">WATCH THIS FIRST</h2>
          <p class="text-gray-300 font-body text-base md:text-lg max-w-2xl mx-auto">Press play. Lee shows you exactly what is inside Coaches Only and why it is built for coaches who want the detail.</p>
        </div>
        <div class="aspect-video bg-black rounded-2xl overflow-hidden ring-1 ring-white/10 shadow-[0_28px_70px_rgba(0,0,0,0.5)]">
          <video
            controls
            playsinline
            preload="metadata"
            class="w-full h-full object-cover"
            poster="/images/coaches-only/video-thumbnail.avif"
          >
            <source src="/videos/coaches-only-intro.mp4" type="video/mp4" />
            Your browser does not support video playback.
          </video>
        </div>
        <p class="text-center text-gray-400 font-body text-sm mt-5">
          <a href={sampleSessionUrl} target="_blank" rel="noopener noreferrer" class="underline hover:text-white transition-colors">Or watch a full Coaches Only session free inside the app</a>
        </p>
      </div>
    </section>


    {/* ========== 3. PROBLEM (two-column with roadmap graphic + FREE BUNDLE OFFER) ========== */}
    <section class="bg-white text-joner-black py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-joner-red font-heading text-sm uppercase tracking-widest mb-4">WHY IT EXISTS</p>
          <h2 class="font-heading text-4xl md:text-6xl font-bold text-joner-black uppercase leading-none mb-6">STOP WINGING YOUR SESSIONS</h2>
          <p class="text-lg text-gray-700 font-body mb-6 max-w-xl">
            Tuesday night, 5pm, still googling drills. Session falls apart 20 minutes in. Parents watching. You know what to coach. You do not know how to coach the detail.
          </p>
          <p class="font-heading uppercase text-2xl text-joner-black mb-6">That stops here.</p>

          {/* FREE BUNDLE: pulse-animated, prominent, gives away real value to build trust */}
          <a href={freeBundleUrl} target="_blank" rel="noopener noreferrer" class="free-bundle-cta group block w-full max-w-xl mb-6" data-meta-checkout-event="CoachesPageFreeBundleClick">
            <div class="relative bg-gradient-to-r from-joner-red to-[#FF1F1F] text-white rounded-2xl px-6 py-5 shadow-[0_18px_38px_rgba(204,0,0,0.35)] hover:shadow-[0_24px_52px_rgba(204,0,0,0.55)] transition-all duration-300 group-hover:-translate-y-0.5">
              <div class="flex items-center gap-4">
                <div class="shrink-0 w-12 h-12 rounded-full bg-white/15 flex items-center justify-center">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                  </svg>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="font-heading uppercase tracking-wider text-xs text-white/90 mb-1">FREE FOR EVERY COACH</p>
                  <p class="font-heading uppercase text-lg md:text-xl text-white leading-tight">Grab The Session Plan Bundle</p>
                </div>
                <svg class="shrink-0 w-6 h-6 text-white transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                </svg>
              </div>
              <span class="free-bundle-pulse"></span>
            </div>
          </a>

          <div class="flex flex-col sm:flex-row gap-4">
            <a href={sampleSessionUrl} target="_blank" rel="noopener noreferrer" class="btn-outline text-base px-8 py-4 text-center border-joner-black text-joner-black hover:bg-joner-black hover:text-white">SEE A SESSION FREE</a>
            <a href={checkoutUrl} target="_blank" rel="noopener noreferrer" class="btn-red text-base px-8 py-4 text-center" data-meta-checkout-event="CoachesPageClickToCheckout">START COACHING THE DETAIL</a>
          </div>
        </div>
        <div class="overflow-hidden rounded-[28px] bg-black/5 p-1 shadow-[0_28px_70px_rgba(0,0,0,0.24)] ring-1 ring-black/10">
          <img src="/images/coaches-only/session-structure-roadmap-plush.png" alt="Plan, understand, watch, become: the Joner Football coaching pathway" class="block w-full rounded-[24px] object-cover" loading="lazy" />
        </div>
      </div>

      <style>
        .free-bundle-cta { perspective: 800px; }
        .free-bundle-pulse {
          position: absolute; inset: 0; border-radius: 1rem; pointer-events: none;
          box-shadow: 0 0 0 0 rgba(204, 0, 0, 0.55);
          animation: freeBundlePulse 2.4s cubic-bezier(0.32, 0.72, 0, 1) infinite;
        }
        @keyframes freeBundlePulse {
          0%   { box-shadow: 0 0 0 0 rgba(204, 0, 0, 0.55); }
          70%  { box-shadow: 0 0 0 14px rgba(204, 0, 0, 0); }
          100% { box-shadow: 0 0 0 0 rgba(204, 0, 0, 0); }
        }
        @media (prefers-reduced-motion: reduce) {
          .free-bundle-pulse { animation: none; }
        }
      </style>
    </section>


    {/* ========== 4. WHO IS TEACHING YOU ========== */}
    <section class="bg-joner-gray py-20 md:py-28 border-t-4 border-[#CC0000]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
          <div>
            <p class="text-joner-red font-heading text-sm uppercase tracking-widest mb-3">WHO IS TEACHING YOU</p>
            <h2 class="font-heading text-4xl md:text-5xl font-bold text-white uppercase leading-tight mb-4">LEE JONES.</h2>
            <p class="text-gray-300 font-body text-lg mb-6">Over 20 years coaching players, coaches, and parents around the world. From grassroots kids to professional players.</p>

            {/* Top-10 ranking accolade: credibility signal */}
            <div class="inline-flex items-center gap-3 bg-joner-black border border-joner-red/40 rounded-full px-5 py-2 mb-6">
              <svg class="w-5 h-5 text-joner-red" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
              <p class="font-heading text-white text-sm uppercase tracking-wider">Voted Top 10 In The World For Technical Training</p>
            </div>

            <p class="text-gray-400 font-body text-base leading-relaxed mb-8">
              Coaches Only is the inside view. The sessions Lee runs, the language he uses, the way he coaches the detail with elite players. Nothing watered down. Nothing held back. The full masterclass coaches pay thousands to sit in the room for, dropped into one Max Plan tier inside the app.
            </p>

            {/* Lee quote: direct mission statement */}
            <blockquote class="border-l-4 border-joner-red pl-5 py-2 mb-8">
              <p class="font-heading text-xl md:text-2xl text-white italic leading-snug">"I built this app to spread the knowledge for all coaches around the world."</p>
              <footer class="mt-3">
                <p class="font-heading text-base text-white not-italic">Lee Jones</p>
                <p class="text-[#999999] text-xs uppercase tracking-widest font-heading mt-1">Founder, Joner Football</p>
              </footer>
            </blockquote>

            <a href={checkoutUrl} target="_blank" rel="noopener noreferrer" class="btn-red text-base px-8 py-4 inline-flex" data-meta-checkout-event="CoachesPageClickToCheckout">JOIN LEE INSIDE THE APP</a>
          </div>
          <div class="flex justify-center lg:justify-end">
            <img
              src="/images/programmes/lee-coaching-red.jpg"
              alt="Lee Jones coaching on the pitch, voted top 10 in the world for technical football training"
              class="w-full max-w-md rounded-lg shadow-2xl"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>


    {/* ========== 4.5 TESTIMONIALS CAROUSEL (moved higher: proof before the offer details) ========== */}
    <CoachesTestimonialsCarousel />


    {/* ========== 5. WHAT IS INSIDE (closer-look interaction matched to /app) ========== */}
    <section id="inside" class="coach-closer bg-joner-black py-16 md:py-24">
      <div class="max-w-[1680px] mx-auto px-4 sm:px-6 lg:px-10">
        <div class="mb-8 md:mb-12 px-2 sm:px-4">
          <p class="text-joner-red font-heading text-sm uppercase tracking-widest mb-4">INSIDE COACHES ONLY</p>
          <h2 class="font-heading text-3xl sm:text-5xl md:text-6xl lg:text-7xl text-white uppercase leading-none tracking-tight mb-4">
            Everything Included
          </h2>
          <p class="text-xl text-gray-300 font-body max-w-3xl">Pulled from the live Coaches Only category inside the Joner Football App.</p>
        </div>

        <div class="coach-closer-shell rounded-2xl md:rounded-[2rem] bg-[#0f0f0f] border border-white/5 overflow-hidden">
          <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,380px)_1fr]">
            <div class="coach-closer-pills p-5 sm:p-8 lg:p-10 lg:py-14 flex flex-col gap-3 order-2 lg:order-1">
              {features.map((f, index) => (
                <div class="coach-closer-pill" data-coach-pill={index} data-open={index === 0 ? 'true' : 'false'}>
                  <button
                    type="button"
                    class="coach-closer-pill-btn w-full flex items-center gap-3 px-4 py-3 rounded-full text-white text-left"
                    data-coach-pill-btn={index}
                    aria-expanded={index === 0 ? 'true' : 'false'}
                    aria-controls={`coach-closer-panel-${index}`}
                  >
                    <span class="coach-closer-icon w-6 h-6 rounded-full flex items-center justify-center shrink-0">
                      <svg class="coach-closer-plus w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                    </span>
                    <span class="font-body text-base sm:text-[15px] font-medium">{f.eyebrow}</span>
                  </button>
                  <div
                    id={`coach-closer-panel-${index}`}
                    class="coach-closer-panel grid grid-rows-[0fr]"
                    aria-hidden={index === 0 ? 'false' : 'true'}
                  >
                    <div class="overflow-hidden">
                      <div class="coach-closer-panel-content pl-13 pr-4 pt-3 pb-2 sm:pl-14">
                        <h3 class="font-heading text-xl text-white uppercase mb-2 tracking-wide">{f.title}</h3>
                        <p class="text-gray-400 font-body text-sm leading-relaxed">{f.body}</p>
                        <a href={appCategoryUrl} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-2 text-joner-red font-heading text-xs uppercase tracking-widest hover:text-white transition-colors">
                          View in app
                          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>

            <div class="coach-closer-stage relative bg-black order-1 lg:order-2 aspect-[4/3] sm:aspect-[16/10] lg:aspect-auto lg:min-h-[620px] overflow-hidden">
              {features.map((f, index) => (
                <img
                  src={f.image}
                  alt={f.title}
                  class="coach-closer-stage-image absolute inset-0 w-full h-full object-contain p-6 sm:p-10 lg:p-16"
                  data-coach-stage-image={index}
                  data-active={index === 0 ? 'true' : 'false'}
                  loading="lazy"
                />
              ))}
              <div class="coach-closer-stage-glow absolute inset-0 pointer-events-none"></div>
            </div>
          </div>
        </div>

        <div class="mt-14 flex flex-col sm:flex-row gap-4 justify-center">
          <a href={appCategoryUrl} target="_blank" rel="noopener noreferrer" class="btn-outline text-base px-8 py-4 text-center">BROWSE THE FULL LIBRARY</a>
          <a href={checkoutUrl} target="_blank" rel="noopener noreferrer" class="btn-red text-base px-8 py-4 text-center" data-meta-checkout-event="CoachesPageClickToCheckout">JOIN COACHES ONLY</a>
        </div>
      </div>
    </section>


    {/* ========== 6. PRICING (Max Plan tier, dual options, value-led) ========== */}
    <section class="bg-white text-joner-black py-16 md:py-24">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <p class="text-joner-red font-heading text-sm uppercase tracking-widest mb-3">THE MAX PLAN</p>
          <h2 class="font-heading text-4xl md:text-6xl font-bold text-joner-black uppercase leading-none mb-5">THE FULL JONER FOOTBALL APP</h2>
          <p class="font-body text-lg md:text-xl text-gray-700 max-w-3xl mx-auto">Coaches Only is the premium <span class="font-semibold">Max Plan</span> tier. It is the only way inside the full coaching library, the voice-over breakdowns, the full training sessions, and the direct line to Lee.</p>
        </div>

        {/* Two pricing cards, monthly + annual, with annual marked as best value */}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto mb-12">

          <article class="relative bg-gray-50 border border-gray-200 rounded-2xl p-8 flex flex-col">
            <p class="font-heading uppercase tracking-widest text-sm text-gray-500 mb-3">MONTHLY</p>
            <div class="flex items-baseline gap-2 mb-2">
              <span class="font-heading text-5xl md:text-6xl font-bold text-joner-black">{monthlyPrice.replace(' USD', '')}</span>
              <span class="font-body text-base text-gray-600">USD / month</span>
            </div>
            <p class="font-body text-sm text-gray-500 mb-6">Roll month to month. Cancel anytime.</p>
            <ul class="space-y-3 mb-8 flex-1 font-body text-gray-700">
              <li class="flex gap-2"><span class="text-joner-red">✓</span>Full Coaches Only library</li>
              <li class="flex gap-2"><span class="text-joner-red">✓</span>Every session plan PDF</li>
              <li class="flex gap-2"><span class="text-joner-red">✓</span>Voice-over drill breakdowns</li>
              <li class="flex gap-2"><span class="text-joner-red">✓</span>Direct messaging with Lee</li>
            </ul>
            <a href={monthlyCheckoutUrl} target="_blank" rel="noopener noreferrer" class="btn-outline border-joner-black text-joner-black hover:bg-joner-black hover:text-white px-6 py-3 text-center" data-meta-checkout-event="CoachesPageMonthlyClick">START MONTHLY</a>
          </article>

          <article class="relative bg-joner-black text-white rounded-2xl p-8 flex flex-col shadow-[0_28px_70px_rgba(0,0,0,0.4)] ring-2 ring-joner-red">
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-joner-red text-white font-heading uppercase tracking-widest text-xs px-3 py-1.5 rounded-full">BEST VALUE. SAVE $230/YEAR</span>
            <p class="font-heading uppercase tracking-widest text-sm text-joner-red mb-3">ANNUAL</p>
            <div class="flex items-baseline gap-2 mb-2">
              <span class="font-heading text-5xl md:text-6xl font-bold text-white">{yearlyPrice.replace(' USD', '')}</span>
              <span class="font-body text-base text-gray-400">USD / year</span>
            </div>
            <p class="font-body text-sm text-gray-400 mb-6">Works out at <span class="text-white">$20.83/month</span> when billed annually.</p>
            <ul class="space-y-3 mb-8 flex-1 font-body text-gray-300">
              <li class="flex gap-2"><span class="text-joner-red">✓</span>Everything in Monthly</li>
              <li class="flex gap-2"><span class="text-joner-red">✓</span>Save about $230 vs monthly</li>
              <li class="flex gap-2"><span class="text-joner-red">✓</span>A full season of session plans</li>
              <li class="flex gap-2"><span class="text-joner-red">✓</span>Coaching the Coaches mentorship</li>
            </ul>
            <a href={checkoutUrl} target="_blank" rel="noopener noreferrer" class="btn-red px-6 py-3 text-center" data-meta-checkout-event="CoachesPageAnnualClick">START ANNUAL</a>
          </article>

