---
import BaseLayout from '../../layouts/BaseLayout.astro'
import CoachesTestimonialsCarousel from '../../components/CoachesTestimonialsCarousel.astro'
import CoachesHighlightsCarousel from '../../components/CoachesHighlightsCarousel.astro'
import PlayButtonVideo from '../../components/PlayButtonVideo.astro'
import FactsMarquee from '../../components/FactsMarquee.astro'
import GeoAnswers from '../../components/GeoAnswers.astro'
import { breadcrumbSchema } from '../../lib/seoSchema'

const title = 'Football Coaching App | Drills & Session Plans | Joner Football'
const description = 'Give coaches clear football drills, session ideas and technical detail through the Joner Football App. Build sharper sessions for every player.'
const annualCheckoutUrl = 'https://app.jonerfootball.com/checkout/new?o=202578'
const monthlyCheckoutUrl = 'https://app.jonerfootball.com/checkout/new?o=230698'
const checkoutUrl = annualCheckoutUrl
const appCategoryUrl = 'https://app.jonerfootball.com/categories/category-8-7szqoiq00'
const previewUrl = 'https://app.jonerfootball.com/programs/how-to-use-joner-football-app-guide?utm_source=product&utm_medium=share&utm_campaign=content_share&utm_term=4067217&utm_content=copy'
const sampleSessionUrl = 'https://app.jonerfootball.com/programs/coaches-session-plan-1-0c96c6'
const freeBundleUrl = 'https://app.jonerfootball.com/checkout/new?o=226775'

// Coaches Only is included in the Max Plan tier. Monthly and annual use the same checkout IDs as the draft join Max plan.
const yearlyPrice = '$249 USD'
const monthlyPrice = '$39.99 USD'

// FAQ schema so Google can pull these as rich results in search
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [] as Array<{ '@type': string; name: string; acceptedAnswer: { '@type': string; text: string } }>
}

// Product schema for Google rich results
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Joner Football App: Coaches Only (Max Plan)',
  description: 'Premium coaching tier inside the Joner Football App. Session plans, voice-over drill breakdowns, full training sessions, and coach development from Lee Jones.',
  brand: { '@type': 'Brand', name: 'Joner Football' },
  image: 'https://jonerfootball.com/images/coaches-only/coaches-only-hero-updated.png',
  offers: [
    {
      '@type': 'Offer',
      name: 'Annual Plan',
      price: '249.00',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      url: 'https://jonerfootball.com/app/for-coaches/'
    },
    {
      '@type': 'Offer',
      name: 'Monthly Plan',
      price: '39.99',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      url: 'https://jonerfootball.com/app/for-coaches/'
    }
  ]
}

const coachesBreadcrumbSchema = breadcrumbSchema([
  { name: 'Home', url: 'https://jonerfootball.com/' },
  { name: 'Football Training App', url: 'https://jonerfootball.com/app/' },
  { name: 'App For Coaches', url: 'https://jonerfootball.com/app/for-coaches/' },
])

// 8 feature blocks, /app-page-style horizontal cards
const features = [
  {
    eyebrow: 'START HERE',
    title: 'App And Session Planner Walkthrough',
    body: 'See how Lee uses the Joner Football App and Sports Session Planner to find drills, build sessions, manage difficulty, and plan with purpose. The full walkthrough no other coach is showing you.',
    image: '/images/coaches-only/app-session-planner.png'
  },
  {
    eyebrow: 'READY TO USE',
    title: 'Session Plans Built To Run',
    body: 'Structured coaching sessions you take straight onto the pitch. No more building from scratch on Tuesday at 5pm. Clear flow, real progression, every age group.',
    image: '/images/coaches-only/session-planning.png'
  },
  {
    eyebrow: 'THE DETAIL',
    title: 'Voice Over Drill Series',
    body: 'Lee narrates the drill while it runs. What he is looking for, why the practice works, how to coach the detail. The bit no YouTube channel gives you.',
    image: '/images/coaches-only/voice-over-series.png'
  },
  {
    eyebrow: 'COACH EDUCATION',
    title: 'Coaching The Coaches',
    body: 'Practical coach development. Better language. Better standards. Better player outcomes. Sharpen how you actually teach, not just what you teach.',
    image: '/images/coaches-only/coaching-the-coaches.png'
  },
  {
    eyebrow: 'WATCH THE FLOW',
    title: 'Full Training Sessions',
    body: 'Extended sessions showing how Lee combines technical work, intensity, detail, and progression across a full training block. Copy them. Run them. Watch your team level up.',
    image: '/images/coaches-only/full-training-sessions.png'
  },
  {
    eyebrow: 'FOR GROUPS',
    title: 'Team Training',
    body: 'Group sessions that still keep individual technique at the centre. For grassroots, academy, and private coaching environments.',
    image: '/images/coaches-only/team-training.png'
  },
  {
    eyebrow: 'ELITE DETAIL',
    title: 'Coaching Professionals',
    body: 'How Lee coaches elite players. The detail, standards, and language used in professional environments. The same masterclass coaches pay thousands to be in the room for.',
    image: '/images/coaches-only/coaching-professionals.png'
  },
  {
    eyebrow: 'MORE TOOLS',
    title: 'Extras And Behind The Scenes',
    body: 'Extra coaching resources and behind-the-scenes material to keep sharpening your eye and your sessions.',
    image: '/images/coaches-only/extras.png'
  }
]

// Sliding trust ticker: proof + the 4 feature points consolidated into one bar
const facts = [
  'Voted Top 10 In The World For Technical Training',
  'Session Planning',
  '50,000+ Downloads',
  'Full Sessions',
  '1,500+ Training Videos',
  'Team Training',
  '15+ Countries',
  'Coaches Community',
  '20+ Years Coaching',
  'Grassroots To Professional Videos'
]

// Slides for the "what's inside" scroller. These graphics already carry their
// own labels, so we show them clean (no text overlay). To use a cleaner photo
// or video later, add `video: '/videos/clip.mp4'` and/or `eyebrow`/`title` to a
// slide and the overlay caption (like /app) renders automatically.
const highlightSlides = features.map((f) => ({
  image: f.image,
  alt: f.title
}))

// "Who it's for" scroll-reveal callouts that draw in over Lee's photo (igloo-style)
const callouts = [
  { label: 'Grassroots Coaches', side: 'left', top: '26%' },
  { label: 'Academy Coaches', side: 'right', top: '44%' },
  { label: 'Parent Coaches', side: 'left', top: '64%' },
  { label: '1on1 & Private Trainers', side: 'right', top: '82%' }
]

// "Everything included" accordion (closer-look style): what you get inside the
// Max Plan. `label` is the pill, `title` + `body` show in the panel, `image` is
// the stage graphic (placeholders for now, swap per item later).
const included = [
  { label: 'DM Coach Lee', title: 'Access To DM Lee', body: 'Direct message me any question. For all Max users inside the JF App.', image: '/images/coaches-only/coaching-the-coaches.png' },
  { label: 'PDF Session Plans', title: 'PDF Session Plans', body: 'Free PDF session plans included, ready to print and take onto the pitch.', image: '/images/coaches-only/session-planning.png' },
  { label: 'Voice Over Series', title: 'Voice Over Series', body: 'A detailed voice over series where I break down my drills in full.', image: '/images/coaches-only/voice-over-series.png' },
  { label: 'Coaches Community', title: 'Access To A Coaches Community', body: 'Get access to thousands of other coaches inside the App.', image: '/images/coaches-only/team-training.png' },
  { label: 'Seminars', title: 'Access To Seminars', body: 'Watch me deliver seminars on specific coaching topics.', image: '/images/coaches-only/coaching-professionals.png' },
  { label: 'Training Resources', title: 'Access To Training Resources', body: 'The resources I use in my own training, broken down so you can use them too. Free for every user.', image: '/images/coaches-only/app-session-planner.png' },
  { label: 'Study The Game', title: 'Study The Game', body: 'Game analysis footage that shows you how to read the game and take it into your sessions.', image: '/images/coaches-only/full-training-sessions.png' },
  { label: 'Live Training Sessions', title: 'Access To Live Training Sessions', body: 'Watch me coach live. See the standards, the language, and the detail as it happens.', image: '/images/coaches-only/extras.png' }
]

const faqs: Array<{ q: string; a: string }> = [
  {
    q: 'How much is Coaches Only?',
    a: 'Coaches Only is included in the Max Plan tier inside the Joner Football App. $39.99 USD per month, or $249 USD per year. That works out at $20.83 per month when billed annually.'
  },
  {
    q: 'Can I pay monthly?',
    a: 'Yes. You can join Coaches Only on a monthly Max Plan at $39.99 USD per month, or save by going annual at $249 USD per year.'
  },
  {
    q: 'Who is Coaches Only for?',
    a: 'Club coaches, private trainers, academy coaches, and parents coaching teams. Grassroots through to elite. Anyone who wants more detail in their sessions.'
  },
  {
    q: 'Is this just drill videos?',
    a: 'No. The point is the coaching detail. You get session planning, coaching points, full sessions, voice-over explanations, and footage of Lee actually working with players.'
  },
  {
    q: 'Will the sessions work for U8s, U18s, and adults?',
    a: 'Yes. Sessions are designed to be adapted. Lee shows you how to modify difficulty, intensity, and focus for the age and level you coach.'
  },
  {
    q: 'Can I use this for team training?',
    a: 'Yes. Coaches Only includes team training content and session ideas you can adapt for groups, squads, and private coaching environments.'
  },
  {
    q: 'How often is new content added?',
    a: 'New content drops regularly across voice-overs, sessions, and coach development. You are not paying for a static library.'
  },
  {
    q: 'Does it include the rest of the Joner Football App?',
    a: 'Yes. Coaches Only gives you the coaches tier plus the wider Joner Football App. 1,500+ training videos, the session planner, daily challenges, and the community.'
  },
  {
    q: 'Can I cancel?',
    a: 'Yes. Cancel anytime from inside your account. Monthly cancels at the next billing date. Annual keeps access for the year you paid for, with no surprise auto-charges.'
  }
]

// Populate FAQ schema from the FAQ list above. Has to run after `faqs` is defined.
faqSchema.mainEntity = faqs.map((f) => ({
  '@type': 'Question',
  name: f.q,
  acceptedAnswer: { '@type': 'Answer', text: f.a }
}))

import SanityPageRenderer from '../../components/sanity/SanityPageRenderer.astro'
import { fetchSanityPage } from '../../lib/sanityPages'
import { shouldReplaceSanityPage } from '../../lib/sanityPageUtils'


const sanityPage = await fetchSanityPage('app-for-coaches')
// TEMPORARY: forcing Astro version to render. Remove the `false &&` to restore Sanity CMS control.
---

{false && shouldReplaceSanityPage(sanityPage) ? (
  <SanityPageRenderer page={sanityPage} />
) : (
<BaseLayout title={title} description={description} canonical="https://jonerfootball.com/app/for-coaches/" ogImage="https://jonerfootball.com/images/coaches-only/coaches-only-hero-updated.png" schema={[productSchema, coachesBreadcrumbSchema, faqSchema]}>
  <main class="coaches-page bg-joner-black text-white">

    {/* ========== 1. HERO (compact, sized to match /programmes hero) ========== */}
    <section class="coaches-hero relative overflow-hidden border-b border-gray-900">
      <div class="absolute inset-0 bg-joner-black">
        <video
          class="h-full w-full object-cover object-center"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          poster="/videos/coaches-web-hero-poster.jpg"
          aria-hidden="true"
        >
          <source src="/videos/coaches-web-hero.mp4" type="video/mp4" />
        </video>
        <div class="absolute inset-0 bg-gradient-to-r from-joner-black via-joner-black/80 to-joner-black/30"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-joner-black/70 via-transparent to-transparent"></div>
      </div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center min-h-[440px] md:min-h-[520px] py-14 md:py-16">
        <div class="max-w-2xl">
          <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl font-bold text-white uppercase leading-none mb-5">
            THE COACHES SECTION
          </h1>
          <p class="text-gray-200 font-body text-lg md:text-xl max-w-xl mb-7">
            Lee’s session plans, voice-over drills, coaching PDFs, and full training videos inside the Joner Football App.
          </p>
          <div class="mb-4">
            <a href="/join" class="btn-red text-base px-8 py-4 inline-flex text-center" data-meta-checkout-event="CoachesPageClickToCheckout">JOIN COACHES ONLY</a>
          </div>
          <p class="text-gray-200 font-body text-base">
            <span class="text-gray-200">From </span><span class="font-heading text-white font-semibold">$20.83 USD</span><span class="text-gray-200"> per month. Max Plan tier. Cancel anytime.</span>
          </p>
        </div>
      </div>
    </section>


    {/* ========== 1a. FACTS MARQUEE (consolidated trust + feature ticker) ========== */}
    <FactsMarquee facts={facts} />


    {/* ========== 2. INTRO VIDEO FROM LEE (trimmed from full app walkthrough, 1m 14s) ========== */}
    <section class="coaches-video py-12 md:py-20 bg-joner-black border-b border-gray-900">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-8">
          <h2 class="font-heading text-3xl md:text-5xl font-bold text-white uppercase leading-tight mb-4">WATCH THIS FIRST</h2>
          <p class="text-gray-300 font-body text-base md:text-lg max-w-5xl mx-auto">Lee shows you exactly what is inside Coaches Only and why it is built for coaches who want the detail.</p>
        </div>
        <PlayButtonVideo src="/videos/coaches-only-intro.mp4" poster="/images/coaches-only/video-thumbnail.avif" label="Play Lee's intro video" />
        <p class="text-center text-gray-400 font-body text-sm mt-5">
          <a href={sampleSessionUrl} target="_blank" rel="noopener noreferrer" class="underline hover:text-white transition-colors">Or watch a full Coaches Only session free inside the app</a>
        </p>
      </div>
    </section>


    {/* ========== 3. PROBLEM (moved up: hook, then problem, then solution) ========== */}
    <section class="bg-white text-joner-black py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="order-2 lg:order-1">
          <p class="text-joner-red font-heading text-sm uppercase tracking-widest mb-4">WHY IT EXISTS</p>
          <h2 class="font-heading text-4xl md:text-6xl font-bold text-joner-black uppercase leading-none mb-6">STOP WINGING YOUR SESSIONS</h2>
          <p class="text-lg text-gray-700 font-body mb-6 max-w-xl">
            Detailed session plans, ready to run, built around team training, small group training and 1on1's. Voice over videos and PDF session plans.
          </p>
          <p class="font-heading uppercase text-2xl text-joner-red mb-6">Free bundle session below!</p>

          <div class="flex flex-col sm:flex-row gap-4">
            <a href={freeBundleUrl} target="_blank" rel="noopener noreferrer" class="btn-red text-base px-8 py-4 text-center" data-meta-checkout-event="CoachesPageFreeBundleClick">DOWNLOAD FREE BUNDLE!</a>
            <a href={sampleSessionUrl} target="_blank" rel="noopener noreferrer" class="btn-red text-base px-8 py-4 text-center">WATCH A FREE SESSION</a>
          </div>
        </div>
        <div class="order-1 lg:order-2 overflow-hidden rounded-[28px] bg-black/5 p-1 shadow-[0_28px_70px_rgba(0,0,0,0.24)] ring-1 ring-black/10">
          <img src="/images/coaches-only/coaches-roadmap.png" alt="The Joner Football coaching pathway: plan, understand, watch, become" class="block w-full rounded-[24px] object-cover" loading="lazy" />
        </div>
      </div>
    </section>


    {/* ========== 3b. BUILT FOR COACHES (scroll-reveal callouts over the photo) ========== */}
    <section class="bfc" data-bfc aria-label="Who it's for">
      <div class="bfc__track">
        <div class="bfc__sticky">
          <div class="bfc__stage">
            <img class="bfc__photo bfc__photo--mobile" src="/images/coaches-only/built-for-coaches-mobile.jpg" alt="Lee Jones coaching on the pitch" loading="lazy" />
            <img class="bfc__photo bfc__photo--desktop" src="/images/coaches-only/built-for-coaches-desktop.jpg" alt="Lee Jones coaching on the pitch" loading="lazy" />
            <div class="bfc__scrim"></div>
            <div class="bfc__intro">
              <p class="bfc__eyebrow">WHO IT'S FOR</p>
              <h2 class="bfc__heading font-heading">Built For Coaches Like You</h2>
            </div>
            {callouts.map((c, i) => (
              <div class={`bfc__callout bfc__callout--${c.side}`} style={`top:${c.top}`} data-callout data-i={i}>
                <span class="bfc__label font-heading">{c.label}</span>
                <span class="bfc__line"></span>
                <span class="bfc__dot"></span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <style>
      .bfc { background: #0A0A0A; }
      .bfc__track { position: relative; height: 200vh; }
      .bfc__sticky { position: sticky; top: 0; height: 100vh; overflow: hidden; }
      .bfc__stage { position: absolute; inset: 0; }
      .bfc__photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
      .bfc__photo--desktop { display: none; }
      .bfc__scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0.72), rgba(0,0,0,0.5) 26%, rgba(0,0,0,0.5) 62%, rgba(0,0,0,0.82)); }
      .bfc__intro { position: absolute; top: max(108px, 10%); left: 0; right: 0; text-align: center; padding: 0 16px; z-index: 3; }
      .bfc__eyebrow { color: var(--color-joner-red, #E8000D); font-family: 'Kanit', 'Anton', sans-serif; font-style: italic; font-weight: 900; text-transform: uppercase; letter-spacing: 0.34em; font-size: 0.95rem; margin: 0 0 8px; }
      .bfc__heading { color: #fff; font-family: 'Kanit', 'Anton', sans-serif; font-style: italic; font-weight: 900; text-transform: uppercase; line-height: 1.0; letter-spacing: -0.01em; font-size: clamp(1.35rem, 6vw, 4.25rem); text-wrap: balance; margin: 0; text-shadow: 0 2px 18px rgba(0,0,0,0.6); }
      .bfc__callout { position: absolute; display: flex; align-items: center; gap: 10px; max-width: 64%; opacity: 0; transform: translateY(16px); transition: opacity .6s cubic-bezier(.22,.61,.36,1), transform .6s cubic-bezier(.22,.61,.36,1); z-index: 2; }
      .bfc__callout--left { left: 6%; }
      .bfc__callout--right { right: 6%; flex-direction: row-reverse; text-align: right; }
      .bfc__callout.is-on { opacity: 1; transform: translateY(0); }
      .bfc__label { font-family: 'Kanit', 'Anton', sans-serif; font-style: italic; font-weight: 900; text-transform: uppercase; color: #fff; line-height: 1.02; font-size: clamp(1.15rem, 5vw, 2.4rem); text-shadow: 0 2px 16px rgba(0,0,0,0.85); }
      .bfc__line { height: 2px; width: 0; background: var(--color-joner-red, #E8000D); transition: width .65s cubic-bezier(.22,.61,.36,1) .08s; flex-shrink: 0; }
      .bfc__callout.is-on .bfc__line { width: clamp(24px, 9vw, 120px); }
      .bfc__dot { width: 11px; height: 11px; border-radius: 999px; background: var(--color-joner-red, #E8000D); box-shadow: 0 0 0 5px rgba(232,0,13,0.22); flex-shrink: 0; }
      @media (min-width: 768px) {
        .bfc__photo--mobile { display: none; }
        .bfc__photo--desktop { display: block; }
        .bfc__scrim { background: linear-gradient(180deg, rgba(0,0,0,0.6), rgba(0,0,0,0.28) 26%, rgba(0,0,0,0.3) 62%, rgba(0,0,0,0.72)); }
        .bfc__eyebrow { font-size: 1.1rem; }
      }
      @media (prefers-reduced-motion: reduce) {
        .bfc__callout { opacity: 1; transform: none; transition: none; }
        .bfc__line { width: clamp(24px, 9vw, 120px); }
      }
    </style>

    <script is:inline>
      ;(function () {
        var section = document.querySelector('[data-bfc]');
        if (!section) return;
        var track = section.querySelector('.bfc__track');
        var callouts = Array.prototype.slice.call(section.querySelectorAll('[data-callout]'));
        if (!track || !callouts.length) return;
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          callouts.forEach(function (c) { c.classList.add('is-on'); });
          return;
        }
        var ticking = false;
        function update() {
          ticking = false;
          var rect = track.getBoundingClientRect();
          var total = rect.height - window.innerHeight;
          var scrolled = Math.min(Math.max(-rect.top, 0), total);
          var progress = total > 0 ? scrolled / total : 0;
          callouts.forEach(function (c, i) {
            c.classList.toggle('is-on', progress >= 0.08 + i * 0.24);
          });
        }
        function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        update();
      })();
    </script>


    {/* ========== 4. WHAT'S INSIDE SCROLLER (solution: what's inside the Max plan) ========== */}
    <CoachesHighlightsCarousel heading="What's inside MAX plan!" slides={highlightSlides} />


    {/* ========== 4. WHO IS TEACHING YOU (mobile = baked graphic, desktop = live text + clean photo) ========== */}
    <section class="bg-joner-gray py-12 md:py-20 border-t-4 border-[#CC0000]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        {/* MOBILE: complete graphic (heading, bio and quote baked in) */}
        <div class="lg:hidden">
          <img src="/images/coaches-only/lee-teaching-mobile.jpg" alt="Who is teaching you: Lee Jones, over 20 years coaching, founder of Joner Football" class="w-full rounded-2xl shadow-2xl" loading="lazy" />
          <div class="text-center mt-7">
            <a href={checkoutUrl} target="_blank" rel="noopener noreferrer" class="btn-red text-base px-8 py-4 inline-flex" data-meta-checkout-event="CoachesPageClickToCheckout">JOIN LEE INSIDE THE APP</a>
          </div>
        </div>

        {/* DESKTOP: live text + clean coaching photo */}
        <div class="hidden lg:grid grid-cols-2 gap-16">
          <div class="flex flex-col justify-center">
            <p class="text-joner-red font-heading text-sm uppercase tracking-widest mb-3">WHO IS TEACHING YOU</p>
            <h2 class="font-heading text-4xl md:text-5xl font-bold text-white uppercase leading-tight mb-4">LEE JONES.</h2>
            <p class="text-gray-300 font-body text-lg mb-6">Over 20 years coaching players, coaches, and parents around the world. From grassroots kids to professional players.</p>
            <p class="text-gray-300 font-body text-base leading-relaxed mb-8">Coaches Only is the inside view. The sessions Lee runs, the language he uses, the way he coaches the detail with elite players. Nothing watered down. Nothing held back.</p>
            <blockquote class="border-l-4 border-joner-red pl-5 py-2 mb-8">
              <p class="font-heading text-xl md:text-2xl text-white italic leading-snug">"I built this app to spread the knowledge for all coaches around the world."</p>
              <footer class="mt-3">
                <p class="font-heading text-base text-white not-italic">Lee Jones</p>
                <p class="text-[#999999] text-xs uppercase tracking-widest font-heading mt-1">Founder, Joner Football</p>
              </footer>
            </blockquote>
            <a href={checkoutUrl} target="_blank" rel="noopener noreferrer" class="btn-red text-base px-8 py-4 inline-flex self-start" data-meta-checkout-event="CoachesPageClickToCheckout">JOIN LEE INSIDE THE APP</a>
          </div>
          <div class="overflow-hidden rounded-lg shadow-2xl">
            <img src="/images/programmes/lee-hero-jf.jpg" alt="Lee Jones coaching at a Joner Football session" class="w-full h-full object-cover object-[70%_50%]" loading="lazy" />
          </div>
        </div>

      </div>
    </section>


