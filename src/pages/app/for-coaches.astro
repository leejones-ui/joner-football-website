---
import BaseLayout from '../../layouts/BaseLayout.astro'

const title = 'Coaches Only | Joner Football App'
const description = 'A dedicated Joner Football App tier for coaches. Session plans, voice-over drills, coaching points, full sessions, team training, and behind-the-scenes coaching insight from Lee Jones.'
const checkoutUrl = 'https://app.jonerfootball.com/checkout/new?o=202578'
const appCategoryUrl = 'https://app.jonerfootball.com/categories/category-8-7szqoiq00'

const contentBlocks = [
  {
    title: 'App And Session Planner Walkthrough',
    eyebrow: 'Start Here',
    image: '/images/coaches-only/app-session-planner.png',
    text: 'See how Lee uses the Joner Football App and Sports Session Planner to find drills, build sessions, manage difficulty, and plan with more purpose.'
  },
  {
    title: 'Session Planning',
    eyebrow: 'Ready To Use',
    image: '/images/coaches-only/session-planning.png',
    text: 'Structured coaching plans you can take into your own environment, with clear session flow instead of random drills thrown together.'
  },
  {
    title: 'Voice Over Series',
    eyebrow: 'The Why Behind It',
    image: '/images/coaches-only/voice-over-series.png',
    text: 'Detailed voice-over drills where Lee explains what he is looking for, why the practice works, and how to coach the detail properly.'
  },
  {
    title: 'Coaching The Coaches',
    eyebrow: 'Coach Education',
    image: '/images/coaches-only/coaching-the-coaches.png',
    text: 'Practical coach development from Joner Football, built for coaches who want better language, better standards, and better player outcomes.'
  },
  {
    title: 'Full Training Sessions',
    eyebrow: 'Watch The Flow',
    image: '/images/coaches-only/full-training-sessions.png',
    text: 'Full extended sessions showing how Joner Football combines technical work, intensity, detail, and progression across a complete training block.'
  },
  {
    title: 'Team Training',
    eyebrow: 'For Groups',
    image: '/images/coaches-only/team-training.png',
    text: 'Team training ideas and examples for coaches who need to manage groups while still keeping individual technique at the centre.'
  },
  {
    title: 'Coaching Professionals',
    eyebrow: 'Elite Detail',
    image: '/images/coaches-only/coaching-professionals.png',
    text: 'Insight into how Lee coaches elite-level players, including the detail, standards, and communication used in professional environments.'
  },
  {
    title: 'Extras',
    eyebrow: 'More Tools',
    image: '/images/coaches-only/extras.png',
    text: 'Extra coaching resources, ideas, and behind-the-scenes material to help you keep improving your sessions and your coaching eye.'
  }
]

const benefits = [
  'Detailed voice-over drills so you understand the why behind every practice',
  'Coaching points you can use straight away on the pitch',
  'Session plans for cleaner structure and better training flow',
  'Examples of Lee coaching professionals and higher-level players',
  'Full training sessions so you can see how the work connects',
  'Team training ideas for grassroots, academy, and private coaching groups',
  'Coaching the coaches content to sharpen how you teach',
  'Behind-the-scenes insight into how Joner Football runs coaching standards'
]

const faqs = [
  {
    q: 'Who is Coaches Only for?',
    a: 'Club coaches, private trainers, academy coaches, parents coaching teams, and anyone who wants more detail in their sessions.'
  },
  {
    q: 'Is this just drill videos?',
    a: 'No. The point is the coaching detail. You get session planning, coaching points, full sessions, voice-over explanations, and examples of Lee working with players.'
  },
  {
    q: 'Can I use this for team training?',
    a: 'Yes. Coaches Only includes team training content and session ideas you can adapt for groups, squads, and private coaching environments.'
  },
  {
    q: 'Does it include the rest of the Joner Football App?',
    a: 'Yes. Coaches Only gives access to the coaches tier plus the wider Joner Football App content.'
  }
]
---

<BaseLayout title={title} description={description} canonical="https://jonerfootball.com/app/for-coaches/" ogImage="https://jonerfootball.com/images/coaches-only/coaches-only-hero-updated.png">
  <main class="bg-joner-black text-white">
    <section class="relative overflow-hidden border-b border-gray-900">
      <div class="absolute inset-0">
        <img src="/images/coaches-only/coaches-only-hero-updated.png" alt="Coaches Only inside the Joner Football App" class="h-full w-full object-cover opacity-60" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-r from-joner-black via-joner-black/80 to-joner-black/25"></div>
      </div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28 lg:py-32">
        <div class="max-w-4xl">
          <p class="font-heading uppercase tracking-[0.25em] text-joner-red text-sm mb-5">COACHES ONLY</p>
          <h1 class="font-heading uppercase text-5xl md:text-7xl lg:text-8xl leading-none mb-6">
            Build Better Sessions. Coach With More Detail.
          </h1>
          <p class="text-xl md:text-2xl text-gray-200 max-w-3xl mb-8">
            A dedicated Joner Football App tier for coaches who want session plans, voice-over drills, coaching points, full training sessions, and real insight into how Lee Jones coaches.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href={checkoutUrl} target="_blank" rel="noopener noreferrer" class="btn-red text-center" data-meta-checkout-event="CoachesPageClickToCheckout">Start Coaches Only</a>
            <a href="#inside" class="btn-outline text-center">See What's Inside</a>
          </div>
        </div>
      </div>
    </section>


    <section class="py-16 md:py-24 bg-white text-joner-black">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="font-heading uppercase tracking-[0.25em] text-joner-red text-sm mb-4">WHY IT EXISTS</p>
          <h2 class="font-heading uppercase text-4xl md:text-6xl leading-none mb-6">Stop Winging Your Sessions.</h2>
          <p class="text-lg text-gray-700 mb-8 max-w-xl">
            Learn how we structure our sessions from structured plans, voice-over sessions, and full session videos. Coach with more purpose.
          </p>
          <a href={checkoutUrl} target="_blank" rel="noopener noreferrer" class="btn-red inline-flex text-center" data-meta-checkout-event="CoachesPageClickToCheckout">Start Coaches Only</a>
        </div>
        <div class="overflow-hidden rounded-[28px] bg-black/5 p-1 shadow-[0_28px_70px_rgba(0,0,0,0.24)] ring-1 ring-black/10">
          <img src="/images/coaches-only/session-structure-roadmap-plush.png" alt="Plan, understand, watch and become coaching pathway" class="block w-full rounded-[24px] object-cover" loading="lazy" />
        </div>
      </div>
    </section>

    <section id="inside" class="py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mb-12">
          <p class="font-heading uppercase tracking-[0.25em] text-joner-red text-sm mb-4">INSIDE COACHES ONLY</p>
          <h2 class="font-heading uppercase text-4xl md:text-6xl leading-none mb-5">Everything Included.</h2>
          <p class="text-xl text-gray-300">Pulled from the live Coaches Only category inside the Joner Football App.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">
          {contentBlocks.map((item) => (
            <article class="bg-joner-gray border border-gray-800 overflow-hidden flex flex-col">
              <div class="aspect-video bg-black overflow-hidden">
                <img src={item.image} alt={item.title} class="h-full w-full object-cover hover:scale-105 transition-transform duration-300" loading="lazy" />
              </div>
              <div class="p-5 flex-1 flex flex-col">
                <p class="font-heading uppercase tracking-[0.18em] text-joner-red text-xs mb-3">{item.eyebrow}</p>
                <h3 class="font-heading uppercase text-2xl leading-tight mb-3">{item.title}</h3>
                <p class="text-gray-300 text-sm flex-1">{item.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>


    <section class="py-16 md:py-24 bg-white text-joner-black">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <p class="font-heading uppercase tracking-[0.25em] text-joner-red text-sm mb-4">FAQ</p>
          <h2 class="font-heading uppercase text-4xl md:text-6xl leading-none">Questions Coaches Ask.</h2>
        </div>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <details class="group border border-gray-200 bg-gray-50 p-6">
              <summary class="cursor-pointer list-none font-heading uppercase text-2xl flex items-center justify-between gap-4">
                {faq.q}
                <span class="text-joner-red group-open:rotate-45 transition-transform">+</span>
              </summary>
              <p class="text-gray-700 mt-4 text-lg">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="font-heading uppercase tracking-[0.25em] text-joner-red text-sm mb-4">COACH BETTER THIS WEEK</p>
        <h2 class="font-heading uppercase text-4xl md:text-7xl leading-none mb-6">Stop Guessing. Start Coaching The Detail.</h2>
        <p class="text-xl text-gray-300 mb-8 max-w-3xl mx-auto">Join Coaches Only inside the Joner Football App and get the coaching resource Lee built for coaches who want more than surface-level drills.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={checkoutUrl} target="_blank" rel="noopener noreferrer" class="btn-red text-center" data-meta-checkout-event="CoachesPageClickToCheckout">Start Coaches Only</a>
          <a href={appCategoryUrl} target="_blank" rel="noopener noreferrer" class="btn-outline text-center">Preview In The App</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
