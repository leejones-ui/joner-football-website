          <a href={checkoutUrl} target="_blank" rel="noopener noreferrer" class="btn-red text-base px-8 py-4 text-center" data-meta-checkout-event="CoachesPageClickToCheckout">JOIN COACHES ONLY</a>
          <a href={sampleSessionUrl} target="_blank" rel="noopener noreferrer" class="btn-outline text-base px-8 py-4 text-center">WATCH A SESSION FREE</a>
        </div>
        <p class="text-gray-200 font-body text-base">
          <span class="font-heading text-white font-semibold">{yearlyPrice}</span><span class="text-gray-400"> per year or </span><span class="font-heading text-white font-semibold">{monthlyPrice}</span><span class="text-gray-200"> per month. Max Plan tier. Cancel anytime.</span>
        </p>
      </div>
