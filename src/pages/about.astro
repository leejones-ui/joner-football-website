  <script>
    document.querySelectorAll('.contact-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        const target = (tab as HTMLElement).dataset.tab

        document.querySelectorAll('.contact-tab').forEach(t => {
          t.classList.remove('bg-joner-red', 'text-white')
          t.classList.add('border', 'border-gray-700', 'text-gray-400')
        })
        tab.classList.add('bg-joner-red', 'text-white')
        tab.classList.remove('border', 'border-gray-700', 'text-gray-400')

        document.querySelectorAll('.contact-form-panel').forEach(p => p.classList.add('hidden'))
        document.getElementById(`form-${target}`)?.classList.remove('hidden')
      })
    })
  </script>

  <EmailCapture />

  <style>
    /* Animated spotlight beams for the hero card */
    .spotlight {
      position: absolute;
      pointer-events: none;
      z-index: 1;
      filter: blur(80px);
      opacity: 0;
      animation: spotlight-fade 2s ease-out 0.2s forwards;
    }
    .spotlight-a {
      top: -20%;
      left: -10%;
      width: 70%;
      height: 80%;
      background: radial-gradient(ellipse at center, rgba(255,255,255,0.35), transparent 60%);
      transform: rotate(-20deg);
    }
    .spotlight-b {
      bottom: -25%;
      right: -15%;
      width: 65%;
      height: 80%;
      background: radial-gradient(ellipse at center, rgba(227,6,19,0.30), transparent 60%);
      transform: rotate(15deg);
      animation-delay: 0.6s;
    }
    @keyframes spotlight-fade {
      from { opacity: 0; transform: translateY(20px) rotate(var(--rot, 0deg)); }
      to { opacity: 1; transform: translateY(0) rotate(var(--rot, 0deg)); }
    }
    @media (prefers-reduced-motion: reduce) {
      .spotlight { animation: none; opacity: 1; }
    }
  </style>

</BaseLayout>
