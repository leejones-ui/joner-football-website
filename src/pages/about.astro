---
import BaseLayout from '../layouts/BaseLayout.astro'
import { leePersonSchema } from '../lib/aiSearchContent'
import { breadcrumbSchema } from '../lib/seoSchema'

const aboutPageSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About Us | Lee Jones & Joner Football",
  "description": "A Licence coach. Author with Penguin. Founder of Joner Football. From Sydney to the world, technique above everything.",
  "url": "https://jonerfootball.com/about/",
  "mainEntity": { "@id": "https://jonerfootball.com/about/#lee-jones" }
}

const crumbs = breadcrumbSchema([
  { name: 'Home', url: 'https://jonerfootball.com/' },
  { name: 'About Us', url: 'https://jonerfootball.com/about/' },
])

const filmRoom = [
  { id: 'axQYlKahQ58', title: 'Our Story', note: 'How it all started.', autoplay: true },
  { id: 'X2Lb84oetsQ', title: '1on1 Training', note: 'One player. Full detail.' },
  { id: '8xfWkNLdVYE', title: 'Group Training', note: 'Standards in a squad.' },
  { id: '6Lk7pztLhEw', title: 'Training Pros', note: 'The top level, up close.' },
]

---

<BaseLayout
  title="About Us | Lee Jones & Joner Football"
  description="A Licence coach. Author with Penguin. Founder of Joner Football. From Sydney to the world, technique above everything."
  ogImage="https://jonerfootball.com/images/about-lee/hero-poster.jpg"
  schema={[aboutPageSchema, leePersonSchema, crumbs]}
  hideChrome={true}
>
  <div id="al-root" class="al-root">

    <!-- Preloader -->
    <div class="al-loader" aria-hidden="true">
      <div class="al-loader-inner">
        <span class="al-loader-word">JONER&nbsp;FOOTBALL</span>
        <span class="al-loader-est">EST. 2013 · SYDNEY</span>
        <span class="al-loader-line"></span>
      </div>
    </div>

    <!-- Slim header -->
    <header class="al-top">
      <a class="al-top-brand" href="/">JONER FOOTBALL</a>
      <a class="al-top-link" href="/join/">Train With Joner</a>
    </header>

    <!-- HERO -->
    <section class="al-hero" id="al-hero">
      <div class="al-hero-media">
        <video
          class="al-hero-video al-hero-base"
          src="/videos/about-lee-hero.mp4"
          poster="/images/about-lee/hero-poster.jpg"
          autoplay muted loop playsinline preload="auto"
        ></video>
        <div class="al-hero-grade" aria-hidden="true"></div>
        <video
          class="al-hero-video al-hero-reveal"
          src="/videos/about-lee-hero.mp4"
          muted loop playsinline preload="none" aria-hidden="true"
        ></video>
        <div class="al-spot" aria-hidden="true"></div>
        <span class="al-face-hint" aria-hidden="true">Move to reveal</span>
      </div>

      <div class="al-hero-copy">
        <p class="al-hero-eyebrow al-fade">JONER FOOTBALL · EST. 2013 · SYDNEY</p>
        <h1 class="al-hero-title">
          <span class="al-hero-line"><span class="al-hero-word">LEE</span></span>
          <span class="al-hero-script" aria-hidden="true">Joner</span>
          <span class="al-hero-line"><span class="al-hero-word">JONES</span></span>
        </h1>
        <p class="al-hero-sub al-fade">Founder. A Licence coach. Twenty years on grass.</p>
      </div>

      <div class="al-hero-meta al-fade">
        <span>FOUNDER</span><span>COACH</span><span>AUTHOR</span>
      </div>
      <div class="al-hero-scroll al-fade" aria-hidden="true">
        <span>SCROLL</span>
        <span class="al-hero-scroll-line"></span>
      </div>
    </section>

    <!-- MANIFESTO with continuous background marquee -->
    <section class="al-manifesto">
      <div class="al-marquee" aria-hidden="true">
        <div class="al-marquee-row al-marquee-a"><span>JONER FOOTBALL&nbsp;·&nbsp;JONER FOOTBALL&nbsp;·&nbsp;JONER FOOTBALL&nbsp;·&nbsp;</span><span>JONER FOOTBALL&nbsp;·&nbsp;JONER FOOTBALL&nbsp;·&nbsp;JONER FOOTBALL&nbsp;·&nbsp;</span></div>
        <div class="al-marquee-row al-marquee-b"><span>TECHNIQUE&nbsp;·&nbsp;TECHNIQUE&nbsp;·&nbsp;TECHNIQUE&nbsp;·&nbsp;TECHNIQUE&nbsp;·&nbsp;</span><span>TECHNIQUE&nbsp;·&nbsp;TECHNIQUE&nbsp;·&nbsp;TECHNIQUE&nbsp;·&nbsp;TECHNIQUE&nbsp;·&nbsp;</span></div>
      </div>
      <div class="al-manifesto-inner">
        <p class="al-manifesto-quote al-lines">
          I built Joner Football to give players, parents, and coaches access to the
          technical coaching, detail, and lessons I&rsquo;ve learned throughout my career
          as both a player and a coach. I&rsquo;m grateful to be able to share that knowledge
          and give something back to young ballers around the world.
        </p>
      </div>
    </section>

    <!-- CREDENTIALS -->
    <section class="al-numbers">
      <div class="al-numbers-grid">
        <div class="al-num"><span class="al-num-val" data-target="2.5" data-decimals="1" data-suffix="M+">0</span><span class="al-num-label">Followers online</span></div>
        <div class="al-num"><span class="al-num-val" data-target="50" data-suffix="K+">0</span><span class="al-num-label">App downloads</span></div>
        <div class="al-num al-num-text"><span class="al-num-word">A Licence</span><span class="al-num-label">Qualified coach</span></div>
        <div class="al-num al-num-text"><span class="al-num-word">Author</span><span class="al-num-label">Published with Penguin</span></div>
        <div class="al-num al-num-text"><span class="al-num-word">Global</span><span class="al-num-label">Recognised worldwide</span></div>
      </div>
    </section>

    <!-- THE ROAD -->
    <section class="al-road">
      <figure class="al-road-photo">
        <div class="al-road-photo-frame"><img src="/images/about-lee/camp-ball.jpg" alt="Lee coaching on the ball among young players at a Joner Football camp" loading="lazy" /></div>
      </figure>
      <div class="al-road-body">
        <p class="al-eyebrow">THE ROAD</p>
        <ol class="al-road-list">
          <li class="al-road-item"><span class="al-road-year">Wrexham</span><span class="al-road-text">Raised in the academy game at Wrexham AFC, then capped by Wales.</span></li>
          <li class="al-road-item"><span class="al-road-year">16</span><span class="al-road-text">UEFA C Licence.</span></li>
          <li class="al-road-item"><span class="al-road-year">19</span><span class="al-road-text">UEFA B Licence. Academy Director at Rhyl FC the same year.</span></li>
          <li class="al-road-item"><span class="al-road-year">A</span><span class="al-road-text">UEFA A Licence, and a qualified teacher.</span></li>
          <li class="al-road-item"><span class="al-road-year">2017</span><span class="al-road-text">Voted a Top 10 technical trainer in the world.</span></li>
          <li class="al-road-item"><span class="al-road-year">Penguin</span><span class="al-road-text">Two books with Penguin, plus his own coaching manual.</span></li>
        </ol>
      </div>
    </section>

    <!-- SINCE THEN -->
    <section class="al-since">
      <div class="al-since-inner">
        <p class="al-eyebrow">SINCE THEN</p>
        <p class="al-since-copy">
          A-League, W-League and elite international players coached. A following
          2.5 million strong. The app in 50,000+ pockets, with 1,500+ training drills
          inside. Camps across 15+ countries, and players who went on to professional
          and international careers.
        </p>
        <p class="al-since-copy">
          Today it all runs from JFP HQ in Belrose, Sydney. A purpose-built indoor
          facility for technical development. The philosophy has never changed.
          <em>Master the ball, and the game opens up.</em>
        </p>
      </div>
    </section>

    <!-- TECHNIQUE ABOVE EVERYTHING -->
    <section class="al-creed" id="al-creed">
      <div class="al-creed-stage">
        <p class="al-creed-word al-creed-1">TECHNIQUE</p>
        <p class="al-creed-word al-creed-2"><em>above</em></p>
        <p class="al-creed-word al-creed-3">EVERYTHING</p>
      </div>
    </section>

    <!-- LIBRARY: collage wall over a fixed hero backdrop -->
    <section class="al-gallery" id="al-gallery">

      <div class="al-gallery-bg" id="al-gallery-bg" aria-hidden="true">
        <img src="/images/about-lee/new-hero.jpg" alt="" loading="lazy" decoding="async" />
      </div>

      <div class="al-gallery-lead">
        <p class="al-eyebrow">THE LIBRARY</p>
        <p class="al-gallery-lead-line">Every drill. Every camp.<br /><em>Every session.</em></p>
      </div>

      <div class="al-gallery-viewport" id="al-gallery-viewport">
        <div class="al-gallery-track" id="al-gallery-track">

          <div class="al-col al-col-lead" aria-hidden="true"></div>

          <div class="al-col al-col-high">
            <figure class="al-tile al-tile-wide">
              <span class="al-tile-label">HARBOUR BRIDGE</span>
              <div class="al-tile-frame"><img src="/images/about-lee/harbour.jpg" alt="Lee walking with a football at Sydney Harbour Bridge" loading="lazy" decoding="async" /></div>
            </figure>
          </div>

          <div class="al-col al-col-low">
            <figure class="al-tile al-tile-sm al-bw">
              <span class="al-tile-label">CAMP DAY</span>
              <div class="al-tile-frame"><img src="/images/about-lee/camp-ball.jpg" alt="Lee on the ball at a Joner Football camp" loading="lazy" decoding="async" /></div>
            </figure>
            <figure class="al-tile al-tile-sm">
              <span class="al-tile-label">SYDNEY</span>
              <div class="al-tile-frame"><img src="/images/about-lee/young-pros.jpg" alt="Lee with two young professional players on a Sydney pitch" loading="lazy" decoding="async" /></div>
            </figure>
          </div>

          <div class="al-col al-col-mid">
            <figure class="al-tile al-tile-lg al-tile-video">
              <span class="al-tile-label">BELROSE</span>
              <div class="al-tile-frame"><video src="/videos/about-lee-kick-reel.mp4" muted loop playsinline preload="none" aria-label="Lee striking balls inside the Joner Football HQ"></video></div>
            </figure>
          </div>

          <div class="al-col al-col-high">
            <figure class="al-tile al-tile-sm">
              <span class="al-tile-label">TRAINING PROS</span>
              <div class="al-tile-frame"><img src="/images/about-lee/lefondre.jpg" alt="Lee Jones with striker Adam Le Fondre" loading="lazy" decoding="async" /></div>
            </figure>
            <figure class="al-tile al-tile-sm">
              <span class="al-tile-label">TELEVISION</span>
              <div class="al-tile-frame"><img src="/images/about-lee/studio.jpg" alt="Lee smiling in the television studio" loading="lazy" decoding="async" /></div>
            </figure>
          </div>

          <div class="al-col al-col-low">
            <figure class="al-tile al-tile-wide">
              <span class="al-tile-label">CHANNEL SEVEN · 2023</span>
              <div class="al-tile-frame"><img src="/images/about-lee/world-cup-desk.jpg" alt="Lee on the FIFA Womens World Cup highlights desk" loading="lazy" decoding="async" /></div>
            </figure>
          </div>

          <div class="al-col al-col-mid">
            <figure class="al-tile al-tile-lg al-bw">
              <span class="al-tile-label">NIKE F.C. · NIGHT</span>
              <div class="al-tile-frame"><img src="/images/about-lee/nike-night.jpg" alt="Black and white photo of Lee driving the ball forward at a Nike FC night session" loading="lazy" decoding="async" /></div>
            </figure>
          </div>

          <div class="al-col al-col-high">
            <figure class="al-tile al-tile-md">
              <span class="al-tile-label">MINDSET SEMINAR</span>
              <div class="al-tile-frame"><img src="/images/about-lee/seminar.jpg" alt="Lee presenting a Joner Football mindset seminar" loading="lazy" decoding="async" /></div>
            </figure>
            <figure class="al-tile al-tile-sm al-bw">
              <span class="al-tile-label">OPTUS SPORT · 2021</span>
              <div class="al-tile-frame"><img src="/images/about-lee/cage.jpg" alt="Lee on the ball during an Optus Sport shoot" loading="lazy" decoding="async" /></div>
            </figure>
          </div>

          <div class="al-col al-col-low">
            <figure class="al-tile al-tile-wide al-tile-video">
              <span class="al-tile-label">ON SET · THE WORK NEVER STOPS</span>
              <div class="al-tile-frame"><video src="/videos/about-lee-on-set.mp4" muted loop playsinline preload="none" aria-label="Lee filmed by a camera crew on set"></video></div>
            </figure>
          </div>

          <div class="al-col al-col-mid">
            <figure class="al-tile al-tile-sm">
              <span class="al-tile-label">CAMPS</span>
              <div class="al-tile-frame"><img src="/images/about-lee/camp-family.jpg" alt="Lee with around one hundred camp players, footballs spelling JONER" loading="lazy" decoding="async" /></div>
            </figure>
            <figure class="al-tile al-tile-sm al-bw">
              <span class="al-tile-label">INDOOR NIGHTS · 2020</span>
              <div class="al-tile-frame"><img src="/images/about-lee/arena.jpg" alt="Lee smiling in a dark indoor football arena" loading="lazy" decoding="async" /></div>
            </figure>
          </div>

          <div class="al-col al-col-high">
            <figure class="al-tile al-tile-sm al-bw">
              <span class="al-tile-label">BELROSE · BEFORE</span>
              <div class="al-tile-frame"><img src="/images/about-lee/empty-shed.jpg" alt="Lee and Carolina inside the empty warehouse that became the Joner Football HQ" loading="lazy" decoding="async" /></div>
            </figure>
            <figure class="al-tile al-tile-sm">
              <span class="al-tile-label">AUTHOR · PENGUIN</span>
              <div class="al-tile-frame"><img src="/images/about-lee/books.jpg" alt="Lee holding two Joner Football books published with Penguin" loading="lazy" decoding="async" /></div>
            </figure>
          </div>

          <div class="al-col al-col-low">
            <figure class="al-tile al-tile-wide">
              <span class="al-tile-label">THE JF HQ · TODAY</span>
              <div class="al-tile-frame"><img src="/images/about-lee/hq.jpg" alt="Lee standing outside the Joner Football HQ building in Belrose" loading="lazy" decoding="async" /></div>
            </figure>
          </div>

        </div>
      </div>
    </section>

    <!-- FILM ROOM: YouTube carousel -->
    <section class="al-film">
      <div class="al-film-head">
        <p class="al-eyebrow">WATCH LEE COACH</p>
        <h2 class="al-h2">The film room<em>.</em></h2>
        <p class="al-film-hint" aria-hidden="true">DRAG</p>
      </div>
      <div class="al-yt-wrap">
        <div class="al-yt-track" id="al-yt-track">
          {filmRoom.map((v, i) => (
            <article class="al-yt-card" data-yt={v.id} data-title={v.title} data-autoplay={v.autoplay ? '1' : undefined}>
              <div class="al-yt-thumb">
                <img src={`https://img.youtube.com/vi/${v.id}/maxresdefault.jpg`} alt={`YouTube video: ${v.title}`} loading="lazy" draggable="false" />
                <span class="al-yt-play" aria-hidden="true"></span>
              </div>
              <div class="al-yt-cap">
                <span class="al-yt-index">{String(i + 1).padStart(2, '0')}</span>
                <span class="al-yt-title">{v.title}</span>
                <span class="al-yt-note">{v.note}</span>
              </div>
            </article>
          ))}
        </div>
        <div class="al-yt-progress"><span id="al-yt-bar"></span></div>
      </div>
      <div class="al-film-more">
        <a class="al-btn al-btn-ghost" href="https://www.youtube.com/@jonerfootball" target="_blank" rel="noopener">Watch More On YouTube</a>
      </div>
    </section>

    <!-- CLOSE -->
    <section class="al-close">
      <p class="al-eyebrow">WHEREVER YOU ARE</p>
      <h2 class="al-close-title al-lines">The method travels. Train with Lee from any postcode on earth.</h2>
      <div class="al-close-ctas">
        <a class="al-btn al-btn-gold" href="/join/">Start Training On The App</a>
        <a class="al-btn al-btn-ghost" href="/training/">Book Sydney Training</a>
      </div>
      <footer class="al-foot">
        <span>© 2026 JONER FOOTBALL</span>
        <span class="al-foot-creed">TECHNIQUE ABOVE EVERYTHING</span>
        <a href="/about/">Full about page</a>
      </footer>
    </section>

  </div>
</BaseLayout>

<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Mrs+Saint+Delafield&family=DM+Sans:wght@400;500;700&display=swap');

/* Lenis needs native instant scrolling: neutralise the global smooth scroll-behavior */
html.lenis { scroll-behavior: auto !important; }
html.lenis, html.lenis body { height: auto; }

.al-root {
  --al-ink: #0b0b0c;
  --al-ink2: #121214;
  --al-bone: #ece8df;
  --al-mute: #8d887d;
  --al-gold: #c9a227;
  --al-gold-hi: #e8c96a;
  --al-hair: rgba(236, 232, 223, 0.14);
  --al-serif: 'Fraunces', Georgia, serif;
  --al-sans: 'DM Sans', system-ui, sans-serif;
  --al-script: 'Mrs Saint Delafield', cursive;
  background: var(--al-ink);
  color: var(--al-bone);
  font-family: var(--al-sans);
  overflow-x: clip;
  min-height: 100vh;
}
.al-root * { box-sizing: border-box; }
.al-root ::selection { background: var(--al-gold); color: var(--al-ink); }
.al-root img, .al-root video { display: block; max-width: 100%; }
.al-root figure { margin: 0; }
.al-root a { color: inherit; text-decoration: none; }

/* Preloader */
.al-loader {
  position: fixed; inset: 0; z-index: 90;
  background: var(--al-ink);
  display: flex; align-items: center; justify-content: center;
}
.al-loader-inner { display: flex; flex-direction: column; align-items: center; gap: 14px; }
.al-loader-word {
  font-family: var(--al-serif); font-weight: 500; font-size: clamp(1.4rem, 3.4vw, 2.6rem);
  letter-spacing: 0.32em; text-indent: 0.32em; color: var(--al-bone);
}
.al-loader-est { font-size: 0.62rem; letter-spacing: 0.42em; text-indent: 0.42em; color: var(--al-mute); }
.al-loader-line { width: 120px; height: 1px; background: var(--al-hair); position: relative; overflow: hidden; }
.al-loader-line::after { content: ''; position: absolute; inset: 0; background: var(--al-gold); transform: scaleX(0); transform-origin: left; animation: al-load 1.1s cubic-bezier(.77,0,.18,1) forwards; }
@keyframes al-load { to { transform: scaleX(1); } }

/* Header */
.al-top {
  position: fixed; top: 0; left: 0; right: 0; z-index: 60;
  display: flex; justify-content: space-between; align-items: center;
  padding: 22px clamp(20px, 4vw, 56px);
  mix-blend-mode: difference;
}
.al-top-brand { font-family: var(--al-serif); font-weight: 600; letter-spacing: 0.26em; font-size: 0.82rem; color: #fff; }
.al-top-link { font-size: 0.7rem; letter-spacing: 0.24em; text-transform: uppercase; color: #fff; border-bottom: 1px solid rgba(255,255,255,0.4); padding-bottom: 3px; }

/* Hero */
.al-hero { position: relative; height: 100svh; min-height: 620px; overflow: hidden; }
.al-hero-media { position: absolute; inset: 0; }
.al-hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
/* Base sits in a moody grade; the reveal layer is the same 4K footage in full colour,
   wiped in by a soft-edged spotlight that follows the cursor. */
.al-hero-base { z-index: 0; filter: grayscale(0.42) brightness(0.7) contrast(1.09) saturate(0.82); }
.al-hero-reveal {
  z-index: 2; filter: brightness(1.06) saturate(1.1) contrast(1.02);
  opacity: 0; transition: opacity 0.45s ease; pointer-events: none;
  --al-x: 50%; --al-y: 30%; --al-r: 0px;
  -webkit-mask-image: radial-gradient(circle var(--al-r) at var(--al-x) var(--al-y), #000 0%, #000 52%, rgba(0,0,0,0) 100%);
  mask-image: radial-gradient(circle var(--al-r) at var(--al-x) var(--al-y), #000 0%, #000 52%, rgba(0,0,0,0) 100%);
}
.al-hero.is-revealing .al-hero-reveal { opacity: 1; }
.al-hero-grade {
  position: absolute; inset: 0; z-index: 1; pointer-events: none;
  background:
    linear-gradient(to top, var(--al-ink) 4%, transparent 36%),
    linear-gradient(to bottom, rgba(11,11,12,0.55) 0%, transparent 24%),
    radial-gradient(120% 90% at 50% 40%, transparent 55%, rgba(11,11,12,0.6) 100%);
}
.al-spot {
  position: absolute; z-index: 3; left: 50%; top: 30%; width: 380px; height: 380px;
  transform: translate(-50%, -50%); border-radius: 50%; pointer-events: none;
  opacity: 0; transition: opacity 0.45s ease; mix-blend-mode: screen;
  background: radial-gradient(circle, rgba(232,201,106,0.16) 0%, rgba(232,201,106,0.06) 42%, transparent 70%);
}
.al-hero.is-revealing .al-spot { opacity: 1; }
.al-face-hint {
  position: absolute; left: 50%; top: 30%; transform: translate(-50%, -50%); z-index: 5;
  display: flex; align-items: center; gap: 12px; pointer-events: none;
  font-size: 0.58rem; letter-spacing: 0.34em; text-indent: 0.34em; text-transform: uppercase;
  color: rgba(236,232,223,0.72); transition: opacity 0.5s ease;
}
.al-face-hint::before, .al-face-hint::after { content: ''; width: 28px; height: 1px; background: rgba(232,201,106,0.5); }
.al-hero-copy {
  position: absolute; left: 0; right: 0; bottom: clamp(72px, 12vh, 130px);
  text-align: center; z-index: 4; pointer-events: none;
  perspective: 900px;
}
.al-hero-eyebrow { font-size: 0.66rem; letter-spacing: 0.44em; text-indent: 0.44em; color: var(--al-mute); margin: 0 0 1.6vh; }
.al-hero-title { margin: 0; line-height: 0.86; position: relative; }
.al-hero-line { display: block; overflow: hidden; padding: 0.04em 0; }
.al-hero-word {
  display: inline-block;
  font-family: var(--al-serif); font-weight: 400;
  font-size: clamp(4.6rem, 17vw, 15.5rem);
  letter-spacing: 0.03em; color: var(--al-bone);
}
.al-hero-script {
  position: absolute; left: 50%; top: 50%; z-index: 3;
  transform: translate(-50%, -54%) rotate(-7deg);
  font-family: var(--al-script); font-size: clamp(2.6rem, 7.5vw, 6.4rem);
  color: var(--al-gold); pointer-events: none;
  text-shadow: 0 2px 30px rgba(11,11,12,0.7);
}
.al-hero-sub { margin: 2.4vh 0 0; font-size: clamp(0.72rem, 1.1vw, 0.92rem); letter-spacing: 0.3em; text-indent: 0.3em; text-transform: uppercase; color: rgba(236,232,223,0.82); }
.al-hero-meta {
  position: absolute; left: clamp(20px, 4vw, 56px); bottom: 26px; z-index: 4;
  display: flex; gap: 22px; font-size: 0.6rem; letter-spacing: 0.3em; color: var(--al-mute);
}
.al-hero-scroll {
  position: absolute; right: clamp(20px, 4vw, 56px); bottom: 26px; z-index: 4;
