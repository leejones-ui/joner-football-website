      });
      hero.addEventListener('mouseleave', function () {
        tr = 0; entered = false; hero.classList.remove('is-revealing');
        if (hint) hint.style.opacity = '';
      });
      window.addEventListener('resize', reset);
    } else if (revealV) {
      revealV.parentNode.removeChild(revealV);
    }

    /* ---------- Reduced motion or missing GSAP: show everything ---------- */
    if (reduce || !hasGsap) {
      var loader = root.querySelector('.al-loader');
      if (loader) loader.style.display = 'none';
      return;
    }

    gsap.registerPlugin(ScrollTrigger);

    /* ---------- Smooth scroll ---------- */
    var lenis = null;
    if (typeof Lenis !== 'undefined') {
      lenis = new Lenis({ lerp: 0.09, smoothWheel: true });
      window.alLenis = lenis;
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add(function (t) { lenis.raf(t * 1000); });
      gsap.ticker.lagSmoothing(0);
    }

    /* ---------- Intro: preloader then hero ---------- */
    var intro = gsap.timeline();
    intro
      .from('.al-loader-word', { y: 26, opacity: 0, duration: 0.7, ease: 'power3.out' })
      .from('.al-loader-est', { opacity: 0, duration: 0.5 }, '-=0.35')
      .to('.al-loader', { yPercent: -100, duration: 0.85, ease: 'power4.inOut', delay: 0.75 })
      .set('.al-loader', { display: 'none' })
      .from('.al-hero-word', { yPercent: 110, duration: 1.1, ease: 'power4.out', stagger: 0.12 }, '-=0.45')
      .from('.al-hero-script', { opacity: 0, scale: 0.7, rotate: -14, duration: 0.8, ease: 'back.out(1.6)' }, '-=0.55')
      .from('.al-hero .al-fade', { opacity: 0, y: 14, duration: 0.7, stagger: 0.08, ease: 'power2.out' }, '-=0.5')
      .from('.al-top', { opacity: 0, y: -12, duration: 0.6 }, '-=0.6');

    /* ---------- Hero scroll: parallax and 3D drift ---------- */
    gsap.to('.al-hero-video', {
      scale: 1.16, yPercent: 6, ease: 'none',
      scrollTrigger: { trigger: '.al-hero', start: 'top top', end: 'bottom top', scrub: true }
    });
    gsap.to('.al-hero-copy', {
      yPercent: -40, rotateX: 8, opacity: 0.15, ease: 'none', transformOrigin: '50% 100%',
      scrollTrigger: { trigger: '.al-hero', start: 'top top', end: 'bottom top', scrub: true }
    });

    /* ---------- Marquee: fast continuous loop, boosted by scroll velocity ---------- */
    var mqA = gsap.to('.al-marquee-a', { xPercent: -50, duration: 11, ease: 'none', repeat: -1 });
    var mqB = gsap.fromTo('.al-marquee-b', { xPercent: -50 }, { xPercent: 0, duration: 14, ease: 'none', repeat: -1 });
    var mqTimer;
    ScrollTrigger.create({
      trigger: '.al-manifesto', start: 'top bottom', end: 'bottom top',
      onUpdate: function (self) {
        var boost = 1 + Math.min(7, Math.abs(self.getVelocity()) / 260);
        mqA.timeScale(boost); mqB.timeScale(boost);
        clearTimeout(mqTimer);
        mqTimer = setTimeout(function () { mqA.timeScale(1); mqB.timeScale(1); }, 180);
      }
    });

    /* ---------- One-shot reveals: explicit start state + to() on enter.
       Avoids from() value capture, which breaks under HMR and scroll restoration. ---------- */
    var revealOnEnter = function (targets, opts) {
      opts = opts || {};
      var els = gsap.utils.toArray(targets);
      if (!els.length) return;
      gsap.set(els, { opacity: 0, y: opts.y == null ? 24 : opts.y });
      ScrollTrigger.create({
        trigger: opts.trigger || els[0],
        start: opts.start || 'top 88%',
        once: true,
        onEnter: function () {
          gsap.to(els, {
            opacity: 1, y: 0,
            duration: opts.duration || 0.8,
            ease: opts.ease || 'power3.out',
            stagger: opts.stagger || 0,
            delay: opts.delay || 0,
            overwrite: 'auto'
          });
        }
      });
    };

    /* ---------- Manifesto quote line reveal ---------- */
    revealOnEnter('.al-manifesto-quote', { y: 40, duration: 1.1, start: 'top 78%' });

    /* ---------- Credential cells: word cells fade in ---------- */
    revealOnEnter('.al-num-text', { y: 20, duration: 0.7, stagger: 0.08, trigger: '.al-numbers', start: 'top 80%' });

    /* ---------- Numbers count up ---------- */
    root.querySelectorAll('.al-num-val').forEach(function (el) {
      var target = parseFloat(el.getAttribute('data-target'));
      var dec = parseInt(el.getAttribute('data-decimals') || '0', 10);
      var suffix = el.getAttribute('data-suffix') || '';
      var comma = el.getAttribute('data-comma') === '1';
      var obj = { v: 0 };
      gsap.to(obj, {
        v: target, duration: 1.6, ease: 'power2.out',
        scrollTrigger: { trigger: el, start: 'top 88%' },
        onUpdate: function () {
          var n = obj.v.toFixed(dec);
          if (comma) n = Number(n).toLocaleString('en-US');
          el.textContent = n + suffix;
        }
      });
    });

    /* ---------- Road: photo + credential list ---------- */
    revealOnEnter('.al-road-photo', { y: 40, duration: 1, trigger: '.al-road', start: 'top 78%' });
    gsap.utils.toArray('.al-road-item').forEach(function (item) {
      revealOnEnter(item, { y: 30, duration: 0.8, start: 'top 90%' });
    });

    /* ---------- Since then ---------- */
    revealOnEnter('.al-since-copy', { y: 30, duration: 1, stagger: 0.15, trigger: '.al-since', start: 'top 74%' });

    /* ---------- Creed: pinned word slam ---------- */
    var creed = gsap.timeline({
      scrollTrigger: {
        trigger: '#al-creed', start: 'top top', end: '+=170%',
        scrub: 0.6, pin: '.al-creed-stage', anticipatePin: 1
      }
    });
    creed
      .fromTo('.al-creed-1', { opacity: 0, scale: 1.7, filter: 'blur(14px)' }, { opacity: 1, scale: 1, filter: 'blur(0px)', duration: 1 })
      .fromTo('.al-creed-2', { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.6 }, '-=0.2')
      .fromTo('.al-creed-3', { opacity: 0, scale: 0.82 }, { opacity: 1, scale: 1, duration: 1 }, '-=0.1')
      .to({}, { duration: 0.6 });

    /* ---------- Library: pinned horizontal gallery (desktop) ---------- */
    var desktop = window.matchMedia('(min-width: 901px)').matches;
    var gTrack = document.getElementById('al-gallery-track');
    var gSection = document.getElementById('al-gallery');
    if (desktop && gTrack && gSection) {
      var amount = function () { return Math.max(0, gTrack.scrollWidth - window.innerWidth); };
      var gTween = gsap.to(gTrack, {
        x: function () { return -amount(); },
        ease: 'none',
        scrollTrigger: {
          trigger: gSection,
          start: 'top top',
          end: function () { return '+=' + amount(); },
          pin: true, scrub: 0.6, anticipatePin: 1, invalidateOnRefresh: true
        }
      });
      /* each tile eases up + in as it crosses the screen */
      gsap.utils.toArray('.al-tile').forEach(function (tile) {
        gsap.from(tile, {
          y: 50, autoAlpha: 0, ease: 'power2.out',
          scrollTrigger: { trigger: tile, containerAnimation: gTween, start: 'left 96%', end: 'left 68%', scrub: true }
        });
      });
      /* the hero backdrop drifts slowly the other way for depth */
      var gbg = document.getElementById('al-gallery-bg');
      if (gbg) {
        gsap.fromTo(gbg.querySelector('img'), { x: 0, scale: 1.08 }, {
          x: '-6vw', scale: 1.16, ease: 'none',
          scrollTrigger: {
            trigger: gSection, start: 'top top',
            end: function () { return '+=' + amount(); }, scrub: true
          }
        });
      }
    }

    /* ---------- Film + close reveals ---------- */
    revealOnEnter('.al-film-head', { y: 30, duration: 0.9, trigger: '.al-film', start: 'top 74%' });
    revealOnEnter('.al-yt-card', { y: 46, stagger: 0.1, duration: 0.9, trigger: '.al-yt-track', start: 'top 82%' });
    revealOnEnter('.al-close-title', { y: 36, duration: 1, trigger: '.al-close', start: 'top 70%' });
    revealOnEnter('.al-close-ctas .al-btn', { y: 20, stagger: 0.1, duration: 0.7, trigger: '.al-close-ctas', start: 'top 88%' });

    ScrollTrigger.refresh();

    /* If the page loads already scrolled past a one-shot reveal
       (browser scroll restoration), snap that reveal to its end state. */
    var healPassedReveals = function () {
      ScrollTrigger.getAll().forEach(function (st) {
        if (st.animation && !st.vars.scrub && !st.pin && st.progress >= 1) {
          st.animation.progress(1);
        }
      });
    };
    healPassedReveals();
    window.addEventListener('load', function () {
      ScrollTrigger.refresh();
      healPassedReveals();
    });
  });
})();
</script>
