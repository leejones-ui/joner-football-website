---
import BaseLayout from '../../layouts/BaseLayout.astro'

const title = 'San Diego | Camp | June 2026 | Joner Football'
const description = 'Joner Football San Diego Camp, June 22 to 24, 2026. 3 day elite camp with Coach Joner in San Diego, CA. Ages 8 to 18. Limited spots.'
const canonical = 'https://jonerfootball.com/camps/san-diego-june/'

const infoCells = [
  {
    label: 'When',
    value: 'Mon 22 Jun to<br/>Wed 24 Jun 2026',
    sub: '3 day elite camp.',
    icon: 'calendar',
  },
  {
    label: 'Where',
    value: 'San Diego, CA',
    sub: 'Exact venue TBA',
    icon: 'pin',
  },
  {
    label: 'Time',
    value: 'TBA',
    sub: 'Times will be confirmed closer to the date',
    icon: 'clock',
  },
  {
    label: 'Who for',
    value: 'Ages 8 to 18',
    sub: 'Grouped by age and skill',
    icon: 'people',
  },
  {
    label: 'Capacity',
    value: 'Limited spots',
    sub: '16 players per coach.',
    icon: 'shield',
  },
  {
    label: 'Includes',
    value: 'App + Kit',
    sub: 'Joner Football App access. Joner jersey for full 3-day attendees.',
    icon: 'list',
  },
]

const bullets = [
  'No babysitting, only players that truly want to improve',
  'Max 16 players per coach',
  'Limited spots available',
  'Dedicated players only',
  'Sold out every year',
  'Access to Joner Football App and training kit / merch',
  'Jersey for players that attend all 3 days',
]

const faqs = [
  {
    q: 'What does the player need to bring?',
    a: ['Soccer boots', 'Shin guards', 'Drinks bottle', 'Sunscreen', 'A smile', 'Good attitude'],
  },
  {
    q: 'What should the player wear?',
    a: ['Black shorts', 'White socks', 'Joner Football will provide a training jersey'],
  },
  {
    q: 'What to expect?',
    text: "Expect energy, enthusiasm, intensity, knowledge, drills you've never done before, and above all else bags of fun. Our team of coaches will go above and beyond to make sure you are learning.",
  },
  {
    q: 'Will bad weather cancel the camp?',
    text: 'No. Only really bad storms can delay the camp.',
  },
  {
    q: 'Can we take photos / videos on the day?',
    text: "We have a team of professional photographers and videographers on the day doing their thing. You can ask on the day for a copy of the photos and we'll sort that out for you. On the last day of camp the coaches always allocate time for photos, autographs and chats with the parents.",
  },
  {
    q: "Who will be in my son / daughter's group?",
    text: 'Our coaches always group players by age first, then ability. We have a limit of 16 players per group. If a player is dominating their group, we push them up into the older age group to make sure they are tested.',
  },
]

const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: 'Joner Football San Diego Camp June 2026',
  startDate: '2026-06-22T08:00-07:00',
  endDate: '2026-06-24T11:00-07:00',
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: 'San Diego',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'San Diego',
      addressRegion: 'CA',
      addressCountry: 'US',
    },
  },
  organizer: { '@type': 'Organization', name: 'Joner Football', url: 'https://jonerfootball.com' },
  description,
}
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  schema={eventSchema}
  hideMobileAppCta
>
  <Fragment slot="head">
    <link rel="preload" as="font" href="/fonts/Kanit-BlackItalic.ttf" type="font/ttf" crossorigin />
  </Fragment>

  <div class="sd-page">

  <!-- ============ 01 HERO ============ -->
  <section class="sd-hero" id="top">
    <div class="sd-hero-overlay" aria-hidden="true"></div>
    <div class="sd-wrap sd-hero-content">
      <span class="sd-eyebrow" data-motion="fade-up"><span class="sd-pulse"></span> New for 2026</span>
      <h1 class="sd-h1" data-motion="fade-up" data-motion-delay="0.08">
        San Diego
        <span class="sd-hook">Camp</span>
        <span class="sd-h1-small">3 Day Elite Camp · June 2026</span>
      </h1>
      <div class="sd-hero-cta" data-motion="fade-up" data-motion-delay="0.24">
        <a class="btn-red" href="#register" data-motion-hover="lift">
          Register interest
        </a>
        <a class="btn-red" href="#info" data-motion-hover="lift">
          See the details
        </a>
      </div>
    </div>
  </section>

  <!-- ============ 02 KEY INFO ============ -->
  <section class="sd-info" id="info">
    <div class="sd-wrap">
      <div class="sd-info-layout">
        <div class="sd-info-left">
          <div class="sd-section-head" data-motion="fade-up">
            <span class="sd-section-eyebrow">Camp Details</span>
            <h2 class="sd-h2">The <span class="sd-hook">essentials</span>.<br/>Everything you need to know.</h2>
            <span class="sd-rule"></span>
          </div>

          <ul class="sd-info-list" data-motion-stagger data-motion-stagger-step="0.06">
            {infoCells.map((cell) => (
              <li class="sd-info-item" data-motion-stagger-child>
                <div class="sd-info-item-head">
                  <span class="sd-info-item-ico" aria-hidden="true">
                    {cell.icon === 'calendar' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>)}
                    {cell.icon === 'pin' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s7-7.5 7-13a7 7 0 1 0-14 0c0 5.5 7 13 7 13z"/><circle cx="12" cy="9" r="2.5"/></svg>)}
                    {cell.icon === 'clock' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>)}
                    {cell.icon === 'people' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 11a3 3 0 1 0 0-6M22 20a5 5 0 0 0-5-5"/></svg>)}
                    {cell.icon === 'shield' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 13l9 7 9-7M3 7l9 7 9-7-9-5-9 5z"/></svg>)}
                    {cell.icon === 'list' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h18M3 12h18M3 17h12"/></svg>)}
                  </span>
                  <span class="sd-info-item-label">{cell.label}</span>
                </div>
                <div class="sd-info-item-value" set:html={cell.value}></div>
                <div class="sd-info-item-sub">{cell.sub}</div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 03 BULLETS ============ -->
  <section class="sd-bullets">
    <div class="sd-bullets-bg" aria-hidden="true"></div>
    <div class="sd-wrap sd-bullets-content">
      <div class="sd-section-head" style="color:#fff;" data-motion="fade-up">
        <span class="sd-section-eyebrow">Why Joner</span>
        <h2 class="sd-h2" style="color:#fff;">Real coaching. <span class="sd-hook">No babysitting.</span></h2>
        <span class="sd-rule"></span>
      </div>
      <ul class="sd-bullets-list" data-motion-stagger data-motion-stagger-step="0.07">
        {bullets.map((b) => (
          <li data-motion-stagger-child>
            <span class="sd-bullet-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M5 12.5l4.2 4.2L19 7"/></svg>
            </span>
            <span>{b}</span>
          </li>
        ))}
      </ul>
      <div class="sd-bullets-cta" data-motion="fade-up">
        <a class="btn-red" href="#register" data-motion-hover="lift">
          Register interest
        </a>
      </div>
    </div>
  </section>

  <!-- ============ 04 REGISTRATION FORM (info only, no payment) ============ -->
  <section class="sd-form-section" id="register">
    <div class="sd-wrap">
      <div class="sd-section-head" data-motion="fade-up">
        <span class="sd-section-eyebrow">Register Interest</span>
        <h2 class="sd-h2">Secure your <span class="sd-hook">spot</span>.</h2>
        <p class="sd-form-lede">
          Fill in your details below to register your interest. We'll be in touch with pricing and payment details closer to the date.
        </p>
        <span class="sd-rule"></span>
      </div>

      <form class="sd-form-shell" data-motion="fade-up" id="sdForm" novalidate>
        <input type="hidden" name="camp" value="San Diego Camp June 2026" />
        <input type="hidden" name="destination" value="San Diego June 2026" />
        <input type="hidden" name="brevoListId" value="2" />
        <input type="hidden" name="brevoListIds" value="2" />
        <input type="hidden" name="source" value="san-diego-camp-2026-landing" />

        <div class="sd-form-grid">
          <div class="sd-field">
            <label>Player first name<span class="sd-req">*</span></label>
            <input type="text" name="playerFirstName" required placeholder="e.g. Marco" />
          </div>
          <div class="sd-field">
            <label>Player last name<span class="sd-req">*</span></label>
            <input type="text" name="playerSurname" required placeholder="e.g. Rodriguez" />
          </div>
          <div class="sd-field">
            <label>Player age<span class="sd-req">*</span></label>
            <input type="number" name="age" min="8" max="18" required placeholder="8 to 18" />
          </div>
          <div class="sd-field">
            <label>Parent / guardian email<span class="sd-req">*</span></label>
            <input type="email" name="email" required placeholder="you@email.com" />
          </div>
          <div class="sd-field">
            <label>Phone number<span class="sd-req">*</span></label>
            <input type="tel" name="mobile" required placeholder="(555) 555-1234" />
          </div>
          <div class="sd-field">
            <label>Jersey size<span class="sd-req">*</span></label>
            <select name="jerseySize" required>
              <option value="">Select size</option>
              <option>Child Small</option>
              <option>Child Medium</option>
              <option>Child Large</option>
              <option>Adult Small</option>
              <option>Adult Medium</option>
              <option>Adult Large</option>
            </select>
          </div>

          <div class="sd-field sd-field-full">
            <label>Select day(s) attending<span class="sd-req">*</span></label>
            <div class="sd-day-picker">
              <div class="sd-day-chip">
                <input type="checkbox" id="sd-d1" name="day_mon" />
                <label for="sd-d1"><span class="sd-d-day">Mon 22</span><span class="sd-d-name">June</span></label>
              </div>
              <div class="sd-day-chip">
                <input type="checkbox" id="sd-d2" name="day_tue" />
                <label for="sd-d2"><span class="sd-d-day">Tue 23</span><span class="sd-d-name">June</span></label>
              </div>
              <div class="sd-day-chip">
                <input type="checkbox" id="sd-d3" name="day_wed" />
                <label for="sd-d3"><span class="sd-d-day">Wed 24</span><span class="sd-d-name">June</span></label>
              </div>
            </div>
          </div>

          <div class="sd-field">
            <label>Have you done a Joner Football camp before?<span class="sd-req">*</span></label>
            <select name="previousCamp" required>
              <option value="">Select</option>
              <option value="Yes">Yes</option>
              <option value="No">No</option>
            </select>
          </div>
          <div class="sd-field">
            <label>Where did you hear about our camp?<span class="sd-req">*</span></label>
            <select name="heardAboutCamp" required>
              <option value="">Select</option>
              <option>Instagram</option>
              <option>Facebook</option>
              <option>Google</option>
              <option>YouTube</option>
              <option>Email</option>
              <option>Friend / word of mouth</option>
              <option>Previous Joner player</option>
              <option>Coach / club</option>
              <option>Other</option>
            </select>
          </div>

          <label class="sd-agree">
            <input type="checkbox" name="agreementAccepted" required />
            <span>I have read and agree to the website <a href="/terms" target="_blank" rel="noopener">training agreement</a>.</span>
          </label>

          <p class="sd-form-error" id="sdFormError" role="alert"></p>

          <div class="sd-form-submit">
            <button type="submit" class="btn-red" data-motion-hover="lift">
              <span class="sd-submit-label">Register interest</span>
            </button>
          </div>
        </div>
      </form>
    </div>
  </section>

  <!-- ============ 05 FAQ ============ -->
  <section class="sd-faq">
    <div class="sd-wrap">
      <div class="sd-section-head" data-motion="fade-up">
        <span class="sd-section-eyebrow">FAQ</span>
        <h2 class="sd-h2">Frequently asked <span class="sd-hook">questions</span>.</h2>
        <span class="sd-rule"></span>
      </div>
      <div class="sd-faq-list" data-motion-stagger data-motion-stagger-step="0.05">
        {faqs.map((faq) => (
          <details class="sd-faq-item" data-motion-stagger-child>
            <summary>
              <span>{faq.q}</span>
              <span class="sd-faq-toggle" aria-hidden="true">+</span>
            </summary>
            <div class="sd-faq-answer">
              {faq.a ? (
                <ul>{faq.a.map((item) => <li>{item}</li>)}</ul>
              ) : (
                <p>{faq.text}</p>
              )}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <section class="sd-final-cta">
    <div class="sd-final-cta-bg" aria-hidden="true"></div>
    <div class="sd-wrap">
      <h2 class="sd-h2 sd-final-h2" data-motion="fade-up">San Diego. <span class="sd-hook">June 2026.</span><br/>Don't miss it.</h2>
      <p data-motion="fade-up" data-motion-delay="0.1">Limited spots available. Register your interest now and we'll be in touch.</p>
      <a class="btn-red" href="#register" data-motion="fade-up" data-motion-delay="0.2" data-motion-hover="lift">
        Register now
      </a>
    </div>
  </section>

  <!-- ============ STICKY MOBILE CTA ============ -->
  <div class="sd-mobile-cta">
    <a class="btn-red w-full" href="#register">
      Register interest
    </a>
  </div>

  </div>

  <style>
    @font-face {
      font-family: 'Kanit';
      font-style: italic;
      font-weight: 600;
      font-display: swap;
      src: url('/fonts/Kanit-SemiBoldItalic.ttf') format('truetype');
    }
    @font-face {
      font-family: 'Kanit';
      font-style: italic;
      font-weight: 900;
      font-display: swap;
      src: url('/fonts/Kanit-BlackItalic.ttf') format('truetype');
    }

    .sd-page {
      --jf-red: #CC0000;
      --jf-red-hover: #B30000;
      --font-display: 'Kanit', 'Impact', 'Arial Narrow Bold', sans-serif;
      --font-body: 'DM Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
      --ease-out: cubic-bezier(.2,.7,.2,1);
      background: #000;
      color: #fff;
      font-family: var(--font-body);
      line-height: 1.55;
      overflow-x: hidden;
      padding-bottom: 0;
    }
    .sd-page * { box-sizing: border-box; }
    .sd-page img { display: block; max-width: 100%; }
    .sd-page h1, .sd-page h2 {
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      line-height: 0.92;
      margin: 0;
    }
    .sd-page .sd-hook { color: var(--jf-red); }
    .sd-wrap { max-width: 1280px; margin: 0 auto; padding: 0 24px; }
    @media (max-width: 640px) { .sd-wrap { padding: 0 20px; } }

    /* ===== HERO ===== */
    .sd-hero {
      position: relative;
      min-height: 92dvh;
      display: flex; align-items: flex-end;
      overflow: hidden;
      padding: 120px 0 56px;
      background: linear-gradient(135deg, #0a0a0a 0%, #1a0000 50%, #0a0a0a 100%);
    }
    .sd-hero-overlay {
      position: absolute; inset: 0;
      background: radial-gradient(ellipse at 30% 80%, rgba(204,0,0,0.15) 0%, transparent 60%);
    }
    .sd-hero-content { position: relative; width: 100%; }
    .sd-eyebrow {
      display: inline-flex; align-items: center; gap: 10px;
      padding: 8px 14px;
      background: rgba(204,0,0,0.15);
      border: 1px solid rgba(204,0,0,0.6);
      color: #fff;
      font-family: var(--font-display); font-style: italic; font-weight: 600;
      font-size: 12px; text-transform: uppercase; letter-spacing: 0.18em;
    }
    .sd-pulse {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--jf-red); box-shadow: 0 0 10px rgba(204,0,0,0.9);
      animation: sdPulse 1.6s var(--ease-out) infinite;
    }
    @keyframes sdPulse { 0%,100% { opacity: 1 } 50% { opacity: 0.4 } }

    .sd-h1 {
      font-size: clamp(3.2rem, 11vw, 8rem);
      line-height: 0.88;
      margin: 18px 0 0;
      max-width: 900px;
    }
    .sd-h1-small {
      display: block;
      font-size: clamp(1.4rem, 3.4vw, 2.2rem);
      line-height: 1.05;
      margin-top: 14px;
    }
    .sd-hero-cta { margin-top: 36px; display: flex; flex-wrap: wrap; gap: 14px; }
    @media (max-width: 640px) {
      .sd-hero { min-height: 88dvh; padding: 96px 0 44px; }
    }

    /* ===== SECTION HEAD ===== */
    .sd-section-head {
      display: flex; flex-direction: column; gap: 14px;
      margin-bottom: 48px;
    }
    .sd-section-eyebrow {
      font-family: var(--font-display); font-style: italic; font-weight: 600;
      font-size: 13px; letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--jf-red);
    }
    .sd-h2 {
      font-size: clamp(2.2rem, 5vw, 3.6rem);
      line-height: 1; margin: 0;
      max-width: 900px;
    }
    .sd-rule { width: 64px; height: 3px; background: var(--jf-red); margin-top: 4px; }

    /* ===== INFO ===== */
    .sd-info { background: #fff; color: #000; padding: 72px 0; }
    .sd-info .sd-h2 { color: #000; }
    .sd-info .sd-section-head { margin-bottom: 34px; }
    .sd-info-layout {
      display: grid;
      grid-template-columns: 1fr;
      gap: 32px;
      align-items: start;
    }
    .sd-info-left { min-width: 0; }
    .sd-info-list {
      list-style: none; padding: 0; margin: 0;
      display: grid; gap: 22px;
    }
    .sd-info-item {
      border-top: 1px solid rgba(0,0,0,0.12);
      padding-top: 16px;
    }
    .sd-info-item:first-child { border-top: 0; padding-top: 0; }
    .sd-info-item-head {
      display: flex; align-items: center; gap: 10px;
      color: var(--jf-red);
    }
    .sd-info-item-ico { display: inline-flex; }
    .sd-info-item-ico svg { width: 18px; height: 18px; }
    .sd-info-item-label {
      font-family: var(--font-display); font-style: italic; font-weight: 600;
      font-size: 13px; letter-spacing: 0.22em; text-transform: uppercase;
    }
    .sd-info-item-value {
      margin-top: 6px;
      font-family: var(--font-display); font-style: italic; font-weight: 900;
      text-transform: uppercase; letter-spacing: 0.02em;
      font-size: clamp(1.7rem, 3.2vw, 2.6rem);
      line-height: 1.02;
      color: #000;
    }
    .sd-info-item-sub {
      margin-top: 6px;
      font-family: var(--font-body);
      font-size: 13px; line-height: 1.5;
      color: rgba(0,0,0,0.6);
    }

    /* ===== BULLETS ===== */
    .sd-bullets {
      position: relative; overflow: hidden;
      min-height: 600px;
      display: flex; align-items: center;
      padding: 100px 0;
      background: #0a0a0a;
    }
    .sd-bullets-bg {
      position: absolute; inset: 0;
      background: linear-gradient(135deg, rgba(204,0,0,0.06) 0%, transparent 50%);
    }
    .sd-bullets-content { position: relative; width: 100%; }
    .sd-bullets-list {
      list-style: none; padding: 0; margin: 36px 0 0;
      display: grid; gap: 14px;
      grid-template-columns: 1fr;
      max-width: 720px;
    }
    .sd-bullets-list li {
      display: flex; align-items: center; gap: 16px;
      padding: 14px 18px;
      background: rgba(0,0,0,0.55);
      border: 1px solid rgba(255,255,255,0.12);
      border-left: 3px solid var(--jf-red);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      font-family: var(--font-display); font-style: italic; font-weight: 900;
      text-transform: uppercase; letter-spacing: 0.04em;
      font-size: clamp(0.95rem, 1.6vw, 1.15rem);
      line-height: 1.15;
      color: #fff;
    }
    .sd-bullet-ico {
      flex-shrink: 0;
      width: 32px; height: 32px; border-radius: 50%;
      border: 2px solid var(--jf-red);
      display: flex; align-items: center; justify-content: center;
      color: var(--jf-red);
    }
    .sd-bullet-ico svg { width: 16px; height: 16px; }
    .sd-bullets-cta { margin-top: 36px; }

    /* ===== FORM ===== */
    .sd-form-section {
      background: #000; color: #fff;
      padding: 96px 0;
      position: relative;
      border-top: 3px solid var(--jf-red);
    }
    .sd-form-section .sd-wrap { position: relative; }
    .sd-form-lede {
      margin: 10px 0 0;
      max-width: 580px;
      color: rgba(255,255,255,0.7);
      font-size: 15px; line-height: 1.55;
    }
    .sd-form-shell {
      background: #0a0a0a;
      border: 1px solid rgba(255,255,255,0.14);
      padding: 40px 32px;
      margin-top: 40px;
    }
    .sd-form-grid { display: grid; gap: 20px; grid-template-columns: 1fr 1fr; }
    .sd-field { display: flex; flex-direction: column; gap: 8px; }
    .sd-field-full { grid-column: 1 / -1; }
    .sd-field label {
      font-family: var(--font-display); font-style: italic; font-weight: 600;
      font-size: 12px; letter-spacing: 0.22em; text-transform: uppercase;
      color: rgba(255,255,255,0.7);
    }
    .sd-req { color: var(--jf-red); margin-left: 4px; }
    .sd-field input, .sd-field select, .sd-field textarea {
      background: #000;
      color: #fff;
      border: 2px solid rgba(255,255,255,0.18);
      border-radius: 2px;
      padding: 14px 16px;
      font-family: var(--font-body); font-size: 16px;
      transition: border-color 120ms;
      appearance: none; -webkit-appearance: none;
      width: 100%;
    }
    .sd-field input:focus, .sd-field select:focus, .sd-field textarea:focus {
      outline: none;
      border-color: var(--jf-red);
    }
    .sd-field select {
      background-image:
        linear-gradient(45deg, transparent 50%, #fff 50%),
        linear-gradient(135deg, #fff 50%, transparent 50%);
      background-position: calc(100% - 18px) 22px, calc(100% - 12px) 22px;
      background-size: 6px 6px, 6px 6px;
      background-repeat: no-repeat;
      padding-right: 36px;
    }

    .sd-day-picker {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px;
    }
    .sd-day-chip input { display: none; }
    .sd-day-chip label {
      display: flex; flex-direction: column; align-items: center; gap: 4px;
      padding: 16px 12px;
      border: 2px solid rgba(255,255,255,0.18);
      cursor: pointer;
      transition: all 120ms;
      text-align: center;
      letter-spacing: normal;
      color: #fff;
    }
    .sd-d-day {
      font-family: var(--font-display); font-style: italic; font-weight: 900;
      font-size: 22px; line-height: 1;
    }
    .sd-d-name {
      font-family: var(--font-display); font-style: italic; font-weight: 600;
      font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
      color: rgba(255,255,255,0.6);
    }
    .sd-day-chip input:checked + label {
      border-color: var(--jf-red);
      background: rgba(204,0,0,0.12);
    }
    .sd-day-chip input:checked + label .sd-d-name { color: var(--jf-red); }

    .sd-agree {
      grid-column: 1 / -1;
      display: flex; gap: 12px; align-items: flex-start;
      font-family: var(--font-body); font-size: 14px; line-height: 1.5;
      color: rgba(255,255,255,0.8);
      letter-spacing: normal;
    }
    .sd-agree input { width: 20px; height: 20px; margin-top: 2px; accent-color: var(--jf-red); flex-shrink: 0; }
    .sd-agree a { color: var(--jf-red); text-decoration: underline; }

    .sd-form-error {
      grid-column: 1 / -1;
      min-height: 0;
      margin: 0;
      color: #ff7676;
      font-size: 14px;
      font-family: var(--font-body);
    }
    .sd-form-error:empty { display: none; }

    .sd-form-submit { grid-column: 1 / -1; display: flex; justify-content: center; margin-top: 12px; }

    @media (max-width: 640px) {
      .sd-form-shell { padding: 28px 20px; }
      .sd-form-grid { grid-template-columns: 1fr; }
      .sd-day-picker { grid-template-columns: 1fr; }
    }

    /* ===== FAQ ===== */
    .sd-faq { background: #fff; color: #000; padding: 96px 0; }
    .sd-faq .sd-h2 { color: #000; }
    .sd-faq-list { margin-top: 36px; }
    .sd-faq-item { border-top: 1px solid rgba(0,0,0,0.12); }
    .sd-faq-item:last-child { border-bottom: 1px solid rgba(0,0,0,0.12); }
    .sd-faq-item summary {
      list-style: none;
      cursor: pointer;
      padding: 22px 0;
      display: flex; align-items: center; justify-content: space-between; gap: 24px;
      font-family: var(--font-display); font-style: italic; font-weight: 900;
      text-transform: uppercase; letter-spacing: 0.04em;
      font-size: clamp(1.05rem, 2vw, 1.4rem);
      line-height: 1.15;
      color: #000;
    }
    .sd-faq-item summary::-webkit-details-marker { display: none; }
    .sd-faq-toggle {
      flex-shrink: 0;
      width: 36px; height: 36px;
      border: 2px solid #000;
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-display); font-weight: 900; font-style: italic;
      font-size: 22px; line-height: 1;
      transition: all 200ms var(--ease-out);
    }
    .sd-faq-item[open] .sd-faq-toggle {
      background: var(--jf-red); border-color: var(--jf-red); color: #fff;
      transform: rotate(45deg);
    }
    .sd-faq-answer {
      padding: 0 0 26px 0;
      max-width: 820px;
      font-family: var(--font-body); font-size: 16px; line-height: 1.6;
      color: rgba(0,0,0,0.78);
    }
    .sd-faq-answer ul { margin: 8px 0 0 18px; padding: 0; }
    .sd-faq-answer li { margin: 4px 0; }
    .sd-faq-answer p { margin: 0; }

    /* ===== FINAL CTA ===== */
    .sd-final-cta {
      position: relative;
      padding: 120px 0;
      overflow: hidden;
      text-align: center;
      background: #0a0a0a;
    }
    .sd-final-cta-bg {
      position: absolute; inset: 0;
      background: radial-gradient(ellipse at 50% 50%, rgba(204,0,0,0.08) 0%, transparent 60%);
    }
    .sd-final-cta .sd-wrap { position: relative; }
    .sd-final-h2 {
      font-size: clamp(2.4rem, 6vw, 5rem);
      line-height: 0.95;
      max-width: 900px; margin: 0 auto 22px;
    }
    .sd-final-cta p {
      max-width: 560px; margin: 0 auto 36px;
      font-size: 17px; color: rgba(255,255,255,0.85); line-height: 1.55;
    }

    /* ===== STICKY MOBILE CTA ===== */
    .sd-mobile-cta {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
      padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
      background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.95) 30%);
      display: none;
      opacity: 0;
      transform: translateY(110%);
      pointer-events: none;
      transition: opacity 280ms ease, transform 360ms cubic-bezier(0.32, 0.72, 0, 1);
    }
    .sd-mobile-cta.is-revealed { opacity: 1; transform: translateY(0); pointer-events: auto; }
    @media (max-width: 1024px), (hover: none) and (pointer: coarse) {
      .sd-mobile-cta { display: block; }
      .sd-page { padding-bottom: 90px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .sd-pulse { animation: none; }
    }
  </style>

  <script>
    import '../../scripts/home-motion'

    /* ========== Form submit ========== */
    const form = document.getElementById('sdForm') as HTMLFormElement | null
    const errEl = document.getElementById('sdFormError')
    if (form) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault()
        if (errEl) errEl.textContent = ''
        const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null
        const labelEl = submitBtn?.querySelector('.sd-submit-label') as HTMLElement | null
        const originalLabel = labelEl?.textContent || 'Register interest'

        const data = new FormData(form)
        const days = [
          data.get('day_mon') ? 'Mon 22 June' : '',
          data.get('day_tue') ? 'Tue 23 June' : '',
          data.get('day_wed') ? 'Wed 24 June' : '',
        ].filter(Boolean).join(', ')

        const payload = {
          camp: data.get('camp') || 'San Diego Camp June 2026',
          destination: data.get('destination') || 'San Diego June 2026',
          brevoListId: Number(data.get('brevoListId') || 2),
          brevoListIds: String(data.get('brevoListIds') || '2'),
          source: data.get('source') || 'san-diego-camp-2026-landing',
          previousCamp: data.get('previousCamp') || '',
          heardAboutCamp: data.get('heardAboutCamp') || '',
          playerFirstName: data.get('playerFirstName') || '',
          playerSurname: data.get('playerSurname') || '',
          email: data.get('email') || '',
          age: data.get('age') || '',
          mobile: data.get('mobile') || '',
          jerseySize: data.get('jerseySize') || '',
          numberOfDays: days ? `${days.split(',').length} Day(s)` : '',
          extraInfo: days ? `Days attending: ${days}` : '',
          paymentMethod: 'N/A - Interest Only',
          paymentLink: '',
          paymentStatus: 'interest_only',
          agreementAccepted: !!data.get('agreementAccepted'),
        }

        if (!payload.playerFirstName || !payload.playerSurname || !payload.email || !payload.age || !payload.mobile || !payload.jerseySize || !payload.previousCamp || !payload.heardAboutCamp || !payload.agreementAccepted) {
          if (errEl) errEl.textContent = 'Please fill in every required field.'
          return
        }
        if (!days) {
          if (errEl) errEl.textContent = 'Please select at least one day.'
          return
        }

        if (submitBtn && labelEl) {
          submitBtn.disabled = true
          labelEl.textContent = 'Sending...'
        }

        try {
          const grecaptcha = (window as any).JonerRecaptcha
          ;(payload as any).recaptchaToken = grecaptcha ? await grecaptcha.getToken('camp_registration') : ''

          const res = await fetch('/api/camp-registration', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          })
          const json = await res.json()
          if (!res.ok || !json.success) throw new Error(json?.error || 'Could not save your registration. Please try again.')

          if (typeof (window as any).JonerTracking?.trackEvent === 'function') {
            (window as any).JonerTracking.trackEvent('Lead', {
              user_data: { email: payload.email },
              custom_data: { form_name: 'san-diego-camp-2026', list_id: 2, lead_type: 'camp_interest' },
            })
          }

          form.innerHTML = `
            <div style="padding:18px 0;text-align:center;">
              <p style="color:#4ade80;font-size:18px;font-family:var(--font-display);font-style:italic;font-weight:900;text-transform:uppercase;letter-spacing:0.06em;margin:0 0 12px;">You're registered!</p>
              <p style="color:rgba(255,255,255,0.78);font-size:15px;line-height:1.55;margin:0 0 20px;">We've got your details. We'll be in touch with pricing and payment info closer to the date. Check your email for confirmation.</p>
            </div>`
        } catch (err) {
          if (errEl) errEl.textContent = (err as Error).message || 'Something went wrong. Please try again.'
          if (submitBtn && labelEl) {
            submitBtn.disabled = false
            labelEl.textContent = originalLabel
          }
        }
      })
    }

    /* Sticky bottom CTA */
    ;(function () {
      const heroEl = document.querySelector('.sd-hero')
      const cta = document.querySelector('.sd-mobile-cta')
      if (!heroEl || !cta || !('IntersectionObserver' in window)) return
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          cta.classList.toggle('is-revealed', !entry.isIntersecting)
        })
      }, { threshold: 0, rootMargin: '-40px 0px 0px 0px' })
      io.observe(heroEl)
    })()
  </script>
</BaseLayout>
