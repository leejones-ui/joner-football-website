---
import BaseLayout from '../../layouts/BaseLayout.astro'

const title = 'San Diego | Camp | June 2026 | Joner Football'
const description = 'Request your spot for the Joner Football San Diego Camp, June 22 to 24, 2026 at 4S Ranch Sports Park. Limited availability.'
const canonical = 'https://jonerfootball.com/camps/san-diego-june/'

const infoCells = [
  {
    label: 'When',
    value: 'Mon 22 to Wed 24<br/>June 2026',
    sub: '3 day elite camp.',
    icon: 'calendar',
  },
  {
    label: 'Where',
    value: '4S Ranch Sports Park',
    sub: '16118 4S Ranch Pkwy, San Diego, CA 92127, United States',
    icon: 'pin',
  },
  {
    label: 'Time',
    value: '7am to 9am',
    sub: 'Three mornings of focused Joner Football coaching.',
    icon: 'clock',
  },
  {
    label: 'Camp price',
    value: '$250 for 3 days',
    sub: 'All payments are handled through Obed Gamino at Leon FC. Fill in the form below.',
    icon: 'shield',
  },
  {
    label: 'Small group training',
    value: 'Request only',
    sub: 'Monday night 22nd and Tuesday night 23rd through Obed.',
    icon: 'list',
  },
]

const carouselImages = [
  '/images/camps/joner-camps/hero-lee-pointing.jpg',
  '/images/camps/joner-camps/san-diego-leon-fc-group.jpg',
  '/images/camps/joner-camps/red-shirt-action.jpg',
  '/images/camps/joner-camps/players-field.jpg',
  '/images/camps/joner-camps/lee-coaching-group.jpg',
  '/images/camps/joner-camps/lee-with-players.jpg',
  '/images/camps/joner-camps/camp-team-photo.jpg',
]

const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: 'Joner Football San Diego Camp June 2026',
  startDate: '2026-06-22T07:00-07:00',
  endDate: '2026-06-24T09:00-07:00',
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: '4S Ranch Sports Park',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '16118 4S Ranch Pkwy',
      addressLocality: 'San Diego',
      addressRegion: 'CA',
      postalCode: '92127',
      addressCountry: 'US',
    },
  },
  organizer: { '@type': 'Organization', name: 'Joner Football', url: 'https://jonerfootball.com' },
  image: 'https://jonerfootball.com/images/camps/joner-camps/hero-lee-pointing.jpg',
  description,
  offers: [{
    '@type': 'Offer',
    name: 'San Diego Camp - 3 Days',
    price: '250',
    priceCurrency: 'USD',
    availability: 'https://schema.org/LimitedAvailability',
    url: 'https://jonerfootball.com/camps/san-diego-june/#register',
  }],
}
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage="https://jonerfootball.com/images/camps/joner-camps/hero-lee-pointing.jpg"
  schema={eventSchema}
  hideMobileAppCta
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/camps/joner-camps/hero-lee-pointing.jpg" fetchpriority="high" />
    <link rel="preload" as="font" href="/fonts/Kanit-BlackItalic.ttf" type="font/ttf" crossorigin />
  </Fragment>

  <div class="sd-page">

  <!-- ============ 01 HERO ============ -->
  <section class="sd-hero" id="top">
    <div class="sd-hero-img" aria-hidden="true"></div>
    <div class="sd-hero-overlay" aria-hidden="true"></div>
    <div class="sd-wrap sd-hero-content">
      <span class="sd-eyebrow" data-motion="fade-up"><span class="sd-pulse"></span> Limited spots available</span>
      <h1 class="sd-h1" data-motion="fade-up" data-motion-delay="0.08">
        San Diego
        <span class="sd-hook">Camp</span>
        <span class="sd-h1-small">Request your spot. Limited availability.</span>
      </h1>
      <div class="sd-hero-cta" data-motion="fade-up" data-motion-delay="0.24">
        <a class="btn-red" href="#register" data-motion-hover="lift">
          Request now
        </a>
        <a class="btn-red" href="#info" data-motion-hover="lift">
          Camp info
        </a>
      </div>
    </div>
  </section>

  <!-- ============ 02 KEY INFO ============ -->
  <section class="sd-info" id="info">
    <div class="sd-wrap">
      <div class="sd-info-layout">
        <div class="sd-info-left">
          <div class="sd-section-head" data-motion="fade-up">
            <span class="sd-section-eyebrow">Camp Details</span>
            <h2 class="sd-h2">The <span class="sd-hook">essentials</span>.<br/>Everything you need to know.</h2>
            <span class="sd-rule"></span>
          </div>

          <ul class="sd-info-list" data-motion-stagger data-motion-stagger-step="0.06">
            {infoCells.map((cell) => (
              <li class="sd-info-item" data-motion-stagger-child>
                <div class="sd-info-item-head">
                  <span class="sd-info-item-ico" aria-hidden="true">
                    {cell.icon === 'calendar' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>)}
                    {cell.icon === 'pin' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s7-7.5 7-13a7 7 0 1 0-14 0c0 5.5 7 13 7 13z"/><circle cx="12" cy="9" r="2.5"/></svg>)}
                    {cell.icon === 'clock' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>)}
                    {cell.icon === 'people' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 11a3 3 0 1 0 0-6M22 20a5 5 0 0 0-5-5"/></svg>)}
                    {cell.icon === 'shield' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 13l9 7 9-7M3 7l9 7 9-7-9-5-9 5z"/></svg>)}
                    {cell.icon === 'list' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h18M3 12h18M3 17h12"/></svg>)}
                  </span>
                  <span class="sd-info-item-label">{cell.label}</span>
                </div>
                <div class="sd-info-item-value" set:html={cell.value}></div>
                <div class="sd-info-item-sub">{cell.sub}</div>
              </li>
            ))}
          </ul>
        </div>

        <div class="sd-info-right" data-motion="fade-up">
          <div class="sd-info-carousel" data-info-carousel aria-label="Photos from Joner Football camps">
            {carouselImages.map((src, i) => (
              <img
                class:list={['sd-info-carousel-img', i === 0 && 'is-active']}
                src={src}
                alt={`Joner Football San Diego camp training photo ${i + 1}`}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
                width="900"
                height="1100"
              />
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 03 REQUEST FORM ============ -->
  <section class="sd-form-section" id="register">
    <div class="sd-wrap">
      <div class="sd-section-head" data-motion="fade-up">
        <span class="sd-section-eyebrow">Request now</span>
        <h2 class="sd-h2">Request your <span class="sd-hook">spot</span>.</h2>
        <p class="sd-form-lede">
          Choose camp, small group training, or both. Obed and Joner Football will follow up.
        </p>
        <span class="sd-rule"></span>
      </div>

      <form class="sd-form-shell" data-motion="fade-up" id="sdForm" novalidate>
        <input type="hidden" name="camp" value="San Diego Camp June 2026" />
        <input type="hidden" name="destination" value="USA San Diego June 2026" />
        <input type="hidden" name="sheetTab" value="San Diego (June)" />
        <input type="hidden" name="brevoListId" value="5" />
        <input type="hidden" name="brevoListIds" value="5" />
        <input type="hidden" name="notificationEmails" value="joner1on1info@gmail.com,Obed_gamino58@yahoo.com" />
        <input type="hidden" name="source" value="san-diego-camp-2026-landing" />
        <input type="hidden" name="numberOfDays" value="3 Days - $250" />
        <input type="hidden" name="jerseySize" value="Not required - San Diego request" />

        <div class="sd-form-grid">
          <div class="sd-field sd-field-full">
            <label>Interested in<span class="sd-req">*</span></label>
            <div class="sd-interest-grid" role="radiogroup" aria-label="Choose your interest">
              <label class="sd-choice">
                <input type="radio" name="requestType" value="Camp" required />
                <span>Camp</span>
              </label>
              <label class="sd-choice">
                <input type="radio" name="requestType" value="Small group training" required />
                <span>Small group</span>
              </label>
              <label class="sd-choice">
                <input type="radio" name="requestType" value="Camp + small group training" required />
                <span>Both</span>
              </label>
            </div>
          </div>

          <div class="sd-field">
            <label>Player first name<span class="sd-req">*</span></label>
            <input type="text" name="playerFirstName" required placeholder="e.g. Marco" />
          </div>
          <div class="sd-field">
            <label>Player last name<span class="sd-req">*</span></label>
            <input type="text" name="playerSurname" required placeholder="e.g. Rodriguez" />
          </div>
          <div class="sd-field">
            <label>Player age<span class="sd-req">*</span></label>
            <input type="number" name="age" min="8" max="18" required placeholder="8 to 18" />
          </div>
          <div class="sd-field">
            <label>Parent / guardian name<span class="sd-req">*</span></label>
            <input type="text" name="parentName" required placeholder="Your name" />
          </div>
          <div class="sd-field">
            <label>Parent / guardian email<span class="sd-req">*</span></label>
            <input type="email" name="email" required placeholder="you@email.com" />
          </div>
          <div class="sd-field">
            <label>Phone number<span class="sd-req">*</span></label>
            <input type="tel" name="mobile" required placeholder="(555) 555-1234" />
          </div>

          <div class="sd-field sd-field-full">
            <label>Small group night request</label>
            <div class="sd-night-picker">
              <div class="sd-day-chip">
                <input type="checkbox" id="sd-n1" name="night_mon" />
                <label for="sd-n1"><span class="sd-d-day">Mon 22nd</span><span class="sd-d-name">Night</span></label>
              </div>
              <div class="sd-day-chip">
                <input type="checkbox" id="sd-n2" name="night_tue" />
                <label for="sd-n2"><span class="sd-d-day">Tue 23rd</span><span class="sd-d-name">Night</span></label>
              </div>
            </div>
            <p class="sd-form-note">Small group training is request only through Obed.</p>
          </div>

          <div class="sd-field">
            <label>Have you done a Joner Football camp before?<span class="sd-req">*</span></label>
            <select name="previousCamp" required>
              <option value="">Select</option>
              <option value="Yes">Yes</option>
              <option value="No">No</option>
            </select>
          </div>
          <div class="sd-field">
            <label>Where did you hear about our camp?<span class="sd-req">*</span></label>
            <select name="heardAboutCamp" required>
              <option value="">Select</option>
              <option>Instagram</option>
              <option>Facebook</option>
              <option>Google</option>
              <option>YouTube</option>
              <option>Email</option>
              <option>Friend / word of mouth</option>
              <option>Previous Joner player</option>
              <option>Coach / club</option>
              <option>Other</option>
            </select>
          </div>
          <div class="sd-field sd-field-full">
            <label>Anything else?</label>
            <textarea name="extraInfo" rows="3" placeholder="Player level, club, or any questions."></textarea>
          </div>

          <label class="sd-agree">
            <input type="checkbox" name="agreementAccepted" required />
            <span>I have read and agree to the website <a href="/terms" target="_blank" rel="noopener">training agreement</a>.</span>
          </label>

          <p class="sd-form-error" id="sdFormError" role="alert"></p>

          <div class="sd-form-submit">
            <button type="submit" class="btn-red" data-motion-hover="lift">
              <span class="sd-submit-label">Request now</span>
            </button>
          </div>
        </div>
      </form>
    </div>
  </section>

  <!-- ============ STICKY MOBILE CTA ============ -->
  <div class="sd-mobile-cta">
    <a class="btn-red w-full" href="#register">
      Request now
    </a>
  </div>

  </div>

  <style>
    @font-face {
      font-family: 'Kanit';
      font-style: italic;
      font-weight: 600;
      font-display: swap;
      src: url('/fonts/Kanit-SemiBoldItalic.ttf') format('truetype');
    }
    @font-face {
      font-family: 'Kanit';
      font-style: italic;
      font-weight: 900;
      font-display: swap;
      src: url('/fonts/Kanit-BlackItalic.ttf') format('truetype');
    }

    .sd-page {
      --jf-red: #CC0000;
      --jf-red-hover: #B30000;
      --font-display: 'Kanit', 'Impact', 'Arial Narrow Bold', sans-serif;
      --font-body: 'DM Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
      --ease-out: cubic-bezier(.2,.7,.2,1);
      background: #000;
      color: #fff;
      font-family: var(--font-body);
      line-height: 1.55;
      overflow-x: hidden;
      padding-bottom: 0;
    }
    .sd-page * { box-sizing: border-box; }
    .sd-page img { display: block; max-width: 100%; }
    .sd-page h1, .sd-page h2 {
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      line-height: 0.92;
      margin: 0;
    }
    .sd-page .sd-hook { color: var(--jf-red); }
    .sd-wrap { max-width: 1280px; margin: 0 auto; padding: 0 24px; }
    @media (max-width: 640px) { .sd-wrap { padding: 0 20px; } }

    /* ===== HERO ===== */
    .sd-hero {
      position: relative;
      min-height: 92dvh;
      display: flex; align-items: flex-end;
      overflow: hidden;
      padding: 120px 0 56px;
      background: #050505;
    }
    .sd-hero-img {
      position: absolute; inset: 0;
      background-image: url('/images/camps/joner-camps/hero-lee-pointing.jpg');
      background-size: cover;
      background-position: center 34%;
      transform: scale(1.02);
    }
    .sd-hero-overlay {
      position: absolute; inset: 0;
      background:
        linear-gradient(90deg, rgba(0,0,0,0.88) 0%, rgba(0,0,0,0.64) 43%, rgba(0,0,0,0.2) 100%),
        linear-gradient(0deg, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.16) 56%, rgba(0,0,0,0.58) 100%);
    }
    .sd-hero-content { position: relative; width: 100%; }
    .sd-eyebrow {
      display: inline-flex; align-items: center; gap: 10px;
      padding: 8px 14px;
      background: rgba(204,0,0,0.15);
      border: 1px solid rgba(204,0,0,0.6);
      color: #fff;
      font-family: var(--font-display); font-style: italic; font-weight: 600;
      font-size: 12px; text-transform: uppercase; letter-spacing: 0.18em;
    }
    .sd-pulse {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--jf-red); box-shadow: 0 0 10px rgba(204,0,0,0.9);
      animation: sdPulse 1.6s var(--ease-out) infinite;
    }
    @keyframes sdPulse { 0%,100% { opacity: 1 } 50% { opacity: 0.4 } }

    .sd-h1 {
      font-size: clamp(3.2rem, 11vw, 8rem);
      line-height: 0.88;
      margin: 18px 0 0;
      max-width: 900px;
    }
    .sd-h1-small {
      display: block;
      font-size: clamp(1.4rem, 3.4vw, 2.2rem);
      line-height: 1.05;
      margin-top: 14px;
    }
    .sd-hero-cta { margin-top: 36px; display: flex; flex-wrap: wrap; gap: 14px; }
    @media (max-width: 640px) {
      .sd-hero { min-height: 88dvh; padding: 96px 0 44px; }
      .sd-hero-img { background-position: 58% center; }
    }

    /* ===== SECTION HEAD ===== */
    .sd-section-head {
      display: flex; flex-direction: column; gap: 14px;
      margin-bottom: 48px;
    }
    .sd-section-eyebrow {
      font-family: var(--font-display); font-style: italic; font-weight: 600;
      font-size: 13px; letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--jf-red);
    }
    .sd-h2 {
      font-size: clamp(2.2rem, 5vw, 3.6rem);
      line-height: 1; margin: 0;
      max-width: 900px;
    }
    .sd-rule { width: 64px; height: 3px; background: var(--jf-red); margin-top: 4px; }

    /* ===== INFO ===== */
    .sd-info { background: #fff; color: #000; padding: 72px 0; }
    .sd-info .sd-h2 { color: #000; }
    .sd-info .sd-section-head { margin-bottom: 34px; }
    .sd-info-layout {
      display: grid;
      grid-template-columns: 1fr;
      gap: 32px;
      align-items: start;
    }
    .sd-info-left { min-width: 0; }
    .sd-info-right { min-width: 0; }
    .sd-info-carousel {
      position: relative;
      width: 100%;
      aspect-ratio: 4 / 5;
      overflow: hidden;
      background: #0a0a0a;
      box-shadow: 0 24px 60px rgba(0,0,0,0.18);
    }
    .sd-info-carousel-img {
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      object-fit: cover;
      object-position: center;
      opacity: 0;
      transition: none;
    }
    .sd-info-carousel-img.is-active { opacity: 1; }
    @media (min-width: 900px) {
      .sd-info-layout {
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
        gap: 40px;
        align-items: start;
      }
      .sd-info-carousel { aspect-ratio: 4 / 5; }
    }
    @media (max-width: 640px) {
      .sd-info-carousel { aspect-ratio: 4 / 3; }
    }
    @media (prefers-reduced-motion: reduce) {
      .sd-info-carousel-img { transition: opacity 1ms; }
    }
    .sd-info-list {
      list-style: none; padding: 0; margin: 0;
      display: grid; gap: 22px;
    }
    .sd-info-item {
      border-top: 1px solid rgba(0,0,0,0.12);
      padding-top: 16px;
    }
    .sd-info-item:first-child { border-top: 0; padding-top: 0; }
    .sd-info-item-head {
      display: flex; align-items: center; gap: 10px;
      color: var(--jf-red);
    }
    .sd-info-item-ico { display: inline-flex; }
    .sd-info-item-ico svg { width: 18px; height: 18px; }
    .sd-info-item-label {
      font-family: var(--font-display); font-style: italic; font-weight: 600;
      font-size: 13px; letter-spacing: 0.22em; text-transform: uppercase;
    }
    .sd-info-item-value {
      margin-top: 6px;
      font-family: var(--font-display); font-style: italic; font-weight: 900;
      text-transform: uppercase; letter-spacing: 0.02em;
      font-size: clamp(1.7rem, 3.2vw, 2.6rem);
      line-height: 1.02;
      color: #000;
    }
    .sd-info-item-sub {
      margin-top: 6px;
      font-family: var(--font-body);
      font-size: 13px; line-height: 1.5;
      color: rgba(0,0,0,0.6);
    }

    /* ===== FORM ===== */
    .sd-form-section {
      background: #000; color: #fff;
      padding: 96px 0;
      position: relative;
      border-top: 3px solid var(--jf-red);
    }
    .sd-form-section .sd-wrap { position: relative; }
    .sd-form-lede {
      margin: 10px 0 0;
      max-width: 580px;
      color: rgba(255,255,255,0.7);
      font-size: 15px; line-height: 1.55;
    }
    .sd-form-shell {
      background: #0a0a0a;
      border: 1px solid rgba(255,255,255,0.14);
      padding: 40px 32px;
      margin-top: 40px;
    }
    .sd-form-grid { display: grid; gap: 20px; grid-template-columns: 1fr 1fr; }
    .sd-field { display: flex; flex-direction: column; gap: 8px; }
    .sd-field-full { grid-column: 1 / -1; }
    .sd-field label {
      font-family: var(--font-display); font-style: italic; font-weight: 600;
      font-size: 12px; letter-spacing: 0.22em; text-transform: uppercase;
      color: rgba(255,255,255,0.7);
    }
    .sd-req { color: var(--jf-red); margin-left: 4px; }
    .sd-field input, .sd-field select, .sd-field textarea {
      background: #000;
      color: #fff;
      border: 2px solid rgba(255,255,255,0.18);
      border-radius: 2px;
      padding: 14px 16px;
      font-family: var(--font-body); font-size: 16px;
      transition: border-color 120ms;
      appearance: none; -webkit-appearance: none;
      width: 100%;
    }
    .sd-field input:focus, .sd-field select:focus, .sd-field textarea:focus {
      outline: none;
      border-color: var(--jf-red);
    }
    .sd-field select {
      background-image:
        linear-gradient(45deg, transparent 50%, #fff 50%),
        linear-gradient(135deg, #fff 50%, transparent 50%);
      background-position: calc(100% - 18px) 22px, calc(100% - 12px) 22px;
      background-size: 6px 6px, 6px 6px;
      background-repeat: no-repeat;
      padding-right: 36px;
    }

    .sd-interest-grid,
    .sd-night-picker {
      display: grid;
      gap: 10px;
    }
    .sd-interest-grid { grid-template-columns: repeat(3, 1fr); }
    .sd-night-picker { grid-template-columns: repeat(2, 1fr); }
    .sd-choice {
      position: relative;
      display: block;
      cursor: pointer;
    }
    .sd-choice input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }
    .sd-choice span {
      min-height: 58px;
      border: 2px solid rgba(255,255,255,0.18);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 14px 12px;
      color: #fff;
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 900;
      letter-spacing: 0.04em;
      line-height: 1.05;
      text-align: center;
      text-transform: uppercase;
      transition: border-color 120ms, background 120ms, color 120ms;
    }
    .sd-choice input:checked + span,
    .sd-choice:focus-within span {
      border-color: var(--jf-red);
      background: rgba(204,0,0,0.16);
      color: #fff;
    }
    .sd-day-chip input { display: none; }
    .sd-day-chip label {
      display: flex; flex-direction: column; align-items: center; gap: 4px;
      padding: 16px 12px;
      border: 2px solid rgba(255,255,255,0.18);
      cursor: pointer;
      transition: all 120ms;
      text-align: center;
      letter-spacing: normal;
      color: #fff;
    }
    .sd-d-day {
      font-family: var(--font-display); font-style: italic; font-weight: 900;
      font-size: 22px; line-height: 1;
    }
    .sd-d-name {
      font-family: var(--font-display); font-style: italic; font-weight: 600;
      font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
      color: rgba(255,255,255,0.6);
    }
    .sd-day-chip input:checked + label {
      border-color: var(--jf-red);
      background: rgba(204,0,0,0.12);
    }
    .sd-day-chip input:checked + label .sd-d-name { color: var(--jf-red); }
    .sd-form-note {
      margin: 8px 0 0;
      color: rgba(255,255,255,0.56);
      font-size: 13px;
      line-height: 1.45;
    }

    .sd-agree {
      grid-column: 1 / -1;
      display: flex; gap: 12px; align-items: flex-start;
      font-family: var(--font-body); font-size: 14px; line-height: 1.5;
      color: rgba(255,255,255,0.8);
      letter-spacing: normal;
    }
    .sd-agree input { width: 20px; height: 20px; margin-top: 2px; accent-color: var(--jf-red); flex-shrink: 0; }
    .sd-agree a { color: var(--jf-red); text-decoration: underline; }

    .sd-form-error {
      grid-column: 1 / -1;
      min-height: 0;
      margin: 0;
      color: #ff7676;
      font-size: 14px;
      font-family: var(--font-body);
    }
    .sd-form-error:empty { display: none; }

    .sd-form-submit { grid-column: 1 / -1; display: flex; justify-content: center; margin-top: 12px; }

    @media (max-width: 640px) {
      .sd-form-shell { padding: 28px 20px; }
      .sd-form-grid { grid-template-columns: 1fr; }
      .sd-interest-grid,
      .sd-night-picker { grid-template-columns: 1fr; }
    }

    /* ===== STICKY MOBILE CTA ===== */
    .sd-mobile-cta {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
      padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
      background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.95) 30%);
      display: none;
      opacity: 0;
      transform: translateY(110%);
      pointer-events: none;
      transition: opacity 280ms ease, transform 360ms cubic-bezier(0.32, 0.72, 0, 1);
    }
    .sd-mobile-cta.is-revealed { opacity: 1; transform: translateY(0); pointer-events: auto; }
    @media (max-width: 1024px), (hover: none) and (pointer: coarse) {
      .sd-mobile-cta { display: block; }
      .sd-page { padding-bottom: 90px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .sd-pulse { animation: none; }
    }
  </style>

  <script>
    import '../../scripts/home-motion'
    import { animate } from 'framer-motion/dom'

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const EASE = [0.2, 0.7, 0.2, 1]

    /* ========== Right-side info carousel ========== */
    const infoCarousel = document.querySelector<HTMLElement>('[data-info-carousel]')
    if (infoCarousel) {
      const imgs = Array.from(infoCarousel.querySelectorAll<HTMLElement>('.sd-info-carousel-img'))
      if (imgs.length > 1) {
        imgs.forEach((img, i) => {
          img.style.opacity = i === 0 ? '1' : '0'
          img.classList.toggle('is-active', i === 0)
        })
        let cIdx = 0
        const tick = () => {
          const prev = imgs[cIdx]
          cIdx = (cIdx + 1) % imgs.length
          const next = imgs[cIdx]
          if (reduced) {
            prev.style.opacity = '0'
            prev.classList.remove('is-active')
            next.style.opacity = '1'
            next.classList.add('is-active')
            return
          }
          animate(prev, { opacity: 0 }, { duration: 0.55, ease: EASE })
          animate(next, { opacity: 1 }, { duration: 0.55, ease: EASE })
          prev.classList.remove('is-active')
          next.classList.add('is-active')
        }
        window.setInterval(tick, 1500)
      }
    }

    /* ========== Form submit ========== */
    const form = document.getElementById('sdForm') as HTMLFormElement | null
    const errEl = document.getElementById('sdFormError')
    if (form) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault()
        if (errEl) errEl.textContent = ''
        const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null
        const labelEl = submitBtn?.querySelector('.sd-submit-label') as HTMLElement | null
        const originalLabel = labelEl?.textContent || 'Request now'

        const data = new FormData(form)
        const requestNights = [
          data.get('night_mon') ? 'Monday night 22nd' : '',
          data.get('night_tue') ? 'Tuesday night 23rd' : '',
        ].filter(Boolean).join(', ')
        const notes = String(data.get('extraInfo') || '').trim()

        const payload = {
          camp: data.get('camp') || 'San Diego Camp June 2026',
          destination: data.get('destination') || 'USA San Diego June 2026',
          sheetTab: data.get('sheetTab') || 'San Diego (June)',
          brevoListId: Number(data.get('brevoListId') || 5),
          brevoListIds: String(data.get('brevoListIds') || '5'),
          notificationEmails: data.get('notificationEmails') || 'joner1on1info@gmail.com,Obed_gamino58@yahoo.com',
          source: data.get('source') || 'san-diego-camp-2026-landing',
          requestOnly: true,
          sendImmediateNotification: true,
          sendInterestReply: true,
          requestType: data.get('requestType') || '',
          requestNights,
          previousCamp: data.get('previousCamp') || '',
          heardAboutCamp: data.get('heardAboutCamp') || '',
          playerFirstName: data.get('playerFirstName') || '',
          playerSurname: data.get('playerSurname') || '',
          parentName: data.get('parentName') || '',
          email: data.get('email') || '',
          age: data.get('age') || '',
          mobile: data.get('mobile') || '',
          jerseySize: data.get('jerseySize') || 'Not required - San Diego request',
          numberOfDays: data.get('numberOfDays') || '3 Days - $250',
          extraInfo: [
            'Camp days: Monday 22nd, Tuesday 23rd, Wednesday 24th',
            requestNights ? `Small group night request: ${requestNights}` : '',
            notes ? `Notes: ${notes}` : '',
          ].filter(Boolean).join('\n'),
          paymentMethod: 'Obed Gamino at Leon FC',
          paymentLink: '',
          paymentStatus: 'request_only',
          agreementAccepted: !!data.get('agreementAccepted'),
        }

        if (!payload.requestType || !payload.playerFirstName || !payload.playerSurname || !payload.parentName || !payload.email || !payload.age || !payload.mobile || !payload.previousCamp || !payload.heardAboutCamp || !payload.agreementAccepted) {
          if (errEl) errEl.textContent = 'Please fill in every required field.'
          return
        }

        if (submitBtn && labelEl) {
          submitBtn.disabled = true
          labelEl.textContent = 'Sending...'
        }

        try {
          const grecaptcha = (window as any).JonerRecaptcha
          ;(payload as any).recaptchaToken = grecaptcha ? await grecaptcha.getToken('camp_registration') : ''

          const res = await fetch('/api/camp-registration', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          })
          const json = await res.json()
          if (!res.ok || !json.success) throw new Error(json?.error || 'Could not save your registration. Please try again.')

          if (typeof (window as any).JonerTracking?.trackEvent === 'function') {
            (window as any).JonerTracking.trackEvent('Lead', {
              user_data: { email: payload.email },
              custom_data: { form_name: 'san-diego-camp-2026', list_id: 5, lead_type: payload.requestType },
            })
          }

          form.innerHTML = `
            <div style="padding:18px 0;text-align:center;">
              <p style="color:#4ade80;font-size:18px;font-family:var(--font-display);font-style:italic;font-weight:900;text-transform:uppercase;letter-spacing:0.06em;margin:0 0 12px;">Request sent.</p>
              <p style="color:rgba(255,255,255,0.78);font-size:15px;line-height:1.55;margin:0 0 20px;">Check your email. Obed and Joner Football will follow up with payment and next steps.</p>
            </div>`
        } catch (err) {
          if (errEl) errEl.textContent = (err as Error).message || 'Something went wrong. Please try again.'
          if (submitBtn && labelEl) {
            submitBtn.disabled = false
            labelEl.textContent = originalLabel
          }
        }
      })
    }

    /* Sticky bottom CTA */
    ;(function () {
      const heroEl = document.querySelector('.sd-hero')
      const cta = document.querySelector('.sd-mobile-cta')
      if (!heroEl || !cta || !('IntersectionObserver' in window)) return
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          cta.classList.toggle('is-revealed', !entry.isIntersecting)
        })
      }, { threshold: 0, rootMargin: '-40px 0px 0px 0px' })
      io.observe(heroEl)
    })()
  </script>
</BaseLayout>
