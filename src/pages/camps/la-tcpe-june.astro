---
import BaseLayout from '../../layouts/BaseLayout.astro'

const title = 'LA Complete Player Experience | Joner Football Camps'
const description = 'Joner Football x First Strike Soccer. A selection only elite player experience in Los Angeles, June 2026. Apply for a spot.'
const canonical = 'https://jonerfootball.com/camps/la-tcpe-june/'

const heroImage = '/images/camps/tcpe/JONER-X-FIRST-STRIKE--scaled.jpg.webp'
const heroVideo = '/images/camps/tcpe/tcpe-hero-720.mp4?v=2'

const quickFacts = [
  { label: 'WHEN', value: 'June 22, 23, 24, 2026' },
  { label: 'WHERE', value: 'Gol Soccer Complex, North Hollywood' },
  { label: 'TIME', value: '8am to 12pm' },
  { label: 'WHO', value: 'Ages 13 to 18, ECNL or MLS NEXT level' },
  { label: 'CAPACITY', value: 'Max 30 players, application only' },
]

const promiseBullets = [
  { title: 'Train with the best', text: 'High level position specific work with Joner Football and First Strike.' },
  { title: 'Build the full player', text: 'Mindset, nutrition and sports science seminars built for serious footballers.' },
  { title: 'Leave with clarity', text: 'Detailed individual reports and a direct coach feedback meeting.' },
]

const proofItems = [
  { label: 'SELECTION ONLY', text: 'Not an open camp. Application required.' },
  { label: 'MAX 30 PLAYERS', text: 'Capped on purpose. Real coaching detail.' },
  { label: 'ECNL / MLS NEXT', text: 'Built for the standard. Not for everyone.' },
  { label: '3 DAYS', text: 'Training, education, reports, kit, feedback.' },
]

const experience = [
  '3 days of high level training with Joner Football and First Strike',
  'Position specific detail tailored to how you actually play',
  'Footballers Mindset Seminar',
  'Nutrition for footballers seminar',
  'Sports science support in partnership with MAP',
  'Detailed individual player reports',
  'Coach feedback meeting',
  'Joner Football x First Strike training jersey',
  'Player welcome pack',
  'Full free access to the Joner Football App',
]

const selectionRules = [
  'Currently playing ECNL, MLS NEXT or an equivalent standard',
  'Aged 13 to 18',
  'Serious about player development, not just a clinic',
  'Coachable, fit, ready to be pushed for 3 full days',
]

const faqs = [
  { question: 'What does the player need to bring?', answer: 'Soccer boots for synthetic, shin guards, drink bottle, waterproof jacket, a smile, and a good attitude.' },
  { question: 'What should the player wear?', answer: 'Black shorts and white socks. Joner Football will provide the training jersey.' },
  { question: 'What should players expect?', answer: 'Energy, intensity, knowledge, new drills, and a learning environment built for serious footballers.' },
  { question: 'Will bad weather cancel the camp?', answer: 'No. Only severe storms can delay the camp.' },
  { question: 'Can we take photos or videos?', answer: 'Professional photos and videos will be taken. The coaches will leave time on the final day for photos and chats.' },
  { question: 'Can I get a refund if I cancel?', answer: 'Full refunds will be issued if you cancel within 14 days of the camp start date.' },
]

const eyebrowClass = 'font-heading text-xs uppercase tracking-[0.18em] text-joner-red'
const darkHeadingClass = 'font-heading text-[clamp(2.5rem,7vw,4rem)] font-bold uppercase leading-[1.04] text-white'
const lightHeadingClass = 'font-heading text-[clamp(2.5rem,7vw,4rem)] font-bold uppercase leading-[1.04] text-joner-black'
const redButtonClass = 'btn-red'

const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: 'Joner Football LA Complete Player Experience June 2026',
  startDate: '2026-06-22T08:00-07:00',
  endDate: '2026-06-24T12:00-07:00',
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: 'Gol Soccer Complex',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '11501 Strathern St',
      addressLocality: 'North Hollywood',
      addressRegion: 'CA',
      postalCode: '91605',
      addressCountry: 'US',
    },
  },
  organizer: { '@type': 'Organization', name: 'Joner Football', url: 'https://jonerfootball.com' },
  image: 'https://jonerfootball.com/images/camps/tcpe/JONER-X-FIRST-STRIKE--scaled.jpg.webp',
  description,
  offers: {
    '@type': 'Offer',
    name: 'Selection only application',
    availability: 'https://schema.org/LimitedAvailability',
    url: 'https://jonerfootball.com/camps/la-tcpe-june/#apply',
  },
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
}
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={`https://jonerfootball.com${heroImage}`}
  schema={[eventSchema, faqSchema]}
  hideMobileAppCta
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={heroImage} fetchpriority="high" />
  </Fragment>

  <section id="overview" class="relative overflow-hidden bg-joner-black text-white">
    <div class="absolute inset-x-0 top-0 z-20 h-px bg-joner-red"></div>
    <video data-hero-video autoplay muted loop playsinline poster={heroImage} class="absolute inset-0 hidden h-full w-full object-cover md:block">
      <source src={heroVideo} type="video/mp4" />
    </video>
    <div class="absolute inset-0 hidden bg-gradient-to-r from-black/85 to-black/25 md:block"></div>
    <div class="absolute inset-0 hidden bg-gradient-to-t from-black via-transparent to-black/30 md:block"></div>

    <div class="relative z-10 mx-auto flex min-h-[92vh] max-w-7xl flex-col justify-center px-4 py-20 sm:px-6 md:py-32 lg:px-8">
      <div class="relative mb-6 aspect-video overflow-hidden border border-white/15 bg-joner-black md:hidden">
        <video data-hero-video autoplay muted loop playsinline poster={heroImage} class="h-full w-full object-cover">
          <source src={heroVideo} type="video/mp4" />
        </video>
        <div class="absolute inset-0 bg-gradient-to-t from-black/55 to-transparent"></div>
      </div>

      <div class="max-w-4xl camp-reveal opacity-0 translate-y-4 transition duration-500 ease-out">
        <p class="inline-flex items-center gap-2 border border-joner-red bg-joner-red/15 px-4 py-2 font-heading text-xs uppercase tracking-[0.18em] text-white">
          <span class="inline-block h-2 w-2 rounded-full bg-joner-red"></span>
          Selection Only, Application Required
        </p>
        <h1 class="mt-5 font-heading text-[clamp(3rem,12vw,6rem)] font-bold uppercase leading-[1.02] text-white">
          <span class="block pb-1">LA Complete</span>
          <span class="block pb-1 text-joner-red">Player</span>
          <span class="block">Experience.</span>
        </h1>

        <div class="mt-7 grid gap-3 sm:grid-cols-3">
          <div class="border border-joner-red/70 bg-white/95 px-4 py-3 text-joner-black shadow-[0_18px_60px_rgba(0,0,0,.3)]">
            <p class="font-heading text-base uppercase leading-tight tracking-[0.08em]">June 22, 23, 24</p>
          </div>
          <div class="border border-joner-red/70 bg-white/95 px-4 py-3 text-joner-black shadow-[0_18px_60px_rgba(0,0,0,.3)]">
            <p class="font-heading text-base uppercase leading-tight tracking-[0.08em]">8am to 12pm</p>
          </div>
          <div class="border border-joner-red/70 bg-white/95 px-4 py-3 text-joner-black shadow-[0_18px_60px_rgba(0,0,0,.3)]">
            <p class="font-heading text-base uppercase leading-tight tracking-[0.08em]">Max 30 players</p>
          </div>
        </div>

        <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a href="#apply" class={`${redButtonClass} w-full text-center sm:w-auto`}>Apply for a spot</a>
          <a href="#what-you-get" class="inline-flex w-full items-center justify-center border border-white/40 bg-black/40 px-6 py-4 font-heading text-sm uppercase tracking-[0.16em] text-white backdrop-blur transition hover:border-white sm:w-auto">See the detail</a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-8 text-joner-black md:py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="camp-reveal opacity-0 translate-y-4 transition duration-500 ease-out">
        <p class={eyebrowClass}>The Facts</p>
        <h2 class={lightHeadingClass}>LA essentials.</h2>
      </div>
      <div class="mt-8 flex snap-x gap-4 overflow-x-auto pb-2 md:grid md:grid-cols-5 md:overflow-visible md:pb-0">
        {quickFacts.map((fact) => (
          <article class="min-w-[78vw] snap-start border border-joner-red/30 bg-joner-black text-white shadow-[0_30px_80px_rgba(0,0,0,.12)] md:min-w-0">
            <div class="bg-joner-red px-5 py-3">
              <p class="font-heading text-lg uppercase leading-none tracking-[0.12em] text-white">{fact.label}</p>
            </div>
            <h3 class="p-5 font-body text-base font-bold leading-snug text-white md:text-lg">{fact.value}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="jxfs" class="bg-white py-12 text-joner-black md:py-20">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-10 px-4 sm:px-6 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.15fr)] lg:gap-16 lg:px-8">
      <div class="camp-reveal opacity-0 translate-y-4 transition duration-500 ease-out">
        <p class={eyebrowClass}>Joner Football x First Strike Soccer</p>
        <h2 class="mt-3 border-l-4 border-joner-red pl-4 font-heading text-[clamp(2.5rem,9vw,5rem)] font-bold uppercase italic leading-[1.02] tracking-tight text-joner-black">Built for serious footballers only.</h2>
        <div class="mt-6 space-y-4 font-body text-base leading-relaxed text-gray-700 md:text-lg">
          <p>This June in Los Angeles, Lee Jones and Bradley Mulvey are teaming up to deliver a footballer's experience like no other.</p>
          <p>This is not a normal camp. High level training, position specific detail, nutrition, mindset, sports science, individual reports and direct coach feedback. All in 3 days.</p>
        </div>
        <p class="mt-6 font-heading text-sm uppercase tracking-[0.12em] text-joner-black">Selection only. Max 30 players.</p>
        <a href="#apply" class={`${redButtonClass} mt-5 w-full text-center sm:w-auto`}>Apply for a spot</a>
      </div>
      <figure class="overflow-hidden bg-gray-100">
        <img src="/images/camps/tcpe/jonerxfirststrike-collage.webp" alt="Lee Jones and Bradley Mulvey coaching players at the LA Complete Player Experience" class="h-full w-full object-cover" loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <section class="bg-black py-8 text-white">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-5 px-4 sm:px-6 md:grid-cols-4 lg:px-8">
      {proofItems.map((item) => (
        <article class="border-l border-joner-red/60 pl-4">
          <p class={eyebrowClass}>Standard</p>
          <h2 class="mt-2 font-heading text-xl uppercase leading-none text-white md:text-2xl">{item.label}</h2>
          <p class="mt-2 font-body text-sm leading-snug text-white/70">{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="who" class="relative overflow-hidden bg-joner-black py-12 text-white md:py-20">
    <img src="/images/camps/tcpe/DSC06106-scaled.jpeg.webp" alt="Joner Football coach working directly with a player" class="absolute inset-y-0 right-0 hidden h-full w-[55%] object-cover lg:block" loading="lazy" decoding="async" />
    <div class="absolute inset-0 hidden bg-gradient-to-r from-black via-black/90 to-black/20 lg:block"></div>
    <figure class="relative mx-4 mb-8 aspect-[4/3] overflow-hidden border border-white/10 sm:mx-6 lg:hidden">
      <img src="/images/camps/tcpe/DSC06106-scaled.jpeg.webp" alt="Joner Football coach working directly with a player" class="h-full w-full object-cover" loading="lazy" decoding="async" />
    </figure>
    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-xl camp-reveal opacity-0 translate-y-4 transition duration-500 ease-out">
        <p class={eyebrowClass}>Who Gets In</p>
        <h2 class={darkHeadingClass}>This is not for everyone.</h2>
        <p class="mt-5 max-w-md font-body text-lg leading-relaxed text-white/80">Spots are reviewed by Lee and Bradley. To be accepted, players must meet the standard.</p>
        <ul class="mt-7 space-y-4">
          {selectionRules.map((rule) => (
            <li class="border-l-4 border-joner-red pl-5">
              <p class="font-heading text-lg uppercase leading-tight tracking-[0.03em] text-white">{rule}</p>
            </li>
          ))}
        </ul>
        <a href="#apply" class={`${redButtonClass} mt-8 w-full text-center sm:w-auto`}>Apply for a spot</a>
      </div>
    </div>
  </section>

  <section id="what-you-get" class="bg-white py-12 text-joner-black md:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="camp-reveal opacity-0 translate-y-4 transition duration-500 ease-out">
        <p class={eyebrowClass}>The Experience</p>
        <h2 class={lightHeadingClass}>What every player gets.</h2>
      </div>
      <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-2">
        {experience.map((item, index) => (
          <article class="flex items-start gap-4 border border-gray-200 bg-gray-50 p-5">
            <span class="grid h-9 w-9 shrink-0 place-items-center bg-joner-red font-heading text-sm text-white">{String(index + 1).padStart(2, '0')}</span>
            <p class="font-heading text-base uppercase leading-tight tracking-[0.04em] text-joner-black md:text-lg">{item}</p>
          </article>
        ))}
      </div>
      <div class="mt-8 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
        <a href="#apply" class={`${redButtonClass} w-full text-center sm:w-auto`}>Apply for a spot</a>
        <p class="font-body text-sm text-gray-600">Max 30 players. Selection only.</p>
      </div>
    </div>
  </section>

  <section id="promise" class="bg-joner-black text-white">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]">
      <figure class="min-h-[320px] overflow-hidden bg-gray-900 lg:min-h-[640px]">
        <img src="/images/camps/tcpe/DSC00901-scaled.jpg.webp" alt="Lee Jones delivering the Footballers Mindset Seminar" class="h-full w-full object-cover" loading="lazy" decoding="async" />
      </figure>
      <div class="flex flex-col justify-center px-4 py-12 sm:px-8 md:py-20 lg:px-14">
        <div class="camp-reveal opacity-0 translate-y-4 transition duration-500 ease-out">
          <p class={eyebrowClass}>The Promise</p>
          <h2 class={darkHeadingClass}>Train hard.<br />Learn deep.<br />Leave better.</h2>
        </div>
        <div class="mt-8 space-y-5">
          {promiseBullets.map((item) => (
            <div class="border-l-4 border-joner-red pl-5">
              <h3 class="font-heading text-xl uppercase leading-snug tracking-[0.03em] text-white">{item.title}</h3>
              <p class="mt-2 font-body leading-relaxed text-white/72">{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="apply" class="relative overflow-hidden bg-joner-black py-12 text-white scroll-mt-20 md:py-24">
    <img src="/images/camps/tcpe/IMG_9569-scaled.jpg.webp" alt="LA Complete Player Experience backdrop" class="absolute inset-0 h-full w-full object-cover opacity-25" loading="lazy" decoding="async" />
    <div class="absolute inset-0 bg-black/82"></div>
    <div class="relative z-10 mx-auto grid max-w-7xl grid-cols-1 gap-8 px-4 sm:px-6 lg:grid-cols-[0.42fr_0.58fr] lg:px-8">
      <aside class="border border-white/15 bg-black/70 p-6 backdrop-blur md:p-8">
        <p class={eyebrowClass}>Selection Only</p>
        <h2 class={darkHeadingClass}>Apply for a spot.</h2>
        <p class="mt-5 font-body text-base leading-relaxed text-white/82">Lee and Bradley personally review every application. You will hear back with acceptance, decline or next steps.</p>
        <div class="mt-7 space-y-4 border-y border-white/10 py-6">
          <div>
            <p class={eyebrowClass}>Camp</p>
            <p class="font-body text-lg font-bold text-white">LA Complete Player Experience</p>
          </div>
          <div>
            <p class={eyebrowClass}>Dates</p>
            <p class="font-body text-lg font-bold text-white">June 22, 23, 24, 2026, 8am to 12pm</p>
          </div>
          <div>
            <p class={eyebrowClass}>Venue</p>
            <p class="font-body text-white/82">Gol Soccer Complex, 11501 Strathern St, North Hollywood, CA 91605</p>
          </div>
          <div>
            <p class={eyebrowClass}>Standard</p>
            <p class="font-body text-white/82">Ages 13 to 18, ECNL or MLS NEXT level. Max 30 players.</p>
          </div>
        </div>
        <p class="mt-5 font-body text-sm text-white/70">Applications go direct to the Joner Football team. Reply usually within 48 hours.</p>
      </aside>

      <form id="tcpe-application-form" class="bg-white p-5 text-joner-black shadow-[0_30px_80px_rgba(0,0,0,.08)] md:p-8">
        <div class="border-b border-gray-200 pb-5">
          <p class={eyebrowClass}>Player Application</p>
          <h3 class="font-heading text-[clamp(2rem,5vw,3rem)] uppercase leading-none text-joner-black">Apply now.</h3>
          <p class="mt-3 font-body text-gray-600">Tell us about the player. We review every application before any payment.</p>
        </div>

        <input type="hidden" name="camp" value="LA Complete Player Experience" />

        <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="mb-2 block font-heading text-xs uppercase tracking-[0.12em] text-joner-black">Player Full Name *</span>
            <input required name="playerFullName" class="min-h-[52px] w-full border border-gray-300 bg-gray-50 px-4 py-3 font-body text-base text-joner-black focus:border-joner-red focus:bg-white focus:outline-none" autocomplete="name" />
          </label>
          <label class="block">
            <span class="mb-2 block font-heading text-xs uppercase tracking-[0.12em] text-joner-black">Parent Full Name *</span>
            <input required name="parentFullName" class="min-h-[52px] w-full border border-gray-300 bg-gray-50 px-4 py-3 font-body text-base text-joner-black focus:border-joner-red focus:bg-white focus:outline-none" autocomplete="name" />
          </label>
          <label class="block">
            <span class="mb-2 block font-heading text-xs uppercase tracking-[0.12em] text-joner-black">Player Age *</span>
            <input required name="playerAge" class="min-h-[52px] w-full border border-gray-300 bg-gray-50 px-4 py-3 font-body text-base text-joner-black focus:border-joner-red focus:bg-white focus:outline-none" inputmode="numeric" />
          </label>
          <label class="block">
            <span class="mb-2 block font-heading text-xs uppercase tracking-[0.12em] text-joner-black">Mobile Number *</span>
            <input required name="mobileNumber" class="min-h-[52px] w-full border border-gray-300 bg-gray-50 px-4 py-3 font-body text-base text-joner-black focus:border-joner-red focus:bg-white focus:outline-none" autocomplete="tel" />
          </label>
          <label class="block sm:col-span-2">
            <span class="mb-2 block font-heading text-xs uppercase tracking-[0.12em] text-joner-black">Email *</span>
            <input required type="email" name="email" class="min-h-[52px] w-full border border-gray-300 bg-gray-50 px-4 py-3 font-body text-base text-joner-black focus:border-joner-red focus:bg-white focus:outline-none" autocomplete="email" />
          </label>
          <label class="block sm:col-span-2">
            <span class="mb-2 block font-heading text-xs uppercase tracking-[0.12em] text-joner-black">Current Club, League, Position *</span>
            <input required name="playFor" placeholder="e.g. LAFC Academy, ECNL, attacking midfielder" class="min-h-[52px] w-full border border-gray-300 bg-gray-50 px-4 py-3 font-body text-base text-joner-black focus:border-joner-red focus:bg-white focus:outline-none" />
          </label>
          <label class="block">
            <span class="mb-2 block font-heading text-xs uppercase tracking-[0.12em] text-joner-black">Worked with Joner before?</span>
            <select name="workedBefore" class="min-h-[52px] w-full border border-gray-300 bg-gray-50 px-4 py-3 font-body text-base text-joner-black focus:border-joner-red focus:bg-white focus:outline-none">
              <option value="">Select</option>
              <option>Yes, in person</option>
              <option>Yes, app or online</option>
              <option>No</option>
            </select>
          </label>
          <label class="block">
            <span class="mb-2 block font-heading text-xs uppercase tracking-[0.12em] text-joner-black">How did you hear about it? *</span>
            <input required name="hearAbout" class="min-h-[52px] w-full border border-gray-300 bg-gray-50 px-4 py-3 font-body text-base text-joner-black focus:border-joner-red focus:bg-white focus:outline-none" />
          </label>
        </div>

        <label class="mt-4 block">
          <span class="mb-2 block font-heading text-xs uppercase tracking-[0.12em] text-joner-black">Why should this player be selected? *</span>
          <textarea required name="applicationMessage" rows="4" placeholder="Standard of play, achievements, what they want to get from these 3 days." class="w-full border border-gray-300 bg-gray-50 px-4 py-3 font-body text-base text-joner-black focus:border-joner-red focus:bg-white focus:outline-none"></textarea>
        </label>

        <div id="tcpe-form-message" class="mt-5 hidden border border-gray-700 p-4 font-body text-sm"></div>
        <button type="submit" class={`${redButtonClass} mt-5 w-full`}>Send application</button>
        <p class="mt-3 font-body text-xs text-gray-500">Applications are reviewed by Lee and Bradley. You will be contacted by the Joner Football team.</p>
      </form>
    </div>
  </section>

  <section id="faqs" class="bg-white py-12 text-joner-black md:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="camp-reveal text-center opacity-0 translate-y-4 transition duration-500 ease-out">
        <p class={eyebrowClass}>FAQ</p>
        <h2 class={lightHeadingClass}>Before you apply.</h2>
      </div>
      <div class="mt-8 space-y-3" id="camp-faq">
        {faqs.map((item) => (
          <article class="faq-item border border-gray-200 bg-white">
            <button class="faq-toggle flex min-h-[56px] w-full items-center justify-between gap-4 p-5 text-left" aria-expanded="false" type="button">
              <span class="font-heading text-base font-bold uppercase tracking-[0.08em] text-joner-black">{item.question}</span>
              <span class="faq-icon text-joner-red transition-transform">+</span>
            </button>
            <div class="faq-content hidden px-5 pb-5">
              <p class="font-body leading-relaxed text-gray-700">{item.answer}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="mt-10 text-center">
        <a href="#apply" class={`${redButtonClass} w-full sm:w-auto`}>Apply for a spot</a>
        <p class="mt-3 font-body text-sm text-gray-600">Questions? Email leejones@jonerfootball.com</p>
      </div>
    </div>
  </section>

  <a href="#apply" class="camp-mobile-cta btn-red fixed bottom-[72px] left-3 right-3 z-40 text-center shadow-2xl transition md:hidden">
    <span class="block font-heading text-sm uppercase tracking-[0.12em]">Apply for a spot, selection only</span>
  </a>

  <script>
    const form = document.querySelector('#tcpe-application-form') as HTMLFormElement | null
    const message = document.querySelector('#tcpe-form-message') as HTMLElement | null

    const revealItems = document.querySelectorAll('.camp-reveal')
    if ('IntersectionObserver' in window) {
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return
          entry.target.classList.remove('opacity-0', 'translate-y-4')
          entry.target.classList.add('opacity-100', 'translate-y-0')
          revealObserver.unobserve(entry.target)
        })
      }, { threshold: 0.18 })
      revealItems.forEach((item) => revealObserver.observe(item))
    } else {
      revealItems.forEach((item) => {
        item.classList.remove('opacity-0', 'translate-y-4')
        item.classList.add('opacity-100', 'translate-y-0')
      })
    }

    const heroVideos = document.querySelectorAll('[data-hero-video]') as NodeListOf<HTMLVideoElement>
    heroVideos.forEach((video) => {
      video.addEventListener('click', () => {
        video.muted = !video.muted
        if (video.paused) video.play().catch(() => {})
      })
    })

    document.addEventListener('visibilitychange', () => {
      heroVideos.forEach((video) => {
        if (document.hidden) {
          video.pause()
          return
        }
        video.play().catch(() => {})
      })
    })

    const mobileCta = document.querySelector('.camp-mobile-cta')
    const applySection = document.querySelector('#apply')
    if (mobileCta && applySection && 'IntersectionObserver' in window) {
      const ctaObserver = new IntersectionObserver((entries) => {
        const isApplyVisible = entries.some((entry) => entry.isIntersecting)
        mobileCta.classList.toggle('opacity-0', isApplyVisible)
        mobileCta.classList.toggle('pointer-events-none', isApplyVisible)
      }, { threshold: 0.12 })
      ctaObserver.observe(applySection)
    }

    document.querySelectorAll('.faq-toggle').forEach((button) => {
      button.addEventListener('click', () => {
        const item = button.closest('.faq-item')
        const content = item?.querySelector('.faq-content')
        const icon = item?.querySelector('.faq-icon')
        const isOpen = content && !content.classList.contains('hidden')

        document.querySelectorAll('.faq-item').forEach((faq) => {
          faq.querySelector('.faq-content')?.classList.add('hidden')
          const toggle = faq.querySelector('.faq-toggle')
          const faqIcon = faq.querySelector('.faq-icon')
          if (toggle) toggle.setAttribute('aria-expanded', 'false')
          if (faqIcon) faqIcon.textContent = '+'
        })

        if (!isOpen && content) {
          content.classList.remove('hidden')
          button.setAttribute('aria-expanded', 'true')
          if (icon) icon.textContent = '-'
        }
      })
    })

    form?.addEventListener('submit', async (event) => {
      event.preventDefault()

      const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement | null
      if (submitButton) {
        submitButton.disabled = true
        submitButton.textContent = 'Sending application...'
      }
      if (message) {
        message.className = 'mt-5 border border-gray-300 bg-gray-50 p-4 text-sm font-body text-gray-700'
        message.textContent = 'Sending application.'
      }

      const formData = new FormData(form)
      const payload = Object.fromEntries(formData.entries()) as Record<string, string>
      const grecaptcha = (window as any).JonerRecaptcha
      ;(payload as any).recaptchaToken = grecaptcha ? await grecaptcha.getToken('selection_application') : ''

      try {
        const response = await fetch('/api/selection-application', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        })
        const data = await response.json()
        if (!response.ok || !data.success) throw new Error(data.error || 'Application failed.')

        if (message) {
          message.className = 'mt-5 border border-joner-red p-4 text-sm font-body text-joner-black bg-joner-red/10'
          message.textContent = 'Application sent. The team will be in touch within 48 hours.'
        }
        form.reset()
      } catch (error) {
        if (message) {
          message.className = 'mt-5 border border-joner-red p-4 text-sm font-body text-joner-black bg-joner-red/10'
          message.textContent = (error as Error).message || 'Could not send application. Please try again.'
        }
        if (submitButton) {
          submitButton.disabled = false
          submitButton.textContent = 'Send application'
        }
      }
    })
  </script>
</BaseLayout>
