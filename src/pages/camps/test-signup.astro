---
import BaseLayout from '../../layouts/BaseLayout.astro'

const defaultPaymentLink = 'https://app.jonerfootball.com'
---

<BaseLayout
  title="Test Camp Sign Up | Joner Football"
  description="Test the Joner Football camp registration flow before launch."
>
  <section class="bg-joner-black py-16 md:py-24 min-h-screen">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-10">
        <p class="text-joner-red font-heading text-sm uppercase tracking-widest mb-3">Camp Registration Test</p>
        <h1 class="font-heading text-4xl md:text-6xl font-bold text-white uppercase leading-none mb-5">Test Camp Sign Up</h1>
        <p class="text-gray-300 font-body text-lg max-w-2xl">Complete the form below first. After it saves, the player is sent to the payment link to secure their place.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-8 items-start">
        <form id="camp-registration-form" class="bg-joner-gray border border-gray-800 p-5 md:p-8 space-y-5">
          <input type="hidden" name="camp" value="Test Camp" />
          <input type="hidden" name="destination" value="usa" />
          <input type="hidden" name="paymentLink" value={defaultPaymentLink} />

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <label class="block">
              <span class="form-label">Player First Name *</span>
              <input required name="playerFirstName" class="form-input" />
            </label>
            <label class="block">
              <span class="form-label">Player Surname *</span>
              <input required name="playerSurname" class="form-input" />
            </label>
            <label class="block">
              <span class="form-label">Parent Name If Under 18</span>
              <input name="parentName" class="form-input" />
            </label>
            <label class="block">
              <span class="form-label">Email *</span>
              <input required type="email" name="email" class="form-input" />
            </label>
            <label class="block">
              <span class="form-label">Current Age *</span>
              <input required name="age" class="form-input" />
            </label>
            <label class="block">
              <span class="form-label">Mobile Number *</span>
              <input required name="mobile" class="form-input" />
            </label>
            <label class="block">
              <span class="form-label">Done A Joner Camp Before?</span>
              <select name="previousCamp" class="form-input">
                <option value="">Select</option>
                <option>Yes</option>
                <option>No</option>
              </select>
            </label>
            <label class="block">
              <span class="form-label">Jersey Size *</span>
              <select required name="jerseySize" class="form-input">
                <option value="">Select size</option>
                <option>Youth XS</option>
                <option>Youth S</option>
                <option>Youth M</option>
                <option>Youth L</option>
                <option>Youth XL</option>
                <option>Adult S</option>
                <option>Adult M</option>
                <option>Adult L</option>
                <option>Adult XL</option>
              </select>
            </label>
            <label class="block md:col-span-2">
              <span class="form-label">Current Club / Level</span>
              <input name="clubLevel" class="form-input" />
            </label>
            <label class="block md:col-span-2">
              <span class="form-label">Where Did You Hear About The Elite Camp?</span>
              <input name="source" class="form-input" />
            </label>
            <label class="block md:col-span-2">
              <span class="form-label">Medical History</span>
              <textarea name="medicalHistory" rows="3" class="form-input"></textarea>
            </label>
            <label class="block md:col-span-2">
              <span class="form-label">Extra Player Info</span>
              <textarea name="extraInfo" rows="3" class="form-input"></textarea>
            </label>
            <label class="block">
              <span class="form-label">How Many Days? *</span>
              <select required name="numberOfDays" class="form-input">
                <option value="">Select</option>
                <option>1 Day</option>
                <option>2 Days</option>
                <option>3 Days</option>
                <option>Full Camp</option>
              </select>
            </label>
            <label class="block">
              <span class="form-label">Payment Method</span>
              <select name="paymentMethod" class="form-input">
                <option>Stripe</option>
                <option>PayPal</option>
              </select>
            </label>
          </div>

          <label class="flex gap-3 items-start text-gray-300 font-body text-sm">
            <input required type="checkbox" name="agreementAccepted" class="mt-1 accent-[#E30613]" />
            <span>I have read and agree to the website training agreement.</span>
          </label>

          <div id="camp-form-message" class="hidden border border-gray-700 p-4 text-sm font-body"></div>
          <button type="submit" class="btn-red w-full md:w-auto">Submit Registration And Pay</button>
        </form>

        <aside class="bg-joner-gray border border-gray-800 p-6 sticky top-24">
          <h2 class="font-heading text-2xl font-bold text-white uppercase mb-4">Flow Being Tested</h2>
          <ol class="space-y-3 text-gray-300 font-body text-sm list-decimal list-inside">
            <li>Parent fills out form.</li>
            <li>Website saves registration.</li>
            <li>Parent is sent to Stripe or PayPal.</li>
            <li>Lee has the lead even if payment is not completed.</li>
          </ol>
          <p class="text-gray-500 font-body text-xs mt-5">For launch, the save step connects to Google Sheets or a webhook.</p>
        </aside>
      </div>
    </div>
  </section>

  <style>
    .form-label { display:block; color:#fff; font-family:var(--font-heading); font-size:.75rem; text-transform:uppercase; letter-spacing:.08em; margin-bottom:.45rem; }
    .form-input { width:100%; background:#0A0A0A; border:1px solid #333; color:#fff; min-height:48px; padding:.75rem .9rem; font-family:var(--font-body); border-radius:0; }
    .form-input:focus { outline:2px solid #E30613; outline-offset:0; border-color:#E30613; }
  </style>

  <script>
    const form = document.querySelector('#camp-registration-form')
    const message = document.querySelector('#camp-form-message')

    form?.addEventListener('submit', async (event) => {
      event.preventDefault()
      const submitButton = form.querySelector('button[type="submit"]')
      submitButton.disabled = true
      submitButton.textContent = 'Saving Registration...'
      message.className = 'border border-gray-700 p-4 text-sm font-body text-gray-300'
      message.textContent = 'Saving registration before payment.'

      const formData = new FormData(form)
      const payload = Object.fromEntries(formData.entries())
      payload.agreementAccepted = formData.get('agreementAccepted') === 'on'

      try {
        const response = await fetch('/api/camp-registration', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        })
        const data = await response.json()
        if (!response.ok || !data.success) throw new Error(data.error || 'Registration failed.')

        message.className = 'border border-joner-red p-4 text-sm font-body text-white bg-joner-red/10'
        message.textContent = 'Registration saved. Sending you to payment now.'
        window.location.href = data.paymentLink || payload.paymentLink || 'https://app.jonerfootball.com'
      } catch (error) {
        message.className = 'border border-joner-red p-4 text-sm font-body text-white bg-joner-red/10'
        message.textContent = error.message || 'Could not save registration. Please try again.'
        submitButton.disabled = false
        submitButton.textContent = 'Submit Registration And Pay'
      }
    })
  </script>
</BaseLayout>
