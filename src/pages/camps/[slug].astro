}

const fallbackCamp = CAMP_FALLBACKS[slug]
if (!fallbackCamp && !sanityCamp) return Astro.redirect('/camps')

const camp = mergeCamp(sanityCamp || {}, fallbackCamp || {})
const jerseySizes = camp.jerseySizes?.length
  ? camp.jerseySizes
  : ['Youth XS', 'Youth S', 'Youth M', 'Youth L', 'Youth XL', 'Adult S', 'Adult M', 'Adult L', 'Adult XL']
const dayOptions = camp.dayOptions?.length ? camp.dayOptions : ['Full Camp']
const dayPaymentLinks = camp.dayPaymentLinks || []
const stripePaymentLink = camp.stripePaymentLink || camp.afterpayPaymentLink || 'https://app.jonerfootball.com'
const paypalPaymentLink = camp.paypalPaymentLink || ''
const dayLevelPaypalLink = dayPaymentLinks.find((item: any) => item?.paypalPaymentLink)?.paypalPaymentLink || ''
const paymentOptions = [
  { label: 'Pay with Stripe', value: 'Stripe', link: stripePaymentLink },
  (paypalPaymentLink || dayLevelPaypalLink) && { label: 'Pay with PayPal', value: 'PayPal', link: paypalPaymentLink || dayLevelPaypalLink },
].filter(Boolean)
const paymentLink = stripePaymentLink || paypalPaymentLink || 'https://app.jonerfootball.com'
const destination = camp.destination || (String(camp.location || '').toLowerCase().includes('sydney') ? 'sydney' : 'usa')
const heroImage = camp.heroImage || '/images/camps/hero-bg.webp'
const heroVideo = camp.heroVideo || ''
const ogImage = heroImage.startsWith('http') ? heroImage : `https://jonerfootball.com${heroImage}`
const pageDescription = camp.description || `Register for ${camp.title} with Joner Football.`
const canonical = `https://jonerfootball.com/camps/${slug}/`
const statusLabel = camp.status === 'sold-out' ? 'Sold out' : camp.status === 'coming-soon' ? 'Coming soon' : 'Registration open'
const spotsLabel = camp.spotsRemaining || camp.spotsTotal
  ? `${camp.spotsRemaining || camp.spotsTotal} spots`
  : camp.urgencyLabel
const campCity = cleanText(camp.location).split(',')[0] || 'This'
const ctaLabel = `Book ${campCity} Camp Spot`
const mainOutcome = camp.mainOutcome || 'Sharper technique, cleaner decisions, and the confidence to train with higher standards after camp.'
const quickFacts = [
  { label: 'Where', value: camp.venueName ? `${camp.location} - ${camp.venueName}` : camp.location },
  { label: 'Date and time', value: `${camp.dates} - ${camp.times}` },
  { label: 'Age group', value: camp.ageRange },
  { label: 'Group standard', value: camp.urgencyLabel || spotsLabel },
  { label: 'Camp options', value: camp.priceLabel || dayOptions.join(', ') },
  { label: 'Main outcome', value: mainOutcome },
]

const campPhotoSet = [
  '/images/camps/joner-camps/hero-lee-pointing.jpg',
  '/images/camps/joner-camps/lee-coaching-group.jpg',
  '/images/camps/joner-camps/lee-with-players.jpg',
  '/images/camps/joner-camps/red-shirt-action.jpg',
  '/images/camps/joner-camps/camp-team-photo.jpg',
]
const pageHeroImage = campPhotoSet[0] || heroImage
const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: `${camp.title} | Joner Football Camp`,
  description: pageDescription,
  startDate: camp.startDate,
  endDate: camp.endDate || camp.startDate,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: camp.status === 'sold-out' || camp.status === 'closed'
    ? 'https://schema.org/EventScheduled'
    : 'https://schema.org/EventScheduled',
  location: {
    '@type': 'Place',
    name: camp.venueName || camp.venue || camp.location,
    address: {
      '@type': 'PostalAddress',
      streetAddress: camp.venueAddress || camp.venue,
      addressLocality: camp.location,
    },
  },
  organizer: {
    '@type': 'Organization',
    name: 'Joner Football',
    url: 'https://jonerfootball.com',
  },
  image: ogImage,
}

const faqSchema = camp.faqItems?.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: camp.faqItems.map((item: any) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
} : null
---

<BaseLayout
  title={`${camp.title} | Joner Football Camps`}
  description={pageDescription}
  canonical={canonical}
  ogImage={ogImage}
  schema={faqSchema ? [eventSchema, faqSchema] : [eventSchema]}
>
  <section id="overview" class="camp-hero relative min-h-[82vh] overflow-hidden bg-joner-black">
    {heroVideo ? (
      <video autoplay muted loop playsinline poster={pageHeroImage} class="absolute inset-0 h-full w-full object-cover">
        <source src={heroVideo} type="video/mp4" />
      </video>
    ) : (
      <img src={pageHeroImage} alt={`${camp.title} with Lee Jones coaching players`} class="absolute inset-0 h-full w-full object-cover" loading="eager" />
    )}
    <div class="absolute inset-0 bg-black/58"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/82 via-black/44 to-black/18"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-black/30"></div>
    <div class="absolute inset-x-0 top-0 h-1 bg-joner-red"></div>

    <div class="relative z-10 flex min-h-[82vh] max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32 items-center">
      <div class="max-w-4xl">
        <h1 class="font-heading text-5xl sm:text-7xl lg:text-8xl font-bold text-white uppercase leading-none">Houston World Cup Camp.</h1>
        <p class="mt-6 max-w-2xl text-xl md:text-2xl text-white font-body font-semibold leading-snug">Come do a Joner Football Elite Camp &amp; enjoy world cup vibes at the same time</p>
      </div>
    </div>
  </section>

  <section id="details" class="bg-white py-14 md:py-20 text-joner-black">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="camp-eyebrow">Camp Details</p>
          <h2 class="section-heading text-joner-black">Houston 2026</h2>
        </div>
        <a href="#register" class="btn-red text-center">{ctaLabel}</a>
      </div>

      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
        <div class="simple-card"><span>Location</span><strong>{camp.venueAddress || camp.venue}</strong></div>
        <div class="simple-card"><span>Times</span><strong>{camp.times}</strong></div>
        <div class="simple-card"><span>Price</span><strong>{camp.priceLabel || dayOptions.join(', ')}</strong></div>
        <div class="simple-card"><span>Ages</span><strong>{camp.ageRange} grouped by age and skill</strong></div>
        <div class="simple-card"><span>Capacity</span><strong>Max 80 players. Sold out last year.</strong></div>
      </div>
    </div>
  </section>

  <section id="work-on" class="bg-joner-black py-14 md:py-20 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-[0.8fr_1.2fr] gap-10 items-start">
        <div>
          <p class="camp-eyebrow">What Players Get</p>
          <h2 class="section-heading text-white">Train hard. Learn detail. Leave better.</h2>
          <p class="mt-4 max-w-xl text-gray-300 font-body text-lg leading-relaxed">This is not babysitting. It is a proper Joner environment for players who want to improve.</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {['Ball mastery and first touch', '1v1 moves and confidence', 'Technique under pressure', 'Game realistic decisions'].map((item) => (
            <article class="dark-card">
              <span></span>
              <strong>{item}</strong>
            </article>
          ))}
        </div>
      </div>

      <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-4">
        {campPhotoSet.slice(2, 5).map((image, index) => (
          <figure class="photo-frame h-72">
            <img src={image} alt={`Joner Football camp photo ${index + 1}`} class="h-full w-full object-cover" loading="lazy" />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section id="register" class="relative overflow-hidden bg-joner-black py-14 md:py-24">
    <img src={campPhotoSet[3]} alt="Joner Football camp players training" class="absolute inset-0 h-full w-full object-cover opacity-25" loading="lazy" />
    <div class="absolute inset-0 bg-black/78"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-[0.78fr_1.22fr] gap-8 items-start">
        <div class="booking-panel text-white">
          <p class="camp-eyebrow">Register Now</p>
          <h2 class="section-heading text-white">Book the camp spot.</h2>
          <p class="mt-4 text-gray-300 font-body leading-relaxed">Fill in the player details first. After submit, you go straight to the selected payment link.</p>
          <div class="mt-7 space-y-3">
            <div class="booking-line"><span>Camp</span><strong>{camp.title}</strong></div>
            <div class="booking-line"><span>Dates</span><strong>{camp.dates}</strong></div>
            <div class="booking-line"><span>Options</span><strong>{camp.priceLabel || dayOptions.join(', ')}</strong></div>
          </div>
        </div>

        <form id="camp-registration-form" class="camp-form bg-white text-joner-black">
          <div class="form-head">
            <p class="camp-eyebrow">Player Registration</p>
            <h3>{ctaLabel}</h3>
            <p>Required fields only where possible. Payment opens after registration saves.</p>
          </div>

          <input type="hidden" name="camp" value={camp.title} />
          <input type="hidden" name="destination" value={destination} />
          <input type="hidden" name="location" value={camp.location || ''} />
          <input type="hidden" name="sheetTab" value={camp.googleSheetTab || camp.title} />
          <input type="hidden" name="brevoListId" value={camp.brevoListId || ''} />
          <input id="payment-link-input" type="hidden" name="paymentLink" value={paymentLink} />
          <script type="application/json" id="day-payment-links" set:html={JSON.stringify(dayPaymentLinks)} />

          <div class="form-grid">
            <label><span class="form-label">Player First Name *</span><input required name="playerFirstName" class="form-input" autocomplete="given-name" /></label>
            <label><span class="form-label">Player Surname *</span><input required name="playerSurname" class="form-input" autocomplete="family-name" /></label>
            <label><span class="form-label">Parent Name If Under 18</span><input name="parentName" class="form-input" autocomplete="name" /></label>
            <label><span class="form-label">Email *</span><input required type="email" name="email" class="form-input" autocomplete="email" /></label>
            <label><span class="form-label">Player Age *</span><input required name="age" class="form-input" inputmode="numeric" /></label>
            <label><span class="form-label">Mobile Number *</span><input required name="mobile" class="form-input" autocomplete="tel" /></label>
            <label><span class="form-label">Jersey Size *</span><select required name="jerseySize" class="form-input"><option value="">Select size</option>{jerseySizes.map((size: string) => <option>{size}</option>)}</select></label>
            <label><span class="form-label">How Many Days? *</span><select id="day-option-select" required name="numberOfDays" class="form-input"><option value="">Select camp option</option>{dayOptions.map((option: string) => <option>{option}</option>)}</select></label>
          </div>

          <details class="optional-fields">
            <summary>Optional player notes</summary>
            <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
              <label><span class="form-label">Current Club / Level</span><input name="clubLevel" class="form-input" /></label>
              <label><span class="form-label">Done A Joner Camp Before?</span><select name="previousCamp" class="form-input"><option value="">Select</option><option>Yes</option><option>No</option></select></label>
            </div>
            <label class="mt-4 block"><span class="form-label">Medical Notes</span><textarea name="medicalHistory" rows="3" class="form-input"></textarea></label>
            <label class="mt-4 block"><span class="form-label">Anything Else We Should Know?</span><textarea name="extraInfo" rows="3" class="form-input"></textarea></label>
            <label class="mt-4 block"><span class="form-label">Where Did You Hear About The Camp?</span><input name="source" class="form-input" /></label>
          </details>

          <label><span class="form-label">Payment Method</span><select id="payment-method-select" name="paymentMethod" class="form-input">{paymentOptions.map((option: any) => <option value={option.value} data-link={option.link}>{option.label}</option>)}</select></label>

          <label class="flex gap-3 items-start text-gray-700 font-body text-sm">
            <input required type="checkbox" name="agreementAccepted" class="mt-1 accent-[#E30613]" />
            <span>I have read and agree to the {camp.trainingAgreementLink ? <a class="text-joner-red underline" href={camp.trainingAgreementLink} target="_blank" rel="noopener noreferrer">training agreement</a> : 'training agreement'}.</span>
          </label>

          <div id="camp-form-message" class="hidden border border-gray-700 p-4 text-sm font-body"></div>
          <button type="submit" class="btn-red w-full">{ctaLabel}</button>
        </form>
      </div>
    </div>
  </section>

  <section id="faqs" class="bg-white text-joner-black py-14 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="camp-eyebrow text-center">FAQs</p>
      <h2 class="section-heading text-joner-black text-center">Quick parent questions</h2>
      <div class="mt-8 space-y-3" id="camp-faq">
        {(camp.faqItems || commonFaqs).slice(0, 5).map((item: any) => (
          <article class="faq-item border border-gray-200 bg-white">
            <button class="faq-toggle flex min-h-[56px] w-full items-center justify-between gap-4 p-5 text-left" aria-expanded="false" type="button">
              <span class="font-heading text-base font-bold uppercase tracking-[0.08em] text-joner-black">{item.question}</span>
              <span class="faq-icon text-joner-red transition-transform">+</span>
            </button>
            <div class="faq-content hidden px-5 pb-5">
              <p class="text-gray-700 font-body leading-relaxed">{item.answer}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <a href="#register" class="camp-mobile-cta btn-red fixed bottom-[72px] left-3 right-3 z-40 text-center text-sm shadow-2xl">{ctaLabel}</a>

  <style>
    .camp-eyebrow {
      color: #E30613;
      font-family: var(--font-heading);
      font-size: .78rem;
      letter-spacing: .18em;
      text-transform: uppercase;
      margin-bottom: .75rem;
    }
    .hero-fact, .simple-card, .dark-card, .schedule-card, .booking-panel {
      border: 1px solid rgba(255,255,255,.14);
      background: rgba(10,10,10,.72);
      backdrop-filter: blur(8px);
    }
    .hero-fact { padding: 1rem; min-height: 92px; }
    .hero-fact span, .simple-card span, .booking-line span, .schedule-card span {
      display: block;
      color: #E30613;
      font-family: var(--font-heading);
      font-size: .72rem;
      letter-spacing: .14em;
      text-transform: uppercase;
      margin-bottom: .35rem;
    }
    .hero-fact strong { color: white; font-family: var(--font-body); line-height: 1.25; }
    .simple-card {
      background: #f7f7f7;
      border-color: #e5e7eb;
      min-height: 132px;
      padding: 1.35rem;
    }
    .simple-card strong {
      color: #0A0A0A;
      font-family: var(--font-body);
      font-size: 1.05rem;
      line-height: 1.35;
    }
    .dark-card {
      display: flex;
      gap: 1rem;
      align-items: center;
      min-height: 96px;
      padding: 1.35rem;
    }
    .dark-card span { width: 5px; align-self: stretch; background: #E30613; }
    .dark-card strong { font-family: var(--font-heading); text-transform: uppercase; letter-spacing: .08em; }
    .photo-frame {
      overflow: hidden;
      border: 1px solid rgba(255,255,255,.14);
      background: #0A0A0A;
      box-shadow: 0 24px 60px rgba(0,0,0,.18);
    }
    .schedule-card {
      background: #fff;
      border-color: #e5e7eb;
      min-height: 190px;
      padding: 1.5rem;
    }
    .schedule-card h3 {
      color: #0A0A0A;
      font-family: var(--font-heading);
      font-size: 1.5rem;
      font-weight: 800;
      text-transform: uppercase;
      line-height: 1;
    }
    .schedule-card p { margin-top: 1rem; color: #4b5563; font-family: var(--font-body); font-weight: 700; }
    .booking-panel { padding: 2rem; }
    .booking-line { border-left: 4px solid #E30613; padding-left: 1rem; }
    .booking-line strong { color: white; font-family: var(--font-body); line-height: 1.3; }
    .camp-form {
      padding: 1.25rem;
      box-shadow: 0 30px 80px rgba(0,0,0,.35);
    }
    @media (min-width: 768px) { .camp-form { padding: 2rem; } }
    .form-head { border-bottom: 1px solid #e5e7eb; padding-bottom: 1.25rem; margin-bottom: 1.25rem; }
    .form-head h3 { font-family: var(--font-heading); font-size: clamp(2rem, 4vw, 3rem); line-height: .95; font-weight: 800; text-transform: uppercase; color: #0A0A0A; }
    .form-head p { margin-top: .5rem; color: #4b5563; font-family: var(--font-body); }
    .form-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
    @media (min-width: 640px) { .form-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    .form-label {
      display: block;
      color: #0A0A0A;
      font-family: var(--font-heading);
      font-size: .72rem;
      text-transform: uppercase;
      letter-spacing: .1em;
      margin-bottom: .45rem;
    }
    .form-input {
      width: 100%;
      background: #f7f7f7;
      border: 1px solid #d1d5db;
      color: #0A0A0A;
      min-height: 52px;
      padding: .85rem .95rem;
      font-family: var(--font-body);
      border-radius: 0;
    }
    .form-input:focus {
      outline: 2px solid #E30613;
      outline-offset: 0;
      border-color: #E30613;
      background: #fff;
    }
    .optional-fields {
      margin: 1rem 0;
      border: 1px solid #e5e7eb;
      background: #fafafa;
      padding: 1rem;
      font-family: var(--font-body);
    }
    .optional-fields summary {
      cursor: pointer;
      font-family: var(--font-heading);
      text-transform: uppercase;
      letter-spacing: .08em;
      color: #0A0A0A;
    }
    @media (min-width: 768px) {
      .camp-mobile-cta { display: none; }
    }
  </style>

  <script>
    const form = document.querySelector('#camp-registration-form')
    const message = document.querySelector('#camp-form-message')
    const paymentSelect = document.querySelector('#payment-method-select')
    const paymentLinkInput = document.querySelector('#payment-link-input')
    const daySelect = document.querySelector('#day-option-select')
    const dayLinksScript = document.querySelector('#day-payment-links')
    const dayPaymentLinks = dayLinksScript?.textContent ? JSON.parse(dayLinksScript.textContent) : []
    const emailInput = form?.querySelector('input[type="email"]')

    if (emailInput && window.JonerEmailGuard?.protectEmailInput) {
      window.JonerEmailGuard.protectEmailInput(emailInput)
    }

    function normalizeDayLabel(value) {
      return String(value || '')
        .toLowerCase()
        .replace(/\s+-\s+.*$/, '')
        .replace(/\s+/g, ' ')
        .trim()
    }

    function findDayPaymentLink(selectedDay) {
      const selected = normalizeDayLabel(selectedDay)
      return dayPaymentLinks.find((item) => {
        const label = normalizeDayLabel(item.label)
        return item.label === selectedDay || label === selected || selected.startsWith(label) || label.startsWith(selected)
      })
    }

    function updatePaymentLink() {
      if (!paymentSelect || !paymentLinkInput) return
      const selectedPayment = paymentSelect.options[paymentSelect.selectedIndex]
      const selectedDay = daySelect?.value
      const dayMatch = findDayPaymentLink(selectedDay)

      if (selectedPayment?.value === 'PayPal' && dayMatch?.paypalPaymentLink) {
        paymentLinkInput.value = dayMatch.paypalPaymentLink
        return
      }

      if (selectedPayment?.value === 'Stripe' && dayMatch?.stripePaymentLink) {
        paymentLinkInput.value = dayMatch.stripePaymentLink
        return
      }

      if (selectedPayment?.dataset?.link) paymentLinkInput.value = selectedPayment.dataset.link
    }

    paymentSelect?.addEventListener('change', updatePaymentLink)
    daySelect?.addEventListener('change', updatePaymentLink)
    updatePaymentLink()

    document.querySelectorAll('.faq-toggle').forEach((button) => {
      button.addEventListener('click', () => {
        const item = button.closest('.faq-item')
        const content = item?.querySelector('.faq-content')
        const icon = item?.querySelector('.faq-icon')
        const isOpen = content && !content.classList.contains('hidden')

        document.querySelectorAll('.faq-item').forEach((faq) => {
          faq.querySelector('.faq-content')?.classList.add('hidden')
          const toggle = faq.querySelector('.faq-toggle')
          const faqIcon = faq.querySelector('.faq-icon')
          if (toggle) toggle.setAttribute('aria-expanded', 'false')
          if (faqIcon) faqIcon.textContent = '+'
        })

        if (!isOpen && content) {
          content.classList.remove('hidden')
          button.setAttribute('aria-expanded', 'true')
          if (icon) icon.textContent = '-'
        }
      })
    })

    form?.addEventListener('submit', async (event) => {
      event.preventDefault()
      updatePaymentLink()

      const submitButton = form.querySelector('button[type="submit"]')
      if (submitButton) {
        submitButton.disabled = true
        submitButton.textContent = 'Saving Registration...'
      }
      if (message) {
        message.className = 'border border-gray-700 p-4 text-sm font-body text-gray-300'
        message.textContent = 'Saving registration before payment.'
      }

      const formData = new FormData(form)
      const payload = Object.fromEntries(formData.entries())
      payload.agreementAccepted = formData.get('agreementAccepted') === 'on'
      payload.recaptchaToken = window.JonerRecaptcha ? await window.JonerRecaptcha.getToken('camp_registration') : ''

      try {
        const response = await fetch('/api/camp-registration', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        })
        const data = await response.json()
        if (!response.ok || !data.success) throw new Error(data.error || 'Registration failed.')

        if (message) {
          message.className = 'border border-joner-red p-4 text-sm font-body text-white bg-joner-red/10'
          message.textContent = 'Registration saved. Sending you to payment now.'
        }
        window.location.href = data.paymentLink || payload.paymentLink
      } catch (error) {
        if (message) {
          message.className = 'border border-joner-red p-4 text-sm font-body text-white bg-joner-red/10'
          message.textContent = error.message || 'Could not save registration. Please try again.'
        }
        if (submitButton) {
          submitButton.disabled = false
          submitButton.textContent = 'Submit Registration And Pay'
        }
      }
    })
  </script>
</BaseLayout>
