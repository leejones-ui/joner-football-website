    stripePaymentLink: sanityCamp?.stripePaymentLink || fallback.stripePaymentLink || 'https://app.jonerfootball.com',
    paypalPaymentLink: sanityCamp?.paypalPaymentLink || fallback.paypalPaymentLink || '',
    afterpayPaymentLink: sanityCamp?.afterpayPaymentLink || fallback.afterpayPaymentLink || '',
    trainingAgreementLink: sanityCamp?.trainingAgreementLink || fallback.trainingAgreementLink || '/terms',
