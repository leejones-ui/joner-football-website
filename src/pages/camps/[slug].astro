    heroKicker: textOrFallback(sanityCamp?.heroKicker, fallback.heroKicker, ['Joner Football x Kingdom Soccer Training']),
    heroSubtitle: textOrFallback(sanityCamp?.heroSubtitle, fallback.heroSubtitle),
    urgencyLabel: textOrFallback(sanityCamp?.urgencyLabel, fallback.urgencyLabel),
    location: textOrFallback(sanityCamp?.location, fallback.location, ['Los Angeles, USA', 'Sydney, Australia']),
    venue: textOrFallback(sanityCamp?.venue, fallback.venue),
    venueName: textOrFallback(sanityCamp?.venueName, fallback.venueName),
    venueAddress: textOrFallback(sanityCamp?.venueAddress, fallback.venueAddress),
    venueNotes: textOrFallback(sanityCamp?.venueNotes, fallback.venueNotes),
    dates: textOrFallback(sanityCamp?.dates, fallback.dates, ['June 2026', 'July 2026']),
    times: textOrFallback(sanityCamp?.times, fallback.times),
    ageRange: textOrFallback(sanityCamp?.ageRange, fallback.ageRange, ['Youth players']),
    priceLabel: textOrFallback(sanityCamp?.priceLabel, fallback.priceLabel, ['Payment link coming soon', '1 day, 2 day and 3 day options']),
    description: textOrFallback(sanityCamp?.description, fallback.description, genericDescriptions.concat(['register interest for the texas houston june joner football camp.', 'register interest for the texas dallas june joner football camp.', 'register interest for the sydney big 1 july joner football camp.'])),
    extraInfo: textOrFallback(sanityCamp?.extraInfo, fallback.extraInfo),
    heroImage: imageUrlFromSanity(sanityCamp?.heroImage) || sanityCamp?.heroImageUrl || fallback.heroImage,
    images: sanityCamp?.images || fallback.images || {},
    galleryImages: arrayOrFallback(sanityCamp?.galleryImages, fallback.galleryImages),
    trustItems: arrayOrFallback(sanityCamp?.trustItems, fallback.trustItems),
    audienceItems: arrayOrFallback(sanityCamp?.audienceItems, fallback.audienceItems || commonAudience),
    campHighlights: arrayOrFallback(sanityCamp?.campHighlights, fallback.campHighlights),
    includedItems: arrayOrFallback(sanityCamp?.includedItems, fallback.includedItems),
    trainingThemes: arrayOrFallback(sanityCamp?.trainingThemes, fallback.trainingThemes || commonThemes),
    scheduleItems: arrayOrFallback(sanityCamp?.scheduleItems, fallback.scheduleItems),
    coachProfiles: arrayOrFallback(sanityCamp?.coachProfiles, fallback.coachProfiles || commonCoaches),
    whatToBring: arrayOrFallback(sanityCamp?.whatToBring, fallback.whatToBring || commonBring),
    faqItems: arrayOrFallback(sanityCamp?.faqItems, fallback.faqItems || commonFaqs),
    dayOptions: arrayOrFallback(sanityCamp?.dayOptions, fallback.dayOptions, [genericDaySignature, '1 day|2 days|3 days']),
    jerseySizes: arrayOrFallback(sanityCamp?.jerseySizes, fallback.jerseySizes || []),
    dayPaymentLinks: Array.isArray(sanityCamp?.dayPaymentLinks) && sanityCamp.dayPaymentLinks.length ? sanityCamp.dayPaymentLinks : (Array.isArray(sanityCamp?.paymentOptions) && sanityCamp.paymentOptions.length ? sanityCamp.paymentOptions : fallback.dayPaymentLinks || []),
    paymentOptions: Array.isArray(sanityCamp?.paymentOptions) ? sanityCamp.paymentOptions : fallback.paymentOptions || [],
    defaultPaymentMethod: sanityCamp?.defaultPaymentMethod || fallback.defaultPaymentMethod || 'Stripe',
    enableStripe: sanityCamp?.enableStripe !== false,
    enablePayPal: sanityCamp?.enablePayPal === true,
    mentionAfterpay: sanityCamp?.mentionAfterpay === true,
    paymentPendingMessage: sanityCamp?.paymentPendingMessage || fallback.paymentPendingMessage || 'NOT PAID YET, payment link selected and sent to parent',
    stripePaymentLink: sanityCamp?.enableStripe === false ? '' : (sanityCamp?.stripePaymentLink || fallback.stripePaymentLink || 'https://app.jonerfootball.com'),
    paypalPaymentLink: sanityCamp?.enablePayPal === true ? (sanityCamp?.paypalPaymentLink || fallback.paypalPaymentLink || '') : '',
    afterpayPaymentLink: sanityCamp?.afterpayPaymentLink || fallback.afterpayPaymentLink || '',
    trainingAgreementLink: sanityCamp?.trainingAgreementLink || fallback.trainingAgreementLink || '/terms',
    googleSheetTab: textOrFallback(sanityCamp?.googleSheetTab, fallback.googleSheetTab),
    destination: textOrFallback(sanityCamp?.destination, fallback.destination),
    brevoListId: sanityCamp?.brevoListId || fallback.brevoListId || '',
    startDate: sanityCamp?.startDate || fallback.startDate,
    endDate: sanityCamp?.endDate || fallback.endDate,
    mapUrl: sanityCamp?.mapUrl || fallback.mapUrl,
  }
}

export async function getStaticPaths() {
  let sanitySlugs: string[] = []
  const fallbackSlugs = [
    'texas-dallas-june',
    'sydney-big-1-july',
    'sydney-july-2026',
  ]
  const staticCampSlugs = ['la-tcpe-june', 'texas-houston-june', 'texas-dallas-june', 'sydney-july-2026', 'test-signup']

  try {
    const camps = await sanityClient.fetch(`*[_type == "camp" && defined(slug.current)]{ "slug": slug.current }`)
    sanitySlugs = camps.map((camp: { slug: string }) => camp.slug).filter(Boolean)
  } catch (error) {
    sanitySlugs = []
  }

  const slugs = Array.from(new Set([...fallbackSlugs, ...sanitySlugs]))
    .filter((campSlug) => !staticCampSlugs.includes(campSlug))
  return slugs.map((campSlug) => ({ params: { slug: campSlug } }))
}

const slug = Astro.params.slug || ''
let sanityCamp: CampMap | null = null

try {
  sanityCamp = await sanityClient.fetch(`*[_type == "camp" && slug.current == $slug][0]{
    title,
    status,
    heroKicker,
    heroSubtitle,
    urgencyLabel,
    location,
    destination,
    googleSheetTab,
    venue,
    venueName,
    venueAddress,
    venueNotes,
    mapUrl,
    dates,
    startDate,
    endDate,
    times,
    ageRange,
    priceLabel,
    spotsTotal,
    spotsRemaining,
    jerseySizes,
    dayOptions,
    dayPaymentLinks,
    paymentOptions,
    defaultPaymentMethod,
    enableStripe,
    enablePayPal,
    mentionAfterpay,
    paymentPendingMessage,
    description,
    trustItems,
    audienceItems,
    campHighlights,
    includedItems,
    trainingThemes,
    scheduleItems,
    coachProfiles[]{
      name,
      role,
      bio,
      "image": image.asset->url
    },
    galleryImages[]{
      alt,
      caption,
      hideImage,
      "url": image.asset->url,
      "mobileUrl": mobileImage.asset->url
    },
    whatToBring,
    faqItems,
    extraInfo,
    heroImageUrl,
    "heroImage": heroImage.asset->url,
    stripePaymentLink,
    afterpayPaymentLink,
    paypalPaymentLink,
    trainingAgreementLink,
    brevoListId
  }`, { slug })
} catch (error) {
  sanityCamp = null
}

const fallbackCamp = CAMP_FALLBACKS[slug]
if (!fallbackCamp && !sanityCamp) return Astro.redirect('/camps')

let camp = mergeCamp(sanityCamp || {}, fallbackCamp || {})

const SYDNEY_STRIPE_PAYMENT_LINKS = [
