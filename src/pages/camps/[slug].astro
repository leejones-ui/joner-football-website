    brevoListId: sanityCamp?.brevoListId || fallback.brevoListId || '',
    startDate: sanityCamp?.startDate || fallback.startDate,
    endDate: sanityCamp?.endDate || fallback.endDate,
    mapUrl: sanityCamp?.mapUrl || fallback.mapUrl,
