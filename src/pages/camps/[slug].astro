          <label><span class="mb-2 block font-heading text-xs uppercase tracking-[0.12em] text-joner-black">Where Did You Hear About The Camp? *</span><select required name="heardAboutCamp" class="min-h-[52px] w-full border border-gray-300 bg-gray-50 px-4 py-3 font-body text-base text-joner-black focus:border-joner-red focus:bg-white focus:outline-none"><option value="">Select</option><option>Instagram</option><option>Facebook</option><option>Google</option><option>YouTube</option><option>Email</option><option>Friend / word of mouth</option><option>Previous Joner player</option><option>Coach / club</option><option>Other</option></select></label>
        </div>

        <details class="my-5 border border-gray-200 bg-gray-50 p-4 font-body">
