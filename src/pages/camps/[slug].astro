    ...sanityCamp,
    title: textOrFallback(sanityCamp?.title, fallback.title, [
      'LA TCPE June Camp',
      'Texas Houston June Camp',
      'Texas Dallas June Camp',
      'Sydney Big 1 July Camp',
    ]),
