        <label class="block"><span class="mb-2 block font-heading text-xs uppercase tracking-[0.12em] text-joner-black">Payment Method</span><select id="payment-method-select" name="paymentMethod" class="min-h-[52px] w-full border border-gray-300 bg-gray-50 px-4 py-3 font-body text-base text-joner-black focus:border-joner-red focus:bg-white focus:outline-none">{paymentOptions.map((option: any) => <option value={option.value} data-link={option.link}>{option.label}</option>)}</select></label>

        <label class="mt-5 flex gap-3 font-body text-sm text-gray-700">
          <input required type="checkbox" name="agreementAccepted" class="mt-1 accent-[#E30613]" />
