  { label: '2 Days - $250 AUD', stripePaymentLink: 'https://buy.stripe.com/cNi4gz7JGgkKgns1LF5Vu0h' },
  { label: '3 Days - $350 AUD', stripePaymentLink: 'https://buy.stripe.com/9B6fZh5By4C2dbgcqj5Vu0i' },
]

if (slug === 'sydney-big-1-july' || slug === 'sydney-july-2026') {
  camp = {
    ...camp,
    dayPaymentLinks: SYDNEY_STRIPE_PAYMENT_LINKS,
    stripePaymentLink: 'https://buy.stripe.com/9B6fZh5By4C2dbgcqj5Vu0i',
    enableStripe: true,
    enablePayPal: false,
  }
}

const jerseySizes = camp.jerseySizes?.length
  ? camp.jerseySizes
  : ['Youth XS', 'Youth S', 'Youth M', 'Youth L', 'Youth XL', 'Adult S', 'Adult M', 'Adult L', 'Adult XL']
const dayOptions = camp.dayOptions?.length ? camp.dayOptions : ['Full Camp']
const dayPaymentLinks = camp.dayPaymentLinks || []
const stripePaymentLink = camp.stripePaymentLink || camp.afterpayPaymentLink || 'https://app.jonerfootball.com'
const paypalPaymentLink = camp.enablePayPal ? (camp.paypalPaymentLink || '') : ''
const dayLevelPaypalLink = camp.enablePayPal ? (dayPaymentLinks.find((item: any) => item?.paypalPaymentLink)?.paypalPaymentLink || '') : ''
const paymentOptions = [
  camp.enableStripe && { label: 'Pay with Stripe', value: 'Stripe', link: stripePaymentLink },
  camp.enablePayPal && (paypalPaymentLink || dayLevelPaypalLink) && { label: 'Pay with PayPal', value: 'PayPal', link: paypalPaymentLink || dayLevelPaypalLink },
].filter(Boolean)
const paymentLink = stripePaymentLink || paypalPaymentLink || 'https://app.jonerfootball.com'
const destination = camp.destination || (String(camp.location || '').toLowerCase().includes('sydney') ? 'sydney' : 'usa')
const rawImages = camp.images || {}
const heroImage = rawImages.heroPoster || camp.heroImage || '/images/camps/hero-bg.webp'
const heroPosterAlt = `${camp.title} players training`
function configuredSrc(item: any, fallback = heroImage) {
  if (typeof item === 'string') return item
  return item?.src || item?.url || fallback
}
function configuredAlt(item: any, fallback: string) {
  return typeof item === 'object' && item?.alt ? item.alt : fallback
}
const galleryFallbacks = (camp.galleryImages || []).map((item: any) => configuredSrc(item, heroImage)).filter(Boolean)
const campImages = {
  heroVideoYoutubeId: rawImages.heroVideoYoutubeId || '',
  heroVideoLocal: rawImages.heroVideoLocal || camp.heroVideo || '',
  heroPoster: rawImages.heroPoster || heroImage,
  promiseImage: rawImages.promiseImage || galleryFallbacks[0] || heroImage,
  valueTiles: rawImages.valueTiles?.length
    ? rawImages.valueTiles
    : galleryFallbacks.slice(0, 4).map((src: string) => ({ src, alt: `${camp.title} camp training image` })),
  gallery: rawImages.gallery?.length ? rawImages.gallery : galleryFallbacks,
  scheduleImages: rawImages.scheduleImages?.length ? rawImages.scheduleImages : galleryFallbacks.slice(0, 3),
  includedTile: rawImages.includedTile || galleryFallbacks[0] || heroImage,
  coachPortrait: rawImages.coachPortrait || galleryFallbacks[1] || heroImage,
  testimonialBackdrop: rawImages.testimonialBackdrop || galleryFallbacks[2] || heroImage,
  bookingBackdrop: rawImages.bookingBackdrop || galleryFallbacks[3] || heroImage,
  finaleBackdrop: rawImages.finaleBackdrop || heroImage,
}
const heroYoutubeSrc = campImages.heroVideoYoutubeId
  ? `https://www.youtube-nocookie.com/embed/${campImages.heroVideoYoutubeId}?rel=0&controls=0&modestbranding=1&playsinline=1&loop=1&playlist=${campImages.heroVideoYoutubeId}&mute=1&autoplay=1`
  : ''
const ogImage = heroImage.startsWith('http') ? heroImage : `https://jonerfootball.com${heroImage}`
const campSeoDescriptions: Record<string, string> = {
  'sydney-big-1-july': 'Book the Sydney July Joner Football camp with Miguel Grande. Three high-energy mornings for players who want sharper technique and more confidence.',
  'sydney-july-2026': 'Book the Sydney July Joner Football camp with Miguel Grande. Three high-energy mornings for players who want sharper technique and more confidence.',
}
const pageDescription = campSeoDescriptions[slug] || camp.description || `Register for ${camp.title} with Joner Football.`
const canonical = `https://jonerfootball.com/camps/${slug}/`
