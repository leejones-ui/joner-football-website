    venueNotes,
    mapUrl,
    dates,
    startDate,
    endDate,
    times,
    ageRange,
    priceLabel,
    spotsTotal,
    spotsRemaining,
    jerseySizes,
    dayOptions,
    dayPaymentLinks,
    description,
    trustItems,
    audienceItems,
    campHighlights,
    includedItems,
    trainingThemes,
    scheduleItems,
    coachProfiles[]{
      name,
      role,
      bio,
      "image": image.asset->url
    },
    galleryImages[]{
      alt,
      caption,
      "url": image.asset->url
    },
    whatToBring,
    faqItems,
    extraInfo,
    "heroImage": heroImage.asset->url,
    stripePaymentLink,
    afterpayPaymentLink,
    paypalPaymentLink,
    trainingAgreementLink,
    brevoListId
  }`, { slug })
} catch (error) {
  sanityCamp = null
}

const fallbackCamp = CAMP_FALLBACKS[slug]
if (!fallbackCamp && !sanityCamp) return Astro.redirect('/camps')

const camp = mergeCamp(sanityCamp || {}, fallbackCamp || {})
const jerseySizes = camp.jerseySizes?.length
  ? camp.jerseySizes
  : ['Youth XS', 'Youth S', 'Youth M', 'Youth L', 'Youth XL', 'Adult S', 'Adult M', 'Adult L', 'Adult XL']
const dayOptions = camp.dayOptions?.length ? camp.dayOptions : ['Full Camp']
const dayPaymentLinks = camp.dayPaymentLinks || []
const stripePaymentLink = camp.stripePaymentLink || camp.afterpayPaymentLink || 'https://app.jonerfootball.com'
const paypalPaymentLink = camp.paypalPaymentLink || ''
const dayLevelPaypalLink = dayPaymentLinks.find((item: any) => item?.paypalPaymentLink)?.paypalPaymentLink || ''
const paymentOptions = [
  { label: 'Pay with Stripe', value: 'Stripe', link: stripePaymentLink },
  (paypalPaymentLink || dayLevelPaypalLink) && { label: 'Pay with PayPal', value: 'PayPal', link: paypalPaymentLink || dayLevelPaypalLink },
].filter(Boolean)
const paymentLink = stripePaymentLink || paypalPaymentLink || 'https://app.jonerfootball.com'
const destination = camp.destination || (String(camp.location || '').toLowerCase().includes('sydney') ? 'sydney' : 'usa')
const heroImage = camp.heroImage || '/images/camps/hero-bg.webp'
const heroVideo = camp.heroVideo || ''
const ogImage = heroImage.startsWith('http') ? heroImage : `https://jonerfootball.com${heroImage}`
const pageDescription = camp.description || `Register for ${camp.title} with Joner Football.`
const canonical = `https://jonerfootball.com/camps/${slug}/`
const statusLabel = camp.status === 'sold-out' ? 'Sold out' : camp.status === 'coming-soon' ? 'Coming soon' : 'Registration open'
const spotsLabel = camp.spotsRemaining || camp.spotsTotal
  ? `${camp.spotsRemaining || camp.spotsTotal} spots`
  : camp.urgencyLabel

const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: `${camp.title} | Joner Football Camp`,
  description: pageDescription,
  startDate: camp.startDate,
  endDate: camp.endDate || camp.startDate,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: camp.status === 'sold-out' || camp.status === 'closed'
    ? 'https://schema.org/EventScheduled'
    : 'https://schema.org/EventScheduled',
  location: {
    '@type': 'Place',
    name: camp.venueName || camp.venue || camp.location,
    address: {
      '@type': 'PostalAddress',
      streetAddress: camp.venueAddress || camp.venue,
      addressLocality: camp.location,
    },
  },
  organizer: {
    '@type': 'Organization',
    name: 'Joner Football',
    url: 'https://jonerfootball.com',
  },
  image: ogImage,
}

const faqSchema = camp.faqItems?.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: camp.faqItems.map((item: any) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
} : null
---

<BaseLayout
  title={`${camp.title} | Joner Football Camps`}
  description={pageDescription}
  canonical={canonical}
  ogImage={ogImage}
  schema={faqSchema ? [eventSchema, faqSchema] : [eventSchema]}
>
  <section id="overview" class="relative min-h-[86vh] overflow-hidden bg-joner-black">
    {heroVideo ? (
      <video autoplay muted loop playsinline poster={heroImage} class="absolute inset-0 h-full w-full object-cover">
        <source src={heroVideo} type="video/mp4" />
      </video>
    ) : (
      <img src={heroImage} alt={`${camp.title} with Joner Football players training`} class="absolute inset-0 h-full w-full object-cover" loading="eager" />
    )}
    <div class="absolute inset-0 bg-gradient-to-r from-joner-black via-joner-black/80 to-joner-black/30"></div>
    <div class="absolute inset-x-0 top-0 h-1 bg-joner-red"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-20 md:pt-32">
      <a href="/camps" class="inline-flex min-h-[44px] items-center text-sm font-body text-gray-300 hover:text-white">Back to all camps</a>
      <div class="grid grid-cols-1 gap-10 items-end mt-8">
        <div>
          <div class="flex flex-wrap items-center gap-3 mb-5">
            <span class="bg-joner-red px-3 py-2 font-heading text-xs uppercase tracking-[0.18em] text-white">{camp.heroKicker || 'Elite Camp'}</span>
            <span class="border border-white/20 bg-black/40 px-3 py-2 font-heading text-xs uppercase tracking-[0.18em] text-white">{statusLabel}</span>
          </div>
          <h1 class="font-heading text-4xl sm:text-6xl lg:text-7xl font-bold text-white uppercase leading-none max-w-5xl">{camp.title}</h1>
          <p class="mt-6 max-w-3xl text-lg md:text-xl text-gray-200 font-body leading-relaxed">{camp.heroSubtitle || camp.description}</p>
          <div class="mt-8 grid grid-cols-2 md:grid-cols-4 gap-3 max-w-4xl">
            <div class="camp-stat"><span>Location</span><strong>{camp.location}</strong></div>
            <div class="camp-stat"><span>Dates / Times</span><strong>{camp.dates}<br />{camp.times}</strong></div>
            <div class="camp-stat"><span>Ages</span><strong>{camp.ageRange}</strong></div>
            <div class="camp-stat"><span>Spots</span><strong>{spotsLabel}</strong></div>
          </div>
          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a href="#register" class="btn-red text-center">Register Now</a>
            <a href="#what-you-get" class="btn-outline text-center">See What You Get</a>
          </div>
        </div>
        </div>
      </div>
    </div>
  </section>

  <nav class="sticky top-16 z-30 border-y border-gray-800 bg-joner-black/95 backdrop-blur" aria-label="Camp sections">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex gap-2 overflow-x-auto py-3 scrollbar-hide">
        {[
          ['Overview', '#overview'],
          ['What You Get', '#what-you-get'],
          ['Schedule', '#schedule'],
          ['Coaches', '#coaches'],
          ['Location', '#location'],
          ['FAQs', '#faqs'],
          ['Register', '#register'],
        ].map(([label, href]) => (
          <a href={href} class="shrink-0 border border-gray-800 px-4 py-2 font-heading text-xs uppercase tracking-[0.16em] text-gray-300 hover:border-joner-red hover:text-white">{label}</a>
        ))}
      </div>
    </div>
  </nav>

  <section class="bg-joner-red py-5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
        {(camp.trustItems || []).slice(0, 4).map((item: string) => (
          <div class="font-heading text-sm uppercase tracking-[0.14em] text-white">{item}</div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-joner-black py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.15fr] gap-10 items-start">
        <div>
          <p class="camp-eyebrow">Overview</p>
          <h2 class="section-heading text-white">Built For Serious Development</h2>
          <p class="mt-5 text-gray-300 font-body text-lg leading-relaxed">{camp.description}</p>
          {camp.extraInfo && <p class="mt-4 text-gray-400 font-body leading-relaxed">{camp.extraInfo}</p>}
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {(camp.audienceItems || commonAudience).map((item: any) => (
            <article class="border border-gray-200 bg-white p-6">
              <h3 class="font-heading text-2xl font-bold text-joner-black uppercase">{item.title}</h3>
              <p class="mt-3 text-gray-700 font-body leading-relaxed">{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  {camp.featureVideoUrl && (
    <section class="bg-joner-black py-16 md:py-24 border-t border-gray-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-[0.75fr_1.25fr] gap-8 items-center">
        <div>
          <p class="camp-eyebrow">A Sneak Peek</p>
          <h2 class="section-heading text-white">Our Camps Come With Energy</h2>
          <p class="mt-5 text-gray-300 font-body text-lg leading-relaxed">A quick look at the pace, energy, and standards players can expect at a Joner Football elite camp.</p>
        </div>
        <div class="aspect-video overflow-hidden border border-gray-800 bg-white">
          <iframe src={camp.featureVideoUrl} title={`${camp.title} camp video`} class="h-full w-full" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
        </div>
      </div>
    </section>
  )}

  <section id="what-you-get" class="scroll-mt-36 bg-white text-joner-black py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="camp-eyebrow">What You Get</p>
        <h2 class="section-heading text-joner-black">A Proper Joner Camp Experience</h2>
      </div>
      <div class="mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {(camp.campHighlights || []).map((item: any) => (
          <article class="border border-gray-800 bg-joner-black p-6">
            <div class="mb-5 h-1 w-12 bg-joner-red"></div>
            <h3 class="font-heading text-xl font-bold text-white uppercase">{item.title}</h3>
            <p class="mt-3 text-sm text-gray-300 font-body leading-relaxed">{item.description}</p>
          </article>
        ))}
      </div>
      <div class="mt-10 grid grid-cols-1 lg:grid-cols-[1fr_0.8fr] gap-8">
        <div class="border border-gray-800 bg-joner-black p-6 md:p-8">
          <h3 class="font-heading text-2xl font-bold text-white uppercase">Included</h3>
          <ul class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3">
            {(camp.includedItems || []).map((item: string) => (
              <li class="flex gap-3 text-gray-300 font-body"><span class="mt-1 h-2 w-2 shrink-0 bg-joner-red"></span><span>{item}</span></li>
            ))}
          </ul>
        </div>
        <div id="options" class="scroll-mt-36 border border-joner-red bg-joner-black p-6 md:p-8">
          <p class="camp-eyebrow">Day Options</p>
          <h3 class="font-heading text-2xl font-bold text-white uppercase">Choose Your Camp Option</h3>
          <p class="mt-3 text-gray-400 font-body">Select your option in the registration form. The checkout link updates from the selected day and payment method.</p>
          <div class="mt-6 space-y-3">
            {dayOptions.map((option: string) => (
              <a href="#register" class="flex items-center justify-between gap-4 border border-white/20 bg-white px-4 py-4 hover:border-joner-red">
                <span class="font-heading text-joner-black uppercase tracking-[0.08em]">{option}</span>
                <span class="font-heading text-xs uppercase tracking-[0.14em] text-joner-red">Register</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-joner-black py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <p class="camp-eyebrow">Training Themes</p>
        <h2 class="section-heading text-white">Technique Above Everything</h2>
      </div>
      <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {(camp.trainingThemes || commonThemes).map((theme: any) => (
          <article class="border border-gray-800 p-6 hover:border-joner-red transition-colors">
            <h3 class="font-heading text-xl font-bold text-white uppercase">{theme.title}</h3>
            <p class="mt-3 text-gray-300 font-body leading-relaxed">{theme.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="schedule" class="scroll-mt-36 bg-white text-joner-black py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="camp-eyebrow text-center">Schedule</p>
      <h2 class="section-heading text-joner-black text-center">Camp Timeline</h2>
      <div class="mt-12 space-y-4">
        {(camp.scheduleItems || []).map((item: any, index: number) => (
          <article class="grid grid-cols-1 md:grid-cols-[180px_1fr] gap-4 border border-gray-200 bg-white p-5 md:p-6">
            <div class="flex md:block items-center gap-3">
              <span class="inline-flex h-10 w-10 items-center justify-center bg-joner-red font-heading font-bold text-white">{index + 1}</span>
              <p class="font-heading text-sm uppercase tracking-[0.14em] text-joner-red md:mt-4">{item.time}</p>
            </div>
            <div>
              <h3 class="font-heading text-2xl font-bold text-joner-black uppercase">{item.title}</h3>
              <p class="mt-2 text-gray-400 font-body leading-relaxed">{item.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="coaches" class="scroll-mt-36 bg-joner-black py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-5 mb-10">
        <div>
          <p class="camp-eyebrow">Coaches</p>
          <h2 class="section-heading text-white">Led By Football People</h2>
        </div>
        <p class="max-w-xl text-gray-400 font-body">Every camp is built around standards, detail, and a coaching team that cares about player development.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {(camp.coachProfiles || commonCoaches).slice(0, 3).map((coach: any) => (
          <article class="border border-gray-200 bg-white overflow-hidden">
            <div class="h-56 bg-joner-black">
              <img src={coach.image || '/images/about/coaching-team.webp'} alt={`${coach.name} coaching at Joner Football`} class="h-full w-full object-cover" loading="lazy" />
            </div>
            <div class="p-6">
              <h3 class="font-heading text-2xl font-bold text-joner-black uppercase">{coach.name}</h3>
              <p class="mt-1 font-heading text-xs uppercase tracking-[0.16em] text-joner-red">{coach.role}</p>
              <p class="mt-4 text-gray-700 font-body leading-relaxed">{coach.bio}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="location" class="scroll-mt-36 bg-white text-joner-black py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr] gap-8">
        <div class="border border-gray-800 bg-joner-black p-6 md:p-8">
          <p class="camp-eyebrow">Venue</p>
          <h2 class="section-heading text-white">{camp.venueName || 'Camp Venue'}</h2>
          <p class="mt-4 text-gray-300 font-body text-lg">{camp.venueAddress || camp.venue}</p>
          <p class="mt-4 text-gray-300 font-body leading-relaxed">{camp.venueNotes}</p>
          {camp.mapUrl && <a href={camp.mapUrl} target="_blank" rel="noopener noreferrer" class="btn-red mt-6">Open In Maps</a>}
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {(camp.galleryImages || []).slice(0, 3).map((image: any) => (
            <figure class="min-h-[260px] overflow-hidden border border-gray-800 bg-joner-black">
              <img src={image.url} alt={image.alt || `${camp.title} camp photo`} class="h-full w-full object-cover hover:scale-105 transition-transform duration-300" loading="lazy" />
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-joner-black py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-[0.8fr_1.2fr] gap-8">
        <div>
          <p class="camp-eyebrow">What To Bring</p>
          <h2 class="section-heading text-white">Arrive Ready</h2>
          <p class="mt-4 text-gray-400 font-body">Everything is set up for players to train properly. Bring the essentials and come ready to work.</p>
        </div>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {(camp.whatToBring || commonBring).map((item: string) => (
            <li class="flex gap-3 border border-white/20 bg-white p-4 text-joner-black font-body"><span class="mt-1 h-2 w-2 shrink-0 bg-joner-red"></span><span>{item}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="faqs" class="scroll-mt-36 bg-white text-joner-black py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="camp-eyebrow text-center">FAQs</p>
      <h2 class="section-heading text-joner-black text-center">Parent Questions</h2>
      <div class="mt-10 space-y-3" id="camp-faq">
        {(camp.faqItems || commonFaqs).map((item: any) => (
          <article class="faq-item border border-gray-200 bg-white">
            <button class="faq-toggle flex min-h-[56px] w-full items-center justify-between gap-4 p-5 text-left" aria-expanded="false" type="button">
              <span class="font-heading text-base font-bold uppercase tracking-[0.08em] text-joner-black">{item.question}</span>
              <span class="faq-icon text-joner-red transition-transform">+</span>
            </button>
            <div class="faq-content hidden px-5 pb-5">
              <p class="text-gray-700 font-body leading-relaxed">{item.answer}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="register" class="scroll-mt-36 bg-joner-black py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.15fr] gap-8 items-start">
        <div class="lg:sticky lg:top-36 border border-gray-200 bg-white text-joner-black p-6 md:p-8">
          <p class="camp-eyebrow">Register</p>
          <h2 class="section-heading text-joner-black">Secure Your Place</h2>
          <p class="mt-4 text-gray-700 font-body leading-relaxed">Submit the registration first. Once it is saved, you will be sent to the selected payment link to complete the booking.</p>
          <div class="mt-6 space-y-4">
            <div class="camp-mini"><span>Camp</span><strong>{camp.title}</strong></div>
            <div class="camp-mini"><span>Dates</span><strong>{camp.dates}</strong></div>
            <div class="camp-mini"><span>Venue</span><strong>{camp.venueName || camp.venue}</strong></div>
          </div>
        </div>

        <form id="camp-registration-form" class="border border-gray-200 bg-white text-joner-black p-5 md:p-8 space-y-5">
          <h3 class="font-heading text-3xl font-bold text-joner-black uppercase">Player Registration</h3>
          <p class="text-gray-600 font-body text-sm">All fields marked with * are required.</p>

          <input type="hidden" name="camp" value={camp.title} />
          <input type="hidden" name="destination" value={destination} />
          <input type="hidden" name="location" value={camp.location || ''} />
          <input type="hidden" name="sheetTab" value={camp.googleSheetTab || camp.title} />
          <input type="hidden" name="brevoListId" value={camp.brevoListId || ''} />
          <input id="payment-link-input" type="hidden" name="paymentLink" value={paymentLink} />
          <script type="application/json" id="day-payment-links" set:html={JSON.stringify(dayPaymentLinks)} />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <label><span class="form-label">Player First Name *</span><input required name="playerFirstName" class="form-input" autocomplete="given-name" /></label>
            <label><span class="form-label">Player Surname *</span><input required name="playerSurname" class="form-input" autocomplete="family-name" /></label>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <label><span class="form-label">Parent Name If Under 18</span><input name="parentName" class="form-input" autocomplete="name" /></label>
            <label><span class="form-label">Email *</span><input required type="email" name="email" class="form-input" autocomplete="email" /></label>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <label><span class="form-label">Current Age *</span><input required name="age" class="form-input" inputmode="numeric" /></label>
            <label><span class="form-label">Mobile Number *</span><input required name="mobile" class="form-input" autocomplete="tel" /></label>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <label><span class="form-label">Done A Joner Camp Before?</span><select name="previousCamp" class="form-input"><option value="">Select</option><option>Yes</option><option>No</option></select></label>
            <label><span class="form-label">Current Club / Level</span><input name="clubLevel" class="form-input" /></label>
          </div>
          <label><span class="form-label">Where Did You Hear About The Elite Camp?</span><input name="source" class="form-input" /></label>
          <label><span class="form-label">Medical History</span><textarea name="medicalHistory" rows="3" class="form-input"></textarea></label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <label><span class="form-label">Jersey Size *</span><select required name="jerseySize" class="form-input"><option value="">Select size</option>{jerseySizes.map((size: string) => <option>{size}</option>)}</select></label>
            <label><span class="form-label">How Many Days? *</span><select id="day-option-select" required name="numberOfDays" class="form-input"><option value="">Select</option>{dayOptions.map((option: string) => <option>{option}</option>)}</select></label>
          </div>
          <label><span class="form-label">Extra Player Info</span><textarea name="extraInfo" rows="3" class="form-input"></textarea></label>
          <label><span class="form-label">Payment Method</span><select id="payment-method-select" name="paymentMethod" class="form-input">{paymentOptions.map((option: any) => <option value={option.value} data-link={option.link}>{option.label}</option>)}</select></label>

          <label class="flex gap-3 items-start text-gray-300 font-body text-sm">
            <input required type="checkbox" name="agreementAccepted" class="mt-1 accent-[#E30613]" />
            <span>I have read and agree to the {camp.trainingAgreementLink ? <a class="text-white underline" href={camp.trainingAgreementLink} target="_blank" rel="noopener noreferrer">training agreement</a> : 'training agreement'}.</span>
          </label>

          <div id="camp-form-message" class="hidden border border-gray-700 p-4 text-sm font-body"></div>
          <button type="submit" class="btn-red w-full">Submit Registration And Pay</button>
        </form>
      </div>
    </div>
  </section>

  <section class="bg-joner-red py-14 md:py-18">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="font-heading text-3xl md:text-5xl font-bold uppercase text-white">Do Not Wait Until It Is Full</h2>
      <p class="mt-4 text-white/85 font-body text-lg">Joner Football camps move fast. Register now and lock in your place for {camp.title}.</p>
      <a href="#register" class="mt-7 inline-block bg-white px-8 py-4 font-heading text-sm font-bold uppercase tracking-[0.14em] text-joner-red hover:bg-gray-100">Register Now</a>
    </div>
  </section>

  <a href="#register" class="fixed bottom-[72px] left-3 right-3 z-40 md:hidden btn-red text-center text-sm shadow-2xl">Register For This Camp</a>

  <style>
    .camp-eyebrow {
      color: #E30613;
      font-family: var(--font-heading);
      font-size: .82rem;
      letter-spacing: .18em;
      text-transform: uppercase;
      margin-bottom: .75rem;
    }
    .camp-stat {
      min-height: 92px;
      border: 1px solid rgba(255,255,255,.16);
      background: rgba(10,10,10,.72);
      padding: 1rem;
      backdrop-filter: blur(8px);
    }
    .camp-stat span,
    .camp-mini span,
    dl dt {
      display: block;
      color: #E30613;
      font-family: var(--font-heading);
      font-size: .72rem;
      letter-spacing: .14em;
      text-transform: uppercase;
      margin-bottom: .3rem;
    }
    .camp-stat strong,
    .camp-mini strong,
    dl dd {
      color: #fff;
      font-family: var(--font-body);
      font-weight: 700;
      line-height: 1.25;
      margin: 0;
    }
    .camp-mini {
      border-left: 3px solid #E30613;
      padding-left: 1rem;
    }
    .form-label {
      display: block;
      color: #fff;
      font-family: var(--font-heading);
      font-size: .72rem;
      text-transform: uppercase;
      letter-spacing: .1em;
      margin-bottom: .45rem;
    }
    .form-input {
      width: 100%;
      background: #0A0A0A;
      border: 1px solid #333;
      color: #fff;
      min-height: 48px;
      padding: .8rem .9rem;
      font-family: var(--font-body);
      border-radius: 0;
    }
    .form-input:focus {
      outline: 2px solid #E30613;
      outline-offset: 0;
      border-color: #E30613;
    }
  </style>

  <script>
    const form = document.querySelector('#camp-registration-form')
    const message = document.querySelector('#camp-form-message')
    const paymentSelect = document.querySelector('#payment-method-select')
    const paymentLinkInput = document.querySelector('#payment-link-input')
    const daySelect = document.querySelector('#day-option-select')
    const dayLinksScript = document.querySelector('#day-payment-links')
    const dayPaymentLinks = dayLinksScript?.textContent ? JSON.parse(dayLinksScript.textContent) : []
    const emailInput = form?.querySelector('input[type="email"]')

    if (emailInput && window.JonerEmailGuard?.protectEmailInput) {
      window.JonerEmailGuard.protectEmailInput(emailInput)
    }

    function normalizeDayLabel(value) {
      return String(value || '')
        .toLowerCase()
        .replace(/\s+-\s+.*$/, '')
        .replace(/\s+/g, ' ')
        .trim()
    }

    function findDayPaymentLink(selectedDay) {
      const selected = normalizeDayLabel(selectedDay)
      return dayPaymentLinks.find((item) => {
        const label = normalizeDayLabel(item.label)
        return item.label === selectedDay || label === selected || selected.startsWith(label) || label.startsWith(selected)
      })
    }

    function updatePaymentLink() {
      if (!paymentSelect || !paymentLinkInput) return
      const selectedPayment = paymentSelect.options[paymentSelect.selectedIndex]
      const selectedDay = daySelect?.value
      const dayMatch = findDayPaymentLink(selectedDay)

      if (selectedPayment?.value === 'PayPal' && dayMatch?.paypalPaymentLink) {
        paymentLinkInput.value = dayMatch.paypalPaymentLink
        return
      }

      if (selectedPayment?.value === 'Stripe' && dayMatch?.stripePaymentLink) {
        paymentLinkInput.value = dayMatch.stripePaymentLink
        return
      }

      if (selectedPayment?.dataset?.link) paymentLinkInput.value = selectedPayment.dataset.link
    }

    paymentSelect?.addEventListener('change', updatePaymentLink)
    daySelect?.addEventListener('change', updatePaymentLink)
    updatePaymentLink()

    document.querySelectorAll('.faq-toggle').forEach((button) => {
      button.addEventListener('click', () => {
        const item = button.closest('.faq-item')
        const content = item?.querySelector('.faq-content')
        const icon = item?.querySelector('.faq-icon')
        const isOpen = content && !content.classList.contains('hidden')

        document.querySelectorAll('.faq-item').forEach((faq) => {
          faq.querySelector('.faq-content')?.classList.add('hidden')
          const toggle = faq.querySelector('.faq-toggle')
          const faqIcon = faq.querySelector('.faq-icon')
          if (toggle) toggle.setAttribute('aria-expanded', 'false')
          if (faqIcon) faqIcon.textContent = '+'
        })

        if (!isOpen && content) {
          content.classList.remove('hidden')
          button.setAttribute('aria-expanded', 'true')
          if (icon) icon.textContent = '-'
        }
      })
    })

    form?.addEventListener('submit', async (event) => {
      event.preventDefault()
      updatePaymentLink()

      const submitButton = form.querySelector('button[type="submit"]')
      if (submitButton) {
        submitButton.disabled = true
        submitButton.textContent = 'Saving Registration...'
      }
      if (message) {
        message.className = 'border border-gray-700 p-4 text-sm font-body text-gray-300'
        message.textContent = 'Saving registration before payment.'
      }

      const formData = new FormData(form)
      const payload = Object.fromEntries(formData.entries())
      payload.agreementAccepted = formData.get('agreementAccepted') === 'on'

      try {
        const response = await fetch('/api/camp-registration', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        })
        const data = await response.json()
        if (!response.ok || !data.success) throw new Error(data.error || 'Registration failed.')

        if (message) {
          message.className = 'border border-joner-red p-4 text-sm font-body text-white bg-joner-red/10'
          message.textContent = 'Registration saved. Sending you to payment now.'
        }
        window.location.href = data.paymentLink || payload.paymentLink
      } catch (error) {
        if (message) {
          message.className = 'border border-joner-red p-4 text-sm font-body text-white bg-joner-red/10'
          message.textContent = error.message || 'Could not save registration. Please try again.'
        }
        if (submitButton) {
          submitButton.disabled = false
          submitButton.textContent = 'Submit Registration And Pay'
        }
      }
    })
  </script>
</BaseLayout>
