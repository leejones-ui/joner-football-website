  camp.spotsTotal ? `Capacity capped at ${camp.spotsTotal} players` : 'Capacity capped on purpose',
]
const pricingRows = (dayPaymentLinks.length ? dayPaymentLinks : camp.paymentOptions || []).map((item: any) => ({
