    venue: textOrFallback(sanityCamp?.venue, fallback.venue),
    venueName: textOrFallback(sanityCamp?.venueName, fallback.venueName),
    venueAddress: textOrFallback(sanityCamp?.venueAddress, fallback.venueAddress),
    venueNotes: textOrFallback(sanityCamp?.venueNotes, fallback.venueNotes),
    dates: textOrFallback(sanityCamp?.dates, fallback.dates, ['June 2026', 'July 2026']),
    times: textOrFallback(sanityCamp?.times, fallback.times),
    ageRange: textOrFallback(sanityCamp?.ageRange, fallback.ageRange, ['Youth players']),
    priceLabel: textOrFallback(sanityCamp?.priceLabel, fallback.priceLabel, ['Payment link coming soon', '1 day, 2 day and 3 day options']),
    description: textOrFallback(sanityCamp?.description, fallback.description, genericDescriptions.concat(['register interest for the texas houston june joner football camp.', 'register interest for the texas dallas june joner football camp.', 'register interest for the sydney big 1 july joner football camp.'])),
    extraInfo: textOrFallback(sanityCamp?.extraInfo, fallback.extraInfo),
    heroImage: imageUrlFromSanity(sanityCamp?.heroImage) || sanityCamp?.heroImageUrl || fallback.heroImage,
    galleryImages: arrayOrFallback(sanityCamp?.galleryImages, fallback.galleryImages),
    trustItems: arrayOrFallback(sanityCamp?.trustItems, fallback.trustItems),
    audienceItems: arrayOrFallback(sanityCamp?.audienceItems, fallback.audienceItems || commonAudience),
    campHighlights: arrayOrFallback(sanityCamp?.campHighlights, fallback.campHighlights),
    includedItems: arrayOrFallback(sanityCamp?.includedItems, fallback.includedItems),
    trainingThemes: arrayOrFallback(sanityCamp?.trainingThemes, fallback.trainingThemes || commonThemes),
    scheduleItems: arrayOrFallback(sanityCamp?.scheduleItems, fallback.scheduleItems),
    coachProfiles: arrayOrFallback(sanityCamp?.coachProfiles, fallback.coachProfiles || commonCoaches),
    whatToBring: arrayOrFallback(sanityCamp?.whatToBring, fallback.whatToBring || commonBring),
    faqItems: arrayOrFallback(sanityCamp?.faqItems, fallback.faqItems || commonFaqs),
    dayOptions: arrayOrFallback(sanityCamp?.dayOptions, fallback.dayOptions, [genericDaySignature, '1 day|2 days|3 days']),
    jerseySizes: arrayOrFallback(sanityCamp?.jerseySizes, fallback.jerseySizes || []),
