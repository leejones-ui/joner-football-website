}

export async function getStaticPaths() {
  let sanitySlugs: string[] = []
  const fallbackSlugs = [
    'texas-dallas-june',
    'sydney-big-1-july',
  ]
  const staticCampSlugs = ['la-tcpe-june', 'texas-houston-june']

  try {
    const camps = await sanityClient.fetch(`*[_type == "camp" && defined(slug.current)]{ "slug": slug.current }`)
    sanitySlugs = camps.map((camp: { slug: string }) => camp.slug).filter(Boolean)
  } catch (error) {
    sanitySlugs = []
  }

  const slugs = Array.from(new Set([...fallbackSlugs, ...sanitySlugs]))
    .filter((campSlug) => !staticCampSlugs.includes(campSlug))
  return slugs.map((campSlug) => ({ params: { slug: campSlug } }))
}

