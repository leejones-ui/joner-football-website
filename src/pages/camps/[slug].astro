function cleanText(value: any) {
  return String(value || '').trim()
}

function textOrFallback(value: any, fallback: any, genericValues: string[] = []) {
  const text = cleanText(value)
  if (!text) return fallback
  const lower = text.toLowerCase()
  if (genericValues.map((item) => item.toLowerCase()).includes(lower)) return fallback
  return text
}

function arrayOrFallback(value: any, fallback: any[] = [], genericSignatures: string[] = []) {
  if (!Array.isArray(value) || value.length === 0) return fallback
  const signature = value.map((item) => cleanText(typeof item === 'string' ? item : item?.title || item?.label || item?.question)).join('|').toLowerCase()
  if (genericSignatures.includes(signature)) return fallback
  return value
}

function imageUrlFromSanity(image: any) {
  return image?.asset?.url || image?.url || ''
}

function mergeCamp(sanityCamp: CampMap, fallback: CampMap) {
  const genericDaySignature = '1 day|2 days|3 days|full camp'
  const genericDescriptions = [
    `register interest for the ${cleanText(sanityCamp?.title).toLowerCase()} joner football camp.`,
    'register for a joner football camp.',
  ]

