  <section class="relative left-1/2 w-screen -translate-x-1/2 overflow-hidden bg-joner-black py-16 text-white md:py-24">
    <img src={campImages.finaleBackdrop} alt="Joner Football Houston World Cup Camp final team moment" class="absolute inset-0 h-full w-full object-cover" loading="lazy" decoding="async" />
    <div class="absolute inset-0 bg-black/65"></div>
    <div class="pointer-events-none absolute inset-0 opacity-[0.015] mix-blend-overlay" style="background-image: radial-gradient(circle at 1px 1px, #fff 1px, transparent 0); background-size: 12px 12px;"></div>
    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="camp-reveal max-w-3xl opacity-0 translate-y-4 transition duration-500 ease-out">
