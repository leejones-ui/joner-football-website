  sanityCamp = await sanityClient.fetch(`*[_type == "camp" && slug.current == $slug][0]{
    title,
    status,
    heroKicker,
    heroSubtitle,
    urgencyLabel,
    location,
    destination,
    googleSheetTab,
    venue,
    venueName,
