---
import BaseLayout from '../../layouts/BaseLayout.astro'

const title = 'Dallas | World Cup Camp | June 2026 | Joner Football'
const description = 'Joner Football Dallas Camp, June 30 to July 2 2026. 3 day elite camp with Coach Joner in Melissa, TX. Ages 8 to 18. Sold out every year. Limited spots.'
const canonical = 'https://jonerfootball.com/camps/texas-dallas-june/'

const infoCells = [
  {
    label: 'When',
    value: 'Tue 30 Jun to<br/>Thu 2 Jul 2026',
    sub: '3 day elite camp. Last day live streamed on YouTube.',
    icon: 'calendar',
  },
  {
    label: 'Where',
    value: 'Melissa, TX',
    sub: '4220 E Melissa Rd, Melissa, TX 75454',
    icon: 'pin',
  },
  {
    label: 'Time',
    value: '7am to 10am',
    sub: 'Early start due to heat',
    icon: 'clock',
  },
  {
    label: 'Who for',
    value: 'Ages 8 to 18',
    sub: 'Grouped by age and skill',
    icon: 'people',
  },
  {
    label: 'Capacity',
    value: 'Limited spots',
    sub: '16 players per coach. Sells out every year.',
    icon: 'shield',
  },
  {
    label: 'Includes',
    value: 'App + Kit',
    sub: 'Joner Football App access. Joner jersey for full 3-day attendees.',
    icon: 'list',
  },
]

const tiers = [
  { days: '1 Day', price: '$130' },
  { days: '2 Days', price: '$250' },
  { days: 'All 3 Days', price: '$350', best: true },
]

const carouselImages = [
  '/images/camps/dallas-2026/photos/dsc09261.webp',
  '/images/camps/dallas-2026/photos/large-camp.webp',
  '/images/camps/dallas-2026/photos/red-drills.webp',
  '/images/camps/dallas-2026/photos/real-coaching.webp',
  '/images/camps/dallas-2026/photos/small-group.webp',
  '/images/camps/dallas-2026/photos/1v1-detail.webp',
]

const bullets = [
  'No babysitting, only players that truly want to improve',
  'Max 16 players per coach',
  'Limited spots available',
  'Dedicated players only',
  'Sold out every year',
  'Access to Joner Football App and training kit / merch',
  'Jersey for players that attend all 3 days',
]

const testimonials = [
  { src: '/images/camps/dallas-2026/testimonials/t1.webp', alt: 'Parent testimonial, Boston 2018' },
  { src: '/images/camps/dallas-2026/testimonials/t2.webp', alt: 'Parent testimonial, California 2022' },
  { src: '/images/camps/dallas-2026/testimonials/t3.webp', alt: 'Parent testimonial, California 2019' },
  { src: '/images/camps/dallas-2026/testimonials/t4.webp', alt: 'Parent testimonial, Sydney 2020' },
  { src: '/images/camps/dallas-2026/testimonials/t5.webp', alt: 'Parent testimonial, Melbourne 2021' },
]

const faqs = [
  {
    q: 'What does the player need to bring?',
    a: ['Soccer boots for synthetic', 'Shin guards', 'Drinks bottle', 'Waterproof jacket', 'A smile', 'Good attitude'],
  },
  {
    q: 'What should the player wear?',
    a: ['Black shorts', 'White socks', 'Joner Football will provide a training jersey'],
  },
  {
    q: 'What to expect?',
    text: "Expect energy, enthusiasm, intensity, knowledge, drills you've never done before, and above all else bags of fun. Our team of coaches will go above and beyond to make sure you are learning.",
  },
  {
    q: 'Will bad weather cancel the camp?',
    text: 'No. Only really bad storms can delay the camp.',
  },
  {
    q: 'Can we take photos / videos on the day?',
    text: "We have a team of professional photographers and videographers on the day doing their thing. You can ask on the day for a copy of the photos and we'll sort that out for you. On the last day of camp the coaches always allocate time for photos, autographs and chats with the parents.",
  },
  {
    q: 'Can I get a refund if I cancel my spot?',
    text: 'Full refunds will be issued if you cancel within 14 days of the camp start date.',
  },
  {
    q: "Who will be in my son / daughter's group?",
    text: 'Our coaches always group players by age first, then ability. We have a limit of 16 players per group. If a player is dominating their group, we push them up into the older age group to make sure they are tested.',
  },
  {
    q: 'Will we receive a training jersey?',
    text: "Yes. Please be mindful of the size you choose on the form, that is the size you'll get. Be mindful of how much your son or daughter will have grown by the time the camp comes around. Jersey only included for players doing all 3 days.",
  },
]

const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: 'Joner Football Dallas Camp June 2026',
  startDate: '2026-06-30T07:00-05:00',
  endDate: '2026-07-02T10:00-05:00',
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: 'Melissa Sports Field',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '4220 E Melissa Rd',
      addressLocality: 'Melissa',
      addressRegion: 'TX',
      postalCode: '75454',
      addressCountry: 'US',
    },
  },
  organizer: { '@type': 'Organization', name: 'Joner Football', url: 'https://jonerfootball.com' },
  image: 'https://jonerfootball.com/images/camps/dallas-2026/photos/dsc09261.webp',
  description,
  offers: tiers.map((tier) => ({
    '@type': 'Offer',
    name: tier.days,
    price: tier.price.replace('$', ''),
    priceCurrency: 'USD',
    availability: 'https://schema.org/LimitedAvailability',
    url: 'https://jonerfootball.com/camps/texas-dallas-june/#register',
  })),
}

import SanityPageRenderer from '../../components/sanity/SanityPageRenderer.astro'
import { fetchSanityPage } from '../../lib/sanityPages'
import { shouldReplaceSanityPage } from '../../lib/sanityPageUtils'

const sanityPage = await fetchSanityPage('camp-texas-dallas-june')
---

{shouldReplaceSanityPage(sanityPage) ? (
  <SanityPageRenderer page={sanityPage} />
) : (
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage="https://jonerfootball.com/images/camps/dallas-2026/photos/dsc09261.webp"
  schema={eventSchema}
  hideMobileAppCta
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/camps/dallas-2026/photos/dsc09261.webp" fetchpriority="high" />
    <link rel="preload" as="font" href="/fonts/Kanit-BlackItalic.ttf" type="font/ttf" crossorigin />
  </Fragment>

  <div class="hou-page">

  <!-- ============ 01 HERO ============ -->
  <section class="hou-hero" id="top">
    <div class="hou-hero-img" aria-hidden="true"></div>
    <div class="hou-wrap hou-hero-content">
      <span class="hou-eyebrow" data-motion="fade-up"><span class="hou-pulse"></span> Sold out 2025 · Running it back</span>
      <h1 class="hou-h1" data-motion="fade-up" data-motion-delay="0.08">
        Dallas
        <span class="hou-hook">World Cup</span>
        Camp
        <span class="hou-h1-small">3 Day Elite Camp · June to July 2026</span>
      </h1>
      <p class="hou-hero-collab" data-motion="fade-up" data-motion-delay="0.16">
        In collaboration with <strong>Kingdom Soccer Training</strong> and <strong>Grande Sports</strong>.
      </p>
      <div class="hou-hero-cta" data-motion="fade-up" data-motion-delay="0.24">
        <a class="btn-red" href="#register" data-motion-hover="lift">
          Book your spot
        </a>
        <a class="btn-red" href="#info" data-motion-hover="lift">
          See the details
        </a>
      </div>
    </div>
  </section>

  <!-- ============ 02 KEY INFO ============ -->
  <section class="hou-info" id="info">
    <div class="hou-wrap">
      <div class="hou-info-layout">
        <div class="hou-info-left">
          <div class="hou-section-head" data-motion="fade-up">
            <span class="hou-section-eyebrow">Camp Details</span>
            <h2 class="hou-h2">The <span class="hou-hook">essentials</span>.<br/>Everything you need to know.</h2>
            <span class="hou-rule"></span>
          </div>

          <ul class="hou-info-list" data-motion-stagger data-motion-stagger-step="0.06">
            {infoCells.map((cell) => (
              <li class="hou-info-item" data-motion-stagger-child>
                <div class="hou-info-item-head">
                  <span class="hou-info-item-ico" aria-hidden="true">
                    {cell.icon === 'calendar' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>)}
                    {cell.icon === 'pin' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s7-7.5 7-13a7 7 0 1 0-14 0c0 5.5 7 13 7 13z"/><circle cx="12" cy="9" r="2.5"/></svg>)}
                    {cell.icon === 'clock' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>)}
                    {cell.icon === 'people' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 11a3 3 0 1 0 0-6M22 20a5 5 0 0 0-5-5"/></svg>)}
                    {cell.icon === 'shield' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 13l9 7 9-7M3 7l9 7 9-7-9-5-9 5z"/></svg>)}
                    {cell.icon === 'list' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h18M3 12h18M3 17h12"/></svg>)}
                  </span>
                  <span class="hou-info-item-label">{cell.label}</span>
                </div>
                <div class="hou-info-item-value" set:html={cell.value}></div>
                <div class="hou-info-item-sub">{cell.sub}</div>
              </li>
            ))}
          </ul>
        </div>

        <div class="hou-info-right" data-motion="fade-up">
          <div class="hou-info-carousel" data-info-carousel aria-label="Photos from past Joner camps">
            {carouselImages.map((src, i) => (
              <img
                class:list={['hou-info-carousel-img', i === 0 && 'is-active']}
                src={src}
                alt=""
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
                width="900"
                height="1100"
              />
            ))}
          </div>

          <div class="hou-cost" data-motion="fade-up">
            <div class="hou-cost-head">Cost</div>
            <div class="hou-cost-tiers">
              {tiers.map((tier) => (
                <div class:list={['hou-cost-tier', tier.best && 'hou-cost-tier--best']}>
                  {tier.best && <span class="hou-cost-badge">Best Value</span>}
                  <span class="hou-cost-days">{tier.days}</span>
                  <span class="hou-cost-price">{tier.price}<small>USD</small></span>
                </div>
              ))}
            </div>
            <p class="hou-cost-note">Joner jersey included with the 3 day pass. Cut-off for jersey: 1st April.</p>
          </div>
          <a class="btn-red hou-info-book" href="#register" data-motion-hover="lift">Book now</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 03 BULLETS OVER PHOTO ============ -->
  <section class="hou-bullets">
    <div class="hou-bullets-bg" aria-hidden="true"></div>
    <div class="hou-wrap hou-bullets-content">
      <div class="hou-section-head" style="color:#fff;" data-motion="fade-up">
        <span class="hou-section-eyebrow">Why Joner</span>
        <h2 class="hou-h2" style="color:#fff;">Real coaching. <span class="hou-hook">No babysitting.</span></h2>
        <span class="hou-rule"></span>
      </div>
      <ul class="hou-bullets-list" data-motion-stagger data-motion-stagger-step="0.07">
        {bullets.map((b) => (
          <li data-motion-stagger-child>
            <span class="hou-bullet-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M5 12.5l4.2 4.2L19 7"/></svg>
            </span>
            <span>{b}</span>
          </li>
        ))}
      </ul>
      <div class="hou-bullets-cta" data-motion="fade-up">
        <a class="btn-red" href="#register" data-motion-hover="lift">
          Invest now
        </a>
      </div>
    </div>
  </section>

  <!-- ============ 04 VIDEO ============ -->
  <section class="hou-video">
    <div class="hou-wrap">
      <div class="hou-section-head" data-motion="fade-up">
        <span class="hou-section-eyebrow">Dallas 2025 · A sneak peek</span>
        <h2 class="hou-h2">Our camps come with <span class="hou-hook">energy</span>.</h2>
        <span class="hou-rule"></span>
      </div>
      <div class="hou-video-shell" data-motion="fade-up">
        <div class="hou-video-poster" id="houVideoPoster" role="button" tabindex="0" aria-label="Play camp video">
          <button class="hou-play-btn" aria-label="Play">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </button>
          <div class="hou-video-label">Dallas 2025, Sneak Peek</div>
        </div>
      </div>
      <div class="hou-video-cta-row" data-motion="fade-up">
        <a class="btn-red" href="#register" data-motion-hover="lift">
          Book your spot now
        </a>
      </div>
    </div>
  </section>

  <!-- ============ 05 TESTIMONIALS ============ -->
  <section class="hou-testi">
    <div class="hou-wrap">
      <div class="hou-section-head" data-motion="fade-up">
        <span class="hou-section-eyebrow">Testimonials</span>
        <h2 class="hou-h2">What <span class="hou-hook">parents</span> say.</h2>
        <span class="hou-rule"></span>
      </div>
      <div class="hou-testi-stage" id="houTestiStage" data-motion="fade-up">
        {testimonials.map((t, i) => (
          <div class:list={['hou-testi-slide', i === 0 && 'is-active']} data-testi-slide>
            <img src={t.src} alt={t.alt} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" width="1100" height="619" />
          </div>
        ))}
        <div class="hou-testi-slide hou-testi-slide--reel" data-testi-slide>
          <div class="hou-testi-reel-wrap">
            <video
              class="hou-testi-reel"
              src="/videos/houston-parent-reel.mp4"
              poster="/videos/houston-parent-reel-poster.webp"
              preload="metadata"
              muted
              loop
              playsinline
              controls
              data-testi-reel-video
              aria-label="Joner Football USA Camp parent reel"
            ></video>
          </div>
        </div>
      </div>
      <div class="hou-testi-controls">
        <div class="hou-testi-dots" id="houTestiDots"></div>
        <div class="hou-testi-arrows">
          <button class="hou-testi-arrow" id="houTestiPrev" aria-label="Previous testimonial">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 6l-6 6 6 6"/></svg>
          </button>
          <button class="hou-testi-arrow" id="houTestiNext" aria-label="Next testimonial">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 6l6 6-6 6"/></svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 06 SIGN UP FORM ============ -->
  <section class="hou-form-section" id="register">
    <div class="hou-wrap">
      <div class="hou-section-head" data-motion="fade-up">
        <span class="hou-section-eyebrow">Register Now</span>
        <h2 class="hou-h2">Lock in your <span class="hou-hook">spot</span>.</h2>
        <p class="hou-form-lede">
          You can't get accepted without filling in the form and submitting payment. Spots are first come, first served.
        </p>
        <div class="hou-spots" data-spots-counter data-spots-baseline="80" data-spots-existing="25" data-spots-paid-baseline="0" data-spots-camp="Dallas World Cup Camp June 2026">
          <span class="hou-spots-pulse" aria-hidden="true"></span>
          <span class="hou-spots-text">
            <span class="hou-spots-num" data-spots-num>55</span>
            <span class="hou-spots-label">spots left</span>
          </span>
        </div>
        <span class="hou-rule"></span>
      </div>

      <form class="hou-form-shell" data-motion="fade-up" id="houForm" novalidate>
        <input type="hidden" name="camp" value="Dallas World Cup Camp June 2026" />
        <input type="hidden" name="destination" value="Texas Dallas June 2026" />
        <input type="hidden" name="brevoListId" value="5" />
        <input type="hidden" name="brevoListIds" value="5,2" />
        <input type="hidden" name="source" value="dallas-camp-2026-landing" />

        <div class="hou-form-grid">
          <div class="hou-field">
            <label>Player first name<span class="hou-req">*</span></label>
            <input type="text" name="playerFirstName" required placeholder="e.g. Marco" />
          </div>
          <div class="hou-field">
            <label>Player last name<span class="hou-req">*</span></label>
            <input type="text" name="playerSurname" required placeholder="e.g. Rodriguez" />
          </div>
          <div class="hou-field">
            <label>Player age<span class="hou-req">*</span></label>
            <input type="number" name="age" min="8" max="18" required placeholder="8 to 18" />
          </div>
          <div class="hou-field">
            <label>Parent / guardian email<span class="hou-req">*</span></label>
            <input type="email" name="email" required placeholder="you@email.com" />
          </div>
          <div class="hou-field">
            <label>Phone number<span class="hou-req">*</span></label>
            <input type="tel" name="mobile" required placeholder="(555) 555-1234" />
          </div>
          <div class="hou-field">
            <label>Jersey size<span class="hou-req">*</span></label>
            <select name="jerseySize" required>
              <option value="">Select size</option>
              <option>Child Small</option>
              <option>Child Medium</option>
              <option>Child Large</option>
              <option>Adult Small</option>
              <option>Adult Medium</option>
              <option>Adult Large</option>
            </select>
          </div>
          <div class="hou-field hou-field-full">
            <label>How many days?<span class="hou-req">*</span></label>
            <select name="numberOfDays" required>
              <option value="">Select</option>
              <option>1 Day, $130 USD</option>
              <option>2 Days, $250 USD</option>
              <option>3 Days, $350 USD (Best Value, Jersey Included)</option>
            </select>
          </div>
          <div class="hou-field hou-field-full">
            <label>Select day(s) attending<span class="hou-req">*</span></label>
            <div class="hou-day-picker">
              <div class="hou-day-chip">
                <input type="checkbox" id="dal-d1" name="day_tue" />
                <label for="dal-d1"><span class="hou-d-day">Tue 30</span><span class="hou-d-name">June</span></label>
              </div>
              <div class="hou-day-chip">
                <input type="checkbox" id="dal-d2" name="day_wed" />
                <label for="dal-d2"><span class="hou-d-day">Wed 1</span><span class="hou-d-name">July</span></label>
              </div>
              <div class="hou-day-chip">
                <input type="checkbox" id="dal-d3" name="day_thu" />
                <label for="dal-d3"><span class="hou-d-day">Thu 2</span><span class="hou-d-name">July</span></label>
              </div>
            </div>
          </div>

          <div class="hou-field hou-field-full">
            <label>Payment method<span class="hou-req">*</span></label>
            <div class="hou-pay-row">
              <div class="hou-pay-opt">
                <input type="radio" name="paymentMethod" id="hou-pay-stripe" value="Stripe" required checked />
                <label for="hou-pay-stripe">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><rect x="2" y="6" width="20" height="12"/><path d="M2 10h20"/></svg>
                  Pay with Stripe
                </label>
              </div>
            </div>
          </div>

          <label class="hou-agree">
            <input type="checkbox" name="agreementAccepted" required />
            <span>I have read and agree to the website <a href="/terms" target="_blank" rel="noopener">training agreement</a>.</span>
          </label>

          <p class="hou-form-error" id="houFormError" role="alert"></p>

          <div class="hou-form-submit">
            <button type="submit" class="btn-red" data-motion-hover="lift">
              <span class="hou-submit-label">Submit and pay</span>
              
            </button>
          </div>
        </div>
      </form>
    </div>
  </section>

  <!-- ============ 07 FAQ ============ -->
  <section class="hou-faq">
    <div class="hou-wrap">
      <div class="hou-section-head" data-motion="fade-up">
        <span class="hou-section-eyebrow">FAQ</span>
        <h2 class="hou-h2">Frequently asked <span class="hou-hook">questions</span>.</h2>
        <span class="hou-rule"></span>
      </div>
      <div class="hou-faq-list" data-motion-stagger data-motion-stagger-step="0.05">
        {faqs.map((faq) => (
          <details class="hou-faq-item" data-motion-stagger-child>
            <summary>
              <span>{faq.q}</span>
              <span class="hou-faq-toggle" aria-hidden="true">+</span>
            </summary>
            <div class="hou-faq-answer">
              {faq.a ? (
                <ul>{faq.a.map((item) => <li>{item}</li>)}</ul>
              ) : (
                <p>{faq.text}</p>
              )}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <section class="hou-final-cta">
    <div class="hou-final-cta-bg" aria-hidden="true"></div>
    <div class="hou-wrap">
      <h2 class="hou-h2 hou-final-h2" data-motion="fade-up">Dallas. <span class="hou-hook">June 2026.</span><br/>Don't miss it.</h2>
      <p data-motion="fade-up" data-motion-delay="0.1">Sells out every year. Lock your spot now and we'll see you on the pitch.</p>
      <a class="btn-red" href="#register" data-motion="fade-up" data-motion-delay="0.2" data-motion-hover="lift">
        Register now
      </a>
    </div>
  </section>

  <!-- ============ STICKY MOBILE CTA ============ -->
  <div class="hou-mobile-cta">
    <a class="btn-red w-full" href="#register">
      Book your spot
    </a>
  </div>

  </div>

  <style>
    /* ===== Local font + brand tokens (scoped to this page) ===== */
    @font-face {
      font-family: 'Kanit';
      font-style: italic;
      font-weight: 600;
      font-display: swap;
      src: url('/fonts/Kanit-SemiBoldItalic.ttf') format('truetype');
    }
    @font-face {
      font-family: 'Kanit';
      font-style: italic;
      font-weight: 900;
      font-display: swap;
      src: url('/fonts/Kanit-BlackItalic.ttf') format('truetype');
    }

    .hou-page {
      --jf-red: #CC0000;
      --jf-red-hover: #B30000;
      --font-display: 'Kanit', 'Impact', 'Arial Narrow Bold', sans-serif;
      --font-body: 'DM Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
      --ease-out: cubic-bezier(.2,.7,.2,1);
      background: #000;
      color: #fff;
      font-family: var(--font-body);
      line-height: 1.55;
      overflow-x: hidden;
      padding-bottom: 0;
    }
    .hou-page * { box-sizing: border-box; }
    .hou-page img { display: block; max-width: 100%; }
    .hou-page h1, .hou-page h2 {
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      line-height: 0.92;
      margin: 0;
    }
    .hou-page .hou-hook { color: var(--jf-red); }
    .hou-wrap { max-width: 1280px; margin: 0 auto; padding: 0 24px; }
    @media (max-width: 640px) { .hou-wrap { padding: 0 20px; } }

    /* ===== STICKY NAV ===== */
    .hou-nav {
      position: sticky; top: 0; z-index: 50;
      background: rgba(0,0,0,0.92);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-bottom: 3px solid var(--jf-red);
    }
    .hou-nav-row {
      display: flex; align-items: center; justify-content: space-between;
      height: 64px; gap: 16px;
    }
    .hou-nav-logo {
      display: flex; align-items: center; gap: 10px;
      text-decoration: none; color: #fff;
      font-family: var(--font-display); font-style: italic; font-weight: 900;
      text-transform: uppercase; letter-spacing: 0.04em; font-size: 18px;
    }
    .hou-nav-logo img { height: 32px; width: auto; }
    .hou-nav-logo .hou-dot { color: var(--jf-red); }
    .hou-nav-cta { display: none; }
    @media (min-width: 768px) {
      .hou-nav-row { height: 72px; }
      .hou-nav-cta { display: inline-flex; }
      .hou-nav-logo { font-size: 22px; }
      .hou-nav-logo img { height: 38px; }
    }

    /* ===== GLASS BUTTON ===== */
    .hou-glass {
      position: relative;
      display: inline-flex; align-items: center; justify-content: center;
      flex-direction: column; gap: 6px;
      padding: 18px 36px 16px;
      font-family: var(--font-display);
      font-style: italic; font-weight: 900;
      text-transform: uppercase; letter-spacing: 0.06em;
      font-size: 17px; line-height: 1;
      color: #fff;
      text-decoration: none;
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: 999px;
      background:
        linear-gradient(180deg, rgba(255,255,255,0.10) 0%, rgba(255,255,255,0.02) 50%, rgba(0,0,0,0.4) 100%),
        radial-gradient(120% 140% at 50% 0%, rgba(204,0,0,0.35) 0%, rgba(204,0,0,0) 60%),
        #0a0a0a;
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.20),
        inset 0 -1px 0 rgba(0,0,0,0.6),
        0 8px 24px rgba(204,0,0,0.18);
      cursor: pointer;
      transition: box-shadow 200ms var(--ease-out);
      user-select: none;
      overflow: hidden;
    }
    .hou-glass::before {
      content: ""; position: absolute; left: 8%; right: 8%; top: 4px; height: 40%;
      background: linear-gradient(180deg, rgba(255,255,255,0.22), rgba(255,255,255,0));
      border-radius: 999px;
      pointer-events: none;
    }
    .hou-glass-underline {
      display: none;
    }
    .hou-glass:hover {
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.28),
        inset 0 -1px 0 rgba(0,0,0,0.6),
        0 12px 32px rgba(204,0,0,0.32);
    }
    .hou-glass:active { transform: translateY(1px); }
    .hou-glass--sm { padding: 12px 22px 10px; font-size: 13px; }
    .hou-glass--lg { padding: 22px 44px 20px; font-size: 20px; }
    .hou-glass--block { display: flex; width: 100%; }

    /* ===== HERO ===== */
    .hou-hero {
      position: relative;
      min-height: 92dvh;
      display: flex; align-items: flex-end;
      overflow: hidden;
      padding: 120px 0 56px;
    }
    .hou-hero-img {
      position: absolute; inset: 0;
      background-image: url('/images/camps/dallas-2026/photos/dsc09261.webp');
      background-size: cover;
      background-position: 60% 22%;
    }
    @media (max-width: 1024px), (hover: none) and (pointer: coarse) {
      .hou-hero-img { background-position: 64% 18%; }
    }
    .hou-hero-img::after {
      content: ""; position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.35) 35%, rgba(0,0,0,0.85) 100%);
    }
    .hou-hero-content { position: relative; width: 100%; }
    .hou-eyebrow {
      display: inline-flex; align-items: center; gap: 10px;
      padding: 8px 14px;
      background: rgba(204,0,0,0.15);
      border: 1px solid rgba(204,0,0,0.6);
      color: #fff;
      font-family: var(--font-display); font-style: italic; font-weight: 600;
      font-size: 12px; text-transform: uppercase; letter-spacing: 0.18em;
    }
    .hou-pulse {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--jf-red); box-shadow: 0 0 10px rgba(204,0,0,0.9);
      animation: houPulse 1.6s var(--ease-out) infinite;
    }
    @keyframes houPulse { 0%,100% { opacity: 1 } 50% { opacity: 0.4 } }

    .hou-h1 {
      font-size: clamp(3.2rem, 11vw, 8rem);
      line-height: 0.88;
      margin: 18px 0 0;
      max-width: 900px;
    }
    .hou-h1-small {
      display: block;
      font-size: clamp(1.4rem, 3.4vw, 2.2rem);
      line-height: 1.05;
      margin-top: 14px;
    }
    .hou-hero-sub {
      margin-top: 22px;
      font-size: 17px; line-height: 1.55;
      max-width: 560px;
      color: rgba(255,255,255,0.85);
    }
    .hou-hero-collab {
      margin: 22px 0 0;
      max-width: 620px;
      font-family: var(--font-body);
      font-size: clamp(13px, 1.4vw, 15px);
      line-height: 1.55;
      letter-spacing: 0.04em;
      color: rgba(255,255,255,0.82);
    }
    .hou-hero-collab strong {
      font-family: var(--font-display); font-style: italic; font-weight: 900;
      text-transform: uppercase; letter-spacing: 0.06em;
      color: #fff;
    }
    .hou-hero-meta {
      margin-top: 28px;
      display: flex; flex-wrap: wrap; gap: 10px;
    }
    .hou-hero-meta span {
      font-family: var(--font-display); font-style: italic; font-weight: 600;
      font-size: 11px; text-transform: uppercase; letter-spacing: 0.18em;
      padding: 8px 12px;
      background: rgba(0,0,0,0.55);
      border: 1px solid rgba(255,255,255,0.18);
    }
    .hou-hero-cta { margin-top: 36px; display: flex; flex-wrap: wrap; gap: 14px; }
    .hou-corner {
      position: absolute; top: 28px; right: 24px;
      width: 80px; height: 3px; background: var(--jf-red);
    }
    @media (max-width: 640px) {
      .hou-hero { min-height: 88dvh; padding: 96px 0 44px; }
      .hou-corner { top: 18px; right: 20px; width: 56px; }
    }

    /* ===== SECTION HEAD ===== */
    .hou-section-head {
      display: flex; flex-direction: column; gap: 14px;
      margin-bottom: 48px;
    }
    .hou-section-eyebrow {
      font-family: var(--font-display); font-style: italic; font-weight: 600;
      font-size: 13px; letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--jf-red);
    }
    .hou-h2 {
      font-size: clamp(2.2rem, 5vw, 3.6rem);
      line-height: 1; margin: 0;
      max-width: 900px;
    }
    .hou-rule { width: 64px; height: 3px; background: var(--jf-red); margin-top: 4px; }

    /* ===== INFO ===== */
    .hou-info { background: #fff; color: #000; padding: 72px 0; }
    .hou-info .hou-h2 { color: #000; }
    .hou-info .hou-section-head { margin-bottom: 34px; }
    .hou-info-layout {
      display: grid;
      grid-template-columns: 1fr;
      gap: 32px;
      align-items: start;
    }
    .hou-info-left { min-width: 0; }
    .hou-info-list {
      list-style: none; padding: 0; margin: 0;
      display: grid; gap: 22px;
    }
    .hou-info-item {
      border-top: 1px solid rgba(0,0,0,0.12);
      padding-top: 16px;
    }
    .hou-info-item:first-child { border-top: 0; padding-top: 0; }
    .hou-info-item-head {
      display: flex; align-items: center; gap: 10px;
      color: var(--jf-red);
    }
    .hou-info-item-ico { display: inline-flex; }
    .hou-info-item-ico svg { width: 18px; height: 18px; }
    .hou-info-item-label {
      font-family: var(--font-display); font-style: italic; font-weight: 600;
      font-size: 13px; letter-spacing: 0.22em; text-transform: uppercase;
    }
    .hou-info-item-value {
      margin-top: 6px;
      font-family: var(--font-display); font-style: italic; font-weight: 900;
      text-transform: uppercase; letter-spacing: 0.02em;
      font-size: clamp(1.7rem, 3.2vw, 2.6rem);
      line-height: 1.02;
      color: #000;
    }
    .hou-info-item-sub {
      margin-top: 6px;
      font-family: var(--font-body);
      font-size: 13px; line-height: 1.5;
      color: rgba(0,0,0,0.6);
    }

    /* ===== COST (under photo) ===== */
    .hou-cost {
      margin-top: 22px;
      max-width: none;
    }
    .hou-cost-head {
      font-family: var(--font-display); font-style: italic; font-weight: 900;
      font-size: 14px; letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--jf-red);
      border-bottom: 2px solid var(--jf-red);
      padding-bottom: 6px;
      display: inline-block;
    }
    .hou-cost-tiers {
      margin-top: 14px;
      display: grid; gap: 8px;
    }
    .hou-cost-tier {
      position: relative;
      display: flex; align-items: baseline; justify-content: space-between; gap: 12px;
      padding: 10px 14px;
      border: 1px solid rgba(0,0,0,0.16);
      background: #fff;
    }
    .hou-cost-tier--best {
      border-color: var(--jf-red);
      background: rgba(204,0,0,0.06);
    }
    .hou-cost-badge {
      position: absolute; top: -10px; right: 12px;
      background: var(--jf-red); color: #fff;
      font-family: var(--font-display); font-style: italic; font-weight: 900;
      font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
      padding: 4px 8px;
      box-shadow: 0 4px 12px rgba(204,0,0,0.28);
    }
    .hou-cost-days {
      font-family: var(--font-display); font-style: italic; font-weight: 900;
      text-transform: uppercase; letter-spacing: 0.04em;
      font-size: 14px;
      color: #000;
    }
    .hou-cost-price {
      font-family: var(--font-display); font-style: italic; font-weight: 900;
      font-size: 1.25rem;
      color: #000;
    }
    .hou-cost-price small {
      font-size: 11px; color: rgba(0,0,0,0.55); margin-left: 4px;
      font-weight: 600;
    }
    .hou-cost-note {
      margin: 12px 0 0;
      font-family: var(--font-body);
      font-size: 12px; line-height: 1.5;
      color: rgba(0,0,0,0.55);
    }
    .hou-info-book {
      margin-top: 18px;
      width: 100%;
      color: #fff;
    }

    /* ===== INFO CAROUSEL (right side) ===== */
    .hou-info-right { min-width: 0; }
    .hou-info-carousel {
      position: relative;
      width: 100%;
      aspect-ratio: 4 / 5;
      overflow: hidden;
      background: #0a0a0a;
      box-shadow: 0 24px 60px rgba(0,0,0,0.18);
    }
    .hou-info-carousel-img {
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      object-fit: cover;
      object-position: center;
      opacity: 0;
      transition: none;
    }
    .hou-info-carousel-img.is-active { opacity: 1; }

    @media (min-width: 900px) {
      .hou-info-layout {
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
        gap: 40px;
        align-items: start;
      }
      .hou-info-carousel { aspect-ratio: 4 / 5; }
    }
    @media (max-width: 640px) {
      .hou-info-carousel { aspect-ratio: 4 / 3; }
    }
    @media (prefers-reduced-motion: reduce) {
      .hou-info-carousel-img { transition: opacity 1ms; }
    }

    /* ===== BULLETS ===== */
    .hou-bullets {
      position: relative; overflow: hidden;
      min-height: 700px;
      display: flex; align-items: center;
      padding: 100px 0;
    }
    .hou-bullets-bg {
      position: absolute; inset: 0;
      background-image: url('/images/camps/dallas-2026/photos/large-camp.webp');
      background-size: cover; background-position: center;
    }
    .hou-bullets-bg::after {
      content: ""; position: absolute; inset: 0;
      background: linear-gradient(90deg, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.6) 60%, rgba(0,0,0,0.4) 100%);
    }
    .hou-bullets-content { position: relative; width: 100%; }
    .hou-bullets-list {
      list-style: none; padding: 0; margin: 36px 0 0;
      display: grid; gap: 14px;
      grid-template-columns: 1fr;
      max-width: 720px;
    }
    .hou-bullets-list li {
      display: flex; align-items: center; gap: 16px;
      padding: 14px 18px;
      background: rgba(0,0,0,0.55);
      border: 1px solid rgba(255,255,255,0.12);
      border-left: 3px solid var(--jf-red);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      font-family: var(--font-display); font-style: italic; font-weight: 900;
      text-transform: uppercase; letter-spacing: 0.04em;
      font-size: clamp(0.95rem, 1.6vw, 1.15rem);
      line-height: 1.15;
      color: #fff;
    }
    .hou-bullet-ico {
      flex-shrink: 0;
      width: 32px; height: 32px; border-radius: 50%;
      border: 2px solid var(--jf-red);
      display: flex; align-items: center; justify-content: center;
      color: var(--jf-red);
    }
    .hou-bullet-ico svg { width: 16px; height: 16px; }
    .hou-bullets-cta { margin-top: 36px; }

    /* ===== VIDEO ===== */
    .hou-video { background: #000; padding: 96px 0 48px; }
    .hou-video-shell {
      position: relative;
      aspect-ratio: 16 / 9;
      background: #0a0a0a;
      border: 1px solid rgba(255,255,255,0.12);
      overflow: hidden;
      margin-top: 36px;
    }
    .hou-video-poster {
      position: absolute; inset: 0;
      background-image: url('/images/camps/dallas-2026/photos/red-drills.webp');
      background-size: cover; background-position: center;
      cursor: pointer;
    }
    .hou-video-poster::after {
      content: ""; position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(0,0,0,0.2), rgba(0,0,0,0.55));
    }
    .hou-play-btn {
      position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%);
      width: 96px; height: 96px; border-radius: 50%;
      background:
        radial-gradient(120% 120% at 50% 0%, rgba(204,0,0,0.6) 0%, rgba(204,0,0,0) 60%),
        rgba(0,0,0,0.6);
      border: 2px solid rgba(255,255,255,0.4);
      backdrop-filter: blur(6px);
      display: flex; align-items: center; justify-content: center;
      color: #fff;
      cursor: pointer;
      box-shadow: 0 12px 40px rgba(204,0,0,0.4);
      transition: transform 200ms var(--ease-out);
    }
    .hou-play-btn:hover { transform: translate(-50%,-50%) scale(1.05); }
    .hou-play-btn svg { width: 36px; height: 36px; margin-left: 6px; }
    .hou-video-label {
      position: absolute; left: 24px; bottom: 24px;
      font-family: var(--font-display); font-style: italic; font-weight: 900;
      font-size: 14px; letter-spacing: 0.18em; text-transform: uppercase;
      color: #fff;
      border-bottom: 3px solid var(--jf-red); padding-bottom: 8px;
    }
    .hou-video-cta-row { margin-top: 36px; display: flex; justify-content: center; }

    /* ===== TESTIMONIALS ===== */
    .hou-testi { background: #000; color: #fff; padding: 96px 0; }
    .hou-testi-stage {
      position: relative;
      margin-top: 8px;
      aspect-ratio: 16 / 9;
      background: #0a0a0a;
      border: 1px solid rgba(255,255,255,0.10);
      overflow: hidden;
    }
    .hou-testi-slide {
      position: absolute; inset: 0;
      opacity: 0;
      transition: opacity 700ms var(--ease-out);
      pointer-events: none;
    }
    .hou-testi-slide.is-active { opacity: 1; pointer-events: auto; }
    .hou-testi-slide img {
      width: 100%; height: 100%;
      object-fit: cover;
      object-position: center;
    }
    .hou-testi-slide--reel {
      background: #000;
      display: flex; align-items: center; justify-content: center;
    }
    .hou-testi-reel-wrap {
      position: relative;
      height: 100%;
      width: auto;
      aspect-ratio: 9 / 16;
      max-width: 100%;
      max-height: 100%;
      overflow: hidden;
      background: #000;
    }
    .hou-testi-reel {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      background: #000;
      border: 0;
    }
    .hou-testi-controls {
      display: flex; justify-content: space-between; align-items: center;
      margin-top: 22px; gap: 16px;
    }
    .hou-testi-dots { display: flex; gap: 8px; }
    .hou-testi-dot {
      width: 28px; height: 4px;
      background: rgba(255,255,255,0.22);
      cursor: pointer; transition: background 200ms, width 200ms;
      border: 0; padding: 0;
    }
    .hou-testi-dot.is-active { background: var(--jf-red); width: 44px; }
    .hou-testi-arrows { display: flex; gap: 8px; }
    .hou-testi-arrow {
      width: 44px; height: 44px;
      background: transparent; color: #fff;
      border: 1px solid rgba(255,255,255,0.22);
      cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: background 120ms, border-color 120ms;
    }
    .hou-testi-arrow:hover { background: var(--jf-red); border-color: var(--jf-red); }
    .hou-testi-arrow svg { width: 18px; height: 18px; }

    /* ===== FORM ===== */
    .hou-form-section {
      background: #000; color: #fff;
      padding: 96px 0;
      position: relative;
      border-top: 3px solid var(--jf-red);
    }
    .hou-form-section::before {
      content: ""; position: absolute; inset: 0;
      background-image: url('/images/camps/dallas-2026/photos/night-session.webp');
      background-size: cover; background-position: center;
      opacity: 0.18;
      pointer-events: none;
    }
    .hou-form-section .hou-wrap { position: relative; }
    .hou-form-lede {
      margin: 10px 0 0;
      max-width: 580px;
      color: rgba(255,255,255,0.7);
      font-size: 15px; line-height: 1.55;
    }
    .hou-spots {
      display: inline-flex; align-items: center; gap: 12px;
      margin-top: 18px;
      padding: 10px 16px;
      border: 1px solid rgba(204,0,0,0.6);
      background: rgba(204,0,0,0.12);
      color: #fff;
    }
    .hou-spots-pulse {
      width: 10px; height: 10px; border-radius: 50%;
      background: var(--jf-red);
      box-shadow: 0 0 12px rgba(204,0,0,0.95);
      animation: houPulse 1.6s var(--ease-out) infinite;
    }
    .hou-spots-text { display: inline-flex; align-items: baseline; gap: 8px; }
    .hou-spots-num {
      font-family: var(--font-display); font-style: italic; font-weight: 900;
      font-size: 22px; line-height: 1;
      color: #fff;
    }
    .hou-spots-label {
      font-family: var(--font-display); font-style: italic; font-weight: 600;
      font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
      color: rgba(255,255,255,0.85);
    }
    .hou-form-shell {
      background: #0a0a0a;
      border: 1px solid rgba(255,255,255,0.14);
      padding: 40px 32px;
      margin-top: 40px;
    }
    .hou-form-grid { display: grid; gap: 20px; grid-template-columns: 1fr 1fr; }
    .hou-field { display: flex; flex-direction: column; gap: 8px; }
    .hou-field-full { grid-column: 1 / -1; }
    .hou-field label {
      font-family: var(--font-display); font-style: italic; font-weight: 600;
      font-size: 12px; letter-spacing: 0.22em; text-transform: uppercase;
      color: rgba(255,255,255,0.7);
    }
    .hou-req { color: var(--jf-red); margin-left: 4px; }
    .hou-field input, .hou-field select, .hou-field textarea {
      background: #000;
      color: #fff;
      border: 2px solid rgba(255,255,255,0.18);
      border-radius: 2px;
      padding: 14px 16px;
      font-family: var(--font-body); font-size: 16px;
      transition: border-color 120ms;
      appearance: none; -webkit-appearance: none;
      width: 100%;
    }
    .hou-field input:focus, .hou-field select:focus, .hou-field textarea:focus {
      outline: none;
      border-color: var(--jf-red);
    }
    .hou-field select {
      background-image:
        linear-gradient(45deg, transparent 50%, #fff 50%),
        linear-gradient(135deg, #fff 50%, transparent 50%);
      background-position: calc(100% - 18px) 22px, calc(100% - 12px) 22px;
      background-size: 6px 6px, 6px 6px;
      background-repeat: no-repeat;
      padding-right: 36px;
    }

    .hou-day-picker {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px;
    }
    .hou-day-chip input { display: none; }
    .hou-day-chip label {
      display: flex; flex-direction: column; align-items: center; gap: 4px;
      padding: 16px 12px;
      border: 2px solid rgba(255,255,255,0.18);
      cursor: pointer;
      transition: all 120ms;
      text-align: center;
      letter-spacing: normal;
      color: #fff;
    }
    .hou-d-day {
      font-family: var(--font-display); font-style: italic; font-weight: 900;
      font-size: 22px; line-height: 1;
    }
    .hou-d-name {
      font-family: var(--font-display); font-style: italic; font-weight: 600;
      font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
      color: rgba(255,255,255,0.6);
    }
    .hou-day-chip input:checked + label {
      border-color: var(--jf-red);
      background: rgba(204,0,0,0.12);
    }
    .hou-day-chip input:checked + label .hou-d-name { color: var(--jf-red); }

    .hou-pay-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .hou-pay-opt { display: flex; }
    .hou-pay-opt input { display: none; }
    .hou-pay-opt label {
      flex: 1;
      display: flex; align-items: center; justify-content: center; gap: 10px;
      padding: 16px;
      border: 2px solid rgba(255,255,255,0.18);
      cursor: pointer;
      font-family: var(--font-display); font-style: italic; font-weight: 900;
      font-size: 14px; letter-spacing: 0.06em; text-transform: uppercase;
      transition: all 120ms;
      color: #fff;
    }
    .hou-pay-opt input:checked + label {
      border-color: var(--jf-red); background: rgba(204,0,0,0.12);
    }

    .hou-agree {
      grid-column: 1 / -1;
      display: flex; gap: 12px; align-items: flex-start;
      font-family: var(--font-body); font-size: 14px; line-height: 1.5;
      color: rgba(255,255,255,0.8);
      letter-spacing: normal;
    }
    .hou-agree input { width: 20px; height: 20px; margin-top: 2px; accent-color: var(--jf-red); flex-shrink: 0; }
    .hou-agree a { color: var(--jf-red); text-decoration: underline; }

    .hou-form-error {
      grid-column: 1 / -1;
      min-height: 0;
      margin: 0;
      color: #ff7676;
      font-size: 14px;
      font-family: var(--font-body);
    }
    .hou-form-error:empty { display: none; }

    .hou-form-submit { grid-column: 1 / -1; display: flex; justify-content: center; margin-top: 12px; }

    @media (max-width: 640px) {
      .hou-form-shell { padding: 28px 20px; }
      .hou-form-grid { grid-template-columns: 1fr; }
      .hou-day-picker { grid-template-columns: 1fr; }
      .hou-pay-row { grid-template-columns: 1fr; }
    }

    /* ===== FAQ ===== */
    .hou-faq { background: #fff; color: #000; padding: 96px 0; }
    .hou-faq .hou-h2 { color: #000; }
    .hou-faq-list { margin-top: 36px; }
    .hou-faq-item { border-top: 1px solid rgba(0,0,0,0.12); }
    .hou-faq-item:last-child { border-bottom: 1px solid rgba(0,0,0,0.12); }
    .hou-faq-item summary {
      list-style: none;
      cursor: pointer;
      padding: 22px 0;
      display: flex; align-items: center; justify-content: space-between; gap: 24px;
      font-family: var(--font-display); font-style: italic; font-weight: 900;
      text-transform: uppercase; letter-spacing: 0.04em;
      font-size: clamp(1.05rem, 2vw, 1.4rem);
      line-height: 1.15;
      color: #000;
    }
    .hou-faq-item summary::-webkit-details-marker { display: none; }
    .hou-faq-toggle {
      flex-shrink: 0;
      width: 36px; height: 36px;
      border: 2px solid #000;
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-display); font-weight: 900; font-style: italic;
      font-size: 22px; line-height: 1;
      transition: all 200ms var(--ease-out);
    }
    .hou-faq-item[open] .hou-faq-toggle {
      background: var(--jf-red); border-color: var(--jf-red); color: #fff;
      transform: rotate(45deg);
    }
    .hou-faq-answer {
      padding: 0 0 26px 0;
      max-width: 820px;
      font-family: var(--font-body); font-size: 16px; line-height: 1.6;
      color: rgba(0,0,0,0.78);
    }
    .hou-faq-answer ul { margin: 8px 0 0 18px; padding: 0; }
    .hou-faq-answer li { margin: 4px 0; }
    .hou-faq-answer p { margin: 0; }

    /* ===== FINAL CTA ===== */
    .hou-final-cta {
      position: relative;
      padding: 120px 0;
      overflow: hidden;
      text-align: center;
    }
    .hou-final-cta-bg {
      position: absolute; inset: 0;
      background-image: url('/images/camps/dallas-2026/photos/1v1-detail.webp');
      background-size: cover; background-position: center;
    }
    .hou-final-cta-bg::after {
      content: ""; position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(0,0,0,0.65), rgba(0,0,0,0.85));
    }
    .hou-final-cta .hou-wrap { position: relative; }
    .hou-final-h2 {
      font-size: clamp(2.4rem, 6vw, 5rem);
      line-height: 0.95;
      max-width: 900px; margin: 0 auto 22px;
    }
    .hou-final-cta p {
      max-width: 560px; margin: 0 auto 36px;
      font-size: 17px; color: rgba(255,255,255,0.85); line-height: 1.55;
    }

    /* ===== FOOTER ===== */
    .hou-footer {
      background: #000; color: #fff;
      padding: 56px 0 36px;
      border-top: 1px solid rgba(255,255,255,0.12);
    }
    .hou-footer-row {
      display: flex; flex-wrap: wrap; justify-content: space-between;
      align-items: center; gap: 24px;
      font-family: var(--font-display); font-style: italic; font-weight: 600;
      font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase;
      color: rgba(255,255,255,0.6);
    }
    .hou-footer-logo { color: #fff; font-size: 18px; }

    /* ===== STICKY MOBILE CTA ===== */
    .hou-mobile-cta {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
      padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
      background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.95) 30%);
      display: none;
      opacity: 0;
      transform: translateY(110%);
      pointer-events: none;
      transition: opacity 280ms ease, transform 360ms cubic-bezier(0.32, 0.72, 0, 1);
    }
    .hou-mobile-cta.is-revealed { opacity: 1; transform: translateY(0); pointer-events: auto; }
    @media (max-width: 1024px), (hover: none) and (pointer: coarse) {
      .hou-mobile-cta { display: block; }
      .hou-page { padding-bottom: 90px; }
    }

    /* ===== Reduced motion fallbacks ===== */
    @media (prefers-reduced-motion: reduce) {
      .hou-pulse { animation: none; }
      .hou-testi-slide { transition-duration: 1ms; }
    }
  </style>

  <script>
    import '../../scripts/home-motion'
    import { animate } from 'framer-motion/dom'

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const EASE = [0.2, 0.7, 0.2, 1]

    /* ========== Right-side info carousel (Framer Motion fade, 1.5s) ========== */
    const infoCarousel = document.querySelector<HTMLElement>('[data-info-carousel]')
    if (infoCarousel) {
      const imgs = Array.from(infoCarousel.querySelectorAll<HTMLElement>('.hou-info-carousel-img'))
      if (imgs.length > 1) {
        imgs.forEach((img, i) => {
          img.style.opacity = i === 0 ? '1' : '0'
          img.classList.toggle('is-active', i === 0)
        })
        let cIdx = 0
        const tick = () => {
          const prev = imgs[cIdx]
          cIdx = (cIdx + 1) % imgs.length
          const next = imgs[cIdx]
          if (reduced) {
            prev.style.opacity = '0'
            prev.classList.remove('is-active')
            next.style.opacity = '1'
            next.classList.add('is-active')
            return
          }
          animate(prev, { opacity: 0 }, { duration: 0.55, ease: EASE })
          animate(next, { opacity: 1 }, { duration: 0.55, ease: EASE })
          prev.classList.remove('is-active')
          next.classList.add('is-active')
        }
        window.setInterval(tick, 1500)
      }
    }

    /* ========== Testimonial carousel ========== */
    const stage = document.getElementById('houTestiStage')
    const dots = document.getElementById('houTestiDots')
    const prevBtn = document.getElementById('houTestiPrev')
    const nextBtn = document.getElementById('houTestiNext')
    if (stage && dots && prevBtn && nextBtn) {
      const slides = Array.from(stage.querySelectorAll<HTMLElement>('[data-testi-slide]'))
      const reelVideo = stage.querySelector<HTMLVideoElement>('[data-testi-reel-video]')
      let idx = 0
      let timer: number | null = null

      slides.forEach((_, i) => {
        const b = document.createElement('button')
        b.className = 'hou-testi-dot' + (i === 0 ? ' is-active' : '')
        b.setAttribute('aria-label', 'Go to testimonial ' + (i + 1))
        b.addEventListener('click', () => go(i, true))
        dots.appendChild(b)
      })

      function isReelSlide(i: number) { return slides[i]?.classList.contains('hou-testi-slide--reel') }
      function go(n: number, manual = false) {
        idx = (n + slides.length) % slides.length
        slides.forEach((s, i) => s.classList.toggle('is-active', i === idx))
        Array.from(dots!.children).forEach((d, i) => (d as HTMLElement).classList.toggle('is-active', i === idx))
        if (reelVideo) {
          if (isReelSlide(idx)) {
            reelVideo.currentTime = 0
            reelVideo.play().catch(() => {})
          } else {
            reelVideo.pause()
          }
        }
        if (manual) restart()
        else maybeRestart()
      }
      function clearTimer() { if (timer !== null) { window.clearInterval(timer); timer = null } }
      function isPaused() { return isReelSlide(idx) && !!reelVideo && !reelVideo.paused && !reelVideo.ended }
      function restart() {
        clearTimer()
        if (isPaused()) return
        timer = window.setInterval(() => go(idx + 1), 6000)
      }
      function maybeRestart() { if (isPaused()) clearTimer(); else if (timer === null) restart() }

      if (reelVideo) {
        reelVideo.addEventListener('play', clearTimer)
        reelVideo.addEventListener('pause', () => { if (!isReelSlide(idx)) return; if (timer === null) restart() })
        reelVideo.addEventListener('ended', () => { go(idx + 1, false) })
      }

      prevBtn.addEventListener('click', () => go(idx - 1, true))
      nextBtn.addEventListener('click', () => go(idx + 1, true))
      stage.addEventListener('mouseenter', clearTimer)
      stage.addEventListener('mouseleave', () => { if (!isPaused()) restart() })
      restart()
    }

    /* ========== Video poster click-to-load ========== */
    const poster = document.getElementById('houVideoPoster')
    if (poster) {
      const load = () => {
        const shell = poster.parentElement
        if (!shell) return
        shell.innerHTML = '<iframe width="100%" height="100%" src="https://www.youtube.com/embed/wSFyNDLu3zc?autoplay=1" title="Dallas 2025 Camp" loading="lazy" frameborder="0" allow="autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="position:absolute; inset:0; border:0;"></iframe>'
      }
      poster.addEventListener('click', load)
      poster.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
          e.preventDefault()
          load()
        }
      })
    }

    /* ========== Spots-left counter ========== */
    const spotsBox = document.querySelector<HTMLElement>('[data-spots-counter]')
    const spotsNum = document.querySelector<HTMLElement>('[data-spots-num]')
    async function refreshSpots() {
      if (!spotsBox || !spotsNum) return
      const camp = spotsBox.getAttribute('data-spots-camp') || ''
      const baseline = spotsBox.getAttribute('data-spots-baseline') || '0'
      const existingSignups = spotsBox.getAttribute('data-spots-existing') || '0'
      const paidBaseline = spotsBox.getAttribute('data-spots-paid-baseline') || '0'
      try {
        const res = await fetch(`/api/camp-spots?camp=${encodeURIComponent(camp)}&baseline=${encodeURIComponent(baseline)}&existingSignups=${encodeURIComponent(existingSignups)}&paidBaseline=${encodeURIComponent(paidBaseline)}`, { cache: 'no-store' })
        const json = await res.json()
        if (typeof json?.spots === 'number') {
          const oldVal = parseInt(spotsNum.textContent || baseline, 10)
          const newVal = Math.max(0, Math.floor(json.spots))
          spotsNum.textContent = String(newVal)
          if (!reduced && oldVal !== newVal) {
            animate(spotsNum, { transform: ['scale(1.18)', 'scale(1)'] }, { duration: 0.4, ease: EASE })
          }
        }
      } catch (_) { /* silent */ }
    }
    refreshSpots()

    /* ========== Form: auto-check day chips when "3 Days" selected ========== */
    const daysSelect = document.querySelector<HTMLSelectElement>('select[name="numberOfDays"]')
    const dayInputs = Array.from(document.querySelectorAll<HTMLInputElement>('.hou-day-chip input[type="checkbox"]'))
    if (daysSelect && dayInputs.length === 3) {
      daysSelect.addEventListener('change', () => {
        const v = (daysSelect.value || '').toLowerCase()
        if (v.includes('3 days')) {
          dayInputs.forEach((d) => { if (!d.checked) d.checked = true })
        } else if (v.includes('1 day')) {
          dayInputs.forEach((d) => { d.checked = false })
        } else if (v.includes('2 days')) {
          dayInputs.forEach((d) => { d.checked = false })
        }
      })
    }

    const paymentLinks = {
      Stripe: {
        one: 'https://buy.stripe.com/dRm7sK7qg0X9bCv0uwgEg03',
        two: 'https://buy.stripe.com/fZubJ0h0QfS3gWPb9agEg02',
        three: 'https://buy.stripe.com/7sY5kC11SeNZ21VcdegEg01',
      },
      PayPal: {
        one: 'https://www.paypal.com/ncp/payment/YFA255Z7ANAMQ',
        two: 'https://www.paypal.com/ncp/payment/MTXPQH7S6ZQR2',
        three: 'https://www.paypal.com/ncp/payment/SDT229N63F4XG',
      },
    }

    function selectedDayCount(value: FormDataEntryValue | null) {
      const text = String(value || '').toLowerCase()
      if (text.includes('3 days')) return 'three'
      if (text.includes('2 days')) return 'two'
      return 'one'
    }

    function paymentLinkFor(method: FormDataEntryValue | null, numberOfDays: FormDataEntryValue | null) {
      const m = String(method || 'Stripe') as 'Stripe' | 'PayPal'
      const dayKey = selectedDayCount(numberOfDays)
      return paymentLinks[m]?.[dayKey] || paymentLinks.Stripe[dayKey] || paymentLinks.Stripe.three
    }

    /* ========== Form submit ========== */
    const form = document.getElementById('houForm') as HTMLFormElement | null
    const errEl = document.getElementById('houFormError')
    if (form) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault()
        if (errEl) errEl.textContent = ''
        const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null
        const labelEl = submitBtn?.querySelector('.hou-submit-label') as HTMLElement | null
        const originalLabel = labelEl?.textContent || 'Submit and pay'

        const data = new FormData(form)
        const days = [
          data.get('day_tue') ? 'Tue 30 June' : '',
          data.get('day_wed') ? 'Wed 1 July' : '',
          data.get('day_thu') ? 'Thu 2 July' : '',
        ].filter(Boolean).join(', ')

        const payload = {
          camp: data.get('camp') || 'Dallas World Cup Camp June 2026',
          destination: data.get('destination') || 'Texas Dallas June 2026',
          brevoListId: Number(data.get('brevoListId') || 5),
          brevoListIds: String(data.get('brevoListIds') || '5,2'),
          source: data.get('source') || 'dallas-camp-2026-landing',
          playerFirstName: data.get('playerFirstName') || '',
          playerSurname: data.get('playerSurname') || '',
          email: data.get('email') || '',
          age: data.get('age') || '',
          mobile: data.get('mobile') || '',
          jerseySize: data.get('jerseySize') || '',
          numberOfDays: data.get('numberOfDays') || '',
          extraInfo: days ? `Days attending: ${days}` : '',
          paymentMethod: data.get('paymentMethod') || '',
          paymentLink: paymentLinkFor(data.get('paymentMethod'), data.get('numberOfDays')),
          paymentStatus: 'not_paid_pending_payment',
          agreementAccepted: !!data.get('agreementAccepted'),
        }

        if (!payload.playerFirstName || !payload.playerSurname || !payload.email || !payload.age || !payload.mobile || !payload.jerseySize || !payload.numberOfDays || !payload.paymentMethod || !payload.agreementAccepted) {
          if (errEl) errEl.textContent = 'Please fill in every required field.'
          return
        }

        if (submitBtn && labelEl) {
          submitBtn.disabled = true
          labelEl.textContent = 'Sending...'
        }

        try {
          const grecaptcha = (window as any).JonerRecaptcha
          ;(payload as any).recaptchaToken = grecaptcha ? await grecaptcha.getToken('camp_registration') : ''

          const res = await fetch('/api/camp-registration', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          })
          const json = await res.json()
          if (!res.ok || !json.success) throw new Error(json?.error || 'Could not save your registration. Please try again.')

          if (typeof (window as any).JonerTracking?.trackEvent === 'function') {
            (window as any).JonerTracking.trackEvent('Lead', {
              user_data: { email: payload.email },
              custom_data: { form_name: 'dallas-camp-2026', list_id: 5, lead_type: 'camp_lead' },
            })
          }

          // Spots-left is paid-only. Do not decrement on form submit;
          // Stripe webhook/payment confirmation updates the paid sheet, then
          // refreshSpots() reads the true paid count.
          refreshSpots()

          const paymentLink = json.paymentLink || payload.paymentLink || 'https://app.jonerfootball.com'
          form.innerHTML = `
            <div style="padding:18px 0;text-align:center;">
              <p style="color:#4ade80;font-size:18px;font-family:var(--font-display);font-style:italic;font-weight:900;text-transform:uppercase;letter-spacing:0.06em;margin:0 0 12px;">You're in. Spot held.</p>
              <p style="color:rgba(255,255,255,0.78);font-size:15px;line-height:1.55;margin:0 0 20px;">Sending you to secure payment now. Once Stripe confirms payment, your confirmation email fires automatically.</p>
              <a href="${paymentLink}" target="_blank" rel="noopener" class="btn-red">Complete payment</a>
            </div>`
          window.setTimeout(() => {
            window.location.href = paymentLink
          }, 900)
        } catch (err) {
          if (errEl) errEl.textContent = (err as Error).message || 'Something went wrong. Please try again.'
          if (submitBtn && labelEl) {
            submitBtn.disabled = false
            labelEl.textContent = originalLabel
          }
        }
      })
    }

    /* Sticky bottom CTA: hidden over the hero, revealed once the user
       scrolls past it. Same pattern across all camp + app pages. */
    ;(function () {
      const heroEl = document.querySelector('.hou-hero')
      const cta = document.querySelector('.hou-mobile-cta')
      if (!heroEl || !cta || !('IntersectionObserver' in window)) return
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          cta.classList.toggle('is-revealed', !entry.isIntersecting)
        })
      }, { threshold: 0, rootMargin: '-40px 0px 0px 0px' })
      io.observe(heroEl)
    })()
  </script>
</BaseLayout>
)}
