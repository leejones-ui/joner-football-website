---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Hybrid Story Object Prototype | Joner Football"
  description="Three visual object directions and a hybrid scroll-object prototype for the Joner Football homepage."
  canonical="https://jonerfootball.com/home-object-prototype/"
  noindex>
  <Fragment slot="head">
    <style>
      .object-page {
        background: #050505;
        color: #fff;
      }

      .object-hero {
        min-height: calc(100svh - 4rem);
        padding: clamp(5rem, 10vw, 8rem) 1.25rem 4rem;
        background:
          radial-gradient(circle at 72% 22%, rgba(227, 6, 19, 0.24), transparent 22rem),
          radial-gradient(circle at 28% 30%, rgba(255, 255, 255, 0.08), transparent 18rem),
          linear-gradient(180deg, #0b0b0d 0%, #050505 100%);
        overflow: hidden;
      }

      .object-grid {
        position: absolute;
        inset: 0;
        opacity: 0.34;
        background-image:
          linear-gradient(rgba(255,255,255,0.055) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255,255,255,0.055) 1px, transparent 1px);
        background-size: 64px 64px;
        mask-image: radial-gradient(circle at center, black 0%, transparent 74%);
      }

      .direction-card {
        position: relative;
        min-height: 31rem;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.14);
        background:
          linear-gradient(180deg, rgba(255,255,255,0.075), rgba(255,255,255,0.025)),
          #09090a;
        box-shadow: 0 2rem 5rem rgba(0,0,0,0.26);
      }

      .direction-card::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(255,255,255,0.12), transparent 34%, rgba(227,6,19,0.16));
        opacity: 0.6;
        pointer-events: none;
      }

      .direction-object {
        position: absolute;
        left: 50%;
        top: 42%;
        width: min(54vw, 17rem);
        aspect-ratio: 1;
        transform: translate(-50%, -50%);
      }

      .premium-ball {
        position: absolute;
        inset: 10%;
        border-radius: 999px;
        background:
          radial-gradient(circle at 34% 24%, rgba(255,255,255,0.82), rgba(255,255,255,0.06) 17%, transparent 28%),
          url('/images/home-object/premium-football-reference.jpg') center / cover no-repeat;
        box-shadow:
          0 2.3rem 4.6rem rgba(0,0,0,0.74),
          0 0 4rem rgba(227,6,19,0.28);
      }

      .premium-ball.is-system {
        background:
          radial-gradient(circle at 34% 24%, rgba(255,255,255,0.82), rgba(255,255,255,0.06) 17%, transparent 28%),
          url('/images/home-storyboard/football-real-object-square.png') center / cover no-repeat;
      }

      .object-ring,
      .object-ring::before,
      .object-ring::after {
        position: absolute;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.2);
        pointer-events: none;
      }

      .object-ring {
        inset: 0;
        box-shadow: 0 0 4rem rgba(227,6,19,0.14);
      }

      .object-ring::before,
      .object-ring::after {
        content: "";
      }

      .object-ring::before {
        inset: 16%;
        border-color: rgba(227,6,19,0.48);
      }

      .object-ring::after {
        inset: 30%;
        border-color: rgba(255,255,255,0.34);
      }

      .tactical-line {
        position: absolute;
        height: 1px;
        width: 54%;
        background: linear-gradient(90deg, transparent, #e30613, transparent);
        transform-origin: center;
        pointer-events: none;
      }

      .cue {
        position: absolute;
        border: 1px solid rgba(255,255,255,0.2);
        background: rgba(8,8,9,0.72);
        padding: 0.5rem 0.7rem;
        font-family: Anton, Impact, sans-serif;
        font-size: 0.62rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        backdrop-filter: blur(14px);
      }

      .mini-card {
        position: absolute;
        width: 7.5rem;
        border: 1px solid rgba(255,255,255,0.18);
        background: rgba(255,255,255,0.09);
        padding: 0.7rem;
        box-shadow: 0 1.5rem 3rem rgba(0,0,0,0.22);
        backdrop-filter: blur(14px);
      }

      .map-pin {
        position: absolute;
        display: grid;
        place-items: center;
        width: 0.9rem;
        height: 0.9rem;
        border-radius: 999px;
        background: #e30613;
        box-shadow: 0 0 0 0.9rem rgba(227,6,19,0.14), 0 0 2rem rgba(227,6,19,0.34);
      }

      .hybrid-shell {
        --hybrid-progress: 0;
        --object-x: 50%;
        --object-y: 50%;
        --object-scale: 1;
        --object-rotate: 0deg;
        height: 520vh;
        background: #050505;
      }

      .hybrid-stage {
        height: calc(100svh - 4rem);
        min-height: 44rem;
        overflow: hidden;
        background:
          radial-gradient(circle at var(--object-x) var(--object-y), rgba(227,6,19,0.22), transparent 18rem),
          linear-gradient(180deg, #08090b 0%, #050505 100%);
      }

      .hybrid-copy {
        position: absolute;
        left: clamp(7rem, 13vw, 12rem);
        top: 18vh;
        z-index: 20;
        width: min(34rem, calc(100vw - 2rem));
      }

      .hybrid-object {
        position: absolute;
        left: var(--object-x);
        top: var(--object-y);
        z-index: 12;
        width: clamp(13rem, 24vw, 24rem);
        aspect-ratio: 1;
        transform: translate(-50%, -50%) scale(var(--object-scale)) rotate(var(--object-rotate));
        transition: left 90ms linear, top 90ms linear, transform 90ms linear;
        will-change: left, top, transform;
      }

      .hybrid-object .premium-ball {
        animation: slowSpin 12s linear infinite;
      }

      @keyframes slowSpin {
        to { transform: rotate(360deg); }
      }

      .hybrid-layer {
        position: absolute;
        inset: 0;
        opacity: 0;
        transform: scale(0.94);
        transition: opacity 340ms ease, transform 340ms ease;
        pointer-events: none;
      }

      .hybrid-shell[data-mode="method"] .method-layer,
      .hybrid-shell[data-mode="app"] .method-layer,
      .hybrid-shell[data-mode="global"] .method-layer,
      .hybrid-shell[data-mode="system"] .method-layer,
      .hybrid-shell[data-mode="app"] .app-layer,
      .hybrid-shell[data-mode="system"] .app-layer,
      .hybrid-shell[data-mode="global"] .global-layer,
      .hybrid-shell[data-mode="system"] .global-layer,
      .hybrid-shell[data-mode="system"] .system-layer {
        opacity: 1;
        transform: scale(1);
      }

      .method-layer .cue:nth-child(1) { left: -18%; top: 16%; }
      .method-layer .cue:nth-child(2) { right: -20%; top: 34%; }
      .method-layer .cue:nth-child(3) { left: 0; bottom: -8%; }
      .app-layer .mini-card:nth-child(1) { right: -30%; top: 4%; }
      .app-layer .mini-card:nth-child(2) { left: -28%; bottom: 6%; }
      .global-layer .map-pin:nth-child(1) { left: -20%; top: 42%; }
      .global-layer .map-pin:nth-child(2) { right: -16%; top: 18%; }
      .global-layer .map-pin:nth-child(3) { right: 6%; bottom: -8%; }

      .hybrid-system-badge {
        position: absolute;
        left: 50%;
        top: 50%;
        display: grid;
        place-items: center;
        width: 42%;
        aspect-ratio: 1;
        transform: translate(-50%, -50%);
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.28);
        background: rgba(0,0,0,0.72);
        box-shadow: 0 0 3rem rgba(0,0,0,0.5);
      }

      .hybrid-system-badge img {
        width: 62%;
        height: auto;
      }

      .hybrid-progress {
        position: absolute;
        left: clamp(1.25rem, 3vw, 2.5rem);
        top: 12vh;
        bottom: 12vh;
        z-index: 22;
        width: 12rem;
      }

      .hybrid-progress-line {
        position: absolute;
        left: 0.5rem;
        top: 0;
        bottom: 0;
        width: 1px;
        background: rgba(255,255,255,0.18);
      }

      .hybrid-progress-fill {
        position: absolute;
        left: 0.5rem;
        top: 0;
        width: 1px;
        height: calc(var(--hybrid-progress) * 100%);
        background: #e30613;
      }

      .hybrid-step {
        display: grid;
        grid-template-columns: 1rem 1fr;
        gap: 0.85rem;
        align-items: center;
        color: rgba(255,255,255,0.44);
        transition: color 220ms ease, transform 220ms ease;
      }

      .hybrid-step span:first-child {
        width: 0.75rem;
        height: 0.75rem;
        border: 1px solid currentColor;
        border-radius: 999px;
        background: #050505;
      }

      .hybrid-step[data-active="true"] {
        color: #fff;
        transform: translateX(0.18rem);
      }

      .hybrid-step[data-active="true"] span:first-child {
        border-color: #e30613;
        background: #e30613;
      }

      .hybrid-caption {
        position: absolute;
        right: clamp(2rem, 7vw, 7rem);
        bottom: 10vh;
        z-index: 20;
        width: min(30rem, 34vw);
        border: 1px solid rgba(255,255,255,0.14);
        background: rgba(255,255,255,0.06);
        padding: 1.35rem;
        backdrop-filter: blur(18px);
      }

      @media (max-width: 900px) {
        .hybrid-shell {
          height: auto;
        }

        .hybrid-stage {
          position: relative;
          height: auto;
          min-height: 100svh;
          padding: 6rem 1.25rem 3rem;
        }

        .hybrid-copy,
        .hybrid-caption,
        .hybrid-object {
          position: relative;
          left: auto;
          right: auto;
          top: auto;
          bottom: auto;
          width: auto;
          transform: none;
        }

        .hybrid-progress {
          display: none;
        }

        .hybrid-object {
          width: min(78vw, 22rem);
          margin: 2rem auto;
        }

        .hybrid-caption {
          margin-top: 1.25rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .hybrid-object,
        .hybrid-layer,
        .hybrid-object .premium-ball {
          animation: none;
          transition: none;
        }
      }
    </style>
  </Fragment>

  <main class="object-page">
    <section class="object-hero relative">
      <div class="object-grid"></div>
      <div class="relative z-10 mx-auto max-w-7xl">
        <p class="font-heading text-xs uppercase tracking-[0.28em] text-joner-red">JON-51 object direction</p>
        <div class="mt-5 grid gap-8 lg:grid-cols-[1fr_0.78fr] lg:items-end">
          <div>
            <h1 class="font-heading text-5xl uppercase leading-[0.88] md:text-8xl">
              The Object Has To Tell The Story.
            </h1>
          </div>
          <p class="max-w-xl font-body text-lg leading-relaxed text-white/70 md:text-xl">
            Three visual directions for Lee to compare. The recommended route is a hybrid Joner Method object: ball at the centre, with tactical graphics, app cards, social proof, map pins, and system marks evolving around it.
          </p>
        </div>

        <div class="mt-14 grid gap-5 lg:grid-cols-3">
          <article class="direction-card p-6">
            <div class="direction-object">
              <div class="premium-ball"></div>
            </div>
            <div class="relative z-10 flex min-h-[27rem] flex-col justify-between">
              <p class="font-heading text-xs uppercase tracking-[0.26em] text-joner-red">01 Realistic Football</p>
              <div>
                <h2 class="font-heading text-4xl uppercase leading-none">Premium Ball</h2>
                <p class="mt-4 font-body text-sm leading-relaxed text-white/66">
                  Dark lighting, red glow, Nike-style hero energy. Strong anchor, but too simple on its own.
                </p>
              </div>
            </div>
          </article>

          <article class="direction-card p-6">
            <div class="direction-object">
              <div class="object-ring"></div>
              <div class="premium-ball is-system"></div>
              <span class="tactical-line" style="left: 2%; top: 38%; transform: rotate(-18deg);"></span>
              <span class="tactical-line" style="right: 0; bottom: 26%; transform: rotate(24deg);"></span>
              <span class="cue" style="left: -6%; bottom: 12%;">First touch</span>
              <span class="cue" style="right: -10%; top: 18%;">Weak foot</span>
            </div>
            <div class="relative z-10 flex min-h-[27rem] flex-col justify-between">
              <p class="font-heading text-xs uppercase tracking-[0.26em] text-joner-red">02 Joner Method</p>
              <div>
                <h2 class="font-heading text-4xl uppercase leading-none">Training System</h2>
                <p class="mt-4 font-body text-sm leading-relaxed text-white/66">
                  Ball, red rings, pitch grid, coaching cues, and touch points. More ownable and more Joner.
                </p>
              </div>
            </div>
          </article>

          <article class="direction-card border-[#e30613]/60 p-6">
            <div class="direction-object">
              <div class="object-ring"></div>
              <div class="premium-ball"></div>
              <div class="mini-card" style="right: -18%; top: 2%;"><p class="font-heading text-xl">APP</p><p class="mt-1 text-xs text-white/55">1,500 drills</p></div>
              <span class="map-pin" style="left: -8%; top: 48%;"></span>
              <span class="map-pin" style="right: 8%; bottom: -3%;"></span>
              <div class="hybrid-system-badge"><img src="/images/joner-logo-white.png" alt="" /></div>
            </div>
            <div class="relative z-10 flex min-h-[27rem] flex-col justify-between">
              <p class="font-heading text-xs uppercase tracking-[0.26em] text-joner-red">03 Recommended Hybrid</p>
              <div>
                <h2 class="font-heading text-4xl uppercase leading-none">Story Object</h2>
                <p class="mt-4 font-body text-sm leading-relaxed text-white/66">
                  Starts as the ball, then becomes method, app, global camps, and the full Joner Football system.
                </p>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="hybrid-shell relative" data-hybrid-shell data-mode="ball">
      <div class="hybrid-stage sticky top-16">
        <div class="object-grid"></div>
        <div class="absolute inset-0 shadow-[inset_0_0_220px_rgba(0,0,0,0.78)]"></div>

        <aside class="hybrid-progress">
          <div class="hybrid-progress-line"></div>
          <div class="hybrid-progress-fill"></div>
          <div class="relative flex h-full flex-col justify-between py-1">
            {['Ball', 'Method', 'App', 'Global', 'System'].map((label, index) => (
              <div class="hybrid-step" data-hybrid-step data-index={index} data-active={index === 0 ? 'true' : 'false'}>
                <span></span>
                <span class="font-heading text-[0.68rem] uppercase tracking-[0.22em]">{String(index + 1).padStart(2, '0')} {label}</span>
              </div>
            ))}
          </div>
        </aside>

        <article class="hybrid-copy">
          <p class="font-heading text-xs uppercase tracking-[0.28em] text-joner-red" data-hybrid-kicker>Opening Object</p>
          <h2 class="mt-5 font-heading text-5xl uppercase leading-[0.88] md:text-8xl" data-hybrid-title>Ball As The Spark</h2>
          <p class="mt-6 max-w-xl font-body text-lg leading-relaxed text-white/70 md:text-xl" data-hybrid-body>
            The ball appears first because Lee's story starts with technique. It should feel heavy, premium, and physical.
          </p>
        </article>

        <div class="hybrid-object" aria-hidden="true">
          <div class="object-ring"></div>
          <div class="premium-ball"></div>
          <div class="hybrid-layer method-layer">
            <span class="cue">First touch</span>
            <span class="cue">1v1</span>
            <span class="cue">Ball mastery</span>
            <span class="tactical-line" style="left: -18%; top: 31%; transform: rotate(-16deg);"></span>
            <span class="tactical-line" style="right: -8%; top: 58%; transform: rotate(21deg);"></span>
            <span class="tactical-line" style="left: 18%; bottom: 8%; transform: rotate(-32deg);"></span>
          </div>
          <div class="hybrid-layer app-layer">
            <div class="mini-card"><p class="font-heading text-xl">APP</p><p class="mt-1 text-xs text-white/58">Plans in pocket</p></div>
            <div class="mini-card"><p class="font-heading text-xl">1,500+</p><p class="mt-1 text-xs text-white/58">training drills</p></div>
          </div>
          <div class="hybrid-layer global-layer">
            <span class="map-pin"></span>
            <span class="map-pin"></span>
            <span class="map-pin"></span>
          </div>
          <div class="hybrid-layer system-layer">
            <div class="hybrid-system-badge"><img src="/images/joner-logo-white.png" alt="" /></div>
          </div>
        </div>

        <div class="hybrid-caption">
          <p class="font-heading text-xs uppercase tracking-[0.24em] text-joner-red">Prototype note</p>
          <p class="mt-3 font-body text-sm leading-relaxed text-white/70" data-hybrid-note>
            Motion should be tied to scroll: move, scale, rotate, reveal tactical marks, then resolve into the Joner system.
          </p>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    (function () {
      var shell = document.querySelector('[data-hybrid-shell]');
      if (!shell) return;

      var kicker = shell.querySelector('[data-hybrid-kicker]');
      var title = shell.querySelector('[data-hybrid-title]');
      var body = shell.querySelector('[data-hybrid-body]');
      var note = shell.querySelector('[data-hybrid-note]');
      var steps = Array.prototype.slice.call(shell.querySelectorAll('[data-hybrid-step]'));

      var beats = [
        {
          mode: 'ball',
          kicker: 'Opening Object',
          title: 'Ball As The Spark',
          body: "The ball appears first because Lee's story starts with technique. It should feel heavy, premium, and physical.",
          note: 'Premium football, dark light, red glow. This is the anchor, not the whole idea.',
          x: 60,
          y: 54,
          scale: 0.92
        },
        {
          mode: 'method',
          kicker: 'The Method Forms',
          title: 'Technique Gets Mapped',
          body: 'Red tactical marks, touch points, pitch geometry, and coaching cues begin to orbit the ball.',
          note: 'This is where the object becomes ownable to Joner Football: first touch, weak foot, ball mastery, 1v1.',
          x: 56,
          y: 50,
          scale: 1.08
        },
        {
          mode: 'app',
          kicker: 'System In Your Pocket',
          title: 'The App Locks In',
          body: 'The physical ball starts carrying cards, drills, session plans, and the structure of the Joner Football App.',
          note: 'The app should feel like part of the training system, not a separate website section.',
          x: 64,
          y: 47,
          scale: 0.98
        },
        {
          mode: 'global',
          kicker: 'Going Global',
          title: 'The World Opens',
          body: 'The object becomes a travel system: camps, clinics, map pins, and player communities around the world.',
          note: 'Map graphics should be abstract and premium, not literal clipart or busy location labels.',
          x: 52,
          y: 55,
          scale: 1.12
        },
        {
          mode: 'system',
          kicker: 'Final Resolve',
          title: 'The Joner Football System',
          body: 'Ball, method, app, camps, staff, HQ, and future tools resolve into one clear Joner Football object.',
          note: 'Final state should feel like a brand system reveal: simple, powerful, and ready to push into the call to action.',
          x: 63,
          y: 50,
          scale: 1.2
        }
      ];

      function clamp(value, min, max) {
        return Math.min(Math.max(value, min), max);
      }

      function setText(node, value) {
        if (node && node.textContent !== value) node.textContent = value;
      }

      function update() {
        var rect = shell.getBoundingClientRect();
        var scrollable = shell.offsetHeight - window.innerHeight;
        var progress = scrollable > 0 ? clamp(-rect.top / scrollable, 0, 1) : 0;
        var index = Math.min(beats.length - 1, Math.floor(progress * beats.length));
        var beat = beats[index];
        var local = clamp((progress * beats.length) - index, 0, 1);

        shell.dataset.mode = beat.mode;
        shell.style.setProperty('--hybrid-progress', String(progress));
        shell.style.setProperty('--object-x', beat.x + '%');
        shell.style.setProperty('--object-y', (beat.y + Math.sin(local * Math.PI) * 3) + '%');
        shell.style.setProperty('--object-scale', String(beat.scale));
        shell.style.setProperty('--object-rotate', (progress * 160) + 'deg');

        setText(kicker, beat.kicker);
        setText(title, beat.title);
        setText(body, beat.body);
        setText(note, beat.note);

        steps.forEach(function (step, stepIndex) {
          step.dataset.active = stepIndex === index ? 'true' : 'false';
        });
      }

      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    })();
  </script>
</BaseLayout>
