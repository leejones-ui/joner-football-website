---
import BaseLayout from '../layouts/BaseLayout.astro'
import JfpHeader from '../components/JfpHeader.astro'
import JfpFooter from '../components/JfpFooter.astro'
import TermWorks from '../components/TermWorks.astro'
import CreateAccountButton from '../components/CreateAccountButton.astro'
import '../styles/jfp.css'

import { termInfo, expectations, groupingLine } from '../data/jfp-term-info.js'
---

<BaseLayout title="JFP Term 4 | Joner Football" description="Joner Football Performance Program, Term 4 timetable and bookings." canonical="https://jonerfootball.com/jfp-booking/" noindex hideChrome hideMobileAppCta>
  <div class="jfp jfp-wide" id="jfp-book">
    <JfpHeader active="booking" />

    <section id="gate" class="j-gate" hidden>
      <div class="j-card">
        <h1 style="margin:0 0 8px">Term 4 timetable</h1>
        <p class="muted" style="margin-bottom:18px">Enter the booking password from your message.</p>
        <form id="gate-form" novalidate>
          <label class="j-field"><span>Booking password</span><input class="j-input" id="gate-password" type="password" autocomplete="current-password" required></label>
          <p class="j-err" id="gate-err" hidden></p>
          <button class="j-btn j-btn-dark j-btn-block j-btn-lg" type="submit" id="gate-btn">Continue</button>
        </form>
        <div class="j-gate-account">
          <p class="small" style="margin-bottom:12px"><a href="https://youtu.be/xn3YXZ9V9rg" target="_blank" rel="noopener noreferrer">&#9654; See how the portal works (video)</a></p>
          <p class="muted small">New to Joner Football?</p>
          <CreateAccountButton variant="jfp" place="booking-gate" class="j-btn-block" />
        </div>
      </div>
    </section>

    <div id="app" hidden>
      <div class="wrap">
        <div id="banner"></div>
        <section class="j-hero">
          <h1>Performance Program, <span id="term-name">Term 4</span></h1>
          <p class="muted" id="term-range"></p>
          <p class="small" style="margin-top:8px"><a href="https://youtu.be/xn3YXZ9V9rg" target="_blank" rel="noopener noreferrer">&#9654; See how the portal works (video)</a></p>
        </section>
        <nav class="j-tabs" aria-label="Sections">
          <a href="#timetable" data-tab="timetable" aria-current="page">Timetable</a>
          <a href="#extra" data-tab="extra">Extra sessions<span class="j-tabn" id="extra-count" hidden></span></a>
          <a href="#term" data-tab="term"><span id="term-tab">Term 4</span>&nbsp;info</a>
          <a href="#pricing" data-tab="pricing">Pricing</a>
          <a href="https://www.besteamsport.com.au/collections/joner-football" id="kit-tab" target="_blank" rel="noopener noreferrer">Training kit</a>
        </nav>

        <section data-panel="extra" hidden>
          <div id="extras-week"></div>
        </section>

        <section data-panel="timetable">
          <h2 class="j-step">Where do you train?</h2>
          <div class="j-locs" id="locs"></div>
          <div class="j-bar">
            <div class="j-daybar" id="daybar" role="tablist" aria-label="Day"></div>
            <div class="j-filters" role="group" aria-label="Filters">
              <select class="j-pillselect" id="f-loc" aria-label="Location"><option value="">All locations</option></select>
              <select class="j-pillselect" id="f-coach" aria-label="Coach"><option value="">All coaches</option></select>
              <div class="j-chips" id="f-show" role="group" aria-label="Show"></div>
              <button type="button" class="j-btn j-btn-ghost j-btn-sm" id="f-reset" hidden>Clear</button>
            </div>
          </div>
          <p class="j-hint" id="results-head"></p>
          <div id="results" aria-live="polite"></div>
          <div class="j-newacct"><span>New to Joner Football?</span><CreateAccountButton variant="jfp" place="booking-hero" /></div>
        </section>
        <div class="j-picks" id="picks-bar" role="region" aria-label="Your sessions" hidden></div>

        <section data-panel="term" hidden>
          <div class="j-term">
            <img src="/images/training/jfp/jfp-training-1.webp" alt="A Joner Football coach working with a player" loading="lazy">
            <div>
              <h2><span class="term-name-2">Term 4</span> at a glance</h2>
              <p class="muted" id="term-range-2"></p>
              <dl class="j-termlist">{termInfo.map(([t, d]) => <div><dt>{t}</dt><dd>{d}</dd></div>)}</dl>
            </div>
          </div>
          <h2 class="j-tw-head">How the term works</h2>
          <TermWorks variant="jfp" />
          <div class="j-term-two">
            <div class="j-pbox"><h3>What we expect</h3><ul class="j-good">{expectations.map((e) => <li>{e}</li>)}</ul></div>
            <div class="j-pbox"><h3>Good to know</h3><ul class="j-good">
              <li>{groupingLine}</li>
              <li>Only really bad storms cancel a session. Afternoon sessions at the HQ are indoors.</li>
              <li>A place is held once it is paid.</li>
              <li>Questions? <button type="button" class="j-foot-link" style="display:inline;color:inherit;text-decoration:underline" data-contact>Contact us</button>.</li>
            </ul></div>
          </div>
        </section>

        <section data-panel="pricing" hidden>
          <div class="j-pricing">
            <div class="j-pbox"><h3>Term programs</h3><div id="price-term"></div></div>
            <div class="j-pbox"><h3>1 to 1 coaching</h3><div id="price-121"></div></div>
          </div>
          <div class="j-pkit">
            <div><span class="j-pill j-pill-red">Required</span><h3>JF playing kit <span id="kit-price">A$60</span></h3><p class="muted small">Every player trains in it.</p></div>
            <a class="j-btn j-btn-dark" id="kit-buy" href="https://www.besteamsport.com.au/collections/joner-football" target="_blank" rel="noopener noreferrer">Joner Football shop</a>
          </div>
          <ul class="j-good">
            <li>Card, Apple Pay, Google Pay or Afterpay.</li>
            <li>Joining late? You only pay for the sessions left.</li>
            <li>No make-up sessions.</li>
          </ul>
          <p class="muted small" style="margin-top:10px">The trial session costs <span id="trial-price">A$85</span> and comes off the term.</p>
        </section>
      </div>
    </div>
    <JfpFooter />
  </div>
</BaseLayout>

<style>
  .j-gate-account { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--j-line); display: grid; gap: 8px; }
  .j-tw-head { margin: 26px 0 12px; font-size: 20px; }
</style>

<script>
  import '../scripts/jfp-booking.js'
</script>
