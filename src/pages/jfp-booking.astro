---
import BaseLayout from '../layouts/BaseLayout.astro'
import '../styles/jfp.css'
---

<BaseLayout title="Book JFP Term 4 | Joner Football" description="Book a Joner Football Performance group for Term 4." canonical="https://jonerfootball.com/jfp-booking/" noindex noTracking hideChrome hideMobileAppCta>
  <div class="jfp" id="jfp-book">
    <header class="j-top">
      <div class="wrap">
        <a class="j-brand" href="/"><img src="/images/joner-logo-white.png" alt="" width="30" height="30"><span>Joner Football<small>Performance programme</small></span></a>
        <div class="j-top-links"><a class="j-btn j-btn-line j-btn-sm" href="/jfp-account/">My account</a></div>
      </div>
    </header>

    <section id="gate" class="j-gate" hidden>
      <div class="j-card">
        <p class="j-kicker">JFP Term 4</p>
        <h1 style="margin:6px 0 8px">Book your group</h1>
        <p class="muted" style="margin-bottom:18px">Enter the booking password from your Joner Football message.</p>
        <form id="gate-form" novalidate>
          <label class="j-field"><span>Booking password</span><input class="j-input" id="gate-password" type="password" autocomplete="current-password" required></label>
          <p class="j-err" id="gate-err" hidden></p>
          <button class="j-btn j-btn-dark j-btn-block j-btn-lg" type="submit" id="gate-btn">Continue</button>
        </form>
        <p class="muted small" style="margin-top:14px">Already booked? <a href="/jfp-account/">Go to your account</a>.</p>
      </div>
    </section>

    <div id="app" hidden>
      <div class="wrap">
        <div id="banner"></div>
        <section class="j-hero">
          <p class="j-kicker" id="term-kicker">JFP Term 4</p>
          <h1 style="margin-top:6px">Find the right group</h1>
          <p class="muted" style="margin-top:8px;max-width:640px">Small groups of up to 6, set by age and level. Pick the player's age and where suits you, and we show the groups that fit.</p>
          <div class="meta" id="meta"></div>
        </section>

        <section class="j-section" aria-labelledby="where">
          <h2 id="where">Where we train</h2>
          <div class="j-locs" id="locs"></div>
        </section>

        <section aria-labelledby="groups-h">
          <h2 id="groups-h" class="sr">Groups</h2>
          <div class="j-filters" role="group" aria-label="Filters">
            <div class="j-age"><label for="f-age">Player's age</label>
              <select id="f-age"><option value="">Any</option></select>
            </div>
            <div class="j-chips" id="f-day" role="group" aria-label="When"></div>
            <div class="j-chips" id="f-show" role="group" aria-label="Show"></div>
          </div>
          <div class="j-results-head"><h2 id="results-title">Groups</h2><button type="button" class="j-btn j-btn-ghost j-btn-sm" id="f-reset" hidden>Clear filters</button></div>
          <div class="j-grid" id="results" aria-live="polite"></div>
          <p class="muted small" id="age-note" style="margin-top:12px" hidden>Ages are on the first day of term, Monday 12 October.</p>
        </section>

        <section class="j-section" aria-labelledby="how">
          <h2 id="how" style="margin-bottom:12px">How JFP works</h2>
          <div class="j-how">
            <div><b>Small groups</b>Up to 6 players, grouped by age and level, 60 minutes a week for 10 weeks.</div>
            <div><b>Book</b>Pay online and the place is yours straight away. You get a confirmation email with every date.</div>
            <div><b>Apply</b>Pathway groups and early morning squads are by application or trial. We reply within 48 hours.</div>
            <div><b>1 to 1</b>Private coaching on request. Send an enquiry and we will find a time.</div>
          </div>
        </section>
        <p class="muted small" style="padding:10px 0 40px">Questions? Email <a href="mailto:leejones@jonerfootball.com">leejones@jonerfootball.com</a>.</p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import '../scripts/jfp-booking.js'
</script>
