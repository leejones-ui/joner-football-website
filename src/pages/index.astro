---
import BaseLayout from '../layouts/BaseLayout.astro'

const storyBeats = [
  {
    number: '01',
    label: 'Philosophy',
    kicker: 'Welcome',
    title: 'Technique Above Everything',
    body: '',
    image: '/images/home-storyboard/01-kick-activation-new.webp',
    alt: 'Lee Jones striking a football on grass in warm light',
    objectPosition: '50% 52%',
    objectPositionTablet: '56% 52%',
    objectPositionMobile: '62% 50%',
    copyPos: 'center',
    markerX: 25.2,
    markerY: 27,
    maskX: 25.2,
    maskY: 27,
    maskSize: 0,
    tone: 'dark',
    overlay: 'none',
  },
  {
    number: '02',
    label: 'Origin',
    kicker: 'Origin',
    title: 'It Started With A Bag Of Balls',
    body: 'In 2013 I had an idea. Joner Football was born. Specialised in Individual & Small Group Training.',
    image: '/images/home-storyboard/02-origin-bag-of-balls.webp',
    alt: 'Lee Jones training on the grass with a bag of footballs beside him',
    objectPosition: '56% 50%',
    objectPositionTablet: '62% 50%',
    objectPositionMobile: '70% 50%',
    copyPos: 'left',
    markerX: 65,
    markerY: 76,
    maskX: 65,
    maskY: 76,
    maskSize: 0,
    tone: 'dark',
    overlay: 'origin',
  },
  {
    number: '03',
    label: 'Growth',
    kicker: 'Growth',
    title: 'Local Sessions. Global Reach.',
    body: 'The work spread through videos, players, parents, coaches, and millions of touches online.',
    image: '/images/home-storyboard/03-method-filming.webp',
    alt: 'Lee Jones coaching a technical ball mastery drill indoors',
    objectPosition: '48% 48%',
    objectPositionTablet: '54% 48%',
    objectPositionMobile: '58% 48%',
    copyPos: 'left',
    markerX: 71.5,
    markerY: 76,
    maskX: 71.5,
    maskY: 76,
    maskSize: 0,
    tone: 'dark',
    overlay: 'growth',
    ctaPlacement: 'overlay',
    ctas: [
      { label: 'YouTube', href: 'https://www.youtube.com/@jonerfootball', external: true },
      { label: 'Instagram', href: 'https://www.instagram.com/jonerfootball/', external: true },
      { label: 'Facebook', href: 'https://www.facebook.com/Jonerfootball/', external: true },
      { label: 'TikTok', href: 'https://www.tiktok.com/@jonerfootball', external: true },
      { label: 'JF App', href: 'https://app.jonerfootball.com', external: true },
      { label: 'X / Twitter', href: 'https://twitter.com/jonerfootball', external: true },
    ],
  },
  {
    number: '04',
    label: 'Joner Way',
    kicker: 'The Joner Way',
    title: 'A Method Like No Other',
    body: 'Every technical detail gets coached through energy, passion & positivity.',
    image: '/images/home-storyboard/04-proof-growth.webp',
    alt: 'Lee Jones coaching players during an evening Joner Football session',
    objectPosition: '50% 44%',
    objectPositionTablet: '54% 44%',
    objectPositionMobile: '58% 44%',
    copyPos: 'right',
    markerX: 82,
    markerY: 76,
    maskSize: 0,
    tone: 'dark',
    overlay: 'none',
    ctas: [
      { label: 'Train With Us In Sydney', href: '/training#jfp' },
    ],
  },
  {
    number: '05',
    label: 'Global',
    kicker: 'Going Global',
    title: 'Coaching Worldwide',
    body: 'From Sydney to camps, clinics, and football communities around the world.',
    image: '/images/home-storyboard/05-global-camps.webp',
    alt: 'Joner Football players training at a large outdoor camp',
    objectPosition: '50% 46%',
    objectPositionTablet: '48% 48%',
    objectPositionMobile: '46% 50%',
    copyPos: 'right',
    markerX: 82,
    markerY: 72,
    maskSize: 0,
    tone: 'dark',
    overlay: 'none',
    ctas: [
      { label: 'Elite Camps', href: '/camps' },
    ],
  },
  {
    number: '06',
    label: 'JF App',
    kicker: 'The Joner Football App',
    title: 'Worlds #1 Football Coaching APP',
    body: 'Built for players, parents, and coaches to train with clarity, confidence, and purpose.',
    image: '/images/home-storyboard/06-app-session-planning.webp',
    video: '/images/home-storyboard/06-app-header-video.mp4',
    alt: 'Joner Football App showing session planning content',
    objectPosition: '50% 50%',
    objectPositionTablet: '50% 50%',
    objectPositionMobile: '50% 50%',
    copyPos: 'left',
    markerX: 86,
    markerY: 66,
    maskSize: 0,
    tone: 'light',
    overlay: 'none',
    ctas: [
      { label: 'Free To Watch', href: 'https://app.jonerfootball.com/categories/category-vpi8uazway4', external: true },
      { label: 'Apple Download', href: 'https://apps.apple.com/au/app/joner-football-app/id6737069275', external: true, badge: 'apple' },
      { label: 'Google Download', href: 'https://play.google.com/store/apps/details?id=tv.uscreen.jonerfootball', external: true, badge: 'google' },
    ],
  },
  {
    number: '07',
    label: 'Our HQ',
    kicker: 'Our HQ',
    title: 'A Home Of Our Own',
    body: 'Sydney, Australia. Belrose. Our home.',
    image: '/images/home-storyboard/07-facility-hq.webp',
    alt: 'Lee Jones standing outside the Joner Football HQ facility in Belrose',
    objectPosition: '56% 50%',
    objectPositionTablet: '64% 50%',
    objectPositionMobile: '76% 50%',
    copyPos: 'left',
    markerX: 36,
    markerY: 66,
    maskSize: 0,
    tone: 'dark',
    overlay: 'none',
    ctas: [
      { label: 'Visit HQ Map', href: 'https://maps.google.com/?q=20+Narabang+Way+Belrose', external: true },
    ],
  },
  {
    number: '08',
    label: 'Action',
    kicker: 'Action',
    title: 'Choose Your Next Step',
    body: 'Train online, train with us, join a camp, or get inside the Joner Football Hub.',
    image: '/images/home-storyboard/07-action-coach.webp',
    alt: 'Lee Jones giving coaching detail during a Joner Football session',
    objectPosition: '50% 22%',
    objectPositionTablet: '50% 18%',
    objectPositionMobile: '50% 14%',
    copyPos: 'action',
    markerX: 108,
    markerY: 42,
    maskSize: 0,
    tone: 'dark',
    overlay: 'paths',
  },
]

const stats = [
  { value: '2M+', label: 'followers online', target: 2000000, format: 'millions' },
  { value: '50K+', label: 'app downloads', target: 50000, format: 'thousands' },
  { value: '1,500+', label: 'training drills', target: 1500, format: 'comma' },
  { value: '15+', label: 'countries reached', target: 15, format: 'plain' },
]


const primaryPaths = [
  { title: 'The App', text: 'Train online with Joner Football drills, programs, and coaching detail.', href: '/app', tag: 'Online Training' },
  { title: 'Train In Person', text: 'Sydney training programs for players who want proper technical coaching.', href: '/training', tag: 'Sydney' },
  { title: 'Coaches Section', text: 'Session ideas, drill detail, and coaching tools inside the Joner Football App.', href: '/app/for-coaches', tag: 'For Coaches' },
  { title: 'Elite Camps', text: 'High energy Joner Football camps in Australia, the USA, and beyond.', href: '/camps', tag: 'Camps' },
  { title: 'Workshops', text: 'Coach education, mindset seminars, and Joner Football learning experiences.', href: '/workshops', tag: 'Education' },
  { title: 'The Joner Football Hub', text: 'Free blogs, challenges, coach resources, and app links in one place.', href: '/hub', tag: 'Free Hub' },
]

const paths = [
  { title: 'Player', text: 'Start with the App, camps, or training in person.', href: '/app' },
  { title: 'Parent', text: 'Find training, camps, and programs for your player.', href: '/training#joners-juniors' },
  { title: 'Coach', text: 'Get the methodology, drills, and coach education.', href: '/app/for-coaches' },
]

const mediaStyle = (beat) => {
  const desktop = beat.objectPosition || '50% 50%'
  const tablet = beat.objectPositionTablet || desktop
  const mobile = beat.objectPositionMobile || tablet
  return `--story-object-desktop: ${desktop}; --story-object-tablet: ${tablet}; --story-object-mobile: ${mobile};`
}
---

<BaseLayout
  title="Joner Football | Technique Above Everything"
  description="Joner Football. Elite football coaching, global camps, and the world's best coaching app. Technique above everything."
  canonical="https://jonerfootball.com/"
>
  <Fragment slot="head">
    <style>
      .story-page {
        background: #0A0A0A;
        color: #FFFFFF;
      }

      .story-shell {
        --story-progress: 0;
        --growth-progress: 0;
        --hero-word-progress: 0;
        --ball-rotation: 0deg;
        --mask-x: var(--marker-x);
        --mask-y: var(--marker-y);
      }

      .story-viewport {
        height: calc(100svh - 4rem);
        min-height: 44rem;
        color: #FFFFFF;
        background: #0A0A0A;
        transition:
          background-color 700ms cubic-bezier(.22,.61,.36,1),
          color 700ms cubic-bezier(.22,.61,.36,1);
      }

      .story-bg {
        opacity: 0;
        transform: scale(1.06);
        object-position: var(--story-object-desktop, 50% 50%);
        filter: grayscale(0.2) contrast(1.08) brightness(0.5);
        transition:
          opacity 800ms cubic-bezier(.22,.61,.36,1),
          transform 1100ms cubic-bezier(.22,.61,.36,1),
          filter 900ms ease;
      }

      .story-bg[data-state="active"] {
        opacity: 1;
        transform: scale(1);
        filter: grayscale(0.04) contrast(1.12) brightness(0.7);
      }

      .story-bg[data-media="video"][data-state="active"] {
        opacity: 0.92;
        filter: grayscale(0) contrast(1.08) brightness(0.78) saturate(1.05);
      }

      .story-shade {
        opacity: 1;
        transition: opacity 700ms ease;
      }

      .story-kicker {
        letter-spacing: 0.26em;
      }

      .story-rail {
        color: rgba(255,255,255,0.54);
        transition: color 700ms ease, opacity 420ms ease;
      }

      .story-shell[data-active="0"] .story-rail {
        opacity: 0;
        pointer-events: none;
      }

      .story-rail-line {
        background: rgba(255,255,255,0.16);
        transition: background 700ms ease;
      }

      .story-rail-fill {
        height: calc(var(--story-progress) * 100%);
        background: #E30613;
      }

      .story-rail-dot,
      .story-rail-label {
        transition:
          opacity 260ms ease,
          transform 260ms ease,
          color 260ms ease,
          border-color 260ms ease,
          background-color 260ms ease;
      }

      .story-rail-dot[data-state="active"] {
        background: #E30613;
        border-color: #E30613;
        opacity: 1;
        transform: scale(1.18);
      }

      .story-rail-dot[data-state="inactive"] {
        opacity: 0.34;
      }

      .story-rail-label[data-state="active"] {
        opacity: 1;
        transform: translateX(0);
      }

      .story-rail-label[data-state="inactive"] {
        opacity: 0.42;
        transform: translateX(-0.18rem);
      }

      .story-copy {
        display: none;
        position: absolute;
        max-width: 34rem;
        opacity: 0;
        pointer-events: none;
      }

      .story-copy[data-state="active"] {
        display: block;
        opacity: 1;
        pointer-events: auto;
        animation: storyCopyIn 620ms cubic-bezier(.22,.61,.36,1) both;
      }

      .story-copy[data-pos="center"] {
        left: 50%;
        top: 20%;
        transform: translateX(-50%);
        text-align: center;
        max-width: 56rem;
      }

      .story-copy[data-pos="action"] {
        left: 50%;
        top: 42%;
        transform: translateX(-50%);
        text-align: center;
        max-width: 56rem;
      }

      .story-copy[data-pos="left"] {
        left: clamp(13rem, 18vw, 18rem);
        top: 26%;
      }

      .story-copy[data-pos="right"] {
        right: clamp(3rem, 8vw, 9rem);
        top: 26%;
      }

      @keyframes storyCopyIn {
        from { opacity: 0; transform: translateY(1.25rem); }
        to { opacity: 1; transform: translateY(0); }
      }

      .story-copy[data-pos="center"][data-state="active"] {
        animation-name: storyCopyInCenter;
      }

      .story-copy[data-pos="action"][data-state="active"] {
        animation-name: storyCopyInCenter;
      }

      @keyframes storyCopyInCenter {
        from { opacity: 0; transform: translate(-50%, 1.25rem); }
        to { opacity: 1; transform: translate(-50%, 0); }
      }

      .story-ball-system {
        left: var(--marker-x);
        top: var(--marker-y);
        transform: rotate(var(--ball-rotation));
        transition:
          left 90ms linear,
          top 90ms linear,
          transform 90ms linear,
          opacity 400ms ease;
        will-change: left, top, transform;
      }

      .story-photo-ball-mask {
        display: none;
        left: var(--mask-x);
        top: var(--mask-y);
        width: clamp(0rem, var(--mask-size), 14rem);
        height: clamp(0rem, var(--mask-size), 14rem);
        transform: translate(-50%, -50%);
        border-radius: 999px;
        background:
          radial-gradient(circle, rgba(0,0,0,1) 0 76%, rgba(0,0,0,0.84) 86%, rgba(0,0,0,0) 100%);
        filter: blur(0.28rem);
        opacity: var(--mask-opacity, 0.92);
        pointer-events: none;
        transition:
          left 180ms linear,
          top 180ms linear,
          opacity 380ms ease,
          width 180ms linear,
          height 180ms linear;
        will-change: left, top;
      }

      .story-ball-pulse {
        width: clamp(5.1rem, 8.4vw, 8.6rem);
        height: clamp(5.1rem, 8.4vw, 8.6rem);
        border-radius: 999px;
        position: relative;
        overflow: hidden;
        border: 0;
        background: transparent;
        box-shadow:
          0 1.4rem 2.8rem rgba(0,0,0,0.46),
          0 0 2.8rem rgba(227,6,19,0.18);
        transform: translate(-50%, -50%);
        perspective: 800px;
        transition: border-color 700ms ease, box-shadow 700ms ease;
      }

      .story-ball-pulse::before,
      .story-ball-pulse::after {
        display: none;
      }

      .story-ball-image {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
        filter:
          saturate(1.18)
          contrast(1.04)
          drop-shadow(0 1.1rem 1.35rem rgba(0,0,0,0.48));
        animation: storyBallSpin3d 2.8s linear infinite;
        transform-origin: 50% 50%;
        will-change: transform;
      }

      @keyframes storyBallSpin3d {
        from { transform: rotateY(0deg) rotateZ(-10deg); }
        to { transform: rotateY(360deg) rotateZ(350deg); }
      }

      .story-ball-logo {
        display: none;
      }

      .story-mini-ball {
        position: absolute;
        border-radius: 999px;
        background: url('/images/home-storyboard/yellow-football-object.png') center / contain no-repeat;
        box-shadow:
          0 0 1.8rem rgba(227,6,19,0.22);
      }

      .hero-scroll-title {
        display: grid;
        gap: 0.02em;
      }

      .hero-word {
        display: block;
        opacity: 0;
        transform: translateY(1.2rem);
        transition:
          opacity 360ms cubic-bezier(.22,.61,.36,1),
          transform 520ms cubic-bezier(.22,.61,.36,1);
      }

      .hero-word[data-visible="true"] {
        opacity: 1;
        transform: translateY(0);
      }

      .story-overlay {
        display: none;
        opacity: 0;
        transition: opacity 500ms ease;
        pointer-events: none;
      }

      .story-overlay a {
        pointer-events: auto;
      }

      .story-overlay[data-state="active"] {
        display: block;
        opacity: 1;
        pointer-events: auto;
        animation: storyOverlayIn 720ms cubic-bezier(.22,.61,.36,1) both;
      }

      @keyframes storyOverlayIn {
        from { opacity: 0; transform: translateY(1rem); }
        to { opacity: 1; transform: translateY(0); }
      }

      .metric-card,
      .path-card,
      .primary-path-card,
      .global-proof-card,
      .phone-shell {
        border: 1px solid rgba(255,255,255,0.16);
        background: rgba(10,10,10,0.46);
        backdrop-filter: blur(18px);
      }

      .primary-path-card {
        min-height: 10.5rem;
      }

      .phone-shell {
        border-radius: 2rem;
        padding: 0.55rem;
        box-shadow: 0 2rem 5rem rgba(0,0,0,0.18);
      }

      .phone-screen {
        border-radius: 1.45rem;
      }

      .story-cta-row {
        margin-top: 1.5rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
        max-width: 34rem;
      }

      .story-cta-link {
        border: 1px solid rgba(255,255,255,0.2);
        background: rgba(255,255,255,0.1);
        color: #FFFFFF;
        padding: 0.78rem 0.95rem;
        font-family: 'Anton', Impact, sans-serif;
        font-size: 0.7rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        line-height: 1;
        backdrop-filter: blur(16px);
        transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease, transform 180ms ease;
      }

      .story-cta-link:hover {
        border-color: rgba(255,255,255,0.45);
        background: rgba(255,255,255,0.16);
        color: #FFFFFF;
        transform: scale(1.045);
      }

      .story-cta-link.primary,
      .story-cta-link.red {
        border-color: #E30613;
        background: #E30613;
      }

      .story-cta-link.primary:hover,
      .story-cta-link.red:hover {
        border-color: #E30613;
        background: #E30613;
      }

      .store-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        min-width: 9.6rem;
        border: 1px solid rgba(255,255,255,0.36);
        border-radius: 0.5rem;
        background: #050505;
        color: #FFFFFF;
        padding: 0.58rem 0.78rem;
        text-transform: none;
        letter-spacing: 0;
      }

      .store-badge:hover {
        border-color: #FFFFFF;
        background: #050505;
        transform: scale(1.045);
      }

      .store-badge svg {
        width: 1.45rem;
        height: 1.45rem;
        flex: 0 0 auto;
      }

      .store-badge small {
        display: block;
        font-family: Arial, sans-serif;
        font-size: 0.62rem;
        line-height: 1;
        letter-spacing: 0;
      }

      .store-badge strong {
        display: block;
        font-family: Arial, sans-serif;
        font-size: 0.92rem;
        line-height: 1.05;
        letter-spacing: -0.02em;
        font-weight: 700;
      }

      .growth-bar {
        transform: scaleY(calc(0.18 + (var(--growth-progress) * 0.82)));
        transform-origin: bottom;
        transition: transform 120ms linear;
      }

      .global-proof-card {
        box-shadow: 0 2rem 5rem rgba(0,0,0,0.22);
      }

      .keyframe-card {
        min-height: 26rem;
      }

      .mobile-story-card {
        min-height: min(82svh, 46rem);
      }

      .mobile-story-media,
      .story-frame-bg {
        object-position: var(--story-object-desktop, 50% 50%);
      }

      .mobile-progress-dot {
        transition:
          transform 220ms ease,
          opacity 220ms ease,
          background-color 220ms ease,
          border-color 220ms ease;
      }

      .mobile-progress-dot[data-state="active"] {
        background: #E30613;
        border-color: #E30613;
        opacity: 1;
        transform: scaleY(1.1);
      }

      .mobile-progress-dot[data-state="inactive"] {
        opacity: 0.35;
      }

      @media (prefers-reduced-motion: reduce) {
        .story-bg,
        .story-copy,
        .story-overlay,
        .story-ball-system,
        .story-ball-image,
        .story-rail-dot,
        .story-rail-label {
          animation: none !important;
          transition: none !important;
        }
      }

      @media (max-width: 1100px) {
        .story-bg,
        .mobile-story-media,
        .story-frame-bg {
          object-position: var(--story-object-tablet, var(--story-object-desktop, 50% 50%));
        }
      }

      @media (max-width: 767px) {
        .mobile-story-media,
        .story-frame-bg {
          object-position: var(--story-object-mobile, var(--story-object-tablet, var(--story-object-desktop, 50% 50%)));
        }
      }
    </style>
  </Fragment>

  <main class="story-page">
    <section
      id="storyboard-desktop"
      class="story-shell relative hidden md:block"
      data-story-shell
      data-active="0"
        style={`height: ${storyBeats.length * 82}vh; --marker-x: ${storyBeats[0].markerX}%; --marker-y: ${storyBeats[0].markerY}%; --mask-x: ${storyBeats[0].maskX ?? storyBeats[0].markerX}%; --mask-y: ${storyBeats[0].maskY ?? storyBeats[0].markerY}%; --mask-size: ${storyBeats[0].maskSize ?? 0}vw; --mask-opacity: ${(storyBeats[0].maskSize ?? 0) > 0 ? 0.98 : 0};`}
    >
      <div class="story-viewport sticky top-16 overflow-hidden">
        {storyBeats.map((beat, index) => (
          beat.video ? (
            <video
              class="story-bg absolute inset-0 h-full w-full object-cover"
              aria-label={beat.alt}
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              poster={beat.image}
              style={mediaStyle(beat)}
              data-media="video"
              data-story-bg
              data-index={index}
              data-state={index === 0 ? 'active' : 'inactive'}
            >
              <source src={beat.video} type="video/mp4" />
            </video>
          ) : (
            <img
              class="story-bg absolute inset-0 h-full w-full object-cover"
              src={beat.image}
              alt={beat.alt}
              style={mediaStyle(beat)}
              data-media="image"
              data-story-bg
              data-index={index}
              data-state={index === 0 ? 'active' : 'inactive'}
            />
          )
        ))}

        <div class="story-shade absolute inset-0 bg-black/68"></div>
        <div class="story-shade absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-[#0A0A0A] to-transparent"></div>
        <div class="absolute inset-0 shadow-[inset_0_0_220px_rgba(0,0,0,0.72)]"></div>

        <aside class="story-rail absolute left-8 top-[10vh] z-30 h-[66vh] w-44">
          <div class="story-rail-line absolute left-5 top-0 bottom-0 w-px"></div>
          <div class="story-rail-fill absolute left-5 top-0 w-px transition-[height] duration-150 ease-linear"></div>
          <div class="absolute inset-y-0 left-0 flex flex-col justify-between py-1">
            {storyBeats.map((beat, index) => (
              <div class="grid grid-cols-[2.5rem_1fr] items-center gap-3">
                <span class="story-rail-dot ml-[0.875rem] h-3 w-3 rounded-full border border-current bg-transparent" data-story-dot data-index={index} data-state={index === 0 ? 'active' : 'inactive'}></span>
                <span class="story-rail-label font-heading uppercase tracking-[0.22em] text-[0.68rem]" data-story-label data-index={index} data-state={index === 0 ? 'active' : 'inactive'}>{beat.number} {beat.label}</span>
              </div>
            ))}
          </div>
        </aside>

        <div class="story-photo-ball-mask absolute z-10" data-story-mask aria-hidden="true"></div>

        <div class="story-ball-system absolute z-20" data-story-ball aria-hidden="true">
          <div class="story-ball-pulse">
            <img class="story-ball-image" src="/images/home-storyboard/yellow-football-object.png" alt="" />
          </div>
