const mediaStyle = (beat) => {
  const desktop = beat.objectPosition || '50% 50%'
  const tablet = beat.objectPositionTablet || desktop
  const mobile = beat.objectPositionMobile || tablet
  return `--story-object-desktop: ${desktop}; --story-object-tablet: ${tablet}; --story-object-mobile: ${mobile};`
}

---

<BaseLayout
  title="Joner Football | Technique Above Everything"
  description="Joner Football. Elite football coaching, global camps, and the world's best coaching app. Technique above everything."
  canonical="https://jonerfootball.com/"
>
  <Fragment slot="head">
    <style>
      .story-page {
        background: #0A0A0A;
        color: #FFFFFF;
        overflow-x: clip;
      }

      .story-shell {
        --story-progress: 0;
        --growth-progress: 0;
        --hero-word-progress: 0;
        --ball-rotation: 0deg;
        --ball-size: clamp(4.8rem, 5.8vw, 5.8rem);
        --ball-opacity: 1;
        --mask-x: var(--marker-x);
        --mask-y: var(--marker-y);
      }

      .story-viewport {
        height: calc(100svh - 4rem);
        min-height: 44rem;
        color: #FFFFFF;
        background: #0A0A0A;
        contain: layout paint;
        transition:
          background-color 700ms cubic-bezier(.22,.61,.36,1),
          color 700ms cubic-bezier(.22,.61,.36,1);
      }

      .story-bg {
        opacity: 0;
        transform: scale(1.06);
        object-position: var(--story-object-desktop, 50% 50%);
        filter: grayscale(0.12) contrast(1.06) brightness(0.76) saturate(1.04);
        transition:
          opacity 800ms cubic-bezier(.22,.61,.36,1),
          transform 1100ms cubic-bezier(.22,.61,.36,1),
          filter 900ms ease;
      }

      .story-bg[data-state="active"] {
        opacity: 1;
        transform: scale(1);
        filter: grayscale(0.02) contrast(1.08) brightness(0.92) saturate(1.06);
      }

      .story-bg[data-media="video"][data-state="active"] {
        opacity: 0.96;
        filter: grayscale(0) contrast(1.06) brightness(0.92) saturate(1.04);
      }

      .story-shade {
        opacity: 1;
        transition: opacity 700ms ease;
      }

      .story-shade-main {
        background: rgba(0,0,0,0.38);
      }

      .story-shade-bottom {
        background: linear-gradient(to top, rgba(10,10,10,0.82), rgba(10,10,10,0.3), rgba(10,10,10,0));
      }

      .story-vignette {
        box-shadow: inset 0 0 160px rgba(0,0,0,0.58);
      }

      .story-kicker {
        letter-spacing: 0.26em;
      }

      .story-rail {
        color: rgba(255,255,255,0.54);
        transition: color 700ms ease, opacity 420ms ease;
      }

      .story-rail-line {
        background: rgba(255,255,255,0.16);
        transition: background 700ms ease;
      }

      .story-rail-fill {
        height: calc(var(--story-progress) * 100%);
        background: #E30613;
      }

      .story-rail-dot,
      .story-rail-label {
        transition:
          opacity 260ms ease,
          transform 260ms ease,
          color 260ms ease,
          border-color 260ms ease,
          background-color 260ms ease;
      }

      .story-rail-label {
        display: block;
        letter-spacing: 0.14em;
        line-height: 1;
      }

      .story-rail-number,
      .story-rail-name {
        display: block;
      }

      .story-rail-number {
        color: rgba(255,255,255,0.88);
        font-size: 0.78rem;
      }

      .story-rail-name {
        margin-top: 0.28rem;
        color: rgba(255,255,255,0.72);
        font-size: 0.72rem;
      }

      .story-rail-dot[data-state="active"] {
        background: #E30613;
        border-color: #E30613;
        opacity: 1;
        transform: scale(1.18);
      }

      .story-rail-dot[data-state="inactive"] {
        opacity: 0.34;
      }

      .story-rail-label[data-state="active"] {
        opacity: 1;
        transform: translateX(0);
      }

      .story-rail-label[data-state="active"] .story-rail-number,
      .story-rail-label[data-state="active"] .story-rail-name {
        color: #FFFFFF;
      }

      .story-rail-label[data-state="inactive"] {
        opacity: 0.42;
        transform: translateX(-0.18rem);
      }

      .story-copy {
        display: none;
        position: absolute;
        max-width: 34rem;
        opacity: 0;
        pointer-events: none;
      }

      .story-copy[data-state="active"] {
        display: block;
        opacity: 1;
        pointer-events: auto;
        animation: storyCopyIn 620ms cubic-bezier(.22,.61,.36,1) both;
      }

      .story-copy[data-pos="center"] {
        left: 50%;
        top: 20%;
        transform: translateX(-50%);
        text-align: center;
        max-width: 56rem;
      }

      .story-copy[data-pos="action"] {
        left: 50%;
        top: 42%;
        transform: translateX(-50%);
        text-align: center;
        max-width: 56rem;
      }

      .story-copy[data-pos="action-left"] {
        left: clamp(13rem, 16vw, 15rem);
        top: 7vh;
        max-width: 68rem;
        text-align: left;
      }

      .story-copy[data-pos="hidden"] {
        display: none !important;
      }

      .story-copy[data-pos="left"] {
        left: clamp(13rem, 18vw, 18rem);
        top: 26%;
      }

      .story-copy[data-pos="top-left"] {
        left: clamp(13rem, 18vw, 18rem);
        top: 18vh;
      }

      .story-copy[data-pos="right"] {
        right: clamp(3rem, 8vw, 9rem);
        top: 26%;
      }

      .story-copy[data-pos="mid-left"] {
        left: clamp(16rem, 26vw, 25rem);
        top: 26%;
      }

      .story-copy[data-pos="hq-left"] {
        left: clamp(13rem, 18vw, 18rem);
        top: 17vh;
      }

      .story-stamp {
        display: inline-flex;
        margin-top: 1.15rem;
        border-left: 2px solid #E30613;
        padding-left: 1rem;
        font-family: 'Anton', Impact, sans-serif;
        font-size: clamp(2.8rem, 5.6vw, 5rem);
        line-height: 0.92;
        text-transform: uppercase;
        color: #FFFFFF;
      }

      @keyframes storyCopyIn {
        from { opacity: 0; transform: translateY(1.25rem); }
        to { opacity: 1; transform: translateY(0); }
      }

      .story-copy[data-pos="center"][data-state="active"] {
        animation-name: storyCopyInCenter;
      }

      .story-copy[data-pos="action"][data-state="active"] {
        animation-name: storyCopyInCenter;
      }

      @keyframes storyCopyInCenter {
        from { opacity: 0; transform: translate(-50%, 1.25rem); }
        to { opacity: 1; transform: translate(-50%, 0); }
      }

      .story-ball-system {
        left: var(--marker-x);
        top: var(--marker-y);
        opacity: var(--ball-opacity);
        transition:
          left 320ms cubic-bezier(.22,.61,.36,1),
          top 320ms cubic-bezier(.22,.61,.36,1),
          opacity 400ms ease;
        will-change: left, top, opacity;
      }

      .story-photo-ball-mask {
        display: none;
        left: var(--mask-x);
        top: var(--mask-y);
        width: clamp(0rem, var(--mask-size), 14rem);
        height: clamp(0rem, var(--mask-size), 14rem);
        transform: translate(-50%, -50%);
        border-radius: 999px;
        background:
          radial-gradient(circle, rgba(0,0,0,1) 0 76%, rgba(0,0,0,0.84) 86%, rgba(0,0,0,0) 100%);
        filter: blur(0.28rem);
        opacity: var(--mask-opacity, 0.92);
        pointer-events: none;
        transition:
          left 180ms linear,
          top 180ms linear,
          opacity 380ms ease,
          width 180ms linear,
          height 180ms linear;
        will-change: left, top;
      }

      .story-ball-pulse {
        width: var(--ball-size);
        height: var(--ball-size);
        border-radius: 999px;
        position: relative;
        overflow: visible;
        border: 0;
        background: transparent;
        box-shadow:
          0 1.1rem 2rem rgba(0,0,0,0.4),
          0 0 2.8rem rgba(227,6,19,0.18);
        transform: translate(-50%, -50%);
        transition: border-color 700ms ease, box-shadow 700ms ease;
      }

      .story-ball-pulse::before,
      .story-ball-pulse::after {
        display: none;
      }

      .story-ball-image {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
        filter:
          saturate(1.18)
          contrast(1.04)
          drop-shadow(0 1.1rem 1.35rem rgba(0,0,0,0.48));
        animation: storyBallSpinFlat 1.35s linear infinite;
        transform-origin: 50% 50%;
        will-change: transform;
      }

      @keyframes storyBallSpinFlat {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }

      .story-ball-logo {
        display: none;
      }

      .story-mini-ball {
        position: absolute;
        border-radius: 999px;
        background: url('/images/home-storyboard/yellow-football-object.png') center / contain no-repeat;
        box-shadow:
          0 0 1.8rem rgba(227,6,19,0.22);
      }

      .hero-scroll-title {
        display: grid;
        gap: 0.02em;
      }

      .hero-word {
        display: block;
        opacity: 0;
        transform: translateY(1.2rem);
        transition:
          opacity 360ms cubic-bezier(.22,.61,.36,1),
          transform 520ms cubic-bezier(.22,.61,.36,1);
      }

      .hero-word[data-visible="true"] {
        opacity: 1;
        transform: translateY(0);
      }

      .story-overlay {
        display: none;
        opacity: 0;
        transition: opacity 500ms ease;
        pointer-events: none;
      }

      .story-overlay a {
        pointer-events: auto;
      }

      .story-overlay[data-state="active"] {
        display: block;
        opacity: 1;
