  <script is:inline>
    (function () {
      var beatMarkers = [
        { x: 24.2, y: 48, maskX: 24.2, maskY: 48, maskSize: 0, ballSize: 'clamp(6.1rem, 7.8vw, 7.2rem)', ballVisible: true },
        { x: 63.2, y: 81, maskX: 63.2, maskY: 81, maskSize: 0, ballSize: 'clamp(6.8rem, 8.4vw, 7.9rem)', ballVisible: true },
        { x: 37.2, y: 72, maskX: 37.2, maskY: 72, maskSize: 0, ballSize: 'clamp(5.8rem, 6.8vw, 6.6rem)', ballVisible: true },
        { x: 34, y: 72, maskX: 34, maskY: 72, maskSize: 0, ballSize: 'clamp(4.8rem, 5.8vw, 5.7rem)', ballVisible: true },
        { x: 24, y: 75, maskX: 24, maskY: 75, maskSize: 0, ballSize: 'clamp(4.8rem, 5.8vw, 5.7rem)', ballVisible: true },
        { x: 77, y: 72, maskX: 77, maskY: 72, maskSize: 0, ballSize: 'clamp(4.8rem, 5.8vw, 5.7rem)', ballVisible: true },
        { x: 35, y: 70, maskX: 35, maskY: 70, maskSize: 0, ballSize: 'clamp(4.8rem, 5.8vw, 5.7rem)', ballVisible: true },
        { x: 18, y: 77, maskX: 18, maskY: 77, maskSize: 0, ballSize: 'clamp(4.8rem, 5.8vw, 5.7rem)', ballVisible: false }
      ];

      function clamp(value, min, max) {
        return Math.min(Math.max(value, min), max);
      }

      function lerp(start, end, amount) {
        return start + (end - start) * amount;
      }

      function smoothstep(value) {
        return value * value * (3 - (2 * value));
      }

      function initDesktopStory() {
        var shell = document.querySelector('[data-story-shell]');
        if (!shell || window.matchMedia('(max-width: 767px)').matches) return;

        var copies = Array.prototype.slice.call(shell.querySelectorAll('[data-story-copy]'));
        var backgrounds = Array.prototype.slice.call(shell.querySelectorAll('[data-story-bg]'));
        var overlays = Array.prototype.slice.call(shell.querySelectorAll('[data-story-overlay]'));
        var dots = Array.prototype.slice.call(shell.querySelectorAll('[data-story-dot]'));
        var labels = Array.prototype.slice.call(shell.querySelectorAll('[data-story-label]'));
        var growthCounters = Array.prototype.slice.call(shell.querySelectorAll('[data-growth-count]'));
        var heroWords = Array.prototype.slice.call(shell.querySelectorAll('[data-hero-word]'));
        var total = copies.length;

        function formatGrowth(value, format) {
          if (format === 'millions') {
            return (value / 1000000).toFixed(value > 1900000 ? 0 : 1).replace('.0', '') + 'M+';
          }

          if (format === 'thousands') {
            return Math.round(value / 1000) + 'K+';
          }

          if (format === 'comma') {
            return Math.round(value).toLocaleString('en-US') + '+';
          }

          return Math.round(value) + '+';
        }

        function apply(nextIndex, progress) {
          var localProgress = clamp((progress * total) - nextIndex, 0, 1);
          var markerFrom = beatMarkers[nextIndex] || beatMarkers[0];
          var marker = {
            x: markerFrom.x,
            y: markerFrom.y
          };

          if (nextIndex === 0) {
            var markerTo = beatMarkers[1] || markerFrom;
            var heroMarkerAmount = smoothstep(clamp((localProgress - 0.78) / 0.22, 0, 1));
            marker = {
              x: lerp(markerFrom.x, markerTo.x, heroMarkerAmount),
              y: lerp(markerFrom.y, markerTo.y, heroMarkerAmount)
            };
          }

          var heroProgress = nextIndex === 0 ? localProgress : nextIndex > 0 ? 1 : 0;
          var growthProgress = nextIndex < 2 ? 0 : nextIndex > 2 ? 1 : localProgress;
          var easedGrowth = 1 - Math.pow(1 - growthProgress, 3);

          shell.dataset.active = String(nextIndex);
          shell.style.setProperty('--story-progress', String(progress));
          shell.style.setProperty('--hero-word-progress', String(heroProgress));
          shell.style.setProperty('--growth-progress', String(growthProgress));
          shell.style.setProperty('--marker-x', marker.x + '%');
          shell.style.setProperty('--marker-y', marker.y + '%');
          shell.style.setProperty('--ball-size', markerFrom.ballSize || 'clamp(4.8rem, 5.8vw, 5.8rem)');
          shell.style.setProperty('--ball-opacity', markerFrom.ballVisible === false ? '0' : '1');
          var activeMask = beatMarkers[nextIndex] || marker;
          var activeMaskSize = activeMask.maskSize || 0;
          shell.style.setProperty('--mask-x', (activeMask.maskX || activeMask.x) + '%');
          shell.style.setProperty('--mask-y', (activeMask.maskY || activeMask.y) + '%');
          shell.style.setProperty('--mask-size', activeMaskSize + 'vw');
          shell.style.setProperty('--mask-opacity', activeMaskSize > 0 ? '0.98' : '0');
          shell.style.setProperty('--ball-rotation', (progress * 520) + 'deg');

          heroWords.forEach(function (word, wordIndex) {
            var thresholds = [0.18, 0.46, 0.74];
            var threshold = thresholds[wordIndex] || 0.74;
            word.setAttribute('data-visible', heroProgress >= threshold ? 'true' : 'false');
          });

          growthCounters.forEach(function (counter) {
            var target = Number(counter.getAttribute('data-growth-target')) || 0;
            var format = counter.getAttribute('data-growth-format') || 'plain';
            counter.textContent = formatGrowth(target * easedGrowth, format);
          });

          copies.forEach(function (copy, index) {
            copy.setAttribute('data-state', index === nextIndex ? 'active' : 'inactive');
          });

          backgrounds.forEach(function (background, index) {
            var active = index === nextIndex;
            background.setAttribute('data-state', active ? 'active' : 'inactive');

            if (background.tagName === 'VIDEO') {
              if (active) {
                var playPromise = background.play();
                if (playPromise && typeof playPromise.catch === 'function') {
                  playPromise.catch(function () {});
                }
              } else {
                background.pause();
              }
            }
          });

          overlays.forEach(function (overlay, index) {
            var active = index === nextIndex;
            overlay.hidden = !active;
            overlay.setAttribute('data-state', active ? 'active' : 'inactive');
          });

          dots.forEach(function (dot, index) {
            dot.setAttribute('data-state', index === nextIndex ? 'active' : 'inactive');
          });

          labels.forEach(function (label, index) {
            label.setAttribute('data-state', index === nextIndex ? 'active' : 'inactive');
          });
        }

        function update() {
          var rect = shell.getBoundingClientRect();
          var scrollable = shell.offsetHeight - window.innerHeight;
          var progress = scrollable > 0 ? clamp(-rect.top / scrollable, 0, 1) : 0;
          var index = Math.min(total - 1, Math.floor(progress * total));
          apply(index, progress);
        }

        var ticking = false;
        function requestUpdate() {
          if (ticking) return;
          ticking = true;
          window.requestAnimationFrame(function () {
            update();
            ticking = false;
          });
        }

        window.addEventListener('scroll', requestUpdate, { passive: true });
        window.addEventListener('resize', requestUpdate);
        update();
      }

      initDesktopStory();
    })();
  </script>
</BaseLayout>
