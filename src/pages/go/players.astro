  "A filmed session does. I'm on the screen doing every rep with you. You copy it, then you do it again tomorrow.",
]

const steps = [
  { head: 'Pick a program', body: 'Weak foot, finishing, passing and first touch, or a 20, 30 or 60 minute session.' },
  { head: 'Press play', body: 'Phone, tablet or laptop. A ball and some space is enough for most sessions.' },
  { head: 'Copy every rep', body: 'I show it, you do it. Next session, it gets harder.' },
]

const programs = [
  { art: 'weakfoot', title: 'Weak Foot Program', detail: '10 weeks. One 60 minute session each week, from tight control to striking.' },
  { art: 'goals', title: 'Score More Goals', detail: '8 sessions. 4 drills every session, 3 sets of each. A lot of shooting.' },
  { art: 'passing6w', title: '6 Week Passing & 1st Touch', detail: '12 sessions, each one harder than the last.' },
  { art: 'min30', title: 'Follow-along sessions', detail: '20, 30 and 60 minute sessions. Press play and train start to finish.' },
  { art: 'juggling', title: 'Juggling Program', detail: 'Grab a ball. That is all you need.' },
]

const quotes = [
  { quote: 'Thanks this helped!!!', name: 'Josh P.', role: 'Player, comment on the Dribbling Program' },
  { quote: 'there is not in my opinion another app nor channel on the web like yours with so much quality to offer for football training, skills, mindset, etc.', name: 'Milan B.', role: 'Plus member' },
]

const faqs = [
  { q: 'What do I need?', a: 'A ball and some space for most sessions. Some programs use cones, a wall or a goal, and each one tells you what to bring before you start.' },
  { q: 'What age is it for?', a: 'There are sessions grouped by age: 6 to 9, 10 to 13 and 14+. The programs work for any player who wants to get better.' },
