---
import BaseLayout from '../layouts/BaseLayout.astro'
import EmailCapture from '../components/EmailCapture.astro'

const ctaUrl = 'https://app.jonerfootball.com?utm_source=website&utm_medium=programmes_page&utm_campaign=100_day_programme'

const programSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'Joner Football 100 Day Development Program',
  description: 'A structured 100 day football training plan for parents, players and coaches inside the Joner Football App.',
  provider: {
    '@type': 'Organization',
    name: 'Joner Football',
    url: 'https://jonerfootball.com'
  }
}

const proof = [
  ['140+', 'Countries'],
  ['12,000+', 'Players'],
  ['1,500+', 'Drills'],
  ['4.9', 'App rating'],
]

const audiences = [
  {
    title: 'For Parents',
    text: 'Give your child a proven plan they can follow at home, in the garden, at the park or before team training.'
  },
  {
    title: 'For Players',
    text: 'Train with purpose every day. Improve your touch, weak foot, control, passing and finishing with sessions you can follow on your phone.'
  },
  {
    title: 'For Coaches',
    text: 'Use the program as extra player homework, technical development or a structured pathway for individuals in your team.'
  },
]

const programs = [
  {
    title: 'Ball Mastery',
    text: 'Build control, confidence and comfort on the ball with daily touches and technical repetition.',
    image: '/images/programmes/claude-design/insideProgram.png'
  },
  {
    title: 'First Touch + Passing',
    text: 'Improve receiving, scanning, passing detail and the ability to play quicker under pressure.',
    image: '/images/programmes/claude-design/nightField.png'
  },
  {
    title: 'Weak Foot',
    text: 'Turn your weaker side into a real weapon with progressive weak foot training.',
    image: '/images/programmes/claude-design/coachingCircle.png'
  },
  {
    title: 'Score More Goals',
    text: 'Develop finishing technique, composure, ball striking and movement in front of goal.',
    image: '/images/programmes/claude-design/leePhones.png'
  },
]

const steps = [
  ['Download The App', 'Get the Joner Football App on your phone and open the 100 Day Program.'],
  ['Follow The Session', 'Watch the video, copy the detail and complete the work at your own level.'],
  ['Build The Habit', 'Train consistently, track progress and move through the full 100 day pathway.'],
  ['See The Difference', 'Cleaner touch. Sharper technique. More confidence. Better football.'],
]

const results = [
  'Better first touch',
  'More control under pressure',
  'A stronger weak foot',
  'Cleaner ball striking',
  'More confidence when the ball comes to you',
]

const testimonials = [
  ['My son finally had a plan to follow. He stopped guessing what to train and started improving properly.', 'Parent of U12 player'],
  ['The weak foot section changed my game. I actually trust it now.', 'Academy player'],
  ['I use Joner Football sessions with my players every week. The detail is top level.', 'Grassroots coach'],
]

const faqs = [
  ['Who is the 100 Day Program for?', 'It is for players who want to improve their technique with a clear plan. Parents can use it to guide their child, players can follow it alone and coaches can use it as extra development work.'],
  ['How long does each session take?', 'Most sessions are designed to be short and focused. Around 20 minutes a day is enough if the player trains with intent.'],
  ['Do I need much equipment?', 'No. A ball, a small space and a phone is enough for most sessions. Cones or markers help, but they are not essential.'],
  ['Is this for beginners or advanced players?', 'Both. The details matter at every level. Younger players can build the foundation, advanced players can sharpen the quality.'],
  ['Where do I access the program?', 'Inside the Joner Football App.'],
  ['Can coaches use this with their players?', 'Yes. Coaches can use it as player homework, individual development or extra technical work between team sessions.'],
]
---

<BaseLayout
  title="100 Day Football Program | Joner Football"
  description="A structured 100 day football training plan for parents, players and coaches. Improve ball mastery, first touch, weak foot and finishing inside the Joner Football App."
  schema={programSchema}
>
  <section class="relative overflow-hidden bg-joner-black">
    <div class="absolute -right-32 -top-20 hidden h-[900px] w-[520px] rotate-12 bg-joner-red/25 lg:block"></div>
    <div class="absolute right-28 top-0 hidden h-full w-1 rotate-12 bg-joner-red lg:block"></div>

    <div class="relative z-10 mx-auto grid min-h-[620px] max-w-7xl items-center gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[1.08fr_0.92fr] lg:px-8 lg:py-24">
      <div>
        <p class="mb-4 font-heading text-sm uppercase tracking-[0.24em] text-joner-red">The 100 Day Development Program</p>
        <h1 class="mb-6 max-w-3xl font-heading text-5xl font-bold uppercase leading-[0.9] text-white sm:text-6xl lg:text-7xl">
          100 Days To Better Football
        </h1>
        <p class="max-w-2xl font-body text-lg leading-relaxed text-gray-200 sm:text-xl">
          A structured football training plan built by Lee Jones to help players improve their ball mastery, first touch, weak foot and finishing inside the Joner Football App.
        </p>
        <p class="mt-4 max-w-xl font-body text-sm uppercase tracking-[0.18em] text-gray-400">
          For parents, players and coaches who want a clear plan, not random drills.
        </p>
        <div class="mt-8 flex flex-col gap-4 sm:flex-row">
          <a href={ctaUrl} target="_blank" rel="noopener noreferrer" class="btn-red px-9 py-4 text-center text-base">Start The 100 Day Program</a>
          <a href="#inside" class="border border-white px-9 py-4 text-center font-heading text-sm uppercase tracking-wide text-white transition hover:bg-white hover:text-joner-black">See What Is Inside</a>
        </div>
      </div>

      <div class="relative hidden lg:block">
        <div class="border-2 border-joner-red bg-joner-black shadow-2xl shadow-black/50">
          <img src="/images/programmes/claude-design/hero100Days.png" alt="100 Days To Your Best Football design" class="mx-auto w-full object-contain" />
        </div>
        <div class="absolute -left-4 top-8 bg-joner-red px-5 py-3 font-heading text-sm font-bold uppercase tracking-[0.18em] text-white">Start Today</div>
      </div>
    </div>
  </section>

  <section class="border-y border-gray-800 bg-joner-black">
    <div class="mx-auto grid max-w-7xl grid-cols-2 px-4 sm:px-6 lg:grid-cols-4 lg:px-8">
      {proof.map(([number, label]) => (
        <div class="border-gray-800 py-6 text-center lg:border-r last:border-r-0">
          <div class="font-heading text-3xl font-bold uppercase text-joner-red sm:text-4xl">{number}</div>
          <div class="mt-2 font-heading text-xs uppercase tracking-[0.22em] text-gray-400">{label}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-white py-16 text-joner-black md:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <p class="mb-3 font-heading text-sm uppercase tracking-[0.24em] text-joner-red">Why It Works</p>
      <h2 class="section-heading mb-5 max-w-4xl text-joner-black">Most Players Train Hard. The Best Players Train With A Plan.</h2>
      <div class="max-w-3xl space-y-4 font-body text-lg leading-relaxed text-gray-700">
        <p>Random drills only get you so far.</p>
        <p>The 100 Day Program gives players a clear daily structure. Every session has a purpose. Every week builds on the last. Every touch moves them closer to becoming cleaner, sharper and more confident on the ball.</p>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {audiences.map((item) => (
          <div class="border border-gray-200 bg-gray-50 p-7">
            <h3 class="mb-3 font-heading text-xl font-bold uppercase text-joner-black">{item.title}</h3>
            <p class="font-body text-gray-700">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-joner-black py-16 md:py-24">
    <div class="mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
      <p class="mb-3 font-heading text-sm uppercase tracking-[0.24em] text-joner-red">The Line</p>
      <h2 class="font-heading text-4xl font-bold uppercase leading-tight text-white sm:text-5xl lg:text-6xl">
        While Other Kids Watch YouTube Highlights, Yours Will Be Creating Them.
      </h2>
      <div class="mx-auto mt-7 max-w-2xl space-y-4 font-body text-lg leading-relaxed text-gray-300">
        <p>That is the standard.</p>
        <p>Not more scrolling. Not another random drill saved to camera roll. A real 100 day development plan players can actually follow.</p>
      </div>
      <a href={ctaUrl} target="_blank" rel="noopener noreferrer" class="btn-red mt-8 inline-block px-9 py-4 text-center">Start The Program</a>
    </div>
  </section>

  <section id="inside" class="bg-joner-gray py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 max-w-3xl">
        <p class="mb-3 font-heading text-sm uppercase tracking-[0.24em] text-joner-red">What Is Inside</p>
        <h2 class="section-heading mb-5 text-white">Four Programs. One Complete System.</h2>
        <p class="font-body text-lg leading-relaxed text-gray-300">The 100 Day Program brings together four key areas every serious player needs. Ball mastery, first touch, weak foot and finishing.</p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {programs.map((program, index) => (
          <article class="overflow-hidden border border-gray-800 bg-joner-black">
            <img src={program.image} alt={`${program.title} inside the Joner Football 100 Day Program`} loading="lazy" class="h-48 w-full object-cover" />
            <div class="p-6">
              <div class="mb-4 font-heading text-4xl font-bold text-joner-red">0{index + 1}</div>
              <h3 class="mb-3 font-heading text-xl font-bold uppercase text-white">{program.title}</h3>
              <p class="font-body text-sm leading-relaxed text-gray-400">{program.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-joner-black py-16 text-white md:py-24">
    <img src="/images/programmes/claude-design/coachingCircle.png" alt="Coach Joner teaching a player huddle" loading="lazy" class="absolute inset-0 h-full w-full object-cover opacity-35" />
    <div class="absolute inset-0 bg-gradient-to-b from-joner-black/70 to-joner-black/95"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="mb-3 font-heading text-sm uppercase tracking-[0.24em] text-joner-red">What You Get</p>
        <h2 class="font-heading text-4xl font-bold uppercase leading-none text-white md:text-6xl">Academy Level Coaching, <span class="text-joner-red">In Your Pocket.</span></h2>
      </div>
      <div class="mt-12 grid border border-white/15 md:grid-cols-4">
        {audiences.map((item) => (
          <div class="border-b border-white/15 bg-joner-black/55 p-7 md:border-b-0 md:border-r last:border-r-0">
            <h3 class="mb-3 font-heading text-xl font-bold uppercase text-white">{item.title}</h3>
            <p class="font-body text-sm leading-relaxed text-gray-300">{item.text}</p>
          </div>
        ))}
        <div class="bg-joner-red p-7">
          <h3 class="mb-3 font-heading text-xl font-bold uppercase text-white">The Standard</h3>
          <p class="font-body text-sm leading-relaxed text-white/90">No random scrolling. No dead reps. One clear plan to follow for the next 100 days.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white text-joner-black">
    <div class="relative flex min-h-[360px] items-center overflow-hidden">
      <img src="/images/programmes/claude-design/nightField.png" alt="Coach Joner on the pitch at night" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-r from-joner-black/85 via-joner-black/60 to-joner-black/20"></div>
      <div class="relative mx-auto w-full max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
        <p class="mb-3 font-heading text-sm uppercase tracking-[0.24em] text-white"><span class="text-joner-red">■</span> How It Works</p>
        <h2 class="max-w-3xl font-heading text-4xl font-bold uppercase leading-none text-white md:text-6xl">20 Minutes A Day. <span class="text-joner-red">100 Days Straight.</span></h2>
      </div>
    </div>
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 md:py-24">
      <div class="grid gap-0 border-t-2 border-joner-black md:grid-cols-4">
        {steps.map(([title, text], index) => (
          <div class="border-b border-gray-200 p-7 md:border-r last:border-r-0">
            <div class="mb-5 font-heading text-5xl font-bold text-joner-red">0{index + 1}</div>
            <h3 class="mb-3 font-heading text-xl font-bold uppercase text-joner-black">{title}</h3>
            <p class="font-body text-gray-700">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-joner-black py-16 md:py-24">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:px-8">
      <img src="/images/programmes/claude-design/leePhones.png" alt="Coach Lee Jones with the Joner Football app" loading="lazy" class="w-full object-contain" />
      <div>
        <p class="mb-3 font-heading text-sm uppercase tracking-[0.24em] text-joner-red">Built By Lee Jones</p>
        <h2 class="section-heading mb-6 text-white">Pro Level Detail. Made Simple For Every Player.</h2>
        <div class="space-y-4 font-body text-lg leading-relaxed text-gray-300">
          <p>Lee Jones has coached players all over the world, from grassroots kids to elite professionals.</p>
          <p>The 100 Day Program takes the same technical detail Lee uses on the pitch and turns it into a simple daily plan any player can follow.</p>
        </div>
        <blockquote class="mt-8 border-l-4 border-joner-red pl-6 font-heading text-2xl font-bold uppercase leading-tight text-white">
          This is the system I wish I had when I was younger. No fluff. No wasted touches. Just proper technique work, every day.
        </blockquote>
        <p class="mt-5 font-heading text-lg uppercase tracking-wide text-white">Lee Jones</p>
        <p class="font-body text-sm text-gray-500">Founder, Joner Football</p>
      </div>
    </div>
  </section>

  <section class="bg-joner-gray py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <p class="mb-3 text-center font-heading text-sm uppercase tracking-[0.24em] text-joner-red">Who It Is For</p>
      <h2 class="section-heading mx-auto mb-10 max-w-3xl text-center text-white">If You Want To Improve, This Is For You.</h2>
      <div class="grid gap-5 md:grid-cols-4">
        <div class="border border-gray-800 bg-joner-black p-6">
          <h3 class="mb-3 font-heading text-lg font-bold uppercase text-white">Parents</h3>
          <p class="font-body text-sm text-gray-400">You want your child doing the right work between team sessions.</p>
        </div>
        <div class="border border-gray-800 bg-joner-black p-6">
          <h3 class="mb-3 font-heading text-lg font-bold uppercase text-white">Players</h3>
          <p class="font-body text-sm text-gray-400">You want to feel sharper, cleaner and more confident every time you touch the ball.</p>
        </div>
        <div class="border border-gray-800 bg-joner-black p-6">
          <h3 class="mb-3 font-heading text-lg font-bold uppercase text-white">Coaches</h3>
          <p class="font-body text-sm text-gray-400">You want a simple way to give your players extra technical work away from training.</p>
        </div>
        <div class="border border-joner-red bg-joner-black p-6">
          <h3 class="mb-3 font-heading text-lg font-bold uppercase text-joner-red">Not For</h3>
          <p class="font-body text-sm text-gray-400">This is not for players who want shortcuts. It works when you do the sessions.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 text-joner-black md:py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <p class="mb-3 font-heading text-sm uppercase tracking-[0.24em] text-joner-red">The Result</p>
      <h2 class="section-heading mb-8 text-joner-black">100 Days From Now, Your Game Can Look Different.</h2>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
        {results.map((result) => (
          <div class="border border-gray-200 bg-gray-50 p-5 font-heading text-base font-bold uppercase text-joner-black">{result}</div>
        ))}
      </div>
      <p class="mt-8 font-body text-lg text-gray-700">That is what daily technical work does.</p>
      <a href={ctaUrl} target="_blank" rel="noopener noreferrer" class="btn-red mt-8 inline-block px-9 py-4 text-center">Start The 100 Day Program</a>
    </div>
  </section>

  <section class="bg-joner-black py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <p class="mb-3 text-center font-heading text-sm uppercase tracking-[0.24em] text-joner-red">Real Players. Real Progress.</p>
      <h2 class="section-heading mb-10 text-center text-white">Trusted By Parents, Players And Coaches.</h2>
      <div class="grid gap-6 md:grid-cols-3">
        {testimonials.map(([quote, who]) => (
          <figure class="border border-gray-800 bg-joner-gray p-7">
            <blockquote class="font-body text-lg leading-relaxed text-gray-200">“{quote}”</blockquote>
            <figcaption class="mt-6 border-t border-gray-800 pt-4 font-heading text-sm uppercase tracking-wide text-joner-red">{who}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-joner-gray py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <p class="mb-3 text-center font-heading text-sm uppercase tracking-[0.24em] text-joner-red">Questions</p>
      <h2 class="section-heading mb-12 text-center text-white">Common Questions</h2>
      <div class="space-y-6">
        {faqs.map(([question, answer], index) => (
          <div class={index < faqs.length - 1 ? 'border-b border-gray-800 pb-6' : 'pb-6'}>
            <h3 class="mb-2 font-heading text-lg font-semibold uppercase text-white">{question}</h3>
            <p class="font-body leading-relaxed text-gray-400">{answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <EmailCapture />

  <section class="bg-joner-red py-16 md:py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
      <p class="mb-3 font-heading text-sm uppercase tracking-[0.24em] text-white/80">Start Today</p>
      <h2 class="mb-5 font-heading text-4xl font-bold uppercase leading-tight text-white md:text-6xl">Give The Next 100 Days A Plan.</h2>
      <p class="mx-auto mb-8 max-w-2xl font-body text-lg text-white/85">Open the Joner Football App, start Day 1 and follow the system.</p>
      <a href={ctaUrl} target="_blank" rel="noopener noreferrer" class="inline-block bg-white px-10 py-4 font-heading text-base uppercase tracking-wider text-joner-red transition hover:bg-gray-100">Start The 100 Day Program</a>
      <p class="mt-5 font-body text-sm text-white/75">Train better today. Play better tomorrow.</p>
    </div>
  </section>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('a[href*="100_day_programme"]').forEach((link) => {
        link.addEventListener('click', () => {
          if (typeof window !== 'undefined' && typeof window.fbq === 'function') {
            window.fbq('trackCustom', 'ProgrammesCTAClick', {
              page: 'programmes',
              destination: 'app',
            })
          }
        })
      })
    })
  </script>
</BaseLayout>
