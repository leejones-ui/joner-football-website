---
import BaseLayout from '../layouts/BaseLayout.astro'
import GeoAnswers from '../components/GeoAnswers.astro'
import FactsMarquee from '../components/FactsMarquee.astro'
import PlayButtonVideo from '../components/PlayButtonVideo.astro'
import ScrollRevealSection from '../components/ScrollRevealSection.astro'
import CoachesTestimonialsCarousel from '../components/CoachesTestimonialsCarousel.astro'
import { faqSchema, webPageSchema, breadcrumbSchema } from '../lib/seoSchema'

const JOIN_LINK = '/join'
const BUNDLE_LINK = 'https://app.jonerfootball.com/checkout/new?o=227739'

const tickerFacts = [
  'Voted Top 10 In The World For Technical Training',
  '50,000+ Downloads',
  '15+ Countries',
  '1,500+ Training Videos',
  '100 Day Development Program',
  'Grassroots To Professional Videos',
]

// "Who is it built for" scroll-reveal callouts (mirrors teams and coaches)
const builtFor = [
  { label: 'All Ages', side: 'left', top: '26%' },
  { label: 'All Levels', side: 'right', top: '44%' },
  { label: 'All Abilities', side: 'left', top: '64%' },
  { label: 'No Excuses', side: 'right', top: '82%' },
]

// Every program included in the 100 Day pathway (the slide bar going across)
const programs = [
  { num: '01', title: 'Juggling Program', meta: '2 Days', body: 'Build your foundation. Ball feel, coordination and touch.' },
  { num: '02', title: 'Fast Feet Program', meta: '7 Sessions', body: 'Quick feet that leave defenders guessing.' },
  { num: '03', title: 'Passing & First Touch', meta: '13 Sessions', body: 'The foundation of everything. Control under pressure, crisp passing.' },
  { num: '04', title: 'Dribbling Program', meta: '8 Sessions', body: 'Beat any defender. Close control and changes of direction.' },
  { num: '05', title: 'Weak Foot Program', meta: '11 Sessions', body: 'Double your options on the pitch.' },
  { num: '06', title: 'Score More Goals', meta: '9 Sessions', body: 'Turn chances into goals. Finishing technique and composure.' },
  { num: '07', title: 'Strength & Conditioning', meta: '12 Weeks', body: 'Advanced S&C for older players ready to build a real physical base.' },
]

const faqs: Array<{ q: string; a: string }> = [
  { q: 'What ages and levels is this for?', a: 'The programs work for players of all ages and levels. Whether you are 10 or 30, just starting out or playing at a high level, the structured pathway meets you where you are and builds from there.' },
  { q: 'How long are the sessions?', a: 'Sessions run from 20 minutes up to an hour, depending on the program and the day. Designed to fit around work, school and team training.' },
  { q: 'Do I need any equipment?', a: 'Each program will clearly tell you what you need to complete it. Everything is based around minimal equipment.' },
  { q: 'What if I already train with a team?', a: 'This is individual development. The extra work that separates good players from great ones. It complements team training, it does not replace it.' },
  { q: 'How does the 100 day guarantee work?', a: 'Annual members only. Follow the program for 100 days. If you do not see improvement, we give you an extra 100 days free and you can DM Lee directly inside the app.' },
  { q: 'Are the programs available on monthly?', a: 'The structured 100 day pathway and the guarantee are exclusive to Annual members. Monthly members access the full video library. Move to Annual to access the programs.' },
  { q: 'What about the S&C program?', a: 'The 12 Week Advanced Strength and Conditioning Program is included with Annual membership. Designed for older players ready to take their physical development seriously.' },
]

const programSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: 'Joner Football 100 Day Development Program',
    description: 'A structured football training programme built by Lee Jones for players, parents and coaches who want clearer sessions and faster improvement.',
    provider: { '@type': 'Organization', name: 'Joner Football', url: 'https://jonerfootball.com' },
  },
  webPageSchema({
    name: 'Football Training Programmes | 100 Day Player Programme',
    description: 'Follow structured Joner Football training programmes built to improve technique, confidence and consistency with clear sessions and daily focus.',
    url: 'https://jonerfootball.com/programmes/',
  }),
  breadcrumbSchema([
    { name: 'Home', url: 'https://jonerfootball.com/' },
    { name: 'Football Training App', url: 'https://jonerfootball.com/app/' },
    { name: '100 Day Programme', url: 'https://jonerfootball.com/programmes/' },
  ]),
  faqSchema(faqs),
]

import SanityPageRenderer from '../components/sanity/SanityPageRenderer.astro'
import { fetchSanityPage } from '../lib/sanityPages'
import { shouldReplaceSanityPage } from '../lib/sanityPageUtils'

const sanityPage = await fetchSanityPage('programmes')
---

{shouldReplaceSanityPage(sanityPage) ? (
  <SanityPageRenderer page={sanityPage} />
) : (
<BaseLayout
  title="Football Training Programmes | 100 Day Player Programme"
  description="Follow structured Joner Football training programmes built to improve technique, confidence and consistency with clear sessions and daily focus."
  schema={programSchemas}
>
  <main class="programmes-page bg-joner-black text-white">
    {/* HERO (full-bleed, mirrors teams, single CTA) */}
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 bg-joner-black">
        <img src="/images/programmes/100-day/hero-cropped.webp" alt="Lee Jones training a young player" class="h-full w-full object-cover object-center" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-r from-joner-black/95 via-joner-black/60 to-joner-black/20"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-joner-black/60 via-transparent to-transparent"></div>
      </div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center min-h-[440px] md:min-h-[520px] py-14 md:py-16">
        <div class="max-w-2xl">
          <p class="text-joner-red font-heading text-sm uppercase tracking-widest mb-5">The 100 Day Transformation</p>
          <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl font-bold text-white uppercase leading-none mb-5">The 100 Day Transformation Program</h1>
          <p class="text-gray-200 font-body text-lg md:text-xl max-w-xl mb-7">100 days of structured football training for players who want to stand out. One clear plan inside the app.</p>
          <div>
            <a href={JOIN_LINK} class="btn-red text-base px-8 py-4 inline-flex text-center">Start Free Trial</a>
          </div>
        </div>
      </div>
    </section>

    <FactsMarquee facts={tickerFacts} />

    {/* WATCH THIS FIRST (matches teams: short heading, one line) */}
    <section class="bg-joner-black py-12 md:py-16">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
        <p class="mb-3 font-heading text-xs uppercase tracking-[0.28em] text-joner-red sm:text-sm">Watch This First</p>
        <h2 class="mb-6 font-heading text-2xl md:text-4xl font-bold uppercase leading-tight text-white">See exactly how the 100 day transformation program works.</h2>
        <PlayButtonVideo src="/videos/100-day-landing.mp4" poster="/videos/100-day-landing-poster.jpg" label="Play the 100 day intro video" />
      </div>
    </section>

    {/* PROBLEM (Stop-Winging layout: text left, graphic right) */}
    <section class="bg-white text-joner-black py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="order-2 lg:order-1">
          <p class="text-joner-red font-heading text-sm uppercase tracking-widest mb-4">The Reality</p>
          <h2 class="font-heading text-4xl md:text-6xl font-bold text-joner-black uppercase leading-none mb-6">Not Enough Players Train On Their Own With Structure</h2>
          <p class="text-lg text-gray-700 font-body mb-8 max-w-xl">Team training is once or twice a week. So is everyone else's. The players who pull ahead do structured work on their own, every week. Most players never do because they have no plan.</p>
          <a href={JOIN_LINK} class="btn-red text-base px-8 py-4 inline-flex text-center">Start Free Trial</a>
        </div>
        <div class="order-1 lg:order-2 overflow-hidden rounded-[24px] shadow-[0_28px_70px_rgba(0,0,0,0.24)] ring-1 ring-black/10">
          <img src="/images/programmes/100-day/train-smart.jpg" alt="Train smart. Improve every day. Train with structure, detailed follow along sessions, hold yourself accountable, guaranteed improvement if you follow the steps." class="block w-full object-cover" loading="lazy" />
        </div>
      </div>
    </section>

    {/* WHO IS IT BUILT FOR (scroll-reveal, mirrors teams and coaches) */}
    <ScrollRevealSection
      eyebrow="WHO IS IT BUILT FOR?"
      heading="Built For Every Player"
      mobileImage="/images/teams/who-its-for-mobile.jpg"
      desktopImage="/images/programmes/100-day/night-field.webp"
      items={builtFor}
      alt="A young player training with the ball"
    />

    {/* THE PATHWAY (every program included, horizontal slide bar) */}
    <section class="bg-joner-black py-16 md:py-24 overflow-hidden">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mb-10 md:mb-14">
          <p class="text-joner-red font-heading text-sm uppercase tracking-widest mb-4">The 100 Day Pathway</p>
          <h2 class="font-heading text-4xl md:text-6xl font-bold text-white uppercase leading-none mb-6">Every Program Included</h2>
          <p class="font-body text-lg text-gray-300 max-w-2xl">Done in order. Every day planned. Every skill built on the last. This is the full pathway that transforms a player.</p>
        </div>
      </div>
      <div class="mx-auto max-w-7xl">
        <div class="flex gap-4 md:gap-5 overflow-x-auto snap-x snap-mandatory scrollbar-hide px-4 sm:px-6 lg:px-8 pb-2">
          {programs.map((p) => (
            <article class="snap-start shrink-0 w-[78vw] sm:w-[340px] bg-joner-gray border border-gray-800 rounded-2xl p-7 flex flex-col">
              <div class="flex items-center justify-between mb-5">
                <span class="font-heading text-joner-red text-5xl leading-none">{p.num}</span>
                <span class="font-heading text-xs uppercase tracking-widest text-gray-400 border border-gray-700 rounded-full px-3 py-1.5">{p.meta}</span>
              </div>
              <h3 class="font-heading text-2xl text-white uppercase leading-tight mb-3 tracking-wide">{p.title}</h3>
              <p class="text-gray-300 font-body text-sm leading-relaxed">{p.body}</p>
            </article>
          ))}
        </div>
      </div>
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 mt-12">
        <a href={JOIN_LINK} class="btn-red text-base px-8 py-4 inline-flex text-center">Start Free Trial</a>
      </div>
    </section>

    {/* WHO IS TEACHING YOU (clean photo + live text, responsive, mirrors teams) */}
    <section class="bg-joner-gray py-12 md:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
          <div class="order-2 lg:order-1 flex flex-col justify-center">
            <p class="text-joner-red font-heading text-sm uppercase tracking-widest mb-3">Who Is Teaching You</p>
            <h2 class="font-heading text-4xl md:text-5xl font-bold text-white uppercase leading-tight mb-4">Lee Jones.</h2>
            <p class="text-gray-300 font-body text-lg mb-6">Over 20 years coaching players around the world, from grassroots kids to professional players. The 100 Day Program is the exact pathway he uses to build complete footballers.</p>
            <blockquote class="border-l-4 border-joner-red pl-5 py-2 mb-8">
              <p class="font-heading text-xl md:text-2xl text-white italic leading-snug">"Give a player structure and a plan, and improvement takes care of itself."</p>
              <footer class="mt-3">
                <p class="font-heading text-base text-white not-italic">Lee Jones</p>
                <p class="text-[#999999] text-xs uppercase tracking-widest font-heading mt-1">Founder, Joner Football</p>
              </footer>
            </blockquote>
            <a href={JOIN_LINK} class="btn-red text-base px-8 py-4 inline-flex self-start text-center">Start Free Trial</a>
          </div>
          <div class="order-1 lg:order-2 overflow-hidden rounded-lg shadow-2xl">
            <img src="/images/programmes/lee-hero-jf.jpg" alt="Lee Jones coaching at a Joner Football session" class="w-full h-full object-cover object-[70%_50%]" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    {/* GUARANTEE (clean reassurance, no baked image) */}
    <section class="bg-joner-black py-16 md:py-24">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <span class="inline-flex flex-col items-center justify-center w-28 h-28 rounded-full border-2 border-joner-red mb-6">
          <span class="font-heading text-joner-red text-4xl leading-none">100</span>
          <span class="font-heading text-white text-[10px] uppercase tracking-widest mt-1">Day Promise</span>
        </span>
        <p class="text-joner-red font-heading text-sm uppercase tracking-widest mb-4">The Guarantee</p>
        <h2 class="font-heading text-4xl md:text-5xl font-bold text-white uppercase leading-none mb-6">My 100 Day Promise To You</h2>
        <p class="text-gray-300 font-body text-lg mb-8 max-w-2xl mx-auto">Commit to the full 100 day program. Follow the plan. Do the sessions. If you do not see real, visible improvement in your game, I will give you an extra 100 days free.</p>
        <a href={JOIN_LINK} class="btn-red text-base px-8 py-4 inline-flex text-center">Start Free Trial</a>
        <p class="text-gray-500 font-body text-xs uppercase tracking-widest mt-5">Annual members only</p>
      </div>
    </section>

    {/* TESTIMONIALS (mirrors teams and coaches; uses the testimonials bank) */}
    <CoachesTestimonialsCarousel />

    {/* FAQ (mirrors coaches) */}
    <section class="bg-white text-joner-black py-20 md:py-24">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <p class="text-joner-red font-heading text-sm uppercase tracking-widest mb-3">Questions Players Ask</p>
          <h2 class="font-heading text-4xl md:text-6xl font-bold text-joner-black uppercase leading-none">FAQ</h2>
        </div>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <details class="group border border-gray-200 bg-gray-50 p-6 rounded-lg">
              <summary class="cursor-pointer list-none font-heading uppercase text-lg md:text-xl flex items-center justify-between gap-4">
                <span>{faq.q}</span>
                <span class="text-joner-red text-2xl group-open:rotate-45 transition-transform flex-shrink-0">+</span>
              </summary>
              <p class="text-gray-700 font-body mt-4 text-base md:text-lg leading-relaxed">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <GeoAnswers
      title="The 100 Day Programme, explained fast."
      intro="The short version for parents and players deciding if a structured football training programme beats random drills."
      blocks={[
        {
          heading: 'Who this is for',
          body: 'Players who train with a team but want a proper individual development plan, and parents who want their child following a structured pathway instead of random YouTube drills.',
        },
        {
          heading: 'What you get',
          body: 'Seven progressive programs over 100 days inside the Joner Football App: juggling, fast feet, passing and first touch, dribbling, weak foot, finishing and strength and conditioning. Each day gives the player a clear job.',
        },
        {
          heading: 'Why it works',
          body: 'Progress comes from structure, not random effort. Sessions run 20 to 60 minutes with minimal equipment, difficulty builds week by week, and players can see their improvement, which keeps them training.',
        },
        {
          heading: 'Best next step',
          body: 'Start a free trial in the app and begin day one. Annual members unlock the full 100 day pathway and the improvement guarantee backed by Lee Jones.',
        },
      ]}
      links={[
        { label: 'The football training app', href: '/app' },
        { label: 'Team subscriptions', href: '/teams' },
        { label: 'App for coaches', href: '/app/for-coaches' },
        { label: 'Football camps', href: '/camps' },
      ]}
    />

    {/* CLOSING CTA */}
    <section class="bg-joner-black py-16 md:py-24">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <p class="text-joner-red font-heading text-sm uppercase tracking-widest mb-4">Your Next Level</p>
        <h2 class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold text-white uppercase leading-none mb-6">Your Next Level Starts Today</h2>
        <p class="text-gray-300 font-body text-lg mb-8 max-w-2xl mx-auto">Pick a program. Follow the plan. Watch yourself improve.</p>
        <a href={JOIN_LINK} class="btn-red text-base px-8 py-4 inline-flex text-center">Start Free Trial</a>
      </div>
    </section>
  </main>

  {/* Match the coaches/teams display typography (Kanit italic), scoped to this page */}
  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Kanit:ital,wght@1,600;1,900&display=swap');
    .programmes-page .font-heading,
    .programmes-page :is(h1, h2, h3) {
      font-family: 'Kanit', 'Anton', Impact, sans-serif;
      font-style: italic;
    }
    .programmes-page :is(h1, h2, h3) { font-weight: 900; letter-spacing: -0.015em; }
  </style>
</BaseLayout>
)}
