---
import BaseLayout from '../layouts/BaseLayout.astro'

const APP_LINK = '/app?utm_source=website&utm_medium=programmes_page&utm_campaign=100_day_programme'
const ANNUAL_LINK = 'https://app.jonerfootball.com/checkout/new?o=183092&utm_source=website&utm_medium=programmes_page&utm_campaign=100_day_programme_annual'

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'Joner Football 100 Day Development Program',
  description: 'A structured 100 day football training pathway for parents, players and coaches inside the Joner Football App. Six progressive programs built by Lee Jones.',
  provider: {
    '@type': 'Organization',
    name: 'Joner Football',
    url: 'https://jonerfootball.com',
  },
}

const proof = [
  ['50,000+', 'DOWNLOADS'],
  ['15+', 'COUNTRIES'],
  ['1,500+', 'VIDEOS'],
  ['100', 'DAY PLAN'],
]

const programs = [
  { num: '01', title: 'Juggling Program',         duration: '2 days',  sessions: null,          body: 'Build your foundation. Ball feel, coordination, and touch.' },
  { num: '02', title: 'Fast Feet Program',        duration: '7 days',  sessions: '7 sessions',  body: 'Quick feet that leave defenders guessing.' },
  { num: '03', title: 'Passing & First Touch',    duration: '50 days', sessions: '13 sessions', body: 'The foundation of everything. Control under pressure. Crisp passing.' },
  { num: '04', title: 'Dribbling Program',        duration: '10 days', sessions: '8 sessions',  body: 'Beat any defender. Close control and changes of direction.' },
  { num: '05', title: 'Weak Foot Program',        duration: '14 days', sessions: '11 sessions', body: 'Double your options on the pitch.' },
  { num: '06', title: 'Score More Goals',         duration: '14 days', sessions: '9 sessions',  body: 'Turn chances into goals. Finishing technique and composure.' },
]

const differences = [
  { num: '01', title: 'Random Drills vs. Structured Pathway', body: 'YouTube gives random drills with no context. This is a 100-day system with progressive difficulty.' },
  { num: '02', title: 'Watching vs. Doing',                   body: 'Every session is designed to be done, not just watched. 20 minutes to an hour, a ball, a small space.' },
  { num: '03', title: 'Guesswork vs. Daily Progress',              body: 'Each session gives the player a clear job to complete, so progress is easier to see and easier to repeat.' },
]

const testimonials = [
  { quote: 'The 6 Week Passing & 1st Touch Program completely changed my game.', who: 'Ben Garrard',  role: 'Player, USA' },
  { quote: 'The Fast Feet Program was so easy to follow, no equipment needed and I saw a huge improvement.', who: 'Jeff Jones', role: 'Player, England' },
  { quote: 'You are the best Joner. Always trying to add and improve an already amazing brand. Hats off to you and the team.', who: 'Henry Santos', role: 'Coach, USA' },
]

const faqs = [
  { q: 'What ages and levels is this for?',                 a: 'The programs work for players of all ages and levels. Whether you are 10 or 30, just starting out or playing at a high level, the structured pathway meets you where you are and builds from there.' },
  { q: 'How long are the sessions?',                        a: 'Sessions run from 20 minutes up to an hour, depending on the program and the day. Designed to fit around work, school and team training.' },
  { q: 'Do I need any equipment?',                          a: 'Each program will clearly tell you what you need to complete it. Everything is based around minimal equipment.' },
  { q: 'What if I already train with a team?',              a: 'This is individual development. The extra work that separates good players from great ones. It complements team training, it does not replace it.' },
  { q: 'How does the 100-day guarantee work?',              a: 'Annual members only. Follow the program for 100 days. If you do not see improvement, we give you an extra 100 days free and you can DM Lee directly inside the app.' },
  { q: 'Are the programs available on monthly?',            a: 'The structured 100-day pathway and the guarantee are exclusive to Annual members. Monthly members access the full video library. Move to Annual to access the programs.' },
  { q: 'What about the S&C program?',                       a: 'The 12-Week Advanced Strength & Conditioning Program is included with Annual membership. Designed for older players ready to take their physical development seriously.' },
]
---

<BaseLayout
  title="100 Day Development Program | Joner Football"
  description="A structured 100 day football pathway for parents, players and coaches. Six progressive programs built by Lee Jones inside the Joner Football App."
  schema={schema}
>
  {/* HERO ============================================================ */}
  <section class="p100-hero">
    <div class="p100-hero__grid">
      <div class="p100-hero__image">
        <img src="/images/programmes/100-day/hero-cropped.png" alt="Coach Lee Jones training a young player" />
        <div class="p100-hero__fade"></div>
      </div>
      <div class="p100-hero__copy">
        <h1 class="p100-h1">
          The 100 Day Development Program
        </h1>
        <p class="p100-lede">
          100 days of structured football training for parents, players and coaches who want a proper plan inside the Joner Football App.
        </p>
        <div class="p100-cta-row">
          <a class="p100-btn p100-btn--red" href={APP_LINK} target="_blank" rel="noopener">Start Your Free Trial</a>
          <a class="p100-btn p100-btn--outline" href={ANNUAL_LINK} target="_blank" rel="noopener">Go Annual Now</a>
        </div>
      </div>
    </div>
    <div class="p100-stat-strip">
      <div class="p100-stat-row">
        {proof.map(([n, l]) => (
          <div class="p100-stat">
            <div class="p100-stat__num">{n}</div>
            <div class="p100-stat__label">{l}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* REALITY (full-bleed photo + overlaid copy on desktop, black band below on mobile) */}
  <section class="reality-hero" aria-label="The Reality, Team Training Is Not Enough">
    <div class="reality-hero__media">
      <img
        src="/images/programmes/100-day/lee-phones.png"
        alt="Lee Jones with the Joner Football App showing the 100 Day, Passing and Weak Foot programs"
      />
      <div class="reality-hero__scrim" aria-hidden="true"></div>
      <div class="reality-hero__inner">
        <div class="reality-hero__copy">
          <p class="reality-hero__eyebrow">The Reality</p>
          <h2 class="reality-hero__title">
            Team training is <span class="accent">not enough.</span>
          </h2>
          <div class="reality-hero__body">
            <p>You train once or twice a week with your team. So does every other player.</p>
            <p>The players who stand out, the ones who get picked, do extra work. Individual work. Structured work.</p>
            <p>You need a plan. A proper program designed by a professional coach. Sessions run from 20 minutes to an hour. That is exactly what this is.</p>
          </div>
          <a href={APP_LINK} target="_blank" rel="noopener" class="reality-hero__cta">Start Your Free Trial</a>
        </div>
      </div>
    </div>
  </section>


  {/* PATHWAY ========================================================= */}
  <section class="p100-section p100-section--black p100-pathway">
    <div class="p100-container p100-center">
      <span class="p100-eyebrow">The 100 Day Pathway</span>
      <h2 class="p100-h2">
        Six programs. One clear path. <span class="p100-hook">Complete footballer.</span>
      </h2>
      <p class="p100-lede p100-lede--center">
        Done in order. Every day planned. Every skill built on the last. Rest days built in between. This is what transforms a player.
      </p>
      <img
        class="p100-pathway__img"
        src="/images/programmes/100-day/pathway.png"
        alt="The 100 Day Pathway, Juggling, Fast Feet, Passing and First Touch, Dribbling, Weak Foot, Score More Goals"
      />
      <div class="p100-cta-row p100-cta-row--center">
        <a class="p100-btn p100-btn--red" href={APP_LINK} target="_blank" rel="noopener">Start Your Free Trial</a>
      </div>
    </div>
  </section>

  {/* GUARANTEE (full-bleed photo + overlaid badge and copy on desktop, stack on mobile) */}
  <section class="guar-hero" aria-label="The 100 Day Guarantee">
    <div class="guar-hero__media">
      <img src="/images/programmes/100-day/guarantee-clean.png" alt="Coach Lee Jones with players, showing the Joner Football App" />
      <div class="guar-hero__scrim" aria-hidden="true"></div>
      <div class="guar-hero__inner">
        <div class="guar-hero__stack">
          <div class="guar-badge">
            <div class="guar-badge__num">100</div>
            <div class="guar-badge__lbl">Day Guarantee</div>
            <div class="guar-badge__sub">Annual Members Only</div>
          </div>
          <div class="guar-copy">
            <p class="guar-copy__eyebrow">The Guarantee</p>
            <h2 class="guar-copy__title">
              My 100-day promise <span class="accent">to you.</span>
            </h2>
            <div class="guar-copy__body">
              <p>Commit to the full 100-day program. Follow the plan. Do the sessions. If you do not see real, visible improvement in your game, I will give you an extra <strong>100 days FREE</strong>.</p>
            </div>
            <div class="guar-copy__signoff">
              <img class="guar-copy__avatar" src="/images/programmes/100-day/lee-avatar.jpg" alt="Lee Jones" loading="lazy" />
              Lee, Founder Joner Football
            </div>
            <div class="guar-copy__ctas">
              <a class="guar-btn guar-btn--red" href={ANNUAL_LINK} target="_blank" rel="noopener">Go Annual Now</a>
              <a class="guar-btn guar-btn--ghost" href={APP_LINK} target="_blank" rel="noopener">Start Free Trial</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


  {/* DIFFERENCE ====================================================== */}
  <section class="p100-section p100-section--black">
    <div class="p100-container">
      <span class="p100-eyebrow">The Difference</span>
      <h2 class="p100-h2">
        This is not just <span class="p100-hook">another training app</span>.
      </h2>
      <div class="p100-diff">
        {differences.map((d) => (
          <article class="p100-diff__card">
            <div class="p100-diff__num">{d.num}</div>
            <h3 class="p100-diff__title">{d.title}</h3>
            <p class="p100-diff__body">{d.body}</p>
          </article>
        ))}
      </div>
      <div class="p100-cta-row p100-cta-row--center">
        <a class="p100-btn p100-btn--red" href={APP_LINK} target="_blank" rel="noopener">Start the Pathway</a>
      </div>
    </div>
  </section>

  {/* TESTIMONIALS ==================================================== */}
  <section class="p100-section p100-section--ink">
    <div class="p100-container">
      <span class="p100-eyebrow">Real players. Real progress.</span>
      <h2 class="p100-h2">
        Trusted by players in <span class="p100-hook">15+ countries</span>.
      </h2>
      <div class="p100-testi">
        {testimonials.map((t, i) => (
          <article class={`p100-testi__card ${i === 1 ? 'p100-testi__card--dark' : ''}`}>
            <div class="p100-testi__mark">&ldquo;</div>
            <div class="p100-testi__quote">"{t.quote}"</div>
            <div class="p100-testi__attr">
              <span class="p100-testi__bar"></span>
              <div>
                <div class="p100-testi__who">{t.who}</div>
                <div class="p100-testi__role">{t.role}</div>
              </div>
            </div>
          </article>
        ))}
      </div>
      <div class="p100-cta-row p100-cta-row--center">
        <a class="p100-btn p100-btn--red" href={APP_LINK} target="_blank" rel="noopener">Start the Program Now</a>
      </div>
    </div>
  </section>

  {/* FAQ ============================================================= */}
  <section class="p100-section p100-section--black">
    <div class="p100-faq">
      <span class="p100-eyebrow">FAQ</span>
      <h2 class="p100-h2">
        Common <span class="p100-hook">questions</span>.
      </h2>
      <div class="p100-faq__list">
        {faqs.map((f, i) => (
          <details class="p100-faq__item" open={i === 0}>
            <summary class="p100-faq__summary">
              <span>{f.q}</span>
              <span class="p100-faq__toggle" aria-hidden="true">+</span>
            </summary>
            <div class="p100-faq__body">{f.a}</div>
          </details>
        ))}
      </div>
      <div class="p100-cta-row p100-cta-row--center">
        <a class="p100-btn p100-btn--red" href={APP_LINK} target="_blank" rel="noopener">Start Your Free Trial</a>
      </div>
    </div>
  </section>

  {/* FINAL CTA ======================================================= */}
  <section class="p100-final">
    <img class="p100-final__bg" src="/images/programmes/100-day/hero-2.png" alt="" aria-hidden="true" />
    <div class="p100-final__overlay"></div>
    <div class="p100-final__inner">
      <span class="p100-eyebrow">Your Next Level</span>
      <h2 class="p100-final__h">
        Your next level <span class="p100-hook">starts today</span>.
      </h2>
      <p class="p100-final__lede">Pick a program. Follow the plan. Watch yourself improve.</p>
      <div class="p100-cta-row p100-cta-row--center">
        <a class="p100-btn p100-btn--red" href={APP_LINK} target="_blank" rel="noopener">Start the Program Now</a>
        <a class="p100-btn p100-btn--outline" href={ANNUAL_LINK} target="_blank" rel="noopener">Go Annual</a>
      </div>
      <p class="p100-final__support">Built for parents, players and coaches.</p>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* 100 Day Development Program landing page styles.
     Page-scoped class prefix: p100-*. Kanit display + Joner red palette. */
  @import url('https://fonts.googleapis.com/css2?family=Kanit:ital,wght@1,600;1,900&display=swap');

  :root {
    --p100-red: #CC0000;
    --p100-red-hover: #B30000;
    --p100-black: #000000;
    --p100-ink-90: #0A0A0A;
    --p100-display: 'Kanit', 'Oswald', 'Impact', 'Arial Narrow Bold', sans-serif;
  }

  /* Hide global mobile sticky bar on this page; we use our own dense CTA stack. */
  /* (kept on for now; remove if it overlaps too much) */

  /* Eyebrow + Hook + base typography ------------------------------- */
  .p100-eyebrow {
    font-family: var(--p100-display);
    font-style: italic; font-weight: 600;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--p100-red);
    display: inline-block;
  }
  .p100-hook { color: var(--p100-red); }

  .p100-h1 {
    font-family: var(--p100-display);
    font-style: italic; font-weight: 900;
    text-transform: uppercase;
    color: #fff;
    font-size: clamp(2.25rem, 5.4vw, 4.75rem);
    line-height: 0.92;
    letter-spacing: -0.015em;
    margin: 18px 0 0;
    text-wrap: balance;
  }
  .p100-h2 {
    font-family: var(--p100-display);
    font-style: italic; font-weight: 900;
    text-transform: uppercase;
    color: #fff;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 0.98;
    letter-spacing: -0.005em;
    margin: 14px 0 0;
    text-wrap: balance;
  }
  .p100-h2--ink { color: #000; }
  .p100-lede {
    font-family: 'DM Sans', system-ui, sans-serif;
    color: rgba(255,255,255,0.82);
    font-size: 1.0625rem;
    line-height: 1.6;
    margin-top: 18px;
    max-width: 640px;
  }
  .p100-lede--center { margin-left: auto; margin-right: auto; }
  .p100-lede--ink { color: rgba(0,0,0,0.74); }

  .p100-section {
    padding: 96px 20px;
  }
  .p100-section--black { background: #000; color: #fff; }
  .p100-section--ink { background: var(--p100-ink-90); color: #fff; }
  .p100-section--white { background: #fff; color: #000; }

  .p100-container { max-width: 1280px; margin: 0 auto; }
  .p100-center { text-align: center; }

  .p100-cta-row { display: flex; gap: 14px; margin-top: 32px; flex-wrap: wrap; }
  .p100-cta-row--center { justify-content: center; }

  /* Buttons -------------------------------------------------------- */
  /* Glass button experiment adapted for Astro anchors.
     The project is Astro, not a React/shadcn app, so this keeps the effect
     local to the 100 Day page without adding React-only dependencies. */
  .p100-btn,
  .reality-hero__cta,
  .guar-btn {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    overflow: hidden;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.32);
    background:
      linear-gradient(135deg, rgba(255,255,255,0.18), rgba(255,255,255,0.045)),
      rgba(0,0,0,0.42);
    color: #fff;
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.26),
      inset 0 -18px 30px rgba(0,0,0,0.28),
      0 18px 38px rgba(0,0,0,0.42),
      0 0 0 1px rgba(232,0,13,0.18);
    backdrop-filter: blur(14px) saturate(1.15);
    -webkit-backdrop-filter: blur(14px) saturate(1.15);
    font-family: var(--p100-display);
    font-style: italic;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    cursor: pointer;
    text-decoration: none;
    user-select: none;
    white-space: normal !important;
    text-align: center;
    line-height: 1.12;
    overflow-wrap: anywhere;
    min-width: 0;
    max-width: 100%;
    transition: transform 140ms ease, border-color 140ms ease, box-shadow 140ms ease, background 140ms ease, color 140ms ease;
  }
  .p100-btn {
    font-size: 1.0625rem;
    padding: 20px 32px;
  }
  .p100-btn::before,
  .reality-hero__cta::before,
  .guar-btn::before {
    content: '';
    position: absolute;
    inset: 1px;
    z-index: -1;
    border-radius: inherit;
    background:
      radial-gradient(circle at 28% 12%, rgba(255,255,255,0.34), transparent 26%),
      linear-gradient(90deg, rgba(232,0,13,0.26), transparent 46%, rgba(255,255,255,0.08));
    opacity: 0.9;
  }
  .p100-btn::after,
  .reality-hero__cta::after,
  .guar-btn::after {
    content: none;
  }
  .p100-btn:hover,
  .reality-hero__cta:hover,
  .guar-btn:hover {
    transform: translateY(-2px);
    border-color: rgba(255,255,255,0.58);
    background:
      linear-gradient(135deg, rgba(255,255,255,0.24), rgba(255,255,255,0.07)),
      rgba(0,0,0,0.54);
    color: #fff;
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.34),
      inset 0 -18px 30px rgba(0,0,0,0.32),
      0 22px 46px rgba(0,0,0,0.48),
      0 0 0 1px rgba(232,0,13,0.36),
      0 0 26px rgba(232,0,13,0.22);
  }
  .p100-btn:active,
  .reality-hero__cta:active,
  .guar-btn:active { transform: translateY(0); }
  .p100-btn--red,
  .guar-btn--red {
    border-color: rgba(232,0,13,0.72);
  }
  .p100-btn--outline,
  .p100-btn--outline-ink,
  .guar-btn--ghost {
    background:
      linear-gradient(135deg, rgba(255,255,255,0.12), rgba(255,255,255,0.035)),
      rgba(0,0,0,0.25);
    border-color: rgba(255,255,255,0.42);
  }

  /* HERO ----------------------------------------------------------- */
  .p100-hero { background: #000; position: relative; }
  .p100-hero__grid {
    max-width: 1440px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr 1fr; gap: 0; align-items: stretch;
  }
  .p100-hero__image { position: relative; min-height: 560px; }
  .p100-hero__image img {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .p100-hero__fade {
    position: absolute; inset: 0;
    background: linear-gradient(90deg, rgba(0,0,0,0) 60%, #000 100%);
  }
  .p100-hero__copy {
    display: flex; flex-direction: column; justify-content: center;
    padding: 72px 48px 72px 36px; background: #000;
  }

  /* Hero stat strip */
  .p100-stat-strip {
    border-top: 1px solid rgba(255,255,255,0.12);
    border-bottom: 1px solid rgba(255,255,255,0.12);
    background: #000;
  }
  .p100-stat-row {
    max-width: 1280px; margin: 0 auto; padding: 0 20px;
    display: grid; grid-template-columns: repeat(4, 1fr);
  }
  .p100-stat {
    padding: 22px 16px;
    border-right: 1px solid rgba(255,255,255,0.12);
    text-align: center;
  }
  .p100-stat:last-child { border-right: none; }
  .p100-stat__num {
    font-family: var(--p100-display);
    font-style: italic; font-weight: 900;
    color: var(--p100-red);
    font-size: clamp(1.5rem, 3vw, 2.25rem); line-height: 1;
  }
  .p100-stat__label {
    font-family: var(--p100-display);
    font-style: italic; font-weight: 600;
    font-size: 11px; letter-spacing: 0.22em;
    color: rgba(255,255,255,0.7);
    margin-top: 8px;
  }

  /* PATHWAY / WHATCHANGES / INSIDE -------------------------------- */
  .p100-pathway__img {
    width: 100%; max-width: 1280px;
    height: auto; display: block;
    margin: 40px auto 0;
  }

  /* PROGRAMS ------------------------------------------------------- */
  .p100-eyebrow-bar {
    display: inline-block;
    border-bottom: 3px solid var(--p100-red);
    padding-bottom: 10px;
    margin-bottom: 24px;
  }
  .p100-programs {
    margin-top: 48px;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px;
    background: rgba(0,0,0,0.12);
    border: 1px solid rgba(0,0,0,0.12);
  }
  .p100-program {
    background: #fff; padding: 30px 26px;
    min-height: 240px;
    display: flex; flex-direction: column;
  }
  .p100-program__head { display: flex; align-items: baseline; gap: 14px; }
  .p100-program__num {
    font-family: var(--p100-display);
    font-style: italic; font-weight: 900;
    color: var(--p100-red);
    font-size: 48px; line-height: 1;
    letter-spacing: -0.02em;
  }
  .p100-program__meta {
    font-family: var(--p100-display);
    font-style: italic; font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 11.5px;
    color: rgba(0,0,0,0.55);
  }
  .p100-program__title {
    font-family: var(--p100-display);
    font-style: italic; font-weight: 900;
    text-transform: uppercase;
    font-size: 22px; letter-spacing: 0.02em; line-height: 1.05;
    color: #000;
    margin: 14px 0 10px;
  }
  .p100-program__body {
    font-size: 14.5px; line-height: 1.6;
    color: rgba(0,0,0,0.72); margin: 0; flex: 1;
  }

  .p100-bonus {
    margin-top: 24px;
    padding: 30px 28px;
    background: #000; color: #fff;
    display: grid; grid-template-columns: auto 1fr auto;
    gap: 24px; align-items: center;
  }
  .p100-bonus__tag {
    display: inline-block; padding: 8px 12px;
    background: var(--p100-red); color: #fff;
    font-family: var(--p100-display);
    font-style: italic; font-weight: 900;
    text-transform: uppercase;
