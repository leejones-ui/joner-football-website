---
import BaseLayout from '../layouts/BaseLayout.astro'

const title = 'Welcome To Joner Football | Registration Complete'
const description = 'Your Joner Football registration is complete. Welcome to the team.'

import SanityPageRenderer from '../components/sanity/SanityPageRenderer.astro'
import { fetchSanityPage } from '../lib/sanityPages'
import { shouldReplaceSanityPage } from '../lib/sanityPageUtils'

const sanityPage = await fetchSanityPage('checkout-success')
---

{shouldReplaceSanityPage(sanityPage) ? (
  <SanityPageRenderer page={sanityPage} />
) : (
<BaseLayout
  title={title}
  description={description}
  canonical="https://jonerfootball.com/checkout-success/"
  noindex
>
  <main class="bg-joner-black text-white">
    <section class="min-h-[70dvh] flex items-center py-20 md:py-28">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="font-heading uppercase tracking-[0.25em] text-joner-red text-sm mb-5">REGISTRATION COMPLETE</p>
        <h1 class="font-heading uppercase text-5xl md:text-7xl leading-none mb-6">Welcome To The Team.</h1>
        <p class="text-xl text-gray-300 mb-8">You are in. Open the Joner Football App and start training with purpose.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="https://app.jonerfootball.com" target="_blank" rel="noopener noreferrer" class="btn-red text-center">Open The App</a>
          <a href="/app" class="btn-outline text-center">Back To App Page</a>
        </div>
      </div>
    </section>

    <script is:inline>
      (function () {
        function fireCompleteRegistration() {
          if (!window.JonerTracking || typeof window.JonerTracking.trackEvent !== 'function') return;
          // CompleteRegistration is now sent SERVER-SIDE from the Uscreen paid-order
          // webhook (api/_uscreen-webhook.js -> Meta CAPI) with the real order id and
          // value, which is reliable and avoids double-counting. The browser fire is
          // intentionally disabled here so a sale is only ever counted once.
          return;
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fireCompleteRegistration);
        else fireCompleteRegistration();
      })();
    </script>
  </main>
</BaseLayout>
)}
