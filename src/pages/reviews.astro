---
import BaseLayout from '../layouts/BaseLayout.astro'
import { breadcrumbSchema, webPageSchema } from '../lib/seoSchema'
import { jonerReviews, reviewSections } from '../data/reviews'

const title = 'Joner Football Reviews | Players, Parents & Coaches'
const description = 'Read genuine Joner Football reviews from players, parents and coaches using the app, training programmes and team sessions. Every review includes its source and date.'
const featured = jonerReviews.find((review) => review.id === 'alfred-c-father-and-sons')!
const reviewSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Joner Football reviews from players, parents and coaches',
  numberOfItems: jonerReviews.length,
  itemListElement: jonerReviews.map((review, index) => ({
    '@type': 'ListItem', position: index + 1,
    item: {
      '@type': 'Review',
      datePublished: review.date,
      reviewBody: review.quote,
      author: { '@type': 'Person', name: review.name },
      itemReviewed: { '@type': 'Organization', name: 'Joner Football', url: 'https://jonerfootball.com/' },
      publisher: { '@type': 'Organization', name: review.source },
    },
  })),
}
const schemas = [
  webPageSchema({ name: title, description, url: 'https://jonerfootball.com/reviews/' }),
  breadcrumbSchema([{ name: 'Home', url: 'https://jonerfootball.com/' }, { name: 'Reviews', url: 'https://jonerfootball.com/reviews/' }]),
  reviewSchema,
]
---

<BaseLayout title={title} description={description} keywords="Joner Football reviews, Joner Football App reviews, football training app reviews, soccer training reviews" schema={schemas}>
  <main class="rv">
    <section class="rv-hero" aria-labelledby="reviews-title">
      <div class="rv-shell rv-hero-grid">
        <div>
          <p class="rv-kicker">Reviews</p>
          <h1 id="reviews-title">What players, parents and coaches say.</h1>
          <p class="rv-lead">Real words from the people who train with Joner Football, in Sydney and on the app. Every review shows where it came from and when.</p>
          <div class="rv-actions">
            <a class="rv-btn rv-btn-red" href="#review-wall">Read the reviews</a>
            <a class="rv-btn rv-btn-line" href="/training/jfp-program">Train with us in Sydney</a>
          </div>
          <dl class="rv-facts">
            <div><dt>{jonerReviews.length}</dt><dd>written reviews</dd></div>
            <div><dt>{jonerReviews.filter((r) => r.audience.includes('Parent')).length + 1}</dt><dd>from parents</dd></div>
            <div><dt>{jonerReviews.filter((r) => r.audience.includes('Coach')).length}</dt><dd>from coaches</dd></div>
          </dl>
        </div>
        <figure class="rv-video">
          <video controls playsinline preload="metadata" poster="/videos/houston-parent-reel-poster.webp">
            <source src="/videos/houston-parent-reel-sound.mp4" type="video/mp4" />
          </video>
          <figcaption><span>Video</span> What parents say about training with Joner Football</figcaption>
        </figure>
      </div>
    </section>

    <section class="rv-featured" aria-label="Featured review">
      <div class="rv-shell">
        <blockquote>
          <p>“{featured.quote}”</p>
          <footer><span class="rv-avatar" aria-hidden="true">{featured.name.slice(0, 1)}</span><span><strong>{featured.name}</strong><small>{featured.audience} · {featured.product}</small></span></footer>
        </blockquote>
      </div>
    </section>

    <section id="review-wall" class="rv-wall">
      <div class="rv-shell">
        <div class="rv-wall-head">
          <h2>Every review</h2>
          <div class="rv-filters" role="group" aria-label="Filter reviews">
            {reviewSections.map((section, index) => (
              <button type="button" class:list={{ active: index === 0 }} data-filter={section} aria-pressed={index === 0 ? 'true' : 'false'}>{section.replace(' reviews', '')}</button>
            ))}
          </div>
        </div>
        <p class="rv-count" aria-live="polite"><strong data-visible-count>{jonerReviews.length}</strong> shown</p>
        <div class="rv-grid">
          {jonerReviews.map((review) => (
            <article class="rv-card" data-tags={review.tags.join('|')} data-review-card>
              <p class="rv-tag">{review.audience}</p>
              <blockquote>“{review.quote}”</blockquote>
              <footer>
                <span class="rv-avatar" aria-hidden="true">{review.name.slice(0, 1)}</span>
                <span><strong>{review.name}</strong><small>{review.product}</small></span>
              </footer>
              <p class="rv-src">{review.sourceDetail} · <time datetime={review.date}>{review.dateLabel}</time></p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="rv-cta">
      <div class="rv-shell rv-cta-grid">
        <a class="rv-cta-card" href="/training/jfp-program">
          <img src="/images/training/jfp/jfp-training-1.webp" alt="" loading="lazy" />
          <span><small>Sydney</small><b>Train with us in person</b>Small group training at Belrose, North Turramurra and Rydalmere.</span>
        </a>
        <a class="rv-cta-card" href="/join">
          <img src="/images/programmes/lee-coaching-red.jpg" alt="" loading="lazy" />
          <span><small>Anywhere</small><b>Train with the Joner Football App</b>Drills, programmes and coaching detail you can use today.</span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'))
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-review-card]'))
  const count = document.querySelector<HTMLElement>('[data-visible-count]')
  buttons.forEach((button) => button.addEventListener('click', () => {
    const filter = button.dataset.filter || 'All reviews'
    buttons.forEach((item) => { item.classList.toggle('active', item === button); item.setAttribute('aria-pressed', item === button ? 'true' : 'false') })
    let visible = 0
    cards.forEach((card) => {
      const show = filter === 'All reviews' || (card.dataset.tags || '').split('|').includes(filter)
      card.hidden = !show
      if (show) visible += 1
    })
    if (count) count.textContent = String(visible)
  }))
</script>

<style>
  .rv { --red:#d20a0a; background:#0a0a0a; color:#fff; font-family:var(--font-body, Inter, system-ui, sans-serif); }
  .rv-shell { width:min(1320px, calc(100% - 32px)); margin-inline:auto; }
  .rv-kicker { color:var(--red); font-weight:800; font-size:.8rem; letter-spacing:.14em; text-transform:uppercase; margin:0 0 14px; }
  .rv-hero { padding:clamp(110px, 14vw, 170px) 0 clamp(48px, 7vw, 90px); background:radial-gradient(circle at 85% 20%, rgba(210,10,10,.18), transparent 40%); }
  .rv-hero-grid { display:grid; gap:40px; align-items:center; }
  @media (min-width:960px) { .rv-hero-grid { grid-template-columns:minmax(0,1.25fr) minmax(0,.75fr); gap:64px; } }
  .rv h1 { font-family:var(--font-body, Inter, sans-serif); font-weight:800; font-size:clamp(2.4rem, 5.4vw, 4.6rem); line-height:1.02; letter-spacing:-.035em; text-transform:none; margin:0; max-width:14ch; }
  .rv-lead { color:#c9c9c9; font-size:clamp(1.05rem, 1.6vw, 1.25rem); line-height:1.6; max-width:560px; margin:20px 0 0; }
  .rv-actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:28px; }
  .rv-btn { display:inline-flex; align-items:center; justify-content:center; min-height:50px; padding:0 24px; border-radius:12px; font-weight:700; font-size:1rem; text-decoration:none; transition:transform .15s, background .15s, border-color .15s; }
  .rv-btn-red { background:var(--red); color:#fff; }
  .rv-btn-red:hover { background:#b00808; transform:translateY(-1px); }
  .rv-btn-line { border:1.5px solid rgba(255,255,255,.35); color:#fff; }
  .rv-btn-line:hover { border-color:#fff; }
  .rv-facts { display:flex; gap:clamp(24px, 4vw, 48px); margin:40px 0 0; padding-top:24px; border-top:1px solid rgba(255,255,255,.14); }
  .rv-facts dt { font-size:clamp(1.8rem, 3vw, 2.4rem); font-weight:800; letter-spacing:-.03em; }
  .rv-facts dd { margin:2px 0 0; color:#9a9a9a; font-size:.9rem; }
  .rv-video { margin:0; border-radius:22px; overflow:hidden; background:#151515; border:1px solid rgba(255,255,255,.1); max-width:420px; justify-self:center; width:100%; }
  .rv-video video { display:block; width:100%; aspect-ratio:9 / 14; object-fit:cover; background:#000; }
  .rv-video figcaption { padding:14px 16px; font-size:.95rem; color:#d6d6d6; display:flex; gap:10px; align-items:center; }
  .rv-video figcaption span { background:var(--red); color:#fff; font-size:.72rem; font-weight:800; letter-spacing:.06em; text-transform:uppercase; padding:4px 8px; border-radius:6px; }
  .rv-featured { background:#f4f2ee; color:#111; padding:clamp(56px, 8vw, 110px) 0; }
  .rv-featured blockquote { margin:0 auto; max-width:980px; }
  .rv-featured blockquote p { font-size:clamp(1.4rem, 2.8vw, 2.3rem); line-height:1.35; font-weight:600; letter-spacing:-.015em; margin:0; }
  .rv-featured footer { display:flex; gap:14px; align-items:center; margin-top:28px; }
  .rv-avatar { width:44px; height:44px; flex:none; border-radius:50%; background:var(--red); color:#fff; display:inline-flex; align-items:center; justify-content:center; font-weight:800; }
  .rv footer strong { display:block; font-weight:750; }
  .rv footer small { display:block; color:#7a7a7a; font-size:.85rem; margin-top:2px; }
  .rv-wall { padding:clamp(56px, 8vw, 110px) 0; }
  .rv-wall-head { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:end; gap:18px; }
  .rv-wall h2 { font-family:var(--font-body, Inter, sans-serif); text-transform:none; font-weight:800; font-size:clamp(1.8rem, 3.4vw, 2.8rem); letter-spacing:-.03em; margin:0; }
  .rv-filters { display:flex; gap:8px; flex-wrap:wrap; }
  .rv-filters button { border:1.5px solid rgba(255,255,255,.18); background:transparent; color:#cfcfcf; border-radius:999px; padding:9px 16px; font:600 .92rem var(--font-body, Inter, sans-serif); cursor:pointer; }
  .rv-filters button:hover { border-color:rgba(255,255,255,.5); color:#fff; }
  .rv-filters button.active { background:#fff; border-color:#fff; color:#0a0a0a; }
  .rv-count { color:#8a8a8a; font-size:.9rem; margin:18px 0 22px; }
  .rv-count strong { color:#fff; }
  .rv-grid { columns:3 340px; column-gap:18px; }
  .rv-card { break-inside:avoid; margin:0 0 18px; background:#141414; border:1px solid rgba(255,255,255,.08); border-radius:18px; padding:24px; transition:border-color .15s, transform .15s; }
  .rv-card:hover { border-color:rgba(255,255,255,.25); transform:translateY(-2px); }
  .rv-card[hidden] { display:none; }
  .rv-tag { display:inline-block; font-size:.75rem; font-weight:700; color:#ff8a80; background:rgba(210,10,10,.14); border-radius:999px; padding:4px 10px; margin:0 0 14px; }
  .rv-card blockquote { margin:0; font-size:1.05rem; line-height:1.6; color:#ececec; }
  .rv-card footer { display:flex; gap:12px; align-items:center; margin-top:20px; }
  .rv-card .rv-avatar { width:38px; height:38px; font-size:.95rem; }
  .rv-src { color:#6f6f6f; font-size:.8rem; margin:14px 0 0; padding-top:12px; border-top:1px solid rgba(255,255,255,.07); }
  .rv-cta { padding:0 0 clamp(64px, 9vw, 120px); }
  .rv-cta-grid { display:grid; gap:18px; }
  @media (min-width:860px) { .rv-cta-grid { grid-template-columns:1fr 1fr; } }
  .rv-cta-card { position:relative; display:block; min-height:320px; border-radius:22px; overflow:hidden; color:#fff; text-decoration:none; }
  .rv-cta-card img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform .4s; }
  .rv-cta-card::after { content:''; position:absolute; inset:0; background:linear-gradient(0deg, rgba(0,0,0,.88), rgba(0,0,0,.1) 70%); }
  .rv-cta-card:hover img { transform:scale(1.04); }
  .rv-cta-card span { position:absolute; z-index:1; left:24px; right:24px; bottom:22px; color:#d6d6d6; font-size:1rem; line-height:1.5; }
  .rv-cta-card small { display:block; color:var(--red); font-weight:800; font-size:.75rem; letter-spacing:.12em; text-transform:uppercase; }
  .rv-cta-card b { display:block; color:#fff; font-size:clamp(1.4rem, 2.4vw, 1.9rem); letter-spacing:-.02em; margin:6px 0 4px; }
  @media (prefers-reduced-motion:reduce) { .rv-card, .rv-cta-card img, .rv-btn { transition:none; } }
</style>
