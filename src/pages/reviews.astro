---
import BaseLayout from '../layouts/BaseLayout.astro'
import { breadcrumbSchema, webPageSchema } from '../lib/seoSchema'
import { jonerReviews, reviewSections } from '../data/reviews'

const reviewSchemas = jonerReviews.map((review) => ({
  '@context': 'https://schema.org',
  '@type': 'Review',
  '@id': `https://jonerfootball.com/reviews/#${review.id}`,
  itemReviewed: {
    '@type': 'SoftwareApplication',
    name: 'Joner Football App',
    operatingSystem: 'iOS, Android, Web',
    applicationCategory: 'SportsApplication',
    url: 'https://jonerfootball.com/app/',
  },
  author: {
    '@type': 'Person',
    name: review.name,
  },
  datePublished: review.date,
  reviewBody: review.quote,
  publisher: {
    '@type': 'Organization',
    '@id': 'https://jonerfootball.com/#organization',
    name: 'Joner Football',
  },
}))

const schemas = [
  webPageSchema({
    name: 'Joner Football Reviews | Players, Parents & Coaches',
    description: 'Read genuine Joner Football reviews from players, parents and coaches using the app, programmes and team training sessions.',
    url: 'https://jonerfootball.com/reviews/',
  }),
  breadcrumbSchema([
    { name: 'Home', url: 'https://jonerfootball.com/' },
    { name: 'Reviews', url: 'https://jonerfootball.com/reviews/' },
  ]),
  ...reviewSchemas,
]
---

<BaseLayout
  title="Joner Football Reviews | Players, Parents & Coaches"
  description="Read genuine Joner Football reviews from players, parents and coaches using the app, programmes and team training sessions. Every review includes its source and date."
  keywords="Joner Football reviews, Joner Football App reviews, football training app reviews, soccer training app reviews, player reviews, parent reviews, coach reviews"
  canonical="https://jonerfootball.com/reviews/"
  schema={schemas}
>
  <div class="reviews-page">
    <section class="reviews-hero" aria-labelledby="reviews-title">
      <div class="reviews-hero-media" aria-hidden="true">
        <img src="/images/programmes/lee-coaching-red.jpg" alt="" loading="eager" fetchpriority="high" />
      </div>
      <div class="reviews-hero-shade"></div>
      <div class="reviews-hero-grid" aria-hidden="true"></div>
      <div class="reviews-hero-inner">
        <p class="reviews-kicker">PLAYERS. PARENTS. COACHES.</p>
        <h1 id="reviews-title">REAL JONER<br /><span>FOOTBALL REVIEWS</span></h1>
        <p class="reviews-intro">Real feedback from people using Joner Football to train better, coach with more detail and help players improve.</p>
        <div class="reviews-hero-actions">
          <a href="#reviews" class="reviews-primary-cta">READ THE REVIEWS</a>
          <a href="/join/" class="reviews-secondary-cta">SEE APP PLANS</a>
        </div>
        <p class="reviews-proof-note"><span></span> Every review below includes a date and verified source.</p>
      </div>
      <div class="reviews-hero-word" aria-hidden="true">PROOF</div>
    </section>

    <section class="reviews-standard" aria-labelledby="proof-standard-title">
      <div class="reviews-container reviews-standard-grid">
        <div>
          <p class="reviews-section-label">OUR PROOF STANDARD</p>
          <h2 id="proof-standard-title">NO MADE-UP STARS.<br />NO EMPTY CLAIMS.</h2>
        </div>
        <div class="reviews-standard-copy">
          <p>These are genuine comments and messages from Joner Football members. We show who said it, what they used, when they said it and where the feedback came from.</p>
          <p>Names are shortened where needed for privacy. We do not publish a made-up aggregate rating or turn member feedback into claims we cannot prove.</p>
        </div>
      </div>
    </section>

    <section id="reviews" class="reviews-library" aria-labelledby="review-library-title">
      <div class="reviews-container">
        <div class="reviews-library-head">
          <div>
            <p class="reviews-section-label">VERIFIED MEMBER FEEDBACK</p>
            <h2 id="review-library-title">THE REVIEWS</h2>
          </div>
          <p><strong>{jonerReviews.length}</strong> sourced reviews in this first published collection.</p>
        </div>

        <div class="reviews-filters" role="group" aria-label="Filter reviews">
          {reviewSections.map((section, index) => (
            <button type="button" class:list={['reviews-filter', { active: index === 0 }]} data-review-filter={section} aria-pressed={index === 0 ? 'true' : 'false'}>
              {section.replace('Joner Football ', '')}
            </button>
          ))}
        </div>

        <div class="reviews-grid" data-reviews-grid>
          {jonerReviews.map((review, index) => (
            <article id={review.id} class="review-card" data-review-card data-tags={review.tags.join('|')}>
              <div class="review-card-topline">
                <span class="review-number">{String(index + 1).padStart(2, '0')}</span>
                <span class="review-audience">{review.audience}</span>
              </div>
              <blockquote>
                <span class="review-mark" aria-hidden="true">“</span>
                <p>{review.quote}</p>
              </blockquote>
              <footer>
                <div class="review-person">
                  <strong>{review.name}</strong>
                  {review.country && <span>{review.country}</span>}
                </div>
                <dl>
                  <div>
                    <dt>Used</dt>
                    <dd>{review.product}</dd>
                  </div>
                  <div>
                    <dt>Date</dt>
                    <dd><time datetime={review.date}>{review.dateLabel}</time></dd>
                  </div>
                  <div>
                    <dt>Source</dt>
                    <dd>{review.sourceDetail}</dd>
                  </div>
                </dl>
              </footer>
            </article>
          ))}
        </div>
        <p class="reviews-empty" data-reviews-empty hidden>No reviews match this filter yet.</p>
      </div>
    </section>

    <section class="reviews-source" aria-labelledby="independent-sources-title">
      <div class="reviews-container reviews-source-grid">
        <div>
          <p class="reviews-section-label">CHECK THE APP YOURSELF</p>
          <h2 id="independent-sources-title">INDEPENDENT<br />APP LISTINGS</h2>
          <p class="reviews-source-intro">The official store listings are separate from this website. Open them directly to see the latest public app information and feedback available on each platform.</p>
        </div>
        <div class="reviews-source-links">
          <a href="https://apps.apple.com/au/app/joner-football-app/id6737069275" target="_blank" rel="noopener noreferrer">
            <span>IOS</span>
            <strong>View on the App Store</strong>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a href="https://play.google.com/store/apps/details?id=tv.uscreen.jonerfootball" target="_blank" rel="noopener noreferrer">
            <span>ANDROID</span>
            <strong>View on Google Play</strong>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a href="https://www.youtube.com/@jonerfootball" target="_blank" rel="noopener noreferrer">
            <span>VIDEO</span>
            <strong>See Joner Football on YouTube</strong>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>
      </div>
    </section>

    <section class="reviews-final" aria-labelledby="reviews-final-title">
      <div class="reviews-final-line" aria-hidden="true"></div>
      <div class="reviews-container reviews-final-inner">
        <p class="reviews-section-label">YOUR NEXT SESSION</p>
        <h2 id="reviews-final-title">READY TO FEEL THE<br /><span>DIFFERENCE?</span></h2>
        <p>Choose a plan, follow the detail and put the work in.</p>
        <div class="reviews-final-actions">
          <a href="/join/" class="reviews-primary-cta">SEE APP PLANS</a>
          <a href="/free-bundle/" class="reviews-secondary-cta">WATCH FREE TRAINING</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const filterButtons = Array.from(document.querySelectorAll('[data-review-filter]'))
  const reviewCards = Array.from(document.querySelectorAll('[data-review-card]'))
  const emptyMessage = document.querySelector('[data-reviews-empty]')

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      if (!(button instanceof HTMLButtonElement)) return
      const filter = button.dataset.reviewFilter || 'All reviews'
      filterButtons.forEach((item) => {
        const active = item === button
        item.classList.toggle('active', active)
        item.setAttribute('aria-pressed', String(active))
      })

      let visible = 0
      reviewCards.forEach((card) => {
        if (!(card instanceof HTMLElement)) return
        const tags = (card.dataset.tags || '').split('|')
        const show = filter === 'All reviews' || tags.includes(filter)
        card.hidden = !show
        if (show) visible += 1
      })
      if (emptyMessage instanceof HTMLElement) emptyMessage.hidden = visible !== 0
    })
  })
</script>

<style>
  .reviews-page {
    --red: #E8000D;
    --black: #000000;
    --ink: #111111;
    --card: #1E1E1E;
    --white: #FFFFFF;
    --soft: #CCCCCC;
    background: var(--black);
    color: var(--white);
    overflow: hidden;
  }

  .reviews-container { width: min(1180px, calc(100% - 2rem)); margin-inline: auto; }
  .reviews-kicker, .reviews-section-label { color: var(--red); font-family: Arial Black, Arial, sans-serif; font-size: .75rem; font-weight: 900; letter-spacing: .2em; line-height: 1.2; text-transform: uppercase; }

  .reviews-hero { min-height: calc(100svh - 4rem); position: relative; display: flex; align-items: flex-end; isolation: isolate; }
  .reviews-hero-media, .reviews-hero-shade, .reviews-hero-grid { position: absolute; inset: 0; }
  .reviews-hero-media { z-index: -4; }
  .reviews-hero-media img { width: 100%; height: 100%; object-fit: cover; object-position: 68% 42%; filter: saturate(.8) contrast(1.12); }
  .reviews-hero-shade { z-index: -3; background: linear-gradient(90deg, rgba(0,0,0,.98) 0%, rgba(0,0,0,.9) 43%, rgba(0,0,0,.28) 72%, rgba(0,0,0,.52) 100%), linear-gradient(0deg, #000 0%, transparent 38%); }
  .reviews-hero-grid { z-index: -2; opacity: .16; background-image: linear-gradient(rgba(255,255,255,.14) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.14) 1px, transparent 1px); background-size: 76px 76px; mask-image: linear-gradient(90deg, #000, transparent 70%); }
  .reviews-hero-inner { width: min(1180px, calc(100% - 2rem)); margin: 0 auto; padding: 7rem 0 5rem; position: relative; z-index: 2; }
  .reviews-hero h1, .reviews-standard h2, .reviews-library h2, .reviews-source h2, .reviews-final h2 { margin: 0; font-family: Arial Black, Arial, sans-serif; font-weight: 900; text-transform: uppercase; letter-spacing: -.055em; line-height: .88; }
  .reviews-hero h1 { margin-top: 1rem; max-width: 880px; font-size: clamp(3.6rem, 9vw, 8.6rem); }
  .reviews-hero h1 span, .reviews-final h2 span { color: var(--red); }
  .reviews-intro { max-width: 610px; margin: 1.8rem 0 0; color: #E2E2E2; font-size: clamp(1.05rem, 2vw, 1.35rem); line-height: 1.55; }
  .reviews-hero-actions, .reviews-final-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2rem; }
  .reviews-primary-cta, .reviews-secondary-cta { min-height: 50px; display: inline-flex; align-items: center; justify-content: center; padding: .85rem 1.35rem; border: 2px solid var(--red); font-family: Arial Black, Arial, sans-serif; font-size: .78rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; transition: background-color .2s, color .2s, transform .2s; }
  .reviews-primary-cta { background: var(--red); color: #fff; }
  .reviews-secondary-cta { background: rgba(0,0,0,.7); color: #fff; border-color: rgba(255,255,255,.45); }
  .reviews-primary-cta:hover, .reviews-secondary-cta:hover { transform: translateY(-2px); }
  .reviews-secondary-cta:hover { border-color: #fff; }
  .reviews-proof-note { display: flex; align-items: center; gap: .65rem; margin: 1.8rem 0 0; color: #AFAFAF; font-size: .78rem; text-transform: uppercase; letter-spacing: .08em; }
  .reviews-proof-note span { width: 2rem; height: 2px; background: var(--red); }
  .reviews-hero-word { position: absolute; right: -1.5vw; bottom: -2.3vw; z-index: -1; color: transparent; -webkit-text-stroke: 1px rgba(255,255,255,.11); font-family: Arial Black, Arial, sans-serif; font-size: clamp(7rem, 20vw, 20rem); font-weight: 900; line-height: .7; letter-spacing: -.08em; }

  .reviews-standard { padding: 6rem 0; background: #fff; color: #000; border-top: 5px solid var(--red); }
  .reviews-standard-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6rem; align-items: start; }
  .reviews-standard h2, .reviews-source h2 { margin-top: 1rem; font-size: clamp(2.7rem, 5vw, 5.5rem); }
  .reviews-standard-copy { border-left: 4px solid var(--red); padding-left: 2rem; color: #333; font-size: 1.08rem; line-height: 1.75; }
  .reviews-standard-copy p { margin: 0; }
  .reviews-standard-copy p + p { margin-top: 1rem; }

  .reviews-library { padding: 6rem 0 7rem; background: var(--ink); }
  .reviews-library-head { display: flex; justify-content: space-between; align-items: end; gap: 2rem; border-bottom: 1px solid #363636; padding-bottom: 2rem; }
  .reviews-library h2 { margin-top: .75rem; font-size: clamp(3.2rem, 7vw, 7rem); }
  .reviews-library-head > p { color: #999; max-width: 250px; line-height: 1.5; text-align: right; }
  .reviews-library-head strong { color: #fff; font-size: 1.7rem; }
  .reviews-filters { display: flex; gap: .55rem; overflow-x: auto; padding: 1.4rem 0 .4rem; scrollbar-width: thin; }
  .reviews-filter { min-height: 44px; flex: 0 0 auto; border: 1px solid #454545; background: #171717; color: #BDBDBD; padding: .7rem 1rem; font-size: .75rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; cursor: pointer; }
  .reviews-filter.active, .reviews-filter:hover { border-color: var(--red); background: var(--red); color: #fff; }
  .reviews-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin-top: 1.4rem; background: #3A3A3A; border: 1px solid #3A3A3A; }
  .review-card { min-width: 0; padding: clamp(1.5rem, 3vw, 2.5rem); background: var(--card); }
  .review-card[hidden] { display: none; }
  .review-card-topline { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .review-number { color: #555; font-family: Arial Black, Arial, sans-serif; font-size: .8rem; }
  .review-audience { color: var(--red); font-size: .68rem; font-weight: 900; letter-spacing: .14em; text-transform: uppercase; }
  .review-card blockquote { margin: 2.1rem 0 2rem; position: relative; }
  .review-mark { position: absolute; top: -1.2rem; left: -.15rem; color: var(--red); font-family: Georgia, serif; font-size: 4rem; line-height: 1; }
  .review-card blockquote p { position: relative; margin: 0; padding-top: 1.8rem; color: #F2F2F2; font-size: clamp(1.05rem, 1.5vw, 1.28rem); font-weight: 700; line-height: 1.55; }
  .review-card footer { border-top: 1px solid #383838; padding-top: 1.25rem; }
  .review-person { display: flex; align-items: baseline; gap: .7rem; margin-bottom: 1.1rem; }
  .review-person strong { font-family: Arial Black, Arial, sans-serif; text-transform: uppercase; }
  .review-person span { color: #898989; font-size: .78rem; }
  .review-card dl { display: grid; gap: .55rem; margin: 0; }
  .review-card dl div { display: grid; grid-template-columns: 4rem 1fr; gap: .5rem; }
  .review-card dt { color: #777; font-size: .66rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  .review-card dd { margin: 0; color: #BDBDBD; font-size: .78rem; line-height: 1.45; }
  .reviews-empty { padding: 2rem; text-align: center; color: #aaa; }

  .reviews-source { padding: 7rem 0; background: #fff; color: #000; }
  .reviews-source-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 6rem; align-items: center; }
  .reviews-source-intro { max-width: 500px; color: #444; font-size: 1.05rem; line-height: 1.7; }
  .reviews-source-links { border-top: 4px solid #000; }
  .reviews-source-links a { display: grid; grid-template-columns: 5rem 1fr 2rem; gap: 1rem; align-items: center; min-height: 90px; border-bottom: 1px solid #BDBDBD; color: #000; transition: color .2s, padding .2s; }
  .reviews-source-links a:hover { color: var(--red); padding-left: .5rem; }
  .reviews-source-links span { color: var(--red); font-size: .68rem; font-weight: 900; letter-spacing: .1em; }
  .reviews-source-links strong { font-family: Arial Black, Arial, sans-serif; font-size: clamp(1rem, 2vw, 1.35rem); text-transform: uppercase; }
  .reviews-source-links svg { width: 1.5rem; fill: none; stroke: currentColor; stroke-width: 2; }

  .reviews-final { position: relative; padding: 7rem 0; background: #050505; text-align: center; }
  .reviews-final-line { position: absolute; inset: 0 auto 0 50%; width: 1px; background: linear-gradient(transparent, rgba(232,0,13,.5), transparent); transform: rotate(18deg); }
  .reviews-final-inner { position: relative; }
  .reviews-final h2 { margin-top: 1rem; font-size: clamp(3.4rem, 8vw, 8rem); }
  .reviews-final p:not(.reviews-section-label) { color: #BDBDBD; font-size: 1.15rem; }
  .reviews-final-actions { justify-content: center; }

  @media (max-width: 800px) {
    .reviews-hero { min-height: 760px; }
    .reviews-hero-media img { object-position: 62% 50%; }
    .reviews-hero-shade { background: linear-gradient(0deg, #000 0%, rgba(0,0,0,.9) 50%, rgba(0,0,0,.25) 100%); }
    .reviews-hero-inner { padding-bottom: 3.5rem; }
    .reviews-hero h1 { font-size: clamp(3.2rem, 15vw, 5.4rem); }
    .reviews-intro { max-width: 34rem; }
    .reviews-standard-grid, .reviews-source-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .reviews-standard-copy { padding-left: 1.25rem; }
    .reviews-library-head { display: block; }
    .reviews-library-head > p { margin-top: 1rem; text-align: left; }
    .reviews-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 520px) {
    .reviews-container, .reviews-hero-inner { width: min(100% - 1.25rem, 1180px); }
    .reviews-hero { min-height: calc(100svh - 4rem); }
    .reviews-hero-media img { object-position: 61% 50%; }
    .reviews-hero-grid { background-size: 48px 48px; }
    .reviews-hero-actions, .reviews-final-actions { display: grid; grid-template-columns: 1fr; }
    .reviews-primary-cta, .reviews-secondary-cta { width: 100%; }
    .reviews-standard, .reviews-library, .reviews-source, .reviews-final { padding-block: 4.5rem; }
    .reviews-standard h2, .reviews-source h2 { font-size: 2.8rem; }
    .review-card { padding: 1.4rem; }
    .reviews-source-links a { grid-template-columns: 4rem 1fr 1.5rem; min-height: 82px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .reviews-primary-cta, .reviews-secondary-cta, .reviews-source-links a { transition: none; }
  }
</style>
