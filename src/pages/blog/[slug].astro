---
import BlogPost from '../../layouts/BlogPost.astro'
import fallbackPosts from '../../data/blogPostFallbacks.json'
import { portableTextToHtml } from '../../lib/sanityPortableText'
import { sanityClient } from '../../lib/sanityClient'

const escapeHtml = (value: string) =>
  String(value || '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;')

const plainTextToHtml = (body: string) => {
  const paragraphs = String(body || '')
    .split(/\n\s*\n/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean)

  return paragraphs
    .map((paragraph) => `<p>${escapeHtml(paragraph).replace(/\n/g, '<br />')}</p>`)
    .join('')
}

export async function getStaticPaths() {
  try {
    const posts = await sanityClient.fetch(
      `*[_type == "blogPost" && publishStatus == "published" && defined(slug.current)] | order(publishedAt desc) {
        "slug": slug.current,
        title,
        excerpt,
        body,
        richBody,
        publishedAt,
        _updatedAt,
        category,
        coverImageUrl,
        coverImageAltText,
        "image": coverImage.asset->url,
        "imageAlt": coverImage.alt
      }`
    )
    if (posts.length > 0) {
      const all = posts.map((p: any) => ({ slug: p.slug, title: p.title, excerpt: p.excerpt || '', category: p.category || '' }))
      return posts.map((post: any) => ({
        params: { slug: post.slug },
        props: { post, all },
      }))
    }
  } catch (e) {
    console.error('Sanity fetch failed for blog paths:', e)
  }

  const fallbackAll = fallbackPosts.map((p: any) => ({ slug: p.slug?.current || p.slug, title: p.title, excerpt: p.excerpt || '', category: p.category || '' }))
  return fallbackPosts.map((post: any) => ({
    params: { slug: post.slug?.current || post.slug },
    props: {
      all: fallbackAll,
      post: {
        ...post,
        slug: post.slug?.current || post.slug,
        image: post.coverImageUrl,
        imageAlt: post.coverImageAltText,
      },
    },
  }))
}

const { post, all = [] } = Astro.props

const formattedDate = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
  : ''

// Last-modified comes from Sanity's own _updatedAt, never a synthetic "today".
// Fallback posts carry no edit history, so they report their publish date.
const updatedIso = (() => {
  const raw = post._updatedAt || post.publishedAt
  const parsed = raw ? new Date(raw) : null
  return parsed && !Number.isNaN(parsed.getTime()) ? parsed.toISOString().split('T')[0] : ''
})()

const bodyHtml = portableTextToHtml(post.richBody || []) || plainTextToHtml(post.body || '')
const postImage = post.image || post.coverImageUrl || '/images/training/jfp-session.webp'
const postImageAlt = post.imageAlt || post.coverImageAltText || post.title

const blogSeoOverrides: Record<string, { title?: string; description?: string }> = {
  '10-mistakes-football-players-make-every-week': {
    title: '10 Football Mistakes Players Must Fix | Joner Football',
    description: 'Fix 10 common football mistakes in training, from first touch panic to poor passing habits. Practical coaching detail from Joner Football.',
  },
  '50-ball-mastery-skills-young-players': {
    title: '50 Ball Mastery Skills For Young Players | Joner Football',
  },
  'coachability-most-important-trait-football': {
    title: 'Why Coachability Matters In Football | Joner Football',
  },
  'different-football-cultures-shape-young-players': {
    title: 'How Football Cultures Shape Players | Joner Football',
    description: 'See how different football cultures shape young players and what families can learn from varied coaching styles, standards and habits.',
  },
  'football-camp-packing-list': {
    title: 'Football Camp Packing List | Joner Football',
    description: 'Use this football camp packing list so players arrive ready to train, compete and enjoy the full Joner Football camp experience.',
  },
  'football-training-for-kids': {
    title: 'Football Training For Kids | Joner Football',
  },
  'how-to-coach-different-ages-one-drill': {
    description: 'Lee Jones shows how to coach different ages and abilities with one drill setup by changing the progressions, not the whole session.',
    title: 'Coach Different Ages With One Drill | Joner Football',
  },
  'parents-dont-be-fooled-by-tiktok': {
    title: 'Parents, Do Not Be Fooled By TikTok Drills | Joner Football',
    description: 'Not every viral football drill helps your child improve. Learn what to look for so training builds real technique and confidence.',
  },
  'viral-football-drills': {
    description: 'Lee Jones tested five viral football drills. Only one truly relates to the game. What coaches, parents and players should take from it.',
    title: 'Viral Football Drills: What Actually Works | Joner Football',
  },
  'what-makes-great-football-coach': {
    description: 'What separates a great football coach from an average one? Five qualities to look for, from technical knowledge to communication.',
    title: 'What Makes A Great Football Coach | Joner Football',
  },
  'what-scouts-look-for-young-football-players': {
    title: 'What Scouts Look For In Young Players | Joner Football',
    description: 'Understand what scouts look for in young football players, from technique and decision making to attitude, bravery and consistency.',
  },
  'youth-football-winning-mentality': {
    title: 'Youth Football Winning Mentality | Joner Football',
    description: 'Winning mentality in youth football is built through effort, standards, resilience and coachability, not empty hype or shortcuts.',
  },
  'football-drills-at-home': {
    description: '10 football drills at home you can do alone with one ball. How to practise on your own: ball mastery, first touch and weak foot, step by step.',
    title: 'Football Drills at Home: 10 to Do Alone | Joner Football',
  },
  'how-to-plan-progress-pro-level-football-training-sessions': {
    title: 'How To Plan Pro-Level Football Sessions | Joner Football',
  },
  'why-half-turn-changes-everything-football': {
    description: 'Most players lose the ball before they touch it. Learn why the half turn helps players scan, receive and play forward faster.',
    title: 'Why The Half Turn Changes Everything | Joner Football',
  },
  'half-turn-drills-for-football-coaches': {
    description: 'Half turn drills for coaches: build scanning, open body shape, first touch and acceleration into your sessions every week.',
    title: 'Half Turn Drills For Football Coaches | Joner Football',
  },
  'improve-first-touch-football': {
    title: 'How to Improve Your First Touch in Football | Joner Football',
  },
}

// Several posts are genuinely numbered lists ("1. Toe Taps", "2. V-Pulls").
// Marking those up as an ItemList describes what a reader actually sees, which
// is the schema answer engines can use. FAQPage is deliberately NOT used here:
// these headings are steps and topics, not questions, and FAQ markup that does
// not match visible Q&A is invalid.
const listItems = Array.from(bodyHtml.matchAll(/<h2[^>]*>\s*(\d+)\.\s*([^<]+?)\s*<\/h2>/gi))
  .map((match) => ({ position: Number(match[1]), name: match[2].trim() }))
  .filter((item) => item.name.length > 1)
  .sort((a, b) => a.position - b.position)

const listSchema = listItems.length >= 3
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: post.title,
      numberOfItems: listItems.length,
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      itemListElement: listItems.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
      })),
    }
  : undefined

const slugKey = post.slug?.current || post.slug || Astro.params.slug || ''

// Keep reading: three related posts on every post, so no post relies on the blog index alone for links.
// Hand-picked by topic (9 Nov 2026 internal link pass); new posts fall back to the same category, then newest.
const relatedMap: Record<string, string[]> = {
  'football-drills-at-home': ['improve-first-touch-football', '50-ball-mastery-skills-young-players', '10-mistakes-football-players-make-every-week'],
  'improve-first-touch-football': ['football-drills-at-home', 'why-half-turn-changes-everything-football', '50-ball-mastery-skills-young-players'],
  '50-ball-mastery-skills-young-players': ['football-drills-at-home', 'football-training-for-kids', 'improve-first-touch-football'],
  '10-mistakes-football-players-make-every-week': ['improve-first-touch-football', 'coachability-most-important-trait-football', 'what-scouts-look-for-young-football-players'],
  'football-camp-packing-list': ['football-training-for-kids', 'youth-football-winning-mentality', '50-ball-mastery-skills-young-players'],
  'football-training-for-kids': ['parents-dont-be-fooled-by-tiktok', '50-ball-mastery-skills-young-players', 'football-camp-packing-list'],
  'half-turn-drills-for-football-coaches': ['why-half-turn-changes-everything-football', 'how-to-coach-different-ages-one-drill', 'how-to-plan-progress-pro-level-football-training-sessions'],
  'why-half-turn-changes-everything-football': ['half-turn-drills-for-football-coaches', 'improve-first-touch-football', 'what-scouts-look-for-young-football-players'],
  'how-to-coach-different-ages-one-drill': ['how-to-plan-progress-pro-level-football-training-sessions', 'what-makes-great-football-coach', 'half-turn-drills-for-football-coaches'],
  'coachability-most-important-trait-football': ['youth-football-winning-mentality', 'what-scouts-look-for-young-football-players', '10-mistakes-football-players-make-every-week'],
  'how-to-plan-progress-pro-level-football-training-sessions': ['how-to-coach-different-ages-one-drill', 'half-turn-drills-for-football-coaches', 'what-makes-great-football-coach'],
  'parents-dont-be-fooled-by-tiktok': ['viral-football-drills', 'football-training-for-kids', 'football-drills-at-home'],
  'what-scouts-look-for-young-football-players': ['coachability-most-important-trait-football', 'youth-football-winning-mentality', 'different-football-cultures-shape-young-players'],
  'viral-football-drills': ['parents-dont-be-fooled-by-tiktok', 'how-to-plan-progress-pro-level-football-training-sessions', 'football-drills-at-home'],
  'youth-football-winning-mentality': ['coachability-most-important-trait-football', 'what-scouts-look-for-young-football-players', 'different-football-cultures-shape-young-players'],
  'what-makes-great-football-coach': ['how-to-coach-different-ages-one-drill', 'how-to-plan-progress-pro-level-football-training-sessions', 'coachability-most-important-trait-football'],
  'different-football-cultures-shape-young-players': ['what-scouts-look-for-young-football-players', 'youth-football-winning-mentality', 'coachability-most-important-trait-football'],
}
const others = (all as Array<{ slug: string; title: string; excerpt: string; category: string }>).filter((p) => p.slug && p.slug !== slugKey)
const related = [
  ...(relatedMap[slugKey] || []).map((slug) => others.find((p) => p.slug === slug)),
  ...others.filter((p) => post.category && p.category === post.category),
  ...others,
].filter((p, i, list): p is (typeof others)[number] => Boolean(p) && list.findIndex((q) => q?.slug === p!.slug) === i).slice(0, 3)
const seoOverride = blogSeoOverrides[slugKey] || {}
// Google cuts titles past about 60 characters: drop to a shorter brand suffix when the long one would not fit.
const fitTitle = (name: string) => [`${name} | Joner Football Blog`, `${name} | Joner Football`].find((t) => t.length <= 60) || name
const seoTitle = seoOverride.title || fitTitle(post.title)
const seoDescription = seoOverride.description || post.excerpt || ''
---

<BlogPost
  title={post.title}
  seoTitle={seoTitle}
  description={seoDescription}
  date={formattedDate}
  updated={updatedIso}
  extraSchema={listSchema}
  category={post.category || ''}
  readTime=""
  image={postImage}
  imageAlt={postImageAlt}
>
  {bodyHtml ? (
    <Fragment set:html={bodyHtml} />
  ) : (
    <p>Content coming soon.</p>
  )}
  {related.length > 0 && (
    <section class="blog-related" aria-labelledby="blog-related-title">
      <h2 id="blog-related-title">Keep reading</h2>
      <ul>
        {related.map((p) => (
          <li><a href={`/blog/${p.slug}/`}>{p.title}</a></li>
        ))}
      </ul>
    </section>
  )}
</BlogPost>
