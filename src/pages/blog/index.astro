---
import BaseLayout from '../../layouts/BaseLayout.astro'
import EmailCapture from '../../components/EmailCapture.astro'
import { sanityClient } from '../../lib/sanityClient'

const hardcodedPosts = [
  {
    title: 'How To Coach Different Ages With One Drill Setup',
    slug: 'how-to-coach-different-ages-one-drill',
    excerpt: 'Good coaches do not need a brand new drill for every age group. They need one simple setup, clear progressions, and better coaching detail.',
    date: 'April 28, 2026',
    readTime: '7 min read',
    category: 'Coaches',
    audience: 'Coaches',
    image: '/images/blog/how-to-coach-different-ages-one-drill.jpg',
  },
  {
    title: 'Why Youth Football Is Losing Its Winning Mentality',
    slug: 'youth-football-winning-mentality',
    excerpt: 'Modern youth football is producing highly technical players, but too many are missing the fight, resilience, and standards needed to compete properly.',
    date: 'April 28, 2026',
    readTime: '7 min read',
    category: 'Coaches',
    audience: 'Coaches',
    image: '/images/blog/youth-football-winning-mentality.jpg',
  },
  {
    title: '10 Mistakes Football Players Make Every Week, And How To Fix Them',
    slug: '10-mistakes-football-players-make-every-week',
    excerpt: 'Lee Jones breaks down 10 common football mistakes players make every week, from poor first touch and lazy passing to weak preparation, communication, and self-evaluation.',
    date: 'April 28, 2026',
    readTime: '8 min read',
    category: 'Players',
    audience: 'Players',
    image: '/images/blog/10-mistakes-football-players-make-every-week.jpg',
  },
  {
    title: 'I Tested 5 Viral Football Drills. Only One Of Them Was Actually Football.',
    slug: 'viral-football-drills',
    excerpt: 'A viral drill is not automatically a good drill. I tested five of them and only one really trained the game.',
    date: 'April 27, 2026',
    readTime: '8 min read',
    category: 'Coaches',
    audience: 'Coaches',
    image: '/images/blog/viral-football-drills.jpg',
  },
  {
    title: 'Why Coachability Is the Most Important Trait in Football',
    slug: 'coachability-most-important-trait-football',
    excerpt: 'The one trait that separates players who make it from players who don\'t. It\'s not speed, strength, or even technique. It\'s coachability.',
    date: 'April 1, 2026',
    readTime: '6 min read',
    category: 'Players',
    audience: 'Players',
    image: '/images/training/jfp-session.webp',
  },
  {
    title: '10 Football Drills You Can Do Alone at Home',
    slug: 'football-drills-at-home',
    excerpt: 'You don\'t need a full pitch or a training partner to improve. These 10 drills will sharpen your technique from your backyard, garage, or living room.',
    date: 'March 28, 2026',
    readTime: '6 min read',
    category: 'Players',
    audience: 'Players',
    image: '/images/training/jfp-session.webp',
  },
  {
    title: 'How to Improve Your First Touch in Football',
    slug: 'improve-first-touch-football',
    excerpt: 'Your first touch determines everything that happens next. Here\'s how to develop a first touch that gives you time, space, and control under pressure.',
    date: 'March 25, 2026',
    readTime: '7 min read',
    category: 'Players',
    audience: 'Players',
    image: '/images/homepage/audience-player.webp',
  },
  {
    title: 'The Best Football Training Program for Kids (Ages 8-12)',
    slug: 'football-training-for-kids',
    excerpt: 'Not all football training programs are equal. Here\'s what to look for when choosing a program for your child, and why technical focus matters most.',
    date: 'March 22, 2026',
    readTime: '6 min read',
    category: 'Parents',
    audience: 'Parents',
    image: '/images/homepage/audience-parent.webp',
  },
  {
    title: 'What Makes a Great Football Coach? 5 Things to Look For',
    slug: 'what-makes-great-football-coach',
    excerpt: 'Great coaches aren\'t just loud voices on the sideline. Here are five qualities that separate good coaches from truly great ones.',
    date: 'March 19, 2026',
    readTime: '5 min read',
    category: 'Coaches',
    audience: 'Coaches',
    image: '/images/homepage/audience-coach.webp',
  },
  {
    title: 'Football Camp Packing List: Everything Your Child Needs',
    slug: 'football-camp-packing-list',
    excerpt: 'Heading to a football camp? Here\'s everything your child needs to pack, plus a few things most parents forget.',
    date: 'March 16, 2026',
    readTime: '4 min read',
    category: 'Parents',
    audience: 'Parents',
    image: '/images/camps/la-camp.webp',
  },
]

let posts = hardcodedPosts

try {
  const sanityPosts = await sanityClient.fetch(
    `*[_type == "blogPost"] | order(publishedAt desc) {
      title,
      "slug": slug.current,
      excerpt,
      publishedAt,
      category,
      "image": coverImage.asset->url
    }`
  )
  if (sanityPosts && sanityPosts.length > 0) {
    posts = sanityPosts.map((p: any) => ({
      title: p.title,
      slug: p.slug,
      excerpt: p.excerpt || '',
      date: p.publishedAt ? new Date(p.publishedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : '',
      readTime: '',
      category: p.category || '',
      audience: p.category || 'World Football',
      image: p.image || '/images/training/jfp-session.webp',
    }))
  }
} catch (e) {
  console.error('Sanity fetch failed, using hardcoded posts')
}

const blogGroups = [
  { title: 'Coaches', intro: 'Coach notes, session ideas and player development thinking.', posts: posts.filter((post: any) => post.audience === 'Coaches') },
  { title: 'Parents', intro: 'Practical reads for parents helping their child train better.', posts: posts.filter((post: any) => post.audience === 'Parents') },
  { title: 'Players', intro: 'Training ideas for players who want sharper technique.', posts: posts.filter((post: any) => post.audience === 'Players') },
  { title: 'World Football', intro: 'Bigger football ideas, trends and talking points.', posts: posts.filter((post: any) => post.audience === 'World Football') },
]
---

<BaseLayout
  title="Football Training Tips & Coaching Blog | Joner Football"
  description="Football drills, coaching tips, and player development from Joner Football. Expert advice from Coach Joner and the team."
>
  <!-- Hero -->
  <section class="bg-joner-gray py-20 md:py-24 relative">
    <div class="absolute top-0 left-0 right-0 h-1 bg-joner-red"></div>
    <div class="max-w-4xl mx-auto px-4 text-center">
      <p class="text-joner-red font-heading text-sm uppercase tracking-widest mb-4">Joner Football Hub</p>
      <h1 class="font-heading text-3xl sm:text-5xl md:text-7xl font-bold text-white uppercase mb-4">Joner Blogs</h1>
      <p class="text-gray-400 font-body text-lg mb-8">My words, my videos and my football ideas, sorted for coaches, parents, players and world football.</p>
      <div class="flex flex-wrap justify-center gap-3">
        {blogGroups.map((group) => group.posts.length > 0 && (
          <a href={`#${group.title.toLowerCase().replace(' ', '-')}`} class="border border-gray-700 px-4 py-3 font-heading text-sm uppercase tracking-wider text-white hover:border-joner-red hover:text-joner-red transition-colors">{group.title}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- Posts grid -->
  <section class="bg-joner-black py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {posts.length === 0 ? (
        <div class="text-center py-20">
          <p class="font-heading text-2xl text-white uppercase mb-4">No Posts Yet</p>
          <p class="text-gray-400 font-body">New content is on the way. In the meantime, train with the app.</p>
          <a href="/app" class="btn-red inline-block mt-6">Try the App Free</a>
        </div>
      ) : (
        <div class="space-y-12 md:space-y-14">
          {blogGroups.map((group) => group.posts.length > 0 && (
            <section id={group.title.toLowerCase().replace(' ', '-')}> 
              <div class="mb-5 border-l-4 border-joner-red pl-4 flex flex-col md:flex-row md:items-end md:justify-between gap-2">
                <h2 class="font-heading text-3xl md:text-5xl font-bold text-white uppercase leading-none">{group.title}</h2>
                <p class="text-gray-400 font-body md:text-right md:max-w-md">{group.intro}</p>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
                {group.posts.map((post) => (
                  <a href={`/blog/${post.slug}`} class="group border border-gray-800 hover:border-joner-red transition-all duration-200 hover:-translate-y-1 overflow-hidden bg-joner-black">
                    <div class="aspect-video overflow-hidden bg-joner-gray">
                      <img src={post.image} alt={post.title} class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                    </div>
                    <div class="p-6">
                      <div class="flex items-center gap-3 mb-3">
                        <span class="bg-joner-red/20 text-joner-red px-2 py-0.5 font-heading text-xs uppercase tracking-wider">{post.category}</span>
                        <span class="text-gray-600 text-xs font-body">{post.readTime}</span>
                      </div>
                      <h3 class="font-heading text-lg font-bold text-white mb-2 group-hover:text-joner-red transition-colors uppercase leading-tight">
                        {post.title}
                      </h3>
                      <p class="text-gray-400 font-body text-sm leading-relaxed mb-3">{post.excerpt}</p>
                      <div class="text-joner-red font-heading text-xs uppercase tracking-wider">Read blog</div>
                    </div>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      )}    </div>
  </section>

  <!-- App CTA -->
  <section class="bg-joner-red py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="font-heading text-2xl md:text-4xl font-bold text-white uppercase mb-4">
        Ready to Start Training?
      </h2>
      <p class="text-white/80 font-body mb-6">
        1,500+ drills, session plans, and follow-along programs. Try the Joner Football App free.
      </p>
      <a href="https://jonerfootball.com/join/" class="bg-white text-joner-red font-heading text-base uppercase tracking-wider px-8 py-4 hover:bg-gray-100 transition-colors inline-block">
        Try the World's #1 Football App Free
      </a>
    </div>
  </section>

  <EmailCapture />
</BaseLayout>
