---
import BaseLayout from '../layouts/BaseLayout.astro'

const stats = [
  ['1,500+', 'drills and sessions'],
  ['100 days', 'structured player pathway'],
  ['50+', 'countries worldwide'],
  ['380K+', 'YouTube subscribers']
]

const highlights = [
  {
    eyebrow: 'Programs',
    title: 'A complete plan, not random drills.',
    text: 'Follow structured training blocks, daily sessions, and technical progressions built by Lee Jones.',
    image: '/images/app/screenshot-6.webp'
  },
  {
    eyebrow: 'Coaches',
    title: 'Sessions ready when you are.',
    text: 'Session plans, coaching points, small group formats, and full training sessions you can take straight onto the pitch.',
    image: '/images/app/screenshot-7.webp'
  },
  {
    eyebrow: 'Training',
    title: 'Press play and train with purpose.',
    text: 'Ball mastery, first touch, passing, dribbling, finishing, weak foot, and daily technical work in one place.',
    image: '/images/app/screenshot-4.webp'
  }
]

const audience = [
  ['Players', 'Build technique with a day-by-day pathway and follow-along sessions.'],
  ['Coaches', 'Save prep time with plans, progressions, voice-over drills, and full session examples.'],
  ['Parents', 'Give young players a clear way to practise without guessing what to do next.']
]
---

<BaseLayout
  title="Joner Football App Preview | Complete Football Development"
  description="A new preview landing page for the Joner Football App, inspired by premium product pages and built separately from the live app page."
  hideMobileAppCta={true}
>
  <main class="app-new">
    <nav class="app-new-local-nav" aria-label="Joner Football App preview navigation">
      <a href="/app-new" class="app-new-local-nav__brand">Joner Football App</a>
      <div class="app-new-local-nav__links">
        <a href="#highlights">Highlights</a>
        <a href="#inside">Inside</a>
        <a href="#coaches">Coaches</a>
        <a href="/join" class="app-new-local-nav__cta">Start free trial</a>
      </div>
    </nav>

    <section class="app-new-hero">
      <div class="app-new-hero__glow app-new-hero__glow--red"></div>
      <div class="app-new-hero__glow app-new-hero__glow--white"></div>
      <div class="app-new-shell app-new-hero__content">
        <p class="app-new-eyebrow">The world&apos;s #1 football training app</p>
        <h1>One app.<br />Complete football development.</h1>
        <p class="app-new-hero__lede">Everything players, parents and coaches need to train with purpose. Structured programs, session plans, and technical detail from Lee Jones.</p>
        <div class="app-new-hero__actions">
          <a href="/join" class="app-new-btn app-new-btn--red">Start free trial</a>
          <a href="https://app.jonerfootball.com/categories/category-vpi8uazway4" target="_blank" rel="noopener" class="app-new-btn app-new-btn--dark">Browse free content</a>
        </div>
        <div class="app-new-hero__stores" aria-label="Download links">
          <a href="https://apps.apple.com/au/app/joner-football-app/id6737069275" target="_blank" rel="noopener">App Store</a>
          <a href="https://play.google.com/store/apps/details?id=tv.uscreen.jonerfootball" target="_blank" rel="noopener">Google Play</a>
        </div>
      </div>
      <div class="app-new-devices" aria-label="Joner Football App shown on iPad and iPhone">
        <img class="app-new-devices__ipad" src="/images/app/joner-app-main-ipad-current-transparent.png" alt="Joner Football App iPad view" loading="eager" />
        <img class="app-new-devices__iphone" src="/images/app/joner-app-main-iphone-current-transparent.png" alt="Joner Football App iPhone view" loading="eager" />
      </div>
    </section>

    <section class="app-new-stats" aria-label="Joner Football App stats">
      <div class="app-new-shell app-new-stats__grid">
        {stats.map(([number, label]) => (
          <div>
            <strong>{number}</strong>
            <span>{label}</span>
          </div>
        ))}
      </div>
    </section>

    <section id="highlights" class="app-new-section app-new-section--light">
      <div class="app-new-shell">
        <div class="app-new-section-head">
          <p class="app-new-eyebrow">Get the highlights</p>
          <h2>Built for the work players actually need.</h2>
        </div>
        <div class="app-new-highlight-grid">
          {highlights.map((item) => (
            <article class="app-new-highlight-card">
              <div>
                <p>{item.eyebrow}</p>
                <h3>{item.title}</h3>
                <span>{item.text}</span>
              </div>
              <img src={item.image} alt={item.title} loading="lazy" />
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="inside" class="app-new-section app-new-section--black">
      <div class="app-new-shell app-new-split">
        <div>
          <p class="app-new-eyebrow">Inside the app</p>
          <h2>Everything organised. Everything ready.</h2>
          <p>The app gives every session a clear purpose. Players can press play and train. Coaches can open a session and deliver. Parents can finally give their child a proper plan.</p>
          <div class="app-new-mini-grid">
            <span>Drill library</span>
            <span>Session plans</span>
            <span>100 Day Program</span>
            <span>Daily challenges</span>
            <span>Coaches section</span>
            <span>Offline downloads</span>
          </div>
        </div>
        <div class="app-new-showcase-card">
          <img src="/images/app/lee-app-composite.jpg" alt="Joner Football App screens and Lee Jones coaching" loading="lazy" />
        </div>
      </div>
    </section>

    <section class="app-new-section app-new-section--light app-new-programme">
      <div class="app-new-shell">
        <p class="app-new-eyebrow">The programme</p>
        <h2>The 100 Day Player Program.</h2>
        <p>Most players train without a plan. This gives them one. A clear day-by-day pathway that builds ball mastery, first touch, passing, movement, and finishing into a complete technical base.</p>
        <div class="app-new-steps">
          <article><strong>Days 1 to 30</strong><span>Build the foundation with close control, ball mastery, and first touch.</span></article>
          <article><strong>Days 31 to 70</strong><span>Add passing, movement, combinations, and game detail.</span></article>
          <article><strong>Days 71 to 100</strong><span>Bring it together with sessions that feel closer to match demands.</span></article>
        </div>
        <a href="/programmes" class="app-new-btn app-new-btn--red">See the 100 Day Program</a>
      </div>
    </section>

    <section id="coaches" class="app-new-section app-new-section--black app-new-coaches">
      <div class="app-new-shell app-new-split app-new-split--reverse">
        <div class="app-new-showcase-card app-new-showcase-card--dark">
          <img src="/images/coaches-only/session-structure-roadmap-plush.png" alt="Coaches Only session structure pathway" loading="lazy" />
        </div>
        <div>
          <p class="app-new-eyebrow">For coaches</p>
          <h2>Stop winging your sessions.</h2>
          <p>Learn how Joner Football structures training through session plans, voice-over breakdowns, full session videos, and coaching detail that makes your work sharper.</p>
          <a href="/app/for-coaches" class="app-new-btn app-new-btn--red">Explore Coaches Only</a>
        </div>
      </div>
    </section>

    <section class="app-new-section app-new-section--light">
      <div class="app-new-shell">
        <div class="app-new-section-head">
          <p class="app-new-eyebrow">Who it helps</p>
          <h2>Players. Coaches. Parents. One clear system.</h2>
        </div>
        <div class="app-new-audience-grid">
          {audience.map(([title, text]) => (
            <article>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="app-new-final">
      <div class="app-new-shell">
        <p class="app-new-eyebrow">Start training today</p>
        <h2>Your football development, finally in one place.</h2>
        <p>Open the app, pick the work, press play, and train with purpose.</p>
        <div class="app-new-hero__actions">
          <a href="/join" class="app-new-btn app-new-btn--red">Start free trial</a>
          <a href="https://app.jonerfootball.com/categories/category-vpi8uazway4" target="_blank" rel="noopener" class="app-new-btn app-new-btn--dark">Browse free content</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  :global(body) { background: #000; }
  .app-new {
    --red: #e8000d;
    --red-dark: #9f0008;
    --ink: #050505;
    --soft: #f5f5f7;
    background: #000;
    color: #fff;
    font-family: 'DM Sans', system-ui, sans-serif;
    overflow: hidden;
  }
  .app-new-shell { width: min(100% - 40px, 1240px); margin: 0 auto; }
  .app-new-local-nav {
    position: sticky;
    top: 64px;
    z-index: 50;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 13px max(20px, calc((100vw - 1240px) / 2));
    border-bottom: 1px solid rgba(255,255,255,0.12);
    background: rgba(10,10,12,0.72);
    backdrop-filter: blur(22px);
  }
  .app-new-local-nav a { color: rgba(255,255,255,0.82); text-decoration: none; font-size: 0.82rem; }
  .app-new-local-nav__brand { color: #fff !important; font-weight: 800; letter-spacing: -0.02em; }
  .app-new-local-nav__links { display: flex; align-items: center; gap: 18px; }
  .app-new-local-nav__cta { padding: 7px 13px; border-radius: 999px; background: var(--red); color: #fff !important; }

  .app-new-hero { position: relative; min-height: 112vh; display: flex; flex-direction: column; justify-content: center; padding: 84px 0 0; background: radial-gradient(circle at 50% 25%, #282828 0%, #090909 48%, #000 100%); }
  .app-new-hero__content { position: relative; z-index: 5; text-align: center; padding-top: 20px; }
  .app-new-eyebrow { margin: 0 0 15px; color: var(--red); font-family: 'Bebas Neue', Impact, sans-serif; font-size: clamp(0.88rem, 1.5vw, 1.05rem); letter-spacing: 0.18em; text-transform: uppercase; }
  .app-new-hero h1 { margin: 0 auto; max-width: 1040px; font-family: 'Bebas Neue', Impact, sans-serif; font-size: clamp(4.6rem, 11.5vw, 11.5rem); line-height: 0.82; letter-spacing: -0.045em; text-transform: uppercase; }
  .app-new-hero__lede { max-width: 720px; margin: 28px auto 0; color: rgba(255,255,255,0.78); font-size: clamp(1.08rem, 2vw, 1.45rem); line-height: 1.45; }
  .app-new-hero__actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 13px; margin-top: 30px; }
  .app-new-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 13px 23px; border-radius: 999px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.04em; text-decoration: none; transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease; }
  .app-new-btn:hover { transform: translateY(-2px); }
  .app-new-btn--red { color: #fff; background: linear-gradient(180deg, var(--red), var(--red-dark)); box-shadow: 0 18px 44px rgba(232,0,13,0.28); }
  .app-new-btn--dark { color: #fff; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.22); }
  .app-new-hero__stores { display: flex; justify-content: center; gap: 18px; margin-top: 19px; }
  .app-new-hero__stores a { color: rgba(255,255,255,0.68); text-decoration: none; font-size: 0.9rem; }
  .app-new-hero__glow { position: absolute; left: 50%; top: 24%; transform: translate(-50%, -50%); border-radius: 999px; filter: blur(70px); pointer-events: none; }
  .app-new-hero__glow--red { width: 38vw; height: 20vw; background: rgba(232,0,13,0.2); }
  .app-new-hero__glow--white { width: 26vw; height: 18vw; background: rgba(255,255,255,0.08); }
  .app-new-devices { position: relative; z-index: 4; height: min(58vw, 620px); width: min(98vw, 1100px); margin: clamp(28px, 5vw, 70px) auto 0; }
  .app-new-devices__ipad { position: absolute; left: 50%; top: 47%; width: min(82vw, 860px); transform: translate(-50%, -50%); filter: drop-shadow(0 48px 95px rgba(0,0,0,0.78)); }
  .app-new-devices__iphone { position: absolute; left: 68%; top: 47%; width: min(28vw, 270px); transform: translate(-50%, -50%); filter: drop-shadow(0 42px 80px rgba(0,0,0,0.82)); }

  .app-new-stats { background: #050505; border-top: 1px solid rgba(255,255,255,0.1); border-bottom: 1px solid rgba(255,255,255,0.1); }
  .app-new-stats__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: rgba(255,255,255,0.1); }
  .app-new-stats__grid div { background: #050505; padding: 30px 18px; text-align: center; }
  .app-new-stats strong { display: block; font-family: 'Bebas Neue', Impact, sans-serif; font-size: clamp(2.3rem, 5vw, 4.5rem); line-height: 0.9; }
  .app-new-stats span { display: block; margin-top: 9px; color: rgba(255,255,255,0.56); text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.74rem; }

  .app-new-section { padding: clamp(82px, 10vw, 150px) 0; scroll-margin-top: 140px; }
  .app-new-section--light { background: var(--soft); color: #090909; }
  .app-new-section--black { background: #000; color: #fff; }
  .app-new-section-head { display: flex; justify-content: space-between; align-items: end; gap: 28px; margin-bottom: 32px; }
  .app-new-section h2, .app-new-final h2 { margin: 0; font-family: 'Bebas Neue', Impact, sans-serif; font-size: clamp(3.4rem, 8vw, 8rem); line-height: 0.88; letter-spacing: -0.035em; text-transform: uppercase; }
  .app-new-section p:not(.app-new-eyebrow), .app-new-final p:not(.app-new-eyebrow) { max-width: 680px; color: rgba(0,0,0,0.68); font-size: clamp(1.05rem, 1.7vw, 1.28rem); line-height: 1.58; }
  .app-new-section--black p:not(.app-new-eyebrow) { color: rgba(255,255,255,0.68); }

  .app-new-highlight-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .app-new-highlight-card { min-height: 560px; display: flex; flex-direction: column; justify-content: space-between; overflow: hidden; border-radius: 32px; padding: 28px; background: #fff; box-shadow: 0 28px 80px rgba(0,0,0,0.08); }
  .app-new-highlight-card p { margin: 0 0 10px; color: var(--red); font-weight: 900; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.75rem; }
  .app-new-highlight-card h3 { margin: 0 0 12px; font-size: clamp(1.8rem, 3vw, 2.7rem); line-height: 0.98; letter-spacing: -0.04em; }
  .app-new-highlight-card span { color: rgba(0,0,0,0.62); line-height: 1.45; }
  .app-new-highlight-card img { width: 100%; margin: 28px auto -22px; border-radius: 24px; box-shadow: 0 20px 54px rgba(0,0,0,0.16); }

  .app-new-split { display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); gap: clamp(38px, 6vw, 90px); align-items: center; }
  .app-new-split--reverse { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); }
  .app-new-mini-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 12px; margin-top: 28px; max-width: 560px; }
  .app-new-mini-grid span { padding: 16px; border: 1px solid rgba(255,255,255,0.14); border-radius: 18px; color: rgba(255,255,255,0.84); background: rgba(255,255,255,0.05); }
  .app-new-showcase-card { overflow: hidden; border-radius: 34px; background: #111; box-shadow: 0 34px 90px rgba(0,0,0,0.45); }
  .app-new-showcase-card img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .app-new-showcase-card--dark { padding: 8px; background: linear-gradient(145deg, rgba(255,255,255,0.16), rgba(255,255,255,0.03)); }
  .app-new-showcase-card--dark img { border-radius: 27px; }

  .app-new-programme { text-align: center; }
  .app-new-programme p:not(.app-new-eyebrow) { margin-left: auto; margin-right: auto; }
  .app-new-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin: 40px 0 32px; text-align: left; }
  .app-new-steps article, .app-new-audience-grid article { border-radius: 28px; padding: 26px; background: #fff; box-shadow: 0 18px 60px rgba(0,0,0,0.07); }
  .app-new-steps strong { display: block; color: var(--red); font-family: 'Bebas Neue', Impact, sans-serif; font-size: 2rem; text-transform: uppercase; }
  .app-new-steps span { display: block; margin-top: 10px; color: rgba(0,0,0,0.62); line-height: 1.5; }

  .app-new-coaches { background: radial-gradient(circle at 20% 50%, rgba(232,0,13,0.15), transparent 32%), #000; }
  .app-new-audience-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .app-new-audience-grid h3 { margin: 0 0 10px; font-family: 'Bebas Neue', Impact, sans-serif; font-size: 3rem; text-transform: uppercase; }
  .app-new-audience-grid p { margin: 0; color: rgba(0,0,0,0.62); line-height: 1.5; }

  .app-new-final { padding: clamp(95px, 13vw, 180px) 0; text-align: center; background: radial-gradient(circle at 50% 20%, rgba(232,0,13,0.18), transparent 34%), #000; }
  .app-new-final p:not(.app-new-eyebrow) { margin: 24px auto 0; color: rgba(255,255,255,0.68); }

  @media (max-width: 900px) {
    .app-new-local-nav__links a:not(.app-new-local-nav__cta) { display: none; }
    .app-new-hero { min-height: auto; padding-top: 74px; }
    .app-new-hero h1 { font-size: clamp(4.4rem, 19vw, 6.6rem); }
    .app-new-devices { height: 78vw; }
    .app-new-devices__ipad { display: none; }
    .app-new-devices__iphone { left: 50%; width: min(62vw, 260px); }
    .app-new-stats__grid, .app-new-highlight-grid, .app-new-steps, .app-new-audience-grid { grid-template-columns: 1fr; }
    .app-new-section-head { display: block; }
    .app-new-split, .app-new-split--reverse { grid-template-columns: 1fr; }
    .app-new-highlight-card { min-height: auto; }
    .app-new-mini-grid { grid-template-columns: 1fr; }
  }
</style>
