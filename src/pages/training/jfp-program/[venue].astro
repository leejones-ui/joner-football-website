---
// One page per JFP venue, for "near me" searches (Lee approved the SEO plan,
// 18 Oct 2026). Facts come from src/data/jfp-public.js and the live booking
// config. Times change each term, so the pages describe the pattern and link
// to the live timetable on /jfp-booking/ (which stays noindex by design).
import BaseLayout from '../../../layouts/BaseLayout.astro'
import BookNowButton from '../../../components/BookNowButton.astro'
import BookNowPanel from '../../../components/BookNowPanel.astro'
import SEOFAQ from '../../../components/SEOFAQ.astro'
import { faqSchema, breadcrumbSchema, webPageSchema } from '../../../lib/seoSchema'
import { venues, venuePath, postalAddress, jfpTerm, SITE, JFP_URL } from '../../../data/jfp-public.js'
import { oneToOneSummary } from '../../../data/jfp-one-to-one.js'
import { groupingLine } from '../../../data/jfp-term-info.js'

export function getStaticPaths() {
  return venues.map((v) => ({ params: { venue: v.slug } }))
}

const { venue: slug } = Astro.params
const v = venues.find((x) => x.slug === slug)
const others = venues.filter((x) => x.slug !== slug)
const url = `${SITE}${venuePath(v)}`

interface VenueCopy {
  title: string
  description: string
  eyebrow: string
  h1: string
  facts: { value: string; label: string }[]
  sessions: { title: string; text: string; href?: string; linkLabel?: string }[]
  venueHeading: string
  venuePoints: string[]
  extraLink?: { label: string; href: string }
  nearbyLine: string
  faqs: { q: string; a: string }[]
}

const copy: Record<string, VenueCopy> = {
  'belrose-hq': {
    title: 'Football Training in Belrose, Northern Beaches | JFP at Joner Football HQ',
    description: 'Small group football training at the indoor Joner Football HQ in Belrose. After school, early morning and Saturday JFP groups from age 3 right up to pro. All weather.',
    eyebrow: 'Belrose, Northern Beaches',
    h1: 'Football training at Belrose HQ',
    facts: [
      { value: 'Indoor', label: 'All weather' },
      { value: 'Mon to Sat', label: 'Training days' },
      { value: '60 min', label: 'Sessions' },
      { value: '3 to pro', label: 'Ages' },
    ],
    sessions: [
      { title: 'After school small groups', text: 'Afternoon and early evening groups from Monday to Friday. This is the busiest time of the week, so places go quickly.' },
      { title: 'Early morning groups', text: 'Before school groups on some weekdays, for players who want extra work before class.' },
      { title: 'Saturday morning groups', text: 'Small groups on Saturday mornings, for families who cannot make a weekday.' },
      { title: 'JFP Pathway', text: 'Groups for younger players who are not ready for a full JFP group yet, on Friday afternoon and Saturday morning.' },
      { title: 'Joners Juniors', text: 'Fun first football for children aged 3 to 6 on Saturday mornings.', href: '/jonersjuniors', linkLabel: 'Joners Juniors' },
      { title: '1 on 1 training', text: oneToOneSummary },
    ],
    venueHeading: 'The HQ',
    venuePoints: [
      'A fully indoor facility with a professional standard synthetic surface.',
      'Sessions are not cancelled for rain or heat.',
      'On-site parking for drop-off and collection.',
      'A parent viewing area, so you can watch your player train.',
    ],
    extraLink: { label: 'More about the HQ', href: '/hq/' },
    nearbyLine: 'Families come to Belrose HQ from across the Northern Beaches and the North Shore, including',
    faqs: [
      { q: 'Where is JFP in Belrose?', a: 'At the Joner Football HQ, Unit 2, 20 Narabang Way, Belrose NSW 2085, with on-site parking for drop-off and collection.' },
      { q: 'Is training at Belrose HQ indoors?', a: 'Yes. The HQ is a fully indoor facility with a professional standard synthetic surface, so sessions run whatever the weather.' },
      { q: 'What ages train at Belrose HQ?', a: 'From age 3 right up to pro players, all levels and abilities. The youngest players, aged 3 to 6, start in Joners Juniors on Saturday mornings.' },
      { q: 'Can parents watch?', a: 'Yes. The HQ has a parent viewing area so you can watch your player train.' },
      { q: 'How do I book a JFP session in Belrose?', a: 'Open the JFP timetable on the booking page, choose Belrose HQ and apply for the sessions that suit you. We reply within 48 hours with a place, a trial first, or a group that suits better.' },
    ],
  },
  'north-turramurra': {
    title: 'Soccer Training North Turramurra, Upper North Shore | JFP Small Groups',
    description: 'Before school JFP football training at North Turramurra Recreation Area on Wednesday and Thursday mornings. Small groups for all levels and abilities, coached by Joner Football.',
    eyebrow: 'North Turramurra, Upper North Shore',
    h1: 'Football training in North Turramurra',
    facts: [
      { value: 'Outdoor', label: 'Field sessions' },
      { value: 'Wed and Thu', label: 'Training days' },
      { value: 'Before school', label: 'Early morning' },
      { value: '60 min', label: 'Sessions' },
    ],
    sessions: [
      { title: 'Wednesday mornings', text: `Several small groups train side by side, each with its own coach. In ${jfpTerm.term} they start at 6:30am. Lee Jones coaches an older group here for players aged 15 to 19.` },
      { title: 'Thursday mornings', text: `More early groups on Thursday, also starting at 6:30am in ${jfpTerm.term}, so players can train twice a week before school.` },
      { title: 'Grouped by ability', text: groupingLine },
    ],
    venueHeading: 'The venue',
    venuePoints: [
      'North Turramurra Recreation Area is a Ku-ring-gai Council sports ground on Bobbin Head Road.',
      'Training is outdoors on the playing fields, so bring a waterproof jacket for wet mornings.',
      'There is a car park at the recreation area for drop-off.',
      'Only really bad storms alter a session.',
    ],
    nearbyLine: 'North Turramurra suits players from across the Upper North Shore, including',
    faqs: [
      { q: 'Where does JFP train in North Turramurra?', a: 'At North Turramurra Recreation Area, Bobbin Head Road, North Turramurra NSW 2074, the Ku-ring-gai Council sports ground beside the golf course.' },
      { q: 'What time are the North Turramurra sessions?', a: `Early morning on Wednesday and Thursday, before school. In ${jfpTerm.term} the groups start at 6:30am and run for 60 minutes. The live timetable on the booking page has the current times.` },
      { q: 'Does it run in bad weather?', a: 'Yes. These are outdoor field sessions and only really bad storms alter them. Players should bring a waterproof jacket.' },
      { q: 'Which group will my child be in?', a: groupingLine },
      { q: 'Can we train at North Turramurra and Belrose?', a: 'Yes. Families can mix venues and apply for more than one session, up to three a week. Belrose HQ adds after school, early morning and Saturday groups indoors.' },
    ],
  },
  rydalmere: {
    title: 'Soccer Training Rydalmere and Parramatta | JFP Small Groups',
    description: 'Friday morning JFP football training at Rydalmere Park near Parramatta. Before school small groups for all levels and abilities, coached by Joner Football.',
    eyebrow: 'Rydalmere, near Parramatta',
    h1: 'Football training in Rydalmere',
    facts: [
      { value: 'Outdoor', label: 'Field sessions' },
      { value: 'Friday', label: 'Training day' },
      { value: 'Before school', label: 'Early morning' },
      { value: '60 min', label: 'Sessions' },
    ],
    sessions: [
      { title: 'Friday mornings', text: `Several small groups train at the same time, each with its own coach. In ${jfpTerm.term} they start at 6:30am and finish in time for school.` },
      { title: 'An older group with Lee Jones', text: 'Joner Football founder Lee Jones coaches a Friday group here for players aged 13 to 17.' },
      { title: 'Grouped by ability', text: groupingLine },
    ],
    venueHeading: 'The venue',
    venuePoints: [
      'Rydalmere Park is a City of Parramatta park bordered by Victoria Road, Park Road and South Street.',
      'Council car parks are off Park Road and South Street.',
      'Training is outdoors on the playing fields, so bring a waterproof jacket for wet mornings.',
      'Only really bad storms alter a session.',
    ],
    nearbyLine: 'Rydalmere suits players from the Parramatta area and nearby suburbs, including',
    faqs: [
      { q: 'Where does JFP train in Rydalmere?', a: 'At Rydalmere Park, South Street, Rydalmere NSW 2116, with council car parks off Park Road and South Street.' },
      { q: 'What day and time is JFP at Rydalmere?', a: `Friday mornings, before school. In ${jfpTerm.term} the groups start at 6:30am and run for 60 minutes. The live timetable on the booking page has the current times.` },
      { q: 'Does Lee Jones coach at Rydalmere?', a: 'Yes. Lee coaches a Friday morning group for players aged 13 to 17. Other groups are run by the JFP coaching team.' },
      { q: 'Can we add more sessions in the week?', a: 'Yes. Families can apply for more than one session, up to three a week, and mix venues. North Turramurra runs on Wednesday and Thursday mornings, and Belrose HQ runs most days.' },
      { q: 'How do I book JFP at Rydalmere?', a: 'Open the JFP timetable on the booking page, choose Rydalmere Park and apply. We reply within 48 hours with a place, a trial first, or a group that suits better.' },
    ],
  },
}

const c = copy[slug]

const locationId = `${url}#location`
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SportsActivityLocation',
    '@id': locationId,
    name: v.placeName,
    address: postalAddress(v),
    image: `${SITE}${v.photo}`,
    hasMap: v.maps,
    url,
    ...(v.indoor ? {
      telephone: '+61-426-885-924',
      parentOrganization: { '@type': 'Organization', '@id': `${SITE}/#organization`, name: 'Joner Football' },
    } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `JFP small group football training at ${v.name}`,
    serviceType: 'Small group youth football training',
    description: c.description,
    url,
    isRelatedTo: { '@id': `${JFP_URL}#service` },
    provider: { '@type': 'Organization', '@id': `${SITE}/#organization`, name: 'Joner Football' },
    availableAtOrFrom: { '@id': locationId },
    areaServed: [v.locality, ...v.nearby].map((name) => ({ '@type': 'Place', name: `${name} NSW` })),
    audience: { '@type': 'PeopleAudience', suggestedMinAge: 3 },
  },
  webPageSchema({ name: c.title, description: c.description, url }),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE}/` },
    { name: 'Sydney Football Training', url: `${SITE}/training/` },
    { name: 'JFP Program', url: JFP_URL },
    { name: v.name, url },
  ]),
  faqSchema(c.faqs),
]
---

<BaseLayout title={c.title} description={c.description} canonical={url} ogImage={`${SITE}${v.photo}`} schema={schema} hideMobileAppCta>
  <main class="bg-joner-black text-white">
    <nav aria-label="Breadcrumb" class="mx-auto max-w-7xl px-4 pt-6 sm:px-6 lg:px-8">
      <ol class="flex flex-wrap items-center gap-2 font-body text-xs text-neutral-500">
        <li><a href="/training/" class="hover:text-white">Training</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/training/jfp-program/" class="hover:text-white">JFP Program</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-neutral-300" aria-current="page">{v.name}</li>
      </ol>
    </nav>

    <section class="pt-4 pb-12 md:pb-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-black">
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(227,6,19,0.2),transparent_56%)] pointer-events-none"></div>
          <div class="relative z-10 flex flex-col lg:min-h-[560px] lg:flex-row">
            <div class="flex flex-1 flex-col justify-center px-6 py-10 sm:px-10 sm:py-14 lg:p-14">
              <p class="mb-4 font-heading text-xs uppercase tracking-[0.25em] text-joner-red sm:text-sm">{c.eyebrow}</p>
              <h1 class="mb-8 font-heading text-[clamp(2.25rem,11.5vw,3rem)] font-bold uppercase leading-[0.92] text-white sm:text-6xl lg:text-7xl">{c.h1}</h1>
              <div class="flex flex-wrap gap-3">
                <BookNowButton size="lg" place={`jfp-venue-${v.slug}-hero`} />
                <a href={v.maps} target="_blank" rel="noopener noreferrer" class="btn-outline text-sm">Open in Google Maps</a>
              </div>
            </div>
            <div class="relative min-h-[300px] flex-1 sm:min-h-[420px] lg:min-h-0">
              <img src={v.photo} alt={v.photoAlt} class="absolute inset-0 h-full w-full object-cover object-center" loading="eager" />
              <div class="absolute inset-y-0 left-0 hidden w-1/3 bg-gradient-to-r from-black via-black/60 to-transparent lg:block pointer-events-none"></div>
              <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black via-black/40 to-transparent pointer-events-none"></div>
            </div>
          </div>
          <div class="relative z-10 grid grid-cols-2 border-t border-white/10 bg-black/45 md:grid-cols-4">
            {c.facts.map((f, i) => (
              <div class:list={['p-5 text-center border-white/10', i % 2 === 0 && 'border-r', i < 2 && 'border-b md:border-b-0', i === 1 && 'md:border-r', i === 2 && 'md:border-r']}>
                <div class="font-heading text-xl font-bold text-white md:text-2xl">{f.value}</div>
                <div class="mt-1 font-body text-[10px] uppercase tracking-wider text-neutral-500 sm:text-xs">{f.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="sessions" class="scroll-mt-24 py-12 md:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-10 text-center">
          <p class="mb-3 font-heading text-sm uppercase tracking-widest text-joner-red">{jfpTerm.term}</p>
          <h2 class="font-heading text-4xl font-bold uppercase leading-tight text-white md:text-5xl">JFP sessions at {v.name}</h2>
        </div>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
          {c.sessions.map((s) => (
            <article class="flex min-w-0 flex-col rounded-xl border border-white/10 bg-white/[0.04] p-6">
              <h3 class="mb-3 font-heading text-xl uppercase leading-tight text-white">{s.title}</h3>
              <p class="flex-1 font-body text-sm leading-relaxed text-neutral-300 md:text-base">{s.text}</p>
              {s.href && (
                <a href={s.href} class="mt-4 inline-flex min-h-[44px] items-center gap-2 self-start font-heading text-xs uppercase tracking-[0.22em] text-joner-red hover:text-white">
                  <span>{s.linkLabel}</span><span aria-hidden="true">&rarr;</span>
                </a>
              )}
            </article>
          ))}
        </div>
        <div class="mx-auto mt-8 max-w-2xl text-center">
          <p class="mb-5 font-body text-base leading-relaxed text-neutral-300">Times change each term. The live timetable shows every group at {v.name} and the places left.</p>
          <BookNowButton label="See the timetable" place={`jfp-venue-${v.slug}-sessions`} />
        </div>
      </div>
    </section>

    <section id="venue" class="scroll-mt-24 border-t border-white/10 py-12 md:py-20">
      <div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14 lg:px-8">
        <div class="min-w-0">
          <h2 class="mb-6 font-heading text-4xl font-bold uppercase leading-tight text-white md:text-5xl">{c.venueHeading}</h2>
          <address class="mb-6 rounded-r-lg border-l-4 border-joner-red bg-white/5 py-4 pl-5 pr-4 font-body text-base not-italic leading-relaxed text-white">
            {v.addressLine}
          </address>
          <ul class="mb-8 space-y-3">
            {c.venuePoints.map((p) => (
              <li class="flex items-start gap-3 font-body text-base leading-relaxed text-neutral-300">
                <span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-joner-red" aria-hidden="true"></span>
                <span>{p}</span>
              </li>
            ))}
          </ul>
          <div class="flex flex-wrap gap-3">
            <a href={v.maps} target="_blank" rel="noopener noreferrer" class="btn-outline text-sm">Directions</a>
            {c.extraLink && <a href={c.extraLink.href} class="btn-outline text-sm">{c.extraLink.label}</a>}
          </div>
        </div>
        <div class="min-w-0">
          <iframe
            src={`https://www.google.com/maps?q=${encodeURIComponent(v.addressLine)}&output=embed`}
            title={`Map of ${v.longName}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="block aspect-[4/3] w-full rounded-xl border border-white/10 bg-joner-gray"
          ></iframe>
        </div>
      </div>
    </section>

    <section id="nearby" class="scroll-mt-24 border-t border-white/10 py-12 md:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="mb-6 font-heading text-3xl font-bold uppercase leading-tight text-white md:text-4xl">Nearby suburbs</h2>
        <p class="mb-10 max-w-3xl font-body text-base leading-relaxed text-neutral-300">{c.nearbyLine} {v.nearby.slice(0, -1).join(', ')} and {v.nearby[v.nearby.length - 1]}.</p>
        <h2 class="mb-6 font-heading text-3xl font-bold uppercase leading-tight text-white md:text-4xl">Other JFP locations</h2>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
          {others.map((o) => (
            <a href={venuePath(o)} class="group flex min-w-0 flex-col rounded-xl border border-white/10 bg-white/[0.04] p-6 hover:border-white/30">
              <span class="mb-2 font-heading text-xs uppercase tracking-[0.22em] text-joner-red">{o.area}</span>
              <span class="mb-2 font-heading text-2xl uppercase leading-none text-white">{o.name}</span>
              <span class="font-body text-sm leading-relaxed text-neutral-400">{o.card}</span>
            </a>
          ))}
          <a href="/training/jfp-program/" class="group flex min-w-0 flex-col rounded-xl border border-white/10 bg-white/[0.04] p-6 hover:border-white/30">
            <span class="mb-2 font-heading text-xs uppercase tracking-[0.22em] text-joner-red">The program</span>
            <span class="mb-2 font-heading text-2xl uppercase leading-none text-white">About JFP</span>
            <span class="font-body text-sm leading-relaxed text-neutral-400">Terms, kit, trials and how to book.</span>
          </a>
        </div>
      </div>
    </section>

    <SEOFAQ eyebrow={`JFP at ${v.name}`} title="Common questions." items={c.faqs} />

    <section class="pb-16 md:pb-24">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <BookNowPanel
          eyebrow=""
          heading={`Train at ${v.name}`}
          place={`jfp-venue-${v.slug}-bottom`}
        />
      </div>
    </section>
  </main>
</BaseLayout>
