---
import BaseLayout from '../../layouts/BaseLayout.astro'
---

<BaseLayout title="Professional Training | Joner Football" description="Professional and elite football training enquiries with Joner Football in Sydney." canonical="/training/professional-training/" noindex={true}>
  <main class="bg-joner-black text-white pt-24">
    <section class="relative overflow-hidden min-h-[72vh] flex items-center">
      <img src="/images/training/pro-training.webp" alt="Professional football training at Joner Football" class="absolute inset-0 h-full w-full object-cover object-center opacity-45" />
      <div class="absolute inset-0 bg-gradient-to-r from-black via-black/70 to-black/30"></div>
      <div class="relative mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 py-24">
        <p class="font-heading text-sm uppercase tracking-[0.25em] text-joner-red mb-4">Training</p>
        <h1 class="font-heading text-6xl md:text-8xl uppercase leading-none mb-6">Professional Training</h1>
        <p class="max-w-2xl font-body text-xl text-gray-300 leading-relaxed mb-8">Private and elite-level training for professional players and serious footballers.</p>
        <a href="/contact?type=training-sydney" class="btn-red px-8 py-4">Enquire About Pro Training</a>
      </div>
    </section>
  </main>
</BaseLayout>
