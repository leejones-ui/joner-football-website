---
import BaseLayout from '../../layouts/BaseLayout.astro'

const playerImages = [
  { src: '/images/training/professional-showcase/player-1.webp', alt: 'Alanna Kennedy professional player showcase' },
  { src: '/images/training/professional-showcase/player-2.webp', alt: 'Alex Robertson professional player showcase' },
  { src: '/images/training/professional-showcase/player-3.webp', alt: 'Adam Le Fondre professional player showcase' },
  { src: '/images/training/professional-showcase/player-4.webp', alt: 'Adrian Segecic professional player showcase' },
  { src: '/images/training/professional-showcase/player-5.webp', alt: 'Izzy Gomez professional player showcase' },
  { src: '/images/training/professional-showcase/player-6.webp', alt: 'Brendan Hamill professional player showcase' },
  { src: '/images/training/professional-showcase/player-7.webp', alt: 'Professional player trained by Joner Football' },
  { src: '/images/training/professional-showcase/player-8.webp', alt: 'Elite player training with Joner Football' },
]

const zoomImages = [
  { src: '/images/training/professional-showcase/img-7717-action.webp', alt: 'Lee Jones coaching a professional player in an action session' },
  ...playerImages.slice(1, 7),
]

const videoFeatures = [
  {
    title: 'Pro player detail session',
    youtubeId: '6Lk7pztLhEw',
    url: 'https://www.youtube.com/watch?v=6Lk7pztLhEw&list=PLM3cVo2QYr-O4bEy1AE1ox9mROWf__T4u&index=2&t=3s',
    label: 'Watch session 01',
  },
  {
    title: 'Elite technical work',
    youtubeId: '_jem2d4dYUg',
    url: 'https://www.youtube.com/watch?v=_jem2d4dYUg',
    label: 'Watch session 02',
  },
  {
    title: 'Professional standards',
    youtubeId: 'WqPaRKQXlts',
    url: 'https://www.youtube.com/watch?v=WqPaRKQXlts',
    label: 'Watch session 03',
  },
  {
    title: 'Inside the training process',
    youtubeId: '0WyjwepmxW8',
    url: 'https://www.youtube.com/watch?v=0WyjwepmxW8&list=PLM3cVo2QYr-O4bEy1AE1ox9mROWf__T4u&index=2&t=3s',
    label: 'Watch session 04',
  },
]
---

<BaseLayout
  title="Professional Training | Joner Football"
  description="Joner Football professional training showcase. Lee Jones has worked with professional players across Australia and worldwide for over 10 years."
  canonical="/training/professional-training/"
>
  <main class="pro-page bg-joner-black text-white">
    <section class="pro-hero" aria-labelledby="pro-title">
      <div class="pro-hero__video" aria-hidden="true">
        <iframe
          src="https://www.youtube.com/embed/6Lk7pztLhEw?autoplay=1&mute=1&controls=0&loop=1&playlist=6Lk7pztLhEw&playsinline=1&rel=0&modestbranding=1&showinfo=0"
          title="Joner Football professional player training video"
          allow="autoplay; encrypted-media; picture-in-picture"
          tabindex="-1"
        ></iframe>
      </div>
      <div class="pro-hero__fallback" aria-hidden="true">
        <img src="/images/training/professional-showcase/img-7717-action.webp" alt="" loading="eager" />
      </div>
      <div class="pro-hero__shade"></div>
      <div class="pro-wrap pro-hero__content">
        <p class="pro-eyebrow">Professional player training</p>
        <h1 id="pro-title">Over 10 years with pros.</h1>
        <p class="pro-hero__lead">
          Lee Jones has worked with professional players across Australia and worldwide for over 10 years, helping serious footballers sharpen the details that decide games.
        </p>
        <div class="pro-hero__actions">
          <a href="#pro-contact" class="pro-glass pro-glass--red">Contact us<span></span></a>
          <a href="#player-carousel" class="pro-glass">See the players<span></span></a>
        </div>
      </div>
    </section>

    <section class="pro-player-wall" id="player-carousel">
      <div class="pro-wrap">
        <div class="pro-section-head">
          <p class="pro-eyebrow">Pro player carousel</p>
          <h2>The players. The sessions. The standard.</h2>
        </div>
      </div>
      <div class="pro-marquee" aria-label="Professional player image carousel">
        <div class="pro-marquee__track">
          {[...playerImages, ...playerImages].map((image) => (
            <figure class="pro-player-card">
              <img src={image.src} alt={image.alt} loading="lazy" />
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="zoom-parallax" data-zoom-parallax aria-label="Professional player image showcase">
      <div class="zoom-parallax__sticky">
        <div class="zoom-parallax__spotlight" aria-hidden="true"></div>
        <div class="zoom-parallax__copy" aria-hidden="true">
          <p class="pro-eyebrow">Scroll the wall</p>
          <h2>Players who trusted the detail.</h2>
        </div>
        {zoomImages.map((image, index) => (
          <div class:list={['zoom-parallax__layer', `zoom-parallax__layer--${index + 1}`]} data-zoom-layer data-scale={index === 0 ? '4' : index === 1 ? '5' : index === 2 ? '6' : index === 3 ? '5' : index === 4 ? '6' : index === 5 ? '8' : '9'}>
            <div class="zoom-parallax__frame">
              <img src={image.src} alt={image.alt} loading={index < 2 ? 'eager' : 'lazy'} />
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="pro-video-grid" aria-label="Professional training video showcase">
      <div class="pro-wrap">
        <div class="pro-section-head pro-section-head--light">
          <p class="pro-eyebrow">Watch the work</p>
          <h2>Video proof inside the process.</h2>
          <p>These are easy to tap now. No broken scroll stack, just clear videos that open the full session.</p>
        </div>
        <div class="pro-video-grid__cards">
          {videoFeatures.map((video) => (
            <a class="pro-video-card" href={video.url} target="_blank" rel="noopener noreferrer">
              <img src={`https://img.youtube.com/vi/${video.youtubeId}/maxresdefault.jpg`} alt={`${video.title} YouTube thumbnail`} loading="lazy" />
              <div class="pro-video-card__shade"></div>
              <div class="pro-video-card__content">
                <span>Play video</span>
                <h3>{video.title}</h3>
                <p>{video.label}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="pro-contact" id="pro-contact">
      <div class="pro-wrap pro-contact__grid">
        <div class="pro-contact__copy">
          <p class="pro-eyebrow">Contact us</p>
          <h2>Enquire about pro training.</h2>
          <p>
            Tell us the player level, age, position, and what needs fixing. If it is the right fit, we will point you to the best next step.
          </p>
        </div>
        <form id="pro-contact-form" class="pro-contact__form">
          <input type="hidden" name="enquiryType" value="training-sydney" />
          <div class="pro-form-grid">
            <input type="text" name="name" placeholder="Full name" required />
            <input type="email" name="email" placeholder="Email address" required />
          </div>
          <div class="pro-form-grid">
            <input type="tel" name="phone" placeholder="Phone number" required />
            <input type="text" name="location" placeholder="Location" />
          </div>
          <div class="pro-form-grid">
            <input type="text" name="playerName" placeholder="Player name" />
            <input type="text" name="playerAge" placeholder="Player age" />
          </div>
          <div class="pro-form-grid">
            <input type="text" name="playerLevel" placeholder="Player level or team" />
            <input type="text" name="position" placeholder="Position" />
          </div>
          <textarea name="message" placeholder="What does the player need help with?" required rows="5"></textarea>
          <label class="pro-check">
            <input type="checkbox" name="marketingOptIn" value="true" />
            <span>Yes, send me Joner Football updates, app news, camps, and training tips by email.</span>
          </label>
          <p id="pro-contact-status" class="pro-contact__status" hidden></p>
          <button type="submit" class="pro-glass pro-glass--red">Send enquiry<span></span></button>
        </form>
      </div>
    </section>
  </main>

  <style>
    :global(html) { scroll-behavior: smooth; }
    .pro-page {
      --pro-red: #E30613;
      --pro-black: #0A0A0A;
      --pro-display: Anton, Impact, sans-serif;
      --pro-body: 'DM Sans', system-ui, sans-serif;
      overflow-x: clip;
    }
    .pro-wrap { width: min(1120px, calc(100% - 32px)); margin: 0 auto; }
    .pro-eyebrow {
      margin: 0;
      font-family: var(--pro-display);
      color: var(--pro-red);
      font-size: 0.8rem;
      letter-spacing: 0.24em;
      text-transform: uppercase;
    }
    .pro-hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: flex-end;
      overflow: hidden;
      padding: 128px 0 72px;
      isolation: isolate;
      background: #050505;
    }
    .pro-hero__video, .pro-hero__fallback, .pro-hero__shade { position: absolute; inset: 0; }
    .pro-hero__video { z-index: 0; pointer-events: none; overflow: hidden; }
    .pro-hero__video iframe {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 177.78vh;
      height: 100vh;
      min-width: 100vw;
      min-height: 56.25vw;
      transform: translate(-50%, -50%) scale(1.16);
      border: 0;
    }
    .pro-hero__fallback { z-index: -1; }
    .pro-hero__fallback img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
    .pro-hero__shade { background: radial-gradient(circle at 72% 28%, rgba(227,6,19,0.22), transparent 30%), linear-gradient(90deg, rgba(0,0,0,0.94) 0%, rgba(0,0,0,0.74) 42%, rgba(0,0,0,0.18) 100%), linear-gradient(180deg, rgba(0,0,0,0.08), rgba(0,0,0,0.86)); z-index: 1; }
    .pro-hero__content { position: relative; z-index: 2; }
    .pro-hero h1, .pro-section-head h2, .pro-contact h2, .zoom-parallax__copy h2 {
      font-family: var(--pro-display);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      line-height: 0.9;
    }
    .pro-hero h1 { max-width: 980px; margin: 18px 0 0; font-size: clamp(4rem, 12vw, 10.5rem); }
    .pro-hero__lead { max-width: 680px; margin: 24px 0 0; color: rgba(255,255,255,0.86); font-size: clamp(1.05rem, 2vw, 1.34rem); line-height: 1.6; }
    .pro-hero__actions { margin-top: 34px; display: flex; flex-wrap: wrap; gap: 14px; }
    .pro-glass {
      min-height: 52px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
      border-radius: 999px;
      padding: 17px 28px 15px;
      border: 1px solid rgba(255,255,255,.32);
      color: #fff;
      text-decoration: none;
      background: linear-gradient(135deg, rgba(255,255,255,.16), rgba(255,255,255,.035)), rgba(5,5,5,.66);
      box-shadow: 0 18px 40px rgba(0,0,0,.38), inset 0 1px 0 rgba(255,255,255,.22);
      font-family: var(--pro-display);
      text-transform: uppercase;
      letter-spacing: .14em;
      font-size: 14px;
      transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
      cursor: pointer;
    }
    .pro-glass:hover { transform: translateY(-2px); border-color: rgba(255,255,255,.58); box-shadow: 0 22px 46px rgba(0,0,0,.46), inset 0 1px 0 rgba(255,255,255,.28); }
    .pro-glass--red { border-color: rgba(227,6,19,.74); }
    .pro-glass span { display: none; }

    .pro-player-wall { padding: 92px 0 100px; background: #fff; color: #050505; overflow: hidden; }
    .pro-section-head { max-width: 820px; margin-bottom: 34px; }
    .pro-section-head h2 { margin: 14px 0 0; font-size: clamp(2.7rem, 7vw, 6rem); }
    .pro-section-head p:not(.pro-eyebrow) { max-width: 620px; margin: 16px 0 0; color: rgba(255,255,255,0.72); line-height: 1.7; }
    .pro-section-head--light { color: #fff; }
    .pro-marquee { width: 100%; overflow: hidden; }
    .pro-marquee__track { width: max-content; display: flex; gap: 18px; animation: pro-marquee 44s linear infinite; }
    .pro-marquee:hover .pro-marquee__track { animation-play-state: paused; }
    .pro-player-card { width: min(280px, 68vw); aspect-ratio: 4 / 5; margin: 0; overflow: hidden; background: #111; box-shadow: 0 24px 60px rgba(0,0,0,0.16); }
    .pro-player-card img { width: 100%; height: 100%; object-fit: cover; }
    @keyframes pro-marquee { from { transform: translateX(0); } to { transform: translateX(calc(-50% - 9px)); } }

    .zoom-parallax { position: relative; height: 320vh; background: #050505; }
    .zoom-parallax__sticky { position: sticky; top: 0; height: 100vh; overflow: hidden; }
    .zoom-parallax__spotlight { position: absolute; top: -42vmin; left: 50%; width: 120vmin; height: 120vmin; transform: translateX(-50%); border-radius: 999px; background: radial-gradient(ellipse at center, rgba(255,255,255,0.12), rgba(227,6,19,0.1) 24%, transparent 55%); filter: blur(30px); pointer-events: none; }
    .zoom-parallax__copy { position: absolute; z-index: 10; left: 50%; top: 50%; width: min(760px, 88vw); transform: translate(-50%, -50%); text-align: center; pointer-events: none; }
    .zoom-parallax__copy::before { content: ''; position: absolute; inset: -42px -54px; z-index: -1; background: radial-gradient(circle, rgba(0,0,0,0.72), rgba(0,0,0,0.42) 42%, transparent 70%); filter: blur(8px); }
    .zoom-parallax__copy h2 { margin: 12px 0 0; font-size: clamp(2.8rem, 8vw, 7.2rem); text-shadow: 0 8px 28px rgba(0,0,0,0.95), 0 2px 4px rgba(0,0,0,0.9); }
    .zoom-parallax__layer { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; will-change: transform; }
    .zoom-parallax__frame { position: relative; width: 30vw; height: 34vh; overflow: hidden; box-shadow: 0 30px 90px rgba(0,0,0,0.55); border: 1px solid rgba(255,255,255,0.14); background: #111; }
    .zoom-parallax__frame img { width: 100%; height: 100%; object-fit: cover; }
    .zoom-parallax__layer--1 .zoom-parallax__frame { width: 42vw; height: 34vh; }
    .zoom-parallax__layer--2 .zoom-parallax__frame { top: -30vh; left: 5vw; width: 27vw; height: 34vh; }
    .zoom-parallax__layer--3 .zoom-parallax__frame { top: -10vh; left: -25vw; width: 21vw; height: 42vh; }
    .zoom-parallax__layer--4 .zoom-parallax__frame { left: 27.5vw; width: 23vw; height: 30vh; }
    .zoom-parallax__layer--5 .zoom-parallax__frame { top: 27.5vh; left: 5vw; width: 22vw; height: 30vh; }
    .zoom-parallax__layer--6 .zoom-parallax__frame { top: 27.5vh; left: -22.5vw; width: 25vw; height: 32vh; }
    .zoom-parallax__layer--7 .zoom-parallax__frame { top: 22.5vh; left: 25vw; width: 16vw; height: 22vh; }

    .pro-video-grid { padding: 96px 0; background: radial-gradient(circle at 74% 22%, rgba(227,6,19,0.18), transparent 24%), #060606; }
    .pro-video-grid__cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
    .pro-video-card { position: relative; min-height: 330px; display: block; overflow: hidden; border: 1px solid rgba(255,255,255,0.16); background: #111; text-decoration: none; color: #fff; box-shadow: 0 30px 90px rgba(0,0,0,0.32); }
    .pro-video-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
    .pro-video-card:hover img { transform: scale(1.04); }
    .pro-video-card__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0.04), rgba(0,0,0,0.8)); }
    .pro-video-card__content { position: absolute; left: 24px; right: 24px; bottom: 24px; }
    .pro-video-card__content span { display: inline-flex; margin-bottom: 12px; border: 1px solid rgba(255,255,255,0.28); border-radius: 999px; padding: 8px 12px; font-family: var(--pro-display); letter-spacing: 0.12em; text-transform: uppercase; font-size: 0.72rem; background: rgba(227,6,19,0.86); }
    .pro-video-card__content h3 { margin: 0; font-family: var(--pro-display); text-transform: uppercase; letter-spacing: 0.05em; font-size: clamp(2rem, 4vw, 3.6rem); line-height: 0.92; }
    .pro-video-card__content p { margin: 8px 0 0; color: rgba(255,255,255,0.74); text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.78rem; }

    .pro-contact { padding: 96px 0; background: #fff; color: #050505; }
    .pro-contact__grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 48px; align-items: start; }
    .pro-contact h2 { margin: 14px 0 0; font-size: clamp(2.8rem, 6vw, 5.6rem); }
    .pro-contact__copy p:not(.pro-eyebrow) { margin: 20px 0 0; color: rgba(0,0,0,0.66); line-height: 1.7; }
    .pro-contact__form { display: grid; gap: 14px; padding: 22px; background: #090909; color: #fff; box-shadow: 0 28px 80px rgba(0,0,0,0.18); }
    .pro-form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .pro-contact__form input, .pro-contact__form textarea { width: 100%; border: 1px solid rgba(255,255,255,0.14); background: rgba(255,255,255,0.06); color: #fff; padding: 15px 16px; min-height: 52px; font-family: var(--pro-body); outline: none; }
    .pro-contact__form textarea { resize: vertical; }
    .pro-contact__form input:focus, .pro-contact__form textarea:focus { border-color: rgba(227,6,19,0.8); }
    .pro-contact__form input::placeholder, .pro-contact__form textarea::placeholder { color: rgba(255,255,255,0.48); }
    .pro-check { display: flex; gap: 12px; color: rgba(255,255,255,0.72); font-size: 0.9rem; line-height: 1.5; }
    .pro-check input { width: 16px; min-height: 16px; margin-top: 2px; accent-color: var(--pro-red); }
    .pro-contact__status { margin: 0; color: #fff; }
    .pro-contact__form button { width: 100%; }

    @media (max-width: 900px) {
      .pro-video-grid__cards, .pro-contact__grid { grid-template-columns: 1fr; }
      .zoom-parallax__frame { width: 42vw; }
    }
    @media (max-width: 640px) {
      .pro-hero { min-height: 92vh; padding: 110px 0 48px; }
      .pro-hero h1 { font-size: clamp(3.4rem, 18vw, 5.2rem); }
      .pro-hero__actions, .pro-glass { width: 100%; }
      .pro-player-wall, .pro-video-grid, .pro-contact { padding: 64px 0; }
      .zoom-parallax { height: 240vh; }
      .zoom-parallax__frame, .zoom-parallax__layer--1 .zoom-parallax__frame { width: 58vw; height: 30vh; }
      .zoom-parallax__layer--2 .zoom-parallax__frame { width: 54vw; }
      .zoom-parallax__layer--3 .zoom-parallax__frame { left: -18vw; width: 34vw; }
      .zoom-parallax__layer--4 .zoom-parallax__frame { left: 20vw; width: 38vw; }
      .zoom-parallax__layer--5 .zoom-parallax__frame { width: 34vw; }
      .zoom-parallax__layer--6 .zoom-parallax__frame { left: -16vw; width: 44vw; }
      .zoom-parallax__layer--7 .zoom-parallax__frame { left: 20vw; width: 26vw; height: 18vh; }
      .pro-player-card { width: 220px; }
      .pro-video-card { min-height: 260px; }
      .pro-form-grid { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) {
      .pro-marquee__track { animation: none; flex-wrap: wrap; width: auto; justify-content: center; }
      .zoom-parallax { height: auto; }
      .zoom-parallax__sticky { position: relative; height: auto; display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; padding: 64px 16px; }
      .zoom-parallax__copy { position: relative; left: auto; top: auto; transform: none; grid-column: 1 / -1; margin: 0 auto 18px; }
      .zoom-parallax__layer { position: relative; inset: auto; transform: none !important; }
      .zoom-parallax__frame, .zoom-parallax__layer--1 .zoom-parallax__frame, .zoom-parallax__layer--2 .zoom-parallax__frame, .zoom-parallax__layer--3 .zoom-parallax__frame, .zoom-parallax__layer--4 .zoom-parallax__frame, .zoom-parallax__layer--5 .zoom-parallax__frame, .zoom-parallax__layer--6 .zoom-parallax__frame, .zoom-parallax__layer--7 .zoom-parallax__frame { top: auto; left: auto; width: 100%; height: 260px; }
    }
  </style>

  <script>
    const parallax = document.querySelector('[data-zoom-parallax]')
    const layers = Array.from(document.querySelectorAll('[data-zoom-layer]'))

    function clamp(value, min, max) {
      return Math.min(Math.max(value, min), max)
    }

    function updateZoomParallax() {
      if (!parallax || !layers.length) return
      const rect = parallax.getBoundingClientRect()
      const scrollable = rect.height - window.innerHeight
      const progress = scrollable > 0 ? clamp(-rect.top / scrollable, 0, 1) : 0

      layers.forEach((layer) => {
        const targetScale = Number(layer.getAttribute('data-scale') || '4')
        const scale = 1 + ((targetScale - 1) * progress)
        layer.style.transform = `scale(${scale})`
      })
    }

    let ticking = false
    function requestUpdate() {
      if (ticking) return
      ticking = true
      requestAnimationFrame(() => {
        updateZoomParallax()
        ticking = false
      })
    }

    updateZoomParallax()
    window.addEventListener('scroll', requestUpdate, { passive: true })
    window.addEventListener('resize', requestUpdate)

    const form = document.getElementById('pro-contact-form')
    const status = document.getElementById('pro-contact-status')
    if (form) {
      form.addEventListener('submit', function (event) {
        event.preventDefault()
        const submit = form.querySelector('button[type="submit"]')
        const originalText = submit ? submit.textContent : 'Send enquiry'
        const formData = new FormData(form)
        const payload = {}
        formData.forEach(function (value, key) { payload[key] = value })
        payload.trainingInterest = 'Private professional training'
        payload.marketingOptIn = formData.get('marketingOptIn') === 'true'

        if (status) {
          status.hidden = true
          status.textContent = ''
        }
        if (submit) {
          submit.disabled = true
          submit.textContent = 'Sending...'
        }

        fetch('/api/contact-enquiry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        })
          .then(function (response) { return response.json() })
          .then(function (data) {
            if (!data || !data.success) throw new Error((data && data.error) || 'Could not send enquiry.')
            form.reset()
            if (status) {
              status.hidden = false
              status.style.color = '#4ade80'
              status.textContent = 'Done. Your enquiry has been sent.'
            }
          })
          .catch(function (error) {
            if (status) {
              status.hidden = false
              status.style.color = '#fbbf24'
              status.textContent = error && error.message ? error.message : 'Could not send enquiry. Please try again.'
            }
          })
          .finally(function () {
            if (submit) {
              submit.disabled = false
              submit.textContent = originalText
            }
          })
      })
    }
  </script>
</BaseLayout>
