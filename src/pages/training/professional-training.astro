---
import BaseLayout from '../../layouts/BaseLayout.astro'

const playerImages = [
  { src: '/images/training/professional-showcase/player-1.webp', alt: 'Alanna Kennedy professional player showcase' },
  { src: '/images/training/professional-showcase/player-2.webp', alt: 'Alex Robertson professional player showcase' },
  { src: '/images/training/professional-showcase/player-3.webp', alt: 'Adam Le Fondre professional player showcase' },
  { src: '/images/training/professional-showcase/player-4.webp', alt: 'Adrian Segecic professional player showcase' },
  { src: '/images/training/professional-showcase/player-5.webp', alt: 'Izzy Gomez professional player showcase' },
  { src: '/images/training/professional-showcase/player-6.webp', alt: 'Brendan Hamill professional player showcase' },
  { src: '/images/training/professional-showcase/player-7.webp', alt: 'Professional player trained by Joner Football' },
  { src: '/images/training/professional-showcase/player-8.webp', alt: 'Elite player training with Joner Football' },
]

const zoomImages = [
  { src: '/images/training/professional-showcase/img-7717-action.webp', alt: 'Lee Jones coaching a professional player in an action session' },
  ...playerImages.slice(1, 7),
]

const videoFeatures = [
  {
    title: 'Pro player detail session',
    youtubeId: '6Lk7pztLhEw',
    url: 'https://www.youtube.com/watch?v=6Lk7pztLhEw&list=PLM3cVo2QYr-O4bEy1AE1ox9mROWf__T4u&index=2&t=3s',
    label: 'Watch session 01',
  },
  {
    title: 'Elite technical work',
    youtubeId: '_jem2d4dYUg',
    url: 'https://www.youtube.com/watch?v=_jem2d4dYUg',
    label: 'Watch session 02',
  },
  {
    title: 'Professional standards',
    youtubeId: 'WqPaRKQXlts',
    url: 'https://www.youtube.com/watch?v=WqPaRKQXlts',
    label: 'Watch session 03',
  },
  {
    title: 'Inside the training process',
    youtubeId: '0WyjwepmxW8',
    url: 'https://www.youtube.com/watch?v=0WyjwepmxW8&list=PLM3cVo2QYr-O4bEy1AE1ox9mROWf__T4u&index=2&t=3s',
    label: 'Watch session 04',
  },
]

import SanityPageRenderer from '../../components/sanity/SanityPageRenderer.astro'
import { fetchSanityPage } from '../../lib/sanityPages'
import { shouldReplaceSanityPage } from '../../lib/sanityPageUtils'

const sanityPage = await fetchSanityPage('professional-training')
---

{shouldReplaceSanityPage(sanityPage) ? (
  <SanityPageRenderer page={sanityPage} />
) : (
<BaseLayout
  title="Professional Training | Joner Football"
  description="Joner Football professional training showcase. Lee Jones has worked with professional players across Australia and worldwide for over 10 years."
  canonical="/training/professional-training/"
>
  <main class="pro-page bg-joner-black text-white">
    <section class="pro-hero" aria-labelledby="pro-title">
      <div class="pro-hero__video" aria-hidden="true">
        <iframe
          src="https://www.youtube.com/embed/6Lk7pztLhEw?autoplay=1&mute=1&controls=0&loop=1&playlist=6Lk7pztLhEw&playsinline=1&rel=0&modestbranding=1&showinfo=0"
          title="Joner Football professional player training video"
          allow="autoplay; encrypted-media; picture-in-picture"
          tabindex="-1"
        ></iframe>
      </div>
      <div class="pro-hero__fallback" aria-hidden="true">
        <img src="/images/training/professional-showcase/img-7717-action.webp" alt="" loading="eager" />
      </div>
      <div class="pro-hero__shade"></div>
      <div class="pro-wrap pro-hero__content">
        <p class="pro-eyebrow">Professional player training</p>
        <h1 id="pro-title">Over 10 years with pros.</h1>
        <p class="pro-hero__lead">
          Lee Jones has worked with professional players across Australia and worldwide for over 10 years, helping serious footballers sharpen the details that decide games.
        </p>
        <div class="pro-hero__actions">
          <a href="#pro-contact" class="pro-glass pro-glass--red">Contact us<span></span></a>
          <a href="#player-carousel" class="pro-glass">See the players<span></span></a>
        </div>
      </div>
    </section>

    <section class="pro-player-wall" id="player-carousel">
      <div class="pro-wrap">
        <div class="pro-section-head">
          <p class="pro-eyebrow">Pro player carousel</p>
          <h2>The players, sessions, and standard.</h2>
        </div>
      </div>
      <div class="pro-marquee" aria-label="Professional player image carousel">
        <div class="pro-marquee__track">
          {[...playerImages, ...playerImages].map((image) => (
            <figure class="pro-player-card">
              <img src={image.src} alt={image.alt} loading="lazy" />
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="zoom-parallax" data-zoom-parallax aria-label="Professional player image showcase">
      <div class="zoom-parallax__sticky">
        <div class="zoom-parallax__spotlight" aria-hidden="true"></div>
        <div class="zoom-parallax__copy" aria-hidden="true">
          <p class="pro-eyebrow">Scroll the wall</p>
          <h2>Players who trusted the detail.</h2>
        </div>
        {zoomImages.map((image, index) => (
          <div class:list={['zoom-parallax__layer', `zoom-parallax__layer--${index + 1}`]} data-zoom-layer data-scale={index === 0 ? '2' : index === 1 ? '5' : index === 2 ? '6' : index === 3 ? '5' : index === 4 ? '6' : index === 5 ? '8' : '9'}>
            <div class="zoom-parallax__frame">
              <img src={image.src} alt={image.alt} loading={index < 2 ? 'eager' : 'lazy'} />
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="pro-video-grid" aria-label="Professional training video showcase">
      <div class="pro-wrap">
        <div class="pro-video-banner">
          <span>Watch the work: pro training videos</span>
        </div>
        <div class="pro-video-grid__cards">
          {videoFeatures.map((video) => (
            <a class="pro-video-card" href={video.url} target="_blank" rel="noopener noreferrer">
              <img src={`https://img.youtube.com/vi/${video.youtubeId}/maxresdefault.jpg`} alt={`${video.title} YouTube thumbnail`} loading="lazy" />
              <div class="pro-video-card__shade"></div>
              <div class="pro-video-card__play">Play video</div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="pro-contact" id="pro-contact">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <div class="mb-8 text-center">
          <p class="pro-eyebrow">Contact us</p>
          <h2>Enquire about pro training.</h2>
          <p class="mx-auto mt-4 max-w-2xl font-body text-base leading-relaxed text-gray-400 md:text-lg">
            Same form as the contact page. Choose training enquiries and tell us about the player.
          </p>
        </div>

        <form id="contact-smart-form" class="space-y-5 border border-gray-800 bg-joner-gray p-5 md:p-8">
          <div>
            <label for="enquiryType" class="mb-2 block font-heading text-xs uppercase tracking-[0.22em] text-gray-400">What can we help with?</label>
            <select id="enquiryType" name="enquiryType" required class="min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white focus:border-joner-red focus:outline-none">
              <option value="training-sydney" selected>Training Enquiries (Sydney)</option>
              <option value="general">General Enquiries</option>
              <option value="joners-juniors">Joners Juniors Enquiries</option>
              <option value="coaching-role">Apply For A Coaching Role</option>
            </select>
            <p id="form-intro" class="mt-3 font-body text-sm text-gray-400">Tell us about the player and what type of training you are looking for.</p>
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <input data-name-field type="text" name="name" placeholder="Full name" required class="min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
            <input type="email" name="email" placeholder="Email address" required class="min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <input type="tel" name="phone" placeholder="Phone number" required class="min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
            <input data-location-field="default" type="text" name="location" placeholder="Location" class="min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
            <select data-location-field="training" name="trainingLocation" class="hidden min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white focus:border-joner-red focus:outline-none" disabled>
              <option value="">Preferred Sydney location</option>
              <option>HQ (Belrose)</option>
              <option>North Turramurra</option>
              <option>Rydalmere Park</option>
              <option>Other</option>
            </select>
          </div>

          <div data-fields="training-sydney joners-juniors" class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <input type="text" name="playerName" placeholder="Player name" class="conditional-required min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
            <input data-player-age-field type="text" name="playerAge" placeholder="Player age" class="conditional-required min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
          </div>

          <div data-fields="training-sydney" class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <input type="text" name="playerLevel" placeholder="Player level or team" class="min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
            <select name="trainingInterest" class="min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white focus:border-joner-red focus:outline-none">
              <option value="">Training interest</option>
              <option>Joner Football Performance</option>
              <option>Private professional training</option>
              <option>Private training</option>
              <option>Group training</option>
              <option>Game analysis</option>
              <option>Not sure yet</option>
            </select>
          </div>

          <div data-fields="joners-juniors" class="grid grid-cols-1 gap-4 sm:grid-cols-2 hidden">
            <select name="juniorProgram" class="min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white focus:border-joner-red focus:outline-none">
              <option value="">Program interest</option>
              <option>Joner 6-8 Year Old Program</option>
              <option>Joner Football Performance pathway</option>
              <option>Not sure yet</option>
            </select>
            <input type="text" name="parentGoal" placeholder="Main goal for the player" class="min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
          </div>

          <div data-fields="coaching-role" class="grid grid-cols-1 gap-4 sm:grid-cols-2 hidden">
            <input type="text" name="coachingExperience" placeholder="Coaching experience" class="conditional-required min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
            <input type="text" name="qualifications" placeholder="Qualifications" class="conditional-required min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
          </div>

          <div data-fields="coaching-role" class="hidden">
            <input type="text" name="availability" placeholder="Availability" class="min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
          </div>

          <div data-fields="coaching-role" class="hidden">
            <label for="cvFile" class="mb-2 block font-heading text-xs uppercase tracking-[0.22em] text-gray-400">Attach CV</label>
            <input id="cvFile" type="file" name="cvFile" accept=".pdf,.doc,.docx,.pages" class="block w-full cursor-pointer border border-dashed border-gray-700 bg-joner-black px-4 py-4 font-body text-sm text-gray-300 file:mr-4 file:border-0 file:bg-joner-red file:px-4 file:py-2 file:font-heading file:text-xs file:uppercase file:tracking-[0.16em] file:text-white hover:border-joner-red focus:border-joner-red focus:outline-none" />
            <p class="mt-2 font-body text-xs text-gray-500">PDF, Word, or Pages file. Max 5MB.</p>
          </div>

          <textarea name="message" placeholder="Message" required rows="5" class="w-full resize-none border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none"></textarea>

          <label class="flex gap-3 border border-gray-800 bg-joner-black/60 p-4 font-body text-sm leading-relaxed text-gray-300">
            <input type="checkbox" name="marketingOptIn" value="true" class="mt-1 h-4 w-4 shrink-0 accent-joner-red" />
            <span>Yes, send me Joner Football updates, offers, app news, camps, and training tips by email.</span>
          </label>

          <p id="contact-form-status" class="hidden font-body text-sm"></p>
          <button type="submit" class="btn-red w-full text-sm">Send Training Enquiry</button>
        </form>
      </div>
    </section>
  </main>

  <style>
    :global(html) { scroll-behavior: smooth; }
    .pro-page {
      --pro-red: #E30613;
      --pro-black: #0A0A0A;
      --pro-display: Anton, Impact, sans-serif;
      --pro-body: 'DM Sans', system-ui, sans-serif;
      overflow-x: clip;
    }
    .pro-wrap { width: min(1120px, calc(100% - 32px)); margin: 0 auto; }
    .pro-eyebrow {
      margin: 0;
      font-family: var(--pro-display);
      color: var(--pro-red);
      font-size: 0.8rem;
      letter-spacing: 0.24em;
      text-transform: uppercase;
    }
    .pro-hero {
      position: relative;
      min-height: 100dvh;
      display: flex;
      align-items: center;
      overflow: hidden;
      padding: 128px 0 56px;
      isolation: isolate;
      background: #050505;
    }
    .pro-hero__video, .pro-hero__fallback, .pro-hero__shade { position: absolute; inset: 0; }
    .pro-hero__video { z-index: 0; pointer-events: none; overflow: hidden; }
    .pro-hero__video iframe {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 177.78vh;
      height: 100vh;
      min-width: 100vw;
      min-height: 56.25vw;
      transform: translate(-50%, -50%) scale(1.16);
      border: 0;
      filter: brightness(1.28) contrast(1.12) saturate(1.12);
    }
    .pro-hero__fallback { z-index: -1; }
    .pro-hero__fallback img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
    .pro-hero__shade { background: radial-gradient(circle at 72% 28%, rgba(227,6,19,0.2), transparent 30%), linear-gradient(90deg, rgba(0,0,0,0.78) 0%, rgba(0,0,0,0.5) 42%, rgba(0,0,0,0.06) 100%), linear-gradient(180deg, rgba(0,0,0,0.0), rgba(0,0,0,0.58)); z-index: 1; }
    .pro-hero__content { position: relative; z-index: 2; }
    .pro-hero h1, .pro-section-head h2, .pro-contact h2, .zoom-parallax__copy h2 {
      font-family: var(--pro-display);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      line-height: 0.9;
    }
    .pro-hero h1 { max-width: 760px; margin: 16px 0 0; font-size: clamp(3.1rem, 7.2vw, 6.7rem); }
    .pro-hero__lead { max-width: 620px; margin: 20px 0 0; color: rgba(255,255,255,0.86); font-size: clamp(1rem, 1.45vw, 1.16rem); line-height: 1.6; }
    .pro-hero__actions { margin-top: 34px; display: flex; flex-wrap: wrap; gap: 14px; }
    .pro-glass {
      min-height: 52px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
      border-radius: 999px;
      padding: 17px 28px 15px;
      border: 1px solid rgba(255,255,255,.32);
      color: #fff;
      text-decoration: none;
      background: linear-gradient(135deg, rgba(255,255,255,.16), rgba(255,255,255,.035)), rgba(5,5,5,.66);
      box-shadow: 0 18px 40px rgba(0,0,0,.38), inset 0 1px 0 rgba(255,255,255,.22);
      font-family: var(--pro-display);
      text-transform: uppercase;
      letter-spacing: .14em;
      font-size: 14px;
      transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
      cursor: pointer;
    }
    .pro-glass:hover { transform: translateY(-2px); border-color: rgba(255,255,255,.58); box-shadow: 0 22px 46px rgba(0,0,0,.46), inset 0 1px 0 rgba(255,255,255,.28); }
    .pro-glass--red { border-color: rgba(227,6,19,.74); }
    .pro-glass span { display: none; }

    .pro-player-wall { padding: 58px 0 80px; background: #fff; color: #050505; overflow: hidden; }
    .pro-section-head { max-width: none; margin-bottom: 28px; }
    .pro-section-head h2 { margin: 12px 0 0; font-size: clamp(2.1rem, 5.1vw, 4.6rem); white-space: nowrap; }
    .pro-section-head p:not(.pro-eyebrow) { max-width: 620px; margin: 16px 0 0; color: rgba(255,255,255,0.72); line-height: 1.7; }
    .pro-section-head--light { color: #fff; }
    .pro-marquee { width: 100%; overflow: hidden; }
    .pro-marquee__track { width: max-content; display: flex; gap: 18px; animation: pro-marquee 44s linear infinite; }
    .pro-marquee:hover .pro-marquee__track { animation-play-state: paused; }
    .pro-player-card { width: min(280px, 68vw); aspect-ratio: 4 / 5; margin: 0; overflow: hidden; background: #111; box-shadow: 0 24px 60px rgba(0,0,0,0.16); }
    .pro-player-card img { width: 100%; height: 100%; object-fit: cover; }
    @keyframes pro-marquee { from { transform: translateX(0); } to { transform: translateX(calc(-50% - 9px)); } }

    .zoom-parallax { position: relative; height: 320vh; background: #050505; }
    .zoom-parallax__sticky { position: sticky; top: 0; height: 100dvh; overflow: hidden; }
    .zoom-parallax__spotlight { position: absolute; top: -42vmin; left: 50%; width: 120vmin; height: 120vmin; transform: translateX(-50%); border-radius: 999px; background: radial-gradient(ellipse at center, rgba(255,255,255,0.12), rgba(227,6,19,0.1) 24%, transparent 55%); filter: blur(30px); pointer-events: none; }
    .zoom-parallax__copy { position: absolute; z-index: 10; left: 50%; top: 50%; width: min(760px, 88vw); transform: translate(-50%, -50%); text-align: center; pointer-events: none; }
    .zoom-parallax__copy::before { content: ''; position: absolute; inset: -42px -54px; z-index: -1; background: radial-gradient(circle, rgba(0,0,0,0.72), rgba(0,0,0,0.42) 42%, transparent 70%); filter: blur(8px); }
    .zoom-parallax__copy h2 { margin: 12px 0 0; font-size: clamp(2.3rem, 6vw, 5.8rem); text-shadow: 0 8px 28px rgba(0,0,0,0.95), 0 2px 4px rgba(0,0,0,0.9); }
    .zoom-parallax__layer { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; will-change: transform; }
    .zoom-parallax__frame { position: relative; width: 30vw; height: 34vh; overflow: hidden; box-shadow: 0 30px 90px rgba(0,0,0,0.55); border: 1px solid rgba(255,255,255,0.14); background: #111; }
    .zoom-parallax__frame img { width: 100%; height: 100%; object-fit: cover; }
    .zoom-parallax__layer--1 .zoom-parallax__frame img { object-position: center 44%; }
    .zoom-parallax__layer--1 .zoom-parallax__frame { width: min(92vw, 1320px); height: min(72vh, 760px); }
    .zoom-parallax__layer--2 .zoom-parallax__frame { top: -30vh; left: 5vw; width: 27vw; height: 34vh; }
    .zoom-parallax__layer--3 .zoom-parallax__frame { top: -10vh; left: -25vw; width: 21vw; height: 42vh; }
    .zoom-parallax__layer--4 .zoom-parallax__frame { left: 27.5vw; width: 23vw; height: 30vh; }
    .zoom-parallax__layer--5 .zoom-parallax__frame { top: 27.5vh; left: 5vw; width: 22vw; height: 30vh; }
    .zoom-parallax__layer--6 .zoom-parallax__frame { top: 27.5vh; left: -22.5vw; width: 25vw; height: 32vh; }
    .zoom-parallax__layer--7 .zoom-parallax__frame { top: 22.5vh; left: 25vw; width: 16vw; height: 22vh; }

    .pro-video-grid { padding: 78px 0 92px; background: radial-gradient(circle at 74% 22%, rgba(227,6,19,0.18), transparent 24%), #060606; }
    .pro-video-banner { display: inline-flex; margin-bottom: 22px; border: 1px solid rgba(255,255,255,0.14); border-radius: 999px; padding: 10px 16px; background: rgba(255,255,255,0.06); color: #fff; font-family: var(--pro-display); text-transform: uppercase; letter-spacing: 0.18em; font-size: 0.82rem; }
    .pro-video-grid__cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
    .pro-video-card { position: relative; min-height: 330px; display: block; overflow: hidden; border: 1px solid rgba(255,255,255,0.16); background: #111; text-decoration: none; color: #fff; box-shadow: 0 30px 90px rgba(0,0,0,0.32); }
    .pro-video-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
    .pro-video-card:hover img { transform: scale(1.04); }
    .pro-video-card__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0.0), rgba(0,0,0,0.18)); pointer-events: none; }
    .pro-video-card__play { position: absolute; left: 18px; top: 18px; display: inline-flex; border: 1px solid rgba(255,255,255,0.28); border-radius: 999px; padding: 8px 12px; font-family: var(--pro-display); letter-spacing: 0.12em; text-transform: uppercase; font-size: 0.72rem; background: rgba(227,6,19,0.9); color: #fff; box-shadow: 0 12px 28px rgba(0,0,0,0.22); }

    .pro-contact { padding: 82px 0 96px; background: #050505; color: #fff; }
    .pro-contact__grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 48px; align-items: start; }
    .pro-contact h2 { margin: 14px 0 0; font-size: clamp(2.8rem, 6vw, 5.6rem); }
    .pro-contact__copy p:not(.pro-eyebrow) { margin: 20px 0 0; color: rgba(0,0,0,0.66); line-height: 1.7; }
    .pro-contact__form { display: grid; gap: 14px; padding: 22px; background: #090909; color: #fff; box-shadow: 0 28px 80px rgba(0,0,0,0.18); }
    .pro-form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .pro-contact__form input, .pro-contact__form textarea { width: 100%; border: 1px solid rgba(255,255,255,0.14); background: rgba(255,255,255,0.06); color: #fff; padding: 15px 16px; min-height: 52px; font-family: var(--pro-body); outline: none; }
    .pro-contact__form textarea { resize: vertical; }
    .pro-contact__form input:focus, .pro-contact__form textarea:focus { border-color: rgba(227,6,19,0.8); }
    .pro-contact__form input::placeholder, .pro-contact__form textarea::placeholder { color: rgba(255,255,255,0.48); }
    .pro-check { display: flex; gap: 12px; color: rgba(255,255,255,0.72); font-size: 0.9rem; line-height: 1.5; }
    .pro-check input { width: 16px; min-height: 16px; margin-top: 2px; accent-color: var(--pro-red); }
    .pro-contact__status { margin: 0; color: #fff; }
    .pro-contact__form button { width: 100%; }

    @media (max-width: 900px) {
      .pro-video-grid__cards, .pro-contact__grid { grid-template-columns: 1fr; }
      .zoom-parallax__frame { width: 42vw; }
    }
    @media (max-width: 640px) {
      .pro-hero { min-height: 86dvh; padding: 92px 0 42px; align-items: center; }
      .pro-hero h1 { font-size: clamp(2.65rem, 14vw, 4.15rem); max-width: 92vw; }
      .pro-hero__lead { font-size: 0.98rem; max-width: 92vw; }
      .pro-hero__actions, .pro-glass { width: 100%; }
      .pro-player-wall, .pro-video-grid, .pro-contact { padding: 54px 0; }
      .pro-section-head h2 { white-space: normal; font-size: clamp(2.05rem, 11vw, 3.4rem); }
      .zoom-parallax { height: 240vh; }
      .zoom-parallax__frame { width: 58vw; height: 30vh; }
      .zoom-parallax__layer--1 .zoom-parallax__frame { width: 92vw; height: 58vh; }
      .zoom-parallax__layer--2 .zoom-parallax__frame { width: 54vw; }
      .zoom-parallax__layer--3 .zoom-parallax__frame { left: -18vw; width: 34vw; }
      .zoom-parallax__layer--4 .zoom-parallax__frame { left: 20vw; width: 38vw; }
      .zoom-parallax__layer--5 .zoom-parallax__frame { width: 34vw; }
      .zoom-parallax__layer--6 .zoom-parallax__frame { left: -16vw; width: 44vw; }
      .zoom-parallax__layer--7 .zoom-parallax__frame { left: 20vw; width: 26vw; height: 18vh; }
      .pro-player-card { width: 220px; }
      .pro-video-card { min-height: 260px; }
      .pro-form-grid { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) {
      .pro-marquee__track { animation: none; flex-wrap: wrap; width: auto; justify-content: center; }
      .zoom-parallax { height: auto; }
      .zoom-parallax__sticky { position: relative; height: auto; display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; padding: 64px 16px; }
      .zoom-parallax__copy { position: relative; left: auto; top: auto; transform: none; grid-column: 1 / -1; margin: 0 auto 18px; }
      .zoom-parallax__layer { position: relative; inset: auto; transform: none !important; }
      .zoom-parallax__frame, .zoom-parallax__layer--1 .zoom-parallax__frame, .zoom-parallax__layer--2 .zoom-parallax__frame, .zoom-parallax__layer--3 .zoom-parallax__frame, .zoom-parallax__layer--4 .zoom-parallax__frame, .zoom-parallax__layer--5 .zoom-parallax__frame, .zoom-parallax__layer--6 .zoom-parallax__frame, .zoom-parallax__layer--7 .zoom-parallax__frame { top: auto; left: auto; width: 100%; height: 260px; }
    }
  </style>

  <script>
    const parallax = document.querySelector('[data-zoom-parallax]')
    const layers = Array.from(document.querySelectorAll('[data-zoom-layer]'))

    function clamp(value, min, max) {
      return Math.min(Math.max(value, min), max)
    }

    function updateZoomParallax() {
      if (!parallax || !layers.length) return
      const rect = parallax.getBoundingClientRect()
      const scrollable = rect.height - window.innerHeight
      const progress = scrollable > 0 ? clamp(-rect.top / scrollable, 0, 1) : 0

      layers.forEach((layer) => {
        const targetScale = Number(layer.getAttribute('data-scale') || '4')
        const scale = 1 + ((targetScale - 1) * progress)
        layer.style.transform = `scale(${scale})`
      })
    }

    let ticking = false
    function requestUpdate() {
      if (ticking) return
      ticking = true
      requestAnimationFrame(() => {
        updateZoomParallax()
        ticking = false
      })
    }

    updateZoomParallax()
    window.addEventListener('scroll', requestUpdate, { passive: true })
    window.addEventListener('resize', requestUpdate)

    ;(function () {
      var options = {
        'training-sydney': {
          label: 'Training Enquiries (Sydney)',
          intro: 'Tell us about the player and what type of training you are looking for.',
          button: 'Send Training Enquiry'
        },
        'general': {
          label: 'General Enquiries',
          intro: 'Ask us anything and the team will point you in the right direction.',
          button: 'Send General Enquiry'
        },
        'joners-juniors': {
          label: 'Joners Juniors Enquiries',
          intro: 'For parents enquiring about the Joners Juniors program.',
          button: 'Send Joners Juniors Enquiry'
        },
        'coaching-role': {
          label: 'Apply For A Coaching Role',
          intro: 'Tell us about your coaching background and why you want to work with Joner Football.',
          button: 'Send Coaching Application'
        }
      };

      var form = document.getElementById('contact-smart-form');
      if (!form) return;
      var typeSelect = form.querySelector('[name="enquiryType"]');
      var intro = document.getElementById('form-intro');
      var submit = form.querySelector('button[type="submit"]');
      var status = document.getElementById('contact-form-status');

      function setStatus(message, ok) {
        if (!status) return;
        status.textContent = message || '';
        status.className = message ? 'font-body text-sm ' + (ok ? 'text-green-400' : 'text-amber-400') : 'hidden font-body text-sm';
      }

      function syncNamePlaceholder() {
        var selected = typeSelect.value || 'training-sydney';
        var nameField = form.querySelector('[data-name-field]');
        var playerAgeField = form.querySelector('[data-player-age-field]');
        if (!nameField) return;
        if (selected !== 'training-sydney') {
          nameField.placeholder = 'Full name';
          return;
        }
        var age = playerAgeField ? parseInt(String(playerAgeField.value || '').replace(/[^0-9]/g, ''), 10) : NaN;
        nameField.placeholder = age >= 18 ? 'Full name' : 'Parent name';
      }

      function syncFields() {
        var selected = typeSelect.value || 'training-sydney';
        var config = options[selected] || options['training-sydney'];
        if (intro) intro.textContent = config.intro;
        if (submit) submit.textContent = config.button;

        form.querySelectorAll('[data-fields]').forEach(function (group) {
          var show = String(group.getAttribute('data-fields') || '').split(' ').indexOf(selected) !== -1;
          group.classList.toggle('hidden', !show);
          group.querySelectorAll('input, select, textarea').forEach(function (field) {
            field.disabled = !show;
            if (field.classList.contains('conditional-required')) field.required = show;
          });
        });

        var defaultLocation = form.querySelector('[data-location-field="default"]');
        var trainingLocation = form.querySelector('[data-location-field="training"]');
        var isTraining = selected === 'training-sydney';
        if (defaultLocation && trainingLocation) {
          defaultLocation.classList.toggle('hidden', isTraining);
          defaultLocation.disabled = isTraining;
          trainingLocation.classList.toggle('hidden', !isTraining);
          trainingLocation.disabled = !isTraining;
          trainingLocation.required = isTraining;
        }
        syncNamePlaceholder();
      }

      typeSelect.addEventListener('change', function () {
        setStatus('', true);
        syncFields();
      });
      var playerAgeField = form.querySelector('[data-player-age-field]');
      if (playerAgeField) playerAgeField.addEventListener('input', syncNamePlaceholder);
      syncFields();

      form.addEventListener('submit', function (event) {
        event.preventDefault();
        setStatus('', true);
        var originalText = submit ? submit.textContent : 'Send Enquiry';
        var formData = new FormData(form);
        var emailInput = form.querySelector('input[name="email"]');

        if (window.JonerEmailGuard && emailInput) {
          var validation = window.JonerEmailGuard.validateEmail(formData.get('email'));
          window.JonerEmailGuard.setFeedback(emailInput, validation);
          if (!validation.valid) {
            emailInput.reportValidity();
            return;
          }
        }

        if (submit) {
          submit.disabled = true;
          submit.textContent = 'Sending...';
          submit.classList.add('opacity-70', 'cursor-not-allowed');
        }

        var payload = {};
        formData.forEach(function (value, key) {
          if (!(value instanceof File)) payload[key] = value;
        });
        if (payload.enquiryType === 'training-sydney' && payload.trainingLocation) payload.location = payload.trainingLocation;
        payload.marketingOptIn = formData.get('marketingOptIn') === 'true';

        var fileInput = form.querySelector('input[name="cvFile"]');
        var file = fileInput && fileInput.files && fileInput.files[0] ? fileInput.files[0] : null;
        var filePromise = Promise.resolve();
        if (payload.enquiryType === 'coaching-role' && file) {
          if (file.size > 5 * 1024 * 1024) {
            setStatus('CV file is too large. Max 5MB.', false);
            if (submit) {
              submit.disabled = false;
              submit.textContent = originalText;
              submit.classList.remove('opacity-70', 'cursor-not-allowed');
            }
            return;
          }
          filePromise = new Promise(function (resolve, reject) {
            var reader = new FileReader();
            reader.onload = function () {
              var result = String(reader.result || '');
              payload.cvFile = {
                name: file.name,
                type: file.type || 'application/octet-stream',
                content: result.split(',')[1] || ''
              };
              resolve();
            };
            reader.onerror = function () { reject(new Error('Could not read CV file.')); };
            reader.readAsDataURL(file);
          });
        }

        var tokenPromise = window.JonerRecaptcha && window.JonerRecaptcha.getToken
          ? window.JonerRecaptcha.getToken('contact')
          : Promise.resolve('');

        filePromise.then(function () { return tokenPromise; }).then(function (token) {
          payload.recaptchaToken = token;
          return fetch('/api/contact-enquiry', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
        })
        .then(function (response) { return response.json(); })
        .then(function (data) {
          if (!data || !data.success) throw new Error((data && data.error) || 'Could not send enquiry.');
          form.reset();
          syncFields();
          setStatus('Done. Your enquiry has been sent.', true);
        })
        .catch(function (error) {
          setStatus(error && error.message ? error.message : 'Could not send enquiry. Please try again.', false);
        })
        .finally(function () {
          if (submit) {
            submit.disabled = false;
            submit.textContent = originalText;
            submit.classList.remove('opacity-70', 'cursor-not-allowed');
          }
        });
      });
    })();
  </script>
</BaseLayout>
)}
