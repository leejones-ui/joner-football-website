---
import BaseLayout from '../../layouts/BaseLayout.astro'

const playerImages = [
  { src: '/images/training/professional-showcase/player-1.webp', alt: 'Alanna Kennedy professional player showcase' },
  { src: '/images/training/professional-showcase/player-2.webp', alt: 'Professional player trained by Joner Football' },
  { src: '/images/training/professional-showcase/player-3.webp', alt: 'Professional footballer showcase with Joner Football' },
  { src: '/images/training/professional-showcase/player-4.webp', alt: 'Elite football player showcase' },
  { src: '/images/training/professional-showcase/player-5.webp', alt: 'Professional player development showcase' },
  { src: '/images/training/professional-showcase/player-6.webp', alt: 'Pro football training showcase' },
  { src: '/images/training/professional-showcase/player-7.webp', alt: 'Professional player coached by Joner Football' },
  { src: '/images/training/professional-showcase/player-8.webp', alt: 'Elite player training with Joner Football' },
]

const zoomImages = playerImages.slice(0, 7)

const videoFeatures = [
  {
    title: 'Pro player detail session',
    youtubeId: '6Lk7pztLhEw',
    url: 'https://www.youtube.com/watch?v=6Lk7pztLhEw',
    label: 'Watch session 01',
  },
  {
    title: 'Elite technical work',
    youtubeId: '_jem2d4dYUg',
    url: 'https://www.youtube.com/watch?v=_jem2d4dYUg',
    label: 'Watch session 02',
  },
  {
    title: 'Professional standards',
    youtubeId: 'WqPaRKQXlts',
    url: 'https://www.youtube.com/watch?v=WqPaRKQXlts',
    label: 'Watch session 03',
  },
  {
    title: 'Inside the training process',
    youtubeId: '0WyjwepmxW8',
    url: 'https://www.youtube.com/watch?v=0WyjwepmxW8&list=PLM3cVo2QYr-O4bEy1AE1ox9mROWf__T4u&index=2&t=3s',
    label: 'Watch session 04',
  },
]

const proofPoints = [
  { stat: '10+', label: 'years working with professional players' },
  { stat: 'AUS', label: 'trusted by elite players across Australia' },
  { stat: 'WORLD', label: 'players supported worldwide' },
]

const standards = [
  'First touch detail under pressure',
  'Body shape before the ball arrives',
  'Scanning, timing, and clean decisions',
  'Technique that survives match speed',
]
---

<BaseLayout
  title="Professional Training | Joner Football"
  description="Joner Football professional training showcase. Lee Jones has worked with professional players across Australia and worldwide for over 10 years."
  canonical="/training/professional-training/"
>
  <main class="pro-page bg-joner-black text-white">
    <section class="pro-hero" aria-labelledby="pro-title">
      <div class="pro-hero__media" aria-hidden="true">
        <img src={playerImages[0].src} alt="" loading="eager" />
      </div>
      <div class="pro-hero__shade"></div>
      <div class="pro-wrap pro-hero__content">
        <p class="pro-eyebrow">Professional player training</p>
        <h1 id="pro-title">Over 10 years with pros.</h1>
        <p class="pro-hero__lead">
          Lee Jones has worked with professional players across Australia and worldwide for over 10 years, helping serious footballers sharpen the details that decide games.
        </p>
        <div class="pro-hero__actions">
          <a href="/contact?type=training-sydney" class="pro-glass pro-glass--red">Enquire now<span></span></a>
          <a href="#pro-showcase" class="pro-glass">See the work<span></span></a>
        </div>
      </div>
    </section>

    <section class="pro-proof" aria-label="Professional training proof points">
      <div class="pro-wrap pro-proof__grid">
        {proofPoints.map((item) => (
          <article class="pro-proof__item">
            <strong>{item.stat}</strong>
            <span>{item.label}</span>
          </article>
        ))}
      </div>
    </section>

    <section class="pro-intro" id="pro-showcase">
      <div class="pro-wrap pro-intro__grid">
        <div>
          <p class="pro-eyebrow">The showcase</p>
          <h2>Not theory. Real players. Real detail.</h2>
        </div>
        <div class="pro-intro__copy">
          <p>
            This page is built to show the level of player Lee has worked with and the standard inside the sessions. The work is technical, direct, and built around what happens in matches.
          </p>
          <p>
            For pros, academy players, and serious footballers, the goal is simple: cleaner actions, quicker pictures, better habits, and more confidence under pressure.
          </p>
        </div>
      </div>
    </section>

    <section class="zoom-parallax" data-zoom-parallax aria-label="Professional player image showcase">
      <div class="zoom-parallax__sticky">
        <div class="zoom-parallax__spotlight" aria-hidden="true"></div>
        <div class="zoom-parallax__copy" aria-hidden="true">
          <p class="pro-eyebrow">Scroll the wall</p>
          <h2>Players who trusted the detail.</h2>
        </div>
        {zoomImages.map((image, index) => (
          <div class:list={['zoom-parallax__layer', `zoom-parallax__layer--${index + 1}`]} data-zoom-layer data-scale={index === 0 ? '4' : index === 1 ? '5' : index === 2 ? '6' : index === 3 ? '5' : index === 4 ? '6' : index === 5 ? '8' : '9'}>
            <div class="zoom-parallax__frame">
              <img src={image.src} alt={image.alt} loading={index < 2 ? 'eager' : 'lazy'} />
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="pro-player-wall">
      <div class="pro-wrap">
        <div class="pro-section-head">
          <p class="pro-eyebrow">Pro player carousel</p>
          <h2>The players. The sessions. The standard.</h2>
        </div>
      </div>
      <div class="pro-marquee" aria-label="Professional player image carousel">
        <div class="pro-marquee__track">
          {[...playerImages, ...playerImages].map((image) => (
            <figure class="pro-player-card">
              <img src={image.src} alt={image.alt} loading="lazy" />
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="pro-video-scroll" data-video-scroll aria-label="Professional training video showcase">
      <div class="pro-video-scroll__sticky">
        <div class="pro-video-scroll__copy">
          <p class="pro-eyebrow">Watch the work</p>
          <h2>Video proof inside the process.</h2>
          <p>
            Tap any session to watch the full training video. These clips show the detail, the conversations, and the level behind the player development work.
          </p>
        </div>
        <div class="pro-video-stack">
          {videoFeatures.map((video, index) => (
            <a class:list={['pro-video-card', `pro-video-card--${index + 1}`]} href={video.url} target="_blank" rel="noopener noreferrer" data-video-card>
              <img src={`https://img.youtube.com/vi/${video.youtubeId}/maxresdefault.jpg`} alt={`${video.title} YouTube thumbnail`} loading="lazy" />
              <div class="pro-video-card__shade"></div>
              <div class="pro-video-card__content">
                <span>Play video</span>
                <h3>{video.title}</h3>
                <p>{video.label}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="pro-standards">
      <div class="pro-wrap">
        <div class="pro-section-head">
          <p class="pro-eyebrow">Why pros use Lee</p>
          <h2>Small details. Match-level difference.</h2>
        </div>
        <div class="pro-standard-grid">
          {standards.map((item, index) => (
            <article class="pro-standard-card">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{item}</h3>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pro-split">
      <div class="pro-wrap pro-split__grid">
        <div class="pro-split__image">
          <img src="/images/training/professional-showcase/player-8.webp" alt="Professional football player showcase with Joner Football" loading="lazy" />
        </div>
        <div class="pro-split__content">
          <p class="pro-eyebrow">Who it is for</p>
          <h2>Professionals, academy players, and serious footballers.</h2>
          <div class="pro-pathways">
            <article>
              <h3>Professional players</h3>
              <p>Private detail work for players who need rhythm, confidence, sharp touches, and clean execution between club sessions.</p>
            </article>
            <article>
              <h3>Elite academy players</h3>
              <p>High-standard technical coaching for players already in serious environments who need the next layer of detail.</p>
            </article>
            <article>
              <h3>International players</h3>
              <p>Online and in-person support for players worldwide who want Lee's eye on their game, habits, and technical detail.</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="pro-final">
      <div class="pro-final__bg" aria-hidden="true"></div>
      <div class="pro-wrap pro-final__content">
        <p class="pro-eyebrow">Ready?</p>
        <h2>Train like the details matter.</h2>
        <p>
          Tell us the player level, age, position, and what needs fixing. If it is the right fit, we will point you to the best next step.
        </p>
        <a href="/contact?type=training-sydney" class="pro-glass pro-glass--red">Enquire about pro training<span></span></a>
      </div>
    </section>
  </main>

  <style>
    :global(html) { scroll-behavior: smooth; }
    .pro-page {
      --pro-red: #E30613;
      --pro-black: #0A0A0A;
      --pro-display: Anton, Impact, sans-serif;
      --pro-body: 'DM Sans', system-ui, sans-serif;
      overflow-x: clip;
    }
    .pro-wrap { width: min(1120px, calc(100% - 32px)); margin: 0 auto; }
    .pro-eyebrow {
      margin: 0;
      font-family: var(--pro-display);
      color: var(--pro-red);
      font-size: 0.8rem;
      letter-spacing: 0.24em;
      text-transform: uppercase;
    }
    .pro-hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: flex-end;
      overflow: hidden;
      padding: 128px 0 72px;
      isolation: isolate;
    }
    .pro-hero__media, .pro-hero__shade { position: absolute; inset: 0; }
    .pro-hero__media img { width: 100%; height: 100%; object-fit: cover; object-position: center 16%; filter: saturate(1.08) contrast(1.08); transform: scale(1.03); }
    .pro-hero__shade { background: radial-gradient(circle at 72% 28%, rgba(227,6,19,0.26), transparent 30%), linear-gradient(90deg, rgba(0,0,0,0.94) 0%, rgba(0,0,0,0.74) 42%, rgba(0,0,0,0.16) 100%), linear-gradient(180deg, rgba(0,0,0,0.04), rgba(0,0,0,0.86)); z-index: 0; }
    .pro-hero__content { position: relative; z-index: 1; }
    .pro-hero h1, .pro-intro h2, .pro-section-head h2, .pro-split h2, .pro-final h2, .zoom-parallax__copy h2, .pro-video-scroll__copy h2 {
      font-family: var(--pro-display);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      line-height: 0.9;
    }
    .pro-hero h1 { max-width: 980px; margin: 18px 0 0; font-size: clamp(4rem, 12vw, 10.5rem); }
    .pro-hero__lead { max-width: 680px; margin: 24px 0 0; color: rgba(255,255,255,0.86); font-size: clamp(1.05rem, 2vw, 1.34rem); line-height: 1.6; }
    .pro-hero__actions { margin-top: 34px; display: flex; flex-wrap: wrap; gap: 14px; }
    .pro-glass {
      min-height: 52px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
      border-radius: 999px;
      padding: 17px 28px 15px;
      border: 1px solid rgba(255,255,255,.32);
      color: #fff;
      text-decoration: none;
      background: linear-gradient(135deg, rgba(255,255,255,.16), rgba(255,255,255,.035)), rgba(5,5,5,.66);
      box-shadow: 0 18px 40px rgba(0,0,0,.38), inset 0 1px 0 rgba(255,255,255,.22);
      font-family: var(--pro-display);
      text-transform: uppercase;
      letter-spacing: .14em;
      font-size: 14px;
      transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
    }
    .pro-glass:hover { transform: translateY(-2px); border-color: rgba(255,255,255,.58); box-shadow: 0 22px 46px rgba(0,0,0,.46), inset 0 1px 0 rgba(255,255,255,.28); }
    .pro-glass--red { border-color: rgba(227,6,19,.74); }
    .pro-glass span { display: none; }

    .pro-proof { background: #050505; border-top: 1px solid rgba(255,255,255,0.08); border-bottom: 1px solid rgba(255,255,255,0.08); }
    .pro-proof__grid { display: grid; grid-template-columns: repeat(3, 1fr); }
    .pro-proof__item { min-height: 178px; padding: 28px; border-left: 1px solid rgba(255,255,255,0.08); display: flex; flex-direction: column; justify-content: center; }
    .pro-proof__item:last-child { border-right: 1px solid rgba(255,255,255,0.08); }
    .pro-proof__item strong { font-family: var(--pro-display); font-size: clamp(3.1rem, 7vw, 6.2rem); line-height: 0.85; color: #fff; }
    .pro-proof__item span { margin-top: 14px; max-width: 260px; color: rgba(255,255,255,0.72); line-height: 1.45; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.82rem; }

    .pro-intro { padding: 88px 0; background: #fff; color: #050505; }
    .pro-intro__grid { display: grid; gap: 28px; grid-template-columns: 0.9fr 1.1fr; align-items: start; }
    .pro-intro h2 { margin: 16px 0 0; font-size: clamp(2.8rem, 6vw, 5.7rem); }
    .pro-intro__copy { display: grid; gap: 18px; color: rgba(0,0,0,0.68); font-size: 1.04rem; line-height: 1.75; }
    .pro-intro__copy p { margin: 0; }

    .zoom-parallax { position: relative; height: 320vh; background: #050505; }
    .zoom-parallax__sticky { position: sticky; top: 0; height: 100vh; overflow: hidden; }
    .zoom-parallax__spotlight { position: absolute; top: -42vmin; left: 50%; width: 120vmin; height: 120vmin; transform: translateX(-50%); border-radius: 999px; background: radial-gradient(ellipse at center, rgba(255,255,255,0.12), rgba(227,6,19,0.1) 24%, transparent 55%); filter: blur(30px); pointer-events: none; }
    .zoom-parallax__copy { position: absolute; z-index: 10; left: 50%; top: 50%; width: min(680px, 84vw); transform: translate(-50%, -50%); text-align: center; pointer-events: none; mix-blend-mode: screen; }
    .zoom-parallax__copy h2 { margin: 12px 0 0; font-size: clamp(2.8rem, 8vw, 7.2rem); text-shadow: 0 16px 60px rgba(0,0,0,0.8); }
    .zoom-parallax__layer { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; will-change: transform; }
    .zoom-parallax__frame { position: relative; width: 25vw; height: 31vh; overflow: hidden; box-shadow: 0 30px 90px rgba(0,0,0,0.55); border: 1px solid rgba(255,255,255,0.14); background: #111; }
    .zoom-parallax__frame img { width: 100%; height: 100%; object-fit: cover; }
    .zoom-parallax__layer--2 .zoom-parallax__frame { top: -30vh; left: 5vw; width: 27vw; height: 34vh; }
    .zoom-parallax__layer--3 .zoom-parallax__frame { top: -10vh; left: -25vw; width: 21vw; height: 42vh; }
    .zoom-parallax__layer--4 .zoom-parallax__frame { left: 27.5vw; width: 23vw; height: 30vh; }
    .zoom-parallax__layer--5 .zoom-parallax__frame { top: 27.5vh; left: 5vw; width: 22vw; height: 30vh; }
    .zoom-parallax__layer--6 .zoom-parallax__frame { top: 27.5vh; left: -22.5vw; width: 25vw; height: 32vh; }
    .zoom-parallax__layer--7 .zoom-parallax__frame { top: 22.5vh; left: 25vw; width: 16vw; height: 22vh; }

    .pro-player-wall { padding: 92px 0 100px; background: #fff; color: #050505; overflow: hidden; }
    .pro-section-head { max-width: 820px; margin-bottom: 34px; }
    .pro-section-head h2 { margin: 14px 0 0; font-size: clamp(2.7rem, 7vw, 6rem); }
    .pro-marquee { width: 100%; overflow: hidden; }
    .pro-marquee__track { width: max-content; display: flex; gap: 18px; animation: pro-marquee 44s linear infinite; }
    .pro-marquee:hover .pro-marquee__track { animation-play-state: paused; }
    .pro-player-card { width: min(280px, 68vw); aspect-ratio: 4 / 5; margin: 0; overflow: hidden; background: #111; box-shadow: 0 24px 60px rgba(0,0,0,0.16); }
    .pro-player-card img { width: 100%; height: 100%; object-fit: cover; }
    @keyframes pro-marquee { from { transform: translateX(0); } to { transform: translateX(calc(-50% - 9px)); } }

    .pro-video-scroll { position: relative; height: 300vh; background: radial-gradient(circle at 74% 22%, rgba(227,6,19,0.22), transparent 24%), #060606; }
    .pro-video-scroll__sticky { position: sticky; top: 0; height: 100vh; overflow: hidden; display: grid; grid-template-columns: minmax(280px, 0.78fr) minmax(0, 1.22fr); gap: 28px; align-items: center; width: min(1160px, calc(100% - 32px)); margin: 0 auto; }
    .pro-video-scroll__copy { position: relative; z-index: 5; }
    .pro-video-scroll__copy h2 { margin: 14px 0 0; font-size: clamp(3rem, 7vw, 6.6rem); }
    .pro-video-scroll__copy p:not(.pro-eyebrow) { margin: 20px 0 0; max-width: 440px; color: rgba(255,255,255,0.72); line-height: 1.7; }
    .pro-video-stack { position: relative; height: min(70vh, 680px); }
    .pro-video-card { position: absolute; inset: 0; display: block; overflow: hidden; border: 1px solid rgba(255,255,255,0.16); background: #111; text-decoration: none; color: #fff; box-shadow: 0 30px 90px rgba(0,0,0,0.5); will-change: transform, opacity; }
    .pro-video-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
    .pro-video-card:hover img { transform: scale(1.04); }
    .pro-video-card__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0.05), rgba(0,0,0,0.78)); }
    .pro-video-card__content { position: absolute; left: 26px; right: 26px; bottom: 26px; }
    .pro-video-card__content span { display: inline-flex; margin-bottom: 12px; border: 1px solid rgba(255,255,255,0.28); border-radius: 999px; padding: 8px 12px; font-family: var(--pro-display); letter-spacing: 0.12em; text-transform: uppercase; font-size: 0.72rem; background: rgba(227,6,19,0.8); }
    .pro-video-card__content h3 { margin: 0; font-family: var(--pro-display); text-transform: uppercase; letter-spacing: 0.05em; font-size: clamp(2rem, 4vw, 4rem); line-height: 0.92; }
    .pro-video-card__content p { margin: 8px 0 0; color: rgba(255,255,255,0.74); text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.78rem; }
    .pro-video-card--1 { transform: rotate(-2deg) translate(-3%, 3%); z-index: 4; }
    .pro-video-card--2 { transform: rotate(2deg) translate(4%, -2%); z-index: 3; }
    .pro-video-card--3 { transform: rotate(-4deg) translate(8%, 6%); z-index: 2; }
    .pro-video-card--4 { transform: rotate(4deg) translate(12%, -5%); z-index: 1; }

    .pro-standards { padding: 92px 0; background: var(--pro-black); }
    .pro-standard-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
    .pro-standard-card { min-height: 260px; padding: 24px; border: 1px solid rgba(255,255,255,0.12); background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.025)); display: flex; flex-direction: column; justify-content: space-between; }
    .pro-standard-card span { color: var(--pro-red); font-family: var(--pro-display); letter-spacing: 0.18em; }
    .pro-standard-card h3 { margin: 0; font-family: var(--pro-display); text-transform: uppercase; line-height: 1; letter-spacing: 0.04em; font-size: clamp(1.5rem, 2.6vw, 2.25rem); }

    .pro-split { padding: 96px 0; background: #fff; color: #050505; }
    .pro-split__grid { display: grid; grid-template-columns: 0.92fr 1.08fr; gap: 54px; align-items: center; }
    .pro-split__image { min-height: 620px; overflow: hidden; background: #050505; box-shadow: 0 28px 70px rgba(0,0,0,0.16); }
    .pro-split__image img { width: 100%; height: 100%; min-height: 620px; object-fit: cover; }
    .pro-split h2 { margin: 14px 0 0; font-size: clamp(2.8rem, 6vw, 5.5rem); }
    .pro-pathways { margin-top: 34px; display: grid; gap: 16px; }
    .pro-pathways article { border-top: 1px solid rgba(0,0,0,0.14); padding-top: 18px; }
    .pro-pathways h3 { margin: 0; font-family: var(--pro-display); text-transform: uppercase; letter-spacing: 0.08em; font-size: 1.35rem; color: var(--pro-red); }
    .pro-pathways p { margin: 8px 0 0; color: rgba(0,0,0,0.66); line-height: 1.65; }

    .pro-final { position: relative; overflow: hidden; padding: 140px 0; }
    .pro-final__bg { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,0.9), rgba(0,0,0,0.56)), url('/images/training/professional-showcase/player-7.webp') center 28%/cover; }
    .pro-final__content { position: relative; max-width: 760px; }
    .pro-final h2 { margin: 14px 0 0; font-size: clamp(3rem, 8vw, 7rem); }
    .pro-final p:not(.pro-eyebrow) { max-width: 620px; margin: 20px 0 30px; color: rgba(255,255,255,0.78); line-height: 1.7; font-size: 1.08rem; }

    @media (max-width: 900px) {
      .pro-intro__grid, .pro-split__grid { grid-template-columns: 1fr; }
      .pro-proof__grid { grid-template-columns: 1fr; }
      .pro-proof__item { border-right: 1px solid rgba(255,255,255,0.08); border-bottom: 1px solid rgba(255,255,255,0.08); }
      .pro-standard-grid { grid-template-columns: repeat(2, 1fr); }
      .pro-split__image, .pro-split__image img { min-height: 420px; }
      .zoom-parallax__frame { width: 42vw; }
      .pro-video-scroll { height: auto; }
      .pro-video-scroll__sticky { position: relative; height: auto; grid-template-columns: 1fr; padding: 80px 0; }
      .pro-video-stack { height: auto; display: grid; gap: 18px; }
      .pro-video-card, .pro-video-card--1, .pro-video-card--2, .pro-video-card--3, .pro-video-card--4 { position: relative; height: 56vw; min-height: 300px; transform: none !important; opacity: 1 !important; }
    }
    @media (max-width: 640px) {
      .pro-hero { min-height: 92vh; padding: 110px 0 48px; }
      .pro-hero h1 { font-size: clamp(3.4rem, 18vw, 5.2rem); }
      .pro-hero__actions, .pro-glass { width: 100%; }
      .pro-intro, .pro-standards, .pro-split, .pro-player-wall { padding: 64px 0; }
      .pro-standard-grid { grid-template-columns: 1fr; }
      .pro-standard-card { min-height: 180px; }
      .zoom-parallax { height: 240vh; }
      .zoom-parallax__frame { width: 48vw; height: 30vh; }
      .zoom-parallax__layer--2 .zoom-parallax__frame { width: 54vw; }
      .zoom-parallax__layer--3 .zoom-parallax__frame { left: -18vw; width: 34vw; }
      .zoom-parallax__layer--4 .zoom-parallax__frame { left: 20vw; width: 38vw; }
      .zoom-parallax__layer--5 .zoom-parallax__frame { width: 34vw; }
      .zoom-parallax__layer--6 .zoom-parallax__frame { left: -16vw; width: 44vw; }
      .zoom-parallax__layer--7 .zoom-parallax__frame { left: 20vw; width: 26vw; height: 18vh; }
      .pro-player-card { width: 220px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .pro-marquee__track { animation: none; flex-wrap: wrap; width: auto; justify-content: center; }
      .zoom-parallax { height: auto; }
      .zoom-parallax__sticky { position: relative; height: auto; display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; padding: 64px 16px; }
      .zoom-parallax__copy { position: relative; left: auto; top: auto; transform: none; grid-column: 1 / -1; margin: 0 auto 18px; }
      .zoom-parallax__layer { position: relative; inset: auto; transform: none !important; }
      .zoom-parallax__frame, .zoom-parallax__layer--2 .zoom-parallax__frame, .zoom-parallax__layer--3 .zoom-parallax__frame, .zoom-parallax__layer--4 .zoom-parallax__frame, .zoom-parallax__layer--5 .zoom-parallax__frame, .zoom-parallax__layer--6 .zoom-parallax__frame, .zoom-parallax__layer--7 .zoom-parallax__frame { top: auto; left: auto; width: 100%; height: 260px; }
    }
  </style>

  <script>
    const parallax = document.querySelector('[data-zoom-parallax]')
    const layers = Array.from(document.querySelectorAll('[data-zoom-layer]'))
    const videoScroll = document.querySelector('[data-video-scroll]')
    const videoCards = Array.from(document.querySelectorAll('[data-video-card]'))

    function clamp(value, min, max) {
      return Math.min(Math.max(value, min), max)
    }

    function updateZoomParallax() {
      if (!parallax || !layers.length) return
      const rect = parallax.getBoundingClientRect()
      const scrollable = rect.height - window.innerHeight
      const progress = scrollable > 0 ? clamp(-rect.top / scrollable, 0, 1) : 0

      layers.forEach((layer) => {
        const targetScale = Number(layer.getAttribute('data-scale') || '4')
        const scale = 1 + ((targetScale - 1) * progress)
        layer.style.transform = `scale(${scale})`
      })
    }

    function updateVideoStack() {
      if (!videoScroll || !videoCards.length || window.innerWidth <= 900) return
      const rect = videoScroll.getBoundingClientRect()
      const scrollable = rect.height - window.innerHeight
      const progress = scrollable > 0 ? clamp(-rect.top / scrollable, 0, 1) : 0

      videoCards.forEach((card, index) => {
        const local = clamp((progress - index * 0.18) / 0.34, 0, 1)
        const y = (index * 34) - (local * 95)
        const x = (index * 22) - (local * 14)
        const rotate = [-2, 2, -4, 4][index] || 0
        const scale = 1 - index * 0.035 + local * 0.045
        const opacity = clamp(1 - Math.max(0, progress - (index + 1) * 0.22) * 1.45, 0.28, 1)
        card.style.transform = `translate(${x}px, ${y}px) rotate(${rotate}deg) scale(${scale})`
        card.style.opacity = opacity
        card.style.zIndex = String(10 - index)
      })
    }

    let ticking = false
    function requestUpdate() {
      if (ticking) return
      ticking = true
      requestAnimationFrame(() => {
        updateZoomParallax()
        updateVideoStack()
        ticking = false
      })
    }

    updateZoomParallax()
    updateVideoStack()
    window.addEventListener('scroll', requestUpdate, { passive: true })
    window.addEventListener('resize', requestUpdate)
  </script>
</BaseLayout>
