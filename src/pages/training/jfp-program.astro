  <script is:inline>
    (function () {
      var options = {
        'training-sydney': {
          intro: 'Tell us about the player and what type of JFP training you are looking for.',
          button: 'Send JFP Enquiry'
        },
        'general': {
          intro: 'Ask us anything and the team will point you in the right direction.',
          button: 'Send General Enquiry'
        },
        'joners-juniors': {
          intro: 'For parents enquiring about the Joners Juniors program.',
          button: 'Send Joners Juniors Enquiry'
        }
      };

      var form = document.getElementById('contact-smart-form');
      if (!form) return;
      var typeSelect = form.querySelector('[name="enquiryType"]');
      var intro = document.getElementById('form-intro');
      var submit = form.querySelector('button[type="submit"]');
      var status = document.getElementById('contact-form-status');

      function setStatus(message, ok) {
        if (!status) return;
        status.textContent = message || '';
        status.className = message ? 'font-body text-sm ' + (ok ? 'text-green-400' : 'text-amber-400') : 'hidden font-body text-sm';
      }

      function syncNamePlaceholder() {
        var selected = typeSelect.value || 'training-sydney';
        var nameField = form.querySelector('[data-name-field]');
        var playerAgeField = form.querySelector('[data-player-age-field]');
        if (!nameField) return;
        if (selected !== 'training-sydney') {
          nameField.placeholder = 'Full name';
          return;
        }
        var age = playerAgeField ? parseInt(String(playerAgeField.value || '').replace(/[^0-9]/g, ''), 10) : NaN;
        nameField.placeholder = age >= 18 ? 'Full name' : 'Parent name';
      }

      function syncFields() {
        var selected = typeSelect.value || 'training-sydney';
        var config = options[selected] || options['training-sydney'];
        if (intro) intro.textContent = config.intro;
        if (submit) submit.textContent = config.button;

        form.querySelectorAll('[data-fields]').forEach(function (group) {
          var show = String(group.getAttribute('data-fields') || '').split(' ').indexOf(selected) !== -1;
          group.classList.toggle('hidden', !show);
          group.querySelectorAll('input, select, textarea').forEach(function (field) {
            field.disabled = !show;
            if (field.classList.contains('conditional-required')) field.required = show;
          });
        });
        syncNamePlaceholder();
      }

      typeSelect.addEventListener('change', function () {
        setStatus('', true);
        syncFields();
      });
      var playerAgeField = form.querySelector('[data-player-age-field]');
      if (playerAgeField) playerAgeField.addEventListener('input', syncNamePlaceholder);
      syncFields();

      form.addEventListener('submit', function (event) {
        event.preventDefault();
        setStatus('', true);
        var originalText = submit ? submit.textContent : 'Send Enquiry';
        var formData = new FormData(form);
        var emailInput = form.querySelector('input[name="email"]');

        if (window.JonerEmailGuard && emailInput) {
          var validation = window.JonerEmailGuard.validateEmail(formData.get('email'));
          window.JonerEmailGuard.setFeedback(emailInput, validation);
          if (!validation.valid) {
            emailInput.reportValidity();
            return;
          }
        }

        if (submit) {
          submit.disabled = true;
          submit.textContent = 'Sending...';
          submit.classList.add('opacity-70', 'cursor-not-allowed');
        }

        var payload = {};
        formData.forEach(function (value, key) {
          if (!(value instanceof File)) payload[key] = value;
        });
        if (payload.trainingLocation) payload.location = payload.trainingLocation;
        payload.marketingOptIn = formData.get('marketingOptIn') === 'true';

        var tokenPromise = window.JonerRecaptcha && window.JonerRecaptcha.getToken
          ? window.JonerRecaptcha.getToken('contact')
          : Promise.resolve('');

        tokenPromise.then(function (token) {
          payload.recaptchaToken = token;
          return fetch('/api/contact-enquiry', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
        })
        .then(function (response) { return response.json(); })
        .then(function (data) {
          if (!data || !data.success) throw new Error((data && data.error) || 'Could not send enquiry.');
          form.reset();
          syncFields();
          setStatus('Done. Your enquiry has been sent.', true);
        })
        .catch(function (error) {
          setStatus(error && error.message ? error.message : 'Could not send enquiry. Please try again.', false);
        })
        .finally(function () {
          if (submit) {
            submit.disabled = false;
            submit.textContent = originalText;
            submit.classList.remove('opacity-70', 'cursor-not-allowed');
          }
        });
      });
    })();
  </script>

  <style>
    /* === JFP Player Pathway === */
    .pathway-photo {
      background-image: url('/images/training/jfp/jfp-training-3.webp');
      background-size: cover;
      background-position: center;
      opacity: 0.6;
      z-index: 0;
    }
    .pathway-scrim {
      background:
        radial-gradient(80% 60% at 50% 0%, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0.7) 70%),
        linear-gradient(180deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.4) 50%, rgba(0,0,0,0.8) 100%);
      z-index: 1;
    }

    /* Mobile vertical spine */
    .pathway-tree::before {
      content: "";
      position: absolute;
      left: 27px;
      top: 28px;
      bottom: 28px;
      width: 2px;
      background: repeating-linear-gradient(
        to bottom,
        #CC0000 0,
        #CC0000 6px,
        transparent 6px,
        transparent 12px
      );
    }

    .pathway-stage {
      box-shadow: 0 0 0 6px #000, 0 0 24px rgba(204, 0, 0, 0.4);
    }
    .pathway-node.is-flagship .pathway-stage {
      background: #CC0000;
      color: #fff;
      box-shadow: 0 0 0 6px #000, 0 0 32px rgba(204, 0, 0, 0.6);
    }
    .pathway-node.is-flagship .pathway-card {
      border-color: #CC0000;
      background:
        radial-gradient(120% 100% at 0% 0%, rgba(204, 0, 0, 0.18) 0%, rgba(204, 0, 0, 0) 60%),
        #0a0a0a;
    }

    /* Connector tick from spine to card (mobile) */
    .pathway-card::before {
      content: "";
      position: absolute;
      left: -36px;
      top: 32px;
      width: 36px;
      height: 2px;
      background: #CC0000;
    }

    @media (min-width: 900px) {
      .pathway-tree::before { display: none; }
      .pathway-card { margin-left: 0; }
      .pathway-card::before {
        left: 50%;
        top: -28px;
        width: 2px;
        height: 28px;
        transform: translateX(-50%);
      }
      /* Dashed connector between stage bubbles */
      .pathway-node:not(:last-child) > .pathway-stage::after {
        content: "";
        position: absolute;
        left: 100%;
        top: 50%;
        height: 2px;
        width: calc((100vw - 40px) / 5 - 56px);
        max-width: 200px;
        background: repeating-linear-gradient(
          to right,
          #CC0000 0, #CC0000 6px,
          transparent 6px, transparent 12px
        );
        transform: translateY(-50%);
      }
    }

    /* Section nav: each link is a full 44px tap target; the bar keeps its 48px height */
    .jfp-subnav > a { display: inline-flex; align-items: center; min-height: 44px; }

    /* Glass button (matches design spec) */
    .btn-glass {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 6px;
      padding: 18px 36px 16px;
      font-family: var(--font-heading, sans-serif);
      font-style: italic;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-size: 17px;
      line-height: 1;
      color: #fff;
      text-decoration: none;
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 999px;
      background:
        linear-gradient(180deg, rgba(255,255,255,0.10) 0%, rgba(255,255,255,0.02) 50%, rgba(0,0,0,0.4) 100%),
        radial-gradient(120% 140% at 50% 0%, rgba(204,0,0,0.35) 0%, rgba(204,0,0,0) 60%),
        #0a0a0a;
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.20),
        inset 0 -1px 0 rgba(0,0,0,0.6),
        0 8px 24px rgba(204,0,0,0.18);
      cursor: pointer;
      overflow: hidden;
      transition: transform 120ms cubic-bezier(.2,.7,.2,1), box-shadow 200ms;
    }
    .btn-glass::before {
      content: "";
      position: absolute;
      left: 8%;
      right: 8%;
