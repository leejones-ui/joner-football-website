---
import BaseLayout from '../../layouts/BaseLayout.astro'

const title = 'JFP Program | Joner Football'
const description = 'Joner Football Performance is a term by term Sydney football training program for ages 8 and over, built around technical, physical and mental development.'
const canonical = '/training/jfp-program/'

const stats = [
  { value: '2013', label: 'Program launched' },
  { value: '8+', label: 'Ages welcome' },
  { value: '10 week', label: 'Term program' },
  { value: '3x', label: 'Train weekly' },
  { value: '3', label: 'Sydney locations' },
]

const locations = [
  {
    title: 'HQ Facility Belrose',
    text: 'Afternoon sessions inside the Joner Football HQ. Indoor, weatherproof, high quality.',
    mapUrl: 'https://www.google.com/maps/search/?api=1&query=20+Narabang+Way+Belrose+NSW+2085',
  },
  {
    title: 'North Turramurra',
    text: 'Early morning field sessions for players who want extra work before school.',
    mapUrl: 'https://www.google.com/maps/search/?api=1&query=North+Turramurra+Recreation+Area+NSW',
  },
  {
    title: 'Rydalmere Park',
    text: 'Morning field sessions for the wider Sydney football community.',
    mapUrl: 'https://www.google.com/maps/search/?api=1&query=Rydalmere+Park+Sydney+NSW',
  },
]

const pillars = [
  { number: '01', title: 'Technique First', text: 'Ball mastery, 1v1 detail, weak foot work, game-relevant habits.' },
  { number: '02', title: 'High Energy', text: 'Sharp, intense, demanding sessions. Real standards.' },
  { number: '03', title: 'Real Development', text: 'Long-term growth across technical, physical, and mental.' },
]

const unlocks = [
  { title: '10 Week Terms', text: 'Clear term structure to build habits and measure progress.' },
  { title: 'Player Reports', text: 'Development feedback so parents and players know what is improving.' },
  { title: 'Elite Coaching', text: 'High-detail technical coaching from the Joner Football team.' },
  { title: 'Joner App', text: 'Continue training away from sessions with app-based drills.' },
  { title: 'Strength And Conditioning', text: 'Physical development support around the player.' },
  { title: 'Game Analysis', text: 'Video and game detail to improve decisions faster.' },
  { title: 'Mentorship', text: 'Guidance on standards, mindset, and training habits.' },
  { title: 'High Level Training', text: 'A demanding environment for players chasing a football career.' },
]

const points = [
  'Early morning, weekday afternoon, and Saturday morning options',
  'Ages 8 and over, all ability levels',
  '10 week term to term program',
  'For dedicated players only',
  'Improve technically, physically, and mentally',
  'Group and individual training options',
  'Limited spots available each term',
]

const videos = [
  { title: 'HQ Training', src: 'https://www.youtube.com/embed/eCmL9QiFtVk?rel=0&controls=1&hd=1' },
  { title: 'On Field Training', src: 'https://www.youtube.com/embed/-V88Iy1X-is?start=466&rel=0&controls=1&hd=1' },
]

const faqs = [
  ['What does the player need to bring?', 'Soccer boots for synthetic, shin guards, drink bottle, waterproof jacket, a smile, a good attitude, and training kit supplied by Deploy.'],
  ['What should players expect?', 'Energy, enthusiasm, intensity, knowledge, new drills, and coaches who go above and beyond to help players learn.'],
  ['Will bad weather cancel the session?', 'No. Only really bad storms can alter the session. Afternoon HQ sessions are indoors, so bad weather is far less of a problem.'],
  ['Who will be in my son or daughter\'s group?', 'Coaches group players by age first, then ability. Groups are limited and players can be moved up if they need a stronger challenge.'],
]
---

<BaseLayout title={title} description={description} canonical={canonical} noindex={true} hideMobileAppCta>
  <Fragment slot="head">
    <link rel="preload" as="video" href="/images/training/jfp/jfp-hero.mp4" />
  </Fragment>

  <main class="bg-joner-black text-white">
    <section class="bg-joner-black pt-10 pb-12 md:pt-16 md:pb-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-black">
          <div class="spotlight spotlight-a" aria-hidden="true"></div>
          <div class="spotlight spotlight-b" aria-hidden="true"></div>
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(227,6,19,0.2),transparent_56%)] pointer-events-none"></div>
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,rgba(255,255,255,0.07),transparent_60%)] pointer-events-none"></div>

          <div class="relative z-10 flex min-h-[620px] flex-col lg:min-h-[700px] lg:flex-row">
            <div class="flex flex-1 flex-col justify-center px-6 py-10 sm:px-10 sm:py-14 lg:p-14">
              <p class="mb-4 font-heading text-xs uppercase tracking-[0.25em] text-joner-red sm:text-sm">Sydney player development</p>
              <h1 class="mb-6 bg-gradient-to-b from-white via-neutral-100 to-neutral-500 bg-clip-text font-heading text-5xl font-bold uppercase leading-[0.9] text-transparent sm:text-6xl md:text-7xl lg:text-8xl">
                Joner Football<br />Performance
              </h1>
              <p class="mb-8 max-w-lg font-body text-base leading-relaxed text-neutral-300 sm:text-lg">
                Sydney's flagship player development program. Ages 8 and over. Train technically, physically, and mentally with the JFP team.
              </p>
              <div class="flex flex-wrap gap-3">
                <a href="#training-form" class="btn-red text-sm">Book Now</a>
                <a href="#program" class="btn-outline text-sm">See The Program</a>
              </div>
            </div>

            <div class="relative min-h-[420px] flex-1 sm:min-h-[500px] lg:min-h-0">
              <video autoplay muted loop playsinline poster="/images/training/jfp/jfp-training-1.webp" class="absolute inset-0 h-full w-full object-cover object-center">
                <source src="/images/training/jfp/jfp-hero.mp4" type="video/mp4" />
              </video>
              <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_35%,rgba(255,255,255,0.14),transparent_55%)] pointer-events-none z-10"></div>
              <div class="absolute inset-y-0 left-0 hidden w-1/3 bg-gradient-to-r from-black via-black/60 to-transparent lg:block pointer-events-none"></div>
              <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black via-black/45 to-transparent pointer-events-none"></div>
            </div>
          </div>

          <div class="relative z-10 grid grid-cols-2 border-t border-white/10 bg-black/45 backdrop-blur-sm md:grid-cols-5">
            {stats.map((stat, index) => (
              <div class={`p-5 text-center ${index < stats.length - 1 ? 'md:border-r' : ''} border-white/10 ${index > 1 ? 'border-t md:border-t-0' : ''}`}>
                <div class={`font-heading text-2xl font-bold md:text-3xl ${index === 0 || index === 4 ? 'text-joner-red' : 'text-white'}`}>{stat.value}</div>
                <div class="mt-1 font-body text-[10px] uppercase tracking-wider text-neutral-500 sm:text-xs">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <nav class="sticky top-0 z-30 border-y border-white/10 bg-joner-black/92 backdrop-blur">
      <div class="mx-auto flex max-w-7xl gap-6 overflow-x-auto px-4 py-4 font-heading text-xs uppercase tracking-[0.22em] text-white sm:px-6 lg:px-8 no-scrollbar">
        <a href="#program" class="shrink-0 hover:text-joner-red">Program</a>
        <a href="#what-you-get" class="shrink-0 hover:text-joner-red">What You Get</a>
        <a href="#locations" class="shrink-0 hover:text-joner-red">Locations</a>
        <a href="#unlocks" class="shrink-0 hover:text-joner-red">Inside JFP</a>
        <a href="#videos" class="shrink-0 hover:text-joner-red">Videos</a>
        <a href="#training-form" class="shrink-0 hover:text-joner-red">Book</a>
        <a href="#faq" class="shrink-0 hover:text-joner-red">FAQ</a>
      </div>
    </nav>

    <section id="program" class="scroll-mt-24 bg-joner-black py-16 md:py-28">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="order-1 lg:order-2 lg:col-span-5">
            <div class="space-y-4 lg:sticky lg:top-24">
              <div class="relative overflow-hidden rounded-xl border border-white/10">
                <img src="/images/training/jfp/jfp-training-1.webp" alt="Joner Football coach working directly with a player at JFP" class="h-auto w-full object-cover" loading="lazy" />
              </div>
              <div class="grid grid-cols-2 gap-3">
                <img src="/images/training/jfp/jfp-training-2.jpg" alt="JFP players training in Sydney" class="aspect-square w-full rounded-lg border border-white/10 object-cover" loading="lazy" />
                <img src="/images/training/jfp/jfp-training-4.webp" alt="Joner Football Performance technical training" class="aspect-square w-full rounded-lg border border-white/10 object-cover" loading="lazy" />
              </div>
            </div>
          </div>

          <div class="order-2 lg:order-1 lg:col-span-7">
            <div class="mb-4 inline-block bg-joner-red px-3 py-1 font-heading text-xs uppercase tracking-widest text-white">The Program</div>
            <h2 class="mb-8 font-heading text-4xl font-bold uppercase leading-tight text-white md:text-5xl lg:text-6xl">
              Built to help players reach their full potential.
            </h2>
            <p class="mb-6 font-body text-base leading-relaxed text-neutral-300 md:text-lg">
              Since 2013, JFP has developed thousands of Sydney players. Many have gone on to elite youth squads, professional, and international football.
            </p>
            <div class="mb-8 rounded-r-lg border-l-4 border-joner-red bg-white/5 py-4 pl-6 pr-4">
              <p class="font-heading text-lg uppercase leading-snug tracking-wide text-white md:text-xl">
                Ages 8 and over. All ability levels. Term by term, up to three sessions a week.
              </p>
            </div>

            <div class="mb-10 grid grid-cols-1 gap-4 sm:grid-cols-3">
              {pillars.map((pillar) => (
                <div class="rounded-lg border border-white/10 bg-white/5 p-5">
                  <div class="mb-2 font-heading text-sm uppercase tracking-widest text-joner-red">{pillar.number}</div>
                  <h3 class="mb-2 font-heading text-lg uppercase tracking-wide text-white">{pillar.title}</h3>
                  <p class="font-body text-sm leading-relaxed text-neutral-400">{pillar.text}</p>
                </div>
              ))}
            </div>

            <a href="#training-form" class="btn-red text-sm">Book Now</a>
          </div>
        </div>
      </div>
    </section>

    <section id="what-you-get" class="scroll-mt-24 bg-joner-black py-16 md:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-black">
          <img
            src="/images/training/jfp/jfp-what-you-get.png"
            alt="Lee Jones outside the Joner Football HQ in Belrose"
            class="absolute inset-0 h-full w-full object-cover object-[70%_center] md:object-[75%_center]"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-black via-black/85 to-black/30 md:from-black md:via-black/80 md:to-transparent"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent md:hidden"></div>

          <div class="relative z-10 px-6 py-12 sm:px-10 sm:py-16 md:px-14 md:py-20 lg:py-28">
            <div class="max-w-xl">
              <p class="mb-3 font-heading text-xs uppercase tracking-[0.28em] text-joner-red sm:text-sm">What players get</p>
              <h2 class="mb-8 font-heading text-4xl font-bold uppercase leading-tight text-white sm:text-5xl md:text-6xl">
                Better habits every term.
              </h2>
              <ul class="mb-10 space-y-3">
                {points.map((point) => (
                  <li class="flex items-start gap-3 font-heading text-sm uppercase leading-snug tracking-wide text-white sm:text-base md:text-lg">
                    <span class="mt-[2px] inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-joner-red text-[10px] font-bold text-white sm:h-6 sm:w-6 sm:text-xs">✓</span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
              <a href="#training-form" class="btn-red text-sm">Book Now</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="locations" class="scroll-mt-24 bg-joner-black py-16 md:py-24 relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(227,6,19,0.12),transparent_60%)] pointer-events-none"></div>
      <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-10 text-center">
          <p class="mb-3 font-heading text-sm uppercase tracking-widest text-joner-red">North Turramurra | Belrose HQ | Rydalmere Park</p>
          <h2 class="font-heading text-4xl font-bold uppercase leading-tight text-white md:text-5xl lg:text-6xl">
            Locations
          </h2>
        </div>
        <div class="mb-10 grid grid-cols-1 gap-5 md:grid-cols-3">
          {locations.map((location) => (
            <article class="flex flex-col rounded-xl border border-white/10 bg-black/45 p-6 backdrop-blur-sm">
              <h3 class="mb-4 font-heading text-2xl uppercase leading-none text-white">{location.title}</h3>
              <p class="mb-5 flex-1 font-body text-sm leading-relaxed text-neutral-400 md:text-base">{location.text}</p>
              <a
                href={location.mapUrl}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 self-start font-heading text-xs uppercase tracking-[0.22em] text-joner-red hover:text-white"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
                <span>Open in Google Maps</span>
              </a>
            </article>
          ))}
        </div>
        <div class="text-center">
          <a href="#training-form" class="btn-red text-sm">Book Now</a>
        </div>
      </div>
    </section>

    <section id="unlocks" class="scroll-mt-24 bg-gradient-to-b from-joner-black via-joner-gray to-joner-black py-16 md:py-24 relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(227,6,19,0.14),transparent_60%)] pointer-events-none"></div>
      <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-10 text-center">
          <p class="mb-3 font-heading text-sm uppercase tracking-widest text-joner-red">Inside JFP</p>
          <h2 class="font-heading text-4xl font-bold uppercase leading-tight text-white md:text-5xl lg:text-6xl">
            What JFP unlocks.
          </h2>
        </div>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {unlocks.map((item) => (
            <article class="rounded-lg border border-white/10 bg-white/5 p-5">
              <h4 class="mb-2 font-heading text-lg uppercase leading-tight text-white">{item.title}</h4>
              <p class="font-body text-sm leading-relaxed text-neutral-400">{item.text}</p>
            </article>
          ))}
        </div>

        <div class="mt-10 text-center">
          <a href="#training-form" class="btn-red text-sm">Book Now</a>
        </div>
      </div>
    </section>

    <section id="videos" class="scroll-mt-24 bg-joner-black py-16 md:py-24 relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(227,6,19,0.12),transparent_60%)] pointer-events-none"></div>
      <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-12 text-center">
          <p class="mb-3 font-heading text-sm uppercase tracking-widest text-joner-red">Have a look</p>
          <h2 class="font-heading text-4xl font-bold uppercase leading-tight text-white md:text-5xl lg:text-6xl">
            Watch the training environment.
          </h2>
        </div>
        <div class="mb-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
          {videos.map((video) => (
            <div class="group">
              <div class="mb-3 flex items-center gap-3 pl-1">
                <span class="h-2 w-2 rounded-full bg-joner-red"></span>
                <span class="font-heading text-[11px] uppercase tracking-[0.32em] text-white/80 sm:text-xs">{video.title}</span>
                <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent"></span>
              </div>
              <div class="relative aspect-video overflow-hidden rounded-xl border border-white/10 bg-black">
                <iframe
                  src={video.src}
                  title={video.title}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen
                  class="absolute inset-0 h-full w-full"
                ></iframe>
              </div>
            </div>
          ))}
        </div>
        <div class="text-center">
          <a href="#training-form" class="btn-red text-sm">Book Now</a>
        </div>
      </div>
    </section>

    <section id="training-form" class="scroll-mt-32 bg-joner-black py-16 md:py-24">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <div class="mb-8 text-center">
          <p class="mb-3 font-heading text-sm uppercase tracking-[0.24em] text-joner-red">Book Your Spot</p>
          <h2 class="font-heading text-3xl uppercase tracking-wide text-white sm:text-4xl">Start Your JFP Enquiry</h2>
          <p class="mx-auto mt-4 max-w-2xl font-body text-base leading-relaxed text-gray-400">
            Tell us about the player. The team will place them in the right JFP option.
          </p>
        </div>

        <form id="contact-smart-form" class="space-y-5 border border-gray-800 bg-joner-gray p-5 md:p-8">
          <div>
            <label for="enquiryType" class="mb-2 block font-heading text-xs uppercase tracking-[0.22em] text-gray-400">What can we help with?</label>
            <select id="enquiryType" name="enquiryType" required class="min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white focus:border-joner-red focus:outline-none">
              <option value="training-sydney">JFP Training Enquiry</option>
              <option value="joners-juniors">Joners Juniors Enquiries</option>
              <option value="general">General Enquiries</option>
            </select>
            <p id="form-intro" class="mt-3 font-body text-sm text-gray-400">Tell us about the player and what type of training you are looking for.</p>
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <input data-name-field type="text" name="name" placeholder="Parent name" required class="min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
            <input type="email" name="email" placeholder="Email address" required class="min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <input type="tel" name="phone" placeholder="Phone number" required class="min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
            <select name="trainingLocation" class="min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white focus:border-joner-red focus:outline-none">
              <option value="">Preferred Sydney location</option>
              <option>HQ (Belrose)</option>
              <option>North Turramurra</option>
              <option>Rydalmere Park</option>
              <option>Other</option>
            </select>
          </div>

          <div data-fields="training-sydney joners-juniors" class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <input type="text" name="playerName" placeholder="Player name" class="conditional-required min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
            <input data-player-age-field type="text" name="playerAge" placeholder="Player age" class="conditional-required min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
          </div>

          <div data-fields="training-sydney" class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <input type="text" name="playerLevel" placeholder="Player level or team" class="min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
            <select name="trainingInterest" class="min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white focus:border-joner-red focus:outline-none">
              <option>Joner Football Performance</option>
              <option>Professional Training</option>
              <option>Private training</option>
              <option>Group training</option>
              <option>Game analysis</option>
              <option>Not sure yet</option>
            </select>
          </div>

          <div data-fields="joners-juniors" class="grid hidden grid-cols-1 gap-4 sm:grid-cols-2">
            <select name="juniorProgram" class="min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white focus:border-joner-red focus:outline-none">
              <option value="">Program interest</option>
              <option>Joners Juniors</option>
              <option>Joner Football Performance pathway</option>
              <option>Not sure yet</option>
            </select>
            <input type="text" name="parentGoal" placeholder="Main goal for the player" class="min-h-[52px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
          </div>

          <textarea name="message" placeholder="Message" required rows="5" class="w-full resize-none border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none"></textarea>

          <label class="flex gap-3 border border-gray-800 bg-joner-black/60 p-4 font-body text-sm leading-relaxed text-gray-300">
            <input type="checkbox" name="marketingOptIn" value="true" class="mt-1 h-4 w-4 shrink-0 accent-joner-red" />
            <span>Yes, send me Joner Football updates, offers, app news, camps, and training tips by email.</span>
          </label>

          <p id="contact-form-status" class="hidden font-body text-sm"></p>
          <button type="submit" class="btn-red w-full text-sm">Send JFP Enquiry</button>
        </form>
      </div>
    </section>

    <section id="faq" class="scroll-mt-24 bg-joner-black py-16 md:py-24">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-10 text-center">
          <p class="mb-3 font-heading text-sm uppercase tracking-widest text-joner-red">Frequently Asked Questions</p>
          <h2 class="font-heading text-4xl font-bold uppercase leading-tight text-white md:text-5xl">Know before you book.</h2>
        </div>
        <div class="mb-10 space-y-3">
          {faqs.map(([question, answer]) => (
            <details class="group rounded-lg border border-white/10 bg-white/5 p-5">
              <summary class="flex cursor-pointer list-none justify-between gap-4 font-heading text-xl uppercase leading-tight text-white">
                <span>{question}</span>
                <span class="text-joner-red transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="mt-4 font-body text-base leading-relaxed text-neutral-400">{answer}</p>
            </details>
          ))}
        </div>
        <div class="text-center">
          <a href="#training-form" class="btn-red text-sm">Book Now</a>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    (function () {
      var options = {
        'training-sydney': {
          intro: 'Tell us about the player and what type of JFP training you are looking for.',
          button: 'Send JFP Enquiry'
        },
        'general': {
          intro: 'Ask us anything and the team will point you in the right direction.',
          button: 'Send General Enquiry'
        },
        'joners-juniors': {
          intro: 'For parents enquiring about the Joners Juniors program.',
          button: 'Send Joners Juniors Enquiry'
        }
      };

      var form = document.getElementById('contact-smart-form');
      if (!form) return;
      var typeSelect = form.querySelector('[name="enquiryType"]');
      var intro = document.getElementById('form-intro');
      var submit = form.querySelector('button[type="submit"]');
      var status = document.getElementById('contact-form-status');

      function setStatus(message, ok) {
        if (!status) return;
        status.textContent = message || '';
        status.className = message ? 'font-body text-sm ' + (ok ? 'text-green-400' : 'text-amber-400') : 'hidden font-body text-sm';
      }

      function syncNamePlaceholder() {
        var selected = typeSelect.value || 'training-sydney';
        var nameField = form.querySelector('[data-name-field]');
        var playerAgeField = form.querySelector('[data-player-age-field]');
        if (!nameField) return;
        if (selected !== 'training-sydney') {
          nameField.placeholder = 'Full name';
          return;
        }
        var age = playerAgeField ? parseInt(String(playerAgeField.value || '').replace(/[^0-9]/g, ''), 10) : NaN;
        nameField.placeholder = age >= 18 ? 'Full name' : 'Parent name';
      }

      function syncFields() {
        var selected = typeSelect.value || 'training-sydney';
        var config = options[selected] || options['training-sydney'];
        if (intro) intro.textContent = config.intro;
        if (submit) submit.textContent = config.button;

        form.querySelectorAll('[data-fields]').forEach(function (group) {
          var show = String(group.getAttribute('data-fields') || '').split(' ').indexOf(selected) !== -1;
          group.classList.toggle('hidden', !show);
          group.querySelectorAll('input, select, textarea').forEach(function (field) {
            field.disabled = !show;
            if (field.classList.contains('conditional-required')) field.required = show;
          });
        });
        syncNamePlaceholder();
      }

      typeSelect.addEventListener('change', function () {
        setStatus('', true);
        syncFields();
      });
      var playerAgeField = form.querySelector('[data-player-age-field]');
      if (playerAgeField) playerAgeField.addEventListener('input', syncNamePlaceholder);
      syncFields();

      form.addEventListener('submit', function (event) {
        event.preventDefault();
        setStatus('', true);
        var originalText = submit ? submit.textContent : 'Send Enquiry';
        var formData = new FormData(form);
        var emailInput = form.querySelector('input[name="email"]');

        if (window.JonerEmailGuard && emailInput) {
          var validation = window.JonerEmailGuard.validateEmail(formData.get('email'));
          window.JonerEmailGuard.setFeedback(emailInput, validation);
          if (!validation.valid) {
            emailInput.reportValidity();
            return;
          }
        }

        if (submit) {
          submit.disabled = true;
          submit.textContent = 'Sending...';
          submit.classList.add('opacity-70', 'cursor-not-allowed');
        }

        var payload = {};
        formData.forEach(function (value, key) {
          if (!(value instanceof File)) payload[key] = value;
        });
        if (payload.trainingLocation) payload.location = payload.trainingLocation;
        payload.marketingOptIn = formData.get('marketingOptIn') === 'true';

        var tokenPromise = window.JonerRecaptcha && window.JonerRecaptcha.getToken
          ? window.JonerRecaptcha.getToken('contact')
          : Promise.resolve('');

        tokenPromise.then(function (token) {
          payload.recaptchaToken = token;
          return fetch('/api/contact-enquiry', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
        })
        .then(function (response) { return response.json(); })
        .then(function (data) {
          if (!data || !data.success) throw new Error((data && data.error) || 'Could not send enquiry.');
          form.reset();
          syncFields();
          setStatus('Done. Your enquiry has been sent.', true);
        })
        .catch(function (error) {
          setStatus(error && error.message ? error.message : 'Could not send enquiry. Please try again.', false);
        })
        .finally(function () {
          if (submit) {
            submit.disabled = false;
            submit.textContent = originalText;
            submit.classList.remove('opacity-70', 'cursor-not-allowed');
          }
        });
      });
    })();
  </script>

  <style>
    .spotlight {
      position: absolute;
      pointer-events: none;
      filter: blur(45px);
      opacity: 0.55;
      z-index: 0;
    }
    .spotlight-a {
      width: 280px;
      height: 280px;
      left: -90px;
      top: -80px;
      background: rgba(227, 6, 19, 0.5);
      border-radius: 999px;
    }
    .spotlight-b {
      width: 360px;
      height: 360px;
      right: -140px;
      bottom: -120px;
      background: rgba(255, 255, 255, 0.12);
      border-radius: 999px;
    }
    .no-scrollbar {
      scrollbar-width: none;
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
  </style>
</BaseLayout>
