---
import BaseLayout from '../../layouts/BaseLayout.astro'

import { faqSchema, breadcrumbSchema, webPageSchema } from '../../lib/seoSchema'
import { venues, venuePath, jfpTerm, jfpServiceSchema, JFP_URL, SITE } from '../../data/jfp-public.js'

const title = 'JFP Small Group Football Training in Sydney | Joner Football'
const description = 'Joner Football Performance (JFP): small group football training from age 3 right up to pro, all levels, at our indoor HQ in Belrose, North Turramurra and Rydalmere.'
const canonical = JFP_URL

const stats = [
  { value: '2013', label: 'Program launched' },
  { value: '3 to pro', label: 'Ages' },
  { value: '10 week', label: 'Term program' },
  { value: '3x', label: 'Train weekly' },
  { value: '3', label: 'Sydney locations' },
]

const locations = venues.map((v) => ({
  title: v.name,
  area: v.area,
  text: v.card,
  href: venuePath(v),
  mapUrl: v.maps,
}))

const pathwayStages = [
  {
    number: '01',
    age: 'Starts here · Ages 3 to 6',
    title: 'Joner Juniors',
    text: 'First touches, first smiles. Building love for the ball from day one.',
  },
  {
    number: '02',
    age: 'Ages 6 to 8',
    title: '6 to 8 Year Old Program',
    text: 'Technical foundations. Coordination, weak foot, fun-first reps.',
  },
  {
    number: '03',
    age: 'Ages 3 to pro',
    title: 'JFP, Joner Football Performance',
    text: 'Our flagship program. Elite technical and tactical development. Where players make the jump.',
    flagship: true,
  },
  {
    number: '04',
    age: 'Selected JFP players',
    title: 'Game Analysis',
    text: '1-to-1 video breakdown. See your game like the pros, strengths, decisions, what to fix.',
  },
  {
    number: '05',
    age: 'The next step',
    title: 'Careers in Football',
    text: 'Trials, college pathways, clubs and contacts. Helping our players take it as far as they want to go.',
  },
]

const includes = [
  { title: '10 Week Terms', text: 'Clear term structure to build habits and measure progress.' },
  { title: 'Player Reports', text: 'Development feedback so parents and players know what is improving.' },
  { title: 'Elite Coaching', text: 'High-detail technical coaching from the Joner Football team.' },
  { title: 'Joner App', text: 'Continue training away from sessions with app-based drills.' },
  { title: 'Strength And Conditioning', text: 'Physical development support around the player.' },
  { title: 'Game Analysis', text: 'Video and game detail to improve decisions faster.' },
  { title: 'Mentorship', text: 'Guidance on standards, mindset, and training habits.' },
  { title: 'High Level Training', text: 'A demanding environment for players chasing a football career.' },
]

const points = [
  'Early morning, weekday afternoon, and Saturday morning options',
  'Ages 3 to pro, all levels and abilities',
  '10 week term to term program',
  'For dedicated players only',
  'Improve technically, physically, and mentally',
  'Group and individual training options',
  'Limited spots available each term',
]

// Real JFP sessions from Instagram, in the order Lee chose (the first plays first).
const reels = ['DcuW0kpSNvj', 'DdQr9zfy2eI', 'Db7XJ4LS8EV', 'DbLG35zyndy', 'Dd5I5CLjxJp', 'DcvIRohBDU-', 'DcQQkUUyNMQ', 'DXyRpezAWwD']
// Lee coaching on the Joner Football YouTube channel. Each card is a still
// until tapped, so the row swipes smoothly and the page stays light.
const coaching = [
  { id: 'EKclfr4Q3l8', title: 'How I Coach Dribbling at Full Speed' },
  { id: 'HVauEJkSwdI', title: 'How I Coach Players Who Panic Under Pressure' },
  { id: 'MuTf56qU3oc', title: 'How I Coach Midfielders to Think Faster' },
  { id: '6Lk7pztLhEw', title: 'Inside Training with Adrian Segecic and Alex Robertson' },
  { id: 'bpsnUbP0U8s', title: 'How I Coach Players to Be More Physical' },
  { id: '8xfWkNLdVYE', title: 'How I Coach First Touch Under Pressure' },
  { id: 'uBlSzlbvsvo', title: 'How I Coach Defensive Attributes Every Footballer Needs' },
  { id: 'l5__i4F-l_I', title: 'How I Coach Wingers to Be More Direct' },
  { id: 'Yi7Y5CV9P8Y', title: 'First Touch Under Pressure: 1v2 Group Training' },
  { id: 'dcw7bayv3Ok', title: 'How I Coach Different Ages With One Setup' },
  { id: 'eCmL9QiFtVk', title: 'Full 1 on 1 Session at Joner Football HQ' },
  { id: '-V88Iy1X-is', title: 'Passing Drills to Improve Speed and Accuracy' },
]

// Visible FAQ and FAQPage JSON-LD come from this one list, so they always match.
const faqItems = [
  { q: 'What is JFP?', a: 'JFP (Joner Football Performance) is Joner Football\'s term by term small group football training program in Sydney, run since 2013. Players train technically, physically and mentally in 60 minute sessions, up to three times a week.' },
  { q: 'What ages is JFP for?', a: 'From age 3 right up to pro players, all levels and abilities. The youngest players, aged 3 to 6, start in Joners Juniors on Saturday mornings at Belrose HQ.' },
  { q: 'Where does JFP train?', a: 'At three places in Sydney: the indoor Joner Football HQ in Belrose on the Northern Beaches, North Turramurra Recreation Area on the Upper North Shore (Wednesday and Thursday mornings), and Rydalmere Park near Parramatta (Friday mornings).' },
  { q: 'How do terms work?', a: `JFP runs in ${jfpTerm.weeks} week terms with one 60 minute session a week in each group you join. ${jfpTerm.term} runs from ${jfpTerm.termRange}.` },
  { q: 'How much does JFP cost?', a: 'Prices are shown on the booking page when you choose a session. Joining late? You only pay for the sessions left.', link: { href: '/jfp-booking/', label: 'Open the booking page' } },
  { q: 'Can my child do a trial session?', a: 'Yes. When you apply, coaches may offer a trial session first. The trial fee comes off the term fee if your player joins.' },
  { q: 'What kit does my child need?', a: 'The JF playing kit is compulsory for every JFP player and is ordered from BE Teamsport. Players also need boots for synthetic grass, shin guards, a drink bottle and a waterproof jacket.' },
  { q: 'How do I book?', a: 'Open the JFP timetable on the booking page, pick the sessions that suit you and apply. You can apply for more than one session at once. We reply to each within 48 hours with a place, a trial first, or a group that suits better.' },
  { q: 'Who will be in my son or daughter\'s group?', a: groupingLine },
  { q: 'Will bad weather cancel the session?', a: 'No. Only really bad storms can alter the session. Belrose HQ sessions are indoors, so bad weather is far less of a problem.' },
  { q: oneToOneFaq.q, a: oneToOneFaq.a },
]

const schema = [
  webPageSchema({ name: title, description, url: JFP_URL }),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE}/` },
    { name: 'Sydney Football Training', url: `${SITE}/training/` },
    { name: 'JFP Program', url: JFP_URL },
  ]),
  jfpServiceSchema(),
  faqSchema(faqItems),
]


import SanityPageRenderer from '../../components/sanity/SanityPageRenderer.astro'
import BookNowButton from '../../components/BookNowButton.astro'
import BookNowPanel from '../../components/BookNowPanel.astro'
import TermWorks from '../../components/TermWorks.astro'
import { groupingLine } from '../../data/jfp-term-info.js'
import { oneToOneFaq } from '../../data/jfp-one-to-one.js'
import CreateAccountButton from '../../components/CreateAccountButton.astro'
import { BOOKING_URL } from '../../lib/booking'
import { fetchSanityPage } from '../../lib/sanityPages'
import { shouldReplaceSanityPage } from '../../lib/sanityPageUtils'

const sanityPage = await fetchSanityPage('jfp-program')
---

{shouldReplaceSanityPage(sanityPage) ? (
  <SanityPageRenderer page={sanityPage} />
) : (
<BaseLayout title={title} description={description} canonical={canonical} schema={schema} ogImage={`${SITE}/images/training/jfp/jfp-training-1.webp`} hideMobileAppCta>
  <Fragment slot="head">
  </Fragment>

  <main class="bg-joner-black text-white">
    <section class="bg-joner-black pt-10 pb-12 md:pt-16 md:pb-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-black">
          <div class="spotlight spotlight-a" aria-hidden="true"></div>
          <div class="spotlight spotlight-b" aria-hidden="true"></div>
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(227,6,19,0.2),transparent_56%)] pointer-events-none"></div>
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,rgba(255,255,255,0.07),transparent_60%)] pointer-events-none"></div>

          <div class="relative z-10 flex min-h-[620px] flex-col lg:min-h-[700px] lg:flex-row">
            <div class="flex flex-1 flex-col justify-center px-6 py-10 sm:px-10 sm:py-14 lg:p-14">
              <p class="mb-4 font-heading text-xs uppercase tracking-[0.25em] text-joner-red sm:text-sm">Small group football training, Sydney</p>
              <h1 class="mb-6 text-white font-heading text-[clamp(2.25rem,11.5vw,3rem)] font-bold uppercase leading-[1] sm:text-6xl md:text-7xl lg:text-8xl">
                Joner Football<br />Performance
              </h1>
              <p class="mb-8 max-w-lg font-body text-base leading-relaxed text-neutral-300 sm:text-lg">
                Small group football training from age 3 right up to pro, all levels and abilities, at our indoor HQ in Belrose, North Turramurra and Rydalmere Park. Train technically, physically, and mentally with the JFP team.
              </p>
              <div class="flex flex-wrap gap-3">
                <BookNowButton size="lg" place="jfp-program-hero" />
                <a href="#program" class="btn-outline text-sm">See The Program</a>
              </div>
            </div>

            <div class="relative min-h-[420px] flex-1 sm:min-h-[500px] lg:min-h-0">
              <video autoplay muted loop playsinline poster="/images/training/jfp/jfp-training-1.webp" class="absolute inset-0 h-full w-full object-cover object-center">
                <source src="/images/training/jfp/jfp-hero.mp4" type="video/mp4" />
              </video>
              <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_35%,rgba(255,255,255,0.14),transparent_55%)] pointer-events-none z-10"></div>
              <div class="absolute inset-y-0 left-0 hidden w-1/3 bg-gradient-to-r from-black via-black/60 to-transparent lg:block pointer-events-none"></div>
              <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black via-black/45 to-transparent pointer-events-none"></div>
            </div>
          </div>

          <div class="relative z-10 grid grid-cols-2 border-t border-white/10 bg-black/45 backdrop-blur-sm md:grid-cols-5">
            {stats.map((stat, index) => (
              <div class={`p-5 text-center ${index < stats.length - 1 ? 'md:border-r' : ''} border-white/10 ${index > 1 ? 'border-t md:border-t-0' : ''}`}>
                <div class={`font-heading text-2xl font-bold md:text-3xl ${index === 0 || index === 4 ? 'text-joner-red' : 'text-white'}`}>{stat.value}</div>
                <div class="mt-1 font-body text-[10px] uppercase tracking-wider text-neutral-500 sm:text-xs">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="videos" class="scroll-mt-24 bg-joner-black pb-14 pt-2 md:pb-20 relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(227,6,19,0.12),transparent_60%)] pointer-events-none"></div>
      <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-12 text-center">
          <p class="mb-3 font-heading text-sm uppercase tracking-widest text-joner-red">Have a look</p>
          <h2 class="font-heading text-4xl font-bold uppercase leading-tight text-white md:text-5xl lg:text-6xl">
            Watch the training environment.
          </h2>
        </div>
        <div class="mb-12">
          <div class="mb-4 flex items-center gap-3 pl-1">
            <span class="h-2 w-2 rounded-full bg-joner-red"></span>
            <span class="font-heading text-[11px] uppercase tracking-[0.32em] text-white/80 sm:text-xs">Inside JFP training</span>
            <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent"></span>
            <span class="hidden gap-2 md:flex">
              <button type="button" class="jfp-reels-nav grid h-10 w-10 place-items-center rounded-full border border-white/20 text-white hover:border-white/60" data-dir="-1" aria-label="Previous video">&larr;</button>
              <button type="button" class="jfp-reels-nav grid h-10 w-10 place-items-center rounded-full border border-white/20 text-white hover:border-white/60" data-dir="1" aria-label="Next video">&rarr;</button>
            </span>
          </div>
          <div id="jfp-reels" class="-mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth px-4 pb-4 sm:mx-0 sm:px-0 [&::-webkit-scrollbar]:hidden" style="scrollbar-width:none;overscroll-behavior-x:contain">
            {reels.map((id, i) => (<>
              {i === 1 && (
                <div class="relative w-[300px] shrink-0 snap-start overflow-hidden rounded-xl border border-white/10 bg-black sm:w-[330px]">
                  <video controls playsinline preload="none" poster="/videos/houston-parent-reel-poster.webp" class="block h-[520px] w-full object-cover sm:h-[560px]">
                    <source src="/videos/houston-parent-reel-sound.mp4" type="video/mp4" />
                  </video>
                  <span class="pointer-events-none absolute left-3 top-3 rounded-full bg-joner-red px-3 py-1 font-body text-xs font-bold text-white">What parents say</span>
                </div>
              )}
              <div class="w-[300px] shrink-0 snap-start overflow-hidden rounded-xl border border-white/10 bg-white sm:w-[330px]">
                <iframe
                  src={`https://www.instagram.com/p/${id}/embed/`}
                  title={`JFP training video ${i + 1}`}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  scrolling="no"
                  allow="autoplay; encrypted-media; picture-in-picture; web-share"
                  class="block h-[520px] w-full border-0 sm:h-[560px]"
                ></iframe>
              </div>
            </>))}
          </div>
          <p class="mt-2 pl-1 text-sm text-white/60">Swipe to see more. Tap a video to play it.</p>
          <script is:inline>
            document.querySelectorAll('.jfp-reels-nav').forEach((b) => b.addEventListener('click', () => {
              const row = document.getElementById('jfp-reels')
              if (row) row.scrollBy({ left: Number(b.dataset.dir) * 346, behavior: 'smooth' })
            }))
          </script>
        </div>
        <div class="mb-10">
          <div class="mb-4 flex items-center gap-3 pl-1">
            <span class="h-2 w-2 rounded-full bg-joner-red"></span>
            <span class="font-heading text-[11px] uppercase tracking-[0.32em] text-white/80 sm:text-xs">How we coach</span>
            <span class="h-px flex-1 bg-gradient-to-r from-white/15 to-transparent"></span>
            <span class="hidden gap-2 md:flex">
              <button type="button" class="jfp-yt-nav grid h-10 w-10 place-items-center rounded-full border border-white/20 text-white hover:border-white/60" data-dir="-1" aria-label="Previous video">&larr;</button>
              <button type="button" class="jfp-yt-nav grid h-10 w-10 place-items-center rounded-full border border-white/20 text-white hover:border-white/60" data-dir="1" aria-label="Next video">&rarr;</button>
            </span>
          </div>
          <div id="jfp-yt" class="-mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth px-4 pb-3 sm:mx-0 sm:px-0 [&::-webkit-scrollbar]:hidden" style="scrollbar-width:none;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain">
            {coaching.map((v) => (
              <div class="w-[280px] shrink-0 snap-start sm:w-[340px]">
                <button type="button" class="jfp-yt-card group relative block aspect-video w-full overflow-hidden rounded-xl border border-white/10 bg-black" data-yt={v.id} aria-label={`Play: ${v.title}`}>
                  <img src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]" />
                  <span class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></span>
                  <span class="absolute left-1/2 top-1/2 grid h-12 w-12 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-joner-red text-white shadow-lg">&#9654;</span>
                </button>
                <p class="mt-2 line-clamp-2 pl-1 text-sm font-medium leading-snug text-white/90">{v.title}</p>
              </div>
            ))}
          </div>
          <p class="mt-1 pl-1 text-sm text-white/60">Swipe for more. <a href="https://www.youtube.com/@jonerfootball" target="_blank" rel="noopener noreferrer" class="-my-3 inline-block py-3 underline hover:text-white">All videos on YouTube</a></p>
          <script is:inline>
            document.querySelectorAll('.jfp-yt-nav').forEach((b) => b.addEventListener('click', () => {
              const row = document.getElementById('jfp-yt')
              if (row) row.scrollBy({ left: Number(b.dataset.dir) * 356, behavior: 'smooth' })
            }))
            // Tap a still: swap in the player and start it.
            document.querySelectorAll('.jfp-yt-card').forEach((c) => c.addEventListener('click', () => {
              const f = document.createElement('iframe')
              f.src = 'https://www.youtube-nocookie.com/embed/' + c.dataset.yt + '?autoplay=1&rel=0&playsinline=1'
              f.title = c.getAttribute('aria-label') || 'Joner Football video'
              f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
              f.allowFullscreen = true
              f.className = 'absolute inset-0 h-full w-full'
              const box = document.createElement('div')
              box.className = 'relative aspect-video w-full overflow-hidden rounded-xl border border-white/10 bg-black'
              box.appendChild(f)
              c.replaceWith(box)
            }))
          </script>
        </div>
        <div class="text-center">
          <BookNowButton place="jfp-program-videos" />
        </div>
      </div>
    </section>

    <nav class="sticky top-0 z-30 border-y border-white/10 bg-joner-black/92 backdrop-blur">
      <div class="jfp-subnav mx-auto flex max-w-7xl gap-6 overflow-x-auto px-4 py-0.5 font-heading text-xs uppercase tracking-[0.22em] text-white sm:px-6 lg:px-8 no-scrollbar">
        <a href="#pathway" class="shrink-0 hover:text-joner-red">Pathway</a>
        <a href="#program" class="shrink-0 hover:text-joner-red">Program</a>
        <a href="#what-you-get" class="shrink-0 hover:text-joner-red">What You Get</a>
        <a href="#locations" class="shrink-0 hover:text-joner-red">Locations</a>
        <a href="#includes" class="shrink-0 hover:text-joner-red">Inside JFP</a>
        <a href="#videos" class="shrink-0 hover:text-joner-red">Videos</a>
        <a href={BOOKING_URL} class="shrink-0 text-joner-red hover:text-white" data-book-now="jfp-program-subnav">Book now</a>
        <a href="#training-form" class="shrink-0 hover:text-joner-red">Enquire</a>
        <a href="#faq" class="shrink-0 hover:text-joner-red">FAQ</a>
      </div>
    </nav>

    <section id="pathway" class="pathway scroll-mt-24 relative overflow-hidden bg-black text-white">
      <div class="pathway-photo absolute inset-0 pointer-events-none" aria-hidden="true"></div>
      <div class="pathway-scrim absolute inset-0 pointer-events-none" aria-hidden="true"></div>

      <div class="relative z-10 mx-auto max-w-[1280px] px-5 py-20 md:py-24 lg:px-8">
        <div class="mb-12 flex max-w-[760px] flex-col gap-3 md:mb-14">
          <span class="font-heading text-[11px] italic uppercase tracking-[0.22em] text-joner-red sm:text-xs">JFP · Player Pathway</span>
          <h2 class="font-heading text-[clamp(2rem,5vw,3.6rem)] font-black italic uppercase leading-[0.95] tracking-[0.04em] text-white">
            From first <span class="text-joner-red">touch</span><br />to a career in football.
          </h2>
          <span class="mt-2 block h-[3px] w-16 bg-joner-red"></span>
          <p class="mt-1 max-w-[580px] font-body text-base leading-[1.55] text-white/70">
            One pathway. Every age. We grow players from their first session as a Joner Junior all the way to game analysis and helping them build a career in the game.
          </p>
        </div>

        <ol class="pathway-tree relative flex flex-col gap-0 pl-7 md:flex-row md:items-stretch md:gap-2 md:pl-0">
          {pathwayStages.map((stage, index) => (
            <li class={`pathway-node relative flex gap-[18px] py-6 md:flex-1 md:flex-col md:py-0 md:pt-14 ${stage.flagship ? 'is-flagship' : ''}`}>
              <span class="pathway-stage absolute left-[-28px] top-[26px] z-[2] flex h-14 w-14 -translate-x-1/2 items-center justify-center rounded-full border-2 border-joner-red bg-black font-heading text-xl italic font-black text-joner-red md:left-1/2 md:top-0 md:-translate-x-1/2 md:translate-y-0">
                {stage.number}
              </span>

              <div class="pathway-card relative ml-9 flex flex-1 flex-col gap-[10px] border border-white/10 bg-[#0a0a0a] p-[22px] md:ml-0 md:min-h-full md:p-[28px_22px_24px]">
                {stage.flagship && (
                  <span class="absolute -top-[10px] right-[18px] bg-joner-red px-[10px] py-[5px] font-heading text-[10px] italic font-black uppercase tracking-[0.22em] text-white">Flagship</span>
                )}
                <span class="font-heading text-[11px] italic font-semibold uppercase tracking-[0.22em] text-joner-red">{stage.age}</span>
                <h3 class="font-heading text-[clamp(1.3rem,3vw,1.7rem)] font-black italic uppercase leading-[1.05] tracking-[0.04em] text-white">{stage.title}</h3>
                <p class="font-body text-[14.5px] leading-[1.5] text-white/75">{stage.text}</p>
              </div>

              {index < pathwayStages.length - 1 && (
                <span class="pathway-arrow absolute -bottom-[14px] left-[-1px] z-[3] -translate-x-1/2 text-joner-red md:hidden" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6" /></svg>
                </span>
              )}
            </li>
          ))}
        </ol>

        <div class="mt-9 flex flex-col gap-2 border border-joner-red/50 border-l-[3px] border-l-joner-red bg-gradient-to-b from-joner-red/[0.18] to-joner-red/[0.04] p-[22px_24px] md:mt-14">
          <span class="font-heading text-[11px] italic font-semibold uppercase tracking-[0.22em] text-joner-red">The Joner Way</span>
          <span class="font-heading text-[clamp(1.2rem,3vw,1.6rem)] font-black italic uppercase leading-[1.05] tracking-[0.04em] text-white">
            One pathway. <span class="text-joner-red">One family.</span>
          </span>
        </div>

        <div class="mt-14 flex flex-wrap justify-center gap-[14px]">
          <a href="#training-form" class="btn-glass">
            <span>Book a trial</span>
            <span class="btn-glass-underline" aria-hidden="true"></span>
          </a>
          <a href="#program" class="btn-glass">
            <span>Learn about JFP</span>
            <span class="btn-glass-underline" aria-hidden="true"></span>
          </a>
        </div>
      </div>
    </section>

    <section id="program" class="scroll-mt-24 bg-joner-black py-16 md:py-28">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="order-1 lg:order-2 lg:col-span-5">
            <div class="space-y-4 lg:sticky lg:top-24">
              <div class="relative overflow-hidden rounded-xl border border-white/10">
