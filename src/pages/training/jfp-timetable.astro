---
import BaseLayout from '../../layouts/BaseLayout.astro';
import timetable from '../../data/jfp-timetable-preview.json';
const days = ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];
const locations = [...new Set(timetable.sessions.map(s => s.location))];
const minutes = (value: string) => { const m = value.match(/(\d+)(?::(\d+))?(am|pm)/)!; return (Number(m[1]) % 12 + (m[3] === 'pm' ? 12 : 0)) * 60 + Number(m[2] || 0); };
const sessions = [...timetable.sessions].sort((a,b) => days.indexOf(a.day)-days.indexOf(b.day) || minutes(a.time)-minutes(b.time));
---
<BaseLayout title="JFP Term Timetable | Joner Football" description="Find your weekly Joner Football Performance training group." noindex hideMobileAppCta>
  <main class="min-h-screen bg-neutral-950 text-white">
    <div class="bg-amber-200 px-6 py-3 text-center text-sm text-black">Preview · Timetable snapshot, 23 September. Availability is awaiting review. Bookings and payments are not open.</div>
    <section class="relative overflow-hidden border-b border-white/10">
      <img src="/images/training/jfp/jfp-training-1.webp" alt="Joner Football training" class="absolute inset-0 h-full w-full object-cover opacity-20" />
      <div class="relative mx-auto max-w-6xl px-6 py-16">
        <p class="mb-4 text-sm font-bold uppercase tracking-widest text-red-400">Joner Football Performance · Term 4</p>
        <h1 class="font-heading text-5xl uppercase leading-none md:text-7xl">Find your weekly<br />training spot.</h1>
        <p class="mt-6 max-w-2xl text-lg text-neutral-200">Choose a day, find a time and check the group suits your player. One weekly place for the ten-week term.</p>
        <p class="mt-5 font-bold">12 October – 19 December 2026 · 10 weeks</p>
      </div>
    </section>
    <section class="mx-auto max-w-6xl px-6 py-10">
      <div class="mb-8 flex flex-wrap gap-3 text-sm"><span class="rounded-full border border-white/20 px-4 py-2">Term 4 · 10 weeks</span><span class="rounded-full border border-white/20 px-4 py-2">Same time each week</span></div>
      <div class="mb-7 flex gap-2" aria-label="Timetable view"><button data-view="find" aria-pressed="true" class="rounded-lg border border-white/20 px-5 py-3 font-bold aria-pressed:bg-white aria-pressed:text-black">Find a session</button><button data-view="week" aria-pressed="false" class="rounded-lg border border-white/20 px-5 py-3 font-bold aria-pressed:bg-white aria-pressed:text-black">Weekly overview</button></div>
      <h2 class="font-heading text-3xl uppercase">Choose the days that suit you</h2><p class="mt-2 text-sm text-neutral-400">Select more than one day, or show the whole week.</p><button id="all-days" class="mt-3 text-sm underline">Show all days</button>
      <div class="my-5 flex flex-wrap gap-2" aria-label="Training day">{days.filter(day=>sessions.some(s=>s.day===day)).map((day,i)=><button data-day-choice={day} aria-pressed={i===0?'true':'false'} class="rounded-full border border-white/20 px-5 py-3 font-bold aria-pressed:bg-red-600 aria-pressed:border-red-600 hover:border-white">{day}</button>)}</div>
      <div class="mb-8 grid gap-3 md:grid-cols-2"><p class="rounded-xl border border-emerald-400/30 bg-emerald-400/5 p-4 text-sm"><strong class="text-emerald-300">Book a place</strong><br />Open groups: book directly when a suitable place is available.</p><p class="rounded-xl border border-violet-400/30 bg-violet-400/5 p-4 text-sm"><strong class="text-violet-300">Apply for a place</strong><br />Ability-based groups: apply first. Pay only after approval.</p></div>
      <h2 class="mb-5 font-heading text-3xl uppercase">2. Choose your time</h2>
      <div class="mb-8 flex flex-wrap items-end gap-4">
        <label class="grid gap-2 text-sm">Location<select id="location" class="rounded-lg border border-white/20 bg-neutral-900 p-3"><option value="">All locations</option>{locations.map(location=><option>{location}</option>)}</select></label>
        <p id="result-count" class="pb-3 text-sm text-neutral-400" aria-live="polite">{sessions.length} timetable entries to review</p>
      </div>
      <p class="mb-6 max-w-3xl text-sm text-neutral-400">These times come from the Term 4 roster. Group ages, coaches, fees and available places still need confirmation before bookings open. Current players’ details remain private.</p>
      <div id="session-cards" class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {sessions.map(session=><article data-session data-day={session.day} data-location={session.location} hidden={session.day!=="Monday"} class="rounded-2xl border border-white/15 bg-neutral-900 p-6">
          <p class="text-sm font-bold text-red-400">{session.location}</p>
          <h2 class="mt-3 font-heading text-3xl uppercase">{session.day} · {session.time}</h2>
          <p class="mt-2 text-sm text-neutral-300">Weekly place · 10-week programme</p>
          <dl class="my-5 grid gap-3 text-sm"><div><dt class="text-neutral-500">Coach</dt><dd>To be confirmed</dd></div><div><dt class="text-neutral-500">Age & ability</dt><dd>Group details coming soon</dd></div></dl><p class="mb-5 text-xs text-amber-200">Booking type and availability to be confirmed</p>
          <button data-review={`${session.day} ${session.time} · ${session.location}`} class="w-full rounded-full bg-white px-4 py-3 font-bold text-black hover:bg-neutral-200">View session</button>
        </article>)}
      </div>
      <div id="weekly-view" hidden class="overflow-x-auto rounded-xl border border-white/15"><table class="w-full min-w-[650px] text-left text-sm"><thead class="bg-white/5"><tr>{['Day','Time','Location','Coach','Entry'].map(label=><th scope="col" class="px-4 py-4">{label}</th>)}</tr></thead><tbody>{sessions.map(session=><tr data-week-session data-day={session.day} data-location={session.location} class="border-t border-white/10"><th scope="row" class="px-4 py-4">{session.day}</th><td class="px-4 py-4 font-bold">{session.time}</td><td class="px-4 py-4">{session.location}</td><td class="px-4 py-4 text-neutral-400">To be confirmed</td><td class="px-4 py-4"><button data-review={`${session.day} ${session.time} · ${session.location}`} class="underline">View session</button></td></tr>)}</tbody></table></div>
      <p id="empty" hidden class="py-10 text-neutral-300">No timetable entries match these filters.</p>
    </section>
    <dialog id="booking-preview" class="m-auto max-h-[90vh] w-[min(92vw,600px)] overflow-y-auto rounded-2xl border border-white/20 bg-neutral-900 p-8 text-white backdrop:bg-black/80">
      <button id="close-preview" class="float-right rounded border border-white/30 px-3 py-1" aria-label="Close booking preview">Close</button>
      <p class="text-sm text-red-400">Booking journey preview</p><h2 id="selected-session" class="mt-4 text-2xl font-bold"></h2>
      <ol class="mt-6 space-y-6">
        <li><h3 class="font-bold">1. Check the group fits</h3><p class="mt-2 text-neutral-300">See the confirmed age range, level, coach, full timetable, term fee and remaining places.</p></li>
        <li><h3 class="font-bold">2. Book directly or apply</h3><p class="mt-2 text-neutral-300">Open groups allow direct booking. Ability-based groups require an application and staff approval before a place can be paid for.</p></li>
        <li><h3 class="font-bold">3. Waiver and secure payment</h3><p class="mt-2 text-neutral-300">Once eligible to book, complete the parent waiver. A place is held temporarily during Stripe checkout. Verified payment confirms the ten-week enrolment and updates the private staff roster.</p></li>
      </ol>
      <p class="mt-8 rounded-lg bg-amber-200/10 p-4 text-sm text-amber-200">This preview collects no personal details and takes no payment. Checkout becomes available after group rules and vacancies are verified.</p>
    </dialog>
  </main>
</BaseLayout>
<script>
  const locationSelect = document.querySelector<HTMLSelectElement>('#location')!;
  const selectedDays=new Set(['Monday']);
  let view='find';
  function filter() {
    let count=0;
    document.querySelectorAll<HTMLElement>('[data-session], [data-week-session]').forEach(card=>{
      card.hidden=Boolean((locationSelect.value&&card.dataset.location!==locationSelect.value)||(selectedDays.size>0&&!selectedDays.has(card.dataset.day!)));
      if(!card.hidden&&card.hasAttribute('data-session'))count++;
    });
    document.querySelector('#result-count')!.textContent=`${count} ${count===1?'time':'times'} · ${selectedDays.size?[...selectedDays].join(', '):'All days'}`;
    document.querySelector<HTMLElement>('#empty')!.hidden=count>0;
    document.querySelector<HTMLElement>('#session-cards')!.hidden=view!=='find';
    document.querySelector<HTMLElement>('#weekly-view')!.hidden=view!=='week';
    document.querySelectorAll<HTMLButtonElement>('[data-day-choice]').forEach(b=>b.setAttribute('aria-pressed',String(selectedDays.has(b.dataset.dayChoice!))));
  }
  locationSelect.addEventListener('change',filter);
  document.querySelectorAll<HTMLButtonElement>('[data-day-choice]').forEach(button=>button.addEventListener('click',()=>{const day=button.dataset.dayChoice!;if(selectedDays.has(day))selectedDays.delete(day);else selectedDays.add(day);filter();}));
  document.querySelector('#all-days')!.addEventListener('click',()=>{selectedDays.clear();filter();});
  document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach(button=>button.addEventListener('click',()=>{view=button.dataset.view!;document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));filter();}));
  filter();
  const dialog=document.querySelector<HTMLDialogElement>('#booking-preview')!;
  document.querySelectorAll<HTMLButtonElement>('[data-review]').forEach(button=>button.addEventListener('click',()=>{document.querySelector('#selected-session')!.textContent=button.dataset.review!;dialog.showModal();}));
  document.querySelector('#close-preview')!.addEventListener('click',()=>dialog.close());
</script>
