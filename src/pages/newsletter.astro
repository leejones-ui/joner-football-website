---
import BaseLayout from '../layouts/BaseLayout.astro'
import { breadcrumbSchema, webPageSchema } from '../lib/seoSchema'

const title = 'The Joner Football Newsletter | Letters from Lee Jones'
const description = 'Letters from Lee Jones. The real stories behind Joner Football, from Everton and Wrexham to the HQ in Belrose, and what they mean for your training.'
const pageUrl = 'https://jonerfootball.com/newsletter/'
const schemas = [
  webPageSchema({ name: title, description, url: pageUrl }),
  breadcrumbSchema([
    { name: 'Home', url: 'https://jonerfootball.com/' },
    { name: 'Newsletter', url: pageUrl },
  ]),
]

// The two most recent letters sent to the Newsletter list (Brevo 66).
// Links are Brevo's public web copies of each campaign. Newest first.
const letters = [
  {
    date: '22 October 2026',
    title: 'The warehouse I said I would never get.',
    teaser: 'How a swimming lesson led us to the Joner Football HQ.',
    image: '/images/email/oct26/oct26-empty-hq-day-one.jpg',
    alt: 'The empty Joner Football HQ warehouse on day one',
    url: 'https://sh1.sendinblue.com/2lz14j77wt4c.html',
  },
  {
    date: '23 September 2026',
    title: 'Every Tuesday I played against men.',
    teaser: 'A normal week at Wrexham at sixteen, and why the off season matters.',
    image: '/images/email/archive/archive-age-17-wrexham.jpg',
    alt: 'Lee at seventeen playing for Wrexham AFC',
    url: 'https://sh1.sendinblue.com/2lvp0z77wt4c.html',
  },
]
---

<BaseLayout
  title={title}
  description={description}
  keywords="Joner Football newsletter, Lee Jones newsletter, football coaching newsletter, football training tips"
  ogImage={`https://jonerfootball.com${letters[0].image}`}
  schema={schemas}
  hideFooterBookNow
  hideFooterSignup
  hideMobileAppCta
>
  <div class="nl">
    <section class="nl-top" aria-labelledby="newsletter-title">
      <div class="nl-wrap">
        <div class="nl-rule">
          <span>Joner Football</span>
          <span>The Newsletter</span>
        </div>

        <h1 id="newsletter-title" class="nl-h1">Letters from Lee.</h1>
        <p class="nl-intro">
          Real stories from Joner Football and my life, on and off the pitch. Straight from me to you.
        </p>
        <p class="nl-intro nl-intro--muted">Hit reply and it comes straight to me. I read every one.</p>

        <div class="nl-card">
          <form id="newsletter-form" class="nl-form" data-brevo-form data-brevo-custom novalidate>
            <div class="nl-field">
              <label for="newsletter-first-name">First name <span>(optional)</span></label>
              <input id="newsletter-first-name" type="text" name="firstName" autocomplete="given-name" maxlength="80" placeholder="Your first name" />
            </div>
            <div class="nl-field">
              <label for="newsletter-email">Email</label>
              <input id="newsletter-email" type="email" name="email" autocomplete="email" inputmode="email" required placeholder="you@example.com" />
            </div>
            <button type="submit" class="nl-btn">Send me the next letter</button>
            <p class="nl-small">No spam. Unsubscribe any time.</p>
            <p id="newsletter-error" class="nl-error hidden" role="alert"></p>
          </form>

          <div id="newsletter-success" class="nl-success hidden" role="status" aria-live="polite" tabindex="-1">
            <p class="nl-success-title">You are in.</p>
            <p>The next letter lands in your inbox soon. Keep turning up.</p>
            <p class="nl-sign">Lee</p>
          </div>
        </div>
      </div>
    </section>

    <section class="nl-recent" aria-labelledby="recent-title">
      <div class="nl-wide">
        <h2 id="recent-title" class="nl-label">The last two letters</h2>
        <div class="nl-grid">
          {letters.map((l) => (
            <a class="nl-letter" href={l.url} target="_blank" rel="noopener noreferrer">
              <img src={l.image} alt={l.alt} width="1200" height="900" loading="lazy" decoding="async" />
              <div class="nl-letter-body">
                <p class="nl-label">{l.date}</p>
                <h3>{l.title}</h3>
                <p class="nl-teaser">{l.teaser}</p>
                <span class="nl-read">Read the letter &rarr;</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Same paper, ink and type as the emails themselves. */
  .nl { --paper: #EFE9D9; --ink: #1C1C1C; --muted: #5B5851; --line: #CFC7B2; --red: #C8102E; background: var(--paper); color: var(--ink); }
  .nl-top { padding: 48px 16px 40px; }
  .nl-wrap { max-width: 560px; margin: 0 auto; text-align: center; }
  .nl-wide { max-width: 1000px; margin: 0 auto; }
  .nl-rule { display: flex; justify-content: space-between; gap: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--ink); font: 11px/1 'Courier New', Courier, monospace; letter-spacing: 3px; text-transform: uppercase; }
  .nl-rule span:last-child { color: var(--muted); }
  .nl-label { margin: 0; font: 11px/1.4 'Courier New', Courier, monospace; letter-spacing: 3px; text-transform: uppercase; color: var(--muted); }
  .nl-h1, .nl-letter h3, .nl-success-title { text-transform: none; }
  .nl-h1 { margin: 36px 0 0; font: normal 44px/1.05 Georgia, 'Times New Roman', Times, serif; letter-spacing: -0.5px; color: var(--ink); }
  .nl-intro { margin: 20px auto 0; max-width: 34em; font: 18px/1.65 Georgia, 'Times New Roman', Times, serif; color: var(--ink); text-wrap: pretty; }
  .nl-intro--muted { margin-top: 12px; font-style: italic; color: var(--muted); }
  .nl-card { margin-top: 32px; padding: 24px 20px; background: #F7F3E8; border: 1px solid var(--line); text-align: left; }
  .nl-form { display: grid; gap: 16px; }
  .nl-field label { display: block; margin-bottom: 6px; font: bold 12px/1.2 'Courier New', Courier, monospace; letter-spacing: 2px; text-transform: uppercase; color: var(--ink); }
  .nl-field label span { font-weight: normal; color: var(--muted); letter-spacing: 1px; text-transform: none; }
  .nl-field input { box-sizing: border-box; width: 100%; min-height: 48px; padding: 12px 14px; border: 1px solid #B9B09A; border-radius: 0; background: #fff; color: var(--ink); font: 16px/1.3 Georgia, 'Times New Roman', Times, serif; }
  .nl-field input::placeholder { color: #9A9485; }
  .nl-field input:focus { outline: 2px solid var(--ink); outline-offset: 1px; border-color: var(--ink); }
  .nl-btn { width: 100%; min-height: 56px; padding: 16px; border: 2px solid var(--red); border-radius: 8px; background: var(--red); color: #fff; font: bold 15px/1.2 'Courier New', Courier, monospace; letter-spacing: 2px; text-transform: uppercase; cursor: pointer; }
  .nl-btn:hover { background: #A50D26; border-color: #A50D26; }
  .nl-btn:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .nl-btn:disabled { opacity: .7; cursor: wait; }
  .nl-small { margin: -4px 0 0; text-align: center; font: 14px/1.4 Georgia, 'Times New Roman', Times, serif; color: var(--muted); }
  .nl-error { margin: 0; font: 15px/1.5 Georgia, 'Times New Roman', Times, serif; color: #A50D26; }
  .nl-success { text-align: center; font: 17px/1.6 Georgia, 'Times New Roman', Times, serif; }
  .nl-success:focus { outline: none; }
  .nl-success p { margin: 0; }
  .nl-success-title { font-size: 30px !important; line-height: 1.1 !important; margin-bottom: 12px !important; }
  .nl-sign { margin-top: 14px !important; font: italic 30px/1.1 Georgia, 'Times New Roman', Times, serif; }
  .nl-recent { padding: 8px 16px 64px; }
  .nl-recent > .nl-wide > .nl-label { padding-bottom: 12px; border-bottom: 1px solid var(--ink); text-align: center; color: var(--ink); font-weight: normal; }
  .nl-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; margin-top: 24px; }
  .nl-letter { display: flex; flex-direction: column; background: #F7F3E8; border: 1px solid var(--line); color: var(--ink); text-decoration: none; transition: border-color .15s; }
  .nl-letter:hover { border-color: var(--ink); }
  .nl-letter:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .nl-letter img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .nl-letter-body { display: flex; flex: 1; flex-direction: column; padding: 20px; }
  .nl-letter h3 { margin: 10px 0 0; font: normal 24px/1.2 Georgia, 'Times New Roman', Times, serif; letter-spacing: -0.3px; }
  .nl-teaser { margin: 10px 0 0; font: 16px/1.6 Georgia, 'Times New Roman', Times, serif; color: var(--muted); }
  .nl-read { margin-top: auto; padding-top: 18px; font: bold 12px/1 'Courier New', Courier, monospace; letter-spacing: 2px; text-transform: uppercase; color: var(--red); }
  @media (min-width: 640px) {
    .nl-top { padding: 72px 24px 48px; }
    .nl-h1 { font-size: 60px; }
    .nl-card { padding: 32px; }
    .nl-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .nl-recent { padding: 16px 24px 88px; }
  }
  @media (max-width: 360px) {
    .nl-h1 { font-size: 38px; }
    .nl-rule { letter-spacing: 2px; }
    .nl-btn { font-size: 14px; letter-spacing: 1px; padding: 16px 8px; }
  }
</style>

<script is:inline>
  (function () {
    var NEWSLETTER_LIST_ID = 66;
    var SOURCE = 'newsletter-page';
    var form = document.getElementById('newsletter-form');
    var success = document.getElementById('newsletter-success');
    var errorBox = document.getElementById('newsletter-error');
    if (!form || !success || !errorBox) return;
    var button = form.querySelector('button[type="submit"]');
    var buttonText = button ? button.textContent : 'Send me the next letter';
    var FRIENDLY_ERROR = 'Sorry, that did not go through. Please check your email and try again, or email leejones@jonerfootball.com and I will add you myself.';

    function showError(message) {
      errorBox.textContent = message || FRIENDLY_ERROR;
      errorBox.classList.remove('hidden');
    }

    function trackingFields() {
      var out = {};
      var params = window.JonerTracking && typeof window.JonerTracking.collectTrackingParams === 'function'
        ? window.JonerTracking.collectTrackingParams()
        : new URLSearchParams(window.location.search || '');
      params.forEach(function (value, key) {
        if (value) out[key] = value;
      });
      return out;
    }

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      errorBox.classList.add('hidden');
      var firstName = String(form.elements.firstName.value || '').trim();
      var email = String(form.elements.email.value || '').trim().toLowerCase();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
        showError('Please enter a valid email address.');
        form.elements.email.focus();
        return;
      }
      if (button) {
        button.disabled = true;
        button.textContent = 'Sending...';
      }

      var getToken = window.JonerRecaptcha && window.JonerRecaptcha.getToken
        ? window.JonerRecaptcha.getToken('subscribe')
        : Promise.resolve('');

      Promise.resolve(getToken)
        .catch(function () { return ''; })
        .then(function (recaptchaToken) {
          // Tracking fields go first so they can never replace the core fields.
          // listId is sent as well as listIds: the endpoint falls back to list 2
          // when listId is missing, and this form must only add list 66.
          var payload = Object.assign(trackingFields(), {
            email: email,
            firstName: firstName,
            listId: NEWSLETTER_LIST_ID,
            listIds: [NEWSLETTER_LIST_ID],
            source: SOURCE,
            marketingConsent: true,
            recaptchaToken: recaptchaToken || ''
          });
          return fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
        })
        .then(function (response) {
          return response.json().catch(function () { return {}; }).then(function (data) { return { ok: response.ok, data: data }; });
        })
        .then(function (result) {
          if (!result.ok || !result.data || !result.data.success) {
            throw new Error((result.data && result.data.error) || '');
          }
          if (window.JonerTracking && typeof window.JonerTracking.trackEvent === 'function') {
            window.JonerTracking.trackEvent('Lead', {
              user_data: { email: email },
              custom_data: { form_name: SOURCE, list_id: NEWSLETTER_LIST_ID, lead_type: 'newsletter_lead' }
            });
          }
          form.classList.add('hidden');
          success.classList.remove('hidden');
          success.focus({ preventScroll: true });
        })
        .catch(function (error) {
          showError(error && error.message ? error.message : FRIENDLY_ERROR);
          if (button) {
            button.disabled = false;
            button.textContent = buttonText;
          }
        });
    });
  })();
</script>
