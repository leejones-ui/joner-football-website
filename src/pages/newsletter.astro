---
import BaseLayout from '../layouts/BaseLayout.astro'
import { breadcrumbSchema, webPageSchema } from '../lib/seoSchema'

const title = 'The Joner Football Newsletter | A letter from Lee Jones'
const description = 'One letter a month from Lee Jones. The stories behind Joner Football, what he is working on with his players, and one idea to use at your next session.'
const pageUrl = 'https://jonerfootball.com/newsletter/'
const schemas = [
  webPageSchema({ name: title, description, url: pageUrl }),
  breadcrumbSchema([
    { name: 'Home', url: 'https://jonerfootball.com/' },
    { name: 'Newsletter', url: pageUrl },
  ]),
]
const latestImage = '/images/email/oct26/oct26-empty-hq-day-one.jpg'
---

<BaseLayout
  title={title}
  description={description}
  keywords="Joner Football newsletter, Lee Jones newsletter, football coaching newsletter, football training tips"
  ogImage={`https://jonerfootball.com${latestImage}`}
  schema={schemas}
>
  <main class="bg-joner-black text-white">
    <section class="px-4 pt-12 pb-10 sm:pt-16 md:pt-24" aria-labelledby="newsletter-title">
      <div class="mx-auto w-full max-w-xl">
        <p class="font-body text-xs font-bold uppercase tracking-[0.2em] text-joner-red">The Newsletter</p>
        <h1 id="newsletter-title" class="mt-3 font-heading text-4xl leading-none sm:text-5xl md:text-6xl">One letter a month from Lee.</h1>
        <span class="mt-6 block h-1 w-14 bg-joner-red" aria-hidden="true"></span>
        <p class="mt-6 font-body text-base leading-relaxed text-gray-300 sm:text-lg">
          The stories behind Joner Football, what I am working on with my players, and one idea you can use at your next session. No spam. Unsubscribe any time.
        </p>

        <div class="mt-8 border border-gray-800 bg-joner-gray p-5 sm:p-8">
          <form id="newsletter-form" class="space-y-5" data-brevo-form data-brevo-custom novalidate>
            <div>
              <label for="newsletter-first-name" class="mb-2 block font-body text-sm font-semibold text-white">First name <span class="font-normal text-gray-400">(optional)</span></label>
              <input id="newsletter-first-name" type="text" name="firstName" autocomplete="given-name" maxlength="80" placeholder="Your first name" class="min-h-[48px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
            </div>
            <div>
              <label for="newsletter-email" class="mb-2 block font-body text-sm font-semibold text-white">Email</label>
              <input id="newsletter-email" type="email" name="email" autocomplete="email" inputmode="email" required placeholder="you@example.com" class="min-h-[48px] w-full border border-gray-700 bg-joner-black px-4 py-3 font-body text-base text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
            </div>
            <button type="submit" class="btn-red w-full">Send me the next letter</button>
            <p id="newsletter-error" class="hidden font-body text-sm leading-relaxed text-amber-400" role="alert"></p>
          </form>

          <div id="newsletter-success" class="hidden" role="status" aria-live="polite" tabindex="-1">
            <p class="font-heading text-3xl uppercase leading-none">You are in<span class="text-joner-red">.</span></p>
            <p class="mt-4 font-body text-base leading-relaxed text-gray-300">The next letter lands in your inbox soon. Keep turning up.</p>
            <p class="mt-4 font-body text-base font-semibold text-white">Lee</p>
          </div>
        </div>
      </div>
    </section>

    <section class="px-4 pb-16 md:pb-24" aria-labelledby="latest-letter-title">
      <div class="mx-auto w-full max-w-xl border-t border-gray-800 pt-10">
        <p class="font-body text-xs font-bold uppercase tracking-[0.2em] text-joner-red">Latest letter</p>
        <article class="mt-5">
          <img
            src={latestImage}
            alt="The empty Joner Football HQ warehouse on day one"
            width="1200"
            height="1500"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover"
          />
          <h2 id="latest-letter-title" class="mt-5 font-heading text-2xl leading-tight sm:text-3xl">The warehouse I said I would never get</h2>
          <p class="mt-3 font-body text-base leading-relaxed text-gray-300">How a swimming lesson led us to the Joner Football HQ.</p>
        </article>
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline>
  (function () {
    var NEWSLETTER_LIST_ID = 66;
    var SOURCE = 'newsletter-page';
    var form = document.getElementById('newsletter-form');
    var success = document.getElementById('newsletter-success');
    var errorBox = document.getElementById('newsletter-error');
    if (!form || !success || !errorBox) return;
    var button = form.querySelector('button[type="submit"]');
    var buttonText = button ? button.textContent : 'Send me the next letter';
    var FRIENDLY_ERROR = 'Sorry, that did not go through. Please check your email and try again, or email leejones@jonerfootball.com and I will add you myself.';

    function showError(message) {
      errorBox.textContent = message || FRIENDLY_ERROR;
      errorBox.classList.remove('hidden');
    }

    function trackingFields() {
      var out = {};
      var params = window.JonerTracking && typeof window.JonerTracking.collectTrackingParams === 'function'
        ? window.JonerTracking.collectTrackingParams()
        : new URLSearchParams(window.location.search || '');
      params.forEach(function (value, key) {
        if (value) out[key] = value;
      });
      return out;
    }

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      errorBox.classList.add('hidden');
      var firstName = String(form.elements.firstName.value || '').trim();
      var email = String(form.elements.email.value || '').trim().toLowerCase();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
        showError('Please enter a valid email address.');
        form.elements.email.focus();
        return;
      }
      if (button) {
        button.disabled = true;
        button.textContent = 'Sending...';
      }

      var getToken = window.JonerRecaptcha && window.JonerRecaptcha.getToken
        ? window.JonerRecaptcha.getToken('subscribe')
        : Promise.resolve('');

      Promise.resolve(getToken)
        .catch(function () { return ''; })
        .then(function (recaptchaToken) {
          // Tracking fields go first so they can never replace the core fields.
          // listId is sent as well as listIds: the endpoint falls back to list 2
          // when listId is missing, and this form must only add list 66.
          var payload = Object.assign(trackingFields(), {
            email: email,
            firstName: firstName,
            listId: NEWSLETTER_LIST_ID,
            listIds: [NEWSLETTER_LIST_ID],
            source: SOURCE,
            marketingConsent: true,
            recaptchaToken: recaptchaToken || ''
          });
          return fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
        })
        .then(function (response) {
          return response.json().catch(function () { return {}; }).then(function (data) { return { ok: response.ok, data: data }; });
        })
        .then(function (result) {
          if (!result.ok || !result.data || !result.data.success) {
            throw new Error((result.data && result.data.error) || '');
          }
          if (window.JonerTracking && typeof window.JonerTracking.trackEvent === 'function') {
            window.JonerTracking.trackEvent('Lead', {
              user_data: { email: email },
              custom_data: { form_name: SOURCE, list_id: NEWSLETTER_LIST_ID, lead_type: 'newsletter_lead' }
            });
          }
          form.classList.add('hidden');
          success.classList.remove('hidden');
          success.focus({ preventScroll: true });
        })
        .catch(function (error) {
          showError(error && error.message ? error.message : FRIENDLY_ERROR);
          if (button) {
            button.disabled = false;
            button.textContent = buttonText;
          }
        });
    });
  })();
</script>
