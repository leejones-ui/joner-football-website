---
import BaseLayout from '../../layouts/BaseLayout.astro'
import HubContent from '../../components/HubContent.astro'

import SanityPageRenderer from '../../components/sanity/SanityPageRenderer.astro'
import { fetchSanityPage } from '../../lib/sanityPages'
import { shouldReplaceSanityPage } from '../../lib/sanityPageUtils'

const sanityPage = await fetchSanityPage('hub-app')
---

{shouldReplaceSanityPage(sanityPage) ? (
  <SanityPageRenderer page={sanityPage} />
) : (
<BaseLayout
  title="Joner Football App Hub"
  description="Direct Joner Football Hub access for app members, with free resources, training links, challenges and useful player and coach content."
>
  <HubContent appMode={true} titleTag="h1" />
</BaseLayout>
)}
