---
import BaseLayout from '../../layouts/BaseLayout.astro'

const posts = [
  {
    hook: 'I tested 5 viral football drills. Only one was actually football.',
    title: 'Train for the game, not the algorithm',
    text: 'Lee tests five viral drills and explains the one question every coach, parent and player should ask before copying a clip.',
    href: '/blog/viral-football-drills',
  },
  {
    hook: 'Your first touch tells everyone what level you are.',
    title: 'Improve your first touch',
    text: 'A simple breakdown of why first touch changes everything, and how players can train it properly.',
    href: '/blog/improve-first-touch-football',
  },
  {
    hook: 'The best coaches make players think, not just run.',
    title: 'Coach notes',
    text: 'Short coaching ideas for building sharper, braver and more technical footballers.',
    href: '/blog/what-makes-great-football-coach',
  },
]
---

<BaseLayout
  title="Joner Blogs | Joner Football Hub"
  description="Joner Football blogs, coaching notes and player development ideas from the Joner Football Hub."
>
  <main class="hub-blog-page">
    <section class="hub-blog-hero">
      <div class="hub-blog-shell">
        <p class="hub-blog-eyebrow">Joner Football Hub</p>
        <h1>Joner Blogs</h1>
        <p>Short reads with proper football ideas. Player development, technique, mindset, coaching notes and the Joner way.</p>
      </div>
    </section>

    <section class="hub-blog-list">
      <div class="hub-blog-shell hub-blog-grid">
        {posts.map((post) => (
          <a href={post.href} class="hub-blog-card">
            <span>Read</span>
            <h2>{post.hook}</h2>
            <h3>{post.title}</h3>
            <p>{post.text}</p>
            <strong>Open blog</strong>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Kanit:ital,wght@1,600;1,900&display=swap');
  .hub-blog-page { background: #000; color: #fff; }
  .hub-blog-shell { max-width: 1180px; margin: 0 auto; padding: 0 20px; }
  .hub-blog-hero { padding: 120px 0 70px; background: linear-gradient(180deg, #000, #101010); }
  .hub-blog-eyebrow, .hub-blog-card span, .hub-blog-card strong { font-family: 'Kanit', 'Oswald', sans-serif; font-style: italic; text-transform: uppercase; letter-spacing: .18em; color: #E30613; font-weight: 600; }
  .hub-blog-hero h1 { font-family: 'Kanit', 'Oswald', sans-serif; font-style: italic; font-weight: 900; text-transform: uppercase; font-size: clamp(4rem, 10vw, 8rem); line-height: .86; margin: 18px 0; }
  .hub-blog-hero p { max-width: 650px; color: rgba(255,255,255,.76); font-size: 1.1rem; line-height: 1.6; }
  .hub-blog-list { background: #fff; color: #000; padding: 80px 0; }
  .hub-blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .hub-blog-card { display: block; min-height: 360px; padding: 30px; border: 2px solid rgba(0,0,0,.16); color: #000; text-decoration: none; transition: transform .16s ease, border-color .16s ease, box-shadow .16s ease; }
  .hub-blog-card:hover { transform: translateY(-4px); border-color: #E30613; box-shadow: 0 18px 45px rgba(0,0,0,.12); }
  .hub-blog-card h2 { font-family: 'Kanit', 'Oswald', sans-serif; font-style: italic; font-weight: 900; text-transform: uppercase; font-size: 2rem; line-height: .98; margin: 18px 0; }
  .hub-blog-card h3 { font-family: 'Kanit', 'Oswald', sans-serif; font-style: italic; font-weight: 900; text-transform: uppercase; font-size: 1.1rem; margin: 0 0 12px; }
  .hub-blog-card p { color: rgba(0,0,0,.68); line-height: 1.55; }
  .hub-blog-card strong::after { content: ' →'; }
  @media (max-width: 900px) { .hub-blog-grid { grid-template-columns: 1fr; } .hub-blog-hero { padding: 95px 0 55px; } }
</style>
