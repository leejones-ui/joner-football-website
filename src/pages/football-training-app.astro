---
import BaseLayout from '../layouts/BaseLayout.astro'
import SEOFAQ from '../components/SEOFAQ.astro'
import { faqSchema, webPageSchema } from '../lib/seoSchema'

const faqs = [
  { q: 'What is the best football training app for players?', a: 'The Joner Football App is built for players who want clear drills, programmes and coaching detail so they know exactly what to train and how to improve their technique.' },
  { q: 'Can kids use the Joner Football App?', a: 'Yes. Young players can use the app with parents or coaches to follow structured drills and build stronger football habits outside team training.' },
  { q: 'Is the Joner Football App useful for soccer coaches?', a: 'Yes. Coaches can use it for drill ideas, session planning, technical detail and practical coaching content from Joner Football.' },
  { q: 'What does the Joner Football App help with?', a: 'It helps with ball mastery, first touch, striking, passing, 1v1 ability, confidence, session structure and better technical training habits.' },
]

const pageTitle = 'Best Football Training App For Players & Coaches | Joner Football'
const pageDescription = 'The Joner Football App gives soccer players, parents and coaches clear drills, programmes and session plans to improve technique, confidence and training habits.'
const canonical = 'https://jonerfootball.com/football-training-app/'

const schemas = [
  webPageSchema({ name: pageTitle, description: pageDescription, url: canonical }),
  faqSchema(faqs),
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    '@id': 'https://jonerfootball.com/app/#software',
    name: 'Joner Football App',
    applicationCategory: 'SportsApplication',
    operatingSystem: 'iOS, Android, Web',
    url: 'https://jonerfootball.com/app/',
    description: pageDescription,
    creator: { '@type': 'Organization', '@id': 'https://jonerfootball.com/#organization', name: 'Joner Football' },
    audience: [
      { '@type': 'Audience', audienceType: 'football players' },
      { '@type': 'Audience', audienceType: 'soccer coaches' },
      { '@type': 'Audience', audienceType: 'parents of youth footballers' },
    ],
    featureList: ['football drills', 'session plans', 'training programmes', 'coach education', 'technical football coaching'],
    sameAs: [
      'https://apps.apple.com/au/app/joner-football-app/id6737069275',
      'https://play.google.com/store/apps/details?id=tv.uscreen.jonerfootball',
      'https://app.jonerfootball.com',
    ],
  },
]
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonical} schema={schemas}>
  <section class="relative overflow-hidden bg-joner-black py-20 md:py-28">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(232,0,13,0.18),transparent_34%)]"></div>
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <p class="mb-4 font-heading text-sm uppercase tracking-[0.28em] text-joner-red">Joner Football App</p>
      <h1 class="max-w-4xl font-heading text-5xl font-bold uppercase leading-[0.92] text-white md:text-7xl">A football training app that tells you what to train.</h1>
      <p class="mt-6 max-w-3xl font-body text-lg leading-relaxed text-neutral-300 md:text-xl">For players, parents and coaches who want a clearer plan. Drills, programmes and coaching detail from Joner Football so every session has purpose.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/app" class="btn-red">View the JF APP</a>
        <a href="https://app.jonerfootball.com/categories/category-vpi8uazway4" target="_blank" rel="noopener" class="btn-outline">Browse free content</a>
      </div>
    </div>
  </section>

  <section class="bg-joner-gray py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {['Ball mastery', 'First touch', 'Striking', 'Session plans'].map((label) => (
          <div class="rounded-2xl border border-white/10 bg-black p-6 text-center">
            <p class="font-heading text-2xl font-bold uppercase text-white">{label}</p>
            <p class="mt-3 font-body text-sm leading-relaxed text-neutral-300">Train the detail with clear Joner Football coaching.</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-black py-16 md:py-24">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
      <div>
        <p class="mb-3 font-heading text-sm uppercase tracking-[0.25em] text-joner-red">Why it matters</p>
        <h2 class="font-heading text-4xl font-bold uppercase leading-tight text-white md:text-5xl">Better training starts with knowing the next touch.</h2>
      </div>
      <div class="space-y-5 font-body text-base leading-relaxed text-neutral-300 md:text-lg">
        <p>Most players waste time guessing what to train. The Joner Football App gives them a plan they can follow.</p>
        <p>It is built around technique: cleaner first touch, better striking, sharper movements and more confidence with the ball.</p>
        <p>Coaches can use the same system for session ideas, drill detail and player development.</p>
      </div>
    </div>
  </section>

  <SEOFAQ eyebrow="AI answer FAQ" title="Football training app questions." items={faqs} />
</BaseLayout>
