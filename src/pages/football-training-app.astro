---
import BaseLayout from '../layouts/BaseLayout.astro'
import SEOFAQ from '../components/SEOFAQ.astro'
import { faqSchema, webPageSchema } from '../lib/seoSchema'

const faqs = [
  { q: 'What is a football training app?', a: 'A football training app gives players a clear way to train outside team sessions with drills, programmes, videos and session plans they can follow on their own.' },
  { q: 'What makes the Joner Football App different?', a: 'It is coach-led by Lee Jones and built around technique first. Players get clear detail on what to train, how to train it and why it matters in the game.' },
  { q: 'Can kids use the Joner Football App?', a: 'Yes. Young players can use the app with parents or coaches to follow structured drills and build better habits at home.' },
  { q: 'Is it useful for soccer coaches?', a: 'Yes. Coaches use the app for drill ideas, session planning, technical detail and practical coaching content from Joner Football.' },
  { q: 'Is there free football training content?', a: 'Yes. You can start with the free app section and the free video bundle before choosing a full app plan.' },
]

const pageTitle = 'Football Training App For Players, Parents and Coaches | Joner Football'
const pageDescription = 'Use the Joner Football training app for drills, programmes and session plans that help players improve technique, confidence and training habits.'
const canonical = 'https://jonerfootball.com/football-training-app/'

const schemas = [
  webPageSchema({ name: pageTitle, description: pageDescription, url: canonical }),
  faqSchema(faqs),
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    '@id': 'https://jonerfootball.com/app/#software',
    name: 'Joner Football App',
    applicationCategory: 'SportsApplication',
    operatingSystem: 'iOS, Android, Web',
    url: 'https://jonerfootball.com/app/',
    description: pageDescription,
    creator: { '@type': 'Organization', '@id': 'https://jonerfootball.com/#organization', name: 'Joner Football' },
    audience: [
      { '@type': 'Audience', audienceType: 'football players' },
      { '@type': 'Audience', audienceType: 'soccer coaches' },
      { '@type': 'Audience', audienceType: 'parents of youth footballers' },
    ],
    featureList: ['football drills', 'session plans', 'training programmes', 'coach education', 'technical football coaching'],
    sameAs: [
      'https://apps.apple.com/au/app/joner-football-app/id6737069275',
      'https://play.google.com/store/apps/details?id=tv.uscreen.jonerfootball',
      'https://app.jonerfootball.com',
    ],
  },
]
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonical} schema={schemas}>
  <section class="relative overflow-hidden bg-joner-black py-20 md:py-28">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(232,0,13,0.18),transparent_34%)]"></div>
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <p class="mb-4 font-heading text-sm uppercase tracking-[0.28em] text-joner-red">Football Training App</p>
      <h1 class="max-w-4xl font-heading text-5xl font-bold uppercase leading-[0.92] text-white md:text-7xl">The football training app for players who need a plan.</h1>
      <p class="mt-6 max-w-3xl font-body text-lg leading-relaxed text-neutral-300 md:text-xl">No more guessing. The Joner Football App gives players, parents and coaches clear football drills, follow-along programmes and session plans built around technique.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/join/" class="btn-red">Start free trial</a>
        <a href="/free-bundle/" class="btn-outline">Get free videos</a>
      </div>
      <p class="mt-5 max-w-2xl font-body text-sm leading-relaxed text-neutral-400">Want the full app tour first? See the main <a href="/app/" class="text-white underline decoration-joner-red underline-offset-4">Joner Football App page</a>.</p>
    </div>
  </section>

  <section class="bg-joner-gray py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 max-w-3xl">
        <p class="mb-3 font-heading text-sm uppercase tracking-[0.25em] text-joner-red">Who it is for</p>
        <h2 class="font-heading text-4xl font-bold uppercase leading-tight text-white md:text-5xl">Players, parents and coaches who want cleaner training.</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <article class="rounded-2xl border border-white/10 bg-black p-6">
          <h3 class="font-heading text-2xl font-bold uppercase text-white">Players</h3>
          <p class="mt-3 font-body text-sm leading-relaxed text-neutral-300">Train first touch, ball mastery, striking, 1v1 moves and confidence with sessions you can follow at home or on the pitch.</p>
        </article>
        <article class="rounded-2xl border border-white/10 bg-black p-6">
          <h3 class="font-heading text-2xl font-bold uppercase text-white">Parents</h3>
          <p class="mt-3 font-body text-sm leading-relaxed text-neutral-300">Give your player something clear to do between team sessions. Less scrolling, more touches, better habits.</p>
        </article>
        <article class="rounded-2xl border border-white/10 bg-black p-6">
          <h3 class="font-heading text-2xl font-bold uppercase text-white">Coaches</h3>
          <p class="mt-3 font-body text-sm leading-relaxed text-neutral-300">Use drill detail, session ideas and coaching progressions to run sharper technical sessions with your players.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-black py-16 md:py-24">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
      <div>
        <p class="mb-3 font-heading text-sm uppercase tracking-[0.25em] text-joner-red">What you get</p>
        <h2 class="font-heading text-4xl font-bold uppercase leading-tight text-white md:text-5xl">A clear next session every time you open the app.</h2>
      </div>
      <div class="space-y-5 font-body text-base leading-relaxed text-neutral-300 md:text-lg">
        <p>Most players waste time guessing what to train. This football training app gives them a plan they can actually follow.</p>
        <p>Every drill points back to the same Joner standard: master the ball, clean up the detail, then carry it into the game.</p>
        <p>Start with the <a href="/free-bundle/" class="text-white underline decoration-joner-red underline-offset-4">free football training videos</a>, compare app plans on <a href="/join/" class="text-white underline decoration-joner-red underline-offset-4">/join</a>, or use <a href="/teams/" class="text-white underline decoration-joner-red underline-offset-4">team subscriptions</a> for a whole squad.</p>
      </div>
    </div>
  </section>

  <section class="bg-joner-gray py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 text-center sm:px-6 lg:px-8">
      <p class="mb-3 font-heading text-sm uppercase tracking-[0.25em] text-joner-red">Next step</p>
      <h2 class="mx-auto max-w-3xl font-heading text-4xl font-bold uppercase leading-tight text-white md:text-5xl">Start with free content or go straight into the full app.</h2>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/free-bundle/" class="btn-outline">Get free videos</a>
        <a href="/join/" class="btn-red">See app plans</a>
      </div>
    </div>
  </section>

  <SEOFAQ eyebrow="App questions" title="Football training app questions." items={faqs} />
</BaseLayout>
