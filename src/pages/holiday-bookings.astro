---
import BaseLayout from '../layouts/BaseLayout.astro'

const title = 'School Holiday Sessions | Joner Football'
const description = 'Book school holiday coaching sessions with Joner Football coaches at The HQ, Belrose.'
---

<BaseLayout title={title} description={description} canonical="https://jonerfootball.com/holiday-bookings/" noindex hideMobileAppCta>
  <main class="bg-joner-black text-white min-h-screen">

    <!-- Gate -->
    <section id="holiday-gate" hidden class="relative overflow-hidden border-b border-white/10 min-h-[70vh] flex items-center">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(232,0,13,0.28),transparent_34%),linear-gradient(135deg,#000_0%,#111_58%,#050505_100%)]"></div>
      <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-joner-red to-transparent"></div>
      <div class="relative w-full max-w-xl mx-auto px-4 sm:px-6 py-16 md:py-24 text-center">
        <p class="font-heading uppercase tracking-[0.28em] text-joner-red text-sm mb-5">School Holiday Coaching</p>
        <h1 class="font-heading uppercase text-5xl md:text-7xl leading-none mb-5">Book Your Session.</h1>
        <p class="text-white/90 text-base md:text-lg leading-relaxed mb-8">Enter the password from your Joner Football message.</p>
        <form id="gate-form" class="flex flex-col gap-3 text-left" novalidate>
          <label for="gate-password" class="block text-white font-heading text-sm uppercase tracking-wider">Password</label>
          <input id="gate-password" name="password" type="password" autocomplete="off" required
            class="w-full bg-joner-gray border border-gray-700 text-white px-4 py-3 font-body text-base focus:outline-none focus:border-joner-red placeholder-gray-500 min-h-[48px]" />
          <button type="submit" class="btn-red w-full min-h-[48px] mt-2">Enter</button>
          <p id="gate-status" class="text-sm text-white/90 min-h-[1.25rem]" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <!-- Booking app -->
    <section id="holiday-app" hidden>
      <div class="relative overflow-hidden border-b border-white/10">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(232,0,13,0.25),transparent_40%),linear-gradient(135deg,#000_0%,#111_58%,#050505_100%)]"></div>
        <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-6 md:pt-14 md:pb-8">
          <p class="font-heading uppercase tracking-[0.28em] text-joner-red text-sm mb-3">School Holiday Coaching</p>
          <h1 id="app-heading" class="font-heading uppercase text-4xl md:text-6xl leading-none mb-3">School Holiday Sessions</h1>
          <p id="app-lead" class="text-white/90 text-base md:text-lg">Pick a coach, then tap a time.</p>
        </div>
      </div>

      <div id="notice" class="hidden max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
        <div class="rounded-xl border border-joner-red/40 bg-joner-red/10 px-4 py-3 text-sm text-white/90" role="status"></div>
      </div>

      <!-- Coach picker -->
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
        <p class="font-heading uppercase tracking-[0.2em] text-white/80 text-xs mb-3">Choose your coach</p>
        <div id="coaches" class="flex gap-3 overflow-x-auto no-scrollbar pb-2" role="tablist" aria-label="Coaches"></div>
      </div>

      <!-- Legend -->
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-2 flex flex-wrap gap-x-5 gap-y-2 text-xs text-white/85">
        <span class="flex items-center gap-2"><i class="legend-dot bg-white"></i> Free</span>
        <span class="flex items-center gap-2"><i class="legend-dot legend-pending"></i> Being booked</span>
        <span class="flex items-center gap-2"><i class="legend-dot bg-white/10"></i> Booked</span>
      </div>

      <!-- Days and times -->
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-8">
        <div id="slots-loading" class="space-y-4">
          <div class="h-8 w-40 rounded bg-white/10 animate-pulse"></div>
          <div class="grid grid-cols-3 gap-3"><div class="h-20 rounded-xl bg-white/5 animate-pulse"></div><div class="h-20 rounded-xl bg-white/5 animate-pulse"></div><div class="h-20 rounded-xl bg-white/5 animate-pulse"></div></div>
        </div>
        <div id="slots-empty" hidden class="rounded-2xl border border-white/10 bg-white/[0.04] p-8 text-center">
          <p class="font-heading uppercase text-2xl mb-2">Nothing To Book Yet</p>
          <p class="text-white/90">This coach's times are not up yet. Try another coach, or email <a class="underline decoration-joner-red underline-offset-4" href="mailto:leejones@jonerfootball.com">leejones@jonerfootball.com</a>.</p>
        </div>
        <div id="slots-error" hidden class="rounded-2xl border border-white/10 bg-white/[0.04] p-8 text-center">
          <p class="font-heading uppercase text-2xl mb-2">Could Not Load Sessions</p>
          <button id="retry" type="button" class="btn-outline mt-3">Try Again</button>
        </div>
        <div id="slots-list" class="space-y-9"></div>
      </div>
    </section>

    <!-- Booking sheet -->
    <div id="sheet-backdrop" hidden class="fixed inset-0 z-40 bg-black/70"></div>
    <div id="sheet" hidden role="dialog" aria-modal="true" aria-labelledby="sheet-title"
      class="fixed z-50 inset-x-0 bottom-0 md:inset-0 md:flex md:items-center md:justify-center">
      <div class="bg-[#111] text-white border-t md:border border-white/15 rounded-t-3xl md:rounded-2xl w-full md:max-w-lg max-h-[92vh] md:max-h-[90vh] overflow-y-auto shadow-2xl">
        <div class="sticky top-0 bg-[#111] border-b border-white/10 px-5 py-4 flex items-start justify-between gap-4 z-10">
          <div>
            <p class="font-heading uppercase tracking-[0.18em] text-joner-red text-xs mb-1">Book This Session</p>
            <h2 id="sheet-title" class="font-heading uppercase text-2xl leading-none"></h2>
            <p id="sheet-subtitle" class="text-white/90 text-sm mt-1"></p>
            <p id="hold-timer" class="hold-timer mt-2" hidden></p>
          </div>
          <button id="sheet-close" type="button" class="text-white/90 hover:text-white text-2xl leading-none min-w-[44px] min-h-[44px]" aria-label="Close">&times;</button>
        </div>
        <form id="book-form" class="px-5 py-5 space-y-5" novalidate>
          <div id="type-block" hidden>
            <label class="block text-white font-heading text-sm uppercase tracking-wider mb-2">Session type</label>
            <div id="type-options" class="grid gap-2" role="radiogroup"></div>
            <p class="text-xs text-white/80 mt-2">This books the whole hour for your players. Nobody else joins.</p>
          </div>
          <div id="locked-block" hidden class="rounded-xl border border-joner-red/40 bg-joner-red/10 px-4 py-3 text-sm"></div>
          <div id="seats-block">
            <label class="block text-white font-heading text-sm uppercase tracking-wider mb-2">How many players?</label>
            <div class="flex items-center gap-3">
              <button type="button" id="seats-minus" class="min-w-[44px] min-h-[44px] border border-gray-600 text-xl" aria-label="Fewer players">-</button>
              <span id="seats-value" class="font-heading text-2xl min-w-[2ch] text-center">1</span>
              <button type="button" id="seats-plus" class="min-w-[44px] min-h-[44px] border border-gray-600 text-xl" aria-label="More players">+</button>
              <span id="seats-hint" class="text-sm text-white/85"></span>
            </div>
          </div>
          <div id="players" class="space-y-3"></div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="parentName" class="block text-white font-heading text-sm uppercase tracking-wider mb-2">Parent or guardian</label>
              <input id="parentName" name="parentName" type="text" autocomplete="name" required class="inp" />
            </div>
            <div>
              <label for="mobile" class="block text-white font-heading text-sm uppercase tracking-wider mb-2">Mobile</label>
              <input id="mobile" name="mobile" type="tel" autocomplete="tel" inputmode="tel" required class="inp" />
            </div>
          </div>
          <div>
            <label for="email" class="block text-white font-heading text-sm uppercase tracking-wider mb-2">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required class="inp" />
          </div>
          <div>
            <label for="notes" class="block text-white font-heading text-sm uppercase tracking-wider mb-2">Anything the coach should know? <span class="text-white/80 normal-case tracking-normal">(optional)</span></label>
            <textarea id="notes" name="notes" rows="2" class="inp"></textarea>
          </div>
          <div class="rounded-xl border border-white/20 bg-white/[0.06] px-4 py-3">
            <p class="font-heading uppercase tracking-wider text-sm mb-1">Cancellation policy</p>
            <p class="text-sm text-white leading-relaxed">Cancel 24 hours or more before your session for a full refund. Cancellations within 24 hours of the session are refunded 50%.</p>
          </div>
          <label class="flex items-start gap-3 text-sm text-white">
            <input id="agreement" name="agreementAccepted" type="checkbox" class="mt-1 h-5 w-5 accent-[#E8000D]" required />
            <span>I agree to the <a href="/terms" target="_blank" rel="noopener noreferrer" class="underline decoration-joner-red underline-offset-4">terms</a> and the cancellation policy, and understand sessions are paid in full at booking.</span>
          </label>
          <p id="book-status" class="text-sm text-joner-red min-h-[1.25rem]" aria-live="polite"></p>
          <div class="sticky bottom-0 bg-[#111] pt-2 pb-1">
            <button id="pay-button" type="submit" class="btn-red w-full min-h-[52px]">Pay with Stripe</button>
            <p class="text-xs text-white/80 text-center mt-2">Secure payment by Stripe. Your place is held for 30 minutes while you pay.</p>
          </div>
        </form>
      </div>
    </div>
  </main>
</BaseLayout>

<style is:global>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { scrollbar-width: none; }
  .inp { width:100%; background:#1a1a1a; border:1px solid #3a3a3a; color:#fff; padding:.7rem .9rem; font-size:1rem; min-height:44px; font-family: var(--font-body); }
  .inp:focus { outline:none; border-color:#E8000D; }
  .legend-dot { display:inline-block; width:12px; height:12px; border-radius:3px; }

  .coach { flex: 0 0 auto; min-width: 150px; display:flex; align-items:center; gap:.75rem; padding:.75rem .9rem; border:1px solid rgba(255,255,255,.15); background: rgba(255,255,255,.04); text-align:left; transition: transform .15s ease, background .15s ease; }
  .coach[aria-selected="true"] { background:#fff; color:#0A0A0A; border-color:#fff; }
  .coach[aria-selected="true"] .coach-tag { color:#E8000D; }
  .coach[disabled] { opacity:.55; cursor:not-allowed; }
  .coach-avatar { width:44px; height:44px; border-radius:999px; background:#E8000D; color:#fff; display:grid; place-items:center; font-family: var(--font-heading); font-size:1.3rem; flex:0 0 auto; }
  .coach[aria-selected="true"] .coach-avatar { background:#0A0A0A; }
  .coach-name { font-family: var(--font-heading); text-transform: uppercase; font-size:1.05rem; line-height:1; }
  .coach-tag { font-size:.72rem; text-transform: uppercase; letter-spacing:.12em; color: rgba(255,255,255,.8); margin-top:.25rem; }

  .day { display:flex; align-items:baseline; gap:.75rem; margin-bottom: .9rem; }
  .day-name { font-family: var(--font-heading); text-transform: uppercase; font-size:1.6rem; line-height:1; background:#E8000D; color:#fff; padding:.35rem .6rem .25rem; }
  .day-count { color: rgba(255,255,255,.8); font-size:.85rem; text-transform: uppercase; letter-spacing:.12em; }

  .times { display:grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap:.6rem; }
  @media (min-width: 640px) { .times { grid-template-columns: repeat(4, minmax(0,1fr)); } }
  @media (min-width: 1024px) { .times { grid-template-columns: repeat(6, minmax(0,1fr)); } }
  .tile { border-radius: .9rem; min-height: 78px; padding: .7rem .6rem; display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center; gap:.15rem; border:1px solid transparent; transition: transform .12s ease; }
  .tile:active { transform: scale(.97); }
  .tile-time { font-family: var(--font-heading); font-size:1.5rem; line-height:1; }
  .tile-sub { font-size:.74rem; text-transform: uppercase; letter-spacing:.08em; }
  .tile.open { background:#fff; color:#0A0A0A; }
  .tile.open .tile-sub { color: rgba(10,10,10,.75); font-weight:700; }
  .tile.join { background: rgba(232,0,13,.10); border-color:#E8000D; color:#fff; }
  .tile.join .tile-sub { color:#ff5a63; }
  .tile.full { background: rgba(255,255,255,.08); color: rgba(255,255,255,.55); cursor: not-allowed; }
  .tile.pending { background: transparent; border: 1px dashed rgba(255,255,255,.45); color: rgba(255,255,255,.75); cursor: not-allowed; }
  .legend-pending { border: 1px dashed rgba(255,255,255,.6); }
  .hold-timer { display:inline-block; background:#ffb020; color:#0A0A0A; font-weight:700; font-size:.85rem; padding:.3rem .6rem; }
  #holiday-app .btn-red, #holiday-app .btn-outline, #sheet .btn-red, #holiday-gate .btn-red { text-shadow:none; backdrop-filter:none; -webkit-backdrop-filter:none; }
  .tile.full .tile-time { text-decoration: line-through; }
</style>

<script>
  (function () {
    const $ = (id) => document.getElementById(id)
    const gate = $('holiday-gate'), app = $('holiday-app')
    const state = { data: null, coach: null, slot: null, seats: 1, submitting: false, sessionType: null }

    function recaptcha(action) {
      return window.JonerRecaptcha && typeof window.JonerRecaptcha.getToken === 'function' ? window.JonerRecaptcha.getToken(action) : Promise.resolve('')
    }
    function track(name, data) {
      if (window.JonerTracking && typeof window.JonerTracking.trackEvent === 'function') window.JonerTracking.trackEvent(name, { custom_data: data })
    }
    function notice(text) {
      const box = $('notice')
      if (!text) { box.classList.add('hidden'); return }
      box.firstElementChild.textContent = text
      box.classList.remove('hidden')
    }
    function esc(value) {
      return String(value ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]))
    }
    function coachLabel(c) { return `Coach ${c.name}` }

    // ----- gate -----
    async function checkAccess() {
      try {
        const res = await fetch('/api/holiday-access', { credentials: 'same-origin' })
        return (await res.json()).ok === true
      } catch { return false }
    }

    $('gate-form').addEventListener('submit', async (event) => {
      event.preventDefault()
      const status = $('gate-status')
      const button = event.target.querySelector('button')
      status.textContent = 'Checking'
      button.disabled = true
      try {
        const recaptchaToken = await recaptcha('holiday_gate')
        const res = await fetch('/api/holiday-access', {
          method: 'POST', credentials: 'same-origin',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ password: $('gate-password').value, recaptchaToken }),
        })
        const data = await res.json()
        if (!res.ok || !data.ok) { status.textContent = data.error || 'That password is not right.'; return }
        status.textContent = ''
        showApp()
      } catch {
        status.textContent = 'Could not check the password. Try again.'
      } finally {
        button.disabled = false
      }
    })

    function showApp() {
      gate.hidden = true
      app.hidden = false
      handleCancelledReturn().then(() => loadSlots())
    }

    async function handleCancelledReturn() {
      const params = new URLSearchParams(location.search)
      if (params.get('payment') !== 'cancelled') return
      const bookingId = params.get('booking_id'), releaseToken = params.get('release')
      history.replaceState({}, '', location.pathname)
      if (!bookingId || !releaseToken) return
      try {
        await fetch('/api/holiday-book', {
          method: 'POST', credentials: 'same-origin',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ action: 'release', bookingId, releaseToken }),
        })
      } catch {}
      notice('Payment cancelled. Nothing was charged and your place was released.')
    }

    // ----- data -----
    // quiet: refresh in place without the loading skeleton.
    async function loadSlots(quiet) {
      if (!quiet) {
        $('slots-loading').hidden = false
        $('slots-empty').hidden = true
        $('slots-error').hidden = true
        $('slots-list').innerHTML = ''
      }
      try {
        const res = await fetch('/api/holiday-slots', { credentials: 'same-origin' })
        if (res.status === 401) { app.hidden = true; gate.hidden = false; return }
        const data = await res.json()
        if (!res.ok || !data.success) throw new Error(data.error || 'failed')
        state.data = data
        $('app-heading').textContent = data.holidayLabel || 'School Holiday Sessions'
        $('app-lead').textContent = `All sessions at ${data.location}, ${data.address}. Pick a coach, then tap a time.`
        try { state.coach = sessionStorage.getItem('jf_holiday_coach') } catch {}
        const pickable = data.coaches.filter((c) => c.available)
        if (!pickable.some((c) => c.id === state.coach)) state.coach = pickable[0]?.id || null
        renderCoaches()
        renderSlots()
      } catch {
        $('slots-error').hidden = false
      } finally {
        $('slots-loading').hidden = true
      }
    }
    $('retry').addEventListener('click', () => loadSlots())
    // Keep everyone's view current so a taken hour crosses out without a reload.
    setInterval(() => { if (!app.hidden && $('sheet').hidden && !document.hidden) loadSlots(true) }, 20000)
    document.addEventListener('visibilitychange', () => { if (!document.hidden && !app.hidden && $('sheet').hidden) loadSlots(true) })

    function renderCoaches() {
      $('coaches').innerHTML = state.data.coaches.map((c) => `
        <button type="button" role="tab" class="coach" data-coach="${esc(c.id)}" aria-selected="${state.coach === c.id}" ${c.available ? '' : 'disabled'}>
          <span class="coach-avatar">${esc(c.name.charAt(0))}</span>
          <span><span class="coach-name">${esc(coachLabel(c))}</span><span class="coach-tag block">${c.available ? 'Available' : 'Coming soon'}</span></span>
        </button>`).join('')
    }
    document.addEventListener('click', (event) => {
      const button = event.target.closest('.coach')
      if (!button || button.disabled) return
      state.coach = button.dataset.coach
      try { sessionStorage.setItem('jf_holiday_coach', state.coach) } catch {}
      renderCoaches()
      renderSlots()
    })

    function tileSub(slot) {
      return `to ${esc(slot.endLabel)}`
    }

    function renderSlots() {
      const slots = state.data.slots.filter((s) => s.coachId === state.coach)
      const list = $('slots-list')
      if (!slots.length) { list.innerHTML = ''; $('slots-empty').hidden = false; return }
      $('slots-empty').hidden = true
      const byDate = new Map()
      for (const slot of slots) {
        if (!byDate.has(slot.date)) byDate.set(slot.date, { label: slot.dateLabel, slots: [] })
        byDate.get(slot.date).slots.push(slot)
      }
      list.innerHTML = [...byDate.values()].map((day) => {
        const free = day.slots.filter((s) => !s.booked).length
        return `
          <section>
            <div class="day">
              <h2 class="day-name">${esc(day.label)}</h2>
              <span class="day-count">${free ? `${free} time${free === 1 ? '' : 's'} free` : 'Fully booked'}</span>
            </div>
            <div class="times">
              ${day.slots.map((slot) => slot.booked && slot.pending
                ? `<div class="tile pending" aria-disabled="true"><span class="tile-time">${esc(slot.startLabel)}</span><span class="tile-sub">Being booked</span></div>`
                : slot.booked
                ? `<div class="tile full" aria-disabled="true"><span class="tile-time">${esc(slot.startLabel)}</span><span class="tile-sub">Booked</span></div>`
                : `<button type="button" class="tile open" data-book="${esc(slot.id)}"><span class="tile-time">${esc(slot.startLabel)}</span><span class="tile-sub">${tileSub(slot)}</span></button>`
              ).join('')}
            </div>
          </section>`
      }).join('')
    }

    // Tapping a time locks it for this parent while they fill in the form.
    document.addEventListener('click', async (event) => {
      const button = event.target.closest('[data-book]')
      if (!button || state.reserving) return
      const slot = state.data.slots.find((s) => s.id === button.dataset.book)
      if (!slot) return
      state.reserving = true
      button.disabled = true
      button.querySelector('.tile-sub').textContent = 'Holding'
      try {
        const recaptchaToken = await recaptcha('holiday_reserve')
        const res = await fetch('/api/holiday-book', {
          method: 'POST', credentials: 'same-origin',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ action: 'reserve', slotId: slot.id, recaptchaToken }),
        })
        const data = await res.json().catch(() => ({}))
        if (res.status === 401) { app.hidden = true; gate.hidden = false; return }
        if (!res.ok) { notice(data.error || 'That time was just taken. Pick another.'); loadSlots(true); return }
        state.hold = { bookingId: data.bookingId, releaseToken: data.releaseToken, expiresAt: new Date(data.expiresAt).getTime(), slotId: slot.id }
        openSheet(slot)
      } catch {
        notice('Could not hold that time. Try again.')
        loadSlots(true)
      } finally {
        state.reserving = false
      }
    })

    function releaseHold(useBeacon) {
      const hold = state.hold
      state.hold = null
      clearInterval(state.timer)
      if (!hold) return
      const body = JSON.stringify({ action: 'release', bookingId: hold.bookingId, releaseToken: hold.releaseToken })
      if (useBeacon && navigator.sendBeacon) navigator.sendBeacon('/api/holiday-book', new Blob([body], { type: 'application/json' }))
      else fetch('/api/holiday-book', { method: 'POST', credentials: 'same-origin', keepalive: true, headers: { 'content-type': 'application/json' }, body }).catch(() => {})
    }
    // Leaving the page with the form open hands the hour straight back,
    // except when leaving is the jump to Stripe.
    window.addEventListener('pagehide', () => { if (!state.toStripe) releaseHold(true) })

    function startTimer() {
      const el = $('hold-timer')
      clearInterval(state.timer)
      const tick = () => {
        if (!state.hold) return
        const left = Math.max(0, state.hold.expiresAt - Date.now())
        const m = Math.floor(left / 60000), s = Math.floor((left % 60000) / 1000)
        el.hidden = false
        el.textContent = `This time is held for you for ${m}:${String(s).padStart(2, '0')}`
        if (left <= 0) {
          clearInterval(state.timer)
          state.hold = null
          closeSheet(true)
          notice('Your 10 minutes ran out, so the time was released. Tap it again if it is still free.')
          loadSlots(true)
        }
      }
      tick()
      state.timer = setInterval(tick, 1000)
    }

    // ----- booking sheet -----
    function chosen() {
      const slot = state.slot
      const opt = slot.options.find((o) => o.type === state.sessionType) || slot.options[0]
      return { type: opt.type, label: opt.label, minPlayers: opt.minPlayers || 1, maxPlayers: opt.maxPlayers, priceCents: opt.priceCents, priceLabel: opt.priceLabel }
    }
    function renderTypeOptions() {
      const slot = state.slot
      const block = $('type-block'), locked = $('locked-block')
      locked.hidden = true
      if (slot.options.length < 2) { block.hidden = true; return }
      block.hidden = false
      const hints = { one: 'One player with the coach.', shared: 'Two players you bring.', group: 'Up to 6 players you bring.' }
      $('type-options').innerHTML = slot.options.map((o) => `
        <label class="flex items-center gap-3 border ${state.sessionType === o.type ? 'border-joner-red bg-joner-red/10' : 'border-gray-700'} px-4 py-3 cursor-pointer min-h-[52px]">
          <input type="radio" name="sessionType" value="${esc(o.type)}" ${state.sessionType === o.type ? 'checked' : ''} class="accent-[#E8000D] h-5 w-5" />
          <span class="flex-1"><span class="font-heading uppercase text-base">${esc(o.label)}</span> <span class="text-white/85 text-sm">${esc(hints[o.type] || '')}</span></span>
          <span class="font-heading text-lg">${esc(o.priceLabel)}<span class="text-white/80 text-xs"> each</span></span>
        </label>`).join('')
    }
    document.addEventListener('change', (e) => {
      if (e.target.name !== 'sessionType') return
      state.sessionType = e.target.value
      state.seats = chosen().minPlayers
      renderTypeOptions()
      renderSeats()
    })

    function openSheet(slot) {
      const coach = state.data.coaches.find((c) => c.id === slot.coachId)
      state.slot = slot
      state.sessionType = slot.options[0].type
      state.seats = slot.options[0].minPlayers || 1
      $('sheet-title').textContent = `${slot.dateLabel}, ${slot.startLabel} to ${slot.endLabel}`
      $('sheet-subtitle').textContent = `${coach ? coachLabel(coach) : slot.coachName} at ${slot.location}. ${slot.durationMin} minutes.`
      $('book-status').textContent = ''
      $('book-form').reset()
      renderTypeOptions()
      renderSeats()
      $('sheet-backdrop').hidden = false
      $('sheet').hidden = false
      document.body.style.overflow = 'hidden'
      startTimer()
    }
    function closeSheet(keepHold) {
      $('sheet-backdrop').hidden = true
      $('sheet').hidden = true
      $('hold-timer').hidden = true
      document.body.style.overflow = ''
      state.slot = null
      if (!keepHold) { releaseHold(false); setTimeout(() => loadSlots(true), 400) }
    }
    $('sheet-close').addEventListener('click', () => closeSheet())
    $('sheet-backdrop').addEventListener('click', () => closeSheet())
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !$('sheet').hidden) closeSheet() })

    function renderSeats() {
      const pick = chosen()
      const max = Math.max(1, pick.maxPlayers)
      const min = Math.min(max, Math.max(1, pick.minPlayers))
      if (state.seats > max) state.seats = max
      if (state.seats < min) state.seats = min
      $('seats-block').hidden = max <= 1
      $('seats-value').textContent = String(state.seats)
      $('seats-minus').disabled = state.seats <= min
      $('seats-plus').disabled = state.seats >= max
      $('seats-hint').textContent = min === max && min > 1 ? `This group is for ${min} players. Add all ${min} to book.`
        : min > 1 ? `${min} to ${max} players.`
        : max > 1 ? `Up to ${max} players from your family or friends.` : ''
      const existing = [...$('players').querySelectorAll('[data-player]')].map((row) => ({
        name: row.querySelector('[name="playerName"]').value,
        age: row.querySelector('[name="playerAge"]').value,
      }))
      $('players').innerHTML = Array.from({ length: state.seats }, (_, i) => `
        <div class="grid grid-cols-[1fr_88px] gap-3" data-player="${i}">
          <div>
            <label class="block text-white font-heading text-sm uppercase tracking-wider mb-2">Player ${state.seats > 1 ? i + 1 : ''} name</label>
            <input name="playerName" type="text" required value="${esc(existing[i]?.name || '')}" class="inp" />
          </div>
          <div>
            <label class="block text-white font-heading text-sm uppercase tracking-wider mb-2">Age (7+)</label>
            <input name="playerAge" type="number" min="7" max="18" inputmode="numeric" required value="${esc(existing[i]?.age || '')}" class="inp" />
          </div>
        </div>`).join('')
      const total = pick.priceCents * state.seats / 100
      $('pay-button').textContent = `Pay A$${total % 1 === 0 ? total.toFixed(0) : total.toFixed(2)} with Stripe`
    }
    $('seats-minus').addEventListener('click', () => { if (state.seats > chosen().minPlayers) { state.seats -= 1; renderSeats() } })
    $('seats-plus').addEventListener('click', () => { if (state.seats < chosen().maxPlayers) { state.seats += 1; renderSeats() } })

    $('book-form').addEventListener('submit', async (event) => {
      event.preventDefault()
      if (state.submitting || !state.slot) return
      const form = event.target
      const status = $('book-status')
      const players = [...form.querySelectorAll('[data-player]')].map((row) => ({
        name: row.querySelector('[name="playerName"]').value.trim(),
        age: Number(row.querySelector('[name="playerAge"]').value),
      }))
      if (players.some((p) => p.name.length < 2)) { status.textContent = 'Enter each player\'s name.'; return }
      if (players.some((p) => !Number.isInteger(p.age) || p.age < 7 || p.age > 18)) { status.textContent = 'Holiday sessions are for players aged 7 to 18.'; return }
      if (window.JonerEmailGuard && typeof window.JonerEmailGuard.validateEmail === 'function') {
        const check = window.JonerEmailGuard.validateEmail($('email').value)
        if (check && check.ok === false) { status.textContent = check.error || 'Check the email address.'; return }
      }
      if (!$('agreement').checked) { status.textContent = 'Please accept the terms to continue.'; return }

      state.submitting = true
      $('pay-button').disabled = true
      status.classList.remove('text-joner-red')
      status.textContent = 'Holding your place'
      try {
        const recaptchaToken = await recaptcha('holiday_book')
        const res = await fetch('/api/holiday-book', {
          method: 'POST', credentials: 'same-origin',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            slotId: state.slot.id,
            bookingId: state.hold?.bookingId,
            releaseToken: state.hold?.releaseToken,
            type: chosen().type,
            seats: state.seats,
            players,
            parentName: $('parentName').value.trim(),
            mobile: $('mobile').value.trim(),
            email: $('email').value.trim(),
            notes: $('notes').value.trim(),
            agreementAccepted: true,
            recaptchaToken,
          }),
        })
        const data = await res.json().catch(() => ({}))
        if (res.status === 401) { closeSheet(); app.hidden = true; gate.hidden = false; return }
        if (res.status === 409 || res.status === 404) {
          state.hold = null
          closeSheet(true)
          notice(data.error || 'That time was just booked by someone else. Pick another.')
          loadSlots()
          return
        }
        if (!res.ok || !data.url) { status.classList.add('text-joner-red'); status.textContent = data.error || 'Could not start the payment. Try again.'; return }
        try { sessionStorage.setItem('jf_holiday_booking', data.bookingId) } catch {}
        track('InitiateCheckout', { content_category: 'holiday_session', content_name: state.slot.coachName, value: chosen().priceCents * state.seats / 100, currency: 'AUD', booking_id: data.bookingId })
        status.textContent = 'Taking you to Stripe'
        state.toStripe = true
        clearInterval(state.timer)
        window.location.href = data.url
      } catch {
        status.classList.add('text-joner-red')
        status.textContent = 'Could not start the payment. Try again.'
      } finally {
        state.submitting = false
        $('pay-button').disabled = false
      }
    })

    // ----- boot -----
    checkAccess().then((ok) => { if (ok) showApp(); else { gate.hidden = false; setTimeout(() => $('gate-password').focus(), 50) } })
  })()
</script>
