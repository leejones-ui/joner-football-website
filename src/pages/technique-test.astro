---
import BaseLayout from '../layouts/BaseLayout.astro'
import SanityPageExtras from '../components/sanity/SanityPageExtras.astro'
import SanityPageRenderer from '../components/sanity/SanityPageRenderer.astro'
import { fetchSanityPage } from '../lib/sanityPages'
import { getSanityCta, getSanityImageUrl, getSanityText, shouldReplaceSanityPage } from '../lib/sanityPageUtils'

const sanityPage = await fetchSanityPage('technique-test')
const pageTitle = sanityPage?.seo?.title || 'Joner Technique Test | How Good Are You?'
const pageDescription = sanityPage?.seo?.description || 'Take the free Joner Football technique test. Find out where your technique ranks among footballers worldwide.'
const heroHeadline = getSanityText(sanityPage?.heroHeadline, 'THE JONER FOOTBALL TECHNIQUE TEST')
const heroSubheadline = getSanityText(sanityPage?.heroSubheadline, 'Enter your name and email, take the test, then when you finish we will tell you your results have been sent by email.')
const heroImage = getSanityImageUrl(sanityPage?.heroImage, '/images/training/lee-coaching-action.webp')
const primaryCta = getSanityCta(sanityPage?.primaryCta, { label: "Try the World's #1 Football App Free", url: '/app' })
const secondaryCta = getSanityCta(sanityPage?.secondaryCta, { label: 'Train in Sydney', url: '/training' })
---
{shouldReplaceSanityPage(sanityPage) ? (
  <SanityPageRenderer page={sanityPage} />
) : (
<BaseLayout title={pageTitle} description={pageDescription} canonical={sanityPage?.seo?.canonicalUrl} ogImage={sanityPage?.seo?.imageUrl || heroImage || undefined} noindex={Boolean(sanityPage?.seo?.noIndex)}>

  <!-- EMAIL GATE SECTION -->
  <section id="gate" class="relative min-h-[500px] flex items-center justify-center py-24 overflow-hidden">
    <div class="absolute inset-0">
      <img src={heroImage} alt="Joner Football training" class="w-full h-full object-cover object-center" />
      <div class="absolute inset-0" style="background:rgba(0,0,0,0.7)"></div>
    </div>
    <div class="relative z-10 max-w-xl mx-auto text-center px-4">
      <h1 class="font-heading text-4xl md:text-6xl lg:text-7xl font-bold text-white uppercase mb-4 leading-tight">
        {heroHeadline}
      </h1>
      <p class="text-gray-400 font-body text-lg md:text-xl mb-10">
        {heroSubheadline}
      </p>
      <form id="gate-form" class="max-w-md mx-auto space-y-4">
        <input
          type="text"
          name="name"
          placeholder="Your Name"
          required
          class="w-full px-5 py-3 bg-white/10 border border-gray-700 rounded text-white font-body text-base placeholder-gray-500 focus:outline-none focus:border-[#E30613] transition-colors min-h-[44px]"
        />
        <input
          type="email"
          name="email"
          placeholder="Your Email"
          required
          class="w-full px-5 py-3 bg-white/10 border border-gray-700 rounded text-white font-body text-base placeholder-gray-500 focus:outline-none focus:border-[#E30613] transition-colors min-h-[44px]"
        />
        <button type="submit" class="btn-red w-full text-sm px-6 py-3 font-heading uppercase tracking-wider">
          Take the Test
        </button>
      </form>
    </div>
  </section>

  <!-- TEST SECTION (hidden initially) -->
  <section id="test-section" class="bg-joner-black py-12 px-4 transition-opacity duration-700 ease-in-out" style="display:none; opacity:0;">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-white uppercase text-center mb-8">
        Your Technique Test
      </h2>
      <div class="w-full bg-white rounded-lg overflow-hidden">
        <iframe
          id="test-iframe"
          src="https://technique-test-five.vercel.app/"
          title="Joner Football Technique Test"
          class="w-full border-0"
          style="height: 800px; min-height: 600px;"
          loading="lazy"
          allow="fullscreen"
        ></iframe>
      </div>
      <p class="text-gray-500 font-body text-sm text-center mt-4">
        If the test doesn't load,
        <a href="https://technique-test-five.vercel.app/" target="_blank" rel="noopener noreferrer" class="text-[#E30613] underline hover:text-red-400 transition-colors">
          click here to open it directly
        </a>.
      </p>
    </div>
  </section>

  <!-- CTA SECTION -->
  <section id="cta-section" class="bg-joner-black py-20 px-4" style="display:none; opacity:0;">
    <div class="max-w-3xl mx-auto text-center transition-opacity duration-700 ease-in-out">
      <h2 class="font-heading text-3xl md:text-5xl font-bold text-white uppercase mb-4">
        Want to improve your technique?
      </h2>
      <p class="text-gray-400 font-body text-lg mb-10">
        Take your game to the next level with Joner Football.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        {primaryCta?.label && primaryCta?.url && <a href={primaryCta.url} class="btn-red text-sm px-8 py-3 font-heading uppercase tracking-wider">{primaryCta.label}</a>}
        {secondaryCta?.label && secondaryCta?.url && <a href={secondaryCta.url} class="btn-outline text-sm px-8 py-3 font-heading uppercase tracking-wider">{secondaryCta.label}</a>}
      </div>
    </div>
  </section>

  <SanityPageExtras page={sanityPage} />

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var gate = document.getElementById('gate');
      var form = document.getElementById('gate-form');
      var testSection = document.getElementById('test-section');
      var ctaSection = document.getElementById('cta-section');

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        e.stopImmediatePropagation();

        var nameInput = form.querySelector('input[name="name"]');
        var name = nameInput.value.trim();
        var emailInput = form.querySelector('input[name="email"]');
        var email = emailInput.value.trim();
        var iframe = document.getElementById('test-iframe');

        if (window.JonerEmailGuard) {
          window.JonerEmailGuard.protectEmailInput(emailInput);
          var validation = window.JonerEmailGuard.validateEmail(email);
          window.JonerEmailGuard.setFeedback(emailInput, validation);
          if (!validation.valid) {
            if (typeof emailInput.reportValidity === 'function') emailInput.reportValidity();
            return;
          }
          email = validation.email;
        }

        if (!name || !email) return;

        try {
          localStorage.setItem('joner_tech_test_name', name);
          localStorage.setItem('joner_tech_test_email', email);
        } catch (err) {
          // localStorage not available, continue anyway
        }

        if (iframe) {
          iframe.src = 'https://technique-test-five.vercel.app/?email=' + encodeURIComponent(email) + '&name=' + encodeURIComponent(name);
        }

        // Hide the gate
        gate.style.transition = 'opacity 0.5s ease';
        gate.style.opacity = '0';

        setTimeout(function () {
          gate.style.display = 'none';

          // Show the test section
          testSection.style.display = 'block';
          // Force reflow before transition
          testSection.offsetHeight;
          testSection.style.opacity = '1';

          // Show the CTA section
          ctaSection.style.display = 'block';
          ctaSection.offsetHeight;
          ctaSection.style.opacity = '1';

          // Scroll to top of test
          testSection.scrollIntoView({ behavior: 'smooth' });
        }, 500);
      });
    });
  </script>

</BaseLayout>
)}
