  <script is:inline>
    (() => {
      const headlineTerm = document.getElementById('development-term');
      if (headlineTerm) {
        const timeZone = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
        const isUSTimeZone = timeZone.startsWith('America/')
          && !['America/Toronto', 'America/Vancouver', 'America/Edmonton', 'America/Winnipeg', 'America/Halifax', 'America/St_Johns'].includes(timeZone);

        if (isUSTimeZone) {
          headlineTerm.textContent = 'COMPLETE SOCCER DEVELOPMENT.';
        }
      }

      const audienceFeature = document.querySelector('[data-audience-feature]');
      if (audienceFeature) {
        const totalAudienceCards = 3;
        let audienceIndex = Number(audienceFeature.getAttribute('data-active') || '0');
        let audienceTimer;

        const setAudienceIndex = (nextIndex) => {
          audienceIndex = (nextIndex + totalAudienceCards) % totalAudienceCards;
          audienceFeature.setAttribute('data-active', String(audienceIndex));
        };

        const restartAudienceTimer = () => {
          window.clearInterval(audienceTimer);
          audienceTimer = window.setInterval(() => setAudienceIndex(audienceIndex + 1), 5000);
        };

        audienceFeature.querySelector('[data-audience-prev]')?.addEventListener('click', () => {
          setAudienceIndex(audienceIndex - 1);
          restartAudienceTimer();
        });

        audienceFeature.querySelector('[data-audience-next]')?.addEventListener('click', () => {
          setAudienceIndex(audienceIndex + 1);
          restartAudienceTimer();
        });

        restartAudienceTimer();
      }

      const hero = document.querySelector('[data-scroll-expand-hero]');
      if (!hero) return;

      const clamp = (value, min, max) => Math.min(Math.max(value, min), max);
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let scrollProgress = 0;
      let mediaFullyExpanded = false;
      let touchStartY = 0;
      let isMobile = window.innerWidth < 768;

      const applyProgress = () => {
        const progress = reducedMotion || isMobile ? 1 : scrollProgress;
        hero.style.setProperty('--hero-progress', progress.toFixed(3));
        hero.toggleAttribute('data-expanded', mediaFullyExpanded || progress >= 1);
      };

      const updateProgress = (delta) => {
        scrollProgress = clamp(scrollProgress + delta, 0, 1);
        if (scrollProgress >= 1) {
          scrollProgress = 1;
          mediaFullyExpanded = true;
        } else if (scrollProgress < 0.72) {
          mediaFullyExpanded = false;
        }
        applyProgress();
      };

      const handleWheel = (event) => {
        if (reducedMotion || isMobile) return;

        const atTop = window.scrollY <= 5;
        if (mediaFullyExpanded && event.deltaY < 0 && atTop) {
          mediaFullyExpanded = false;
          event.preventDefault();
          updateProgress(event.deltaY * 0.0009);
          return;
        }

        if (!mediaFullyExpanded && atTop) {
          event.preventDefault();
          updateProgress(event.deltaY * 0.0009);
        }
      };

      const handleTouchStart = (event) => {
        touchStartY = event.touches?.[0]?.clientY || 0;
      };

      const handleTouchMove = (event) => {
        if (reducedMotion || isMobile || !touchStartY) return;

        const touchY = event.touches?.[0]?.clientY || touchStartY;
        const deltaY = touchStartY - touchY;
        const atTop = window.scrollY <= 5;

        if (mediaFullyExpanded && deltaY < -20 && atTop) {
          mediaFullyExpanded = false;
          event.preventDefault();
          updateProgress(deltaY * 0.008);
        } else if (!mediaFullyExpanded && atTop) {
          event.preventDefault();
          const scrollFactor = deltaY < 0 ? 0.008 : 0.005;
          updateProgress(deltaY * scrollFactor);
        }

        touchStartY = touchY;
      };

      const handleTouchEnd = () => {
        touchStartY = 0;
      };

      const handleScroll = () => {
        if (reducedMotion || isMobile) return;
        if (!mediaFullyExpanded && window.scrollY > 0 && window.scrollY < window.innerHeight * 0.6) {
          window.scrollTo(0, 0);
        }
      };

      const handleResize = () => {
        isMobile = window.innerWidth < 768;
        hero.style.setProperty('--hero-mobile', isMobile ? '1' : '0');
        applyProgress();
      };

      const resetSection = () => {
        scrollProgress = 0;
        mediaFullyExpanded = false;
        touchStartY = 0;
        if (window.scrollY !== 0) {
          window.scrollTo(0, 0);
        }
        applyProgress();
      };

      handleResize();
      resetSection();
      window.addEventListener('resetSection', resetSection);
      window.addEventListener('wheel', handleWheel, { passive: false });
      window.addEventListener('scroll', handleScroll);
      window.addEventListener('touchstart', handleTouchStart, { passive: false });
      window.addEventListener('touchmove', handleTouchMove, { passive: false });
      window.addEventListener('touchend', handleTouchEnd);
      window.addEventListener('resize', handleResize);
    })();
  </script>

  <style>
    .app-scroll-hero {
