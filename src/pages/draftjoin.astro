const club = {
  id: 'club',
  name: 'Team / Club',
  badge: 'Request Only',
  subtitle: 'For clubs, teams, academies and schools.',
  blurb: 'Bring your players and coaches into one training system, with separate logins and a dedicated app experience for your group.',
  priceLabel: 'Request',
  note: 'Custom pricing for your group.',
  cta: 'Request Club Pricing',
  url: '/teams',
  features: [
    'Full app access for your group',
    'Separate logins for players and coaches',
    'Team or club section in the app',
    'Player and coach access in one system',
    'Team training content',
    'Club onboarding',
    'Custom pricing based on your group',
    'Built for teams, academies and schools',
  ],
}

const selector = [
  { label: 'Beginner or solo player', detail: 'You want simple drills to train on your own.', target: '#starter', pick: 'Start with Starter' },
  { label: 'Serious player or parent', detail: 'You want real structure and a clear pathway.', target: '#plus', pick: 'Go with Plus' },
  { label: 'Coach or full development', detail: 'You want the full app and Coaches Only.', target: '#max', pick: 'Get Max' },
  { label: 'Team, club or academy', detail: 'You want your whole group in one system.', target: '#club', pick: 'Book a call' },
]

// Comparison: columns are Starter, Plus, Max, Club
const compareGroups = [
  {
    title: 'Train on your own',
    rows: [
      ['Train on your own content', [true, true, true, true]],
      ['Beginner ball mastery', [true, true, true, true]],
      ['Basic drills and how-to videos', [true, true, true, true]],
      ['Prehab, activation and warm-ups', [true, true, true, true]],
      ['Challenges, tips and tutorials', [true, true, true, true]],
    ],
  },
  {
    title: 'Serious player development',
    rows: [
      ['100 Day Transformation Program', [false, true, true, true]],
      ['Advanced drills and training', [false, true, true, true]],
