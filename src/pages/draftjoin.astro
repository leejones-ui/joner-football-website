---
import BaseLayout from '../layouts/BaseLayout.astro'

// DRAFT_PAGE_NOTICE: Hidden direct-access page for Claude/Lee review. Not linked in nav. noindex enabled.
// Decision page. Defaults to Annual billing showing the per-month-billed-annually price (Higgsfield style).
// Prices localise client-side from the app checkout values. Unknown countries default to USD.

const plans = [
  {
    id: 'starter', name: 'Starter', badge: '', tag: 'The Essentials | Solo Training',
    monthlyPrice: '$14.99', monthlyNum: '14.99',
    annualMonthlyPrice: '$10.83', annualMonthlyNum: '10.83',
    annualSave: 'Save $49.89 a year',
    trial: '7-day free trial', cta: 'Start With Starter',
    monthlyUrl: 'https://app.jonerfootball.com/checkout/new?o=183083',
    annualUrl: 'https://app.jonerfootball.com/checkout/new?o=230697',
    style: 'plain',
    features: [
      'Solo follow-along training',
      'Beginner ball mastery',
      'Basic drills and how-to videos',
      'Prehab, activation and warm-ups',
      'Challenges, tips and tutorials',
    ],
  },
  {
    id: 'plus', name: 'Plus', badge: 'Most Popular', tag: 'For players, coaches and parents',
    monthlyPrice: '$19.99', monthlyNum: '19.99',
    annualMonthlyPrice: '$15.00', annualMonthlyNum: '15.00',
    annualSave: 'Save $59.89 a year',
    trial: '7-day free trial', cta: 'Start Plus',
    monthlyUrl: 'https://app.jonerfootball.com/checkout/new?o=230699',
    annualUrl: 'https://app.jonerfootball.com/checkout/new?o=183092',
    style: 'featured',
    features: [
      { text: 'Everything in Starter', lead: true },
      '100 Day Transformation Program',
      'Advanced drills',
      'Cognitive and awareness drills',
      'Age-specific training',
      'DM Lee directly',
      'Livestream training sessions',
      'Mindset, HQ and 1v1 training',
    ],
  },
  {
    id: 'max', name: 'Max', badge: 'Full Access', tag: 'The full app, Coaches Only and serious ballers',
    monthlyPrice: '$39.99', monthlyNum: '39.99',
    annualMonthlyPrice: '$20.83', annualMonthlyNum: '20.83',
    annualSave: 'Save $229.89 a year',
    trial: 'Full access from day one', cta: 'Join Max',
    monthlyUrl: 'https://app.jonerfootball.com/checkout/new?o=230698',
    annualUrl: 'https://app.jonerfootball.com/checkout/new?o=202578',
    style: 'max',
    features: [
      { text: 'Everything in Plus', lead: true },
      'Full access to the entire app',
      { text: 'Includes Coaches Only', coaches: true },
      'Direct coaching access with Lee',
      'Team and position-specific training',
      'Study the game',
      'Pro drills and voice-over training',
      'Session plan videos and PDF plans',
      'Live seminars and session planning',
      'Behind-the-scenes coaching access',
    ],
  },
  {
    id: 'club', name: 'Team / Club', badge: '', tag: 'For teams, clubs and academies',
    priceLabel: 'Custom', trial: 'Built for your group', cta: 'Request Club Pricing',
    url: '/teams/#team-subscription-form', style: 'club',
    features: [
      { text: 'Full app access for your group', lead: true },
      'Player and coach logins',
      'Team or club section in the app',
      'Club onboarding',
      'Custom pricing for your size',
      'Built for clubs, academies and schools',
    ],
  },
]

const compareCols = ['Starter', 'Plus', 'Max', 'Club']
const compareGroups = [
  {
    title: 'Train on your own',
    rows: [
      ['Solo follow-along training', [true, true, true, true]],
      ['Beginner ball mastery', [true, true, true, true]],
      ['Basic drills and how-to videos', [true, true, true, true]],
      ['Prehab, activation and warm-ups', [true, true, true, true]],
      ['Challenges, tips and tutorials', [true, true, true, true]],
    ],
  },
  {
    title: 'Serious player development',
    rows: [
      ['100 Day Transformation Program', [false, true, true, true]],
      ['Advanced drills', [false, true, true, true]],
      ['Cognitive and awareness drills', [false, true, true, true]],
      ['Age-specific training', [false, true, true, true]],
      ['1v1, mindset and HQ sessions', [false, true, true, true]],
      ['Livestream training sessions', [false, true, true, true]],
      ['DM Lee directly', [false, true, true, true]],
    ],
  },
  {
    title: 'Full app and Coaches Only',
    rows: [
      ['Full access to the entire app', [false, false, true, true]],
      ['Coaches Only section', [false, false, true, true]],
      ['Direct coaching access with Lee', [false, false, true, true]],
      ['Team and position-specific training', [false, false, true, true]],
      ['Study the game and pro drills', [false, false, true, true]],
      ['Voice-over training drills', [false, false, true, true]],
      ['Session plan videos and PDF plans', [false, false, true, true]],
      ['Live seminars and session planning', [false, false, true, true]],
    ],
  },
  {
    title: 'Teams and clubs',
    rows: [
      ['Player and coach logins for your group', [false, false, false, true]],
      ['Team or club section in the app', [false, false, false, true]],
      ['Club onboarding with Joner Football', [false, false, false, true]],
      ['Custom pricing for your size', [false, false, false, true]],
    ],
  },
]

const ladder = [
  { name: 'Starter', accent: false, body: 'All the essentials. For players who want simple solo training they can follow straight away and start building better habits with the ball.' },
  { name: 'Plus', accent: true, body: 'For players, parents and coaches who want a clear training pathway, more structure and direct guidance from Lee.' },
  { name: 'Max', accent: false, body: 'For serious players and coaches who want the full Joner system, including Coaches Only, session plans, game study and how Lee builds training.' },
  { name: 'Team / Club', accent: false, body: 'For teams, clubs and academies who want unlimited players and coaches inside their own Joner Football app section and community.' },
]

const faqs = [
  ['Which plan should I choose?', 'Train on your own, start with Starter. Serious about improving, Plus is the best pathway. Want the full app and Coaches Only, go with Max. Running a team or club, request club pricing.'],
  ['Is there a free trial?', 'Starter and Plus come with a 7-day free trial. Max gives you full access from day one.'],
  ['Can I cancel?', 'Yes. You manage your subscription in the app and can cancel anytime. You keep access until the end of the period you paid for.'],
  ['Is Max only for coaches?', 'No. Max is the full Joner Football App for serious players, parents and coaches. The Coaches Only section is included, it is not the only thing in there.'],
  ['Can parents use the app?', 'Yes. Plenty of parents use it to give their player a clear plan at home instead of guessing.'],
  ['Can teams or clubs join?', 'Yes. Team and Club is request only. We set your group up with player and coach access in one system, then scope the pricing to your size.'],
]
---

<BaseLayout
  title="Draft Join Page | Joner Football App New Tiers"
  description="Draft Joner Football App joining page for Starter, Plus, Max and Team Club. Pick the plan built around how serious you are about improving."
  canonical="https://jonerfootball.com/draftjoin/"
  noindex={true}>
  <main id="main-content" class="scroll-smooth bg-white text-[#0A0A0A]">

    <!-- HEADER -->
    <section class="bg-white pt-10 pb-5 md:pt-12 md:pb-7">
      <div class="mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
        <img
          src="/images/join-live/joner-app-logo-header.webp"
          alt="Joner Football App"
          width="1280"
          height="720"
          loading="eager"
          decoding="async"
          class="mx-auto mb-4 h-auto w-36 sm:w-40 md:w-44"
        />
        <h1 class="mx-auto font-heading text-4xl uppercase leading-[0.95] tracking-tight sm:text-5xl md:text-6xl">
          Choose your level, <span class="text-[#E30613]">get to work.</span>
        </h1>
        <p class="mx-auto mt-4 font-body text-base text-gray-700 md:text-lg">
          For players, coaches and parents.
        </p>
      </div>
    </section>

    <!-- PRICING -->
    <section id="plans" class="scroll-mt-24 bg-white pb-10 md:pb-12">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        <!-- Toggle + currency (defaults to Annual) -->
        <div class="mb-10 flex flex-col items-center gap-2.5">
          <div id="billing-switch" class="relative flex w-[320px] max-w-full rounded-full border border-gray-200 bg-gray-100 p-1">
            <span id="toggle-indicator" class="absolute inset-y-1 left-1 w-[calc(50%-0.25rem)] translate-x-full rounded-full bg-black transition-transform duration-300 ease-out"></span>
            <button type="button" data-billing="monthly" aria-pressed="false" class="billing-toggle relative z-10 flex-1 rounded-full py-2.5 text-center font-heading text-sm uppercase tracking-wider text-gray-600 transition-colors">Monthly</button>
            <button type="button" data-billing="annual" aria-pressed="true" class="billing-toggle relative z-10 flex-1 rounded-full py-2.5 text-center font-heading text-sm uppercase tracking-wider text-white transition-colors">Annual <span class="text-[#E30613]">save</span></button>
          </div>
          <p id="currency-note" class="font-body text-xs text-gray-500">Prices shown in AUD</p>
        </div>

        <!-- 4 columns -->
        <div class="grid grid-cols-1 items-stretch gap-4 sm:grid-cols-2 xl:grid-cols-4">
          {plans.map((plan) => (
            <article id={plan.id} class:list={[
              'group relative flex min-h-full scroll-mt-24 flex-col rounded-3xl border p-6 transition-transform duration-200 ease-out md:hover:-translate-y-1.5',
              plan.style === 'featured' && 'border-black bg-black text-white shadow-[0_20px_50px_rgba(0,0,0,0.18)] xl:-mt-2 xl:mb-2',
              plan.style === 'max' && 'border-[#E30613] bg-white text-[#0A0A0A] ring-1 ring-[#E30613]',
              plan.style === 'plain' && 'border-gray-200 bg-white text-[#0A0A0A]',
              plan.style === 'club' && 'border-gray-200 bg-[#0A0A0A] text-white',
            ]}>
              {plan.badge && (
                <div class="absolute -top-3 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-[#E30613] px-3.5 py-1 text-xs font-heading uppercase tracking-wider text-white shadow">{plan.badge}</div>
              )}

              <h3 class="font-heading text-3xl uppercase leading-none">{plan.name}</h3>
              <p class:list={['mt-1.5 min-h-[2.5rem] font-body text-sm font-semibold leading-tight', plan.style === 'featured' || plan.style === 'club' ? 'text-white/75' : 'text-gray-600']}>{plan.tag}</p>

              <div class="mt-4 min-h-[6rem]">
                {plan.priceLabel ? (
                  <span class="font-heading text-5xl leading-none">{plan.priceLabel}</span>
                ) : (
                  <>
                    <div class="min-h-4">
                      <span class:list={['billing-compare font-heading text-sm line-through', plan.style === 'featured' ? 'text-white/50' : 'text-gray-500']} data-plan={plan.id}>{plan.monthlyPrice}</span>
                    </div>
                    <div class="flex items-end gap-1.5">
                      <span class="billing-price font-heading text-5xl leading-none tabular-nums" data-plan={plan.id}>{plan.annualMonthlyPrice}</span>
                      <span class:list={['billing-period pb-1 font-body text-sm', plan.style === 'featured' || plan.style === 'club' ? 'text-white/65' : 'text-gray-600']} data-monthly="/month" data-annual="/mo">/mo</span>
                    </div>
                    <p class:list={['billing-sub font-body text-xs', plan.style === 'featured' || plan.style === 'club' ? 'text-white/55' : 'text-gray-500']} data-plan={plan.id}>billed annually</p>
                  </>
                )}
              </div>

              <p class:list={[
                'mt-2 inline-flex w-fit rounded-md px-2.5 py-1 font-heading text-xs uppercase tracking-wide',
                plan.style === 'plain' || plan.style === 'max' ? 'bg-[#E30613]/10 text-[#E30613]' : 'bg-white/15 text-white',
              ]}>{plan.trial}</p>

              {plan.url ? (
                <a href={plan.url} class:list={['mt-5 w-full px-5 py-3.5 text-sm', plan.style === 'featured' || plan.style === 'club' ? 'jf-btn-dark' : 'jf-btn']}>{plan.cta}</a>
              ) : (
                <a href={plan.annualUrl} data-monthly-url={plan.monthlyUrl} data-annual-url={plan.annualUrl} target="_blank" rel="noopener noreferrer" class:list={['plan-cta mt-5 w-full px-5 py-3.5 text-sm', plan.style === 'featured' || plan.style === 'club' ? 'jf-btn-dark' : 'jf-btn']}>{plan.cta}</a>
              )}
              {!plan.priceLabel && (
                <p class:list={['billing-save mt-2 min-h-4 text-center font-body text-xs font-semibold', plan.style === 'featured' ? 'text-[#ff8088]' : 'text-[#E30613]']} data-plan={plan.id}>{plan.annualSave}</p>
              )}

              <ul class="mt-6 flex-1 space-y-2.5">
                {plan.features.map((feature) => {
                  const label = typeof feature === 'string' ? feature : feature.text
                  const lead = typeof feature === 'object' && feature.lead
                  const coaches = typeof feature === 'object' && feature.coaches
                  return (
                    <li class="flex gap-2.5 font-body text-sm leading-snug">
                      <span class="mt-0.5 shrink-0 font-bold text-[#16a34a]">&check;</span>
                      <span class:list={[
                        lead && 'font-bold',
                        coaches && 'font-semibold underline decoration-[#E30613] decoration-2 underline-offset-2',
                        plan.style === 'featured' || plan.style === 'club' ? 'text-white/90' : 'text-gray-800',
                      ]}>{label}</span>
                    </li>
                  )
                })}
              </ul>
            </article>
          ))}
        </div>

        <!-- Feature strip -->
        <div class="mt-8 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 font-body text-sm font-semibold text-gray-800">
          <span class="rounded-full bg-gray-100 px-3.5 py-1.5">2,000+ training videos</span>
          <span class="rounded-full bg-gray-100 px-3.5 py-1.5">Filter by age, difficulty, drill type and plan</span>
          <span class="rounded-full bg-gray-100 px-3.5 py-1.5">New content every week</span>
          <span class="rounded-full bg-gray-100 px-3.5 py-1.5">Players in 15+ countries</span>
          <span class="rounded-full bg-black px-3.5 py-1.5 font-heading uppercase tracking-wide text-white">50K+ downloads worldwide</span>
        </div>
      </div>
    </section>

    <!-- COMPARISON (single responsive tick/cross table, clear on mobile) -->
    <section id="compare" class="scroll-mt-24 bg-white pb-12 md:pb-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="mb-2 font-heading text-3xl uppercase tracking-tight md:text-4xl">Compare every tier.</h2>
        <p class="mb-7 font-body text-gray-600">Green is included. Grey is not.</p>

        <div class="overflow-hidden rounded-2xl border border-gray-200">
          <table class="w-full table-fixed text-left">
            <colgroup>
              <col class="w-[40%] sm:w-[44%]" /><col /><col /><col /><col />
            </colgroup>
            <thead>
              <tr class="bg-black text-white">
                <th class="p-2.5 font-heading text-[0.7rem] uppercase tracking-wide sm:p-4 sm:text-base sm:tracking-wider">What you get</th>
                {compareCols.map((c) => (
                  <th class:list={['p-2.5 text-center font-heading text-[0.7rem] uppercase tracking-wide sm:p-4 sm:text-base', (c === 'Plus' || c === 'Max') && 'text-[#ff6b73]']}>{c}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {compareGroups.map((group) => (
                <>
                  <tr class="bg-gray-50">
                    <td colspan="5" class="px-2.5 py-2 font-heading text-[0.62rem] uppercase tracking-[0.18em] text-gray-500 sm:px-4 sm:text-xs">{group.title}</td>
                  </tr>
                  {group.rows.map((row) => (
                    <tr class="border-t border-gray-100">
                      <td class="p-2.5 font-body text-[0.72rem] font-semibold leading-tight text-gray-800 sm:p-4 sm:text-sm">{row[0]}</td>
                      {row[1].map((on, i) => (
                        <td class:list={['p-2.5 text-center sm:p-4', (compareCols[i] === 'Plus' || compareCols[i] === 'Max') && 'bg-gray-50/70']}>
                          {on
                            ? <span class="font-heading text-base text-[#16a34a] sm:text-lg">&check;</span>
                            : <span class="font-heading text-base text-gray-300 sm:text-lg">&times;</span>}
                        </td>
                      ))}
                    </tr>
                  ))}
                </>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- KNOW WHAT YOU ARE PAYING FOR (now under the comparison table) -->
    <section aria-label="What you are paying for" class="border-t border-gray-100 bg-gray-50 py-14 md:py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="mb-2 font-heading text-3xl uppercase tracking-tight md:text-4xl">Know exactly what you are paying for.</h2>
        <p class="mb-9 max-w-2xl font-body text-gray-700">The plans are a ladder. Each step adds more structure and more access.</p>
        <div class="grid grid-cols-1 items-stretch gap-4 sm:grid-cols-2 xl:grid-cols-4">
          {ladder.map((card) => (
            <div class:list={['rounded-2xl bg-white p-7', card.accent ? 'border-2 border-[#E30613]' : 'border border-gray-200']}>
              <h3 class:list={['font-heading text-2xl uppercase leading-none', card.accent ? 'text-[#E30613]' : 'text-[#0A0A0A]']}>{card.name}</h3>
              <p class="mt-3 font-body text-sm leading-relaxed text-gray-700">{card.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- MAX INCLUDES COACHES ONLY (photo) -->
    <section aria-label="Max includes Coaches Only" class="bg-white py-14 md:py-18">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="overflow-hidden rounded-3xl bg-[#0A0A0A] text-white">
          <div class="grid grid-cols-1 lg:grid-cols-2">
            <div class="p-8 md:p-12">
              <p class="mb-3 inline-flex rounded-full bg-[#E30613] px-3 py-1 text-xs font-heading uppercase tracking-wider text-white">Only on Max</p>
              <h2 class="font-heading text-4xl uppercase leading-[0.95] md:text-5xl">Max includes<br />Coaches Only.</h2>
              <p class="mt-4 max-w-md font-body text-white/75">The section built for coaches who want detail. Plan sessions, coach better and run your team from the same system the pros learn from.</p>
              <ul class="mt-6 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
                {['Session plan videos', 'PDF session plans', 'Team training', 'Study the game', 'Voice-over drills', 'How Lee coaches the coaches'].map((item) => (
                  <li class="flex gap-3 font-body text-sm text-white/90">
                    <span class="mt-0.5 shrink-0 font-bold text-[#16a34a]">&check;</span>
                    {item}
                  </li>
                ))}
              </ul>
              <a href="#max" class="jf-btn-dark mt-8 px-8 py-4">Join Max</a>
            </div>
            <div class="relative min-h-[260px] lg:min-h-full">
              <img src="/app/uploads/2026/05/soccer-coach-goal-instruction.webp" alt="Lee coaching detail with players" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
              <div class="absolute inset-0 bg-gradient-to-t from-[#0A0A0A] via-transparent to-transparent lg:bg-gradient-to-r"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section aria-label="Questions" class="border-t border-gray-100 bg-gray-50 py-14 md:py-18">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <h2 class="mb-8 font-heading text-3xl uppercase tracking-tight md:text-4xl">Before you join.</h2>
        <div class="space-y-3">
          {faqs.map(([q, a]) => (
            <details class="group rounded-2xl border border-gray-200 bg-white p-6">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-heading text-lg uppercase">
                {q}
                <span class="text-[#E30613] transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="mt-4 font-body leading-relaxed text-gray-700">{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section id="final-cta" class="bg-[#0A0A0A] py-14 md:py-20">
      <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <h2 class="font-heading text-4xl uppercase leading-[0.95] text-white md:text-6xl">Choose your level and get to work.</h2>
        <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
          <a href="#plus" class="jf-btn-dark px-8 py-4">Start Plus</a>
          <a href="#max" class="jf-btn-dark px-8 py-4">Join Max</a>
        </div>
        <a href="#starter" class="mt-5 inline-block font-body text-sm text-white/90 underline underline-offset-4 hover:text-white">Just want the basics? Start with Starter</a>
      </div>
    </section>

    <div class="h-20 md:hidden"></div>
  </main>

  <!-- Mobile sticky CTA -->
  <div id="sticky-cta" class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-gray-200 bg-white/95 p-3 opacity-0 shadow-[0_-8px_30px_rgba(0,0,0,0.08)] backdrop-blur transition-all duration-300 md:hidden">
    <div class="flex items-center justify-between gap-3">
      <div class="leading-tight">
        <p class="font-heading text-sm uppercase text-[#0A0A0A]">Joner Football App</p>
        <p id="sticky-price" class="font-body text-xs text-gray-600">From $10.83/mo billed annually</p>
      </div>
      <a href="#plans" class="jf-btn px-6 py-3 text-sm">Choose Plan</a>
    </div>
  </div>

  <script>
    const toggles = document.querySelectorAll('.billing-toggle')
    const indicator = document.getElementById('toggle-indicator')
    const prices = document.querySelectorAll('.billing-price')
    const periods = document.querySelectorAll('.billing-period')
    const compares = document.querySelectorAll('.billing-compare')
    const subs = document.querySelectorAll('.billing-sub')
    const saves = document.querySelectorAll('.billing-save')
    const ctas = document.querySelectorAll('.plan-cta')
    let currentMode = 'annual'
    let currentRegion = 'US'

    const regionalPricing = {
      US: {
        code: 'USD',
        symbol: '$',
        country: 'United States',
        plans: {
          starter: { monthly: 14.99, annual: 129.99 },
          plus: { monthly: 19.99, annual: 179.99 },
          max: { monthly: 39.99, annual: 249.99 },
        },
      },
      AU: {
        code: 'AUD',
        symbol: '$',
        country: 'Australia',
        plans: {
          starter: { monthly: 23.99, annual: 184.99 },
          plus: { monthly: 28.49, annual: 254.99 },
          max: { monthly: 56.99, annual: 354.99 },
        },
      },
      CA: {
        code: 'CAD',
        symbol: '$',
        country: 'Canada',
        plans: {
          starter: { monthly: 21.00, annual: 184.99 },
          plus: { monthly: 28.99, annual: 254.99 },
          max: { monthly: 55.99, annual: 349.99 },
        },
      },
      EUR: {
        code: 'EUR',
        symbol: '€',
        country: 'Europe',
        plans: {
          starter: { monthly: 13.00, annual: 113.45 },
          plus: { monthly: 18.55, annual: 155.55 },
          max: { monthly: 35.55, annual: 215.55 },
        },
      },
      GB: {
        code: 'GBP',
        symbol: '£',
        country: 'United Kingdom',
        plans: {
          starter: { monthly: 11.99, annual: 98.50 },
          plus: { monthly: 15.45, annual: 134.45 },
          max: { monthly: 29.95, annual: 186.45 },
        },
      },
    }
    const eurozone = ['AT','BE','CY','EE','FI','FR','DE','GR','IE','IT','LV','LT','LU','MT','NL','PT','SK','SI','ES']

    const fmt = (n, region = currentRegion) => {
      const p = regionalPricing[region] || regionalPricing.US
      return p.symbol + Number(n).toFixed(2)
    }
    const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3)

    function priceForPlan(planId, mode, region = currentRegion) {
      const regionPrices = regionalPricing[region] || regionalPricing.US
      const plan = regionPrices.plans[planId]
      if (!plan) return null
      return mode === 'annual' ? plan.annual / 12 : plan.monthly
    }

    function rollNumber(el, from, to, region = currentRegion) {
      const dur = 520
      let start = null
      function step(ts) {
        if (start === null) start = ts
        const p = Math.min((ts - start) / dur, 1)
        el.textContent = fmt(from + (to - from) * easeOutCubic(p), region)
        if (p < 1) requestAnimationFrame(step)
        else el.textContent = fmt(to, region)
      }
      requestAnimationFrame(step)
    }

    function regionFromCountryCode(countryCode) {
      const c = countryCode || ''
      if (c === 'AU') return 'AU'
      if (c === 'US') return 'US'
      if (c === 'CA') return 'CA'
      if (c === 'GB') return 'GB'
      if (eurozone.indexOf(c) > -1) return 'EUR'
      return 'US'
    }

    function annualSaving(planId, region = currentRegion) {
      const p = regionalPricing[region] || regionalPricing.US
      const plan = p.plans[planId]
      return plan ? plan.monthly * 12 - plan.annual : 0
    }

    function setBilling(mode, animate) {
      const regionPrices = regionalPricing[currentRegion] || regionalPricing.US
      toggles.forEach((t) => {
        const active = t.getAttribute('data-billing') === mode
        t.setAttribute('aria-pressed', active ? 'true' : 'false')
        t.classList.toggle('text-white', active)
        t.classList.toggle('text-gray-600', !active)
      })
      if (indicator) indicator.classList.toggle('translate-x-full', mode === 'annual')

      prices.forEach((el) => {
        const planId = el.getAttribute('data-plan')
        const to = priceForPlan(planId, mode)
        if (to !== null) el.textContent = fmt(to)
      })
      periods.forEach((el) => { el.textContent = el.getAttribute('data-' + mode) || '' })
      compares.forEach((el) => {
        const planId = el.getAttribute('data-plan')
        const plan = regionPrices.plans[planId]
        const v = mode === 'annual' && plan ? fmt(plan.monthly) : ''
        el.textContent = v
        el.classList.toggle('hidden', !v)
      })
      subs.forEach((el) => {
        const planId = el.getAttribute('data-plan')
        const plan = regionPrices.plans[planId]
        el.textContent = mode === 'annual' && plan ? 'billed annually' : ''
      })
      saves.forEach((el) => {
        const planId = el.getAttribute('data-plan')
        el.textContent = mode === 'annual' ? 'Save ' + fmt(annualSaving(planId)) + ' a year' : ''
      })
      ctas.forEach((el) => {
        const href = el.getAttribute('data-' + mode + '-url')
        if (href) el.setAttribute('href', href)
      })
      if (note) note.textContent = 'Prices shown in ' + regionPrices.code + ' (' + regionPrices.country + ')'
      const stickyPrice = document.getElementById('sticky-price')
      if (stickyPrice) stickyPrice.textContent = 'From ' + fmt(priceForPlan('starter', 'annual')) + '/mo billed annually'
      currentMode = mode
    }

    toggles.forEach((t) => t.addEventListener('click', () => setBilling(t.getAttribute('data-billing') || 'annual', true)))
    const note = document.getElementById('currency-note')

    function setRegion(region) {
      currentRegion = regionalPricing[region] ? region : 'US'
      setBilling(currentMode, false)
    }

    setBilling('annual', false)

    fetch('https://ipapi.co/json/')
      .then((r) => { if (!r.ok) throw new Error('ipapi blocked'); return r.json() })
      .then((d) => { setRegion(regionFromCountryCode(d.country_code)) })
      .catch(() => {
        fetch('https://ipwho.is/')
          .then((r) => { if (!r.ok) throw new Error('ipwho blocked'); return r.json() })
          .then((d) => { setRegion(regionFromCountryCode(d.country_code)) })
          .catch(() => { setRegion('US') })
      })

    // Sticky mobile CTA
    const bar = document.getElementById('sticky-cta')
    if (bar) {
      let overFinal = false
      function update() {
        const show = window.scrollY > 520 && !overFinal
        bar.classList.toggle('opacity-0', !show)
        bar.classList.toggle('translate-y-full', !show)
        bar.classList.toggle('pointer-events-none', !show)
      }
      window.addEventListener('scroll', update, { passive: true })
      window.addEventListener('resize', update)
      const final = document.getElementById('final-cta')
      if (final && 'IntersectionObserver' in window) {
        new IntersectionObserver((entries) => {
          entries.forEach((e) => { overFinal = e.isIntersecting })
          update()
        }, { threshold: 0.05 }).observe(final)
      }
      update()
    }
  </script>
</BaseLayout>
