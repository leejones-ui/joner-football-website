---

<BaseLayout
  title="Draft Join Page | Joner Football App New Tiers"
  description="Draft Joner Football App joining page for Starter, Plus, Max and Team Club. Pick the plan built around how serious you are about improving."
  canonical="https://jonerfootball.com/draftjoin/"
  noindex={true}>
  <main id="main-content" class="scroll-smooth bg-[#0A0A0A] text-white">

    <!-- HERO -->
    <section class="relative overflow-hidden border-b border-white/10 bg-[#0A0A0A] pt-24 pb-12 md:pt-28 md:pb-16">
      <div class="pointer-events-none absolute -right-32 -top-24 h-[420px] w-[420px] rounded-full bg-[#E30613]/20 blur-[120px]"></div>
      <div class="relative mx-auto grid max-w-7xl grid-cols-1 items-center gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:gap-8 lg:px-8">
        <div>
          <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-body font-bold uppercase tracking-wider text-white/80">
            <span class="h-2 w-2 rounded-full bg-[#E30613]"></span>
            50,000+ players, coaches and parents
          </p>
          <h1 class="font-heading text-5xl uppercase leading-[0.92] tracking-tight sm:text-6xl md:text-7xl">
            Train smarter.<br />Improve faster.<br /><span class="text-[#E30613]">Pick your level.</span>
          </h1>
          <p class="mt-5 max-w-xl font-body text-base leading-relaxed text-white/70 md:text-lg">
            From solo training to full coach access, choose the Joner Football App plan built around how serious you are about improving. Find yours in under a minute.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="#plans" class="inline-flex items-center justify-center rounded-full bg-[#E30613] px-8 py-4 font-heading uppercase tracking-wider text-white transition-colors hover:bg-[#b80510]">Choose Your Plan</a>
            <a href="#compare" class="inline-flex items-center justify-center rounded-full border border-white/25 px-8 py-4 font-heading uppercase tracking-wider text-white transition-colors hover:border-white hover:bg-white/5">Compare Tiers</a>
          </div>
          <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2 font-body text-sm text-white/55">
            <span>1,500+ training videos</span>
            <span class="text-white/20">/</span>
            <span>New content every week</span>
            <span class="text-white/20">/</span>
            <span>Players in 15+ countries</span>
          </div>
        </div>
        <div class="relative flex justify-center lg:justify-end">
          <img
            src="/images/app/joner-app-main-iphone-current-transparent.avif"
            alt="The Joner Football App on iPhone"
            width="520" height="560"
            loading="eager" decoding="async"
            class="h-auto w-[68%] max-w-[360px] drop-shadow-[0_30px_60px_rgba(0,0,0,0.6)] sm:w-[58%] lg:w-full lg:max-w-[440px]" />
        </div>
      </div>
    </section>

    <!-- WHO IS THIS FOR -->
    <section aria-label="Find your plan" class="bg-[#0A0A0A] py-12 md:py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="mb-2 font-heading text-3xl uppercase tracking-tight md:text-4xl">Who is this for?</h2>
        <p class="mb-8 font-body text-white/60">Tap the one that sounds like you.</p>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {selector.map((s) => (
            <a href={s.target} class="group flex flex-col justify-between rounded-2xl border border-white/10 bg-[#141414] p-6 transition-colors hover:border-[#E30613]">
              <div>
                <h3 class="font-heading text-xl uppercase leading-tight">{s.label}</h3>
                <p class="mt-2 font-body text-sm text-white/60">{s.detail}</p>
              </div>
              <span class="mt-5 inline-flex items-center gap-2 font-heading text-sm uppercase tracking-wider text-[#E30613]">
                {s.pick}
                <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- PRICING -->
    <section id="plans" class="scroll-mt-24 bg-[#0A0A0A] py-12 md:py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-8 flex flex-col gap-5 md:mb-12 md:flex-row md:items-end md:justify-between">
          <div>
            <h2 class="font-heading text-4xl uppercase leading-none tracking-tight md:text-5xl">Choose your level.</h2>
            <p class="mt-3 font-body text-white/60">Start with the basics or go all in. You can change plan anytime.</p>
          </div>
          <div class="w-full md:w-auto">
            <div class="inline-flex w-full rounded-full border border-white/15 bg-white/5 p-1 md:w-auto" aria-label="Billing toggle" role="group">
              <button type="button" data-billing="monthly" aria-pressed="true" class="billing-toggle flex-1 rounded-full bg-white px-6 py-2.5 font-heading text-sm uppercase tracking-wider text-black transition md:flex-none">Monthly</button>
              <button type="button" data-billing="annual" aria-pressed="false" class="billing-toggle flex-1 rounded-full px-6 py-2.5 font-heading text-sm uppercase tracking-wider text-white/60 transition md:flex-none">Annual <span class="text-[#E30613]">save</span></button>
            </div>
            <p class="mt-2 text-right font-body text-xs text-white/40">Prices in USD. You see your local price at checkout.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 items-stretch gap-5 md:grid-cols-2 xl:grid-cols-4">
          {plans.map((plan) => (
            <article id={plan.id} class:list={[
              'relative flex min-h-full scroll-mt-24 flex-col rounded-[1.75rem] border p-6 md:p-7',
              plan.style === 'featured' && 'border-[#E30613] bg-white text-black shadow-[0_24px_70px_rgba(227,6,19,0.25)] xl:-mt-3 xl:mb-3',
              plan.style === 'premium' && 'border-[#E30613]/50 bg-gradient-to-b from-[#1b1b1b] to-[#0e0e0e] text-white ring-1 ring-[#E30613]/30',
              plan.style === 'muted' && 'border-white/10 bg-[#141414] text-white',
            ]}>
              {plan.badge && (
                <div class:list={[
                  'absolute -top-3 left-6 rounded-full px-4 py-1.5 text-xs font-heading uppercase tracking-wider shadow-lg',
                  plan.style === 'premium' ? 'bg-white text-black' : 'bg-[#E30613] text-white',
                ]}>{plan.badge}</div>
              )}

              <h3 class="font-heading text-3xl uppercase leading-none md:text-4xl">{plan.name}</h3>
              <p class:list={['mt-2 font-body text-sm font-semibold', plan.style === 'featured' ? 'text-gray-600' : 'text-white/65']}>{plan.subtitle}</p>

              <div class="mt-5">
                <div class="min-h-5">
                  <span class:list={['billing-compare hidden font-heading text-base line-through', plan.style === 'featured' ? 'text-gray-400' : 'text-white/40']} data-monthly="" data-annual={plan.annualCompare}></span>
                </div>
                <div class="flex items-end gap-1.5">
                  <span class="billing-price font-heading text-5xl leading-none md:text-6xl" data-monthly={plan.monthlyPrice} data-annual={plan.annualPrice}>{plan.monthlyPrice}</span>
                  <span class:list={['billing-period pb-1 font-body text-sm', plan.style === 'featured' ? 'text-gray-500' : 'text-white/55']} data-monthly="/month" data-annual="/year">/month</span>
                </div>
                <p class:list={['billing-note mt-2 font-body text-sm', plan.style === 'featured' ? 'text-gray-600' : 'text-white/60']} data-monthly={plan.monthlyNote} data-annual={plan.annualNote}>{plan.monthlyNote}</p>
                <p class:list={['mt-1 font-heading text-xs uppercase tracking-wider', plan.style === 'featured' ? 'text-[#E30613]' : 'text-[#ff6a72]']}>{plan.trial}</p>
              </div>

              <a href={plan.monthlyUrl} data-monthly-url={plan.monthlyUrl} data-annual-url={plan.annualUrl} target="_blank" rel="noopener noreferrer" class:list={[
                'plan-cta mt-6 block w-full rounded-full px-5 py-4 text-center font-heading uppercase tracking-wider transition-colors',
                plan.style === 'featured' ? 'bg-[#E30613] text-white hover:bg-[#b80510]' : 'bg-[#E30613] text-white hover:bg-[#b80510]',
              ]}>{plan.cta}</a>

              <ul class="mt-7 flex-1 space-y-3">
                {plan.features.map((feature) => (
                  <li class:list={[
                    'flex gap-3 font-body text-sm leading-snug',
                    feature === 'Includes Coaches Only' && 'rounded-lg bg-[#E30613] px-3 py-2 font-bold text-white',
                  ]}>
                    <span class:list={[
                      'mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-[0.7rem] font-bold',
                      feature === 'Includes Coaches Only' ? 'bg-white text-[#E30613]' : 'bg-[#E30613] text-white',
                    ]}>&check;</span>
                    <span class:list={[feature === 'Includes Coaches Only' ? '' : (plan.style === 'featured' ? 'text-gray-800' : 'text-white/85')]}>{feature}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>

        <!-- CLUB ROW -->
        <article id={club.id} class="mt-5 scroll-mt-24 overflow-hidden rounded-[1.75rem] border border-white/10 bg-[#141414]">
          <div class="grid grid-cols-1 gap-6 p-6 md:grid-cols-12 md:items-center md:p-8">
            <div class="md:col-span-5">
              <div class="mb-3 inline-flex rounded-full bg-white/10 px-3 py-1 text-xs font-heading uppercase tracking-wider text-white/80">{club.badge}</div>
              <h3 class="font-heading text-3xl uppercase leading-none md:text-4xl">{club.name}</h3>
              <p class="mt-3 max-w-md font-body text-sm text-white/65">{club.blurb}</p>
              <a href={club.url} class="mt-5 inline-flex rounded-full bg-white px-7 py-3.5 font-heading uppercase tracking-wider text-black transition-colors hover:bg-[#E30613] hover:text-white">{club.cta}</a>
            </div>
            <div class="md:col-span-7">
              <ul class="grid grid-cols-1 gap-x-6 gap-y-2.5 sm:grid-cols-2">
                {club.features.map((feature) => (
                  <li class="flex gap-3 font-body text-sm text-white/85">
                    <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#E30613] text-[0.7rem] font-bold text-white">&check;</span>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- WHY UPGRADE -->
    <section aria-label="Why upgrade" class="border-y border-white/10 bg-[#0e0e0e] py-14 md:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="mb-3 font-heading text-3xl uppercase tracking-tight md:text-5xl">Know exactly what you are paying for.</h2>
        <p class="mb-10 max-w-2xl font-body text-white/60">The plans are a ladder. Each step adds more structure and more access. Here is the jump.</p>
        <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
          <div class="rounded-2xl border border-white/10 bg-[#141414] p-7">
            <p class="font-heading text-sm uppercase tracking-wider text-white/45">Starter</p>
            <h3 class="mt-1 font-heading text-2xl uppercase">The basics</h3>
            <p class="mt-3 font-body text-sm text-white/65">Train on your own with simple drills, ball mastery and warm-ups. A safe place to start.</p>
          </div>
          <div class="rounded-2xl border border-[#E30613] bg-[#141414] p-7 ring-1 ring-[#E30613]/40">
            <p class="font-heading text-sm uppercase tracking-wider text-[#E30613]">Plus</p>
            <h3 class="mt-1 font-heading text-2xl uppercase">The structure</h3>
            <p class="mt-3 font-body text-sm text-white/75">The serious player pathway. The 100 Day Program, advanced and age-specific training, and DM Lee directly.</p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-[#141414] p-7">
            <p class="font-heading text-sm uppercase tracking-wider text-white/45">Max</p>
            <h3 class="mt-1 font-heading text-2xl uppercase">The full system</h3>
            <p class="mt-3 font-body text-sm text-white/65">Everything in the app plus Coaches Only. Session plans, team training, study the game and how Lee coaches the coaches.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- COACHES ONLY SPOTLIGHT -->
    <section aria-label="Max includes Coaches Only" class="bg-[#0A0A0A] py-14 md:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="overflow-hidden rounded-[2rem] border border-[#E30613]/40 bg-gradient-to-br from-[#1a1a1a] to-[#0b0b0b]">
          <div class="grid grid-cols-1 lg:grid-cols-2">
            <div class="p-8 md:p-12">
              <p class="mb-3 inline-flex rounded-full bg-[#E30613] px-3 py-1 text-xs font-heading uppercase tracking-wider text-white">Only on Max</p>
              <h2 class="font-heading text-4xl uppercase leading-[0.95] md:text-5xl">Max includes<br />Coaches Only.</h2>
              <p class="mt-4 max-w-md font-body text-white/70">The section built for coaches who want detail. Plan sessions, coach better and run your team from the same system the pros learn from.</p>
              <ul class="mt-6 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
                {['Session plan videos', 'PDF session plans', 'Team training', 'Study The Game', 'Voice-over drills', 'How Lee coaches the coaches'].map((item) => (
                  <li class="flex gap-3 font-body text-sm text-white/85">
                    <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#E30613] text-[0.7rem] font-bold text-white">&check;</span>
                    {item}
                  </li>
                ))}
              </ul>
              <a href="#max" class="mt-8 inline-flex rounded-full bg-[#E30613] px-8 py-4 font-heading uppercase tracking-wider text-white transition-colors hover:bg-[#b80510]">Join Max</a>
            </div>
            <div class="relative min-h-[260px] lg:min-h-full">
              <img
                src="/app/uploads/2026/05/soccer-coach-goal-instruction.webp"
                alt="Lee coaching detail with players"
                loading="lazy" decoding="async"
                class="absolute inset-0 h-full w-full object-cover" />
              <div class="absolute inset-0 bg-gradient-to-t from-[#0b0b0b] via-transparent to-transparent lg:bg-gradient-to-r"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PROOF -->
    <section aria-label="Why Joner Football" class="border-y border-white/10 bg-[#0e0e0e] py-14 md:py-18">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-center">
          <div>
            <h2 class="font-heading text-3xl uppercase leading-tight md:text-4xl">Built by Lee Jones.<br />Trusted worldwide.</h2>
            <p class="mt-4 max-w-lg font-body text-white/65">This is the same coaching detail Joner Football is known for, in one app. Players, parents and coaches use it every day to stop guessing and train properly.</p>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div class="rounded-2xl border border-white/10 bg-[#141414] p-6">
              <p class="font-heading text-4xl text-[#E30613] md:text-5xl">50,000+</p>
              <p class="mt-1 font-body text-sm text-white/60">Players, coaches and parents</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-[#141414] p-6">
              <p class="font-heading text-4xl text-[#E30613] md:text-5xl">1,500+</p>
              <p class="mt-1 font-body text-sm text-white/60">Training videos in the app</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-[#141414] p-6">
              <p class="font-heading text-4xl text-[#E30613] md:text-5xl">Weekly</p>
              <p class="mt-1 font-body text-sm text-white/60">New content added</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-[#141414] p-6">
              <p class="font-heading text-4xl text-[#E30613] md:text-5xl">15+</p>
              <p class="mt-1 font-body text-sm text-white/60">Countries training with us</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- COMPARISON -->
    <section id="compare" class="scroll-mt-24 bg-[#0A0A0A] py-14 md:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="mb-2 font-heading text-3xl uppercase tracking-tight md:text-5xl">Compare every tier.</h2>
        <p class="mb-8 font-body text-white/60">See exactly what you unlock as you move up.</p>

        <!-- Desktop table -->
        <div class="hidden overflow-hidden rounded-[1.5rem] border border-white/10 md:block">
          <table class="w-full text-left">
            <thead>
              <tr class="bg-black">
                <th class="p-5 font-heading uppercase tracking-wider text-white">Included</th>
                {compareCols.map((c) => (
                  <th class:list={['p-5 text-center font-heading uppercase tracking-wider', c === 'Plus' || c === 'Max' ? 'text-[#E30613]' : 'text-white']}>{c}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {compareGroups.map((group) => (
                <>
                  <tr class="bg-white/5">
                    <td colspan="5" class="px-5 py-2.5 font-heading text-xs uppercase tracking-[0.2em] text-white/45">{group.title}</td>
                  </tr>
                  {group.rows.map((row) => (
                    <tr class="border-t border-white/5">
                      <td class="p-4 font-body text-sm font-semibold text-white/90">{row[0]}</td>
                      {row[1].map((on, i) => (
                        <td class:list={['p-4 text-center', (compareCols[i] === 'Plus' || compareCols[i] === 'Max') && 'bg-white/[0.03]']}>
                          {on
                            ? <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-[#E30613] text-sm font-bold text-white">&check;</span>
                            : <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-white/5 text-sm text-white/25">&times;</span>}
                        </td>
                      ))}
                    </tr>
                  ))}
                </>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Mobile accordions -->
        <div class="space-y-3 md:hidden">
          {mobileCompare.map((tier) => (
            <details class="overflow-hidden rounded-2xl border border-white/10 bg-[#141414]">
              <summary class="flex cursor-pointer items-center justify-between gap-3 p-5">
                <span class="font-heading text-xl uppercase">{tier.name}</span>
                <span class="flex items-center gap-2 font-body text-sm text-white/55">{tier.price}<span class="text-[#E30613]">+</span></span>
              </summary>
              <ul class="space-y-2.5 px-5 pb-5">
                {tier.features.map((feature) => (
                  <li class="flex gap-3 font-body text-sm text-white/85">
                    <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#E30613] text-[0.7rem] font-bold text-white">&check;</span>
                    {feature}
                  </li>
                ))}
              </ul>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section aria-label="Questions" class="border-t border-white/10 bg-[#0e0e0e] py-14 md:py-20">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <h2 class="mb-8 font-heading text-3xl uppercase tracking-tight md:text-5xl">Before you join.</h2>
        <div class="space-y-3">
          {faqs.map(([q, a]) => (
            <details class="group rounded-2xl border border-white/10 bg-[#141414] p-6">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-heading text-lg uppercase">
                {q}
                <span class="text-[#E30613] transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="mt-4 font-body leading-relaxed text-white/70">{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section id="final-cta" class="bg-[#E30613] py-16 md:py-24">
      <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <h2 class="font-heading text-4xl uppercase leading-[0.95] text-white md:text-6xl">Choose your level and start training properly.</h2>
        <p class="mx-auto mt-4 max-w-xl font-body text-white/85">If you are serious about improving, Plus is the best path. If you want the full Joner system, Max is the one.</p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <a href="#plus" class="inline-flex items-center justify-center rounded-full bg-white px-8 py-4 font-heading uppercase tracking-wider text-black transition-colors hover:bg-black hover:text-white">Start Plus</a>
          <a href="#max" class="inline-flex items-center justify-center rounded-full bg-black px-8 py-4 font-heading uppercase tracking-wider text-white transition-colors hover:bg-[#0A0A0A]">Join Max</a>
        </div>
        <a href="#starter" class="mt-5 inline-block font-body text-sm text-white/80 underline underline-offset-4 hover:text-white">Just want the basics? Start with Starter</a>
      </div>
    </section>

    <div class="h-20 md:hidden"></div>
  </main>

  <!-- Mobile sticky CTA -->
  <div id="sticky-cta" class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-white/10 bg-[#0A0A0A]/95 p-3 opacity-0 backdrop-blur transition-all duration-300 md:hidden">
    <div class="flex items-center justify-between gap-3">
      <div class="leading-tight">
        <p class="font-heading text-sm uppercase text-white">Joner Football App</p>
        <p class="font-body text-xs text-white/55">Plans from $14.99/mo</p>
      </div>
      <a href="#plans" class="rounded-full bg-[#E30613] px-6 py-3 font-heading text-sm uppercase tracking-wider text-white">Choose Plan</a>
    </div>
  </div>

  <script>
    // Billing toggle
    const toggles = document.querySelectorAll('.billing-toggle')
    const prices = document.querySelectorAll('.billing-price')
    const periods = document.querySelectorAll('.billing-period')
    const compares = document.querySelectorAll('.billing-compare')
    const notes = document.querySelectorAll('.billing-note')
    const ctas = document.querySelectorAll('.plan-cta')

    function setBilling(mode) {
      toggles.forEach((t) => {
        const active = t.getAttribute('data-billing') === mode
        t.setAttribute('aria-pressed', active ? 'true' : 'false')
        t.classList.toggle('bg-white', active)
        t.classList.toggle('text-black', active)
        t.classList.toggle('text-white/60', !active)
      })
      prices.forEach((el) => { el.textContent = el.getAttribute('data-' + mode) || '' })
      periods.forEach((el) => { el.textContent = el.getAttribute('data-' + mode) || '' })
      notes.forEach((el) => { el.textContent = el.getAttribute('data-' + mode) || '' })
      compares.forEach((el) => {
        const v = el.getAttribute('data-' + mode) || ''
        el.textContent = v
        el.classList.toggle('hidden', !v)
      })
      ctas.forEach((el) => {
        const href = el.getAttribute('data-' + mode + '-url')
        if (href) el.setAttribute('href', href)
      })
    }
    toggles.forEach((t) => t.addEventListener('click', () => setBilling(t.getAttribute('data-billing') || 'monthly')))
    setBilling('monthly')

    // Sticky mobile CTA: show after hero, hide over the final CTA
    const bar = document.getElementById('sticky-cta')
    if (bar) {
      let overFinal = false
      function update() {
        const show = window.scrollY > 560 && !overFinal
        bar.classList.toggle('opacity-0', !show)
        bar.classList.toggle('translate-y-full', !show)
        bar.classList.toggle('pointer-events-none', !show)
      }
      window.addEventListener('scroll', update, { passive: true })
      window.addEventListener('resize', update)
      const final = document.getElementById('final-cta')
      if (final && 'IntersectionObserver' in window) {
        new IntersectionObserver((entries) => {
          entries.forEach((e) => { overFinal = e.isIntersecting })
          update()
        }, { threshold: 0.05 }).observe(final)
      }
      update()
    }
  </script>
</BaseLayout>
