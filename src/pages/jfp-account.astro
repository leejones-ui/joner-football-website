---
import BaseLayout from '../layouts/BaseLayout.astro'
import JfpHeader from '../components/JfpHeader.astro'
import JfpFooter from '../components/JfpFooter.astro'
import '../styles/jfp.css'
---

<BaseLayout title="My account | Joner Football" description="Your Joner Football Performance players, sessions and payments." canonical="https://jonerfootball.com/jfp-account/" noindex noTracking hideChrome hideMobileAppCta>
  <div class="jfp" id="jfp-account">
    <JfpHeader active="account" />

    <section id="signin" class="j-gate" hidden>
      <div class="j-card">
        <p class="j-kicker">My account</p>
        <h1 style="margin:6px 0 16px">Sign in</h1>
        <div id="si-mount"></div>
        <div id="si-foot" style="margin-top:6px"></div>
      </div>
    </section>

    <div id="app" class="wrap" style="max-width:860px;padding-bottom:60px" hidden>
      <div id="banner" style="margin-top:18px"></div>
      <section class="j-hero">
        <p class="j-kicker" id="term">JFP</p>
        <h1 style="margin-top:6px" id="hello">Your players</h1>
        <p class="muted" id="who" style="margin-top:6px"></p>
      </section>
      <section id="todo-wrap" class="j-section" hidden>
        <h2 style="margin-bottom:10px">Finish your booking</h2>
        <div id="todo"></div>
      </section>
      <section id="next-wrap" class="j-section" hidden>
        <h2 style="margin-bottom:10px" id="next-title">Next term</h2>
        <div id="next"></div>
      </section>
      <section class="j-section">
        <div id="players"></div>
      </section>
      <section id="requests-wrap" class="j-section" hidden>
        <h2 style="margin-bottom:10px">Applications, trials and waitlist</h2>
        <div id="requests"></div>
      </section>
      <p class="muted small">Something not right? <button type="button" class="j-foot-link" style="display:inline;text-decoration:underline" data-contact>Contact us</button>.</p>
    </div>
    <JfpFooter />
  </div>
</BaseLayout>

<script>
  import '../scripts/jfp-account.js'
</script>
