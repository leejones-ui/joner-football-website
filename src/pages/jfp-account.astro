---
import BaseLayout from '../layouts/BaseLayout.astro'
import JfpHeader from '../components/JfpHeader.astro'
import JfpFooter from '../components/JfpFooter.astro'
import '../styles/jfp.css'
---

<BaseLayout title="My account | Joner Football" description="Your Joner Football Performance players, sessions and payments." canonical="https://jonerfootball.com/jfp-account/" noindex noTracking hideChrome hideMobileAppCta>
  <div class="jfp" id="jfp-account">
    <JfpHeader active="account" />

    <section id="signin" class="j-gate" hidden>
      <div class="j-card">
        <p class="j-kicker">My account</p>
        <h1 style="margin:6px 0 16px">Sign in</h1>
        <div id="si-mount"></div>
        <div id="si-foot" style="margin-top:6px"></div>
      </div>
    </section>

    <div id="app" class="jp-app ja-app" hidden>
      <nav class="jp-nav" id="ja-nav" aria-label="My account">
        <button type="button" data-panel="home" aria-current="page">Home</button>
        <button type="button" data-panel="sessions">My sessions</button>
        <a class="ja-navlink" href="/jfp-booking/">Timetable</a>
        <button type="button" data-panel="term">About Term 4</button>
        <button type="button" data-panel="cancel">Can't make a session</button>
        <button type="button" data-panel="videos">Training videos</button>
        <button type="button" data-panel="app">The JF App</button>
        <button type="button" data-contact>Contact us</button>
      </nav>
      <main class="jp-main ja-main" id="view" tabindex="-1">
        <div id="banner"></div>
        <header class="ja-head">
          <div><p class="j-kicker" id="term">JFP</p><h1 id="hello">Your players</h1><p class="muted small" id="who"></p></div>
        </header>
        <section data-pane="home">
          <section id="todo-wrap" class="ja-block" hidden><h2>Finish your booking</h2><div id="todo"></div></section>
          <div id="home"></div>
          <section id="next-wrap" class="ja-block" hidden><h2 id="next-title">Next term</h2><div id="next"></div></section>
          <section id="requests-wrap" class="ja-block" hidden><h2>Applications, trials and waitlist</h2><div id="requests"></div></section>
        </section>
        <section data-pane="sessions" hidden><div id="players"></div></section>
        <section data-pane="term" hidden><div id="term-info"></div></section>
        <section data-pane="cancel" hidden><div id="cancel-help"></div></section>
        <section data-pane="videos" hidden><div id="videos"></div></section>
        <section data-pane="app" hidden><div id="app-info"></div></section>
      </main>
    </div>
    <JfpFooter />
  </div>
</BaseLayout>

<script>
  import '../scripts/jfp-account.js'
</script>
