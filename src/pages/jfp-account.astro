---
import BaseLayout from '../layouts/BaseLayout.astro'
import '../styles/jfp.css'
import '../styles/jfp-account.css'
// The family account (Lee, 13 Oct 2026): the Joner Football look, phones
// first. Everything below the sign in is drawn by src/scripts/jfp-account.js.
---

<BaseLayout title="My account | Joner Football" description="Your Joner Football Performance players, sessions and payments." canonical="https://jonerfootball.com/jfp-account/" noindex noTracking hideChrome hideMobileAppCta>
  <div class="jfp ja" id="jfp-account">
    <section id="signin" class="ja-gate" hidden>
      <div class="ja-gate-media">
        <img src="/images/jfp-account/photos/ntra-field-900x1100.webp" srcset="/images/jfp-account/photos/ntra-field-900x1100.webp 900w, /images/jfp-account/photos/ntra-field-1600x900.webp 1600w" sizes="(min-width: 960px) 55vw, 100vw" alt="" fetchpriority="high">
        <h1>Your <span>JFP</span><br>account</h1>
      </div>
      <div class="ja-gate-panel">
        <div class="ja-logo" style="margin-bottom:26px"><img src="/images/joner-logo-white.png" alt="" width="30" height="30"><span><b>Joner Football</b><small>Performance</small></span></div>
        <div class="j-card">
          <p class="ja-kicker"><i></i>My account</p>
          <h2 class="ja-h2" style="margin:10px 0 18px">Sign in</h2>
          <div id="si-mount"></div>
          <div id="si-foot" style="margin-top:6px"></div>
          <p class="ja-small ja-muted" style="margin-top:22px">Need a hand? <button type="button" class="ja-link" data-contact>Contact us</button></p>
        </div>
      </div>
    </section>

    <div id="app" class="ja-app" hidden>
      <aside class="ja-side" aria-label="My account">
        <button type="button" class="ja-logo" data-go="home"><img src="/images/joner-logo-white.png" alt="" width="30" height="30"><span><b>Joner Football</b><small>Performance</small></span></button>
        <nav id="ja-nav" aria-label="Sections"></nav>
        <div class="ja-side-foot"><span>Signed in as</span><b id="ja-email"></b><button type="button" class="ja-link ja-small" id="sign-out" style="margin-top:8px">Sign out</button></div>
      </aside>
      <header class="ja-bar">
        <button type="button" class="ja-logo" data-go="home"><img src="/images/joner-logo-white.png" alt="" width="30" height="30"><span><b>Joner Football</b><small>Performance</small></span></button>
        <button type="button" class="ja-me" id="ja-me" aria-label="Account and all sections">J</button>
      </header>
      <main class="ja-main" id="view" tabindex="-1">
        <div id="banner"></div>
        <section class="ja-pane" data-pane="home"></section>
        <section class="ja-pane" data-pane="sessions" hidden></section>
        <section class="ja-pane" data-pane="fees" hidden></section>
        <section class="ja-pane" data-pane="info" hidden></section>
        <section class="ja-pane" data-pane="cancel" hidden></section>
        <section class="ja-pane" data-pane="keep" hidden></section>
        <section class="ja-pane" data-pane="term" hidden></section>
        <section class="ja-pane" data-pane="holidays" hidden></section>
        <section class="ja-pane" data-pane="videos" hidden></section>
        <section class="ja-pane" data-pane="app" hidden></section>
        <section class="ja-pane" data-pane="contact" hidden></section>
      </main>
      <nav class="ja-tabs" id="ja-tabs" aria-label="Sections"></nav>
    </div>
  </div>
</BaseLayout>

<script>
  import '../scripts/jfp-account.js'
</script>
