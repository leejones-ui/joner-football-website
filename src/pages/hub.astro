---
import BaseLayout from '../layouts/BaseLayout.astro'
import HubContent from '../components/HubContent.astro'
---

<BaseLayout
  title="Joner Football Hub | Free Training, Technique Test, Camps & App"
  description="The free Joner Football Hub. Enter your name and email to access free Joner Football blogs, challenges, coach resources and app links."
>
  <main class="hub-gate-page">
    <section class="hub-gate" id="hub-gate">
      <div class="hub-gate__media" aria-hidden="true">
        <img src="/images/hub-hero-desktop.jpg" alt="" loading="eager" />
      </div>
      <div class="hub-gate__scrim" aria-hidden="true"></div>
      <div class="hub-gate__inner">
        <div class="hub-gate__copy">
          <p class="hub-gate__eyebrow">Joner Football Hub</p>
          <h1>Get free access to the Hub.</h1>
          <p>Blogs, challenges, coach resources, giveaways and weekly Joner Football ideas. Pop your details in once and you are in.</p>
        </div>
        <form class="hub-gate__form" id="hub-access-form" data-brevo-custom data-list-id="2" novalidate>
          <h2>Enter The Hub</h2>
          <label>
            <span>Name</span>
            <input type="text" name="firstName" autocomplete="given-name" placeholder="Your name" required />
          </label>
          <label>
            <span>Email</span>
            <input type="email" name="email" autocomplete="email" placeholder="you@email.com" required />
          </label>
          <label class="hub-gate__consent">
            <input type="checkbox" name="marketingConsent" required />
            <span>I agree to receive Joner Football emails, including free resources, training ideas, app updates and promotional emails. I understand I can unsubscribe anytime.</span>
          </label>
          <button type="submit">Enter Free Hub</button>
          <p class="hub-gate__message" id="hub-access-message" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <div id="hub-content" hidden>
      <HubContent />
    </div>
  </main>
</BaseLayout>

<script is:inline>
  (function () {
    var STORAGE_KEY = 'jonerHubAccess';
    var gate = document.getElementById('hub-gate');
    var content = document.getElementById('hub-content');
    var form = document.getElementById('hub-access-form');
    var message = document.getElementById('hub-access-message');

    function hasAccess() {
      try { return window.localStorage.getItem(STORAGE_KEY) === 'granted'; }
      catch (e) { return false; }
    }

    function showHub() {
      if (gate) gate.hidden = true;
      if (content) content.hidden = false;
      try { window.localStorage.setItem(STORAGE_KEY, 'granted'); } catch (e) {}
    }

    if (hasAccess()) showHub();
    if (!form) return;

    var emailInput = form.querySelector('input[name="email"]');
    if (window.JonerEmailGuard && emailInput) window.JonerEmailGuard.protectEmailInput(emailInput);

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      var button = form.querySelector('button[type="submit"]');
      var nameInput = form.querySelector('input[name="firstName"]');
      var consentInput = form.querySelector('input[name="marketingConsent"]');
      var name = String(nameInput && nameInput.value || '').trim();
      var email = String(emailInput && emailInput.value || '').trim();
      var validation = window.JonerEmailGuard ? window.JonerEmailGuard.validateEmail(email) : { valid: /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email), email: email.toLowerCase(), message: 'Enter a valid email address.' };

      if (!name) {
        if (message) message.textContent = 'Enter your name first.';
        if (nameInput) nameInput.focus();
        return;
      }
      if (window.JonerEmailGuard && emailInput) window.JonerEmailGuard.setFeedback(emailInput, validation);
      if (!validation.valid) {
        if (message) message.textContent = validation.message || 'Enter a valid email address.';
        if (emailInput && emailInput.reportValidity) emailInput.reportValidity();
        return;
      }
      if (!consentInput || !consentInput.checked) {
        if (message) message.textContent = 'Tick the email opt-in box to access the free Hub.';
        if (consentInput) consentInput.focus();
        return;
      }

      if (button) {
        button.disabled = true;
        button.textContent = 'Checking...';
      }
      if (message) message.textContent = '';

      fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: validation.email, firstName: name, listId: 2, source: 'hub-gate-email-consent', marketingConsent: true })
      })
      .then(function (response) { return response.json().then(function (data) { return { ok: response.ok, data: data }; }); })
      .then(function (result) {
        if (!result.ok || !result.data || !result.data.success) throw new Error((result.data && result.data.error) || 'That did not go through. Try again.');
        showHub();
      })
      .catch(function (error) {
        if (message) message.textContent = error.message || 'That did not go through. Try again.';
        if (button) {
          button.disabled = false;
          button.textContent = 'Enter Free Hub';
        }
      });
    });
  })();
</script>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Kanit:ital,wght@1,600;1,900&display=swap');
  .hub-gate-page { background: #000; color: #fff; }
  .hub-gate[hidden], #hub-content[hidden] { display: none; }
  .hub-gate { min-height: calc(100vh - 80px); position: relative; display: flex; align-items: center; overflow: hidden; background: #000; }
  .hub-gate__media, .hub-gate__scrim { position: absolute; inset: 0; }
  .hub-gate__media img { width: 100%; height: 100%; object-fit: cover; object-position: 60% 22%; opacity: .84; }
  .hub-gate__scrim { background: linear-gradient(90deg, rgba(0,0,0,.92) 0%, rgba(0,0,0,.76) 50%, rgba(0,0,0,.35) 100%); }
  .hub-gate__inner { position: relative; z-index: 1; width: min(1120px, calc(100% - 40px)); margin: 0 auto; padding: 80px 0; display: grid; grid-template-columns: 1.1fr .9fr; gap: 44px; align-items: center; }
  .hub-gate__eyebrow { font-family: 'Kanit', 'Oswald', sans-serif; font-style: italic; color: #E30613; text-transform: uppercase; letter-spacing: .2em; font-size: .82rem; }
  .hub-gate__copy h1 { font-family: 'Kanit', 'Oswald', sans-serif; font-style: italic; text-transform: uppercase; font-size: clamp(3.3rem, 7.8vw, 7rem); line-height: .86; margin: 14px 0 20px; max-width: 720px; }
  .hub-gate__copy p:not(.hub-gate__eyebrow) { color: rgba(255,255,255,.82); font-size: 1.15rem; line-height: 1.6; max-width: 560px; }
  .hub-gate__form { border: 1px solid rgba(255,255,255,.18); background: rgba(0,0,0,.78); backdrop-filter: blur(10px); padding: clamp(26px, 4vw, 42px); box-shadow: 0 24px 80px rgba(0,0,0,.45); }
  .hub-gate__form h2 { font-family: 'Kanit', 'Oswald', sans-serif; font-style: italic; text-transform: uppercase; font-size: 2.4rem; margin: 0 0 22px; }
  .hub-gate__form label { display: block; margin-bottom: 16px; }
  .hub-gate__form span { display: block; font-family: 'Kanit', 'Oswald', sans-serif; font-style: italic; text-transform: uppercase; color: rgba(255,255,255,.78); font-size: .82rem; letter-spacing: .08em; margin-bottom: 8px; }
  .hub-gate__form input { width: 100%; min-height: 52px; background: #080808; border: 1px solid rgba(255,255,255,.18); color: #fff; padding: 14px 16px; font-size: 1rem; outline: none; }
  .hub-gate__form input:focus { border-color: #E30613; }
  .hub-gate__consent { display: grid !important; grid-template-columns: 22px 1fr; gap: 12px; align-items: start; margin: 12px 0 14px !important; }
  .hub-gate__consent input { width: 22px; min-height: 22px; height: 22px; margin-top: 2px; accent-color: #E30613; }
  .hub-gate__consent span { display: block; font-family: system-ui, sans-serif; font-style: normal; text-transform: none; letter-spacing: 0; font-size: .88rem; line-height: 1.45; color: rgba(255,255,255,.78); margin: 0; }
  .hub-gate__note { color: rgba(255,255,255,.62); font-size: .9rem; line-height: 1.45; margin: 6px 0 20px; }
  .hub-gate__form button { width: 100%; min-height: 56px; border: 0; background: #E30613; color: #fff; font-family: 'Kanit', 'Oswald', sans-serif; font-style: italic; text-transform: uppercase; font-weight: 900; letter-spacing: .06em; cursor: pointer; }
  .hub-gate__form button:disabled { opacity: .65; cursor: not-allowed; }
  .hub-gate__message { min-height: 20px; color: #fbbf24; font-size: .9rem; margin: 14px 0 0; }
  @media (max-width: 860px) {
    .hub-gate { min-height: 100vh; }
    .hub-gate__inner { grid-template-columns: 1fr; padding: 48px 0; }
    .hub-gate__copy h1 { font-size: clamp(3rem, 14vw, 5.2rem); }
  }
</style>
