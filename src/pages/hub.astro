---
import BaseLayout from '../layouts/BaseLayout.astro'
import HubContent from '../components/HubContent.astro'
import SanityPageExtras from '../components/sanity/SanityPageExtras.astro'

import SanityPageRenderer from '../components/sanity/SanityPageRenderer.astro'
import { fetchSanityPage } from '../lib/sanityPages'
import { getSanityImageUrl, getSanityText, shouldReplaceSanityPage } from '../lib/sanityPageUtils'

const sanityPage = await fetchSanityPage('hub')
const pageTitle = sanityPage?.seo?.title || 'Joner Football Hub | Free Training, Technique Test, Camps & App'
const pageDescription = sanityPage?.seo?.description || 'The free Joner Football Hub. Enter your name and email to access free Joner Football blogs, challenges, coach resources and app links.'
const heroEyebrow = getSanityText(sanityPage?.heroEyebrow, 'Joner Football Hub')
const heroHeadline = getSanityText(sanityPage?.heroHeadline, 'Joner Football Hub')
const heroSubheadline = getSanityText(sanityPage?.heroSubheadline, 'Free blogs, challenges, coach resources, giveaways and weekly Joner Football ideas. Enter once and you are in.')
const heroImage = getSanityImageUrl(sanityPage?.heroImage, '/images/hub-hero-desktop.jpg')
---

{shouldReplaceSanityPage(sanityPage) ? (
  <SanityPageRenderer page={sanityPage} />
) : (
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={sanityPage?.seo?.canonicalUrl}
  ogImage={sanityPage?.seo?.imageUrl || heroImage || undefined}
  noindex={Boolean(sanityPage?.seo?.noIndex)}
>
  <main class="hub-gate-page">
    <section class="hub-gate" id="hub-gate">
      <div class="hub-gate__media" aria-hidden="true">
        <img src={heroImage} alt="" loading="eager" />
      </div>
      <div class="hub-gate__scrim" aria-hidden="true"></div>
      <div class="hub-gate__inner">
        <div class="hub-gate__copy">
          <p class="hub-gate__eyebrow">{heroEyebrow}</p>
          <h1>{heroHeadline}</h1>
          <span class="hub-gate__rule" aria-hidden="true"></span>
          <p>{heroSubheadline}</p>
        </div>
        <form class="hub-gate__form" id="hub-access-form" data-brevo-custom data-list-id="2" novalidate>
          <h2>Enter The Hub</h2>
          <label>
            <span>Name</span>
            <input type="text" name="firstName" autocomplete="given-name" placeholder="Your name" required />
          </label>
          <label>
            <span>Email</span>
            <input type="email" name="email" autocomplete="email" placeholder="you@email.com" required />
          </label>
          <label class="hub-gate__consent">
            <input type="checkbox" name="marketingConsent" required />
            <span>I agree to receive Joner Football emails, including free resources, training ideas, app updates and promotional emails. I understand I can unsubscribe anytime.</span>
          </label>
          <button type="submit" class="btn-red">Enter Free Hub</button>
          <p class="hub-gate__message" id="hub-access-message" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <div id="hub-content" hidden>
      <HubContent />
    </div>
  </main>

  <SanityPageExtras page={sanityPage} />
</BaseLayout>

<script is:inline>
  (function () {
    var STORAGE_KEY = 'jonerHubAccess';
    var gate = document.getElementById('hub-gate');
    var content = document.getElementById('hub-content');
    var form = document.getElementById('hub-access-form');
    var message = document.getElementById('hub-access-message');

    function getSafeNextPath() {
      var params = new URLSearchParams(window.location.search);
      var next = params.get('next') || '';
      if (!next || next.charAt(0) !== '/' || next.indexOf('//') === 0) return '';
      if (next.indexOf('/hub') === 0) return '';
      return next;
    }

    function goNextIfNeeded() {
      var next = getSafeNextPath();
      if (next) window.location.assign(next);
      return Boolean(next);
    }

    function hasAccess() {
      try { return window.localStorage.getItem(STORAGE_KEY) === 'granted'; }
      catch (e) { return false; }
    }

    function showHub() {
      if (gate) gate.hidden = true;
      if (content) content.hidden = false;
      try { window.localStorage.setItem(STORAGE_KEY, 'granted'); } catch (e) {}
    }

    if (hasAccess()) {
      showHub();
      goNextIfNeeded();
    }
    if (!form) return;

    var emailInput = form.querySelector('input[name="email"]');
    if (window.JonerEmailGuard && emailInput) window.JonerEmailGuard.protectEmailInput(emailInput);

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      var button = form.querySelector('button[type="submit"]');
      var nameInput = form.querySelector('input[name="firstName"]');
      var consentInput = form.querySelector('input[name="marketingConsent"]');
      var name = String(nameInput && nameInput.value || '').trim();
      var email = String(emailInput && emailInput.value || '').trim();
      var validation = window.JonerEmailGuard ? window.JonerEmailGuard.validateEmail(email) : { valid: /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email), email: email.toLowerCase(), message: 'Enter a valid email address.' };

      if (!name) {
        if (message) message.textContent = 'Enter your name first.';
        if (nameInput) nameInput.focus();
        return;
      }
      if (window.JonerEmailGuard && emailInput) window.JonerEmailGuard.setFeedback(emailInput, validation);
      if (!validation.valid) {
        if (message) message.textContent = validation.message || 'Enter a valid email address.';
        if (emailInput && emailInput.reportValidity) emailInput.reportValidity();
        return;
      }
      if (!consentInput || !consentInput.checked) {
        if (message) message.textContent = 'Tick the email opt-in box to access the free Hub.';
        if (consentInput) consentInput.focus();
        return;
      }

      if (button) {
        button.disabled = true;
        button.textContent = 'Checking...';
      }
      if (message) message.textContent = '';

      (window.JonerRecaptcha ? window.JonerRecaptcha.getToken('hub_gate') : Promise.resolve(''))
      .then(function (recaptchaToken) {
        return fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: validation.email, firstName: name, listId: 2, source: 'hub-gate-email-consent', marketingConsent: true, recaptchaToken: recaptchaToken })
        });
      })
      .then(function (response) { return response.json().then(function (data) { return { ok: response.ok, data: data }; }); })
      .then(function (result) {
        if (!result.ok || !result.data || !result.data.success) throw new Error((result.data && result.data.error) || 'That did not go through. Try again.');
        showHub();
        goNextIfNeeded();
      })
      .catch(function (error) {
        if (message) message.textContent = error.message || 'That did not go through. Try again.';
        if (button) {
          button.disabled = false;
          button.textContent = 'Enter Free Hub';
        }
      });
    });
  })();
</script>

<style is:global>
  /* Redesign (Oct 2026): newer site style (game analysis, reviews). Layout and
     styling only: the form fields, names, list id, endpoint, reCAPTCHA and
     success behaviour are unchanged. */
  .hub-gate-page { --jf-red: #E8000D; --font-display: var(--font-heading, Anton, Impact, sans-serif); background: #000; color: #fff; }
  .hub-gate[hidden], #hub-content[hidden] { display: none; }
  .hub-gate { min-height: calc(100vh - 80px); position: relative; display: flex; align-items: center; overflow: hidden; background: #000; }
  .hub-gate__media, .hub-gate__scrim { position: absolute; inset: 0; }
  .hub-gate__media img { width: 100%; height: 100%; object-fit: cover; object-position: 60% 22%; }
  .hub-gate__scrim { background: linear-gradient(180deg, rgba(0,0,0,.2) 0%, rgba(0,0,0,.15) 45%, rgba(0,0,0,.85) 100%), linear-gradient(90deg, rgba(0,0,0,.85) 0%, rgba(0,0,0,.55) 50%, rgba(0,0,0,.2) 100%); }
  .hub-gate__inner { position: relative; z-index: 1; width: min(1120px, calc(100% - 32px)); margin: 0 auto; padding: 88px 0; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: 48px; align-items: center; }
  .hub-gate__eyebrow { margin: 0; font-family: var(--font-display); font-style: italic; font-weight: 600; font-size: 13px; letter-spacing: .2em; text-transform: uppercase; color: #fff; }
  .hub-gate__copy h1 { font-family: var(--font-display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: clamp(2.8rem, 8vw, 6.2rem); line-height: .92; margin: 14px 0 0; max-width: 9ch; }
  .hub-gate__rule { display: block; width: 56px; height: 4px; background: var(--jf-red); margin: 24px 0 0; }
  .hub-gate__copy p:not(.hub-gate__eyebrow) { margin: 22px 0 0; color: rgba(255,255,255,.88); font-size: 18px; line-height: 1.55; max-width: 520px; }
  .hub-gate__form { display: grid; gap: 16px; border: 1px solid rgba(255,255,255,.12); background: rgba(11,11,11,.92); padding: clamp(20px, 3vw, 32px); }
  .hub-gate__form h2 { font-family: var(--font-display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: clamp(1.9rem, 3.4vw, 2.6rem); line-height: 1; margin: 0 0 4px; }
  .hub-gate__form label { display: grid; gap: 7px; margin: 0; }
  .hub-gate__form label > span { font-family: var(--font-body, Inter, system-ui, sans-serif); font-size: 14px; font-weight: 600; color: rgba(255,255,255,.9); }
  .hub-gate__form input[type="text"], .hub-gate__form input[type="email"] { width: 100%; min-height: 50px; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.18); color: #fff; padding: 13px 14px; font: inherit; font-size: 16px; border-radius: 0; outline: none; }
  .hub-gate__form input::placeholder { color: rgba(255,255,255,.45); }
  .hub-gate__form input[type="text"]:focus, .hub-gate__form input[type="email"]:focus { border-color: #fff; }
  .hub-gate__consent { display: grid !important; grid-template-columns: 20px 1fr; gap: 12px; align-items: start; }
  .hub-gate__consent input { width: 20px; height: 20px; margin: 2px 0 0; accent-color: var(--jf-red); }
  .hub-gate__consent span { font-weight: 400 !important; font-size: 14px !important; line-height: 1.5; color: rgba(255,255,255,.75) !important; }
  .hub-gate__form button { width: 100%; min-height: 54px; cursor: pointer; font-size: 16px; }
  .hub-gate__form button:disabled { opacity: .65; cursor: not-allowed; }
  .hub-gate__message { min-height: 20px; color: #fbbf24; font-size: 15px; margin: 0; }
  .hub-gate__message:empty { min-height: 0; }
  @media (max-width: 860px) {
    .hub-gate { min-height: calc(100svh - 4rem); align-items: stretch; }
    .hub-gate__media img { object-position: 58% 18%; }
    .hub-gate__scrim { background: linear-gradient(180deg, rgba(0,0,0,.35) 0%, rgba(0,0,0,.55) 40%, rgba(0,0,0,.96) 70%); }
    .hub-gate__inner { grid-template-columns: minmax(0, 1fr); gap: 26px; padding: 140px 0 32px; align-content: end; align-items: end; }
    .hub-gate__copy p:not(.hub-gate__eyebrow) { font-size: 16px; }
    .hub-gate__form { padding: 18px; }
  }
</style>
)}
