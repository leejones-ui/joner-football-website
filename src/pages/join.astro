---
import BaseLayout from '../layouts/BaseLayout.astro'

const plans = [
  {
    name: 'Monthly',
    subtitle: 'Perfect for trying us out',
    price: '$23.99',
    period: '/month',
    trial: '7-day FREE trial',
    cta: 'Start Free Trial',
    href: 'https://app.jonerfootball.com/checkout/new?o=183083',
    image: '/images/join-live/monthly.webp',
    alt: 'Monthly Plan',
    featured: false,
    features: [
      ['1,500+ Training Videos', true],
      ['New Content Weekly', true],
      ['Daily Challenges', true],
      ['Community Access', true],
      ['Live Sessions', true],
      ['100 Day Transformation Program', false],
      ['Age Specific Training Content', true],
      ['DM Lee Directly', false],
      ['Team Training', false],
      ['Coaches Section', false],
    ],
  },
  {
    name: 'Annual',
    subtitle: 'Save $83/year',
    price: '$204.99',
    period: '/year',
    trial: '7-day FREE trial',
    cta: 'Start Free Trial',
    href: 'https://app.jonerfootball.com/checkout/new?o=183092',
    image: '/images/join-live/annual.webp',
    alt: 'Annual Plan',
    badge: '⭐ MOST POPULAR',
    featured: true,
    features: [
      ['1,500+ Training Videos', true],
      ['New Content Weekly', true],
      ['Daily Challenges', true],
      ['Community Access', true],
      ['Live Sessions', true],
      ['DM Lee Directly', true],
      ['Team Training Videos', true],
      ['100 Day Transformation Program', true],
      ['Coaches Section', false],
    ],
  },
  {
    name: 'For The Coaches',
    subtitle: 'Everything + Coaches Content',
    price: '$319.99',
    period: '/year',
    trial: 'Full Access',
    cta: 'Join Now',
    href: 'https://app.jonerfootball.com/checkout/new?o=202578',
    image: '/images/join-live/coaches.webp',
    alt: 'For The Coaches',
    featured: false,
    features: [
      ['Everything in Annual', true],
      ['DM Lee Directly', true],
      ['Coaches-Only Section', true],
      ['PDF Season Plans', true],
      ['Advanced Team Training', true],
      ['Pro Player Sessions', true],
      ['Workshop Discounts', true],
      ['Coaching Templates', true],
    ],
  },
]

const teamFeatures = [
  'Custom onboarding with Lee',
  'Multi-seat Licences (Player/Coach)',
  'Transferable seats',
  'Bulk player access',
  'Dedicated community page',
  'Single-invoice for whole team',
  'Flexible billing: Monthly/Yearly',
  'Priority support',
  'Usage analytics',
  'Dedicated account rep',
  'Bespoke training plans',
]
---

<BaseLayout
  title="Joner Football App Pricing - Joner Football"
  description="Join 50,000 players, coaches and parents already using the Joner Football App."
  canonical="https://jonerfootball.com/join/"
  ogImage="https://jonerfootball.com/images/join-live/annual.webp"
>
  <main class="join-live-page">
    <section class="join-hero">
      <div class="join-wrap join-hero__inner">
        <img class="join-logo" src="/images/join-live/jf-app-logo.png" alt="Joner Football App" loading="eager" />
        <h1>Join 50,000 Players, Coaches &amp; Parents</h1>
        <p>Already using the Joner Football App. Invest in your game today.</p>
        <span class="join-location">Detecting location...</span>
      </div>
    </section>

    <section class="join-pricing" aria-label="Joner Football App pricing">
      <div class="join-wrap">
        <div class="join-cards">
          {plans.map((plan) => (
            <article class:list={['join-card', plan.featured && 'join-card--featured']}>
              {plan.badge && <div class="join-badge">{plan.badge}</div>}
              <img class="join-card__image" src={plan.image} alt={plan.alt} loading="lazy" decoding="async" />
              <div class="join-card__body">
                <h2>{plan.name}</h2>
                <p class="join-card__subtitle">{plan.subtitle}</p>
                <div class="join-price"><span>{plan.price}</span> <small>{plan.period}</small></div>
                <p class="join-trial">{plan.trial}</p>
                <a class="join-cta" href={plan.href} target="_blank" rel="noopener noreferrer">{plan.cta}</a>
                <ul>
                  {plan.features.map(([feature, included]) => (
                    <li class:list={[included ? 'is-included' : 'is-excluded']}>
                      <span>{included ? '✓' : '✗'}</span>
                      {feature}
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="join-teams">
      <div class="join-wrap">
        <article class="join-team-card">
          <div class="join-team-card__image-wrap">
            <img src="/images/join-live/teams.webp" alt="Team Subscriptions" loading="lazy" decoding="async" />
            <span>TEAMS &amp; CLUBS</span>
          </div>
          <div class="join-team-card__body">
            <h2>Club Subscriptions</h2>
            <p class="join-card__subtitle">For teams, academies &amp; clubs</p>
            <div class="join-price"><span>Custom Pricing</span></div>
            <p class="join-trial">Bulk discounts</p>
            <a class="join-cta" href="https://jonerfootball.com/clubpricing/">Contact Sales</a>
            <ul>
              {teamFeatures.map((feature) => (
                <li class="is-included"><span>✓</span>{feature}</li>
              ))}
            </ul>
          </div>
        </article>
      </div>
    </section>

    <section class="join-compare">
      <div class="join-wrap">
        <p>📱 Rotate your phone to landscape to see the full comparison table</p>
      </div>
    </section>
  </main>

  <style>
    .join-live-page { background: #050505; color: #fff; font-family: 'DM Sans', system-ui, sans-serif; }
    .join-wrap { width: min(1180px, calc(100% - 32px)); margin: 0 auto; }
    .join-hero { position: relative; overflow: hidden; padding: clamp(7rem, 10vw, 10rem) 0 clamp(3rem, 5vw, 4rem); text-align: center; background: radial-gradient(circle at 50% 0%, rgba(227,6,19,.28), transparent 36%), #050505; }
    .join-hero::before { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(255,255,255,.04), transparent 45%); pointer-events: none; }
    .join-hero__inner { position: relative; z-index: 1; display: grid; justify-items: center; }
    .join-logo { width: min(360px, 72vw); height: auto; margin-bottom: 2rem; object-fit: contain; }
    .join-hero h1 { max-width: 920px; margin: 0; font-family: 'Anton', Impact, sans-serif; font-size: clamp(3rem, 8vw, 6.8rem); line-height: .92; letter-spacing: .03em; text-transform: uppercase; }
    .join-hero p { max-width: 660px; margin: 1.25rem 0 1rem; color: rgba(255,255,255,.78); font-size: clamp(1.05rem, 2vw, 1.35rem); font-weight: 700; }
    .join-location { color: rgba(255,255,255,.5); font-size: .95rem; }
    .join-pricing { padding: clamp(2.5rem, 5vw, 4.5rem) 0; background: #0a0a0a; }
    .join-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.35rem; align-items: stretch; }
    .join-card, .join-team-card { position: relative; overflow: hidden; border: 1px solid rgba(255,255,255,.16); border-radius: 1.6rem; background: #fff; color: #050505; box-shadow: 0 26px 80px rgba(0,0,0,.32); }
    .join-card--featured { border-color: rgba(227,6,19,.9); box-shadow: 0 30px 90px rgba(227,6,19,.22); transform: translateY(-.65rem); }
    .join-badge { position: absolute; z-index: 2; left: 1.15rem; top: 1.15rem; border-radius: 999px; background: #E30613; color: #fff; padding: .55rem .85rem; font-family: 'Anton', Impact, sans-serif; font-size: .82rem; letter-spacing: .08em; }
    .join-card__image { display: block; width: 100%; height: 245px; object-fit: cover; }
    .join-card__body, .join-team-card__body { padding: 1.45rem; }
    .join-card h2, .join-team-card h2 { margin: 0; font-family: 'Anton', Impact, sans-serif; font-size: clamp(2.15rem, 4vw, 3.1rem); line-height: .95; letter-spacing: .03em; text-transform: uppercase; }
    .join-card__subtitle { margin: .55rem 0 1.15rem; color: #555; font-weight: 800; }
    .join-price { display: flex; align-items: baseline; gap: .35rem; min-height: 4.2rem; margin-bottom: .25rem; font-family: 'Anton', Impact, sans-serif; }
    .join-price span { font-size: clamp(2.5rem, 5vw, 4rem); line-height: .95; letter-spacing: .02em; }
    .join-price small { color: #666; font-size: 1.1rem; font-family: 'DM Sans', system-ui, sans-serif; font-weight: 800; }
    .join-trial { margin: 0 0 1rem; color: #E30613; font-weight: 900; text-transform: uppercase; letter-spacing: .04em; }
    .join-cta { display: flex; align-items: center; justify-content: center; min-height: 3.15rem; margin-bottom: 1.15rem; border-radius: 999px; background: #E30613; color: #fff; font-family: 'Anton', Impact, sans-serif; text-transform: uppercase; letter-spacing: .1em; text-decoration: none; box-shadow: 0 18px 38px rgba(227,6,19,.28); transition: transform .16s ease, background .16s ease; }
    .join-cta:hover { transform: translateY(-2px); background: #b80510; }
    .join-card ul, .join-team-card ul { display: grid; gap: .72rem; margin: 0; padding: 0; list-style: none; }
    .join-card li, .join-team-card li { display: grid; grid-template-columns: 1.4rem 1fr; gap: .55rem; align-items: start; color: #151515; font-weight: 750; line-height: 1.2; }
    .join-card li span, .join-team-card li span { display: inline-flex; align-items: center; justify-content: center; width: 1.35rem; height: 1.35rem; border-radius: 50%; font-size: .85rem; font-weight: 900; }
    .join-card li.is-included span, .join-team-card li.is-included span { background: #E30613; color: #fff; }
    .join-card li.is-excluded { color: #aaa; }
    .join-card li.is-excluded span { background: #f1f1f1; color: #aaa; }
    .join-teams { padding: 0 0 clamp(3rem, 6vw, 5rem); background: #0a0a0a; }
    .join-team-card { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); background: #fff; }
    .join-team-card__image-wrap { position: relative; min-height: 520px; }
    .join-team-card__image-wrap img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .join-team-card__image-wrap span { position: absolute; left: 1.4rem; top: 1.4rem; border-radius: 999px; background: #E30613; color: #fff; padding: .65rem 1rem; font-family: 'Anton', Impact, sans-serif; letter-spacing: .12em; }
    .join-compare { padding: 1.5rem 0 5rem; background: #0a0a0a; color: rgba(255,255,255,.74); text-align: center; font-weight: 800; }
    @media (max-width: 980px) { .join-cards { grid-template-columns: 1fr; } .join-card--featured { transform: none; } .join-team-card { grid-template-columns: 1fr; } .join-team-card__image-wrap { min-height: 340px; } }
    @media (max-width: 640px) { .join-wrap { width: min(100% - 24px, 1180px); } .join-card__image { height: 220px; } .join-card__body, .join-team-card__body { padding: 1.15rem; } .join-price span { font-size: 2.7rem; } }
  </style>
</BaseLayout>
