---
import BaseLayout from '../layouts/BaseLayout.astro'
import AppPlanFinder from '../components/AppPlanFinder.astro'
import '../styles/app-join.css'

// LIVE_JOIN_PAGE: Joner Football App join/pricing page.
// Decision page. Defaults to Annual billing showing the per-month-billed-annually price (Higgsfield style).
// Prices localise client-side from the app checkout values. Unknown countries default to USD.

const plans = [
  {
    id: 'starter', name: 'Starter', badge: '', tag: 'Simple solo training',
    monthlyPrice: '$14.99', monthlyNum: '14.99',
    annualMonthlyPrice: '$10.83', annualMonthlyNum: '10.83',
    annualSave: 'Save $49.89 a year',
    trial: '7-day free trial', cta: 'Start 7-day free trial',
    monthlyUrl: 'https://app.jonerfootball.com/checkout/new?o=183083',
    annualUrl: 'https://app.jonerfootball.com/checkout/new?o=230697',
    style: 'plain',
    features: [
      'Solo follow-along training',
      'Beginner ball mastery',
      'Basic drills and how-to videos',
      'Prehab, activation and warm-ups',
      'Challenges, tips and tutorials',
    ],
  },
  {
    id: 'plus', name: 'Plus', badge: '', tag: 'Structured training programmes',
    monthlyPrice: '$19.99', monthlyNum: '19.99',
    annualMonthlyPrice: '$15.00', annualMonthlyNum: '15.00',
    annualSave: 'Save $59.89 a year',
    trial: '7-day free trial', cta: 'Start 7-day free trial',
    monthlyUrl: 'https://app.jonerfootball.com/checkout/new?o=230699',
    annualUrl: 'https://app.jonerfootball.com/checkout/new?o=183092',
    style: 'plain',
    features: [
      { text: 'Everything in Starter', lead: true },
      '100 Day Transformation Program',
      'Advanced drills',
      'Cognitive and awareness drills',
      'Age-specific training',
      'DM Lee directly',
      'Livestream training sessions',
      'Mindset, HQ and 1v1 training',
    ],
  },
  {
    id: 'max', name: 'Max', badge: 'Most Popular', tag: 'The full App, plus Coaches Only',
    monthlyPrice: '$39.99', monthlyNum: '39.99',
    annualMonthlyPrice: '$20.83', annualMonthlyNum: '20.83',
    annualSave: 'Save $229.89 a year',
    trial: 'Paid access from day one', cta: 'Get Max Plan',
    monthlyUrl: 'https://app.jonerfootball.com/checkout/new?o=230698',
    annualUrl: 'https://app.jonerfootball.com/checkout/new?o=202578',
    style: 'featured',
    features: [
      { text: 'Everything in Plus', lead: true },
      'Full access to the entire app',
      { text: 'Includes Coaches Only', coaches: true },
      'Direct coaching access with Lee',
      'Team and position-specific training',
      'Study the game',
      'Pro drills and voice-over training',
      'Session plan videos and PDF plans',
      'Live seminars and session planning',
      'Behind-the-scenes coaching access',
    ],
  },
  {
    id: 'club', name: 'Team / Club', badge: '', tag: 'For teams, clubs and academies',
    priceLabel: 'Your team', trial: 'Plans for clubs of every size', cta: 'See Teams plans',
    url: '/teams/', style: 'club',
    features: [
      { text: 'App access matched to your Teams plan', lead: true },
      'Player and coach logins',
      'Team or club section in the app',
      'Club onboarding',
      'Custom pricing for your size',
      'Built for clubs, academies and schools',
    ],
  },
]

const compareCols = ['Starter', 'Plus', 'Max', 'Teams']
const compareGroups = [
  {
    title: 'Train on your own',
    rows: [
      ['Solo follow-along training', [true, true, true, true]],
      ['Beginner ball mastery', [true, true, true, true]],
      ['Basic drills and how-to videos', [true, true, true, true]],
      ['Prehab, activation and warm-ups', [true, true, true, true]],
      ['Challenges, tips and tutorials', [true, true, true, true]],
    ],
  },
  {
    title: 'Serious player development',
    rows: [
      ['100 Day Transformation Program', [false, true, true, true]],
      ['Advanced drills', [false, true, true, true]],
      ['Cognitive and awareness drills', [false, true, true, true]],
      ['Age-specific training', [false, true, true, true]],
      ['1v1, mindset and HQ sessions', [false, true, true, true]],
      ['Livestream training sessions', [false, true, true, true]],
      ['DM Lee directly', [false, true, true, true]],
    ],
  },
  {
    title: 'Full app and Coaches Only',
    rows: [
      ['Full access to the entire app', [false, false, true, true]],
      ['Coaches Only section', [false, false, true, true]],
      ['Direct coaching access with Lee', [false, false, true, true]],
      ['Team and position-specific training', [false, false, true, true]],
      ['Study the game and pro drills', [false, false, true, true]],
      ['Voice-over training drills', [false, false, true, true]],
      ['Session plan videos and PDF plans', [false, false, true, true]],
      ['Live seminars and session planning', [false, false, true, true]],
    ],
  },
  {
    title: 'Teams and clubs',
    rows: [
      ['Player and coach logins for your group', [false, false, false, true]],
      ['Team or club section in the app', [false, false, false, true]],
      ['Club onboarding with Joner Football', [false, false, false, true]],
      ['Custom pricing for your size', [false, false, false, true]],
    ],
  },
]

const faqs = [
  ['Which plan should I choose?', 'Starter is for simple solo training. Plus is the best pathway if you are serious about improving. Choose Max for the full App and Coaches Only resources. Running a team or club? See the Teams plans.'],
  ['Is there a free trial?', 'Starter and Plus come with a 7-day free trial. Max skips the trial and gives you the full app from day one, and you can still cancel anytime.'],
  ['Can I cancel?', 'Yes. You manage your subscription in the app and can cancel anytime. You keep access until the end of the period you paid for.'],
  ['Is Max only for coaches?', 'No. Max is the full Joner Football App for serious players, parents and coaches. The Coaches Only section is included, it is not the only thing in there.'],
  ['Can parents use the app?', 'Yes. Plenty of parents use it to give their player a clear plan at home instead of guessing.'],
  ['Can teams or clubs join?', 'Yes. The individual App plans above are for one account. Teams has separate Lite, Squad and Pro plans; Organisation capacity and pricing are agreed by quote.'],
]
---

<BaseLayout
  title="Join The Joner Football App | Player, Coach and Team Plans"
  description="Join the Joner Football App for player drills, session plans and coach-led programmes. Choose the level that fits your training and start with a clear plan."
  canonical="https://jonerfootball.com/join/">
  <main id="main-content" class="app-join-page">
    <header class="app-join-hero">
      <img src="/images/join-live/joner-app-logo-header.webp" alt="Joner Football App" width="1280" height="720" loading="eager" decoding="async" />
      <h1>Your next level<br class="join-phone-break" /> <span>starts here.</span></h1>
      <p>Training for players. Guidance for parents. Resources for coaches.</p>
    </header>
    <div class="app-join-container">
      <AppPlanFinder />
      <section id="plans" class="app-join-plans" aria-label="Choose an App plan">
        <div class="app-join-toolbar">
          <div id="billing-switch" class="relative flex w-[320px] max-w-full rounded-full border border-gray-200 bg-white p-1" role="group" aria-label="Billing period">
            <span id="toggle-indicator" class="absolute inset-y-1 left-1 w-[calc(50%-0.25rem)] translate-x-full rounded-full bg-[#252727] transition-transform duration-300 ease-out"></span>
            <button type="button" data-billing="monthly" aria-pressed="false" class="billing-toggle relative z-10 flex-1 rounded-full py-2.5 text-center font-body text-sm font-semibold text-gray-600 transition-colors">Monthly</button>
            <button type="button" data-billing="annual" aria-pressed="true" class="billing-toggle relative z-10 flex-1 rounded-full py-2.5 text-center font-body text-sm font-semibold text-white transition-colors">Annual <span class="app-annual-save">Save</span></button>
          </div>
          <p id="currency-note">Prices shown in USD</p>
        </div>
        <div class="app-plan-grid">
          {plans.map(plan=><article id={plan.id} class:list={['app-plan-card',plan.style==='featured' && 'recommended']}>
            <div class="app-plan-heading"><h2 tabindex="-1">{plan.name}</h2>{plan.badge && <span class="app-plan-badge">{plan.badge}</span>}</div>
            <p class="app-plan-tag">{plan.tag}</p>
            <div class="app-plan-price-block">
              {plan.priceLabel ? <><p class="app-plan-group-price">{plan.priceLabel}</p><p class="app-plan-group-note">Player and coach places to suit.</p></> : <>
                <span class="billing-compare" data-plan={plan.id}>{plan.monthlyPrice}</span>
                <div class="app-plan-price-row"><span class="billing-price" data-plan={plan.id}>{plan.annualMonthlyPrice}</span><span class="billing-period" data-monthly="/month" data-annual="/mo">/mo</span></div>
                <p class="billing-sub" data-plan={plan.id}>billed annually</p>
                <p class="billing-save" data-plan={plan.id}>{plan.annualSave}</p>
              </>}
            </div>
            <p class:list={['app-plan-trial',plan.id==='max' && 'paid']}>{plan.trial}</p>
            {plan.url ? <a href={plan.url} data-ga-event="JoinClubPricingClick" data-plan-target="club" class="join-button outline">{plan.cta}</a> :
              <a href={plan.annualUrl} data-monthly-url={plan.monthlyUrl} data-annual-url={plan.annualUrl} target="_blank" rel="noopener noreferrer" class:list={['plan-cta join-button', plan.id==='max' && 'max-cta']}>{plan.cta}</a>}
            <ul class="app-plan-features">{plan.features.map(feature=>{
              const label=typeof feature==='string'?feature:feature.text
              return <li><span class="app-plan-tick" aria-hidden="true">✓</span><span class:list={[typeof feature==='object' && feature.lead && 'feature-lead',typeof feature==='object' && feature.coaches && 'feature-coaches']}>{label}</span></li>
            })}</ul>
          </article>)}
        </div>
        <div class="app-join-proof"><span>2,000+ training videos</span><span>Filter by age, difficulty, drill type and plan</span><span>New content every week</span><span>Players in 15+ countries</span><strong>50K+ downloads worldwide</strong></div>
      </section>
      <section id="compare" class="app-join-comparison" aria-label="Compare plans">
        <details>
          <summary><span>Compare plans</span><span class="compare-caption">Every feature, side by side</span><span class="compare-icon" aria-hidden="true">+</span></summary>
          <div class="app-compare-scroll" tabindex="0" role="region" aria-label="Plan features comparison, scroll horizontally on small screens">
            <table>
              <thead><tr><th scope="col">What you get</th>{compareCols.map(c=><th scope="col">{c}</th>)}</tr></thead>
              <tbody>{compareGroups.map(group=><>
                <tr class="app-compare-group"><th colspan="5" scope="colgroup">{group.title}</th></tr>
                {group.rows.map(row=><tr><th scope="row">{row[0]}</th>{row[1].map((on,i)=><td>
                  {i===3 && group.title!=='Teams and clubs' ? <a href="/teams/">By Teams plan</a> : on ? <span class="app-compare-yes" aria-label="Included">✓</span> : <span class="app-compare-no" aria-label="Not included">−</span>}
                </td>)}</tr>)}
              </>)}</tbody>
            </table>
          </div>
        </details>
      </section>
      <section class="app-coaches-preview" aria-labelledby="coaches-preview-title">
        <div class="app-coaches-copy"><p class="app-join-eyebrow">Included in Max</p><h2 id="coaches-preview-title">Your next session<br />starts here.</h2><p>See how Lee plans, coaches and develops his players.</p>
          <ul>{['Session plan videos','PDF session plans','Team training','Study the game','Voice-over drills','How Lee coaches the coaches'].map(item=><li><span aria-hidden="true">✓</span>{item}</li>)}</ul>
          <a href="#max" data-ga-event="JoinPlanAnchorClick" data-plan-target="max" class="join-button outline">See Max features <span aria-hidden="true">↗</span></a>
        </div>
        <div class="app-coaches-photo"><img src="/app/uploads/2026/05/soccer-coach-goal-instruction.webp" alt="Lee coaching players on the pitch" loading="lazy" decoding="async" /></div>
      </section>
      <section class="app-join-faq" aria-labelledby="app-faq-title"><div><p class="app-join-eyebrow">A few things to know</p><h2 id="app-faq-title">Before you join.</h2></div><div>{faqs.map(([q,a])=><details data-faq-question={q}><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></section>
      <section id="final-cta" class="app-join-finish"><div><h2>Ready to get started?</h2><p>Choose your plan and get training.</p></div><a href="#plans" data-ga-event="JoinPlanAnchorClick" data-plan-target="plans" class="join-button">See the plans <span aria-hidden="true">↑</span></a></section>
    </div>
  </main>
  <div id="sticky-cta" class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-gray-200 bg-white/95 p-3 opacity-0 shadow-[0_-8px_30px_rgba(0,0,0,0.08)] backdrop-blur transition-all duration-300 md:hidden">
    <div class="flex items-center justify-between gap-3"><div class="leading-tight"><p class="font-body text-sm font-semibold text-[#252727]">Joner Football App</p><p id="sticky-price" class="font-body text-xs text-gray-600">From $10.83/mo billed annually</p></div><a href="#plans" data-ga-event="JoinPlanAnchorClick" data-plan-target="plans" class="join-button">See plans</a></div>
  </div>

  <script>
    const toggles = document.querySelectorAll('.billing-toggle')
    const indicator = document.getElementById('toggle-indicator')
    const prices = document.querySelectorAll('.billing-price')
    const periods = document.querySelectorAll('.billing-period')
    const compares = document.querySelectorAll('.billing-compare')
    const subs = document.querySelectorAll('.billing-sub')
    const saves = document.querySelectorAll('.billing-save')
    const ctas = document.querySelectorAll('.plan-cta')
    let currentMode = 'annual'
    let currentRegion = 'US'

    const regionalPricing = {
      US: {
        code: 'USD',
        symbol: '$',
        country: 'United States',
        plans: {
          starter: { monthly: 14.99, annual: 129.99 },
          plus: { monthly: 19.99, annual: 179.99 },
          max: { monthly: 39.99, annual: 249.99 },
        },
      },
      AU: {
        code: 'AUD',
        symbol: '$',
        country: 'Australia',
        plans: {
          starter: { monthly: 23.99, annual: 184.99 },
          plus: { monthly: 28.49, annual: 254.99 },
          max: { monthly: 56.99, annual: 354.99 },
        },
      },
      CA: {
        code: 'CAD',
        symbol: '$',
        country: 'Canada',
        plans: {
          starter: { monthly: 21.00, annual: 184.99 },
          plus: { monthly: 28.99, annual: 254.99 },
          max: { monthly: 55.99, annual: 349.99 },
        },
      },
      EUR: {
        code: 'EUR',
        symbol: '€',
        country: 'Europe',
        plans: {
          starter: { monthly: 13.00, annual: 113.45 },
          plus: { monthly: 18.55, annual: 155.55 },
          max: { monthly: 35.55, annual: 215.55 },
        },
      },
      GB: {
        code: 'GBP',
        symbol: '£',
        country: 'United Kingdom',
        plans: {
          starter: { monthly: 11.99, annual: 98.50 },
          plus: { monthly: 15.45, annual: 134.45 },
          max: { monthly: 29.95, annual: 186.45 },
        },
      },
    }
    const eurozone = ['AT','BE','CY','EE','FI','FR','DE','GR','IE','IT','LV','LT','LU','MT','NL','PT','SK','SI','ES']

    const fmt = (n, region = currentRegion) => {
      const p = regionalPricing[region] || regionalPricing.US
      return p.symbol + Number(n).toFixed(2)
    }
    function priceForPlan(planId, mode, region = currentRegion) {
      const regionPrices = regionalPricing[region] || regionalPricing.US
      const plan = regionPrices.plans[planId]
      if (!plan) return null
      return mode === 'annual' ? plan.annual / 12 : plan.monthly
    }

    const priceFrames = new Map<Element, number>()
    function updatePrice(el: Element, to: number, animate: boolean) {
      const pending = priceFrames.get(el)
      if (pending !== undefined) cancelAnimationFrame(pending)
      priceFrames.delete(el)
      const from = Number((el.textContent || '').replace(/[^0-9.]/g, ''))
      const region = currentRegion
      // Assistive technology gets the final price, not the animation's intermediate values.
      el.setAttribute('aria-label', fmt(to, region))
      if (!animate || matchMedia('(prefers-reduced-motion: reduce)').matches || !Number.isFinite(from) || from === to) {
        el.textContent = fmt(to, region)
        return
      }
      let start: number | null = null
      function frame(now: number) {
        if (start === null) start = now
        const progress = Math.min((now - start) / 520, 1)
        const eased = 1 - Math.pow(1 - progress, 3)
        el.textContent = fmt(from + (to - from) * eased, region)
        if (progress < 1) priceFrames.set(el, requestAnimationFrame(frame))
        else {
          el.textContent = fmt(to, region)
          priceFrames.delete(el)
          document.dispatchEvent(new Event('app-billing-updated'))
        }
      }
      priceFrames.set(el, requestAnimationFrame(frame))
    }

    function regionFromCountryCode(countryCode) {
      const c = countryCode || ''
      if (c === 'AU') return 'AU'
      if (c === 'US') return 'US'
      if (c === 'CA') return 'CA'
      if (c === 'GB') return 'GB'
      if (eurozone.indexOf(c) > -1) return 'EUR'
      return 'US'
    }

    function annualSaving(planId, region = currentRegion) {
      const p = regionalPricing[region] || regionalPricing.US
      const plan = p.plans[planId]
      return plan ? plan.monthly * 12 - plan.annual : 0
    }

    function setBilling(mode, animate) {
      const regionPrices = regionalPricing[currentRegion] || regionalPricing.US
      toggles.forEach((t) => {
        const active = t.getAttribute('data-billing') === mode
        t.setAttribute('aria-pressed', active ? 'true' : 'false')
        t.classList.toggle('text-white', active)
        t.classList.toggle('text-gray-600', !active)
      })
      if (indicator) indicator.classList.toggle('translate-x-full', mode === 'annual')

      prices.forEach((el) => {
        const planId = el.getAttribute('data-plan')
        const to = priceForPlan(planId, mode)
        if (to === null) return
        updatePrice(el, to, Boolean(animate && mode !== currentMode))
      })
      periods.forEach((el) => { el.textContent = el.getAttribute('data-' + mode) || '' })
      compares.forEach((el) => {
        const planId = el.getAttribute('data-plan')
        const plan = regionPrices.plans[planId]
        const v = mode === 'annual' && plan ? fmt(plan.monthly) : ''
        el.textContent = v
        el.classList.toggle('hidden', !v)
      })
      subs.forEach((el) => {
        const planId = el.getAttribute('data-plan')
        const plan = regionPrices.plans[planId]
        el.textContent = mode === 'annual' && plan ? fmt(plan.annual) + ' billed yearly' : 'billed monthly'
      })
      saves.forEach((el) => {
        const planId = el.getAttribute('data-plan')
        el.textContent = mode === 'annual' ? 'Save ' + fmt(annualSaving(planId)) + ' a year' : ''
      })
      ctas.forEach((el) => {
        const href = el.getAttribute('data-' + mode + '-url')
        if (!href) return
        const tracking = window.JonerTracking?.collectTrackingParams()
        const decorated = window.JonerTracking?.appendUscreenTrackingParams(href, tracking)
        el.setAttribute('href', decorated || href)
      })
      if (note) note.textContent = 'Prices shown in ' + regionPrices.code + ' (' + regionPrices.country + ')'
      const stickyPrice = document.getElementById('sticky-price')
      if (stickyPrice) stickyPrice.textContent = 'From ' + fmt(priceForPlan('starter', mode)) + (mode==='annual' ? '/mo billed annually' : '/month')
      currentMode = mode
      document.dispatchEvent(new Event('app-billing-updated'))
    }

    toggles.forEach((t) => t.addEventListener('click', () => {
      const billingMode = t.getAttribute('data-billing') || 'annual'
      setBilling(billingMode, true)
      window.JonerTracking?.trackEvent('JoinBillingToggle', {
        custom_data: {
          billing_mode: billingMode,
          page_path: window.location.pathname,
        },
      })
    }))
    const note = document.getElementById('currency-note')

    function setRegion(region) {
      currentRegion = regionalPricing[region] ? region : 'US'
      setBilling(currentMode, false)
    }

    setBilling('annual', false)

    document.querySelectorAll('details[data-faq-question]').forEach((details) => {
      details.addEventListener('toggle', () => {
        if (!details.open) return
        window.JonerTracking?.trackEvent('JoinFaqOpen', {
          custom_data: {
            question: details.getAttribute('data-faq-question') || '',
            page_path: window.location.pathname,
          },
        })
      })
    })

    fetch('https://ipapi.co/json/')
      .then((r) => { if (!r.ok) throw new Error('ipapi blocked'); return r.json() })
      .then((d) => { setRegion(regionFromCountryCode(d.country_code)) })
      .catch(() => {
        fetch('https://ipwho.is/')
          .then((r) => { if (!r.ok) throw new Error('ipwho blocked'); return r.json() })
          .then((d) => { setRegion(regionFromCountryCode(d.country_code)) })
          .catch(() => { setRegion('US') })
      })

    // Sticky mobile CTA
    const bar = document.getElementById('sticky-cta')
    if (bar) {
      let overFinal = false
      function update() {
        const show = window.scrollY > 520 && !overFinal
        bar.classList.toggle('opacity-0', !show)
        bar.classList.toggle('translate-y-full', !show)
        bar.classList.toggle('pointer-events-none', !show)
      }
      window.addEventListener('scroll', update, { passive: true })
      window.addEventListener('resize', update)
      const final = document.getElementById('final-cta')
      if (final && 'IntersectionObserver' in window) {
        new IntersectionObserver((entries) => {
          entries.forEach((e) => { overFinal = e.isIntersecting })
          update()
        }, { threshold: 0.05 }).observe(final)
      }
      update()
    }
  </script>
</BaseLayout>
