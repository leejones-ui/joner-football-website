---
import BaseLayout from '../layouts/BaseLayout.astro'

const plans = [
  {
    id: 'monthly',
    name: 'Monthly',
    badge: '',
    desc: 'Perfect for trying us out',
    price: '$23.99',
    period: '/month',
    note: '7-day FREE trial',
    cta: 'Start Free Trial',
    ctaUrl: 'https://app.jonerfootball.com/checkout/new?o=183083',
    featured: false,
    features: [
      { text: '1,500+ Training Videos', included: true },
      { text: 'New Content Weekly', included: true },
      { text: 'Daily Challenges', included: true },
      { text: 'Community Access', included: true },
      { text: 'Live Sessions', included: true },
      { text: '100 Day Transformation Program', included: false },
      { text: 'Age Specific Training Content', included: true },
      { text: 'DM Lee Directly', included: false },
      { text: 'Team Training', included: false },
      { text: 'Coaches Section', included: false },
    ],
  },
  {
    id: 'annual',
    name: 'Annual',
    badge: '⭐ MOST POPULAR',
    desc: 'Save $83/year',
    price: '$204.99',
    period: '/year',
    note: '7-day FREE trial',
    cta: 'Start Free Trial',
    ctaUrl: 'https://app.jonerfootball.com/checkout/new?o=183092',
    featured: true,
    features: [
      { text: '1,500+ Training Videos', included: true },
      { text: 'New Content Weekly', included: true },
      { text: 'Daily Challenges', included: true },
      { text: 'Community Access', included: true },
      { text: 'Live Sessions', included: true },
      { text: 'DM Lee Directly', included: true },
      { text: 'Team Training Videos', included: true },
      { text: '100 Day Transformation Program', included: true },
      { text: 'Coaches Section', included: false },
    ],
  },
  {
    id: 'coaches',
    name: 'For The Coaches',
    badge: '',
    desc: 'Everything + Coaches Content',
    price: '$319.99',
    period: '/year',
    note: 'Full Access',
    cta: 'Join Now',
    ctaUrl: 'https://app.jonerfootball.com/checkout/new?o=202578',
    featured: false,
    features: [
      { text: 'Everything in Annual', included: true },
      { text: 'DM Lee Directly', included: true },
      { text: 'Coaches-Only Section', included: true },
      { text: 'PDF Season Plans', included: true },
      { text: 'Advanced Team Training', included: true },
      { text: 'Pro Player Sessions', included: true },
      { text: 'Workshop Discounts', included: true },
      { text: 'Coaching Templates', included: true },
    ],
  },
  {
    id: 'clubs',
    name: 'Club Subscriptions',
    badge: 'TEAMS & CLUBS',
    desc: 'For teams, academies & clubs',
    price: 'Custom Pricing',
    period: '',
    note: 'Bulk discounts',
    cta: 'Contact Sales',
    ctaUrl: 'https://jonerfootball.com/clubpricing/',
    featured: false,
    features: [
      { text: 'Custom onboarding with Lee', included: true },
      { text: 'Multi-seat Licences (Player/Coach)', included: true },
      { text: 'Transferable seats', included: true },
      { text: 'Bulk player access', included: true },
      { text: 'Dedicated community page', included: true },
      { text: 'Single-invoice for whole team', included: true },
      { text: 'Flexible billing: Monthly/Yearly', included: true },
      { text: 'Priority support', included: true },
      { text: 'Usage analytics', included: true },
      { text: 'Dedicated account rep', included: true },
      { text: 'Bespoke training plans', included: true },
    ],
  },
]
const comparisonRows = [
  ['1,500+ Training Videos', true, true, true],
  ['New Videos Every Week', true, true, true],
  ['Daily Challenges', true, true, true],
  ['Community Access', true, true, true],
  ['Live Training Sessions', true, true, true],
  ['100 Day Transformation Program', false, true, true],
  ['Age Specific Training Content', true, true, true],
  ['Create Playlist', true, true, true],
  ['Offline Downloads', true, true, true],
  ['Watch History', true, true, true],
  ['Streaks & Badges', true, true, true],
  ['Create Notes', true, true, true],
  ['Free Trial', true, true, false],
  ['DM Lee Directly', false, true, true],
  ['Team Training Videos', false, true, true],
  ['Advanced Team Training', false, false, true],
  ['PDF Season Plans', false, false, true],
  ['Coaches-Only Section', false, false, true],
  ['Pro Player Training', false, false, true],
  ['Workshop Discounts', false, false, true],
]
---

<BaseLayout
  title="Join Joner Football App | Start Your Free Trial"
  description="Choose your Joner Football plan. Start your free trial and train with the Joner Football app."
  canonical="https://jonerfootball.com/join/">
  <section id="accounts" class="bg-white pt-14 pb-14 md:pt-16 md:pb-20 text-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-3 md:mb-4 flex justify-center">
        <img src="/images/brand/joner-app-logo-horizontal.jpg" alt="Joner Football App" class="h-auto object-contain" style="width: 130px; max-width: 32vw;" loading="eager" />
      </div>

      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-5 mb-6 md:mb-8">
        <h1 class="w-full text-center lg:text-left font-heading text-[clamp(1.35rem,6.7vw,4.5rem)] font-bold uppercase leading-[0.9] tracking-tight whitespace-nowrap">Choose Your Level, Get To Work</h1>

      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-5 items-stretch">
        {plans.map((plan) => (
          <article class:list={[
            'relative rounded-[2rem] border p-6 md:p-7 flex flex-col min-h-full shadow-sm',
            plan.featured ? 'bg-black text-white border-black shadow-[0_20px_60px_rgba(0,0,0,0.18)] xl:-mt-3 xl:mb-3' : 'bg-white text-black border-gray-200',
          ]}>
            {plan.badge && (
              <div class="absolute -top-3 left-6 rounded-full bg-[#E30613] px-4 py-1.5 text-xs font-heading uppercase tracking-wider text-white shadow-lg">{plan.badge}</div>
            )}

            <div class="mb-6 pt-2">
              <h2 class="font-heading text-3xl md:text-4xl font-bold uppercase leading-none">{plan.name}</h2>
              <p class:list={['mt-3 font-body text-base leading-snug', plan.featured ? 'text-white/75' : 'text-gray-600']}>{plan.desc}</p>
            </div>

            <div class="mb-7">
              <div class="flex items-end gap-2 flex-wrap">
                <span class="font-heading text-5xl md:text-6xl font-bold leading-none">{plan.price}</span>
                <span class:list={['font-body text-base pb-1', plan.featured ? 'text-white/70' : 'text-gray-500']}>{plan.period}</span>
              </div>
              <p class:list={['mt-3 text-sm font-body', plan.featured ? 'text-white/75' : 'text-gray-600']}>{plan.note}</p>
            </div>

            <ul class="space-y-3 mb-8 flex-1">
              {plan.features.map((feature) => (
                <li class="flex gap-3 font-body text-sm leading-snug">
                  <span class:list={[
                    'mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-xs font-bold',
                    feature.included ? 'bg-[#E30613] text-white' : 'bg-gray-100 text-gray-400',
                  ]}>{feature.included ? '✓' : '✗'}</span>
                  <span class:list={[plan.featured ? 'text-white/90' : 'text-gray-800']}>{feature.text}</span>
                </li>
              ))}
            </ul>

            <a href={plan.ctaUrl} target={plan.ctaUrl.startsWith('http') ? '_blank' : undefined} rel={plan.ctaUrl.startsWith('http') ? 'noopener noreferrer' : undefined} class:list={[
              'plan-cta block w-full rounded-full px-5 py-4 text-center font-heading uppercase tracking-wider transition-colors',
              plan.featured ? 'bg-[#E30613] text-white hover:bg-[#b80510]' : 'bg-black text-white hover:bg-[#E30613]',
            ]}>{plan.cta}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-8 md:py-14 text-black">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="mb-4 text-center font-body text-sm text-gray-600 md:hidden">📱 Rotate your phone to landscape to see the full comparison table</p>
      <div class="overflow-x-auto rounded-[2rem] border border-gray-200 bg-white shadow-sm">
        <table class="w-full min-w-[680px] text-left">
          <thead class="bg-black text-white">
            <tr>
              <th class="p-5 font-heading uppercase tracking-wider">What You Get</th>
              <th class="p-5 font-heading uppercase tracking-wider text-center">Monthly<br /><span class="font-body text-sm normal-case tracking-normal">$23.99/mo</span></th>
              <th class="p-5 font-heading uppercase tracking-wider text-center">Annual<br /><span class="font-body text-sm normal-case tracking-normal">$204.99/yr</span></th>
              <th class="p-5 font-heading uppercase tracking-wider text-center">Coaches<br /><span class="font-body text-sm normal-case tracking-normal">$319.99/yr</span></th>
            </tr>
          </thead>
          <tbody>
            {comparisonRows.map((row) => (
              <tr class="border-t border-gray-100">
                <td class="p-5 font-body font-semibold">{row[0]}</td>
                {row.slice(1).map((included) => (
                  <td class="p-5 text-center font-heading text-xl">{included ? <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-[#E30613] text-white">✓</span> : <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-gray-100 text-gray-300">✗</span>}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>



</BaseLayout>
