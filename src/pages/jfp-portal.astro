---
import BaseLayout from '../layouts/BaseLayout.astro'
import '../styles/jfp.css'
---

<BaseLayout title="JFP Portal | Joner Football" description="Joner Football Performance staff portal." canonical="https://jonerfootball.com/jfp-portal/" noindex noTracking hideChrome hideMobileAppCta>
  <div class="jfp" id="jfp-portal">
    <header class="j-top">
      <div class="wrap" style="max-width:none">
        <a class="j-brand" href="/jfp-portal/"><img src="/images/joner-logo-white.png" alt="" width="30" height="30"><span>JFP Portal<small id="who-small">Joner Football Performance</small></span></a>
        <div class="j-top-links"><a class="j-btn j-btn-line j-btn-sm" href="/jfp-booking/" target="_blank" rel="noopener">Parent page</a><button type="button" class="j-btn j-btn-ghost j-btn-sm" id="sign-out" hidden>Sign out</button></div>
      </div>
    </header>

    <section id="signin" class="j-gate" hidden>
      <div class="j-card">
        <p class="j-kicker">Staff</p>
        <h1 style="margin:6px 0 16px">Sign in to the JFP portal</h1>
        <div id="si-mount"></div>
        <div id="si-foot" style="margin-top:6px"></div>
      </div>
    </section>

    <div id="app" class="jp-app" hidden>
      <nav class="jp-nav" id="nav" aria-label="Portal sections"></nav>
      <main class="jp-main" id="view" tabindex="-1"></main>
    </div>
  </div>
</BaseLayout>

<script>
  import '../scripts/jfp-portal.js'
</script>
