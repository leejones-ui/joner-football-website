---
import BaseLayout from '../layouts/BaseLayout.astro'
import '../styles/jfp.css'
import '../styles/jfp-portal.css'
---

<BaseLayout title="JFP Portal | Joner Football" description="Joner Football Performance staff portal." canonical="https://jonerfootball.com/jfp-portal/" noindex noTracking hideChrome hideMobileAppCta>
  <div class="jfp jp-theme" id="jfp-portal" data-theme="dark">
    <script is:inline>
      // Theme and sidebar state before first paint, so nothing flashes.
      try {
        var root = document.getElementById('jfp-portal')
        var t = localStorage.getItem('jfp-portal-theme'); if (t === 'light' || t === 'dark') root.dataset.theme = t
        if (localStorage.getItem('jfp-nav-collapsed') === '1') root.classList.add('nav-collapsed')
      } catch (e) {}
    </script>
    <header class="jp-top">
      <button type="button" class="jp-iconbtn jp-menu-btn" id="nav-open" aria-label="Open menu" aria-controls="side" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none"/></svg>
      </button>
      <a class="jp-brand" href="/jfp-portal/"><img src="/images/joner-logo-white.png" alt="" width="28" height="28"><span>JFP Portal</span></a>
      <div class="jp-top-right">
        <a class="jp-toplink" href="/jfp-booking/" target="_blank" rel="noopener">Parent page</a>
        <button type="button" class="jp-iconbtn" id="theme-toggle" aria-label="Switch to light mode" title="Light or dark">
          <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="jp-toplink" id="sign-out" hidden>Sign out</button>
      </div>
    </header>

    <section id="signin" class="j-gate" hidden>
      <div class="j-card">
        <p class="j-kicker">Staff</p>
        <h1 style="margin:6px 0 16px">Sign in to the JFP portal</h1>
        <div id="si-mount"></div>
        <div id="si-foot" style="margin-top:6px"></div>
      </div>
    </section>

    <div id="app" class="jp-app" hidden>
      <aside class="jp-sidebar" id="side" aria-label="Portal navigation">
        <nav class="jp-nav" id="nav" aria-label="Portal sections"></nav>
        <div class="jp-side-foot">
          <div class="jp-me"><span class="jp-me-dot" id="me-ini" aria-hidden="true"></span><span class="jp-me-txt"><b id="who-name"></b><small id="who-small">Joner Football Performance</small></span></div>
          <button type="button" class="jp-collapse" id="nav-collapse" aria-expanded="true" aria-controls="side" title="Collapse menu">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M14.5 6.5 9 12l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span class="jp-lbl">Collapse</span>
          </button>
        </div>
      </aside>
      <div class="jp-scrim" id="nav-scrim" hidden></div>
      <main class="jp-main" id="view" tabindex="-1"></main>
    </div>
    <div class="jp-tip" id="chart-tip" role="tooltip" hidden></div>
  </div>
</BaseLayout>

<script>
  import '../scripts/jfp-portal.js'
</script>
