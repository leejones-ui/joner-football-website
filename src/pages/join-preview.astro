---
import BaseLayout from '../layouts/BaseLayout.astro'

const accountPlans = [
  {
    id: 'starter',
    name: 'Starter',
    eyebrow: 'Start here',
    audience: 'Best for beginners getting inside the app.',
    monthlyPrice: '$14.99',
    annualPrice: '$10.83',
    annualCompare: '$14.99/mo',
    annualNote: 'Billed yearly at $129.99',
    periodMonthly: 'per month',
    periodAnnual: 'per month',
    cta: 'Start Free Trial',
    ctaUrl: 'https://app.jonerfootball.com/checkout/new?o=183092',
    monthlyCtaUrl: 'https://app.jonerfootball.com/checkout/new?o=183083',
    tone: 'quiet',
    features: [
      ['1,500+ Training Videos', true],
      ['New Content Weekly', true],
      ['Daily Challenges', true],
      ['Community Access', true],
      ['Live Sessions', true],
      ['100 Day Transformation Program', false],
      ['DM Lee Directly', false],
      ['Team Training', false],
      ['Coaches Section', false],
    ],
  },
  {
    id: 'plus',
    name: 'Plus',
    eyebrow: 'Most Popular',
    audience: 'Structured training programs to transform your game.',
    monthlyPrice: '$19.99',
    annualPrice: '$14.99',
    annualCompare: '$19.99/mo',
    annualNote: 'Billed yearly at $179.99',
    periodMonthly: 'per month',
    periodAnnual: 'per month',
    cta: 'Start Free Trial',
    ctaUrl: 'https://app.jonerfootball.com/checkout/new?o=183092',
    monthlyCtaUrl: 'https://app.jonerfootball.com/checkout/new?o=183083',
    tone: 'featured',
    features: [
      ['Everything in Starter', true],
      ['100 Day Transformation Program', true],
      ['DM Lee Directly', true],
      ['Team Training Videos', true],
      ['Offline Downloads', true],
      ['Watch History', true],
      ['Streaks and Badges', true],
      ['Coaches Section', false],
    ],
  },
  {
    id: 'max',
    name: 'Max',
    eyebrow: 'Full Access',
    audience: 'Full access to the coaches only section and every app feature.',
    monthlyPrice: '$219',
    annualPrice: '$219',
    annualCompare: '',
    annualNote: 'Annual only',
    monthlyNote: 'Annual only',
    periodMonthly: 'per year',
    periodAnnual: 'per year',
    cta: 'Join Max',
    ctaUrl: 'https://app.jonerfootball.com/checkout/new?o=202578',
    tone: 'strong',
    features: [
      ['Everything in Plus', true],
      ['Coaches Section', true],
      ['PDF Season Plans', true],
      ['Advanced Team Training', true],
      ['Pro Player Sessions', true],
      ['Workshop Discounts', true],
      ['Coaching Templates', true],
    ],
  },
  {
    id: 'club',
    name: 'Club Plan',
    eyebrow: 'Request only',
    audience: 'For clubs, schools and academies.',
    monthlyPrice: 'Request',
    annualPrice: 'Request',
    annualCompare: '',
    annualNote: '',
    periodMonthly: '',
    periodAnnual: '',
    cta: 'Request Club Plan',
    ctaUrl: '/teams',
    tone: 'quiet',
    features: [
      ['Custom onboarding with Lee', true],
      ['Multi-seat licences', true],
      ['Transferable seats', true],
      ['Bulk player access', true],
      ['Single invoice for the whole team', true],
      ['Usage analytics', true],
      ['Priority support', true],
    ],
  },
]

const comparisonRows = [
  ['1,500+ Training Videos', true, true, true, true],
  ['New Videos Every Week', true, true, true, true],
  ['Daily Challenges', true, true, true, true],
  ['Community Access', true, true, true, true],
  ['Live Training Sessions', true, true, true, true],
  ['100 Day Transformation Program', false, true, true, true],
  ['Age Specific Training Content', true, true, true, true],
  ['Create Playlist', true, true, true, true],
  ['Offline Downloads', true, true, true, true],
  ['Watch History', true, true, true, true],
  ['Streaks and Badges', true, true, true, true],
  ['Create Notes', true, true, true, true],
  ['Free Trial', true, true, false, false],
  ['DM Lee Directly', false, true, true, true],
  ['Team Training Videos', false, true, true, true],
  ['Advanced Team Training', false, false, true, true],
  ['PDF Season Plans', false, false, true, true],
  ['Coaches Section', false, false, true, true],
  ['Pro Player Training', false, false, true, true],
  ['Workshop Discounts', false, false, true, true],
]
---

<BaseLayout
  title="Private Join Page Preview | Joner Football"
  description="Private preview of the new Joner Football account based join page."
  canonical="https://jonerfootball.com/join-preview/"
>
  <Fragment slot="head">
    <meta name="robots" content="noindex,nofollow" />
  </Fragment>

  <section id="accounts" class="bg-[#0A0A0A] pt-24 pb-16 md:pt-28 md:pb-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10">
        <div>
          <img src="/images/brand/joner-app-logo.jpg" alt="Joner Football App" class="h-12 w-auto mb-6 rounded-xl" loading="eager" />
          <h2 class="font-heading text-4xl md:text-5xl font-bold text-white uppercase leading-none">Choose Your Level. Get To Work.</h2>
        </div>

        <div class="bg-[#111111] border border-gray-800 rounded-full p-1 flex w-full sm:w-auto" aria-label="Billing toggle">
          <button type="button" data-billing="monthly" class="billing-toggle flex-1 sm:flex-none rounded-full px-6 py-3 text-sm font-heading uppercase tracking-wider text-gray-300">Monthly</button>
          <button type="button" data-billing="annual" class="billing-toggle active flex-1 sm:flex-none rounded-full px-6 py-3 text-sm font-heading uppercase tracking-wider bg-[#E30613] text-white">Annual</button>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 items-stretch">
        {accountPlans.map((plan) => (
          <article class:list={[
            'relative rounded-3xl border p-6 md:p-7 flex flex-col min-h-full',
            plan.tone === 'featured' ? 'bg-white text-black border-white shadow-[0_0_50px_rgba(227,6,19,0.24)] xl:-mt-4 xl:mb-4' : 'bg-[#111111] text-white border-gray-800',
            plan.tone === 'strong' ? 'border-[#E30613]/70' : '',
          ]}>
            <div class:list={[
              'inline-flex self-start rounded-full px-3 py-1 text-xs font-heading uppercase tracking-wider mb-5',
              plan.tone === 'featured' ? 'bg-[#E30613] text-white' : 'bg-[#E30613]/10 text-[#E30613] border border-[#E30613]/30',
            ]}>{plan.eyebrow}</div>

            <h3 class="font-heading text-3xl font-bold uppercase mb-3">{plan.name}</h3>
            <p class:list={['font-body text-sm leading-relaxed min-h-[64px] mb-6', plan.tone === 'featured' ? 'text-gray-700' : 'text-gray-400']}>
              {plan.id === 'max' ? <Fragment>Full access to the <span class="text-[#E30613] font-bold">coaches only section</span> and every app feature.</Fragment> : plan.audience}
            </p>

            <div class="mb-6">
              <span class="hidden billing-compare mb-1 text-lg font-heading line-through opacity-50" data-monthly="" data-annual={plan.annualCompare}>{plan.annualCompare}</span>
              <div class="flex items-end gap-2 flex-wrap">
                <span class="font-heading text-5xl font-bold billing-price" data-monthly={plan.monthlyPrice} data-annual={plan.annualPrice}>{plan.annualPrice}</span>
              </div>
              <div class:list={['billing-period font-body text-sm mt-1', plan.tone === 'featured' ? 'text-gray-700' : 'text-gray-300']} data-monthly={plan.periodMonthly} data-annual={plan.periodAnnual}>{plan.periodAnnual}</div>
              {(plan.annualNote || plan.monthlyNote) && <div class:list={['billing-note mt-2 text-xs font-body', plan.tone === 'featured' ? 'text-gray-600' : 'text-gray-500']} data-monthly={plan.monthlyNote || ''} data-annual={plan.annualNote || ''}>{plan.annualNote || plan.monthlyNote}</div>}
            </div>

            <ul class="space-y-3 mb-8 flex-1">
              {plan.features.map(([feature, included]) => (
                <li class:list={['flex gap-3 font-body text-sm leading-snug', !included ? 'opacity-45' : '']}>
                  <span class:list={['mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-xs font-bold', included ? 'bg-[#E30613] text-white' : 'bg-gray-200 text-gray-500']}>{included ? '✓' : '×'}</span>
                  <span class:list={[plan.tone === 'featured' ? 'text-gray-800' : 'text-gray-200', !included ? 'line-through' : '']}>{feature}</span>
                </li>
              ))}
            </ul>

            <a href={plan.ctaUrl} data-annual-url={plan.ctaUrl} data-monthly-url={plan.monthlyCtaUrl || plan.ctaUrl} target={plan.ctaUrl.startsWith('http') ? '_blank' : undefined} rel={plan.ctaUrl.startsWith('http') ? 'noopener noreferrer' : undefined} class:list={[
              'plan-cta block w-full rounded-full px-5 py-4 text-center font-heading uppercase tracking-wider transition-colors',
              plan.tone === 'featured' ? 'bg-[#E30613] text-white hover:bg-[#b80510]' : 'bg-white text-black hover:bg-gray-200',
            ]}>{plan.cta}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#F5F5F5] py-16 md:py-24 text-black">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <p class="text-[#E30613] font-heading text-sm uppercase tracking-widest mb-3">Compare accounts</p>
        <h2 class="font-heading text-4xl md:text-5xl font-bold uppercase leading-none">What each account gets</h2>
      </div>

      <div class="overflow-x-auto rounded-3xl border border-gray-200 bg-white shadow-xl">
        <table class="w-full min-w-[760px] text-left">
          <thead class="bg-black text-white">
            <tr>
              <th class="p-5 font-heading uppercase tracking-wider">Feature</th>
              <th class="p-5 font-heading uppercase tracking-wider text-center">Starter</th>
              <th class="p-5 font-heading uppercase tracking-wider text-center">Plus</th>
              <th class="p-5 font-heading uppercase tracking-wider text-center">Max</th>
              <th class="p-5 font-heading uppercase tracking-wider text-center">Club Plan</th>
            </tr>
          </thead>
          <tbody>
            {comparisonRows.map((row) => (
              <tr class="border-t border-gray-200">
                <td class="p-5 font-body font-semibold">{row[0]}</td>
                {row.slice(1).map((included) => (
                  <td class="p-5 text-center font-heading text-xl">{included ? <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-[#E30613] text-white">✓</span> : <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-gray-200 text-gray-400">×</span>}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-[#0A0A0A] py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="bg-[#111111] border border-gray-800 rounded-3xl p-8">
        <p class="text-[#E30613] font-heading text-sm uppercase tracking-widest mb-3">Players</p>
        <h3 class="font-heading text-3xl font-bold uppercase mb-4">Build better habits.</h3>
        <p class="text-gray-400 font-body leading-relaxed">Train with a clear plan instead of guessing what to practise next.</p>
      </div>
      <div class="bg-[#111111] border border-gray-800 rounded-3xl p-8">
        <p class="text-[#E30613] font-heading text-sm uppercase tracking-widest mb-3">Parents</p>
        <h3 class="font-heading text-3xl font-bold uppercase mb-4">Give them structure.</h3>
        <p class="text-gray-400 font-body leading-relaxed">The app gives your child sessions they can follow at home, on the pitch or before training.</p>
      </div>
      <div class="bg-[#111111] border border-gray-800 rounded-3xl p-8">
        <p class="text-[#E30613] font-heading text-sm uppercase tracking-widest mb-3">Coaches</p>
        <h3 class="font-heading text-3xl font-bold uppercase mb-4">Plan sessions faster.</h3>
        <p class="text-gray-400 font-body leading-relaxed">Use Joner drills, progressions and templates to run sharper sessions every week.</p>
      </div>
    </div>
  </section>

  <section class="bg-white text-black py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <p class="text-[#E30613] font-heading text-sm uppercase tracking-widest mb-3">Questions</p>
        <h2 class="font-heading text-4xl md:text-5xl font-bold uppercase leading-none">Before you join</h2>
      </div>
      <div class="space-y-4">
        <details class="group rounded-2xl border border-gray-200 p-6">
          <summary class="cursor-pointer font-heading text-xl uppercase list-none">What is the difference between Starter and Plus?</summary>
          <p class="mt-4 text-gray-700 font-body leading-relaxed">Starter gives you the core Joner Football training library. Plus is for players and parents who want deeper structure, more detail and more advanced pathways.</p>
        </details>
        <details class="group rounded-2xl border border-gray-200 p-6">
          <summary class="cursor-pointer font-heading text-xl uppercase list-none">Who is Max for?</summary>
          <p class="mt-4 text-gray-700 font-body leading-relaxed">Max is for coaches, serious players and families who want the complete system, including the coaches section and advanced session planning content.</p>
        </details>
        <details class="group rounded-2xl border border-gray-200 p-6">
          <summary class="cursor-pointer font-heading text-xl uppercase list-none">Can I pay monthly?</summary>
          <p class="mt-4 text-gray-700 font-body leading-relaxed">Yes. Use the monthly and annual switcher at the top of the account cards.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="bg-[#E30613] py-14 md:py-20 text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-heading text-4xl md:text-6xl font-bold uppercase leading-none mb-5">Start training with Joner today.</h2>
      <p class="font-body text-lg md:text-xl text-white/90 mb-8">Choose Starter, Plus, Max or request a Club Plan.</p>
      <a href="#accounts" class="inline-flex bg-white text-black rounded-full px-8 py-4 font-heading uppercase tracking-wider hover:bg-gray-100">Choose Your Plan</a>
    </div>
  </section>

  <script>
    const toggles = document.querySelectorAll('.billing-toggle')
    const prices = document.querySelectorAll('.billing-price')
    const compares = document.querySelectorAll('.billing-compare')
    const periods = document.querySelectorAll('.billing-period')
    const notes = document.querySelectorAll('.billing-note')
    const ctas = document.querySelectorAll('.plan-cta')

    function setBilling(mode) {
      toggles.forEach((toggle) => {
        const active = toggle.getAttribute('data-billing') === mode
        toggle.classList.toggle('active', active)
        toggle.classList.toggle('bg-[#E30613]', active)
        toggle.classList.toggle('text-white', active)
        toggle.classList.toggle('text-gray-300', !active)
      })

      prices.forEach((price) => {
        price.textContent = price.getAttribute(`data-${mode}`) || ''
      })

      compares.forEach((compare) => {
        const value = compare.getAttribute(`data-${mode}`) || ''
        compare.textContent = value
        compare.classList.toggle('hidden', !value)
      })

      periods.forEach((period) => {
        period.textContent = period.getAttribute(`data-${mode}`) || ''
      })

      notes.forEach((note) => {
        const value = note.getAttribute(`data-${mode}`) || ''
        note.textContent = value
        note.classList.toggle('hidden', !value)
      })

      ctas.forEach((cta) => {
        const href = cta.getAttribute(`data-${mode}-url`)
        if (href) cta.setAttribute('href', href)
      })
    }

    toggles.forEach((toggle) => {
      toggle.addEventListener('click', () => setBilling(toggle.getAttribute('data-billing') || 'annual'))
    })

    setBilling('annual')
  </script>
</BaseLayout>
