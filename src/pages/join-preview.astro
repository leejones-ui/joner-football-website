---
import BaseLayout from '../layouts/BaseLayout.astro'

const plans = [
  {
    id: 'monthly',
    name: 'Monthly',
    badge: '',
    monthlyPrice: '$23.99',
    monthlyPeriod: '/month',
    annualPrice: '$23.99',
    annualPeriod: '/month',
    noteMonthly: '7-day free trial',
    noteAnnual: '7-day free trial',
    cta: 'Start Free Trial',
    ctaUrl: 'https://app.jonerfootball.com/checkout/new?o=183083',
    ctaMonthlyUrl: 'https://app.jonerfootball.com/checkout/new?o=183083',
    featured: false,
    features: [
      '1,500+ training videos',
      'New content every week',
      'Daily challenges',
      'Community access',
      'Live sessions',
    ],
  },
  {
    id: 'annual',
    name: 'Annual',
    badge: 'Most Popular',
    monthlyPrice: '$17.08',
    monthlyPeriod: '/month',
    annualPrice: '$204.99',
    annualPeriod: '/year',
    noteMonthly: 'Billed yearly. Save $83',
    noteAnnual: '7-day free trial. Save $83',
    cta: 'Start Free Trial',
    ctaUrl: 'https://app.jonerfootball.com/checkout/new?o=183092',
    ctaMonthlyUrl: 'https://app.jonerfootball.com/checkout/new?o=183092',
    featured: true,
    features: [
      'Everything in Monthly',
      '100 Day Transformation Program',
      'DM Lee directly',
      'Team training videos',
      'Best value for serious players',
    ],
  },
  {
    id: 'max',
    name: 'Max',
    badge: '',
    monthlyPrice: '$26.67',
    monthlyPeriod: '/month',
    annualPrice: '$319.99',
    annualPeriod: '/year',
    noteMonthly: 'Billed yearly. Full access day one',
    noteAnnual: 'Full access day one',
    cta: 'Join Max',
    ctaUrl: 'https://app.jonerfootball.com/checkout/new?o=202578',
    ctaMonthlyUrl: 'https://app.jonerfootball.com/checkout/new?o=202578',
    featured: false,
    features: [
      'Everything in Annual',
      'Full coaches content',
      'PDF season plans',
      'Advanced team training',
      'Pro player sessions',
    ],
  },
  {
    id: 'club',
    name: 'Club',
    badge: '',
    monthlyPrice: 'Custom',
    monthlyPeriod: '',
    annualPrice: 'Custom',
    annualPeriod: '',
    noteMonthly: 'For clubs, schools and academies',
    noteAnnual: 'For clubs, schools and academies',
    cta: 'Get Club Pricing',
    ctaUrl: '/teams',
    ctaMonthlyUrl: '/teams',
    featured: false,
    features: [
      'Multi-seat access',
      'Custom onboarding',
      'Bulk player licences',
      'Single invoice',
      'Priority support',
    ],
  },
]

const comparisonRows = [
  ['1,500+ training videos', true, true, true, true],
  ['New videos every week', true, true, true, true],
  ['Daily challenges', true, true, true, true],
  ['Community access', true, true, true, true],
  ['Live training sessions', true, true, true, true],
  ['100 Day Transformation Program', false, true, true, true],
  ['DM Lee directly', false, true, true, true],
  ['Team training videos', false, true, true, true],
  ['Full coaches content', false, false, true, true],
  ['PDF season plans', false, false, true, true],
  ['Advanced team training', false, false, true, true],
]
---

<BaseLayout
  title="Private Join Page Preview | Joner Football"
  description="Private preview of the new Joner Football join page."
  canonical="https://jonerfootball.com/join-preview/"
  noindex>
  <section id="accounts" class="bg-white pt-24 pb-14 md:pt-28 md:pb-20 text-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-8 md:mb-12">
        <h1 class="font-heading text-5xl md:text-7xl font-bold uppercase leading-[0.9] tracking-tight max-w-3xl">Choose Your Level. Get To Work.</h1>

        <div class="w-full lg:w-[360px]">
          <div class="bg-gray-100 border border-gray-200 rounded-full p-1 flex w-full" aria-label="Billing toggle">
            <button type="button" data-billing="monthly" class="billing-toggle flex-1 rounded-full px-5 py-3 text-sm font-heading uppercase tracking-wider text-gray-600">Monthly</button>
            <button type="button" data-billing="annual" class="billing-toggle active flex-1 rounded-full px-5 py-3 text-sm font-heading uppercase tracking-wider bg-black text-white">Annual</button>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-5 items-stretch">
        {plans.map((plan) => (
          <article class:list={[
            'relative rounded-[2rem] border p-6 md:p-7 flex flex-col min-h-full shadow-sm',
            plan.featured ? 'bg-black text-white border-black shadow-[0_20px_60px_rgba(0,0,0,0.18)] xl:-mt-3 xl:mb-3' : 'bg-white text-black border-gray-200',
          ]}>
            {plan.badge && (
              <div class="absolute -top-3 left-6 rounded-full bg-[#E30613] px-4 py-1.5 text-xs font-heading uppercase tracking-wider text-white shadow-lg">{plan.badge}</div>
            )}

            <div class="mb-6 pt-2">
              <h2 class="font-heading text-3xl md:text-4xl font-bold uppercase leading-none">{plan.name}</h2>
            </div>

            <div class="mb-7">
              <div class="flex items-end gap-2 flex-wrap">
                <span class="billing-price font-heading text-5xl md:text-6xl font-bold leading-none" data-monthly={plan.monthlyPrice} data-annual={plan.annualPrice}>{plan.annualPrice}</span>
                <span class:list={['billing-period font-body text-base pb-1', plan.featured ? 'text-white/70' : 'text-gray-500']} data-monthly={plan.monthlyPeriod} data-annual={plan.annualPeriod}>{plan.annualPeriod}</span>
              </div>
              <p class:list={['billing-note mt-3 text-sm font-body', plan.featured ? 'text-white/75' : 'text-gray-600']} data-monthly={plan.noteMonthly} data-annual={plan.noteAnnual}>{plan.noteAnnual}</p>
            </div>

            <ul class="space-y-3 mb-8 flex-1">
              {plan.features.map((feature) => (
                <li class="flex gap-3 font-body text-sm leading-snug">
                  <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#E30613] text-xs font-bold text-white">✓</span>
                  <span class:list={[plan.featured ? 'text-white/90' : 'text-gray-800']}>{feature}</span>
                </li>
              ))}
            </ul>

            <a href={plan.ctaUrl} data-annual-url={plan.ctaUrl} data-monthly-url={plan.ctaMonthlyUrl} target={plan.ctaUrl.startsWith('http') ? '_blank' : undefined} rel={plan.ctaUrl.startsWith('http') ? 'noopener noreferrer' : undefined} class:list={[
              'plan-cta block w-full rounded-full px-5 py-4 text-center font-heading uppercase tracking-wider transition-colors',
              plan.featured ? 'bg-[#E30613] text-white hover:bg-[#b80510]' : 'bg-black text-white hover:bg-[#E30613]',
            ]}>{plan.cta}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-8 md:py-14 text-black">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="overflow-x-auto rounded-[2rem] border border-gray-200 bg-white shadow-sm">
        <table class="w-full min-w-[760px] text-left">
          <thead class="bg-black text-white">
            <tr>
              <th class="p-5 font-heading uppercase tracking-wider">Included</th>
              <th class="p-5 font-heading uppercase tracking-wider text-center">Monthly</th>
              <th class="p-5 font-heading uppercase tracking-wider text-center">Annual</th>
              <th class="p-5 font-heading uppercase tracking-wider text-center">Max</th>
              <th class="p-5 font-heading uppercase tracking-wider text-center">Club</th>
            </tr>
          </thead>
          <tbody>
            {comparisonRows.map((row) => (
              <tr class="border-t border-gray-100">
                <td class="p-5 font-body font-semibold">{row[0]}</td>
                {row.slice(1).map((included) => (
                  <td class="p-5 text-center font-heading text-xl">{included ? <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-[#E30613] text-white">✓</span> : <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-gray-100 text-gray-300">×</span>}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white text-black py-10 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-4">
        <details class="group rounded-2xl border border-gray-200 p-6">
          <summary class="cursor-pointer font-heading text-xl uppercase list-none">What should I choose?</summary>
          <p class="mt-4 text-gray-700 font-body leading-relaxed">Choose Monthly to try the app. Choose Annual for the best value. Choose Max if you want the full coaching system.</p>
        </details>
        <details class="group rounded-2xl border border-gray-200 p-6">
          <summary class="cursor-pointer font-heading text-xl uppercase list-none">Can I start free?</summary>
          <p class="mt-4 text-gray-700 font-body leading-relaxed">Monthly and Annual include a 7-day free trial. Max gives full access from day one.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="bg-[#E30613] py-14 md:py-20 text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-heading text-4xl md:text-6xl font-bold uppercase leading-none mb-6">Start training today.</h2>
      <a href="#accounts" class="inline-flex bg-white text-black rounded-full px-8 py-4 font-heading uppercase tracking-wider hover:bg-gray-100">Choose Your Plan</a>
    </div>
  </section>

  <script>
    const toggles = document.querySelectorAll('.billing-toggle')
    const prices = document.querySelectorAll('.billing-price')
    const periods = document.querySelectorAll('.billing-period')
    const notes = document.querySelectorAll('.billing-note')
    const ctas = document.querySelectorAll('.plan-cta')

    function setBilling(mode) {
      toggles.forEach((toggle) => {
        const active = toggle.getAttribute('data-billing') === mode
        toggle.classList.toggle('active', active)
        toggle.classList.toggle('bg-black', active)
        toggle.classList.toggle('text-white', active)
        toggle.classList.toggle('text-gray-600', !active)
      })

      prices.forEach((price) => {
        price.textContent = price.getAttribute(`data-${mode}`) || ''
      })

      periods.forEach((period) => {
        period.textContent = period.getAttribute(`data-${mode}`) || ''
      })

      notes.forEach((note) => {
        note.textContent = note.getAttribute(`data-${mode}`) || ''
      })

      ctas.forEach((cta) => {
        const href = cta.getAttribute(`data-${mode}-url`)
        if (href) cta.setAttribute('href', href)
      })
    }

    toggles.forEach((toggle) => {
      toggle.addEventListener('click', () => setBilling(toggle.getAttribute('data-billing') || 'annual'))
    })

    setBilling('annual')
  </script>
</BaseLayout>
