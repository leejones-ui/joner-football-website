---
import BaseLayout from '../layouts/BaseLayout.astro'

const schema = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: 'Football Coach',
  description: 'Joner Football is accepting applications from qualified, experienced football coaches for its growing programme in Sydney, Australia. Applications are welcome worldwide.',
  hiringOrganization: { '@type': 'Organization', name: 'Joner Football', sameAs: 'https://jonerfootball.com' },
  jobLocation: {
    '@type': 'Place',
    address: { '@type': 'PostalAddress', addressLocality: 'Sydney', addressCountry: 'AU' },
  },
}
---

<BaseLayout
  title="Apply For A Coaching Role | Joner Football"
  description="Joner Football is growing. Apply to join our coaching team in Sydney, Australia. Qualified coaches with 1on1 and small group experience are welcome worldwide."
  canonical="https://jonerfootball.com/new-coaching-role/"
  ogImage="https://jonerfootball.com/images/contact/coaching-role-hero.jpg"
  schema={schema}
>
  <section class="relative flex min-h-[68dvh] items-end overflow-hidden bg-joner-black pt-24">
    <div class="absolute inset-0">
      <img src="/images/contact/coaching-role-hero.jpg" alt="Joner Football coach working with players on the pitch" class="h-full w-full object-cover object-center" />
      <div class="absolute inset-0 bg-black/65"></div>
      <div class="absolute inset-x-0 bottom-0 h-48 bg-gradient-to-t from-joner-black to-transparent"></div>
    </div>
    <div class="relative z-10 mx-auto w-full max-w-7xl px-5 pb-16 sm:px-8 md:pb-24">
      <p class="mb-5 font-heading text-xs font-bold uppercase tracking-[0.3em] text-joner-red">Join Joner Football</p>
      <h1 class="max-w-4xl font-heading text-6xl font-black uppercase leading-[0.88] tracking-tight text-white sm:text-8xl lg:text-[9rem]">Coach the<br /><span class="text-joner-red">Joner way.</span></h1>
      <p class="mt-7 max-w-xl font-body text-lg leading-relaxed text-gray-200 md:text-xl">Our programme is growing. We are looking for experienced, qualified coaches who care about doing the work properly.</p>
    </div>
  </section>

  <section class="bg-joner-black py-16 md:py-24">
    <div class="mx-auto grid max-w-7xl gap-10 px-5 sm:px-8 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div>
        <p class="mb-4 font-heading text-xs font-bold uppercase tracking-[0.28em] text-joner-red">The opportunity</p>
        <h2 class="max-w-2xl font-heading text-4xl font-black uppercase leading-[0.95] text-white md:text-6xl">Build better footballers with us.</h2>
        <div class="mt-7 space-y-5 font-body text-base leading-relaxed text-gray-300 md:text-lg">
          <p>Joner Football is a growing football coaching programme based in Sydney, Australia. We work with players through 1on1 coaching and small group training, with a clear focus on technical quality.</p>
          <p>This is a chance to join a team, work in a high-standard coaching environment, and explore life in Sydney. Applications are welcome from coaches around the world.</p>
        </div>
        <div class="mt-10 overflow-hidden border border-gray-800">
          <img src="/images/camps/joner-camps/lee-coaching-group.jpg" alt="Lee Jones coaching a small group at Joner Football" class="aspect-[4/3] w-full object-cover" loading="lazy" />
        </div>
      </div>

      <div class="border border-gray-800 bg-joner-gray p-6 sm:p-9">
        <p class="mb-3 font-heading text-xs font-bold uppercase tracking-[0.28em] text-joner-red">Before you apply</p>
        <h2 class="font-heading text-3xl font-black uppercase leading-tight text-white md:text-5xl">You must have</h2>
        <ul class="mt-8 space-y-4 font-body text-base leading-relaxed text-gray-200 md:text-lg">
          <li class="flex gap-4 border-t border-gray-700 pt-4"><span class="font-heading text-joner-red">01</span><span>Full coaching qualifications.</span></li>
          <li class="flex gap-4 border-t border-gray-700 pt-4"><span class="font-heading text-joner-red">02</span><span>Experience coaching both 1on1 and small group training.</span></li>
          <li class="flex gap-4 border-t border-gray-700 pt-4"><span class="font-heading text-joner-red">03</span><span>A full driving licence and your own car.</span></li>
          <li class="flex gap-4 border-t border-gray-700 pt-4"><span class="font-heading text-joner-red">04</span><span>A Working With Children Check.</span></li>
          <li class="flex gap-4 border-t border-gray-700 pt-4"><span class="font-heading text-joner-red">05</span><span>The ability to demonstrate football skills correctly. This is crucial.</span></li>
          <li class="flex gap-4 border-y border-gray-700 py-4"><span class="font-heading text-joner-red">06</span><span>A strong work ethic and real passion for developing players.</span></li>
        </ul>
        <p class="mt-7 font-body text-sm leading-relaxed text-gray-400">If you are looking to explore Sydney and become part of a growing coaching team, we want to hear from you. Please include your age in years with your application — no date of birth is required.</p>
        <div class="mt-10 border-t border-gray-700 pt-8"><a href="/contact?type=coaching-role" class="btn-red inline-flex w-full justify-center px-8 py-5 text-base sm:w-auto">Apply for coaching role</a></div>
      </div>
    </div>
  </section>
</BaseLayout>
