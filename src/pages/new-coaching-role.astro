---
import BaseLayout from '../layouts/BaseLayout.astro'

const heroImage = '/images/contact/coaching-role-hero.jpg'
const coachingImage = '/images/camps/joner-camps/lee-coaching-group.jpg'

const schema = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: 'Football Coach',
  description: 'Joner Football is accepting applications from qualified, experienced football coaches for its growing programme in Sydney, Australia. Applications are welcome worldwide.',
  hiringOrganization: {
    '@type': 'Organization',
    name: 'Joner Football',
    sameAs: 'https://jonerfootball.com',
  },
  jobLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Sydney',
      addressCountry: 'AU',
    },
  },
}
---

<BaseLayout
  title="Coaching Roles | Joner Football"
  description="Joner Football is growing. Apply to join our coaching team in Sydney, Australia. Qualified coaches with 1on1 and small group experience are welcome worldwide."
  canonical="https://jonerfootball.com/new-coaching-role/"
  ogImage={`https://jonerfootball.com${heroImage}`}
  schema={schema}
>
  <section class="relative flex min-h-[70dvh] items-end overflow-hidden bg-joner-black pt-24">
    <div class="absolute inset-0">
      <img src={heroImage} alt="Joner Football coach working with players on the pitch" class="h-full w-full object-cover object-center" />
      <div class="absolute inset-0 bg-black/65"></div>
      <div class="absolute inset-x-0 bottom-0 h-56 bg-gradient-to-t from-joner-black to-transparent"></div>
    </div>
    <div class="relative z-10 mx-auto w-full max-w-7xl px-5 pb-16 sm:px-8 md:pb-24">
      <p class="mb-5 font-heading text-xs font-bold uppercase tracking-[0.3em] text-joner-red">Join Joner Football</p>
      <h1 class="max-w-4xl font-heading text-6xl font-black uppercase leading-[0.88] tracking-tight text-white sm:text-8xl lg:text-[9rem]">Coach the<br /><span class="text-joner-red">Joner way.</span></h1>
      <p class="mt-7 max-w-xl font-body text-lg leading-relaxed text-gray-200 md:text-xl">Our programme is growing. We are looking for experienced, qualified coaches who care about doing the work properly.</p>
    </div>
  </section>

  <section class="bg-joner-black py-16 md:py-24">
    <div class="mx-auto grid max-w-7xl gap-10 px-5 sm:px-8 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div>
        <p class="mb-4 font-heading text-xs font-bold uppercase tracking-[0.28em] text-joner-red">The opportunity</p>
        <h2 class="max-w-2xl font-heading text-4xl font-black uppercase leading-[0.95] text-white md:text-6xl">Build better footballers with us.</h2>
        <div class="mt-7 space-y-5 font-body text-base leading-relaxed text-gray-300 md:text-lg">
          <p>Joner Football is a growing football coaching programme based in Sydney, Australia. We work with players through 1on1 coaching and small group training, with a clear focus on technical quality.</p>
          <p>This is a chance to join a team, work in a high-standard coaching environment, and explore life in Sydney. Applications are welcome from coaches around the world.</p>
        </div>
        <div class="mt-10 overflow-hidden border border-gray-800">
          <img src={coachingImage} alt="Lee Jones coaching a small group at Joner Football" class="aspect-[4/3] w-full object-cover" loading="lazy" />
        </div>
      </div>

      <div class="border border-gray-800 bg-joner-gray p-6 sm:p-9">
        <p class="mb-3 font-heading text-xs font-bold uppercase tracking-[0.28em] text-joner-red">Before you apply</p>
        <h2 class="font-heading text-3xl font-black uppercase leading-tight text-white md:text-5xl">You must have</h2>
        <ul class="mt-8 space-y-4 font-body text-base leading-relaxed text-gray-200 md:text-lg">
          <li class="flex gap-4 border-t border-gray-700 pt-4"><span class="font-heading text-joner-red">01</span><span>Full coaching qualifications.</span></li>
          <li class="flex gap-4 border-t border-gray-700 pt-4"><span class="font-heading text-joner-red">02</span><span>Experience coaching both 1on1 and small group training.</span></li>
          <li class="flex gap-4 border-t border-gray-700 pt-4"><span class="font-heading text-joner-red">03</span><span>A full driving licence and your own car.</span></li>
          <li class="flex gap-4 border-t border-gray-700 pt-4"><span class="font-heading text-joner-red">04</span><span>A Working With Children Check.</span></li>
          <li class="flex gap-4 border-t border-gray-700 pt-4"><span class="font-heading text-joner-red">05</span><span>The ability to demonstrate football skills correctly. This is crucial.</span></li>
          <li class="flex gap-4 border-y border-gray-700 py-4"><span class="font-heading text-joner-red">06</span><span>A strong work ethic and real passion for developing players.</span></li>
        </ul>
        <p class="mt-7 font-body text-sm leading-relaxed text-gray-400">If you are looking to explore Sydney and become part of a growing coaching team, we want to hear from you.</p>
      </div>
    </div>
  </section>

  <section id="application" class="bg-white py-16 text-black md:py-24">
    <div class="mx-auto grid max-w-7xl gap-12 px-5 sm:px-8 lg:grid-cols-[0.75fr_1.25fr] lg:gap-20">
      <div>
        <p class="mb-4 font-heading text-xs font-bold uppercase tracking-[0.28em] text-joner-red">Application</p>
        <h2 class="font-heading text-5xl font-black uppercase leading-[0.92] md:text-7xl">Tell us<br />about you.</h2>
        <p class="mt-6 max-w-md font-body text-base leading-relaxed text-gray-600">Complete the form and attach your CV. We will use your details for this recruitment process only.</p>
      </div>

      <form id="coaching-application-form" class="space-y-5" novalidate>
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="block"><span class="field-label">Full name <b>*</b></span><input name="name" type="text" autocomplete="name" required class="field-input" /></label>
          <label class="block"><span class="field-label">Email <b>*</b></span><input name="email" type="email" autocomplete="email" required class="field-input" /></label>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="block"><span class="field-label">Phone <b>*</b></span><input name="phone" type="tel" autocomplete="tel" required class="field-input" /></label>
          <label class="block"><span class="field-label">Current location <b>*</b></span><input name="location" type="text" autocomplete="address-level2" required class="field-input" placeholder="City, country" /></label>
        </div>
        <label class="block"><span class="field-label">Qualifications <b>*</b></span><input name="qualifications" type="text" required class="field-input" placeholder="Your coaching qualifications" /></label>
        <label class="block"><span class="field-label">Coaching experience <b>*</b></span><textarea name="coachingExperience" required rows="5" class="field-input resize-y" placeholder="Tell us about your 1on1 and small group coaching experience"></textarea></label>
        <label class="block"><span class="field-label">Demo or coaching link <span class="normal-label">(optional)</span></span><input name="demoLink" type="url" class="field-input" placeholder="https://..." /></label>
        <label class="block"><span class="field-label">CV <b>*</b></span><input id="cvFile" name="cvFile" type="file" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" required class="file-input" /><span class="mt-2 block text-xs text-gray-500">PDF, DOC or DOCX. Maximum 5MB.</span></label>
        <label class="flex gap-3 border border-gray-200 p-4 font-body text-sm leading-relaxed text-gray-700"><input name="requirementsConfirmed" type="checkbox" value="true" required class="mt-1 h-4 w-4 shrink-0 accent-joner-red" /><span>I confirm that I meet the requirements listed above. <b>*</b></span></label>
        <label class="flex gap-3 border border-gray-200 p-4 font-body text-sm leading-relaxed text-gray-700"><input name="recruitmentConsent" type="checkbox" value="true" required class="mt-1 h-4 w-4 shrink-0 accent-joner-red" /><span>I consent to Joner Football using these details and my CV for recruitment purposes only. <b>*</b></span></label>
        <p id="application-status" class="hidden font-body text-sm" role="status" aria-live="polite"></p>
        <button type="submit" class="btn-red w-full sm:w-auto">Submit application</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .field-label { display:block; margin-bottom:.55rem; font-family:Arial,sans-serif; font-size:.72rem; font-weight:700; letter-spacing:.14em; text-transform:uppercase; color:#444; }
  .field-label b { color:#e8000d; }
  .normal-label { font-weight:400; letter-spacing:0; text-transform:none; color:#888; }
  .field-input { display:block; width:100%; border:1px solid #cfcfcf; background:#fafafa; padding:.85rem 1rem; font-family:Arial,sans-serif; font-size:1rem; color:#111; outline:none; }
  .field-input:focus { border-color:#e8000d; box-shadow:0 0 0 1px #e8000d; }
  .file-input { display:block; width:100%; border:1px dashed #aaa; background:#fafafa; padding:.85rem; font-family:Arial,sans-serif; font-size:.9rem; color:#333; }
  .file-input:focus { border-color:#e8000d; outline:1px solid #e8000d; }
</style>

<script is:inline>
  (function () {
    var form = document.getElementById('coaching-application-form');
    var status = document.getElementById('application-status');
    if (!form) return;
    function setStatus(message, ok) {
      status.textContent = message;
      status.className = message ? 'font-body text-sm ' + (ok ? 'text-green-700' : 'text-red-700') : 'hidden font-body text-sm';
    }
    form.addEventListener('submit', function (event) {
      event.preventDefault();
      setStatus('', false);
      if (!form.checkValidity()) { form.reportValidity(); return; }
      var file = form.querySelector('[name="cvFile"]').files[0];
      if (!file) { setStatus('Please attach your CV.', false); return; }
      if (file.size > 5 * 1024 * 1024) { setStatus('Your CV is larger than 5MB.', false); return; }
      var button = form.querySelector('button');
      var original = button.textContent;
      button.disabled = true;
      button.textContent = 'Sending...';
      var reader = new FileReader();
      reader.onload = function () {
        var data = new FormData(form);
        var payload = {};
        data.forEach(function (value, key) { if (!(value instanceof File)) payload[key] = value; });
        payload.enquiryType = 'coaching-role';
        payload.requirementsConfirmed = data.get('requirementsConfirmed') === 'true';
        payload.recruitmentConsent = data.get('recruitmentConsent') === 'true';
        payload.cvFile = { name: file.name, type: file.type, content: String(reader.result).split(',')[1] || '' };
        var token = window.JonerRecaptcha && window.JonerRecaptcha.getToken ? window.JonerRecaptcha.getToken('contact') : Promise.resolve('');
        Promise.resolve(token).then(function (recaptchaToken) {
          payload.recaptchaToken = recaptchaToken;
          return fetch('/api/contact-enquiry', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload) });
        }).then(function (response) { return response.json(); }).then(function (result) {
          if (!result || !result.success) throw new Error(result && result.error ? result.error : 'Application could not be sent.');
          form.reset();
          setStatus('Application received. Thank you.', true);
        }).catch(function (error) { setStatus(error.message || 'Application could not be sent. Please try again.', false); }).finally(function () { button.disabled = false; button.textContent = original; });
      };
      reader.onerror = function () { setStatus('Could not read your CV. Please try again.', false); button.disabled = false; button.textContent = original; };
      reader.readAsDataURL(file);
    });
  })();
</script>
