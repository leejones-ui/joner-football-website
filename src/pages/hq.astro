---
import BaseLayout from '../layouts/BaseLayout.astro'
import SEOFAQ from '../components/SEOFAQ.astro'
import GeoAnswers from '../components/GeoAnswers.astro'
import { faqSchema, webPageSchema, breadcrumbSchema } from '../lib/seoSchema'

const localBizSchema = {
  "@context": "https://schema.org",
  "@type": "SportsActivityLocation",
  "name": "Joner Football HQ",
  "description": "Indoor football training facility in Belrose, Sydney. Home of Joner Football Performance: JFP sessions, Joners Juniors, professional 1 on 1 training and camp events.",
  "image": "https://jonerfootball.com/images/hq/hq-hero-lee-exterior.webp",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Unit 2, 20 Narabang Way",
    "addressLocality": "Belrose",
    "addressRegion": "NSW",
    "postalCode": "2085",
    "addressCountry": "AU"
  },
  "telephone": "+61-426-885-924",
  "url": "https://jonerfootball.com/hq/",
  "parentOrganization": {
    "@type": "Organization",
    "@id": "https://jonerfootball.com/#organization",
    "name": "Joner Football"
  },
  "openingHours": "Mo-Sa",
  "priceRange": "$$"
}

const hqSEOFAQs = [
  { q: 'Where is the Joner Football HQ?', a: 'The HQ is at Unit 2, 20 Narabang Way, Belrose, in Sydney’s Northern Beaches area, with on-site parking for drop-off and collection.' },
  { q: 'Is the HQ indoor?', a: 'Yes. The HQ is a fully indoor facility with a professional standard synthetic surface, so sessions are never cancelled for weather.' },
  { q: 'What training runs at the HQ?', a: 'JFP afternoon sessions run Monday to Saturday, Joners Juniors runs Saturdays, professional 1 on 1 sessions run by appointment, and holiday camps and events run through the year.' },
  { q: 'Can parents watch sessions?', a: 'Yes. The HQ has a dedicated parent viewing area so you can watch your player train.' },
  { q: 'How do I book training at the HQ?', a: 'Send the contact form on this page with the player’s age and what you are looking for. The team replies with the right HQ training option.' },
]

const hqSchemas = [
  localBizSchema,
  webPageSchema({
    name: 'The Joner Football HQ | Belrose, Sydney',
    description: 'The Joner Football HQ. Brand new indoor training facility at 20 Narabang Way, Belrose, Sydney. Professional standard surface. All-weather training.',
    url: 'https://jonerfootball.com/hq/',
  }),
  breadcrumbSchema([
    { name: 'Home', url: 'https://jonerfootball.com/' },
    { name: 'Sydney Football Training', url: 'https://jonerfootball.com/training/' },
    { name: 'The HQ', url: 'https://jonerfootball.com/hq/' },
  ]),
  faqSchema(hqSEOFAQs),
]

const hqVideos = [
  { id: 'oVrMcXv6qZQ', title: 'Training Drills for Midfielders', label: 'Midfielder Session' },
  { id: 'eCmL9QiFtVk', title: 'Full 1 on 1 Soccer Training Session at Joner Football HQ', label: '1 on 1 Session' },
  { id: 'wbFlx3YV9fM', title: 'Blazepod Soccer Drills with a Pro Player', label: 'Pro Player Drills' },
  { id: 'A0rJxzjbWss', title: 'How I Train a Group of Beginners', label: 'Group Training' },
  { id: 'OgBcMesGvqw', title: 'How to Master Your First Touch', label: 'First Touch' },
  { id: 'ns7I4SzidyQ', title: 'Dribbling, Speed and Agility Drills in Tight Spaces', label: 'Tight Space Work' }
]

const features = [
  { icon: '⚽', title: 'Indoor Pitch', copy: 'Professional standard synthetic surface. Train in any weather.' },
  { icon: '☔', title: 'All Weather', copy: 'Fully indoor facility. Sessions never cancelled for weather.' },
  { icon: '👀', title: 'Parent Viewing', copy: 'Dedicated parent viewing area. Watch your player train.' },
  { icon: '🎽', title: 'Apparel Pickup', copy: 'Joner Apparel collection point. Order online, collect here.' },
  { icon: '🅿️', title: 'Parking', copy: 'On-site parking available for drop-off and collection.' },
  { icon: '🏆', title: 'Pro Standard', copy: 'The same facility used for professional player sessions.' }
]

const programs = [
  { title: 'JFP Afternoon Sessions', copy: 'Monday to Saturday. The flagship Joner Football Performance program.', href: '/training/jfp-program', cta: 'Learn More' },
  { title: 'Joners Juniors', copy: 'Saturdays. Entry-level program for young players starting their journey.', href: '/training/joners-juniors', cta: 'Learn More' },
  { title: 'Professional Sessions', copy: 'By appointment. 1-on-1 training for professional and elite players.', href: '/training/professional-training', cta: 'Enquire' },
  { title: 'Camp Events', copy: 'Holiday camps and intensive training events throughout the year.', href: '/camps', cta: 'View Camps' }
]

import SanityPageRenderer from '../components/sanity/SanityPageRenderer.astro'
import { fetchSanityPage } from '../lib/sanityPages'
import { shouldReplaceSanityPage } from '../lib/sanityPageUtils'

const sanityPage = await fetchSanityPage('hq')
---

{shouldReplaceSanityPage(sanityPage) ? (
  <SanityPageRenderer page={sanityPage} />
) : (
<BaseLayout
  title="The Joner Football HQ | Belrose, Sydney"
  description="The Joner Football HQ. Brand new indoor training facility at 20 Narabang Way, Belrose, Sydney. Professional standard surface. All-weather training."
  schema={hqSchemas}
>
  <section class="bg-joner-black pt-10 pb-12 md:pt-16 md:pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-black">
        <div class="spotlight spotlight-a" aria-hidden="true"></div>
        <div class="spotlight spotlight-b" aria-hidden="true"></div>
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(227,6,19,0.18),transparent_55%)] pointer-events-none"></div>
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,rgba(255,255,255,0.06),transparent_60%)] pointer-events-none"></div>

        <div class="relative z-10 flex flex-col lg:flex-row min-h-[560px] lg:min-h-[650px]">
          <div class="flex-1 px-6 py-10 sm:px-10 sm:py-14 lg:p-14 flex flex-col justify-center">
            <p class="text-joner-red font-heading text-xs sm:text-sm uppercase tracking-[0.25em] mb-4">Belrose, Sydney</p>
            <h1 class="font-heading text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold uppercase leading-[0.92] mb-6 bg-clip-text text-transparent bg-gradient-to-b from-white via-neutral-100 to-neutral-500">
              The Joner<br/>Football<br/>HQ
            </h1>
            <p class="text-neutral-300 font-body text-base sm:text-lg max-w-lg leading-relaxed mb-8">
              Brand new indoor training facility. Professional standard surface. All-weather training. The home of Joner Football Performance in Sydney.
            </p>
            <div class="flex flex-wrap gap-3">
              <a href="/training" class="btn-red text-sm">View Training Programs</a>
              <a href="#contact" class="btn-outline text-sm">Contact The HQ</a>
            </div>
          </div>

          <div class="relative flex-1 min-h-[420px] sm:min-h-[500px] lg:min-h-0">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_35%,rgba(255,255,255,0.16),transparent_55%)] pointer-events-none z-10"></div>
            <img
              src="/images/hq/hq-hero-lee-exterior.webp"
              alt="Lee Jones outside Joner Football HQ in Belrose, Sydney"
              class="absolute inset-0 w-full h-full object-cover object-center"
              loading="eager"
            />
            <div class="absolute inset-y-0 left-0 w-1/3 bg-gradient-to-r from-black via-black/60 to-transparent lg:block hidden pointer-events-none"></div>
            <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black via-black/45 to-transparent pointer-events-none"></div>
          </div>
        </div>

        <div class="relative z-10 grid grid-cols-2 md:grid-cols-4 border-t border-white/10 bg-black/45 backdrop-blur-sm">
          <div class="p-5 text-center border-r border-white/10">
            <div class="font-heading text-joner-red text-2xl md:text-3xl font-bold">Indoor</div>
            <div class="text-neutral-500 text-[10px] sm:text-xs font-body uppercase tracking-wider mt-1">All Weather</div>
          </div>
          <div class="p-5 text-center md:border-r border-white/10">
            <div class="font-heading text-white text-2xl md:text-3xl font-bold">Belrose</div>
            <div class="text-neutral-500 text-[10px] sm:text-xs font-body uppercase tracking-wider mt-1">Sydney HQ</div>
          </div>
          <div class="p-5 text-center border-r border-t md:border-t-0 border-white/10">
            <div class="font-heading text-white text-2xl md:text-3xl font-bold">JFP</div>
            <div class="text-neutral-500 text-[10px] sm:text-xs font-body uppercase tracking-wider mt-1">Player Pathway</div>
          </div>
          <div class="p-5 text-center border-t md:border-t-0 border-white/10">
            <div class="font-heading text-joner-red text-2xl md:text-3xl font-bold">Pro</div>
            <div class="text-neutral-500 text-[10px] sm:text-xs font-body uppercase tracking-wider mt-1">Training Standard</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-gradient-to-b from-joner-black via-joner-gray to-joner-black py-16 md:py-24 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(227,6,19,0.12),transparent_60%)] pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-12">
        <p class="text-joner-red font-heading text-sm uppercase tracking-widest mb-3">Inside The HQ</p>
        <h2 class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold text-white uppercase leading-tight">Watch The<br class="sm:hidden"/> Training</h2>
        <p class="text-neutral-400 font-body text-base md:text-lg max-w-2xl mx-auto mt-4">Pick a session from the HQ playlist and see how players train inside the facility.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
        <div class="lg:col-span-8">
          <div class="relative overflow-hidden rounded-xl border border-white/10 bg-black aspect-video shadow-2xl shadow-black/50">
            <iframe
              id="hq-video-frame"
              src={`https://www.youtube.com/embed/${hqVideos[0].id}`}
              title={hqVideos[0].title}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              class="absolute inset-0 w-full h-full"
            ></iframe>
          </div>
        </div>
        <div class="lg:col-span-4 space-y-3">
          {hqVideos.map((video, index) => (
            <button
              type="button"
              class={`hq-video-button ${index === 0 ? 'is-active' : ''}`}
              data-video-id={video.id}
              data-video-title={video.title}
            >
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{video.label}</strong>
            </button>
          ))}
          <a href="https://www.youtube.com/playlist?list=PLM3cVo2QYr-OSRsMVRkYFb89yPGzzL23x" target="_blank" rel="noopener" class="btn-outline text-sm w-full mt-5">Open Full Playlist</a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-joner-black py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="text-joner-red font-heading text-sm uppercase tracking-widest mb-3">The Facility</p>
        <h2 class="section-heading text-white mb-4">What's at The HQ</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {features.map((feature) => (
          <div class="rounded-xl border border-white/10 bg-white/[0.04] p-7 text-center hover:border-joner-red/60 transition-colors">
            <div class="text-4xl mb-4">{feature.icon}</div>
            <h3 class="font-heading text-white text-lg uppercase tracking-wide mb-2">{feature.title}</h3>
            <p class="text-neutral-400 text-sm font-body leading-relaxed">{feature.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-joner-black py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        <div class="lg:col-span-5">
          <div class="lg:sticky lg:top-24 space-y-4">
            <div class="relative overflow-hidden rounded-xl border border-white/10">
              <img src="/images/camps/joner-camps-pack/02_indoor_detail_v1_polished_blank_4x3.jpg" alt="Joner Football indoor training detail" class="w-full h-auto object-cover" loading="lazy" />
            </div>
            <div class="grid grid-cols-2 gap-3">
              <img src="/images/hq/hq-juniors-indoor-session.webp" alt="Young players training inside Joner Football HQ" class="w-full aspect-square object-cover rounded-lg border border-white/10" loading="lazy" />
              <img src="/images/home-mobile-story/mobile-story-07-hq-photo.webp" alt="Joner Football HQ training photo" class="w-full aspect-square object-cover rounded-lg border border-white/10" loading="lazy" />
            </div>
          </div>
        </div>

        <div class="lg:col-span-7">
          <div class="inline-block bg-joner-red px-3 py-1 font-heading text-xs uppercase tracking-widest text-white mb-4">Programs</div>
          <h2 class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold text-white uppercase mb-8 leading-tight">What Happens at The HQ</h2>
          <p class="text-neutral-300 font-body text-base md:text-lg leading-relaxed mb-8">
            The HQ is where Joner Football runs its Sydney pathway, junior sessions, professional training, camp events, and apparel collection. Simple setup, high standards, and no weather excuses.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {programs.map((program) => (
              <a href={program.href} class="hq-program-card">
                <h3>{program.title}</h3>
                <p>{program.copy}</p>
                <span>{program.cta}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="location" class="bg-gradient-to-b from-joner-black to-joner-gray py-16 md:py-24 scroll-mt-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-12 items-center">
        <div>
          <p class="text-joner-red font-heading text-sm uppercase tracking-widest mb-3">Location</p>
          <h2 class="section-heading text-white mb-6">Find Us</h2>

          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <span class="text-joner-red text-xl flex-shrink-0">📍</span>
              <div>
                <div class="font-heading text-white font-bold uppercase tracking-wide">Address</div>
                <div class="text-gray-400 font-body">Unit 2, 20 Narabang Way<br/>Belrose, NSW 2085</div>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <span class="text-joner-red text-xl flex-shrink-0">🚗</span>
              <div>
                <div class="font-heading text-white font-bold uppercase tracking-wide">Parking</div>
                <div class="text-gray-400 font-body">On-site parking available in front of the unit.</div>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <span class="text-joner-red text-xl flex-shrink-0">📞</span>
              <div>
                <div class="font-heading text-white font-bold uppercase tracking-wide">Contact</div>
                <div class="text-gray-400 font-body">
                  JFP: <a href="tel:0426885924" class="text-joner-red hover:underline">0426 885 924</a> (Dean)<br/>
                  Juniors: <a href="mailto:jonersjuniors@jonerfootball.com" class="text-joner-red hover:underline">jonersjuniors@jonerfootball.com</a>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href="https://maps.google.com/?q=20+Narabang+Way+Belrose" target="_blank" rel="noopener" class="btn-red text-sm">Open in Google Maps</a>
            <a href="#contact" class="btn-outline text-sm">Contact Us</a>
          </div>
        </div>

        <div class="rounded-xl border border-white/10 overflow-hidden bg-black">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3319.5!2d151.2164!3d-33.7394!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2s20+Narabang+Way+Belrose+NSW+2085!5e0!3m2!1sen!2sau"
            width="100%"
            height="430"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Joner Football HQ location at 20 Narabang Way, Belrose">
          </iframe>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="bg-joner-black py-16 md:py-24 scroll-mt-32">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <p class="text-joner-red font-heading text-sm uppercase tracking-widest mb-3">Start Training at The HQ</p>
        <h2 class="section-heading text-white mb-4">Contact Us</h2>
        <p class="mx-auto max-w-2xl font-body text-base leading-relaxed text-gray-400 md:text-lg">
          Tell us about the player and the team will come back with the right HQ training option.
        </p>
      </div>

      <form id="hq-contact-form" class="space-y-5 border border-white/10 bg-white/[0.04] p-5 md:p-8 rounded-xl">
        <input type="hidden" name="enquiryType" value="training-sydney" />
        <input type="hidden" name="trainingInterest" value="Joner Football HQ" />
        <input type="hidden" name="trainingLocation" value="HQ (Belrose)" />
        <input type="hidden" name="location" value="HQ (Belrose)" />

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <input type="text" name="name" placeholder="Parent or player name" required class="hq-input" />
          <input type="email" name="email" placeholder="Email address" required class="hq-input" />
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <input type="tel" name="phone" placeholder="Phone number" required class="hq-input" />
          <input type="text" name="playerName" placeholder="Player name" required class="hq-input" />
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <input type="text" name="playerAge" placeholder="Player age" required class="hq-input" />
          <input type="text" name="playerLevel" placeholder="Player level or team" class="hq-input" />
        </div>
        <textarea name="message" placeholder="What are you looking for at the HQ?" required rows="5" class="hq-input resize-none"></textarea>
        <label class="flex gap-3 border border-gray-800 bg-joner-black/60 p-4 font-body text-sm leading-relaxed text-gray-300 rounded-lg">
          <input type="checkbox" name="marketingOptIn" value="true" class="mt-1 h-4 w-4 shrink-0 accent-joner-red" />
          <span>Yes, send me Joner Football updates, offers, app news, camps, and training tips by email.</span>
        </label>
        <p id="hq-contact-status" class="hidden font-body text-sm"></p>
        <button type="submit" class="btn-red w-full text-sm">Send HQ Enquiry</button>
      </form>
    </div>
  </section>

  <GeoAnswers
    title="The HQ, explained fast."
    intro="The short version for parents looking at indoor football training in Sydney."
    blocks={[
      {
        heading: 'Who this is for',
        body: 'Sydney players and parents who want consistent, coach-led technical training in a proper indoor facility, from juniors starting out to professionals booking 1 on 1 work.',
      },
      {
        heading: 'What you get',
        body: 'A professional standard indoor surface in Belrose, all-weather sessions that never get cancelled, a parent viewing area, on-site parking and the full Joner Football Performance program calendar.',
      },
      {
        heading: 'Why it works',
        body: 'Indoor means no lost weeks to rain and no wasted sessions. The same standards Lee Jones shows millions online are coached in person, week after week, on the same floor.',
      },
      {
        heading: 'Best next step',
        body: 'Send the HQ enquiry form with your player’s age and goals, or look at the training pathways first to see which program fits.',
      },
    ]}
    links={[
      { label: 'Sydney training pathways', href: '/training' },
      { label: 'JFP Program', href: '/training/jfp-program' },
      { label: 'Sydney camp', href: '/camps/sydney-july-2026' },
      { label: 'The football training app', href: '/app' },
    ]}
  />

  <SEOFAQ
    title="Questions about The HQ."
    items={hqSEOFAQs}
  />

  <script is:inline>
    (function () {
      var frame = document.getElementById('hq-video-frame');
      var buttons = Array.prototype.slice.call(document.querySelectorAll('.hq-video-button'));
      buttons.forEach(function (button) {
        button.addEventListener('click', function () {
          var id = button.getAttribute('data-video-id');
          var title = button.getAttribute('data-video-title') || 'Joner Football HQ video';
          if (!id || !frame) return;
          frame.src = 'https://www.youtube.com/embed/' + encodeURIComponent(id) + '?autoplay=1';
          frame.title = title;
          buttons.forEach(function (item) { item.classList.remove('is-active'); });
          button.classList.add('is-active');
        });
      });

      var form = document.getElementById('hq-contact-form');
      var status = document.getElementById('hq-contact-status');
      if (!form) return;
      var submit = form.querySelector('button[type="submit"]');

      function setStatus(message, ok) {
        if (!status) return;
        status.textContent = message || '';
        status.className = message ? 'font-body text-sm ' + (ok ? 'text-green-400' : 'text-amber-400') : 'hidden font-body text-sm';
      }

      form.addEventListener('submit', function (event) {
        event.preventDefault();
        setStatus('', true);
        var originalText = submit ? submit.textContent : 'Send HQ Enquiry';
        var formData = new FormData(form);
        var emailInput = form.querySelector('input[name="email"]');

        if (window.JonerEmailGuard && emailInput) {
          var validation = window.JonerEmailGuard.validateEmail(formData.get('email'));
          window.JonerEmailGuard.setFeedback(emailInput, validation);
          if (!validation.valid) {
            emailInput.reportValidity();
            return;
          }
        }

        var payload = {};
        formData.forEach(function (value, key) { payload[key] = value; });
        payload.marketingOptIn = formData.get('marketingOptIn') === 'true';

        if (submit) {
          submit.disabled = true;
          submit.textContent = 'Sending...';
          submit.classList.add('opacity-70', 'cursor-not-allowed');
        }

        var tokenPromise = window.JonerRecaptcha && window.JonerRecaptcha.getToken
          ? window.JonerRecaptcha.getToken('contact')
          : Promise.resolve('');

        tokenPromise.then(function (token) {
          payload.recaptchaToken = token;
          return fetch('/api/contact-enquiry', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
        })
        .then(function (response) { return response.json(); })
        .then(function (data) {
          if (!data || !data.success) throw new Error((data && data.error) || 'Could not send enquiry.');
          form.reset();
          setStatus('Done. Your HQ enquiry has been sent.', true);
        })
        .catch(function (error) {
          setStatus(error && error.message ? error.message : 'Could not send enquiry. Please try again.', false);
        })
        .finally(function () {
          if (submit) {
            submit.disabled = false;
            submit.textContent = originalText;
            submit.classList.remove('opacity-70', 'cursor-not-allowed');
          }
        });
      });
    })();
  </script>

  <style>
