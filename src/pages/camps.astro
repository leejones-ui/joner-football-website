---
import BaseLayout from '../layouts/BaseLayout.astro'
import SEOFAQ from '../components/SEOFAQ.astro'
import GeoAnswers from '../components/GeoAnswers.astro'
import { faqSchema, webPageSchema, breadcrumbSchema } from '../lib/seoSchema'

const campSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: 'Joner Football Sydney July Camp',
    startDate: '2026-07-14',
    endDate: '2026-07-16',
    location: {
      '@type': 'Place',
      name: 'Rydalmere Park',
      address: { '@type': 'PostalAddress', addressLocality: 'Sydney', addressRegion: 'NSW', addressCountry: 'AU' },
    },
    organizer: { '@type': 'Organization', name: 'Joner Football' },
  },
]


const campSEOFAQs = [
  { q: 'Where are Joner Football camps held?', a: 'Joner Football camps run in selected USA, Australia and global locations, with current camp pages showing dates, venues and registration details.' },
  { q: 'Which Joner Football camps are running in 2026?', a: 'Current listed 2026 camps include Sydney in Australia. Each camp page shows the exact dates, venue and registration status.' },
  { q: 'What age are the camps for?', a: 'Most Joner Football camps are built for motivated young players who want to improve technique, confidence and game impact in a high-energy coaching environment.' },
  { q: 'What do players work on at camp?', a: 'Players work on technical detail, ball mastery, attacking skills, confidence, decision-making and the standards Lee Jones expects in high-level football training.' },
  { q: 'How do I register for a Joner Football camp?', a: 'Open the camp page for your city and follow the registration steps. Spots are limited and camps regularly sell out, so register early.' },
]

const campsPageSchemas = [
  ...campSchemas,
  webPageSchema({
    name: 'Elite Football Camps | USA & Australia | Joner Football',
    description: 'Train at Joner Football camps in the USA, Australia and worldwide. Improve technique, confidence and game impact with elite coach-led sessions.',
    url: 'https://jonerfootball.com/camps/',
  }),
  breadcrumbSchema([
    { name: 'Home', url: 'https://jonerfootball.com/' },
    { name: 'Football Camps', url: 'https://jonerfootball.com/camps/' },
  ]),
  faqSchema(campSEOFAQs),
]

const camps = [
  {
    label: 'SYD',
    title: 'Sydney',
    subtitle: 'Biggest of the year!',
    location: 'Rydalmere Park, NSW',
    dates: 'July 14 to 16, 2026',
    href: '/camps/sydney-july-2026',
    image: '/images/camps/sydney-2026/photos/rydalmere-camp-running.jpg',
    alt: 'Joner Football Sydney camp players training at Rydalmere Park',
    badge: 'Register now',
    circleImage: '/images/camps/destination-circles/syd-opera.jpg',
  },
]

const testimonials = [
  {
    image: '/images/camps/hub/testimonial-parent-california.webp',
    alt: 'Parent testimonial saying the coaches went above and beyond at a Joner Football camp',
  },
  {
    image: '/images/camps/dallas-2026/testimonials/t1.webp',
    alt: 'Joner Football camp parent testimonial',
  },
  {
    image: '/images/camps/dallas-2026/testimonials/t2.webp',
    alt: 'Joner Football camp parent testimonial from California',
  },
  {
    image: '/images/camps/houston-2026/testimonials/t3.webp',
    alt: 'Joner Football camp family testimonial',
  },
]

import SanityPageRenderer from '../components/sanity/SanityPageRenderer.astro'
import { fetchSanityPage } from '../lib/sanityPages'
import { shouldReplaceSanityPage } from '../lib/sanityPageUtils'

const sanityPage = await fetchSanityPage('camps')
---

{shouldReplaceSanityPage(sanityPage) ? (
  <SanityPageRenderer page={sanityPage} />
) : (
<BaseLayout
  title="Elite Football Camps | USA & Australia | Joner Football"
  description="Train at Joner Football camps in the USA, Australia and worldwide. Improve technique, confidence and game impact with elite coach-led sessions."
  schema={campsPageSchemas}
>
  <main class="bg-joner-black text-white overflow-hidden">
    <section class="relative min-h-[calc(100vh-80px)] flex items-center py-14 sm:py-18 lg:py-20">
      <div class="absolute inset-0">
        <img src="/images/camps/hub/camps-hero-lee-coaching.webp" alt="Lee Jones coaching players at a Joner Football camp" class="h-full w-full object-contain object-center" />
      </div>
      <div class="absolute inset-0 bg-gradient-to-b from-joner-black/70 via-joner-black/42 to-joner-black/82 lg:bg-gradient-to-r lg:from-joner-black/82 lg:via-joner-black/48 lg:to-joner-black/22"></div>
      <div class="absolute left-0 top-0 h-full w-1 bg-joner-red"></div>

      <div class="relative z-10 mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-10 px-4 sm:px-6 lg:grid-cols-[0.95fr_1.05fr] lg:px-8">
        <div class="max-w-2xl">
          <p class="mb-4 font-heading text-sm uppercase tracking-[0.28em] text-joner-red">Joner Football Camps</p>
          <h1 class="mb-5 font-heading text-5xl font-bold uppercase leading-[0.92] tracking-wide text-white sm:text-6xl lg:text-7xl">
            Choose Your Camp
          </h1>
          <p class="max-w-xl font-body text-base leading-relaxed text-gray-300 sm:text-lg">
            Pick the destination you need. Each camp page has dates, location, booking details, and everything parents need before registering.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#camp-destinations" class="btn-red text-sm">View Destinations</a>
          </div>
        </div>

        <div class="camp-orbit mx-auto" aria-label="Joner Football camp destination wheel">
          <div class="camp-orbit__ring" aria-hidden="true"></div>
          <div class="camp-orbit__spin">
            {camps.map((camp, index) => {
              const angle = `${(360 / camps.length) * index}deg`
              const counterAngle = `${(-360 / camps.length) * index}deg`
              return (
              <a
                href={camp.href}
                class={`camp-orbit__node camp-orbit__node--${index + 1}`}
                style={`--orbit-angle: ${angle}; --orbit-counter-angle: ${counterAngle};`}
                aria-label={`Open ${camp.title} camp page`}
              >
                <span class="camp-orbit__node-content">
                  <img src={camp.circleImage} alt="" aria-hidden="true" class="camp-orbit__node-photo" loading="lazy" />
                  <span class="camp-orbit__node-label">{camp.label}</span>
                  <span class="camp-orbit__tooltip">{camp.title}<small>{camp.subtitle}</small></span>
                </span>
              </a>
              )
            })}
          </div>
          <div class="camp-orbit__center">
            <img src="/images/joner-logo-white.png" alt="Joner Football" />
          </div>
        </div>
      </div>
    </section>

    <section id="camp-destinations" class="border-y border-white/10 bg-joner-gray py-12 sm:py-16 scroll-mt-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
          <h2 class="font-heading text-3xl uppercase tracking-wide text-white sm:text-4xl">Camp Destinations</h2>
        </div>

        <div class="camp-destination-grid grid grid-cols-1 gap-5 md:grid-cols-2">
          {camps.map((camp) => (
            <a href={camp.href} class="camp-card group" aria-label={`View ${camp.title} camp details`}>
              <div class="relative h-56 overflow-hidden bg-joner-black">
                <img src={camp.image} alt={camp.alt} loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
                <div class="absolute inset-0 bg-joner-black/34"></div>
                <div class="absolute left-0 right-0 top-0 bg-joner-red px-4 py-2 text-center font-heading text-xs uppercase tracking-[0.18em] text-white">
                  Limited spots
                </div>
              </div>
              <div class="p-5">
                <p class="mb-2 font-heading text-xs uppercase tracking-[0.22em] text-joner-red">{camp.dates}</p>
                <h3 class="font-heading text-3xl uppercase tracking-wide text-white group-hover:text-joner-red">{camp.title}</h3>
                <p class="mt-1 font-heading text-sm uppercase tracking-[0.16em] text-gray-300">{camp.subtitle}</p>
                <p class="mt-4 text-sm text-gray-400">{camp.location}</p>
                <span class="mt-5 inline-flex items-center font-heading text-sm uppercase tracking-[0.14em] text-white">
                  {camp.badge}
                  <span class="ml-2 text-joner-red transition group-hover:translate-x-1">→</span>
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-joner-black py-12 sm:py-16" aria-labelledby="camp-testimonials-heading">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-7">
          <p class="mb-2 font-heading text-xs uppercase tracking-[0.25em] text-joner-red">Testimonials</p>
          <h2 id="camp-testimonials-heading" class="font-heading text-3xl uppercase tracking-wide text-white sm:text-4xl">
            What Parents Say
          </h2>
        </div>

        <div class="testimonial-rail" aria-label="Joner Football camp parent testimonials">
          {testimonials.map((testimonial) => (
            <figure class="testimonial-slide">
              <img src={testimonial.image} alt={testimonial.alt} loading="lazy" />
            </figure>
          ))}
        </div>
      </div>
    </section>

  </main>

  <GeoAnswers
    title="Joner Football camps, explained fast."
    intro="The short version for parents weighing up a football camp in the USA or Australia."
    blocks={[
      {
        heading: 'Who this is for',
        body: 'Young players who want to train at a higher standard for a few days, and parents looking for a football camp in the USA or Australia run by coaches who actually teach technique.',
      },
      {
        heading: 'What you get',
        body: 'Multiple days of coach-led sessions with Lee Jones and the Joner Football team: ball mastery, striking, 1v1 work, attacking detail and the energy the brand is known for worldwide.',
      },
      {
        heading: 'Why it works',
        body: 'Players hear the same coaching points millions watch online, but live, with corrections on the spot. The standard resets what players think a good session looks like.',
      },
      {
        heading: 'Best next step',
        body: 'Pick the camp closest to you, open the camp page and register. Spots are limited and camps sell out. Between camps, players keep improving with the Joner Football App.',
      },
    ]}
    links={[
      { label: 'Sydney camp', href: '/camps/sydney-july-2026' },
      { label: 'The football training app', href: '/app' },
    ]}
  />

  <SEOFAQ
    title="Questions about Joner Football camps."
    intro="For parents and players deciding if a camp is the right next step."
    items={campSEOFAQs}
  />

  <style>
    @keyframes camp-orbit-spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    @keyframes camp-orbit-counter {
      from { transform: rotate(0deg); }
      to { transform: rotate(-360deg); }
    }

    .camp-orbit {
      position: relative;
      width: min(78vw, 520px);
      aspect-ratio: 1;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.16);
      background: rgba(26,26,26,0.84);
      box-shadow: 0 28px 80px rgba(0,0,0,0.5), inset 0 0 0 1px rgba(227,6,19,0.24);
    }

    .camp-orbit__ring {
      position: absolute;
      inset: 13%;
      border-radius: 999px;
      border: 1px dashed rgba(255,255,255,0.22);
    }

    .camp-orbit__spin {
      position: absolute;
      inset: 0;
      animation: camp-orbit-spin 24s linear infinite;
    }

    .camp-orbit:hover .camp-orbit__spin {
      animation-play-state: paused;
    }

    .camp-orbit__node {
      position: absolute;
      left: calc(50% - 49px);
      top: calc(50% - 49px);
      display: flex;
      width: 98px;
      height: 98px;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      border: 2px solid rgba(255,255,255,0.72);
      background: #0A0A0A;
      color: #fff;
      overflow: visible;
      font-family: Anton, Impact, sans-serif;
      font-size: 0.98rem;
      letter-spacing: 0.08em;
      text-decoration: none;
      box-shadow: 0 14px 34px rgba(0,0,0,0.45);
      transition: background 160ms ease;
    }

    .camp-orbit__node-content {
      position: relative;
      display: flex;
      width: 100%;
      height: 100%;
      align-items: center;
      justify-content: center;
      overflow: visible;
      border-radius: inherit;
      animation: camp-orbit-counter 24s linear infinite;
    }

    .camp-orbit:hover .camp-orbit__node-content {
      animation-play-state: paused;
    }

    .camp-orbit__node-photo {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0.56;
      filter: grayscale(0.16) contrast(1.1) brightness(0.82);
      transition: opacity 160ms ease, filter 160ms ease, transform 160ms ease;
      border-radius: inherit;
    }

    .camp-orbit__node-label {
      position: relative;
      z-index: 2;
      max-width: 86px;
      text-align: center;
      line-height: 0.88;
      text-shadow: 0 2px 10px rgba(0,0,0,0.9);
    }

    .camp-orbit__node:hover .camp-orbit__node-photo,
    .camp-orbit__node:focus-visible .camp-orbit__node-photo {
      opacity: 0.72;
      filter: grayscale(0.05) contrast(1.16) brightness(0.86);
      transform: scale(1.08);
    }

    .camp-orbit__tooltip {
      pointer-events: none;
      position: absolute;
      left: 50%;
      top: calc(100% + 14px);
      z-index: 20;
      width: max-content;
      max-width: 190px;
      transform: translateX(-50%) translateY(6px);
      border: 1px solid rgba(255,255,255,0.2);
      background: rgba(10,10,10,0.95);
      color: #FFFFFF;
      opacity: 0;
      padding: 0.7rem 0.8rem;
      text-align: center;
      font-family: Anton, Impact, sans-serif;
      font-size: 0.9rem;
      letter-spacing: 0.08em;
      line-height: 1.05;
      text-transform: uppercase;
      transition: opacity 160ms ease, transform 160ms ease;
      box-shadow: 0 16px 34px rgba(0,0,0,0.42);
    }

    .camp-orbit__tooltip small {
      display: block;
      margin-top: 0.3rem;
      color: #E30613;
      font-size: 0.65rem;
      letter-spacing: 0.12em;
    }

    .camp-orbit__node:hover .camp-orbit__tooltip,
    .camp-orbit__node:focus-visible .camp-orbit__tooltip {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    .camp-orbit__node--4 .camp-orbit__tooltip {
      top: auto;
      bottom: calc(100% + 14px);
    }

    .camp-orbit__node:hover,
    .camp-orbit__node:focus-visible {
      background: #fff;
      color: #E30613;
      z-index: 50;
    }

    .camp-orbit__node {
      transform: rotate(var(--orbit-angle)) translateX(min(31vw, 202px)) rotate(var(--orbit-counter-angle));
    }

    .camp-orbit__center {
      position: absolute;
      z-index: 1;
      inset: 30%;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      border: 4px solid rgba(227,6,19,0.82);
      background: #0A0A0A;
      text-align: center;
      box-shadow: inset 0 0 30px rgba(255,255,255,0.05), 0 18px 50px rgba(0,0,0,0.42);
    }

    .camp-orbit__center img {
      width: 84%;
      height: 84%;
      object-fit: contain;
      margin: 0;
      display: block;
    }

    .camp-card {
      display: block;
      overflow: hidden;
      border: 1px solid rgba(255,255,255,0.12);
      background: #0A0A0A;
      text-decoration: none;
      transition: border-color 160ms ease, transform 160ms ease;
    }

    .camp-card:hover {
      border-color: #E30613;
      transform: translateY(-3px);
    }


    .testimonial-rail {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: minmax(84%, 1fr);
      gap: 1rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      padding: 0 0 0.65rem;
      scrollbar-width: thin;
      scrollbar-color: #E30613 rgba(255,255,255,0.12);
    }

    .testimonial-slide {
      scroll-snap-align: start;
      overflow: hidden;
      border: 1px solid rgba(255,255,255,0.12);
      background: #0A0A0A;
      box-shadow: 0 20px 52px rgba(0,0,0,0.34);
    }

    .testimonial-slide img {
      display: block;
      width: 100%;
      height: auto;
      object-fit: contain;
    }

    @media (min-width: 768px) {
      .testimonial-rail {
        grid-auto-columns: minmax(520px, 66%);
        gap: 1.25rem;
      }
    }

    @media (min-width: 1180px) {
      .testimonial-rail {
        grid-auto-columns: minmax(620px, 58%);
      }
    }

    @media (max-width: 640px) {
      .camp-orbit {
        width: min(82vw, 340px);
        margin-top: 0.25rem;
      }
      .camp-orbit__node {
        left: calc(50% - 36px);
        top: calc(50% - 36px);
        width: 72px;
        height: 72px;
        font-size: 0.72rem;
      }
      .camp-orbit__node {
        transform: rotate(var(--orbit-angle)) translateX(min(31vw, 126px)) rotate(var(--orbit-counter-angle));
      }
      .camp-orbit__node-label {
        max-width: 64px;
      }
      .camp-destination-grid {
        display: flex;
        gap: 0.9rem;
        overflow-x: auto;
        margin-inline: calc(50% - 50vw);
        padding: 0 1rem 0.5rem;
        scroll-padding-inline: 1rem;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior-x: contain;
        scrollbar-width: none;
      }

      .camp-destination-grid::-webkit-scrollbar {
        display: none;
      }

      .camp-destination-grid .camp-card {
        flex: 0 0 88vw;
        scroll-snap-align: center;
        scroll-snap-stop: always;
      }

      .camp-orbit__tooltip {
        display: none;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .camp-orbit__spin,
      .camp-orbit__node-content {
        animation: none;
      }
    }
  </style>
</BaseLayout>
)}
