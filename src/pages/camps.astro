---
import BaseLayout from '../layouts/BaseLayout.astro'
import SEOFAQ from '../components/SEOFAQ.astro'
import GeoAnswers from '../components/GeoAnswers.astro'
import { faqSchema, webPageSchema, breadcrumbSchema } from '../lib/seoSchema'


const campSEOFAQs = [
  { q: 'Are any Joner Football camps currently available?', a: 'No. There are no further Joner Football camps scheduled for the rest of 2026.' },
  { q: 'When will new Joner Football camps be announced?', a: 'Future camp dates and destinations will be published here when they are confirmed.' },
  { q: 'What age are the camps for?', a: 'Most Joner Football camps are built for motivated young players who want to improve technique, confidence and game impact in a high-energy coaching environment.' },
  { q: 'What do players work on at camp?', a: 'Players work on technical detail, ball mastery, attacking skills, confidence, decision-making and the standards Lee Jones expects in high-level football training.' },
  { q: 'How can players train with Joner Football between camps?', a: 'Players can train with Joner Football through the app, with structured sessions designed to improve technique, confidence and game impact.' },
]

const campsPageSchemas = [
  webPageSchema({
    name: 'Football Camps | Joner Football',
    description: 'There are no further Joner Football camps scheduled for 2026. Future camp dates and destinations will be announced here.',
    url: 'https://jonerfootball.com/camps/',
  }),
  breadcrumbSchema([
    { name: 'Home', url: 'https://jonerfootball.com/' },
    { name: 'Football Camps', url: 'https://jonerfootball.com/camps/' },
  ]),
  faqSchema(campSEOFAQs),
]

const testimonials = [
  {
    image: '/images/camps/hub/testimonial-parent-california.webp',
    alt: 'Parent testimonial saying the coaches went above and beyond at a Joner Football camp',
  },
  {
    image: '/images/camps/dallas-2026/testimonials/t1.webp',
    alt: 'Joner Football camp parent testimonial',
  },
  {
    image: '/images/camps/dallas-2026/testimonials/t2.webp',
    alt: 'Joner Football camp parent testimonial from California',
  },
  {
    image: '/images/camps/houston-2026/testimonials/t3.webp',
    alt: 'Joner Football camp family testimonial',
  },
]

import SanityPageRenderer from '../components/sanity/SanityPageRenderer.astro'
import { fetchSanityPage } from '../lib/sanityPages'
import { shouldReplaceSanityPage } from '../lib/sanityPageUtils'

const sanityPage = await fetchSanityPage('camps')
---

{shouldReplaceSanityPage(sanityPage) ? (
  <SanityPageRenderer page={sanityPage} />
) : (
<BaseLayout
  title="Football Camps | Joner Football"
  description="There are no further Joner Football camps scheduled for 2026. Future camp dates and destinations will be announced here."
  schema={campsPageSchemas}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/camps/hub/camps-hero-lee-coaching.webp" fetchpriority="high" />
  </Fragment>

  <main class="cp-page">
    <section class="cp-hero">
      <img class="cp-hero-img" src="/images/camps/hub/camps-hero-lee-coaching.webp" alt="Lee Jones coaching players at a Joner Football camp" fetchpriority="high" />
      <div class="cp-hero-shade" aria-hidden="true"></div>
      <div class="cp-wrap cp-hero-content">
        <p class="cp-eyebrow">Joner Football Camps</p>
        <h1 class="cp-h1">No upcoming <span class="cp-hook">camps.</span></h1>
        <p class="cp-hero-sub">There are no further Joner Football camps scheduled for the rest of 2026. Future dates and destinations will be announced here when they are confirmed.</p>
        <div class="cp-hero-cta">
          <a href="/join" class="btn-red">Train With The App</a>
        </div>
        <p class="cp-hero-note"><span class="cp-dot" aria-hidden="true"></span>2026 camp calendar: season complete.</p>
      </div>
    </section>

    <section id="camp-destinations" class="cp-status scroll-mt-24">
      <div class="cp-wrap cp-status-layout">
        <div>
          <p class="cp-kicker">2026 camp calendar</p>
          <h2 class="cp-h2">2026 camps complete.</h2>
          <p class="cp-lead">There are no camp registrations open for the remainder of the year.</p>
        </div>
        <div class="cp-keep">
          <h3>Want to keep improving?</h3>
          <p>Use the Joner Football App for structured training sessions you can follow anywhere.</p>
          <a href="/join" class="btn-red">View App Plans</a>
        </div>
      </div>
    </section>

    <section class="cp-reviews" aria-labelledby="camp-testimonials-heading">
      <div class="cp-wrap">
        <p class="cp-kicker">Testimonials</p>
        <h2 id="camp-testimonials-heading" class="cp-h2">What parents say.</h2>
        <div class="cp-rail" aria-label="Joner Football camp parent testimonials">
          {testimonials.map((testimonial) => (
            <figure class="cp-slide">
              <img src={testimonial.image} alt={testimonial.alt} loading="lazy" />
            </figure>
          ))}
        </div>
      </div>
    </section>
  </main>

  <GeoAnswers
    title="Joner Football camps, explained fast."
    intro="The short version for parents weighing up a football camp in the USA or Australia."
    blocks={[
      {
        heading: 'Who this is for',
        body: 'Young players who want to train at a higher standard for a few days, and parents looking for a football camp in the USA or Australia run by coaches who actually teach technique.',
      },
      {
        heading: 'What you get',
        body: 'Multiple days of coach-led sessions with Lee Jones and the Joner Football team: ball mastery, striking, 1v1 work, attacking detail and the energy the brand is known for worldwide.',
      },
      {
        heading: 'Why it works',
        body: 'Players hear the same coaching points millions watch online, but live, with corrections on the spot. The standard resets what players think a good session looks like.',
      },
      {
        heading: 'Best next step',
        body: 'There are no further camps scheduled for 2026. Between camp seasons, players can keep improving with structured Joner Football App sessions.',
      },
    ]}
    links={[
      { label: 'The football training app', href: '/app' },
    ]}
  />

  <SEOFAQ
    title="Questions about Joner Football camps."
    intro="For parents and players deciding if a camp is the right next step."
    items={campSEOFAQs}
  />

  <style>
    .cp-page { --jf-red: #E8000D; --font-display: var(--font-heading, Anton, Impact, sans-serif); background: #000; color: #fff; overflow: hidden; }
    .cp-wrap { width: min(1120px, calc(100% - 32px)); margin: 0 auto; }
    .cp-kicker, .cp-eyebrow { margin: 0 0 12px; font-family: var(--font-display); font-style: italic; font-weight: 600; font-size: 13px; letter-spacing: .2em; text-transform: uppercase; color: var(--jf-red); }
    .cp-eyebrow { color: #fff; }
    .cp-h2 { margin: 0; font-family: var(--font-display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: clamp(2.1rem, 5vw, 3.4rem); line-height: 1; }

    .cp-hero { position: relative; min-height: 80dvh; display: flex; align-items: flex-end; padding: 120px 0 56px; }
    .cp-hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 55% 25%; }
    .cp-hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.25) 0%, rgba(0,0,0,.2) 40%, rgba(0,0,0,.9) 100%), linear-gradient(90deg, rgba(0,0,0,.75), rgba(0,0,0,0) 70%); }
    .cp-hero-content { position: relative; }
    .cp-h1 { margin: 14px 0 0; max-width: 900px; font-family: var(--font-display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: clamp(2.8rem, 9vw, 6.4rem); line-height: .92; }
    .cp-hook { display: block; color: var(--jf-red); }
    .cp-hero-sub { margin: 22px 0 0; max-width: 560px; font-size: 18px; line-height: 1.55; color: rgba(255,255,255,.88); }
    .cp-hero-cta { margin-top: 30px; }
    .cp-hero-cta .btn-red { min-width: 220px; min-height: 52px; display: inline-flex; align-items: center; justify-content: center; }
    .cp-hero-note { display: flex; align-items: center; gap: 10px; margin: 18px 0 0; font-size: 15px; font-weight: 600; color: #fff; }
    .cp-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--jf-red); flex: none; }

    .cp-status { background: #fff; color: #000; padding: 76px 0; }
    .cp-status-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: center; }
    .cp-lead { margin: 18px 0 0; max-width: 460px; color: rgba(0,0,0,.68); line-height: 1.6; font-size: 17px; }
    .cp-keep { padding: 28px; border: 1px solid rgba(0,0,0,.12); border-left: 3px solid var(--jf-red); }
    .cp-keep h3 { margin: 0; font-family: var(--font-display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: 1.6rem; line-height: 1.05; }
    .cp-keep p { margin: 10px 0 22px; color: rgba(0,0,0,.68); line-height: 1.6; }
    .cp-keep .btn-red { min-height: 50px; padding: 0 26px; display: inline-flex; align-items: center; justify-content: center; }

    .cp-reviews { padding: 80px 0; background: #0a0a0a; }
    .cp-rail { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-top: 32px; }
    .cp-slide { margin: 0; overflow: hidden; border: 1px solid rgba(255,255,255,.12); background: #000; }
    .cp-slide img { display: block; width: 100%; height: auto; }

    @media (max-width: 900px) {
      .cp-status-layout { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    }
    @media (max-width: 640px) {
      .cp-hero { min-height: 78dvh; padding: 100px 0 40px; }
      .cp-hero-sub { font-size: 16px; }
      .cp-hero-cta .btn-red, .cp-keep .btn-red { width: 100%; }
      .cp-status, .cp-reviews { padding: 56px 0; }
      .cp-keep { padding: 20px; }
      .cp-rail { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 12px; margin: 24px -16px 0; padding: 0 16px 6px; scrollbar-width: none; }
      .cp-rail::-webkit-scrollbar { display: none; }
      .cp-slide { flex: 0 0 88%; scroll-snap-align: center; }
    }
  </style>
</BaseLayout>
)}
