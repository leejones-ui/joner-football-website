---
import BaseLayout from '../../layouts/BaseLayout.astro'
import '../../styles/jfp.css'
---

<BaseLayout title="Booked | Joner Football Performance" description="Your JFP term place is booked." canonical="https://jonerfootball.com/jfp-booking/success/" noindex noTracking hideChrome hideMobileAppCta>
  <div class="jfp" id="jfp-ok">
    <header class="j-top">
      <div class="wrap">
        <a class="j-brand" href="/"><img src="/images/joner-logo-white.png" alt="" width="30" height="30"><span>Joner Football<small>Performance Program</small></span></a>
        <div class="j-top-links"><a class="j-btn j-btn-line j-btn-sm" href="/jfp-account/">My JFP</a></div>
      </div>
    </header>
    <div class="wrap" style="max-width:640px;padding-top:28px;padding-bottom:60px">
      <p class="j-kicker" id="eyebrow">Confirming payment</p>
      <h1 id="heading" style="margin:6px 0 10px">One moment</h1>
      <p class="muted" id="lead">We are checking your payment with Stripe.</p>
      <div class="j-card" id="kit" style="padding:20px;margin-top:20px;border-color:#111827" hidden>
        <p class="j-kicker">Next step</p>
        <h2 style="margin:4px 0 6px">Get the training kit</h2>
        <p class="muted" id="kit-note"></p>
        <a class="j-btn j-btn-dark j-btn-lg" id="kit-go" href="#" target="_blank" rel="noopener noreferrer" style="margin-top:14px">Get the training kit</a>
      </div>
      <div class="j-card" id="card" style="padding:20px;margin-top:20px" hidden>
        <dl class="j-kv" id="details"></dl>
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:18px">
          <a class="j-btn j-btn-dark" id="calendar" href="#" download="jfp-term.ics">Add all dates to calendar</a>
          <a class="j-btn j-btn-line" id="maps" href="#" target="_blank" rel="noopener noreferrer" hidden>Open in Maps</a>
          <a class="j-btn j-btn-line" href="/jfp-account/">Open My JFP</a>
        </div>
      </div>
      <div class="j-box j-box-grey" id="help" style="margin-top:20px" hidden>If you paid and this page does not update, do not pay again. Email <a href="mailto:leejones@jonerfootball.com">leejones@jonerfootball.com</a> and we will sort it. <a href="/jfp-booking/">Back to groups</a>.</div>
    </div>
  </div>
</BaseLayout>

<script>
  import { $, esc } from '../../scripts/jfp-common.js'

  const q = new URLSearchParams(location.search)
  const sid = q.get('session_id') || ''
  let tries = 0
  const hero = (e, h, l) => { $('eyebrow').textContent = e; $('heading').textContent = h; $('lead').textContent = l }

  function ics(b) {
    const [hh, mm] = (b.time24 || '16:00').split(':').map(Number)
    const pad = (n) => String(n).padStart(2, '0')
    const first = b.isoDates[0].replace(/-/g, '')
    const end = hh * 60 + mm + (b.durationMin || 60)
    const lines = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Joner Football//JFP//EN', 'BEGIN:VEVENT',
      `UID:${b.id}@jonerfootball.com`, `DTSTAMP:${new Date().toISOString().replace(/[-:]/g, '').slice(0, 15)}Z`,
      `DTSTART;TZID=Australia/Sydney:${first}T${pad(hh)}${pad(mm)}00`,
      `DTEND;TZID=Australia/Sydney:${first}T${pad(Math.floor(end / 60))}${pad(end % 60)}00`,
      `RRULE:FREQ=WEEKLY;COUNT=${b.isoDates.length}`,
      `SUMMARY:JFP ${b.day} ${b.time}`, `LOCATION:${(b.address || '').replace(/([,;])/g, '\\$1')}`,
      'END:VEVENT', 'END:VCALENDAR']
    return 'data:text/calendar;charset=utf-8,' + encodeURIComponent(lines.join('\r\n'))
  }

  function kit(k) {
    if (!k) return
    $('kit-note').textContent = k.note || ''
    if (k.url) { $('kit-go').href = k.url; $('kit').hidden = false }
  }

  // A payment link (spot, trial, offer, balance): thank you, then the kit.
  function paidLink(p, k) {
    const names = p.players
    const g = p.group
    hero('Payment complete', 'Thank you', p.trial
      ? `${names.join(' and ')}'s trial is booked${g ? ` for ${g.day} ${g.time}` : ''}${p.trialDate ? `, ${p.trialDate}` : ''}. We have emailed you the details.`
      : `${names.join(' and ')} ${names.length > 1 ? 'are' : 'is'} locked in for ${p.term}${g ? `, ${g.day} ${g.time}` : ''}. We have emailed you a receipt.`)
    kit(k)
    $('details').innerHTML = [
      ...(g ? [['Group', `${g.day} ${g.time}`], ['Where', g.address || g.location], ['Coach', g.coachName || 'Joner Football']] : []),
      ['Players', names.join(', ')],
      ...(p.trial ? [['Trial', p.trialDate || (g ? g.firstDate : '')]] : g ? [['First session', p.startDate || g.firstDate]] : []),
      ['Paid', p.priceLabel], ['Reference', p.id],
    ].map(([k2, v]) => `<dt>${esc(k2)}</dt><dd>${esc(v)}</dd>`).join('')
    $('calendar').hidden = true
    if (g?.maps) { $('maps').href = g.maps; $('maps').hidden = false }
    $('card').hidden = false
    $('help').hidden = true
  }

  function paid(b, k) {
    const names = b.players.map((p) => p.name)
    hero('Payment complete', 'Thank you, you are booked in', `${names.join(' and ')} ${names.length > 1 ? 'are' : 'is'} in ${b.term}, ${b.day} ${b.time}. We have emailed you the details.`)
    kit(k)
    $('details').innerHTML = [
      ['Group', `${b.day} ${b.time}`], ['Where', b.address || b.location], ['Coach', b.coachName || 'Joner Football'],
      ['Players', names.join(', ')], ['First session', b.firstDate], ['All dates', b.dates.join(', ')], ['Paid', b.priceLabel], ['Reference', b.id],
    ].map(([k, v]) => `<dt>${esc(k)}</dt><dd>${esc(v)}</dd>`).join('')
    $('calendar').href = ics(b)
    if (b.maps) { $('maps').href = b.maps; $('maps').hidden = false }
    $('card').hidden = false
    $('help').hidden = true
    let fired = false
    try { fired = sessionStorage.getItem(`jfp_purchase_${b.id}`) === '1' } catch {}
    if (!fired && window.JonerTracking?.trackEvent) {
      window.JonerTracking.trackEvent('Purchase', { custom_data: { content_name: 'jfp_term', content_category: 'jfp_term', currency: 'AUD', value: Number(String(b.priceLabel).replace(/[^0-9.]/g, '')) || 0, booking_id: b.id } })
      try { sessionStorage.setItem(`jfp_purchase_${b.id}`, '1') } catch {}
    }
  }
  function failed(msg) { hero('Not found', 'We could not find that booking', msg); $('help').hidden = false }

  async function check() {
    if (!sid) return failed('Open this page from your Stripe payment.')
    tries += 1
    try {
      const res = await fetch(`/api/jfp-confirm?session_id=${encodeURIComponent(sid)}`)
      const d = await res.json().catch(() => ({}))
      if (res.status === 404) return failed('If you paid, email us and we will find it.')
      if (d.status === 'paid' && d.booking) return paid(d.booking, d.kit)
      if (d.status === 'paid' && d.payment) return paidLink(d.payment, d.kit)
      if (d.status === 'received') { hero('Payment received', 'We have your payment', 'This booking had been closed before your payment went through, so Lee or Ligia will contact you today to confirm the place or refund you. Do not pay again.'); $('help').hidden = true; return }
      if (d.status === 'expired') return failed('The payment session expired before it was finished. Nothing was charged.')
    } catch {}
    if (tries < 12) { hero('Confirming payment', 'Almost there', 'Your payment is still processing. This page updates on its own.'); setTimeout(check, 5000) }
    else failed('Your payment is taking longer than usual. Do not pay again.')
  }
  check()
</script>
