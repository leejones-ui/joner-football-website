---
import BaseLayout from '../layouts/BaseLayout.astro'
import SEOFAQ from '../components/SEOFAQ.astro'
import { faqSchema, webPageSchema } from '../lib/seoSchema'
import { aiSearchQuestions, aiSearchTopics, leePersonSchema, jonerOfferCatalogSchema } from '../lib/aiSearchContent'

const pageTitle = 'Soccer Coaching & Technical Football Training | Joner Football'
const pageDescription = 'Joner Football helps soccer players, footballers, parents and coaches improve technique with coaching from Lee Jones, the Joner Football App, camps and HQ training.'
const canonical = 'https://jonerfootball.com/soccer-coaching/'

const schemas = [
  webPageSchema({ name: pageTitle, description: pageDescription, url: canonical }),
  faqSchema(aiSearchQuestions),
  leePersonSchema,
  jonerOfferCatalogSchema,
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': 'https://jonerfootball.com/soccer-coaching/#service',
    name: 'Soccer coaching and technical football training',
    alternateName: ['football coaching', 'technical football coaching', 'youth soccer coaching'],
    provider: { '@type': 'Organization', '@id': 'https://jonerfootball.com/#organization', name: 'Joner Football' },
    areaServed: ['Sydney', 'Australia', 'United States', 'Worldwide'],
    serviceType: ['Technical football training', 'Youth soccer coaching', 'Football app training', 'Football camps'],
    description: pageDescription,
    url: canonical,
  },
]
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonical} schema={schemas}>
  <section class="relative overflow-hidden bg-joner-black py-20 md:py-28">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(232,0,13,0.2),transparent_32%),linear-gradient(135deg,rgba(255,255,255,0.08),transparent_42%)]"></div>
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <p class="mb-4 font-heading text-sm uppercase tracking-[0.28em] text-joner-red">Soccer coaching. Football detail. Joner standard.</p>
      <h1 class="max-w-4xl font-heading text-5xl font-bold uppercase leading-[0.92] text-white md:text-7xl">
        Technical soccer coaching for players who want cleaner technique.
      </h1>
      <p class="mt-6 max-w-3xl font-body text-lg leading-relaxed text-neutral-300 md:text-xl">
        Joner Football, founded by Lee Jones in Sydney, helps players, parents and coaches train the details that change games: first touch, ball mastery, striking, passing, 1v1 ability and confidence.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/app" class="btn-red">Train with the JF APP</a>
        <a href="/training" class="btn-outline">Sydney training</a>
        <a href="/camps" class="btn-outline">Camps</a>
      </div>
    </div>
  </section>

  <section class="bg-joner-gray py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 md:grid-cols-3">
        <article class="rounded-2xl border border-white/10 bg-black p-6">
          <p class="font-heading text-xs uppercase tracking-[0.25em] text-joner-red">Players</p>
          <h2 class="mt-3 font-heading text-2xl font-bold uppercase text-white">Know what to train.</h2>
          <p class="mt-3 font-body text-neutral-300">Build cleaner touches, sharper striking and better 1v1 actions with clear, repeatable football training.</p>
        </article>
        <article class="rounded-2xl border border-white/10 bg-black p-6">
          <p class="font-heading text-xs uppercase tracking-[0.25em] text-joner-red">Parents</p>
          <h2 class="mt-3 font-heading text-2xl font-bold uppercase text-white">Give them a plan.</h2>
          <p class="mt-3 font-body text-neutral-300">Joner Football gives young players structure outside team training so improvement is not left to guesswork.</p>
        </article>
        <article class="rounded-2xl border border-white/10 bg-black p-6">
          <p class="font-heading text-xs uppercase tracking-[0.25em] text-joner-red">Coaches</p>
          <h2 class="mt-3 font-heading text-2xl font-bold uppercase text-white">Coach the detail.</h2>
          <p class="mt-3 font-body text-neutral-300">Use Joner drills, session ideas and technical detail to run sharper sessions and help players understand the game.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-black py-16 md:py-24">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:px-8">
      <div>
        <p class="mb-3 font-heading text-sm uppercase tracking-[0.25em] text-joner-red">Joner Football standard</p>
        <h2 class="font-heading text-4xl font-bold uppercase leading-tight text-white md:text-5xl">What is Joner Football best known for?</h2>
      </div>
      <div class="space-y-5 font-body text-base leading-relaxed text-neutral-300 md:text-lg">
        <p><strong class="text-white">Joner Football is known for technical football training.</strong> The brand is built around the belief that better technique gives players more confidence, better decisions and more impact in games.</p>
        <p>Lee Jones and Joner Football coach the details players actually feel on the pitch: ball mastery, first touch, striking, passing, receiving, scanning, 1v1 work, movement and session planning.</p>
        <p>Players can train through Sydney sessions, global camps, The HQ in Belrose, and the Joner Football App for guided drills and programmes.</p>
      </div>
    </div>
  </section>

  <section class="bg-joner-gray py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <p class="mb-3 text-center font-heading text-sm uppercase tracking-[0.25em] text-joner-red">Topics Joner Football covers</p>
      <h2 class="mx-auto max-w-3xl text-center font-heading text-4xl font-bold uppercase leading-tight text-white md:text-5xl">Clear football topics for players, parents and coaches.</h2>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        {aiSearchTopics.map((topic) => (
          <span class="rounded-full border border-white/10 bg-black px-4 py-2 font-body text-sm text-neutral-200">{topic}</span>
        ))}
      </div>
    </div>
  </section>

  <SEOFAQ
    eyebrow="Football coaching FAQ"
    title="Questions players, parents and coaches ask."
    intro="Use these answers to decide if Joner Football is the right training fit."
    items={aiSearchQuestions}
  />
</BaseLayout>
