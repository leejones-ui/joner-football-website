---
// Microsoft Clarity: heatmaps and session recordings for the landing pages.
// Typed text is masked by Clarity by default. Renders nothing until an ID is set.
const clarityId = import.meta.env.PUBLIC_CLARITY_ID || '';
---
{clarityId && (
  <script is:inline define:vars={{ clarityId }}>
    (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", clarityId);
    // Tag each recording with the ad it came from so recordings can be filtered per ad.
    try {
      var params = new URLSearchParams(window.location.search || '');
      ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'].forEach(function (key) {
        var value = params.get(key);
        if (value) window.clarity('set', key, value.slice(0, 100));
      });
      window.clarity('set', 'landing_path', (window.location.pathname || '/').replace(/\/+$/, '') || '/');
    } catch (e) {}
  </script>
)}
