---
const beats = [
  {
    number: '01',
    label: 'Philosophy',
    kicker: 'Welcome',
    title: 'Technique Above Everything',
    body: '',
    image: '/images/home-mobile-story/mobile-story-01-action.webp',
  },
  {
    number: '02',
    label: 'Origin',
    kicker: 'Origin',
    title: 'It Started With A Bag Of Balls',
    body: 'In 2013 it started with an idea. Joner Football was born. Now we are recognised all over the world.',
    image: '/images/home-mobile-story/mobile-story-02-origin.webp',
    stamp: 'EST 2013',
  },
  {
    number: '03',
    label: 'Growth',
    kicker: 'Growth',
    title: 'Local Sessions. Global Reach.',
    body: 'The work spread through videos, players, parents, coaches, and millions of touches online.',
    image: '/images/home-mobile-story/mobile-story-04-global.webp',
    growth: true,
    ctas: [
      ['YouTube', 'https://www.youtube.com/@jonerfootball'],
      ['Instagram', 'https://www.instagram.com/jonerfootball/'],
      ['Facebook', 'https://www.facebook.com/Jonerfootball/'],
      ['TikTok', 'https://www.tiktok.com/@jonerfootball'],
      ['JF App', 'https://app.jonerfootball.com'],
      ['X / Twitter', 'https://twitter.com/jonerfootball'],
    ],
  },
  {
    number: '04',
    label: 'Joner Way',
    kicker: 'The Joner Way',
    title: 'A Method Like No Other',
    body: 'Every technical detail gets coached through energy, passion & positivity.',
    image: '/images/home-mobile-story/mobile-story-03-method.webp',
    ctas: [['Train With Us In Sydney', '/training#jfp']],
  },
  {
    number: '05',
    label: 'Global',
    kicker: 'Going Global',
    title: 'Coaching Worldwide',
    body: 'From Sydney to camps, clinics, and football communities around the world.',
    image: '/images/home-mobile-story/mobile-story-04-global.webp',
    ctas: [['Elite Camps', '/camps']],
  },
  {
    number: '06',
    label: 'JF App',
    kicker: 'The Joner Football App',
    title: 'Worlds #1 Football Coaching APP',
    body: 'Built for players, parents, and coaches to train with clarity, confidence, and purpose.',
    image: '/images/home-mobile-story/mobile-story-05-app.webp',
    video: '/images/home-storyboard/06-app-header-video-desktop.mp4',
    ctas: [
      ['7 Day Free Trial', 'https://app.jonerfootball.com/categories/category-vpi8uazway4'],
      ['Apple Download', 'https://apps.apple.com/au/app/joner-football-app/id6737069275'],
      ['Google Download', 'https://play.google.com/store/apps/details?id=tv.uscreen.jonerfootball'],
    ],
  },
  {
    number: '07',
    label: 'Our HQ',
    kicker: 'Our HQ',
    title: 'A Home Of Our Own',
    body: 'Sydney, Australia. Belrose. Our home.',
    image: '/images/home-mobile-story/mobile-story-06-hq.webp',
    ctas: [['Visit HQ Map', 'https://maps.google.com/?q=20+Narabang+Way+Belrose']],
  },
  {
    number: '08',
    label: 'Action',
    kicker: 'Action',
    title: 'Choose Your Next Step',
    body: 'Train online, train with us, join a camp, or get inside the Joner Football Hub.',
    image: '/images/home-mobile-story/mobile-story-07-choice.webp',
    choose: true,
  },
]

const stats = [
  { value: '2M+', label: 'followers online', target: 2000000, format: 'millions' },
  { value: '50K+', label: 'app downloads', target: 50000, format: 'thousands' },
  { value: '1,500+', label: 'training drills', target: 1500, format: 'comma' },
  { value: '15+', label: 'countries reached', target: 15, format: 'plain' },
]

const choices = [
  ['The APP', '/app'],
  ['Train In Person', '/training'],
  ['Coaches', '/app/for-coaches'],
  ['Elite Camps', '/camps'],
  ['Workshops', '/workshops'],
  ['The JF HUB', '/hub'],
]
---

<section class="mobile-story" data-mobile-story-rebuild aria-label="Joner Football mobile story">
  <div class="mobile-story-track" style={`height: ${beats.length * 100}svh`}>
    <div class="mobile-story-sticky">
      {beats.map((beat, index) => (
        <article class="mobile-story-beat" data-mobile-beat data-index={index} style={`opacity:${index === 0 ? 1 : 0};`}>
          {beat.video ? (
            <video class="mobile-story-media" muted loop playsinline preload="metadata" poster={beat.image} aria-label={beat.title}>
              <source src={beat.video} type="video/mp4" />
            </video>
          ) : (
            <img class="mobile-story-media" src={beat.image} alt="" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
          )}

          <div class="mobile-story-shade" aria-hidden="true"></div>

          <div class="mobile-story-copy">
            <p class="mobile-story-kicker">{beat.number} / {beat.kicker}</p>
            <h2>{beat.title}</h2>
            {beat.body && <p>{beat.body}</p>}
            {beat.stamp && <strong class="mobile-story-stamp">{beat.stamp}</strong>}

            {beat.growth && (
              <div class="mobile-growth-card">
                <p class="mobile-growth-label">Social growth</p>
                <strong data-mobile-growth-count data-target={stats[0].target} data-format={stats[0].format}>{stats[0].value}</strong>
                <div class="mobile-growth-bars" aria-hidden="true">
                  {[18, 32, 48, 66, 88, 100].map((height) => <span style={`height:${height}%`}></span>)}
                </div>
                <div class="mobile-growth-grid">
                  {stats.slice(1).map((stat) => (
                    <div><strong data-mobile-growth-count data-target={stat.target} data-format={stat.format}>{stat.value}</strong><span>{stat.label}</span></div>
                  ))}
                </div>
              </div>
            )}

            {beat.choose ? (
              <div class="mobile-story-choices">
                {choices.map(([label, href]) => <a href={href}>{label}</a>)}
              </div>
            ) : beat.ctas && (
              <div class="mobile-story-ctas">
                {beat.ctas.map(([label, href]) => <a href={href}>{label}</a>)}
              </div>
            )}
          </div>
        </article>
      ))}

      <aside class="mobile-story-rail" aria-hidden="true">
        <div class="mobile-story-line"></div>
        <div class="mobile-story-fill" data-mobile-story-fill></div>
        <div class="mobile-story-dots">
          {beats.map((beat, index) => <span class:list={[index === 0 && 'is-active']} data-mobile-dot></span>)}
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .mobile-story { display: none; position: relative; background: #030303; color: #fff; }
  .mobile-story-track { position: relative; }
  .mobile-story-sticky { position: sticky; top: 0; height: 100svh; overflow: hidden; isolation: isolate; background: #050505; }
  .mobile-story-beat { position: absolute; inset: 0; pointer-events: none; will-change: opacity, transform; transform: scale(1.015); }
  .mobile-story-beat.is-active { pointer-events: auto; }
  .mobile-story-media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 50%; filter: saturate(1.02) contrast(1.08) brightness(0.82); }
  .mobile-story-beat:nth-child(1) .mobile-story-media { object-position: 53% 48%; }
  .mobile-story-beat:nth-child(2) .mobile-story-media { object-position: 50% 47%; }
  .mobile-story-beat:nth-child(4) .mobile-story-media { object-position: 50% 48%; }
  .mobile-story-beat:nth-child(7) .mobile-story-media { object-position: 54% 50%; }
  .mobile-story-shade { position: absolute; inset: 0; z-index: 1; background: radial-gradient(circle at 68% 38%, rgba(227,6,19,0.16), transparent 18rem), linear-gradient(180deg, rgba(0,0,0,0.48), rgba(0,0,0,0.08) 38%, rgba(0,0,0,0.8)), linear-gradient(90deg, rgba(0,0,0,0.78), rgba(0,0,0,0.24) 54%, rgba(0,0,0,0.2)); }
  .mobile-story-copy { position: absolute; left: 2.85rem; right: 1.2rem; bottom: max(2.05rem, env(safe-area-inset-bottom)); z-index: 3; max-width: 23rem; opacity: var(--copy-opacity, 1); transform: translateY(var(--copy-y, 0)); will-change: opacity, transform; }
  .mobile-story-kicker { margin: 0 0 0.9rem; color: #e30613; font-family: 'Anton', Impact, sans-serif; font-size: 0.72rem; letter-spacing: 0.24em; text-transform: uppercase; }
  .mobile-story-copy h2 { margin: 0; color: #fff; font-family: 'Anton', Impact, sans-serif; font-size: clamp(2.65rem, 12.2vw, 4.45rem); line-height: 0.92; letter-spacing: 0.03em; text-transform: uppercase; text-shadow: 0 1rem 2rem rgba(0,0,0,0.62); }
  .mobile-story-copy p:not(.mobile-story-kicker) { margin: 1rem 0 0; max-width: 19.5rem; color: rgba(255,255,255,0.78); font-family: Arial, sans-serif; font-size: 0.98rem; line-height: 1.42; }
  .mobile-story-stamp { display: inline-flex; margin-top: 1rem; border-left: 2px solid #e30613; padding-left: 0.8rem; font-family: 'Anton', Impact, sans-serif; font-size: 2.4rem; line-height: 1; }
  .mobile-story-ctas, .mobile-story-choices { margin-top: 1.15rem; display: flex; flex-wrap: wrap; gap: 0.58rem; }
  .mobile-story-ctas a, .mobile-story-choices a { display: inline-flex; align-items: center; justify-content: center; min-height: 2.9rem; border: 1px solid rgba(255,255,255,0.34); border-radius: 999px; background: rgba(5,5,5,0.58); color: #fff; padding: 0.78rem 1rem; font-family: 'Anton', Impact, sans-serif; font-size: 0.72rem; letter-spacing: 0.13em; line-height: 1; text-decoration: none; text-transform: uppercase; backdrop-filter: blur(14px); }
  .mobile-story-choices { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 20.5rem; }
  .mobile-story-choices a { border-radius: 0.7rem; min-height: 3.2rem; padding-inline: 0.55rem; text-align: center; }
  .mobile-growth-card { margin-top: 1.05rem; max-width: 20.5rem; border: 1px solid rgba(255,255,255,0.16); background: rgba(5,5,5,0.54); padding: 0.95rem; backdrop-filter: blur(16px); }
  .mobile-growth-label { margin: 0 0 0.55rem !important; color: #e30613 !important; font-family: 'Anton', Impact, sans-serif !important; font-size: 0.62rem !important; letter-spacing: 0.18em; text-transform: uppercase; }
  .mobile-growth-card > strong { display: block; font-family: 'Anton', Impact, sans-serif; font-size: clamp(3.4rem, 15vw, 5rem); line-height: 0.92; transform: rotateX(var(--growth-spin, 0deg)); transform-origin: 50% 55%; }
  .mobile-growth-bars { margin-top: 0.5rem; height: 4.6rem; display: flex; align-items: end; gap: 0.32rem; }
  .mobile-growth-bars span { flex: 1; background: #e30613; opacity: 0.5; transform-origin: bottom; transform: scaleY(var(--bar-scale, 1)); }
  .mobile-growth-grid { margin-top: 0.72rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.38rem; }
  .mobile-growth-grid div { border: 1px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.06); padding: 0.48rem 0.3rem; text-align: center; }
  .mobile-growth-grid strong { display: block; font-family: 'Anton', Impact, sans-serif; font-size: 1.15rem; line-height: 1; transform: rotateX(var(--growth-spin, 0deg)); }
  .mobile-growth-grid span { display: block; margin-top: 0.25rem; color: rgba(255,255,255,0.58); font-family: Arial, sans-serif; font-size: 0.47rem; font-weight: 900; letter-spacing: 0.1em; text-transform: uppercase; }
  .mobile-story-rail { position: absolute; left: 1rem; top: 5rem; bottom: 4.7rem; z-index: 5; width: 1.3rem; pointer-events: none; }
  .mobile-story-line, .mobile-story-fill { position: absolute; left: 0.62rem; top: 0; width: 1px; }
  .mobile-story-line { bottom: 0; background: rgba(255,255,255,0.24); }
  .mobile-story-fill { height: 0%; background: #e30613; box-shadow: 0 0 1rem rgba(227,6,19,0.58); }
  .mobile-story-line::before, .mobile-story-line::after { content: '+'; position: absolute; left: -0.25rem; color: rgba(255,255,255,0.74); font-family: Arial, sans-serif; font-size: 1rem; line-height: 1; }
  .mobile-story-line::before { top: -0.9rem; } .mobile-story-line::after { bottom: -0.9rem; }
  .mobile-story-dots { position: absolute; left: 0.38rem; top: 0; bottom: 0; display: flex; flex-direction: column; justify-content: space-between; }
  .mobile-story-dots span { width: 0.5rem; height: 0.5rem; border-radius: 999px; border: 1px solid rgba(255,255,255,0.38); background: rgba(0,0,0,0.3); }
  .mobile-story-dots span.is-active { border-color: #e30613; background: #e30613; box-shadow: 0 0 1rem rgba(227,6,19,0.5); }
  @media (max-width: 767px) { .mobile-story { display: block; } }
  @media (prefers-reduced-motion: reduce) { .mobile-story-beat, .mobile-story-copy, .mobile-growth-card > strong, .mobile-growth-grid strong { transition: none !important; transform: none !important; } }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-mobile-story-rebuild]');
    if (!root) return;
    var track = root.querySelector('.mobile-story-track');
    var beats = Array.prototype.slice.call(root.querySelectorAll('[data-mobile-beat]'));
    var dots = Array.prototype.slice.call(root.querySelectorAll('[data-mobile-dot]'));
    var fill = root.querySelector('[data-mobile-story-fill]');
    var counters = Array.prototype.slice.call(root.querySelectorAll('[data-mobile-growth-count]'));
    var active = -1;
    var ticking = false;

    function clamp(value, min, max) { return Math.min(Math.max(value, min), max); }
    function easeOutCubic(value) { return 1 - Math.pow(1 - value, 3); }
    function formatGrowth(value, format) {
      if (format === 'millions') return (value / 1000000).toFixed(value > 1900000 ? 0 : 1).replace('.0', '') + 'M+';
      if (format === 'thousands') return Math.round(value / 1000) + 'K+';
      if (format === 'comma') return Math.round(value).toLocaleString('en-US') + '+';
      return Math.round(value) + '+';
    }
    function setActive(next) {
      if (next === active) return;
      active = next;
      beats.forEach(function (beat, index) {
        beat.classList.toggle('is-active', index === next);
        var video = beat.querySelector('video');
        if (video) {
          if (index === next) video.play().catch(function () {});
          else video.pause();
        }
      });
      dots.forEach(function (dot, index) { dot.classList.toggle('is-active', index === next); });
    }
    function updateNow() {
      ticking = false;
      if (window.innerWidth > 767) return;
      var rect = track.getBoundingClientRect();
      var maxScroll = Math.max(1, rect.height - window.innerHeight);
      var progress = clamp(-rect.top / maxScroll, 0, 1);
      var exact = progress * (beats.length - 1);
      var index = clamp(Math.round(exact), 0, beats.length - 1);
      setActive(index);
      beats.forEach(function (beat, i) {
        var distance = Math.abs(exact - i);
        var opacity = clamp(1 - (distance * 1.35), 0, 1);
        beat.style.opacity = opacity.toFixed(4);
        beat.style.transform = 'scale(' + (1 + (Math.min(distance, 1) * 0.018)).toFixed(4) + ')';
        beat.style.setProperty('--copy-opacity', String(clamp(opacity * 1.25, 0, 1)));
        beat.style.setProperty('--copy-y', (Math.min(distance, 1) * 12).toFixed(2) + 'px');
      });
      if (fill) fill.style.height = (progress * 100).toFixed(2) + '%';
      var growthLocal = clamp(exact - 2, 0, 1);
      var eased = easeOutCubic(growthLocal);
      root.style.setProperty('--growth-spin', (growthLocal * 720).toFixed(1) + 'deg');
      root.style.setProperty('--bar-scale', eased.toFixed(3));
      counters.forEach(function (counter) {
        var target = Number(counter.getAttribute('data-target')) || 0;
        var format = counter.getAttribute('data-format') || 'plain';
        counter.textContent = formatGrowth(target * eased, format);
      });
    }
    function requestUpdate() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(updateNow);
    }
    requestUpdate();
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
  })();
</script>
