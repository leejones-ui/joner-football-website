---
import BookNowButton from './BookNowButton.astro'

// A third item marks the shared Book now button (JFP booking system).
const beats = [
  {
    number: '01',
    label: 'Philosophy',
    kicker: 'Welcome',
    title: 'Technique Above Everything',
    body: '',
    image: '/images/home-mobile-story/mobile-story-01-action.webp',
    ctas: [['Book now', '', 'home-mobile-hero']],
  },
  {
    number: '02',
    label: 'Origin',
    kicker: 'Origin',
    title: 'It Started With A Bag Of Balls',
    body: 'In 2013 it started with an idea. Joner Football was born. Now we are recognised all over the world.',
    image: '/images/home-mobile-story/mobile-story-02-origin.webp',
    stamp: 'EST 2013',
  },
  {
    number: '03',
    label: 'Growth',
    kicker: 'Growth',
    title: 'Local Sessions. Global Reach.',
    body: 'The work spread through videos, players, parents, coaches, and millions of touches online.',
    image: '/images/home-mobile-story/mobile-story-03-growth.webp',
    growth: true,
    ctas: [
      ['YouTube', 'https://www.youtube.com/@jonerfootball'],
      ['Instagram', 'https://www.instagram.com/jonerfootball/'],
      ['Facebook', 'https://www.facebook.com/Jonerfootball/'],
      ['TikTok', 'https://www.tiktok.com/@jonerfootball'],
      ['JF App', 'https://app.jonerfootball.com'],
      ['X / Twitter', 'https://twitter.com/jonerfootball'],
    ],
  },
  {
    number: '04',
    label: 'Joner Way',
    kicker: 'The Joner Way',
    title: 'A Method Like No Other',
    body: 'Every technical detail gets coached through energy, passion & positivity.',
    image: '/images/home-mobile-story/mobile-story-04-joner-way.webp',
    ctas: [['Book now', '', 'home-mobile-joner-way'], ['Train With Us In Sydney', '/contact']],
  },
  {
    number: '05',
    label: 'Global',
    kicker: 'Going Global',
    title: 'Coaching Worldwide',
    body: 'From Sydney to camps, clinics, and football communities around the world.',
    image: '/images/home-mobile-story/mobile-story-05-camps.webp',
    ctas: [['Elite Camps', '/camps']],
  },
  {
    number: '06',
    label: 'JF App',
    kicker: 'The Joner Football App',
    title: 'World’s #1 Football Coaching APP',
    body: 'Built for players, parents, and coaches to train with clarity, confidence, and purpose.',
    image: '/images/home-mobile-story/mobile-story-05-app.webp',
    video: '/images/home-storyboard/06-app-header-video-desktop.mp4',
    ctas: [
      ['7 Day Free Trial', 'https://app.jonerfootball.com/categories/category-vpi8uazway4'],
    ],
  },
  {
    number: '07',
    label: 'Our HQ',
    kicker: 'Our HQ',
    title: 'A Home Of Our Own',
    body: 'Sydney, Australia. Belrose. Our home.',
    image: '/images/home-mobile-story/mobile-story-07-hq-photo.webp',
    ctas: [['Visit HQ Map', 'https://maps.google.com/?q=20+Narabang+Way+Belrose']],
  },
  {
    number: '08',
    label: 'Action',
    kicker: 'Action',
    title: 'Choose Your Next Step',
    body: 'Train online, train with us, join a camp, or get inside the Joner Football Hub.',
    image: '/images/home-mobile-story/mobile-story-08-action.webp',
    choose: true,
  },
]

const stats = [
  { value: '2M+', label: 'followers online', target: 2000000, format: 'millions' },
  { value: '50K+', label: 'app downloads', target: 50000, format: 'thousands' },
  { value: '1,500+', label: 'training drills', target: 1500, format: 'comma' },
  { value: '15+', label: 'countries reached', target: 15, format: 'plain' },
]

const choices = [
  ['The APP', '/app'],
  ['Train In Person', '/training'],
  ['Coaches', '/app/for-coaches'],
  ['Elite Camps', '/camps'],
  ['Workshops', '/workshops'],
  ['The JF HUB', '/hub'],
]
---

<section class="mobile-story" data-mobile-story-rebuild aria-label="Joner Football mobile story">
  <div class="mobile-story-track" data-mobile-track style={`--beats:${beats.length};`}>
    <div class="mobile-story-sticky" data-mobile-sticky>
      {beats.map((beat, index) => (
        <article class:list={['mobile-story-beat', index === 0 && 'is-active']} data-mobile-beat data-index={index}>
          <div class="mobile-story-canvas" data-mobile-canvas aria-hidden="true">
            {beat.video ? (
              <video class="mobile-story-media mobile-story-video" muted loop playsinline preload="none" data-poster={beat.image} aria-label={beat.title}>
                <source src={beat.video} type="video/mp4" />
              </video>
            ) : (
              <picture>
              {/* Laptops show the wide story instead, so this hidden photo must not download there. */}
              <source media="(min-width: 768px) and (min-height: 601px) and (orientation: landscape), (min-width: 1025px) and (min-height: 601px)" srcset="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" />
              <img
                class="mobile-story-media"
                src={beat.image}
                alt=""
                width="1080"
                height="1920"
                loading={index === 0 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : 'auto'}
                decoding="async"
              />
              </picture>
            )}
            <div class="mobile-story-shade"></div>
          </div>

          <div class="mobile-story-copy">
            {beat.stamp && <strong class="mobile-story-stamp">{beat.stamp}</strong>}
            <p class="mobile-story-kicker">{beat.kicker}</p>
            <h2>{beat.title}</h2>
            {beat.body && <p>{beat.body}</p>}

            {beat.growth && (
              <div class="mobile-growth-card">
                <p class="mobile-growth-label">Social growth</p>
                <strong data-mobile-growth-count data-target={stats[0].target} data-format={stats[0].format}>{stats[0].value}</strong>
                <div class="mobile-growth-bars" aria-hidden="true">
                  {[18, 32, 48, 66, 88, 100].map((height) => <span style={`height:${height}%`}></span>)}
                </div>
                <div class="mobile-growth-grid">
                  {stats.slice(1).map((stat) => (
                    <div><strong data-mobile-growth-count data-target={stat.target} data-format={stat.format}>{stat.value}</strong><span>{stat.label}</span></div>
                  ))}
                </div>
              </div>
            )}

            {beat.choose ? (
              <div class="mobile-story-choices">
                {choices.map(([label, href]) => <a href={href}>{label}</a>)}
              </div>
            ) : beat.ctas && (
              <div class:list={['mobile-story-ctas', beat.ctas.length > 2 && 'mobile-story-ctas--grid']}>
                {beat.ctas.map(([label, href, bookPlace], ctaIndex) => bookPlace
                  ? <BookNowButton place={bookPlace} class="mobile-story-book" />
                  : <a
                      href={href}
                      class:list={[ctaIndex === 0 && beat.ctas.length <= 2 && 'is-primary']}
                      target={/^https?:/.test(href) ? '_blank' : undefined}
                      rel={/^https?:/.test(href) ? 'noopener noreferrer' : undefined}
                    >{label}</a>)}
              </div>
            )}
          </div>

          {index === 0 && (
            <div class="mobile-story-cue" aria-hidden="true">
              <span class="mobile-story-cue-label">Scroll</span>
              <span class="mobile-story-cue-track"><span class="mobile-story-cue-drop"></span></span>
            </div>
          )}
        </article>
      ))}

      <aside class="mobile-story-rail" aria-hidden="true">
        <div class="mobile-story-line"></div>
        <div class="mobile-story-fill" data-mobile-story-fill></div>
        <div class="mobile-story-dots">
          {beats.map((beat, index) => <span class:list={[index === 0 && 'is-active']} data-mobile-dot>{beat.number}</span>)}
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  /* ONE STORY, EVERY SCREEN (16 Nov 2026).
     Phones and portrait tablets now get the same pinned story as the laptop:
     the screen holds still and each photo dissolves into the next as you
     scroll. Nothing is moved by script. The panel is pinned by the browser
     (position: sticky) and script only writes opacity and scale, so iPhone
     momentum scrolling cannot make it jitter.
     Without script, with reduced motion, or on very short screens the story
     falls back to plain stacked panels with everything visible. */
  .mobile-story { display: none; position: relative; background: #050505; color: #fff; }
  .mobile-story-track { position: relative; }
  .mobile-story-sticky { position: relative; background: #050505; }
  .mobile-story-beat { position: relative; min-height: 100svh; overflow: hidden; isolation: isolate; }
  .mobile-story-beat + .mobile-story-beat { margin-top: -7svh; }
  .mobile-story-canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 15%, #000 85%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 15%, #000 85%, transparent 100%);
  }
  .mobile-story-beat:first-child .mobile-story-canvas {
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 85%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 0%, #000 85%, transparent 100%);
  }
  .mobile-story-media { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; object-fit: cover; object-position: 50% 50%; transform: translateZ(0); transform-origin: 50% 45%; }
  .mobile-story-video { z-index: 0; background: #000; }
  .mobile-story-beat:nth-child(1) .mobile-story-media { object-position: 53% 44%; }
  .mobile-story-beat:nth-child(2) .mobile-story-media { object-position: 50% 45%; }
  .mobile-story-beat:nth-child(3) .mobile-story-media { object-position: 50% 48%; }
  .mobile-story-beat:nth-child(4) .mobile-story-media { object-position: 50% 42%; }
  .mobile-story-beat:nth-child(5) .mobile-story-media { object-position: 50% 48%; }
  .mobile-story-beat:nth-child(7) .mobile-story-media { object-position: 50% 44%; }
  .mobile-story-beat:nth-child(8) .mobile-story-media { object-position: 50% 38%; }
  /* The shade does the darkening. A CSS filter on the photo would force the
     phone to re-filter a full-screen image on every frame of the dissolve. */
  .mobile-story-shade { position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, rgba(0,0,0,0.42), rgba(0,0,0,0.2) 42%, rgba(0,0,0,0.78)), linear-gradient(90deg, rgba(0,0,0,0.76), rgba(0,0,0,0.26) 58%, rgba(0,0,0,0.24)); }

  .mobile-story-copy { position: absolute; left: 3.85rem; right: 1.25rem; top: 18svh; z-index: 3; max-width: 22.5rem; }
  .mobile-story-beat:nth-child(1) .mobile-story-copy { inset: 0 3.8rem 0 3.8rem; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; max-width: none; }
  .mobile-story-beat:nth-child(2) .mobile-story-copy { inset: 0 1.4rem 0 3.8rem; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; max-width: none; }
  .mobile-story-beat:nth-child(3) .mobile-story-copy { top: 9svh; }
  .mobile-story-beat:nth-child(4) .mobile-story-copy { top: 34svh; left: 3.8rem; right: 1.4rem; text-align: center; max-width: none; }
  .mobile-story-beat:nth-child(5) .mobile-story-copy { left: 4.15rem; }
  .mobile-story-beat:nth-child(6) .mobile-story-copy { inset: 0 1.4rem 0 3.8rem; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; max-width: none; }
  .mobile-story-beat:nth-child(7) .mobile-story-copy { top: auto; bottom: max(2.2rem, env(safe-area-inset-bottom)); }
  .mobile-story-beat:nth-child(8) .mobile-story-copy { inset: 0 1.4rem 0 3.8rem; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; max-width: none; }
  .mobile-story-kicker { margin: 0 0 0.9rem; color: #e30613; font-family: 'Anton', Impact, sans-serif; font-size: 0.72rem; letter-spacing: 0.24em; text-transform: uppercase; }
  .mobile-story-copy h2 { margin: 0; color: #fff; font-family: 'Anton', Impact, sans-serif; font-size: clamp(2.55rem, 11.7vw, 4.25rem); font-weight: 400; line-height: 0.92; letter-spacing: 0.03em; text-transform: uppercase; text-shadow: 0 1rem 2rem rgba(0,0,0,0.62); }
  .mobile-story-copy p:not(.mobile-story-kicker) { margin: 1rem 0 0; max-width: 19.5rem; color: rgba(255,255,255,0.86); font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif; font-size: 1rem; line-height: 1.45; }
  .mobile-story-stamp { position: absolute; left: 1.25rem; top: max(1.25rem, env(safe-area-inset-top)); z-index: 4; display: inline-flex; border-left: 2px solid #e30613; padding-left: 0.6rem; font-family: 'Anton', Impact, sans-serif; font-size: 1.35rem; font-weight: 400; line-height: 1; }

  /* Buttons: the site's own red and white buttons, one width per screen so
     nothing sits ragged. No blur behind them (cheap to paint while photos
     dissolve). */
  .mobile-story-ctas, .mobile-story-choices { margin-top: 1.25rem; display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.6rem; width: min(100%, 16.5rem); }
  .mobile-story-beat:nth-child(4) .mobile-story-ctas { margin-inline: auto; }
  .mobile-story-ctas a:not(.book-now-btn), .mobile-story-choices a {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 48px; border: 2px solid #fff; border-radius: 12px;
    background: rgba(10,10,10,0.5); color: #fff; padding: 0.7rem 1rem;
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif; font-size: 0.95rem; font-weight: 700; letter-spacing: 0; line-height: 1.2;
    text-align: center; text-decoration: none; text-transform: none;
    transition: transform 140ms ease, border-color 140ms ease, background-color 140ms ease, color 140ms ease;
  }
  .mobile-story-ctas a.is-primary { border-color: #E8000D; background: #E8000D; }
  .mobile-story-ctas a:not(.book-now-btn):active, .mobile-story-choices a:active { transform: scale(0.97); border-color: #fff; background: #fff; color: #0A0A0A; }
  .mobile-story-ctas a.is-primary:active { border-color: #C4000B; background: #C4000B; color: #fff; }
  .mobile-story-ctas :global(.book-now-btn) { width: 100%; min-height: 48px; }
  .mobile-story-ctas--grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.45rem; width: min(100%, 20.5rem); margin-top: 0.8rem; }
  .mobile-story-ctas--grid a:not(.book-now-btn) { min-height: 44px; border-width: 1.5px; border-color: rgba(255,255,255,0.7); padding: 0.5rem 0.3rem; font-size: 0.8rem; }
  .mobile-story-choices { grid-template-columns: repeat(2, minmax(0, 1fr)); width: min(100%, 20.5rem); }
  .mobile-story-choices a { min-height: 54px; padding-inline: 0.5rem; }

  .mobile-growth-card { margin-top: 0.85rem; max-width: 20.5rem; border: 1px solid rgba(255,255,255,0.16); border-radius: 12px; background: rgba(5,5,5,0.72); padding: 0.8rem; contain: layout style; }
  .mobile-growth-label { margin: 0 0 0.45rem !important; color: #e30613 !important; font-family: 'Anton', Impact, sans-serif !important; font-size: 0.62rem !important; letter-spacing: 0.18em; text-transform: uppercase; }
  .mobile-growth-card > strong { display: block; font-family: 'Anton', Impact, sans-serif; font-size: clamp(2.8rem, 13vw, 4rem); font-weight: 400; line-height: 0.92; transform-origin: 0 60%; transition: transform 700ms cubic-bezier(.22,.61,.36,1) 80ms; }
  .mobile-growth-bars { margin-top: 0.45rem; height: 3.4rem; display: flex; align-items: end; gap: 0.28rem; }
  .mobile-growth-bars span { flex: 1; background: #e30613; opacity: 0.5; transform-origin: bottom; transition: transform 1300ms cubic-bezier(.22,.61,.36,1); }
  .mobile-growth-bars span:nth-child(2) { transition-delay: 120ms; }
  .mobile-growth-bars span:nth-child(3) { transition-delay: 240ms; }
  .mobile-growth-bars span:nth-child(4) { transition-delay: 360ms; }
  .mobile-growth-bars span:nth-child(5) { transition-delay: 480ms; }
  .mobile-growth-bars span:nth-child(6) { transition-delay: 600ms; }
  .mobile-growth-grid { margin-top: 0.6rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.34rem; }
  .mobile-growth-grid div { border: 1px solid rgba(255,255,255,0.12); border-radius: 8px; background: rgba(255,255,255,0.06); padding: 0.42rem 0.28rem; text-align: center; }
  .mobile-growth-grid strong { display: block; font-family: 'Anton', Impact, sans-serif; font-size: 1.08rem; font-weight: 400; line-height: 1; transition: transform 700ms cubic-bezier(.22,.61,.36,1) 140ms; }
  .mobile-growth-grid span { display: block; margin-top: 0.2rem; color: rgba(255,255,255,0.7); font-family: 'Inter', system-ui, sans-serif; font-size: 0.5rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }

  .mobile-story-rail { display: none; }
  .mobile-story-cue { display: none; }

  /* ---------- Pinned story (script adds .is-pinned) ---------- */
  /* EVERY height here comes from --sh, the screen height in pixels, which
     the script measures once and then freezes. Phone browsers change the
     screen height while you scroll (the address bar slides away and back),
     and Chrome changes vh and svh with it. Sizes tied to those units made
     the whole story resize and bounce mid-scroll (Lee, 17 Nov 2026). Never
     put vh, svh, dvh or % of the viewport back into the pinned story.
     The photo panel is 140px taller than the screen, so when the address
     bar hides there is photo under it, not a black strip. */
  .mobile-story { --sh: 100svh; --over: 140px; overflow-anchor: none; }
  .mobile-story.is-pinned .mobile-story-track { height: calc(var(--sh) - 4rem + var(--over) + (var(--beats) - 1) * 0.85 * var(--sh) + 0.3 * var(--sh)); }
  .mobile-story.is-pinned .mobile-story-sticky { position: sticky; top: 4rem; height: calc(var(--sh) - 4rem + var(--over)); overflow: hidden; contain: paint; }
  .mobile-story.is-pinned .mobile-story-beat { position: absolute; inset: 0 0 auto 0; height: calc(var(--sh) - 4rem); min-height: 0; margin: 0; overflow: visible; isolation: auto; pointer-events: none; }
  .mobile-story.is-pinned .mobile-story-canvas { inset: 0 0 auto 0; height: calc(var(--sh) - 4rem + var(--over)); -webkit-mask-image: none; mask-image: none; opacity: 0; }
  .mobile-story.is-pinned .mobile-story-beat:not(.is-warm) .mobile-story-canvas { display: none; }
  /* NOTHING IS WRITTEN PER SCROLL FRAME (Lee's screen recording, 17 Nov
     2026). Writing opacity or scale from script on every frame made iPhone
     browsers re-place the pinned panel a frame late, so it shook by a few
     pixels the whole time a finger was moving. Script now only flips classes
     when the beat changes; these timed fades run inside the browser's own
     animation engine. Do not add scroll-linked styles back to this story. */
  .mobile-story.is-pinned .mobile-story-canvas { visibility: hidden; transition: opacity 700ms cubic-bezier(.4,0,.2,1), visibility 0s linear 750ms; }
  .mobile-story.is-pinned .mobile-story-beat.is-near .mobile-story-canvas { visibility: visible; transition: opacity 700ms cubic-bezier(.4,0,.2,1), visibility 0s; }
  .mobile-story.is-pinned .mobile-story-beat.is-shown .mobile-story-canvas { opacity: 1; }
  .mobile-story.is-pinned .mobile-story-media { transform: translateZ(0) scale(1.07); transition: transform 1500ms cubic-bezier(.22,.61,.36,1); }
  .mobile-story.is-pinned .mobile-story-beat.is-active .mobile-story-media { transform: translateZ(0) scale(1); }
  .mobile-story.is-pinned .mobile-story-fill { transition: transform 600ms cubic-bezier(.22,.61,.36,1); }

  .mobile-story.is-pinned .mobile-story-copy { top: calc(0.18 * var(--sh)); }
  .mobile-story.is-pinned .mobile-story-beat:nth-child(1) .mobile-story-copy,
  .mobile-story.is-pinned .mobile-story-beat:nth-child(2) .mobile-story-copy,
  .mobile-story.is-pinned .mobile-story-beat:nth-child(6) .mobile-story-copy,
  .mobile-story.is-pinned .mobile-story-beat:nth-child(8) .mobile-story-copy { top: 0; }
  .mobile-story.is-pinned .mobile-story-beat:nth-child(3) .mobile-story-copy { top: calc(0.09 * var(--sh)); }
  .mobile-story.is-pinned .mobile-story-beat:nth-child(4) .mobile-story-copy { top: calc(0.34 * var(--sh)); }
  .mobile-story.is-pinned .mobile-story-beat:nth-child(7) .mobile-story-copy { top: auto; }
  .mobile-story.is-pinned .mobile-story-copy { transition: opacity 200ms cubic-bezier(.55,0,.68,.19), visibility 0s linear 200ms; }
  .mobile-story.is-pinned .mobile-story-beat:not(.is-active) .mobile-story-copy { opacity: 0; visibility: hidden; }
  .mobile-story.is-pinned .mobile-story-beat.is-active .mobile-story-copy { transition: opacity 0s, visibility 0s; pointer-events: auto; }
  .mobile-story.is-pinned .mobile-story-kicker,
  .mobile-story.is-pinned .mobile-story-copy h2,
  .mobile-story.is-pinned .mobile-story-copy p:not(.mobile-story-kicker),
  .mobile-story.is-pinned .mobile-story-stamp,
  .mobile-story.is-pinned .mobile-growth-card,
  .mobile-story.is-pinned .mobile-story-ctas,
  .mobile-story.is-pinned .mobile-story-choices { transition: opacity 520ms cubic-bezier(.22,.61,.36,1), transform 620ms cubic-bezier(.22,.61,.36,1); }
  .mobile-story.is-pinned .mobile-story-beat:not(.is-active) .mobile-story-kicker,
  .mobile-story.is-pinned .mobile-story-beat:not(.is-active) .mobile-story-copy h2,
  .mobile-story.is-pinned .mobile-story-beat:not(.is-active) .mobile-story-copy p:not(.mobile-story-kicker),
  .mobile-story.is-pinned .mobile-story-beat:not(.is-active) .mobile-story-stamp,
  .mobile-story.is-pinned .mobile-story-beat:not(.is-active) .mobile-growth-card,
  .mobile-story.is-pinned .mobile-story-beat:not(.is-active) .mobile-story-ctas,
  .mobile-story.is-pinned .mobile-story-beat:not(.is-active) .mobile-story-choices { opacity: 0; transform: translate3d(0, 1.1rem, 0); transition-duration: 0s; transition-delay: 200ms; }
  .mobile-story.is-pinned .mobile-story-beat.is-active .mobile-story-kicker { transition-delay: 60ms; }
  .mobile-story.is-pinned .mobile-story-beat.is-active .mobile-story-copy h2 { transition-delay: 130ms; }
  .mobile-story.is-pinned .mobile-story-beat.is-active .mobile-story-copy p:not(.mobile-story-kicker) { transition-delay: 220ms; }
  .mobile-story.is-pinned .mobile-story-beat.is-active .mobile-growth-card { transition-delay: 280ms; }
  .mobile-story.is-pinned .mobile-story-beat.is-active .mobile-story-ctas,
  .mobile-story.is-pinned .mobile-story-beat.is-active .mobile-story-choices { transition-delay: 320ms; }
  .mobile-story.is-pinned:not(.is-growth-played) .mobile-growth-card > strong { transform: translate3d(0, 18px, 0) scale(0.76); }
  .mobile-story.is-pinned:not(.is-growth-played) .mobile-growth-bars span { transform: scaleY(0.12); }
  .mobile-story.is-pinned:not(.is-growth-played) .mobile-growth-grid strong { transform: translate3d(0, 8px, 0) scale(0.82); }

  .mobile-story.is-pinned .mobile-story-rail { display: block; position: absolute; left: 0.9rem; top: 1.4rem; height: calc(var(--sh) - 4rem - 3.4rem); z-index: 20; width: 1.7rem; pointer-events: none; }
  .mobile-story-line, .mobile-story-fill { position: absolute; left: 0.82rem; top: 0; bottom: 0; width: 1px; }
  .mobile-story-line { background: rgba(255,255,255,0.24); }
  .mobile-story-fill { background: #e30613; transform: scaleY(0); transform-origin: top; }
  .mobile-story-dots { position: absolute; left: 0.18rem; top: 0; bottom: 0; display: flex; flex-direction: column; justify-content: space-between; }
  .mobile-story-dots span { width: 1.45rem; height: 1.45rem; border-radius: 999px; border: 1px solid rgba(255,255,255,0.26); background: rgba(0,0,0,0.5); display: grid; place-items: center; color: rgba(255,255,255,0.62); font-family: 'Anton', Impact, sans-serif; font-size: 0.58rem; letter-spacing: 0.08em; transition: background-color 260ms ease, border-color 260ms ease, color 260ms ease, transform 260ms cubic-bezier(.22,.61,.36,1); }
  .mobile-story-dots span.is-active { border-color: #e30613; background: #e30613; color: #fff; transform: scale(1.12); }

  .mobile-story.is-pinned .mobile-story-cue { display: flex; position: absolute; left: 50%; bottom: 1.5rem; z-index: 4; transform: translateX(-50%); flex-direction: column; align-items: center; gap: 0.5rem; opacity: 0.9; transition: opacity 420ms ease, visibility 0s linear 420ms; pointer-events: none; }
  .mobile-story.is-scrolled .mobile-story-cue { opacity: 0; visibility: hidden; }
  .mobile-story.is-scrolled .mobile-story-cue-drop { animation-play-state: paused; }
  .mobile-story-cue-label { color: rgba(255,255,255,0.7); font-family: 'Anton', Impact, sans-serif; font-size: 0.56rem; letter-spacing: 0.3em; text-transform: uppercase; }
  .mobile-story-cue-track { position: relative; width: 1px; height: 2.1rem; overflow: hidden; background: rgba(255,255,255,0.24); }
  .mobile-story-cue-drop { position: absolute; left: 0; top: 0; width: 1px; height: 0.75rem; background: #e30613; animation: mobileCueDrop 2.2s cubic-bezier(.5,0,.75,.45) infinite; }
  @keyframes mobileCueDrop { 0% { transform: translateY(-0.85rem); } 62%, 100% { transform: translateY(2.25rem); } }

  /* Phone layouts and portrait tablets use this story. Landscape tablets and
     laptops use the wide one. Same motion on both. */
  @media (max-width: 767px), (max-height: 600px), (orientation: portrait) and (max-width: 1024px) { .mobile-story { display: block; } }
  @media (orientation: portrait) and (min-width: 600px) {
    .mobile-story-copy { left: 5rem; max-width: 30rem; }
    .mobile-story-copy h2 { font-size: clamp(3.4rem, 9vw, 5.4rem); }
    .mobile-story-copy p:not(.mobile-story-kicker) { max-width: 26rem; font-size: 1.15rem; }
    .mobile-story-ctas { width: min(100%, 19rem); }
    .mobile-story-ctas--grid, .mobile-story-choices, .mobile-growth-card { width: min(100%, 26rem); max-width: 26rem; }
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-mobile-story-rebuild]');
    if (!root) return;
    var track = root.querySelector('[data-mobile-track]');
    var sticky = root.querySelector('[data-mobile-sticky]');
    var beats = Array.prototype.slice.call(root.querySelectorAll('[data-mobile-beat]'));
    var canvases = beats.map(function (beat) { return beat.querySelector('[data-mobile-canvas]'); });
    var medias = beats.map(function (beat) { return beat.querySelector('.mobile-story-media'); });
    var dots = Array.prototype.slice.call(root.querySelectorAll('[data-mobile-dot]'));
    var fill = root.querySelector('[data-mobile-story-fill]');
    var counters = Array.prototype.slice.call(root.querySelectorAll('[data-mobile-growth-count]'));
    var video = root.querySelector('video');
    var total = beats.length;
    if (!track || !sticky || !total) return;

    var storyQuery = window.matchMedia('(max-width: 767px), (max-height: 600px), (orientation: portrait) and (max-width: 1024px)');
    var reducedQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

    var SEGMENT_VH = 85;   // must match the track height in the CSS
    var END_HOLD_VH = 30;  // must match the track height in the CSS

    var pinned = false;
    var listening = false;
    var rafId = 0;
    var trackTop = 0;
    var segmentPx = 1;
    var measuredWidth = 0;
    var floorIndex = -1;
    var active = -1;
    var scrolled = false;
    var growthPlayed = false;
    var growthRafId = 0;
    var last = {};

    function clamp(value, min, max) { return Math.min(Math.max(value, min), max); }
    function smooth(value) { return value * value * (3 - 2 * value); }
    function write(key, element, property, value) {
      if (!element || last[key] === value) return;
      last[key] = value;
      element.style[property] = value;
    }
    function formatGrowth(value, format) {
      if (format === 'millions') return (value / 1000000).toFixed(value > 1900000 ? 0 : 1).replace('.0', '') + 'M+';
      if (format === 'thousands') return Math.round(value / 1000) + 'K+';
      if (format === 'comma') return Math.round(value).toLocaleString('en-US') + '+';
      return Math.round(value) + '+';
    }
    function setCounters(amount) {
      counters.forEach(function (counter) {
        var target = Number(counter.getAttribute('data-target')) || 0;
        counter.textContent = formatGrowth(target * amount, counter.getAttribute('data-format') || 'plain');
      });
    }

    // The numbers show their final values; the card rises in with CSS only.
    // A script count-up would repaint the pinned panel on every frame.
    function playGrowth() {
      if (growthPlayed) return;
      growthPlayed = true;
      root.classList.add('is-growth-played');
    }
    function resetGrowth() {
      if (!growthPlayed) return;
      growthPlayed = false;
      root.classList.remove('is-growth-played');
    }

    // The only place styles change, and only when the beat changes.
    function setActive(next) {
      if (next === active) return;
      active = next;
      beats.forEach(function (beat, index) {
        if (index <= next + 2 && !beat.classList.contains('is-warm')) {
          beat.classList.add('is-warm');
          var media = medias[index];
          if (media && media.tagName === 'IMG') {
            media.loading = 'eager';
            if (typeof media.decode === 'function') media.decode().catch(function () {});
          }
        }
        beat.classList.toggle('is-active', index === next);
        beat.classList.toggle('is-shown', index <= next);
        beat.classList.toggle('is-near', Math.abs(index - next) <= 1);
      });
      dots.forEach(function (dot, index) { dot.classList.toggle('is-active', index === next); });
      if (fill) fill.style.transform = 'scaleY(' + (next / (total - 1)).toFixed(4) + ')';
      if (next >= 3) warmVideo();
      if (video) {
        var videoIndex = beats.indexOf(video.closest('[data-mobile-beat]'));
        if (next === videoIndex) { var p = video.play(); if (p && p.catch) p.catch(function () {}); }
        else if (!video.paused) video.pause();
      }
      if (next === 2) window.setTimeout(function () { if (active === 2 && pinned) playGrowth(); }, 320);
      else if (Math.abs(next - 2) > 1) resetGrowth();
    }

    // The app video and its poster are only fetched once the story is close.
    function warmVideo() {
      if (!video || video.dataset.warm) return;
      video.dataset.warm = 'true';
      if (video.dataset.poster) video.poster = video.dataset.poster;
      video.preload = 'metadata';
    }

    // Freeze the screen height in pixels. Taken once, and again only when the
    // width really changes (rotation), never when the address bar moves.
    var probe = null;
    function lockHeight() {
      if (!probe) {
        probe = document.createElement('div');
        probe.style.cssText = 'position:fixed;left:0;top:0;width:0;height:100svh;visibility:hidden;pointer-events:none;';
        document.body.appendChild(probe);
      }
      var small = probe.offsetHeight || window.innerHeight;
      var height = Math.round(Math.min(small, window.innerHeight || small));
      root.style.setProperty('--sh', height + 'px');
    }

    function measure() {
      measuredWidth = window.innerWidth;
      var y = window.scrollY || window.pageYOffset || 0;
      trackTop = track.getBoundingClientRect().top + y;
      var distance = Math.max(track.offsetHeight - sticky.offsetHeight, 1);
      segmentPx = distance / ((total - 1) + (END_HOLD_VH / SEGMENT_VH));
    }

    function update() {
      rafId = 0;
      if (!pinned) return;
      var y = window.scrollY || window.pageYOffset || 0;
      var pos = clamp((y - trackTop) / segmentPx, 0, total - 1);
      setActive(Math.round(pos));
      if (!scrolled && y > 30) { scrolled = true; root.classList.add('is-scrolled'); }
    }
    function onScroll() {
      if (!rafId) rafId = window.requestAnimationFrame(update);
    }
    function onResize() {
      // iPhone fires resize as the address bar slides. Heights here are in
      // fixed units, so only a real width change needs a new measurement.
      if (Math.abs(window.innerWidth - measuredWidth) > 2) { lockHeight(); measure(); }
      onScroll();
    }

    function enable() {
      if (pinned) return;
      pinned = true;
      root.classList.add('is-pinned');
      lockHeight();
      measure();
      if (!listening) {
        listening = true;
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onResize);
      }
      update();
    }
    function disable() {
      if (!pinned) return;
      pinned = false;
      root.classList.remove('is-pinned', 'is-growth-played');
      root.style.removeProperty('--sh');
      growthPlayed = false;
      active = -1;
      beats.forEach(function (beat) { beat.classList.remove('is-near', 'is-active', 'is-shown'); });
      if (fill) fill.style.transform = '';
      if (video && !video.paused) video.pause();
    }
    // Whether to pin is decided when the page opens and again only when the
    // width really changes (rotation). The address bar moving changes the
    // height many times a scroll; it must never switch the story on or off.
    var tallEnough = false;
    function sync(force) {
      var widthChanged = Math.abs(window.innerWidth - measuredWidth) > 2;
      if (force || widthChanged || !measuredWidth) tallEnough = window.innerHeight >= 560;
      if (storyQuery.matches && tallEnough && !reducedQuery.matches) {
        var wasPinned = pinned;
        enable();
        if (wasPinned && widthChanged) { lockHeight(); measure(); }
        onScroll();
      } else {
        measuredWidth = window.innerWidth;
        disable();
        if (storyQuery.matches) warmVideo();
      }
    }

    [storyQuery, reducedQuery].forEach(function (query) {
      var onChange = function () { sync(false); };
      if (typeof query.addEventListener === 'function') query.addEventListener('change', onChange);
      else if (typeof query.addListener === 'function') query.addListener(onChange);
    });
    window.addEventListener('orientationchange', function () {
      window.setTimeout(function () { sync(false); }, 150);
      window.setTimeout(function () { sync(false); }, 400);
    });
    window.addEventListener('load', function () { if (pinned) { measure(); onScroll(); } });
    window.addEventListener('pageshow', function () { if (pinned) { measure(); onScroll(); } });
    sync(true);
  })();
</script>
