---
---

<footer class="bg-joner-gray border-t border-gray-800 pb-20 md:pb-0">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <!-- Logo + tagline -->
    <div class="text-center mb-10">
      <a href="/" class="font-heading text-2xl font-bold text-white tracking-widest">JONER FOOTBALL</a>
      <p class="text-gray-400 mt-2 text-sm uppercase tracking-widest font-heading">Technique Above Everything</p>
    </div>

    <!-- Email capture -->
    <div class="mx-auto mb-10 max-w-4xl border border-gray-800 bg-joner-black p-6 md:p-8">
      <div class="mb-5 text-center">
        <p class="font-heading text-xs uppercase tracking-[0.24em] text-joner-red">Free Joner Football Updates</p>
        <h2 class="mt-2 font-heading text-2xl font-bold uppercase text-white md:text-3xl">Get The Right Stuff Sent To You</h2>
        <p class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed text-gray-400 font-body">Pick what you care about and we will send the best drills, camp news, app updates, and coaching resources to the right inbox.</p>
      </div>
      <form data-brevo-form data-form-name="footer-interest-capture" data-list-id="2" class="grid grid-cols-1 gap-3 md:grid-cols-[1fr_1fr_1fr_auto]">
        <input type="text" name="first_name" placeholder="First name" required class="min-h-[44px] border border-gray-700 bg-joner-gray px-4 py-3 text-sm text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
        <input type="email" name="email" placeholder="Email address" required class="min-h-[44px] border border-gray-700 bg-joner-gray px-4 py-3 text-sm text-white placeholder-gray-500 focus:border-joner-red focus:outline-none" />
        <select name="listId" required class="min-h-[44px] border border-gray-700 bg-joner-gray px-4 py-3 text-sm text-white focus:border-joner-red focus:outline-none">
          <option value="2">The App and Hub</option>
          <option value="6">Train in Person</option>
          <option value="11">Coaches Section</option>
          <option value="5">Elite Camps</option>
          <option value="11">Workshops</option>
          <option value="14">Shop, Books and Merch</option>
        </select>
        <button type="submit" class="btn-red min-h-[44px] whitespace-nowrap px-6 py-3 text-sm">Join</button>
      </form>
    </div>

    <!-- Quick links -->
    <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 mb-8">
      <a href="/training" class="text-gray-400 hover:text-white text-sm transition-colors">Training</a>
      <a href="/camps" class="text-gray-400 hover:text-white text-sm transition-colors">Camps</a>
      <a href="/workshops" class="text-gray-400 hover:text-white text-sm transition-colors">Workshops</a>
      <a href="/app" class="text-gray-400 hover:text-white text-sm transition-colors">App</a>
      <a href="/shop" class="text-gray-400 hover:text-white text-sm transition-colors">Shop</a>
      <a href="/about" class="text-gray-400 hover:text-white text-sm transition-colors">About</a>
      <a href="/reviews" class="text-gray-400 hover:text-white text-sm transition-colors">Reviews</a>
      <a href="/teams" class="text-gray-400 hover:text-white text-sm transition-colors">Teams</a>
      <a href="/contact" class="text-gray-400 hover:text-white text-sm transition-colors">Contact</a>
    </div>

    <!-- Social icons -->
    <div class="flex flex-wrap justify-center gap-x-6 gap-y-4 mb-4">
      <a href="https://www.instagram.com/jonerfootball/" target="_blank" rel="noopener" aria-label="Instagram" class="text-gray-400 hover:text-joner-red transition-colors">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
      </a>
