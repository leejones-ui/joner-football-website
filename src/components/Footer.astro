    <!-- Legal -->
    <div class="flex flex-wrap justify-center gap-x-4 gap-y-1 mb-3">
      <a href="/privacy" class="text-gray-500 hover:text-gray-300 text-xs transition-colors">Privacy Policy</a>
      <a href="/terms" class="text-gray-500 hover:text-gray-300 text-xs transition-colors">Terms & Conditions</a>
      <a href="/privacy#cookies" class="text-gray-500 hover:text-gray-300 text-xs transition-colors">Cookie Policy</a>
    </div>

    <p class="mx-auto mb-6 max-w-2xl text-center text-[10px] leading-relaxed text-gray-700">
      This site is protected by reCAPTCHA and the Google
      <a href="https://policies.google.com/privacy" target="_blank" rel="noopener" class="text-gray-600 hover:text-gray-400">Privacy Policy</a>
      and
      <a href="https://policies.google.com/terms" target="_blank" rel="noopener" class="text-gray-600 hover:text-gray-400">Terms of Service</a>
      apply.
    </p>

    <p class="text-center text-gray-600 text-xs">&copy; 2026 Joner Football. All rights reserved.</p>
  </div>
</footer>
