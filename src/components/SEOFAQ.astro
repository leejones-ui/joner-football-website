---
interface FAQItem {
  q: string
  a: string
}

interface Props {
  eyebrow?: string
  title?: string
  intro?: string
  items: FAQItem[]
}

const {
  eyebrow = 'FAQ',
  title = 'Common questions.',
  intro = '',
  items,
} = Astro.props
---

<section class="bg-joner-black py-16 md:py-24">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="mb-10 text-center">
      <p class="mb-3 font-heading text-sm uppercase tracking-[0.26em] text-joner-red">{eyebrow}</p>
      <h2 class="font-heading text-4xl font-bold uppercase leading-tight text-white md:text-5xl">{title}</h2>
      {intro && <p class="mx-auto mt-4 max-w-2xl font-body text-base leading-relaxed text-neutral-300 md:text-lg">{intro}</p>}
    </div>

    <div class="space-y-3">
      {items.map((item, index) => (
        <details class="group rounded-xl border border-white/10 bg-white/[0.04] p-5 shadow-[0_18px_60px_rgba(0,0,0,0.28)]" open={index === 0}>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-heading text-lg uppercase leading-tight text-white md:text-xl">
            <span>{item.q}</span>
            <span class="text-2xl leading-none text-joner-red transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-4 max-w-3xl font-body text-sm leading-relaxed text-neutral-300 md:text-base">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
