---
import BaseLayout from '../layouts/BaseLayout.astro'

const APP_LINK = 'https://app.jonerfootball.com'
const JOIN_LINK = 'https://jonerfootball.com/join/?utm_source=website&utm_medium=hub&utm_campaign=hub_app_cta'
const TECHNIQUE_LINK = '/technique-test'

const hubTiles = [
  { title: 'Joner Blogs', text: 'Weekly training ideas, player mindset and coaching notes from the Joner Football world.', href: '/blog', tag: 'Read' },
  { title: 'Technique Test', text: 'Find your level, spot the gaps and get a clear next step for your training.', href: TECHNIQUE_LINK, tag: 'Free' },
  { title: 'Free Training Video', text: 'Start with a free Joner Football training session from inside the app.', href: 'https://app.jonerfootball.com/programs/6-weeks-program-week-1-session-1-41ba39?category_id=236680', tag: 'Free' },
  { title: '100 Day Program Challenge', text: 'Start the 100 Day pathway and build your game with a clear daily plan.', href: 'https://joner-football-website.vercel.app/programmes', tag: 'Challenge' },
  { title: 'Latest Camps', text: 'See upcoming Joner Football camps, new cities and live booking pages.', href: 'https://jonerfootball.com/elitecampbookings/', tag: 'Book' },
  { title: 'How I Coach A Professional Footballer', text: 'Watch a full training video and see the detail behind a professional-level session.', href: 'https://app.jonerfootball.com/programs/t8-full-training-app-video-maria-2eee3f?category_id=236680', tag: 'Video' },
  { title: 'How Well Do You Know Joner Football?', text: 'Take the quiz. Real die hards get a discount code for the app.', href: '/hub/quiz', tag: 'Quiz' },
  { title: 'Coaches Resources', text: 'Free tools, equipment links and coaching resources for better sessions.', href: '/hub/resources', tag: 'Coaches' },
  { title: 'Open The App', text: 'Already a member? Jump straight back inside the full Joner Football training system.', href: APP_LINK, tag: 'App' },
]

export interface Props { appMode?: boolean }
const { appMode = false } = Astro.props
---

<main class="hub-page">
    <section class="hub-hero" aria-label="Joner Football Hub">
      <img class="hub-hero__media hub-hero__media--desktop" src="/images/hub-hero-desktop.jpg" alt="Joner Football Hub" loading="eager" />
      <img class="hub-hero__media hub-hero__media--mobile" src="/images/hub-hero-lee.jpg" alt="Joner Football Hub" loading="eager" />
      <div class="hub-hero__scrim" aria-hidden="true"></div>
      <div class="hub-hero__inner">
        <h1 class="hub-hero__title">Joner<br/>Football<br/>Hub</h1>
        <div class="hub-hero__rule" aria-hidden="true"></div>
        <p class="hub-hero__sub">All things Joner Football for FREE.</p>
      </div>
    </section>
    <section class="hub-welcome">
      <div class="hub-shell hub-welcome__inner">
        <div class="hub-welcome__copy">
          <p>Welcome to the Joner Football Hub. Every week I will be adding free blogs, football challenges, drills, quizzes, giveaways and updates from across the Joner Football world. Use it to test yourself, find something useful, then get back on the ball and do the work.</p>
          <div class="hub-signoff">
            <img src="/images/programmes/100-day/lee-avatar.jpg" alt="Lee Jones" loading="lazy" />
            <div>
              <strong>Lee Jones</strong>
              <span>Owner of Joner Football</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="hub-strip">
      <div class="hub-shell hub-strip__grid">
        <div><strong>Free</strong><span>No payment needed</span></div>
        <div><strong>Weekly</strong><span>Fresh ideas and challenges</span></div>
        <div><strong>Useful</strong><span>Players, parents and coaches</span></div>
        <div><strong>Free resources</strong><span>Blogs, tools and ideas</span></div>
      </div>
      <div class="hub-socials" aria-label="Joner Football social links">
        <a href="https://www.instagram.com/jonerfootball/" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0 5.838c-2.209 0-4 1.791-4 4s1.791 4 4 4 4-1.79 4-4-1.791-4-4-4zm6.406-2.184c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg></a>
        <a href="https://www.youtube.com/@jonerfootball" target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg></a>
        <a href="https://www.tiktok.com/@jonerfootball" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.79 1.54V6.79a4.85 4.85 0 0 1-1.02-.1z"/></svg></a>
        <a href="https://www.facebook.com/Jonerfootball/" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg></a>
        <a href="https://twitter.com/jonerfootball" target="_blank" rel="noopener" aria-label="X"><svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
        <a href="https://www.threads.net/@jonerfootball" target="_blank" rel="noopener" aria-label="Threads" class="hub-socials__threads">THREADS</a>
      </div>
    </section>

    <section class="hub-section hub-section--white">
      <div class="hub-shell">
        <div class="hub-section-head hub-section-head--dark">
          <p class="hub-eyebrow">Live now</p>
          <p>Pick a free tool, read a blog, take a challenge or jump back inside the app.</p>
        </div>
        <div class="hub-tile-grid">
          {hubTiles.map((tile) => (
            <a class="hub-tile" href={tile.href} target={tile.href.startsWith('http') ? '_blank' : undefined} rel={tile.href.startsWith('http') ? 'noopener' : undefined}>
              <span>{tile.tag}</span>
              <h3>{tile.title}</h3>
              <p>{tile.text}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    {!appMode && (
    <section class="hub-section hub-app-cta">
      <div class="hub-shell hub-app-cta__grid">
        <div>
          <p class="hub-eyebrow">Back inside the app</p>
          <h2>Already a member? Jump straight back in.</h2>
          <p>The Hub gives free value. The full Joner Football system lives inside the app with programs, full sessions and weekly content.</p>
        </div>
        <div class="hub-app-cta__buttons">
          <a href={APP_LINK} target="_blank" rel="noopener" class="hub-btn hub-btn--red">I Am A Member</a>
          <a href={JOIN_LINK} class="hub-btn hub-btn--outline">I Need To Sign Up</a>
        </div>
      </div>
    </section>
    )}

  </main>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Kanit:ital,wght@1,600;1,900&display=swap');
  .hub-page { background: #000; color: #fff; overflow: hidden; }
  .hub-shell { max-width: 1240px; margin: 0 auto; padding: 0 20px; }
  .hub-eyebrow { font-family: 'Kanit', 'Oswald', sans-serif; font-style: italic; text-transform: uppercase; letter-spacing: .2em; color: #E30613; font-size: .8rem; font-weight: 600; }
  /* Aspect-ratio container preserves the image's natural proportions. max-height
     uses min() so the cap softens on shorter viewports but still allows the image
     to render at full ratio on most desktops without head-cropping. */
  .hub-hero { position: relative; width: 100%; aspect-ratio: 16 / 9; max-height: min(900px, 88vh); min-height: 360px; display: flex; align-items: center; overflow: hidden; background: #000; isolation: isolate; }
  .hub-hero__media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 22%; display: block; z-index: 1; }
  .hub-hero__media--mobile { display: none; }
  .hub-hero__scrim { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,.85) 0%, rgba(0,0,0,.6) 35%, rgba(0,0,0,.15) 60%, rgba(0,0,0,0) 80%); z-index: 2; }
  .hub-hero__inner { position: relative; z-index: 3; height: 100%; width: min(1240px, calc(100% - 40px)); margin: 0 auto; padding: clamp(24px, 5vw, 64px) 0; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; }
  .hub-hero__title { font-family: 'Kanit', 'Oswald', sans-serif; font-style: italic; font-weight: 900; text-transform: uppercase; font-size: clamp(2.5rem, 7vw, 6rem); line-height: .92; letter-spacing: -0.01em; max-width: 12ch; margin: 0; text-shadow: 0 2px 30px rgba(0,0,0,.5); }
  .hub-hero__rule { width: 56px; height: 4px; background: #E30613; margin-top: clamp(20px, 2.5vw, 28px); }
  .hub-hero__sub { font-family: 'Kanit', 'Oswald', sans-serif; font-style: italic; text-transform: uppercase; font-size: clamp(.95rem, 1.6vw, 1.25rem); letter-spacing: .04em; color: rgba(255,255,255,.92); margin: clamp(16px, 2vw, 24px) 0 0; }
  .hub-actions { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 34px; }
  .hub-btn { display: inline-flex; align-items: center; justify-content: center; padding: 18px 26px; font-family: 'Kanit', 'Oswald', sans-serif; font-style: italic; text-transform: uppercase; font-weight: 700; letter-spacing: .04em; border: 2px solid transparent; text-decoration: none; }
  .hub-btn--red { background: #E30613; border-color: #E30613; color: #fff; }
  .hub-btn--outline { color: #fff; border-color: #fff; }
  .hub-phone-card { border: 2px solid #E30613; background: rgba(0,0,0,.72); padding: 34px; box-shadow: 0 24px 80px rgba(0,0,0,.45); max-width: 420px; margin-left: auto; }
  .hub-phone-card span { font-family: 'Kanit', 'Oswald', sans-serif; font-style: italic; color: #E30613; text-transform: uppercase; letter-spacing: .18em; font-size: .78rem; }
  .hub-phone-card strong { display: block; font-family: 'Kanit', 'Oswald', sans-serif; font-style: italic; font-size: 3rem; line-height: .9; text-transform: uppercase; margin-top: 14px; }
  .hub-phone-card p { color: rgba(255,255,255,.78); line-height: 1.55; }
  .hub-phone-card a { color: #fff; font-family: 'Kanit', 'Oswald', sans-serif; font-style: italic; text-transform: uppercase; }
  .hub-welcome { background: #fff; color: #000; padding: 58px 0; }
  .hub-welcome__inner { max-width: 900px; }
  .hub-welcome__copy { border-left: 5px solid #E30613; padding-left: 26px; }
  .hub-welcome__copy p { font-size: clamp(1.1rem, 2.2vw, 1.45rem); line-height: 1.55; margin: 0; color: rgba(0,0,0,.78); }
  .hub-signoff { display: flex; align-items: center; gap: 14px; margin-top: 26px; }
  .hub-signoff img { width: 62px; height: 62px; border-radius: 999px; object-fit: cover; border: 3px solid #E30613; }
  .hub-signoff strong { display: block; font-family: 'Kanit', 'Oswald', sans-serif; font-style: italic; text-transform: uppercase; font-size: 1.1rem; color: #000; }
  .hub-signoff span { display: block; color: rgba(0,0,0,.62); font-size: .92rem; }
  .hub-strip { border-top: 1px solid rgba(255,255,255,.14); border-bottom: 1px solid rgba(255,255,255,.14); }
  .hub-strip__grid { display: grid; grid-template-columns: repeat(4,1fr); padding-top: 0; padding-bottom: 0; }
  .hub-strip__grid div { padding: 22px 16px; border-right: 1px solid rgba(255,255,255,.14); text-align: center; }
  .hub-strip__grid div:last-child { border-right: 0; }
  .hub-strip strong { display: block; color: #E30613; font-family: 'Kanit', 'Oswald', sans-serif; font-style: italic; font-size: 1.8rem; text-transform: uppercase; }
  .hub-strip span { display: block; color: rgba(255,255,255,.66); font-size: .85rem; }
  .hub-socials { width: min(1240px, calc(100% - 40px)); margin: 0 auto; padding: 18px 0 20px; display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; border-top: 1px solid rgba(255,255,255,.14); }
  .hub-socials a { width: 44px; height: 44px; color: #fff; border: 1px solid rgba(255,255,255,.18); border-radius: 999px; display: inline-flex; align-items: center; justify-content: center; text-decoration: none; transition: border-color .16s ease, color .16s ease, transform .16s ease; }
  .hub-socials a:hover { border-color: #E30613; color: #E30613; transform: translateY(-2px); }
  .hub-socials svg { width: 20px; height: 20px; fill: currentColor; }
  .hub-socials a.hub-socials__threads { width: auto; padding: 0 16px; border-radius: 999px; font-family: 'Kanit', 'Oswald', sans-serif; font-style: italic; font-weight: 900; font-size: .78rem; letter-spacing: .08em; }
  .hub-section { padding: 96px 0; }
  .hub-section--black { background: #050505; }
  .hub-section--white { background: #fff; color: #000; }
  .hub-section-head { margin-bottom: 34px; }
  .hub-section-head h2, .hub-app-cta h2 { font-family: 'Kanit', 'Oswald', sans-serif; font-style: italic; text-transform: uppercase; font-size: clamp(2.4rem, 5vw, 4.8rem); line-height: .92; margin: 12px 0; }
  .hub-section-head--dark p:not(.hub-eyebrow) { color: rgba(0,0,0,.68); font-size: 1.05rem; }
  .hub-feature-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 22px; }
  .hub-feature { min-height: 430px; position: relative; overflow: hidden; display: flex; align-items: flex-end; text-decoration: none; color: #fff; border: 1px solid rgba(255,255,255,.18); }
  .hub-feature img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
  .hub-feature:hover img { transform: scale(1.04); }
  .hub-feature__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.1), rgba(0,0,0,.92)); }
  .hub-feature__copy { position: relative; padding: 34px; max-width: 560px; }
  .hub-feature__copy span, .hub-tile span { color: #E30613; font-family: 'Kanit', 'Oswald', sans-serif; font-style: italic; text-transform: uppercase; letter-spacing: .18em; font-size: .75rem; }
  .hub-feature__copy h3, .hub-tile h3 { font-family: 'Kanit', 'Oswald', sans-serif; font-style: italic; text-transform: uppercase; font-size: 2rem; line-height: .95; margin: 10px 0; }
  .hub-feature__copy p { color: rgba(255,255,255,.8); line-height: 1.55; }
  .hub-feature__copy strong { font-family: 'Kanit', 'Oswald', sans-serif; font-style: italic; text-transform: uppercase; }
  .hub-tile-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1px; background: rgba(0,0,0,.14); border: 1px solid rgba(0,0,0,.14); }
  .hub-tile { background: #fff; color: #000; padding: 30px; min-height: 230px; text-decoration: none; border: 2px solid rgba(0,0,0,.12); position: relative; transition: transform .16s ease, border-color .16s ease, box-shadow .16s ease; }
  .hub-tile::after { content: 'OPEN →'; position: absolute; left: 30px; bottom: 24px; font-family: 'Kanit', 'Oswald', sans-serif; font-style: italic; font-weight: 900; color: #E30613; letter-spacing: .12em; font-size: .78rem; }
  .hub-tile:hover { background: #fff; border-color: #E30613; transform: translateY(-4px); box-shadow: 0 18px 45px rgba(0,0,0,.12); }
  .hub-tile p { color: rgba(0,0,0,.68); line-height: 1.55; padding-bottom: 32px; }
  .hub-app-cta { background: #0A0A0A; padding: 88px 0; }
  .hub-app-cta__grid { display: grid; grid-template-columns: 1fr auto; gap: 38px; align-items: center; }
  .hub-app-cta p:not(.hub-eyebrow), .hub-game p { color: rgba(255,255,255,.76); max-width: 640px; line-height: 1.6; }
  .hub-app-cta__buttons { display: flex; gap: 14px; flex-wrap: wrap; justify-content: flex-end; }
  .hub-coming { background: #000; padding: 86px 0; }
  .hub-coming__grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1px; background: rgba(255,255,255,.16); border: 1px solid rgba(255,255,255,.16); }
  .hub-coming__card { background: #0A0A0A; padding: 34px; min-height: 260px; }
  .hub-coming__card--red { background: #E30613; }
  .hub-coming__card--red .hub-eyebrow { color: rgba(255,255,255,.8); }
  .hub-coming h2 { font-family: 'Kanit', 'Oswald', sans-serif; font-style: italic; text-transform: uppercase; font-size: clamp(2rem, 4vw, 3.4rem); line-height: .92; margin: 12px 0; }
  .hub-coming p:not(.hub-eyebrow) { color: rgba(255,255,255,.76); line-height: 1.6; }
  @media (max-width: 900px) {
    .hub-actions, .hub-app-cta__buttons { flex-direction: column; }
    .hub-btn { width: 100%; }
    .hub-strip__grid { grid-template-columns: 1fr 1fr; }
    .hub-strip__grid div:nth-child(2) { border-right: 0; }
    .hub-strip__grid div:nth-child(1), .hub-strip__grid div:nth-child(2) { border-bottom: 1px solid rgba(255,255,255,.14); }
    .hub-feature-grid, .hub-tile-grid, .hub-app-cta__grid, .hub-coming__grid { grid-template-columns: 1fr; }
    .hub-welcome { padding: 42px 0; }
    .hub-welcome__copy { padding-left: 18px; }
    .hub-section { padding: 72px 0; }
  }
  /* Hero stack switch happens earlier than the rest of the responsive layout, so the
     portrait phone image never grows into a 1000px-tall hero on small tablets. */
  @media (max-width: 720px) {
    .hub-hero { aspect-ratio: auto; max-height: none; min-height: 0; flex-direction: column; align-items: stretch; }
    .hub-hero__media--desktop { display: none; }
    .hub-hero__media--mobile { display: block; position: relative; inset: auto; width: 100%; height: auto; aspect-ratio: 1067 / 1600; object-fit: cover; object-position: 50% 25%; }
    .hub-hero__scrim { display: none; }
    .hub-hero__inner { position: relative; width: 100%; max-width: none; padding: 32px 22px 40px; background: #000; height: auto; align-items: flex-start; }
    .hub-hero__title { font-size: clamp(2.6rem, 12vw, 4.4rem); max-width: 100%; }
    .hub-hero__rule { width: 56px; }
  }
</style>
