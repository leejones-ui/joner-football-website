---
// Home page feature for Lee's book, Top 50 Coaching Drills (Lee, 16 Nov 2026: "add the book to the home page").
// Words are Lee's own, from the book page hero. Prices come from src/data/top50-book.ts.
import { top50Book as book } from '../data/top50-book'
---

<section class="hb" aria-labelledby="hb-title" data-home-book>
  <div class="hb-wrap">
    <a class="hb-cover" href={book.page} aria-label="Top 50 Coaching Drills by Lee Jones">
      <img src={book.cover} alt="Cover of Top 50 Coaching Drills by Lee Jones" width="800" height="1132" loading="lazy" decoding="async" />
    </a>
    <div class="hb-copy">
      <p class="hb-kicker">My new book</p>
      <h2 id="hb-title" class="hb-title">Top 50 Coaching Drills</h2>
      <p class="hb-big">20 years of coaching. <em>My top 50 drills.</em></p>
      <p class="hb-text">These are the drills I love and use the most. One page each. Every drill on video.</p>
      <a class="hb-btn" href={book.page} data-book-cta="home">See the book</a>
      <p class="hb-meta">Out {book.releaseLabel}. PDF {book.pdfPrice}. Paperback {book.paperbackPrice}.</p>
    </div>
  </div>
</section>

<style>
  .hb { position: relative; z-index: 2; isolation: isolate; padding: 64px 0; background: #0a0a0a; color: #fff; border-top: 1px solid rgba(255, 255, 255, 0.08); }
  .hb-wrap { display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; align-items: center; max-width: 1080px; margin: 0 auto; padding: 0 16px; }
  .hb-cover { display: block; justify-self: center; width: min(62vw, 300px); }
  .hb-cover img { display: block; width: 100%; height: auto; box-shadow: 0 28px 50px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.08); transform: rotate(-2deg); transition: transform 220ms ease; }
  .hb-cover:hover img, .hb-cover:focus-visible img { transform: rotate(0deg) translateY(-6px); }
  .hb-copy { text-align: center; }
  .hb-kicker { margin: 0 0 10px; font-family: var(--font-heading, 'Anton', sans-serif); font-size: 12px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--color-joner-red, #e30613); }
  .hb-title { margin: 0 0 14px; font-family: var(--font-heading, 'Anton', sans-serif); font-size: clamp(36px, 6vw, 64px); line-height: 1; text-transform: uppercase; }
  .hb-big { margin: 0 0 10px; font-size: clamp(19px, 2.4vw, 24px); font-weight: 700; line-height: 1.3; }
  .hb-big em { font-style: normal; color: var(--color-joner-red, #e30613); }
  .hb-text { margin: 0 auto 24px; max-width: 460px; font-size: 16px; line-height: 1.55; color: #d1d5db; }
  .hb-btn { display: flex; align-items: center; justify-content: center; min-height: 52px; padding: 0 28px; background: var(--color-joner-red, #e30613); color: #fff; font-weight: 800; font-size: 16px; text-decoration: none; transition: background 160ms ease, color 160ms ease; }
  .hb-btn:hover, .hb-btn:focus-visible { background: #fff; color: #0a0a0a; }
  .hb-meta { margin: 14px 0 0; font-size: 14px; color: #d1d5db; }
  @media (min-width: 768px) {
    .hb { padding: 88px 0; }
    .hb-wrap { grid-template-columns: minmax(0, 340px) minmax(0, 1fr); gap: 64px; padding: 0 24px; }
    .hb-cover { width: 100%; }
    .hb-copy { text-align: left; }
    .hb-text { margin-left: 0; }
    .hb-btn { display: inline-flex; }
  }
  @media (prefers-reduced-motion: reduce) { .hb-cover img { transition: none; } }
</style>
