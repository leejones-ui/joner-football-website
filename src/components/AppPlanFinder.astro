---
import { audiences, goals, contentGroups } from '../lib/app-plan-recommendation.js'
import '../styles/app-plan-finder.css'
const questions = [
  { key: 'roles', title: 'Which of these describe you?', hint: 'Select more than one if needed.', options: audiences },
  { key: 'goals', title: 'What are your goals?', hint: 'Select more than one if needed.', options: goals },
]
---
<div class="app-finder-banner">
  <div><strong>Not sure which plan?</strong><span>Three quick questions will help.</span></div>
  <button type="button" class="join-button outline" data-open-app-finder aria-haspopup="dialog" aria-controls="app-plan-finder">Find my plan <span aria-hidden="true">↗</span></button>
</div>
<dialog id="app-plan-finder" aria-labelledby="pf-dialog-title">
    <div class="pf-panel">
      <header class="pf-topbar"><div><p id="pf-dialog-title">Find my plan</p><p class="pf-step" aria-live="polite">Question 1 of 3</p></div><button type="button" class="pf-close" aria-label="Close plan finder">×</button></header>
      <div class="pf-progress" aria-hidden="true"><span></span></div>
      <div class="pf-scroll">
        {questions.map((q, index) => <fieldset data-finder-step={index} hidden={index !== 0}>
          <legend tabindex="-1">{q.title}</legend><p class="pf-hint">{q.hint}</p>
          <div class="pf-options">{q.options.map(option => <label class="pf-option"><input type="checkbox" name={`finder-${q.key}`} value={option.id}/><span class="pf-option-copy"><strong>{option.title}</strong></span><span class="pf-check" aria-hidden="true">✓</span></label>)}</div>
        </fieldset>)}
        <fieldset data-finder-step="2" hidden>
          <legend tabindex="-1">What would you like access to?</legend><p class="pf-hint">Select more than one if needed.</p>
          <label class="pf-option pf-everything"><input type="checkbox" name="finder-full" value="full"/><span class="pf-option-copy"><strong>Everything — the full library</strong></span><span class="pf-check" aria-hidden="true">✓</span></label>
          {contentGroups.map(group => <div class="pf-content-group"><h3>{group.title}</h3><div class="pf-options">{group.options.map(option => <label class="pf-option"><input type="checkbox" name="finder-content" value={option.id}/><span class="pf-option-copy"><strong>{option.title}</strong></span><span class="pf-check" aria-hidden="true">✓</span></label>)}</div></div>)}
        </fieldset>
        <fieldset data-finder-extra="access" hidden>
          <legend tabindex="-1">Who needs access?</legend><p class="pf-hint">Choose one.</p>
          <div class="pf-options pf-one-column">
            <label class="pf-option"><input type="radio" name="finder-access" value="individual"/><span class="pf-option-copy"><strong>Just me</strong><span>Training and coaching ideas for my own use</span></span><span class="pf-check" aria-hidden="true">✓</span></label>
            <label class="pf-option"><input type="radio" name="finder-access" value="group"/><span class="pf-option-copy"><strong>My players and coaches</strong><span>Separate logins, assignments and tracking</span></span><span class="pf-check" aria-hidden="true">✓</span></label>
            <label class="pf-option"><input type="radio" name="finder-access" value="both"/><span class="pf-option-copy"><strong>Both</strong><span>My own resources plus access for my group</span></span><span class="pf-check" aria-hidden="true">✓</span></label>
          </div>
        </fieldset>
        <fieldset data-finder-extra="coaching" hidden>
          <legend tabindex="-1">Want coaching resources too?</legend><p class="pf-hint">Your picks so far cover player training.</p>
          <div class="pf-options pf-one-column">
            <label class="pf-option"><input type="radio" name="finder-coaching" value="include"/><span class="pf-option-copy"><strong>Yes, include Coaches Only</strong><span>Session plans and coaching breakdowns</span></span><span class="pf-check" aria-hidden="true">✓</span></label>
            <label class="pf-option"><input type="radio" name="finder-coaching" value="training-only"/><span class="pf-option-copy"><strong>No, just my selected training</strong></span><span class="pf-check" aria-hidden="true">✓</span></label>
          </div>
        </fieldset>
        <section class="pf-result" hidden aria-labelledby="pf-result-title">
          <p class="pf-kicker">Your best fit</p><h2 id="pf-result-title" tabindex="-1"></h2><p class="pf-result-reason"></p>
          <div class="pf-matches"><h3>Your picks, covered</h3><ul></ul></div>
          <div class="pf-price-box"><p class="pf-price"></p><p class="pf-billing"></p><p class="pf-trial"></p></div>
          <a class="join-button pf-result-link" data-finder-result-link>See your plan</a>
          <p class="pf-account-note"></p>
          <aside class="pf-upgrade" hidden><h3>Want everything?</h3><p>Max adds Coaches Only, session plans and breakdowns.</p><a class="pf-text-link" href="#max" data-finder-max>Compare with Max <span aria-hidden="true">↗</span></a><p class="pf-upgrade-trial">Paid from day one. No free trial.</p></aside>
          <button type="button" class="pf-text-link pf-edit">Edit my answers</button>
        </section>
        <div class="pf-photo"><img src="/app/uploads/2026/05/soccer-coach-goal-instruction.webp" alt="Lee coaching players on the pitch" loading="lazy" width="600" height="600"/></div>
      </div>
      <footer class="pf-footer"><button type="button" class="pf-back" hidden>← Back</button><p class="pf-selection" aria-live="polite"></p><button type="button" class="join-button pf-next" disabled>Continue →</button></footer>
    </div>
</dialog>
<script>
  import { needsGroupQuestion, recommendAppPlan } from '../lib/app-plan-recommendation.js'
  const dialog = document.querySelector<HTMLDialogElement>('#app-plan-finder')!
  const panel = dialog.querySelector<HTMLElement>('.pf-panel')!
  const scroll = dialog.querySelector<HTMLElement>('.pf-scroll')!
  const next = dialog.querySelector<HTMLButtonElement>('.pf-next')!
  const back = dialog.querySelector<HTMLButtonElement>('.pf-back')!
  const result = dialog.querySelector<HTMLElement>('.pf-result')!
  const resultLink = dialog.querySelector<HTMLAnchorElement>('[data-finder-result-link]')!
  let step: number | string = 0
  let opener: HTMLElement | null = null
  let previousOverflow = ''
  let lastCompleted = ''
  const selected = (name: string) => [...dialog.querySelectorAll<HTMLInputElement>(`input[name="finder-${name}"]:checked`)].map(input => input.value)
  const answers = () => ({ roles: selected('roles'), goals: selected('goals'), content: selected('content'), fullLibrary: selected('full').length > 0, access: selected('access')[0], coaching: selected('coaching')[0] })
  function track(event: string, data = {}) {
    // Reuse consent-aware tracking; never send role or content-answer details.
    window.JonerTracking?.trackEvent(event, { custom_data: { page_path: location.pathname, finder_version: 'wishlist-v2', ...data } })
  }
  function updateResult() {
    const rec = recommendAppPlan(answers())
    if (!rec || 'needs' in rec) return
    const group = rec.id === 'club'
    result.dataset.plan = rec.id
    result.querySelector('h2')!.textContent = group ? 'Joner Football Teams' : `${rec.name} is your best fit.`
    result.querySelector('.pf-result-reason')!.textContent = rec.reason
    result.querySelector('ul')!.replaceChildren(...rec.matches.map(match => { const li = document.createElement('li'); li.textContent = match; return li }))
    result.querySelector('.pf-account-note')!.textContent = rec.note
    const card = document.getElementById(rec.id)
    const annual = document.querySelector('[data-billing="annual"]')?.getAttribute('aria-pressed') === 'true'
    const amount = card?.querySelector('.billing-price')?.textContent?.trim() || ''
    const currency = document.querySelector('#currency-note')?.textContent?.replace('Prices shown in ', '') || 'USD'
    result.querySelector('.pf-price')!.textContent = group ? 'Built for your group.' : `${amount}${annual ? ' /mo' : ' /month'}`
    result.querySelector('.pf-billing')!.textContent = group ? 'Compare plans for your player and coach numbers.' : `${card?.querySelector('.billing-sub')?.textContent || ''} · ${currency}`
    result.querySelector('.pf-trial')!.textContent = group ? 'App access varies by Teams plan and role.' : rec.id === 'max' ? 'Paid access from day one. No free trial.' : 'Start with a 7-day free trial.'
    resultLink.href = group ? '/teams/' : `#${rec.id}`
    resultLink.textContent = group ? 'Explore Teams plans ↗' : `See ${rec.name} plan ↗`
    resultLink.dataset.planTarget = rec.id
    resultLink.dataset.gaEvent = group ? 'JoinClubPricingClick' : 'JoinPlanAnchorClick'
    resultLink.classList.toggle('max-cta', rec.id === 'max')
    result.querySelector<HTMLElement>('.pf-upgrade')!.hidden = group || rec.id === 'max'
  }
  function render(focus = false) {
    const isResult = step === 'result'
    let field: HTMLFieldSetElement | null = null
    dialog.querySelectorAll<HTMLFieldSetElement>('fieldset').forEach(el => {
      const visible = typeof step === 'number' ? el.dataset.finderStep === String(step) : el.dataset.finderExtra === step
      el.hidden = !visible
      if (visible) field = el
    })
    result.hidden = !isResult
    dialog.querySelector<HTMLElement>('.pf-footer')!.hidden = isResult
    dialog.querySelector<HTMLElement>('.pf-step')!.textContent = isResult ? 'Your recommendation' : typeof step === 'number' ? `Question ${step + 1} of 3` : 'One quick check'
    dialog.querySelector<HTMLElement>('.pf-progress span')!.style.width = `${typeof step === 'number' ? (step + 1) / 3 * 100 : 100}%`
    dialog.querySelector<HTMLElement>('.pf-photo')!.hidden = isResult
    back.hidden = step === 0
    const inputs = field ? [...(field as HTMLFieldSetElement).querySelectorAll<HTMLInputElement>('input:checked')] : []
    next.disabled = !inputs.length
    next.textContent = typeof step === 'number' && step < 2 ? 'Continue →' : step === 2 && needsGroupQuestion(answers()) ? 'Continue →' : 'Find my plan ↗'
    dialog.querySelector<HTMLElement>('.pf-selection')!.textContent = inputs.length ? step === 2 && selected('full').length ? 'Full library selected' : `${inputs.length} selected` : ''
    panel.dataset.view = String(step)
    if (isResult) updateResult()
    if (focus) {
      scroll.scrollTop = 0
      const target = isResult ? result.querySelector<HTMLElement>('h2') : (field as HTMLFieldSetElement | null)?.querySelector<HTMLElement>('legend')
      target?.focus({ preventScroll: true })
    }
  }
  function finish() {
    const rec = recommendAppPlan(answers())
    if (!rec) return
    if ('needs' in rec) { step = rec.needs; render(true); return }
    step = 'result'; render(true)
    const signature = JSON.stringify(answers())
    if (signature !== lastCompleted) { track('JoinPlanFinderComplete', { plan: rec.id }); lastCompleted = signature }
  }
  document.querySelectorAll<HTMLElement>('[data-open-app-finder]').forEach(button => button.addEventListener('click', () => {
    if (dialog.open) return
    opener = button; previousOverflow = document.body.style.overflow
    render(); dialog.showModal(); document.body.style.overflow = 'hidden'; render(true)
    track('JoinPlanFinderOpen')
  }))
  dialog.querySelector('.pf-close')!.addEventListener('click', () => dialog.close())
  dialog.addEventListener('close', () => { document.body.style.overflow = previousOverflow; opener?.focus({ preventScroll: true }) })
  dialog.addEventListener('change', event => {
    const input = event.target as HTMLInputElement
    if (input.name === 'finder-full' && input.checked) dialog.querySelectorAll<HTMLInputElement>('input[name="finder-content"]').forEach(el => el.checked = false)
    if (input.name === 'finder-content' && input.checked) dialog.querySelector<HTMLInputElement>('input[name="finder-full"]')!.checked = false
    if (typeof step === 'number') dialog.querySelectorAll<HTMLInputElement>('input[name="finder-access"], input[name="finder-coaching"]').forEach(el => el.checked = false)
    if (input.name === 'finder-access') dialog.querySelectorAll<HTMLInputElement>('input[name="finder-coaching"]').forEach(el => el.checked = false)
    render()
  })
  next.addEventListener('click', () => { if (next.disabled) return; if (typeof step === 'number' && step < 2) { step++; render(true) } else finish() })
  back.addEventListener('click', () => { step = typeof step === 'number' ? Math.max(0, step - 1) : step === 'coaching' && needsGroupQuestion(answers()) ? 'access' : 2; render(true) })
  dialog.querySelector('.pf-edit')!.addEventListener('click', () => { step = 0; render(true) })
  document.addEventListener('app-billing-updated', () => { if (step === 'result') updateResult() })
  function goToPlan(event: MouseEvent) {
    const link = event.currentTarget as HTMLAnchorElement
    const hash = link.getAttribute('href')
    if (!hash?.startsWith('#') || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
    event.preventDefault(); dialog.close()
    if (link.hasAttribute('data-finder-max')) track('JoinPlanFinderUpgradeClick', { plan: 'max' })
    requestAnimationFrame(() => {
      const card = document.getElementById(hash.slice(1))
      card?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth', block: 'start' })
      card?.querySelector<HTMLElement>('h2')?.focus({ preventScroll: true })
    })
  }
  resultLink.addEventListener('click', goToPlan)
  dialog.querySelector<HTMLAnchorElement>('[data-finder-max]')!.addEventListener('click', goToPlan)
  document.querySelector('[data-finder-compare]')?.addEventListener('click', () => track('JoinPlanFinderSkip'))
  render()
</script>
