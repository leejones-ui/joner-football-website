---
const tiles = [
  { label: 'The APP', href: '/app', className: 'app' },
  { label: 'Train in Person', href: '/training', className: 'train' },
  { label: 'Coaches Section', href: '/app/for-coaches', className: 'coaches' },
  { label: 'Elite Camps', href: '/camps', className: 'camps' },
  { label: 'Workshops', href: '/workshops', className: 'workshops' },
  { label: 'The JF HUB', href: '/hub', className: 'hub' },
  { label: 'Player', href: '/app', className: 'player' },
  { label: 'Parent', href: '/training#joners-juniors', className: 'parent' },
  { label: 'Coach', href: '/app/for-coaches', className: 'coach' },
]
---

<div class="cns" aria-label="Choose Your Next Step">
  <img
    class="cns-bg"
    src="/images/home-storyboard/08-choose-next-step.webp"
    alt="Choose Your Next Step: The App, Train in Person, Coaches Section, Elite Camps, Workshops, The JF HUB, Player, Parent and Coach"
    loading="lazy"
    decoding="async"
  />

  <nav class="cns-hotspots" aria-label="Choose your next step">
    {tiles.map((tile) => (
      <a class:list={['cns-hotspot', tile.className]} href={tile.href} aria-label={tile.label}>
        <span>{tile.label}</span>
      </a>
    ))}
  </nav>
</div>

<style>
  .cns {
    position: absolute;
    inset: 0;
    z-index: 45;
    overflow: hidden;
    background: #000;
  }

  .cns-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    pointer-events: none;
    user-select: none;
  }

  .cns-hotspots {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .cns-hotspot {
    position: absolute;
    display: block;
    border: 1px solid rgba(255,255,255,0);
    border-radius: 0.55rem;
    background: rgba(204,0,0,0);
    outline: none;
    text-decoration: none;
    transition:
      background-color 280ms cubic-bezier(.2,.7,.2,1),
      border-color 280ms cubic-bezier(.2,.7,.2,1),
      box-shadow 280ms cubic-bezier(.2,.7,.2,1),
      transform 200ms cubic-bezier(.2,.7,.2,1);
  }

  .cns-hotspot span {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .cns-hotspot:hover,
  .cns-hotspot:focus-visible {
    background: rgba(204,0,0,0.12);
    border-color: rgba(204,0,0,0.82);
    box-shadow:
      inset 0 0 0 1px rgba(204,0,0,0.42),
      0 0 1.6rem rgba(204,0,0,0.28);
    transform: translateY(-2px);
  }

  .cns-hotspot:active {
    transform: translateY(0);
    transition-duration: 80ms;
  }

  .cns-hotspot.app { left: 8.05%; top: 53.15%; width: 19.2%; height: 12.45%; }
  .cns-hotspot.train { left: 27.95%; top: 53.15%; width: 19.35%; height: 12.45%; }
  .cns-hotspot.coaches { left: 47.7%; top: 53.15%; width: 19.5%; height: 12.45%; }
  .cns-hotspot.camps { left: 8.05%; top: 67.1%; width: 19.2%; height: 12.55%; }
  .cns-hotspot.workshops { left: 27.95%; top: 67.1%; width: 19.35%; height: 12.55%; }
  .cns-hotspot.hub { left: 47.7%; top: 67.1%; width: 19.5%; height: 12.55%; }
  .cns-hotspot.player { left: 8.05%; top: 81.1%; width: 19.2%; height: 12.35%; }
  .cns-hotspot.parent { left: 27.95%; top: 81.1%; width: 19.35%; height: 12.35%; }
  .cns-hotspot.coach { left: 47.7%; top: 81.1%; width: 19.5%; height: 12.35%; }

  @media (max-width: 767px) {
    .cns-bg {
      object-position: 42% 50%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cns-hotspot {
      transition: none;
    }
  }
</style>
