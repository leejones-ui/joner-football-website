---
const tiles = [
  {
    label: 'The APP',
    href: '/app',
    icon: 'phone',
    eyebrow: 'Train online',
  },
  {
    label: 'Train in Person',
    href: '/training',
    icon: 'people',
    eyebrow: 'Sydney sessions',
  },
  {
    label: 'Coaches Section',
    href: '/app/for-coaches',
    icon: 'whistle',
    eyebrow: 'Plan better',
  },
  {
    label: 'Elite Camps',
    href: '/camps',
    icon: 'trophy',
    eyebrow: 'Worldwide',
  },
  {
    label: 'Workshops',
    href: '/workshops',
    icon: 'cap',
    eyebrow: 'Learn live',
  },
  {
    label: 'The JF HUB',
    href: '/hub',
    icon: 'jf',
    eyebrow: 'Free resources',
  },
  {
    label: 'Player',
    href: '/app',
    icon: 'player',
    eyebrow: 'Improve your game',
  },
  {
    label: 'Parent',
    href: '/training#joners-juniors',
    icon: 'parent',
    eyebrow: 'Find a pathway',
  },
  {
    label: 'Coach',
    href: '/app/for-coaches',
    icon: 'clipboard',
    eyebrow: 'Coach with clarity',
  },
]
---

<section class="cns" aria-label="Choose Your Next Step">
  <div class="cns-photo" aria-hidden="true">
    <img
      src="/images/home-storyboard/07-action-coach.webp"
      alt=""
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="cns-shade" aria-hidden="true"></div>

  <span class="cns-corner cns-corner--tl" aria-hidden="true"></span>
  <span class="cns-corner cns-corner--tr" aria-hidden="true"></span>
  <span class="cns-corner cns-corner--bl" aria-hidden="true"></span>
  <span class="cns-corner cns-corner--br" aria-hidden="true"></span>

  <div class="cns-inner">
    <header class="cns-head">
      <h2 class="cns-title">
        <span class="cns-title-row">Choose Your</span>
        <span class="cns-title-row cns-title-row--red">Next Step</span>
      </h2>
      <span class="cns-rule" aria-hidden="true"></span>
      <p class="cns-eyebrow">Elite training. Real development. Lasting impact.</p>
    </header>

    <nav class="cns-grid" aria-label="Pick your path">
      {tiles.map((tile) => (
        <a class="cns-tile" href={tile.href} aria-label={tile.label} data-icon={tile.icon}>
          <span class="cns-tile-icon" aria-hidden="true">
            {tile.icon === 'phone' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="6" y="2.5" width="12" height="19" rx="2.4" />
                <line x1="11" y1="18.5" x2="13" y2="18.5" />
              </svg>
            )}
            {tile.icon === 'people' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="8" r="3.2" />
                <path d="M3 19c0-3.3 2.7-6 6-6s6 2.7 6 6" />
                <circle cx="17" cy="9" r="2.4" />
                <path d="M15.6 13.6c2.6.5 4.4 2.7 4.4 5.4" />
              </svg>
            )}
            {tile.icon === 'whistle' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 13a5 5 0 0 1 5-5h9l4-2v9a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5z" />
                <circle cx="8.5" cy="13" r="1.6" fill="currentColor" />
              </svg>
            )}
            {tile.icon === 'trophy' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 4h8v5a4 4 0 0 1-8 0z" />
                <path d="M8 6H5a3 3 0 0 0 3 3" />
                <path d="M16 6h3a3 3 0 0 1-3 3" />
                <path d="M10 13v3h4v-3" />
                <line x1="8" y1="20" x2="16" y2="20" />
                <line x1="12" y1="16" x2="12" y2="20" />
              </svg>
            )}
            {tile.icon === 'cap' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 9l10-4 10 4-10 4z" />
                <path d="M6 11v4c0 1.5 2.7 3 6 3s6-1.5 6-3v-4" />
                <line x1="22" y1="9" x2="22" y2="14" />
              </svg>
            )}
            {tile.icon === 'jf' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
                <path d="M3.5 4h17v3.5l-1.5 1v9l-7 3-7-3v-9l-1.5-1z" />
                <path d="M9 8.5v5a2 2 0 0 1-2 2" stroke-linecap="round" />
                <path d="M13 8.5h4M13 11.5h3" stroke-linecap="round" />
              </svg>
            )}
            {tile.icon === 'player' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="6" r="2.6" />
                <path d="M8 21l1.2-6.4 2.8-1.6 2.8 1.6L16 21" />
                <path d="M9.5 13l-3 .5M14.5 13l3 .5" />
              </svg>
            )}
            {tile.icon === 'parent' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="8" cy="7" r="2.6" />
                <circle cx="16" cy="8" r="2.2" />
                <path d="M3 20c0-2.8 2.2-5 5-5s5 2.2 5 5" />
                <path d="M13 20c0-2.4 1.8-4.4 4-4.4s4 2 4 4.4" />
              </svg>
            )}
            {tile.icon === 'clipboard' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="6" y="4" width="12" height="17" rx="2" />
                <rect x="9" y="2.5" width="6" height="3" rx="1" />
                <line x1="9" y1="10" x2="15" y2="10" />
                <line x1="9" y1="13.5" x2="15" y2="13.5" />
                <line x1="9" y1="17" x2="13" y2="17" />
              </svg>
            )}
          </span>
          <span class="cns-tile-text">
            <span class="cns-tile-eyebrow">{tile.eyebrow}</span>
            <span class="cns-tile-label">{tile.label}</span>
          </span>
          <span class="cns-tile-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <line x1="6" y1="12" x2="17" y2="12" />
              <polyline points="12 7 17 12 12 17" />
            </svg>
          </span>
        </a>
      ))}
    </nav>
  </div>
</section>

<style>
  .cns {
    --rail: 80px;
    position: relative;
    isolation: isolate;
    width: 100%;
    background: #000;
    color: #fff;
    overflow: hidden;
    padding: clamp(4rem, 7vw, 7rem) clamp(1.25rem, 4vw, 4rem) clamp(4rem, 7vw, 6rem);
    padding-left: max(var(--rail), clamp(1.25rem, 4vw, 4rem));
  }

  .cns-photo {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .cns-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 78% 35%;
    opacity: 0.85;
  }

  .cns-shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.78) 40%, rgba(0,0,0,0.45) 70%, rgba(0,0,0,0.2) 100%),
      linear-gradient(180deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.15) 30%, rgba(0,0,0,0.55) 100%);
  }

  .cns-corner {
    position: absolute;
    z-index: 2;
    width: 38px;
    height: 38px;
    border: 2px solid #cc0000;
    pointer-events: none;
  }
  .cns-corner--tl { top: 18px; left: 18px; border-right: 0; border-bottom: 0; }
  .cns-corner--tr { top: 18px; right: 18px; border-left: 0; border-bottom: 0; }
  .cns-corner--bl { bottom: 18px; left: 18px; border-right: 0; border-top: 0; }
  .cns-corner--br { bottom: 18px; right: 18px; border-left: 0; border-top: 0; }

  .cns-inner {
    position: relative;
    z-index: 3;
    max-width: 1280px;
    margin: 0 auto;
  }

  .cns-head {
    max-width: 60ch;
    margin-bottom: clamp(2rem, 4vw, 3.25rem);
  }

  .cns-title {
    margin: 0;
    font-family: 'Anton', Impact, 'Arial Narrow Bold', sans-serif;
    font-style: italic;
    font-weight: 900;
    text-transform: uppercase;
    line-height: 0.88;
    letter-spacing: 0.02em;
    font-size: clamp(3rem, 7vw, 6.25rem);
    text-shadow: 0 1.4rem 3rem rgba(0,0,0,0.55);
  }

  .cns-title-row {
    display: block;
  }
  .cns-title-row--red {
    color: #cc0000;
  }

  .cns-rule {
    display: block;
    width: 56px;
    height: 4px;
    background: #cc0000;
    margin: clamp(0.85rem, 1.4vw, 1.15rem) 0 clamp(0.9rem, 1.4vw, 1.15rem);
  }

  .cns-eyebrow {
    margin: 0;
    font-family: 'Anton', Impact, 'Arial Narrow Bold', sans-serif;
    font-style: italic;
    font-size: clamp(0.78rem, 0.95vw, 0.95rem);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.78);
  }

  .cns-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.7rem, 1vw, 1rem);
  }

  .cns-tile {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(0.7rem, 1.1vw, 1rem);
    padding: clamp(0.85rem, 1.15vw, 1.1rem) clamp(0.95rem, 1.4vw, 1.35rem);
    min-height: clamp(72px, 7vw, 90px);
    background:
      linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0)) ,
      rgba(10,10,10,0.92);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 14px;
    color: #fff;
    text-decoration: none;
    overflow: hidden;
    will-change: transform;
    transition:
      transform 280ms cubic-bezier(.2,.7,.2,1),
      border-color 280ms cubic-bezier(.2,.7,.2,1),
      background-color 280ms cubic-bezier(.2,.7,.2,1),
      box-shadow 280ms cubic-bezier(.2,.7,.2,1);
  }

  .cns-tile::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 80% at 12% 0%, rgba(204,0,0,0.18), transparent 55%);
    opacity: 0;
    transition: opacity 280ms cubic-bezier(.2,.7,.2,1);
    pointer-events: none;
  }

  .cns-tile:hover,
  .cns-tile:focus-visible {
    transform: translateY(-2px);
    border-color: rgba(204,0,0,0.95);
    background-color: rgba(14,4,4,0.94);
    box-shadow:
      inset 0 0 0 1px rgba(204,0,0,0.6),
      0 14px 38px -14px rgba(204,0,0,0.55);
    outline: none;
  }

  .cns-tile:hover::before,
  .cns-tile:focus-visible::before {
    opacity: 1;
  }

  .cns-tile:active {
    transform: translateY(0);
    transition-duration: 80ms;
  }

  .cns-tile-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    color: #fff;
  }

  .cns-tile-icon svg {
    width: 100%;
    height: 100%;
  }

  .cns-tile-text {
    position: relative;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .cns-tile-eyebrow {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.55);
    line-height: 1;
  }

  .cns-tile-label {
    font-family: 'Anton', Impact, 'Arial Narrow Bold', sans-serif;
    font-style: italic;
    font-size: clamp(1.1rem, 1.45vw, 1.5rem);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1;
    color: #fff;
  }

  .cns-tile-arrow {
    position: relative;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: #cc0000;
    color: #fff;
    transition: transform 280ms cubic-bezier(.2,.7,.2,1), background-color 280ms cubic-bezier(.2,.7,.2,1);
  }

  .cns-tile-arrow svg {
    width: 16px;
    height: 16px;
  }

  .cns-tile:hover .cns-tile-arrow,
  .cns-tile:focus-visible .cns-tile-arrow {
    transform: translateX(4px);
    background: #ff1a1a;
  }

  @media (max-width: 900px) {
    .cns {
      padding-left: clamp(1.25rem, 5vw, 2.5rem);
    }
    .cns-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cns-corner { width: 26px; height: 26px; }
  }

  @media (max-width: 560px) {
    .cns-grid {
      grid-template-columns: 1fr;
    }
    .cns-photo img {
      object-position: 70% 30%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cns-tile,
    .cns-tile::before,
    .cns-tile-arrow {
      transition: none;
    }
  }
</style>
