---
const productTiles = [
  { label: 'The APP',          href: '/app',                       icon: 'phone',     eyebrow: 'Train online' },
  { label: 'Train in Person',  href: '/training',                  icon: 'people',    eyebrow: 'Sydney sessions' },
  { label: 'Coaches Section',  href: '/app/for-coaches',           icon: 'whistle',   eyebrow: 'Plan better' },
]

const programTiles = [
  { label: 'Elite Camps',      href: '/camps',                     icon: 'trophy',    eyebrow: 'Worldwide' },
  { label: 'Workshops',        href: '/workshops',                 icon: 'cap',       eyebrow: 'Learn live' },
  { label: 'The JF HUB',       href: '/hub',                       icon: 'jf',        eyebrow: 'Free resources' },
]

const roleTiles = [
  { label: 'Player',           href: '/app',                       icon: 'player',    eyebrow: 'Improve your game' },
  { label: 'Parent',           href: '/training#joners-juniors',   icon: 'parent',    eyebrow: 'Find a pathway' },
  { label: 'Coach',            href: '/app/for-coaches',           icon: 'clipboard', eyebrow: 'Coach with clarity' },
]

const allTiles = [...productTiles, ...programTiles, ...roleTiles]
---

<div class="cns-block" data-cns-block>
  <header class="cns-head">
    <h2 class="cns-title">
      <span class="cns-title-row">Choose Your</span>
      <span class="cns-title-row cns-title-row--red">Next Step</span>
    </h2>
    <span class="cns-rule" aria-hidden="true"></span>
    <p class="cns-eyebrow">Elite training. Real development. Lasting impact.</p>
  </header>

  <div class="cns-grid-wrap">
    <div class="cns-grid cns-grid--top" aria-label="Joner Football products and programs">
      {[...productTiles, ...programTiles].map((tile) => (
        <a class="cns-tile" href={tile.href} aria-label={tile.label}>
          <span class="cns-tile-icon" aria-hidden="true">
            {tile.icon === 'phone' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <rect x="6" y="2.5" width="12" height="19" rx="2.6" />
                <line x1="10.5" y1="5" x2="13.5" y2="5" />
                <circle cx="12" cy="18.6" r="0.6" fill="currentColor" stroke="none" />
              </svg>
            )}
            {tile.icon === 'people' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="7" r="2.7" />
                <circle cx="5.4" cy="8.4" r="2.2" />
                <circle cx="18.6" cy="8.4" r="2.2" />
                <path d="M6 20c0-3.3 2.7-6 6-6s6 2.7 6 6" />
                <path d="M1.6 19c0-2.4 1.7-4.5 4-4.9" />
                <path d="M22.4 19c0-2.4-1.7-4.5-4-4.9" />
              </svg>
            )}
            {tile.icon === 'whistle' && (
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M21.5 8.4l-2.7 1V7.4a1.4 1.4 0 0 0-1.4-1.4H8.5a5.6 5.6 0 0 0-5.6 5.6v0.6a5.6 5.6 0 0 0 5.6 5.6h6.7a5.6 5.6 0 0 0 5.6-5.6v-0.7l2.7 1a0.5 0.5 0 0 0 0.7-0.5V8.9a0.5 0.5 0 0 0-0.7-0.5zM8.5 13.6a1.6 1.6 0 1 1 0-3.2 1.6 1.6 0 0 1 0 3.2z" />
              </svg>
            )}
            {tile.icon === 'trophy' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 4h8v5.5a4 4 0 0 1-8 0z" />
                <path d="M8 5.5H5.4A1.4 1.4 0 0 0 4 6.9V8a3.5 3.5 0 0 0 3.5 3.5" />
                <path d="M16 5.5h2.6A1.4 1.4 0 0 1 20 6.9V8a3.5 3.5 0 0 1-3.5 3.5" />
                <path d="M10 13.5v3.2h4v-3.2" />
                <line x1="8.5" y1="20" x2="15.5" y2="20" />
                <line x1="12" y1="16.7" x2="12" y2="20" />
              </svg>
            )}
            {tile.icon === 'cap' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 9.5l10-4.2 10 4.2-10 4.2z" />
                <path d="M6.5 11.4v3.6c0 1.4 2.5 2.6 5.5 2.6s5.5-1.2 5.5-2.6v-3.6" />
                <line x1="22" y1="9.5" x2="22" y2="15" />
                <path d="M22 15c0 0.6-0.4 1.1-1 1.1s-1-0.5-1-1.1" />
              </svg>
            )}
            {tile.icon === 'jf' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
                <path d="M4 3.6h16v2.6l-1.4 0.9v8.5c0 0.7-0.4 1.4-1 1.7l-5.6 3a2 2 0 0 1-2 0l-5.6-3a2 2 0 0 1-1-1.7V7.1L4 6.2z" />
                <path d="M10.4 8.6v4.5c0 0.9-0.7 1.6-1.6 1.6" stroke-linecap="round" />
                <path d="M13 8.6h3.4M13 11.2h2.6" stroke-linecap="round" />
              </svg>
            )}
          </span>
          <span class="cns-tile-text">
            <span class="cns-tile-eyebrow">{tile.eyebrow}</span>
            <span class="cns-tile-label">{tile.label}</span>
          </span>
          <span class="cns-tile-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <line x1="6" y1="12" x2="17" y2="12" />
              <polyline points="12 7 17 12 12 17" />
            </svg>
          </span>
        </a>
      ))}
    </div>

    <div class="cns-divider" role="presentation">
      <span class="cns-divider-line" aria-hidden="true"></span>
      <span class="cns-divider-label">Which one are you?</span>
      <span class="cns-divider-line" aria-hidden="true"></span>
    </div>

    <div class="cns-grid cns-grid--roles" aria-label="Pick your role">
      {roleTiles.map((tile) => (
        <a class="cns-tile cns-tile--role" href={tile.href} aria-label={tile.label}>
          <span class="cns-tile-icon" aria-hidden="true">
            {tile.icon === 'player' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="13.5" cy="4.4" r="1.8" />
                <path d="M8.5 9.6l4-1.4 2.8 2.6 2.4 0.9" />
                <path d="M12.5 10.8l-1.6 4.4 3 2.4-1.4 4" />
                <path d="M10.9 15.2l-3.4 0.6" />
                <circle cx="6.4" cy="20.4" r="1.7" />
                <line x1="7.6" y1="19.2" x2="9" y2="17.8" />
              </svg>
            )}
            {tile.icon === 'parent' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="6.6" r="2.5" />
                <circle cx="5.6" cy="8.4" r="2.1" />
                <circle cx="18.4" cy="8.4" r="2.1" />
                <path d="M6.4 19.5c0-3.1 2.5-5.6 5.6-5.6s5.6 2.5 5.6 5.6" />
                <path d="M1.8 18.4c0-2.3 1.6-4.2 3.8-4.6" />
                <path d="M22.2 18.4c0-2.3-1.6-4.2-3.8-4.6" />
              </svg>
            )}
            {tile.icon === 'clipboard' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <rect x="5.5" y="4.2" width="13" height="17" rx="1.8" />
                <rect x="9" y="2.5" width="6" height="3" rx="1" />
                <circle cx="9" cy="11" r="0.9" fill="currentColor" stroke="none" />
                <circle cx="15" cy="11" r="0.9" fill="currentColor" stroke="none" />
                <circle cx="12" cy="16.6" r="0.9" fill="currentColor" stroke="none" />
                <path d="M9.7 11.3 L11.6 15.8" />
                <path d="M14.3 11.3 L12.4 15.8" />
              </svg>
            )}
          </span>
          <span class="cns-tile-text">
            <span class="cns-tile-eyebrow">{tile.eyebrow}</span>
            <span class="cns-tile-label">{tile.label}</span>
          </span>
          <span class="cns-tile-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <line x1="6" y1="12" x2="17" y2="12" />
              <polyline points="12 7 17 12 12 17" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</div>

<style>
  .cns-block {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    width: 100%;
    color: #fff;
  }

  .cns-head { max-width: 60ch; }

  .cns-title {
    margin: 0;
    font-family: 'Anton', Impact, 'Arial Narrow Bold', sans-serif;
    font-style: italic;
    font-weight: 900;
    text-transform: uppercase;
    line-height: 0.86;
    letter-spacing: 0.02em;
    font-size: clamp(2.6rem, 5.6vw, 5.4rem);
    text-shadow: 0 1.4rem 3rem rgba(0,0,0,0.55);
  }
  .cns-title-row { display: block; }
  .cns-title-row--red { color: #cc0000; }

  .cns-rule {
    display: block;
    width: 64px;
    height: 4px;
    background: #cc0000;
    margin: clamp(0.7rem, 1.2vw, 1rem) 0;
  }

  .cns-eyebrow {
    margin: 0;
    font-family: 'Anton', Impact, 'Arial Narrow Bold', sans-serif;
    font-style: italic;
    font-size: clamp(0.78rem, 1vw, 1rem);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.82);
  }

  .cns-grid-wrap {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 1.4vw, 1.4rem);
  }

  .cns-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.7rem, 1vw, 1.05rem);
  }

  .cns-grid--top {
    grid-template-rows: repeat(2, minmax(0, 1fr));
    grid-auto-flow: row;
  }

  .cns-tile {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(0.85rem, 1.2vw, 1.15rem);
    padding: clamp(1rem, 1.4vw, 1.35rem) clamp(1.1rem, 1.6vw, 1.5rem);
    min-height: clamp(82px, 7.5vw, 102px);
    background:
      linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0)),
      rgba(8,8,8,0.88);
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 14px;
    color: #fff;
    text-decoration: none;
    overflow: hidden;
    backdrop-filter: blur(8px) saturate(1.1);
    will-change: transform;
    transition:
      transform 280ms cubic-bezier(.2,.7,.2,1),
      border-color 280ms cubic-bezier(.2,.7,.2,1),
      background-color 280ms cubic-bezier(.2,.7,.2,1),
      box-shadow 280ms cubic-bezier(.2,.7,.2,1);
  }

  .cns-tile::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 80% at 12% 0%, rgba(204,0,0,0.24), transparent 55%);
    opacity: 0;
    transition: opacity 280ms cubic-bezier(.2,.7,.2,1);
    pointer-events: none;
  }

  .cns-tile:hover,
  .cns-tile:focus-visible {
    transform: translateY(-3px);
    border-color: rgba(204,0,0,0.95);
    background-color: rgba(14,4,4,0.95);
    box-shadow:
      inset 0 0 0 1px rgba(204,0,0,0.65),
      0 18px 42px -16px rgba(204,0,0,0.6);
    outline: none;
  }

  .cns-tile:hover::before,
  .cns-tile:focus-visible::before {
    opacity: 1;
  }

  .cns-tile:active {
    transform: translateY(0);
    transition-duration: 80ms;
  }

  .cns-tile-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(34px, 2.4vw, 42px);
    height: clamp(34px, 2.4vw, 42px);
    color: #fff;
    flex-shrink: 0;
  }
  .cns-tile-icon svg { width: 100%; height: 100%; }

  .cns-tile-text {
    position: relative;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cns-tile-eyebrow {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: clamp(0.6rem, 0.7vw, 0.7rem);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
    line-height: 1;
  }

  .cns-tile-label {
    font-family: 'Anton', Impact, 'Arial Narrow Bold', sans-serif;
    font-style: italic;
    font-size: clamp(1.25rem, 1.65vw, 1.85rem);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1;
    color: #fff;
    text-shadow: 0 0.4rem 1.2rem rgba(0,0,0,0.45);
  }

  .cns-tile-arrow {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(32px, 2.2vw, 38px);
    height: clamp(32px, 2.2vw, 38px);
    border-radius: 999px;
    background: #cc0000;
    color: #fff;
    transition: transform 280ms cubic-bezier(.2,.7,.2,1), background-color 280ms cubic-bezier(.2,.7,.2,1);
    flex-shrink: 0;
  }
  .cns-tile-arrow svg { width: 16px; height: 16px; }

  .cns-tile:hover .cns-tile-arrow,
  .cns-tile:focus-visible .cns-tile-arrow {
    transform: translateX(5px);
    background: #ff1a1a;
  }

  .cns-divider {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(0.8rem, 1.2vw, 1.2rem);
    padding: clamp(0.2rem, 0.4vw, 0.4rem) 0;
  }

  .cns-divider-line {
    height: 1px;
    background: linear-gradient(90deg, rgba(255,255,255,0), rgba(204,0,0,0.55) 50%, rgba(255,255,255,0));
  }

  .cns-divider-label {
    font-family: 'Anton', Impact, 'Arial Narrow Bold', sans-serif;
    font-style: italic;
    font-size: clamp(0.85rem, 1.05vw, 1.05rem);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.92);
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .cns-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cns-grid--roles { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .cns-grid,
    .cns-grid--roles { grid-template-columns: 1fr; }
    .cns-tile-label { font-size: 1.15rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cns-tile,
    .cns-tile::before,
    .cns-tile-arrow { transition: none; }
  }
</style>
