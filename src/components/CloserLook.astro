---
interface Feature {
  id: string
  label: string
  title: string
  body: string
  image: string
  alt: string
}

const features: Feature[] = [
  {
    id: 'drills',
    label: 'Drills',
    title: '1,500+ drills',
    body: 'Every technique filmed, explained, and organised by skill level. From first touch to finishing, ball mastery to set-pieces.',
    image: '/images/app/screenshot-2.webp',
    alt: 'Joner Football App drill library screen',
  },
  {
    id: 'sessions',
    label: 'Sessions',
    title: 'Ready-made sessions',
    body: 'Complete session plans built by Lee. Pick a topic, hit play, run training tonight. No prep, no guesswork.',
    image: '/images/app/screenshot-3.webp',
    alt: 'Joner Football App session plans screen',
  },
  {
    id: 'programme',
    label: '100-Day Programme',
    title: 'The 100-Day Player Programme',
    body: 'A day-by-day plan that takes you from where you are to a technically complete footballer. Day 1 builds the foundation. Day 100 is a new player.',
    image: '/images/app/screenshot-4.webp',
    alt: 'Joner Football App programme view',
  },
  {
    id: 'coaches',
    label: 'Coaches library',
    title: 'Built for coaches',
    body: 'A dedicated coaches section with session plans, small group formats, and progressions. Organised by topic, age, and session type.',
    image: '/images/app/screenshot-5.webp',
    alt: 'Joner Football App coaches library screen',
  },
  {
    id: 'challenges',
    label: 'Daily challenges',
    title: 'A new challenge every day',
    body: 'Short, sharp, technical. Track your progress, build your streak, see the improvement compound.',
    image: '/images/app/screenshot-7.webp',
    alt: 'Joner Football App daily challenges screen',
  },
  {
    id: 'offline',
    label: 'Offline mode',
    title: 'Train anywhere',
    body: 'Download sessions to your phone. Train at the park, in the garage, on the road. Wifi optional.',
    image: '/images/app/screenshot-8.webp',
    alt: 'Joner Football App offline downloads screen',
  },
]

const initialId = features[0].id
---

<section class="bg-joner-black py-16 md:py-24">
  <div class="max-w-[1680px] mx-auto px-4 sm:px-6 lg:px-10">

    <h2 class="font-heading text-3xl sm:text-5xl md:text-6xl lg:text-7xl text-white uppercase leading-none tracking-tight mb-8 md:mb-12 px-2 sm:px-4">
      Take a closer look.
    </h2>

    <div class="rounded-2xl md:rounded-[2rem] bg-[#0f0f0f] border border-white/5 overflow-hidden">
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,360px)_1fr]">

        <!-- Pills column -->
        <div class="closer-pills p-5 sm:p-8 lg:p-10 lg:py-14 flex flex-col gap-3 order-2 lg:order-1">
          {features.map((f, i) => (
            <div class="closer-pill" data-pill={f.id}>
              <button
                type="button"
                class="closer-pill-btn w-full flex items-center gap-3 px-4 py-3 rounded-full bg-[#1c1c1c] hover:bg-[#262626] text-white text-left transition-colors duration-200"
                data-pill-btn={f.id}
                aria-expanded={f.id === initialId ? 'true' : 'false'}
                aria-controls={`closer-panel-${f.id}`}
              >
                <span class="closer-icon w-6 h-6 rounded-full bg-white/15 flex items-center justify-center shrink-0">
                  <svg class="closer-plus w-3 h-3 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                </span>
                <span class="font-body text-base sm:text-[15px] font-medium">{f.label}</span>
              </button>
              <div
                id={`closer-panel-${f.id}`}
                class="closer-panel grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-[cubic-bezier(0.4,0,0.2,1)]"
                aria-hidden={f.id === initialId ? 'false' : 'true'}
              >
                <div class="overflow-hidden">
                  <div class="pl-13 pr-4 pt-3 pb-2 sm:pl-14">
                    <h3 class="font-heading text-xl text-white uppercase mb-2 tracking-wide">{f.title}</h3>
                    <p class="text-gray-400 font-body text-sm leading-relaxed">{f.body}</p>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Image stage -->
        <div class="relative bg-black order-1 lg:order-2 aspect-[4/3] sm:aspect-[16/10] lg:aspect-auto lg:min-h-[600px]">
          {features.map((f) => (
            <img
              src={f.image}
              alt={f.alt}
              class="closer-stage-image absolute inset-0 w-full h-full object-contain p-6 sm:p-10 lg:p-16 transition-opacity duration-500 ease-out"
              data-stage-image={f.id}
              style={`opacity: ${f.id === initialId ? '1' : '0'};`}
              loading="lazy"
            />
          ))}
          <div class="absolute inset-0 pointer-events-none bg-gradient-to-tr from-joner-red/5 via-transparent to-transparent"></div>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  .closer-pill[data-open='true'] .closer-pill-btn {
    background: #262626;
  }
  .closer-pill[data-open='true'] .closer-plus {
    transform: rotate(45deg);
  }
  .closer-pill[data-open='true'] .closer-panel {
    grid-template-rows: 1fr;
  }
  .pl-13 { padding-left: 3.25rem; }
</style>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-pill-btn]'))
  const images = Array.from(document.querySelectorAll<HTMLImageElement>('[data-stage-image]'))

  const open = (id: string) => {
    buttons.forEach((btn) => {
      const targetId = btn.dataset.pillBtn
      const pill = btn.closest('.closer-pill') as HTMLElement | null
      const panel = btn.parentElement?.querySelector('.closer-panel') as HTMLElement | null
      const isTarget = targetId === id
      btn.setAttribute('aria-expanded', isTarget ? 'true' : 'false')
      if (pill) pill.dataset.open = isTarget ? 'true' : 'false'
      if (panel) panel.setAttribute('aria-hidden', isTarget ? 'false' : 'true')
    })
    images.forEach((img) => {
      img.style.opacity = img.dataset.stageImage === id ? '1' : '0'
    })
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.pillBtn
      if (!id) return
      const pill = btn.closest('.closer-pill') as HTMLElement | null
      if (pill?.dataset.open === 'true') return
      open(id)
    })
  })

  const initiallyOpen = buttons.find((b) => b.getAttribute('aria-expanded') === 'true')
  if (initiallyOpen?.dataset.pillBtn) open(initiallyOpen.dataset.pillBtn)
</script>
