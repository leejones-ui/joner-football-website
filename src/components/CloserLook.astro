---
interface Feature {
  id: string
  label: string
  title: string
  body: string
  image: string
  alt: string
}

const features: Feature[] = [
  {
    id: 'drills',
    label: '2,000+ Drills',
    title: 'Every Skill, Covered.',
    body: 'Drills for first touch, passing, finishing, ball mastery, defending, movement, set pieces, and more.',
    image: '/images/app/closer-look-drills.webp',
    alt: 'Joner Football App showing drills and age-specific training screens',
  },
  {
    id: 'programme',
    label: '100-Day Program',
    title: 'A Clear Plan to Improve.',
    body: 'A structured day-by-day programme that helps players train with purpose and consistency.',
    image: '/images/app/closer-look-100-day-program.webp',
    alt: 'The 100 Day Pathway programme graphic for Joner Football App',
  },
  {
    id: 'age-specific',
    label: 'Age-Specific Training',
    title: 'Train at the Right Level.',
    body: 'Content designed for ages 6 to 9, 10 to 13, and 14+.',
    image: '/images/app/closer-look-age-specific.webp',
    alt: 'Age-specific football training for ages 6 to 9, 10 to 13, and 14 plus',
  },
  {
    id: 'coaches',
    label: 'Coaches Section',
    title: 'Built for Coaches.',
    body: 'Session plans, team training ideas, voice-over breakdowns, and coaching-only content.',
    image: '/images/app/closer-look-coaches-section.webp',
    alt: 'Lee Jones coaching with session plan diagram for coaches section',
  },
  {
    id: 'live',
    label: 'Live Sessions',
    title: 'Learn Live.',
    body: 'Access selected live sessions, workshops, and special events inside the app.',
    image: '/images/app/closer-look-live-sessions.webp',
    alt: 'Behind-the-scenes filming setup with Joner Football App live sessions on devices',
  },
  {
    id: 'community',
    label: 'DM & Community',
    title: 'Stay Connected.',
    body: 'Ask questions, get updates, share progress, and connect through the app community.',
    image: '/images/app/closer-look-community.webp',
    alt: 'Joner Football App direct messages and community screens',
  },
  {
    id: 'downloads',
    label: 'Playlists & Downloads',
    title: 'Train Anywhere.',
    body: 'Save videos, build playlists, and download sessions for offline access.',
    image: '/images/app/closer-look-playlists-downloads.webp',
    alt: 'Joner Football App downloads and playlists screens',
  },
]

const initialId = features[0].id
---

<section class="bg-joner-black py-16 md:py-24">
  <div class="max-w-[1680px] mx-auto px-4 sm:px-6 lg:px-10">

    <h2 class="font-heading text-3xl sm:text-5xl md:text-6xl lg:text-7xl text-white uppercase leading-none tracking-tight mb-8 md:mb-12 px-2 sm:px-4">
      Take a closer look.
    </h2>

    <div class="rounded-2xl md:rounded-[2rem] bg-[#0f0f0f] border border-white/5 overflow-hidden">
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,360px)_1fr]">

        <!-- Pills column -->
        <div class="closer-pills p-5 sm:p-8 lg:p-10 lg:py-14 flex flex-col gap-3 order-2 lg:order-1">
          {features.map((f) => (
            <div class="closer-pill" data-pill={f.id} data-open={f.id === initialId ? 'true' : 'false'}>
              <button
                type="button"
                class="closer-pill-btn w-full flex items-center gap-3 px-4 py-3 rounded-full text-white text-left"
                data-pill-btn={f.id}
                aria-expanded={f.id === initialId ? 'true' : 'false'}
                aria-controls={`closer-panel-${f.id}`}
              >
                <span class="closer-icon w-6 h-6 rounded-full flex items-center justify-center shrink-0">
                  <svg class="closer-plus w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                </span>
                <span class="font-body text-base sm:text-[15px] font-medium">{f.label}</span>
              </button>
              <div
                id={`closer-panel-${f.id}`}
                class="closer-panel grid grid-rows-[0fr]"
                aria-hidden={f.id === initialId ? 'false' : 'true'}
              >
                <div class="overflow-hidden">
                  <div class="closer-panel-content pl-13 pr-4 pt-3 pb-2 sm:pl-14">
                    <h3 class="font-heading text-xl text-white uppercase mb-2 tracking-wide">{f.title}</h3>
                    <p class="text-gray-400 font-body text-sm leading-relaxed">{f.body}</p>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Image stage -->
        <div class="closer-stage relative bg-black order-1 lg:order-2 aspect-[4/3] sm:aspect-[16/10] lg:aspect-auto lg:min-h-[600px] overflow-hidden">
          {features.map((f) => (
            <img
              src={f.image}
              alt={f.alt}
              class="closer-stage-image absolute inset-0 w-full h-full object-contain p-6 sm:p-10 lg:p-16"
              data-stage-image={f.id}
              data-active={f.id === initialId ? 'true' : 'false'}
              loading="lazy"
            />
          ))}
          <div class="closer-stage-glow absolute inset-0 pointer-events-none"></div>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  /* iOS-style easing for the Apple-feel motion */
  .closer-stage-image {
    opacity: 0;
    transform: scale(0.94) translateY(14px);
    filter: blur(6px);
    pointer-events: none;
    will-change: opacity, transform, filter;
    transition:
      opacity 520ms cubic-bezier(0.32, 0.72, 0, 1),
      transform 720ms cubic-bezier(0.32, 0.72, 0, 1),
      filter 520ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .closer-stage-image[data-active='true'] {
    opacity: 1;
    transform: scale(1) translateY(0);
    filter: blur(0);
    transition:
      opacity 620ms cubic-bezier(0.32, 0.72, 0, 1) 80ms,
      transform 820ms cubic-bezier(0.32, 0.72, 0, 1) 80ms,
      filter 520ms cubic-bezier(0.32, 0.72, 0, 1) 100ms;
  }

  /* Soft red wash on the stage */
  .closer-stage-glow {
    background:
      radial-gradient(60% 60% at 80% 20%, rgba(227, 6, 19, 0.10), transparent 60%),
      radial-gradient(50% 50% at 20% 80%, rgba(255, 255, 255, 0.04), transparent 60%);
    opacity: 0.85;
    transition: opacity 600ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  /* Pill button */
  .closer-pill-btn {
    background: #1c1c1c;
    transition:
      background-color 320ms cubic-bezier(0.32, 0.72, 0, 1),
      transform 320ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .closer-pill-btn:hover {
    background: #252525;
  }
  .closer-pill[data-open='true'] .closer-pill-btn {
    background: #2a2a2a;
  }

  .closer-icon {
    background: rgba(255, 255, 255, 0.15);
    transition: background-color 320ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .closer-pill[data-open='true'] .closer-icon {
    background: rgba(227, 6, 19, 0.85);
  }

  /* + → × rotation */
  .closer-plus {
    transition: transform 380ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .closer-pill[data-open='true'] .closer-plus {
    transform: rotate(45deg);
  }

  /* Panel expand with smooth grid-rows */
  .closer-panel {
    transition: grid-template-rows 520ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .closer-pill[data-open='true'] .closer-panel {
    grid-template-rows: 1fr;
  }

  /* Panel content slides up + fades in, delayed so it appears AFTER the panel opens */
  .closer-panel-content {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 460ms cubic-bezier(0.32, 0.72, 0, 1),
      transform 520ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .closer-pill[data-open='true'] .closer-panel-content {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 520ms cubic-bezier(0.32, 0.72, 0, 1) 180ms,
      transform 620ms cubic-bezier(0.32, 0.72, 0, 1) 180ms;
  }

  .pl-13 { padding-left: 3.25rem; }

  @media (prefers-reduced-motion: reduce) {
    .closer-stage-image,
    .closer-stage-glow,
    .closer-pill-btn,
    .closer-icon,
    .closer-plus,
    .closer-panel,
    .closer-panel-content {
      transition: none !important;
    }
    .closer-stage-image {
      filter: none;
      transform: none;
    }
  }
</style>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-pill-btn]'))
  const images = Array.from(document.querySelectorAll<HTMLImageElement>('[data-stage-image]'))

  const setActive = (id: string) => {
    buttons.forEach((btn) => {
      const targetId = btn.dataset.pillBtn
      const pill = btn.closest('.closer-pill') as HTMLElement | null
      const panel = btn.parentElement?.querySelector('.closer-panel') as HTMLElement | null
      const isTarget = targetId === id
      btn.setAttribute('aria-expanded', isTarget ? 'true' : 'false')
      if (pill) pill.dataset.open = isTarget ? 'true' : 'false'
      if (panel) panel.setAttribute('aria-hidden', isTarget ? 'false' : 'true')
    })
    images.forEach((img) => {
      img.dataset.active = img.dataset.stageImage === id ? 'true' : 'false'
    })
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.pillBtn
      if (!id) return
      const pill = btn.closest('.closer-pill') as HTMLElement | null
      if (pill?.dataset.open === 'true') return
      setActive(id)
    })
  })
</script>
