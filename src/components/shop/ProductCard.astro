---
// One apparel card: photo with a second photo on hover, name, price, colour dots. Tapping the card
// opens the product sheet (ShopKit); tapping a dot shows that colour on the card and the sheet
// opens on it. Styles in src/styles/shop-store.css.
import { cardImages, colourNote, colourSwatches, isLimited, isWide, priceLabel, sized, type ShopProduct } from '../../lib/shopify'

interface Props {
  product: ShopProduct
  group?: string
  eager?: boolean
  href?: string
}

const { product: p, group, eager = false, href = '/shop/apparel' } = Astro.props
const { main, hover } = cardImages(p)
const swatches = colourSwatches(p)
const note = swatches.length ? '' : colourNote(p)
const limitedOnly = isLimited(p) && !swatches.some((s) => !s.limited)
---

<div class="st-card" data-group={group}>
  <a href={`${href}#p=${p.handle}`} class="st-link" data-shop-open={p.handle} data-shop-colour={swatches[0]?.value}>
    <span class="st-img">
      {main && <img class={`st-main${isWide(main) ? ' st-wide' : ''}`} src={sized(main.url, 800)} alt={main.alt} width="800" height="1200" loading={eager ? 'eager' : 'lazy'} />}
      {hover && <img class={`st-hover${isWide(hover) ? ' st-wide' : ''}`} src={sized(hover.url, 800)} alt="" width="800" height="1200" loading="lazy" />}
      {limitedOnly && <span class="st-tag">Limited</span>}
      {!limitedOnly && swatches.some((s) => s.limited) && <span class="st-tag">Limited editions</span>}
      <span class="st-tag st-tag-out">Sold out</span>
      <span class="st-plus" aria-hidden="true">+</span>
    </span>
    <span class="st-name">{p.title.replace(/^Joner Football\s+/i, '')}</span>
    <span class="st-meta"><span data-shop-price set:html={priceLabel(p)} />{note && <span class="st-note">{note}</span>}</span>
  </a>
  {swatches.length > 0 && (
    <div class="st-sw" role="group" aria-label={`${p.title} colours`}>
      {swatches.map((s, i) => (
        <button
          type="button"
          aria-pressed={i === 0 ? 'true' : 'false'}
          aria-label={s.value}
          title={s.value}
          data-sw={s.value}
          data-main={s.main ? sized(s.main.url, 800) : ''}
          data-hover={s.hover ? sized(s.hover.url, 800) : ''}
          data-wide-main={isWide(s.main) ? '1' : undefined}
          data-wide-hover={isWide(s.hover) ? '1' : undefined}
        ><span style={`background:${s.hex}`} /></button>
      ))}
    </div>
  )}
</div>

<script>
  // Colour dots: swap the card's two photos and remember the colour for the product sheet.
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.st-sw button')
    if (!b) return
    const card = b.closest('.st-card')!
    const link = card.querySelector<HTMLElement>('[data-shop-open]')!
    card.querySelectorAll('.st-sw button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)))
    link.dataset.shopColour = b.dataset.sw
    const set = (img: HTMLImageElement | null, src?: string, wide?: string) => {
      if (!img || !src) return
      img.src = src
      img.classList.toggle('st-wide', !!wide)
    }
    set(card.querySelector('.st-main'), b.dataset.main, b.dataset.wideMain)
    set(card.querySelector('.st-hover'), b.dataset.hover, b.dataset.wideHover)
  })
</script>
