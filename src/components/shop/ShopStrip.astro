---
// "Joner kit" product row for busy pages. Each card opens the product sheet on the same page,
// so people can buy without leaving. Placed only on pages that do not sell the app
// (Lee, 9 Nov 2026: no shop buttons on the app pages, they compete).
import ShopKit from './ShopKit.astro'
import ShopPromo from './ShopPromo.astro'
import { getShopProducts, pickLabel, priceLabel, sized } from '../../lib/shopify'
import { SHOP_STRIPS_ON } from '../../data/shop-promo'

interface Props {
  title?: string
  intro?: string
  limit?: number
  theme?: 'dark' | 'light'
  place: string
}

const { title = 'Wear the badge.', intro = 'Official Joner Football apparel. Pick your size here and pay in a minute.', limit = 4, theme = 'dark', place } = Astro.props
const products = SHOP_STRIPS_ON ? (await getShopProducts()).filter((p) => p.available).slice(0, limit) : []
---

{products.length > 0 && (
  <section class={`jss jss-${theme}`} data-shop-strip={place} aria-labelledby={`jss-${place}`}>
    <div class="jss-wrap">
      <ShopPromo />
      <div class="jss-head">
        <div>
          <p class="jss-eyebrow">Joner kit</p>
          <h2 id={`jss-${place}`} class="jss-title">{title}</h2>
          <p class="jss-intro">{intro}</p>
        </div>
        <a href="/shop/off-field-apparel" class="jss-all">Shop all apparel</a>
      </div>
      <div class="jss-row">
        {products.map((p) => (
          <a href={`/shop/off-field-apparel#p=${p.handle}`} class="jss-card" data-shop-open={p.handle}>
            <span class="jss-img">
              {p.images[0] && <img src={sized(p.images[0].url, 600)} alt={p.images[0].alt} loading="lazy" width="600" height="750" />}
            </span>
            <span class="jss-name">{p.title}</span>
            <span class="jss-price" data-shop-price set:html={priceLabel(p)} />
            <span class="jss-cta" data-shop-status>{pickLabel(p)}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
{products.length > 0 && <ShopKit />}

<style>
  .jss { position: relative; z-index: 2; isolation: isolate; padding: 56px 0; }
  .jss-dark { background: #0a0a0a; color: #fff; border-top: 1px solid rgba(255, 255, 255, 0.08); }
  .jss-light { background: #fff; color: #0a0a0a; }
  .jss-wrap { max-width: 1280px; margin: 0 auto; padding: 0 16px; }
  @media (min-width: 640px) { .jss-wrap { padding: 0 24px; } }
  .jss-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px 24px; margin-bottom: 24px; }
  .jss-eyebrow { font-family: var(--font-heading, 'Anton', sans-serif); text-transform: uppercase; letter-spacing: 0.24em; font-size: 12px; color: var(--color-joner-red, #e30613); margin: 0 0 8px; }
  .jss-title { font-family: var(--font-heading, 'Anton', sans-serif); text-transform: uppercase; font-size: clamp(30px, 5vw, 48px); line-height: 1; margin: 0 0 10px; }
  .jss-intro { margin: 0; max-width: 520px; font-size: 16px; line-height: 1.5; }
  .jss-dark .jss-intro { color: #d1d5db; }
  .jss-light .jss-intro { color: #4b5563; }
  .jss-all { display: inline-flex; align-items: center; min-height: 44px; font-weight: 700; text-decoration: underline; text-underline-offset: 4px; }
  .jss-all:hover { color: var(--color-joner-red, #e30613); }
  .jss-row { display: grid; grid-auto-flow: column; grid-auto-columns: 62%; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 6px; margin: 0 -16px; padding-left: 16px; padding-right: 16px; scroll-padding-left: 16px; scrollbar-width: none; }
  .jss-row::-webkit-scrollbar { display: none; }
  @media (min-width: 640px) { .jss-row { grid-auto-columns: 38%; margin: 0; padding-left: 0; padding-right: 0; } }
  @media (min-width: 1024px) { .jss-row { grid-auto-flow: row; grid-template-columns: repeat(4, minmax(0, 1fr)); overflow: visible; } }
  .jss-card { display: flex; flex-direction: column; scroll-snap-align: start; min-width: 0; }
  .jss-img { display: block; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 12px; background: #f3f3f3; margin-bottom: 12px; }
  .jss-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 500ms cubic-bezier(0.32, 0.72, 0, 1); }
  @media (hover: hover) { .jss-card:hover .jss-img img { transform: scale(1.04); } .jss-card:hover .jss-name { color: var(--color-joner-red, #e30613); } }
  .jss-name { font-weight: 700; font-size: 15px; line-height: 1.3; }
  .jss-price { font-size: 15px; margin-top: 4px; }
  .jss-cta { margin-top: auto; padding-top: 10px; font-size: 13px; font-weight: 700; color: var(--color-joner-red, #e30613); }
  .jss-dark .jss-price :global(s) { color: #9ca3af; }
</style>
