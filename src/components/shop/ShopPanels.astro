---
// The /shop front door (Lee, 9 Nov 2026: option D "Expanding panels" with T1 "Slide up on scroll",
// picked from /drafts/shop-tiles/). Four panels; the one you point at (or tap on a phone) slides open.
// First tap on a phone opens a panel, the second follows its link. Panels slide up in turn when they
// come on screen. Swap images in `doors` on src/pages/shop.astro (Codex is making new ones).
export interface ShopDoor {
  href: string
  label: string
  sub: string
  img: string
  pos?: string
  external?: boolean
}
interface Props { doors: ShopDoor[] }
const { doors } = Astro.props
---

<nav class="sp-row" aria-label="Shops" data-sp-row>
  {doors.map((d, i) => (
    <a class={`sp-panel${i === 0 ? ' is-open' : ''}`} href={d.href} style={`--i:${i}`} data-sp-panel>
      <img src={d.img} alt="" style={`object-position:${d.pos || 'center'}`} loading={i < 2 ? 'eager' : 'lazy'} />
      <span class="sp-shade" aria-hidden="true"></span>
      <span class="sp-closed" aria-hidden="true"><span class="sp-n">{String(i + 1).padStart(2, '0')}</span><span class="sp-vert">{d.label}</span></span>
      <span class="sp-open">
        <span class="sp-n">{String(i + 1).padStart(2, '0')}</span>
        <span class="sp-label">{d.label}</span>
        <span class="sp-sub">{d.sub}</span>
        <span class="sp-btn">Shop now <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
      </span>
    </a>
  ))}
</nav>

<style>
  .sp-row { --red: #E8000D; --ease: cubic-bezier(0.22, 1, 0.36, 1); display: flex; flex-direction: column; gap: 3px; height: min(150vw, 680px); background: #fff; }
  @media (min-width: 900px) { .sp-row { flex-direction: row; height: min(78vh, 760px); } }
  .sp-panel { position: relative; flex: 1 1 0; min-width: 0; min-height: 0; overflow: hidden; background: #111; color: #fff; text-decoration: none; transition: flex-grow 700ms var(--ease), opacity 700ms ease, transform 900ms var(--ease); }
  .sp-panel.is-open { flex-grow: 4; }
  .sp-panel img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1200ms var(--ease); }
  .sp-panel.is-open img { transform: scale(1.03); }
  .sp-shade { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.5); transition: background 500ms ease; }
  .sp-panel.is-open .sp-shade { background: linear-gradient(to top, rgba(0, 0, 0, 0.78), rgba(0, 0, 0, 0) 58%); }
  .sp-n { font-family: var(--font-heading, Anton, sans-serif); font-style: italic; color: var(--red); letter-spacing: 0.14em; font-size: 13px; }
  .sp-closed { position: absolute; inset: 0; display: flex; align-items: center; gap: 12px; padding: 0 16px; transition: opacity 300ms ease; }
  @media (min-width: 900px) { .sp-closed { flex-direction: column; justify-content: flex-end; gap: 14px; padding: 28px 0; } }
  .sp-vert { font-family: var(--font-heading, Anton, sans-serif); font-style: italic; text-transform: uppercase; font-size: 22px; line-height: 1; white-space: nowrap; }
  @media (min-width: 900px) { .sp-vert { writing-mode: vertical-rl; transform: rotate(180deg); font-size: 28px; } }
  .sp-open { position: absolute; left: 0; right: 0; bottom: 0; padding: 18px 16px; display: grid; gap: 8px; justify-items: start; opacity: 0; transform: translateY(24px); transition: opacity 400ms ease, transform 600ms var(--ease); }
  @media (min-width: 900px) { .sp-open { padding: 40px; } }
  .sp-panel.is-open .sp-closed { opacity: 0; }
  .sp-panel.is-open .sp-open { opacity: 1; transform: none; transition-delay: 250ms; }
  .sp-label { font-family: var(--font-heading, Anton, sans-serif); font-style: italic; text-transform: uppercase; font-size: clamp(36px, 5vw, 68px); line-height: 0.95; }
  .sp-sub { color: #e5e5e5; font-size: 16px; }
  .sp-btn { display: inline-flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 22px; background: var(--red); font-weight: 800; }
  .sp-btn svg { width: 18px; height: 18px; }
  .sp-panel:focus-visible { outline: 3px solid var(--red); outline-offset: -3px; }

  /* T1: slide up in turn when the row comes on screen (only once the script is running). */
  .sp-row.is-armed .sp-panel { opacity: 0; transform: translateY(70px); }
  .sp-row.is-armed .sp-panel.is-in { opacity: 1; transform: none; transition-delay: 0ms, calc(var(--i) * 120ms), calc(var(--i) * 120ms); }

  @media (prefers-reduced-motion: reduce) {
    .sp-panel, .sp-panel img, .sp-open, .sp-closed, .sp-shade { transition-duration: 1ms !important; transition-delay: 0ms !important; }
    .sp-row.is-armed .sp-panel { opacity: 1; transform: none; }
  }
</style>

<script>
  const row = document.querySelector<HTMLElement>('[data-sp-row]')
  if (row) {
    const coarse = matchMedia('(pointer: coarse)').matches
    const panels = [...row.querySelectorAll<HTMLElement>('[data-sp-panel]')]
    const open = (p: HTMLElement) => panels.forEach((x) => x.classList.toggle('is-open', x === p))
    panels.forEach((p) => {
      p.addEventListener('mouseenter', () => { if (!coarse) open(p) })
      p.addEventListener('focus', () => open(p))
      p.addEventListener('click', (e) => { if (!p.classList.contains('is-open')) { e.preventDefault(); open(p) } })
    })
    if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      row.classList.add('is-armed')
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target) } }), { threshold: 0.1 })
      panels.forEach((p) => io.observe(p))
    }
  }
</script>
