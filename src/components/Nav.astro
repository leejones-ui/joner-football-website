<style>
  /* Force hamburger on any touch device regardless of viewport width.
     Catches iPad portrait + landscape (including 12.9" at 1366px) where
     hover dropdowns don't work because there is no hover state. */
  @media (hover: none) and (pointer: coarse) {
    #main-nav .nav-desktop { display: none !important; }
    #main-nav .nav-desktop-cta { display: none !important; }
    #main-nav .nav-mobile-btn { display: flex !important; }
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn')
  const menu = document.getElementById('mobile-menu')
  const closeBtn = document.getElementById('mobile-menu-close')
  const overlay = document.getElementById('mobile-menu-overlay')

  function openMenu() {
    menu?.classList.remove('hidden')
    document.body.style.overflow = 'hidden'
  }
  function closeMenu() {
    menu?.classList.add('hidden')
    document.body.style.overflow = ''
  }

  btn?.addEventListener('click', openMenu)
  closeBtn?.addEventListener('click', closeMenu)
  overlay?.addEventListener('click', closeMenu)
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu))
</script>
