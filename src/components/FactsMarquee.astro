---
// Thin trust ticker that slides facts across the page continuously.
// Facts are rendered twice so the loop is seamless (-50% translate).
interface Props {
  facts: string[]
  speed?: number // seconds for one full loop
}
const { facts, speed = 30 } = Astro.props
---

<div class="fm-bar" style={`--fm-speed:${speed}s`} aria-label="Joner Football facts">
  <div class="fm-track">
    {[0, 1].map((g) => (
      <div class="fm-group" aria-hidden={g === 1 ? 'true' : undefined}>
        {facts.map((f) => (
          <span class="fm-item">
            <svg class="fm-star" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <span class="fm-text font-heading">{f}</span>
          </span>
        ))}
      </div>
    ))}
  </div>
</div>

<style>
  .fm-bar {
    overflow: hidden;
    background: #0E0E0E;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }
  .fm-track {
    display: flex;
    width: max-content;
    animation: fm-scroll var(--fm-speed, 30s) linear infinite;
  }
  .fm-bar:hover .fm-track { animation-play-state: paused; }
  .fm-group { display: flex; flex-shrink: 0; }
  .fm-item { display: inline-flex; align-items: center; gap: 0.85rem; padding: 0.6rem 1.4rem; }
  .fm-star { width: 0.7rem; height: 0.7rem; color: var(--color-joner-red, #E8000D); flex-shrink: 0; }
  .fm-text {
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.82rem;
    white-space: nowrap;
    font-style: italic;
  }
  @keyframes fm-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .fm-track { animation: none; }
  }
</style>
