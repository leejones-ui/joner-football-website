---
interface Slide {
  eyebrow?: string
  title: string
  image: string
  alt: string
  note?: string
}

const slides: Slide[] = [
  {
    eyebrow: 'The library',
    title: 'Train with structure. Improve with purpose.',
    image: '/images/app/highlight-slide-1.webp',
    alt: 'Joner Football App drill library',
  },
  {
    eyebrow: 'Train anywhere',
    title: 'Follow Along Training',
    image: '/images/app/highlight-slide-2.webp',
    alt: 'Player training at home while following the Joner Football App',
  },
  {
    eyebrow: 'For coaches',
    title: 'Session plans ready to use. With PDF.',
    image: '/images/app/highlight-slide-3.webp',
    alt: 'Coach explaining a football session plan',
  },
  {
    eyebrow: 'Free section',
    title: 'Free to watch section*',
    image: '/images/app/highlight-slide-4.webp',
    alt: 'Joner Football App free to watch section on tablet',
    note: '* No sign up required.',
  },
  {
    eyebrow: 'Coach access',
    title: 'DM Coach Lee*',
    image: '/images/app/highlight-slide-5.webp',
    alt: 'Lee Jones coaching and giving advice through the Joner Football App',
    note: '* Only annual plan members can DM Coach Lee.',
  },
]
---

<section class="bg-joner-black pt-16 pb-8 md:py-24 overflow-hidden">
  <div class="max-w-[1680px] mx-auto px-4 sm:px-6 lg:px-10">

    <!-- Header row -->
    <div class="flex items-end justify-between mb-8 md:mb-12 px-2 sm:px-4">
      <h2 class="font-heading text-3xl sm:text-5xl md:text-6xl lg:text-7xl text-white uppercase leading-none tracking-tight whitespace-nowrap">
        What's inside the app.
      </h2>
    </div>

    <!-- Carousel track -->
    <div
      id="highlights-track"
      class="highlights-track flex gap-3 md:gap-5 overflow-x-auto snap-x snap-mandatory scrollbar-hide"
    >
      {slides.map((slide, i) => (
        <article
          class="highlights-slide snap-center shrink-0 relative rounded-2xl md:rounded-3xl overflow-hidden bg-joner-gray"
          data-index={i}
        >
          <img
            src={slide.image}
            alt={slide.alt}
            class="absolute inset-0 w-full h-full object-cover"
            loading={i === 0 ? 'eager' : 'lazy'}
          />
          <div class="absolute inset-0 bg-gradient-to-b from-black/35 via-black/5 to-black/45 pointer-events-none"></div>
          <div class="relative z-10 h-full p-7 sm:p-10 md:p-14 lg:p-16 flex items-center">
            <div class="max-w-[34rem]">
              {slide.eyebrow && (
                <p class="font-body text-white/90 text-sm md:text-base mb-3 tracking-wide">{slide.eyebrow}</p>
              )}
              <h3 class="font-body text-white text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-semibold leading-[1.08] highlights-headline">
                {slide.title}
              </h3>
              {slide.note && (
                <p class="mt-5 font-body text-white/85 text-xs sm:text-sm md:text-base highlights-note">{slide.note}</p>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Dots + pause/play -->
    <div class="flex items-center justify-center gap-4 mt-7 md:mt-9">
      <div class="flex items-center gap-1.5" id="highlights-dots">
        {slides.map((_, i) => (
          <button
            type="button"
            class="highlights-dot rounded-full transition-all duration-300"
            data-dot-index={i}
            aria-label={`Go to highlight ${i + 1}`}
          ></button>
        ))}
      </div>
      <button
        type="button"
        id="highlights-toggle"
        class="ml-1 w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition-colors"
        aria-label="Pause highlights"
      >
        <svg id="highlights-pause-icon" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
          <rect x="6" y="5" width="4" height="14" rx="1"/>
          <rect x="14" y="5" width="4" height="14" rx="1"/>
        </svg>
        <svg id="highlights-play-icon" class="w-3.5 h-3.5 hidden" viewBox="0 0 24 24" fill="currentColor">
          <path d="M8 5v14l11-7z"/>
        </svg>
      </button>
    </div>

  </div>
</section>

<style>
  .highlights-track {
    scroll-padding-inline: 6vw;
    padding-inline: 6vw;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
  }

  .highlights-slide {
    width: 88vw;
    aspect-ratio: 16 / 11;
    scroll-snap-stop: always;
  }

  .highlights-headline {
    letter-spacing: -0.02em;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.35);
  }

  @media (min-width: 768px) {
    .highlights-track { scroll-padding-inline: 10vw; padding-inline: 10vw; }
    .highlights-slide { width: 80vw; aspect-ratio: 16 / 9; }
  }

  @media (min-width: 1024px) {
    .highlights-track { scroll-padding-inline: 13vw; padding-inline: 13vw; }
    .highlights-slide { width: 74vw; }
  }

  @media (min-width: 1440px) {
    .highlights-slide { width: 1100px; }
  }

  .highlights-dot {
    width: 8px;
    height: 8px;
    background: rgba(255, 255, 255, 0.32);
  }

  .highlights-dot[data-active='true'] {
    width: 26px;
    background: rgba(255, 255, 255, 0.9);
  }

  @media (prefers-reduced-motion: reduce) {
    .highlights-track { scroll-behavior: auto; }
  }
</style>

<script>
  const track = document.getElementById('highlights-track') as HTMLElement | null
  const toggle = document.getElementById('highlights-toggle') as HTMLButtonElement | null
  const pauseIcon = document.getElementById('highlights-pause-icon')
  const playIcon = document.getElementById('highlights-play-icon')
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.highlights-dot'))

  if (track && dots.length) {
    const slides = Array.from(track.querySelectorAll<HTMLElement>('.highlights-slide'))
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    let current = 0
    let playing = !reduced
    let timer: ReturnType<typeof setInterval> | null = null
    let pausedTemporarily = false
    let scrollPauseTO: ReturnType<typeof setTimeout> | null = null

    const setActive = (i: number) => {
      current = i
      dots.forEach((dot, idx) => {
        dot.dataset.active = idx === i ? 'true' : 'false'
      })
    }

    const goTo = (i: number) => {
      const target = slides[i]
      if (!target || !track) return
      const offset = target.offsetLeft - (track.clientWidth - target.clientWidth) / 2
      track.scrollTo({ left: offset, behavior: reduced ? 'auto' : 'smooth' })
    }

    const next = () => goTo((current + 1) % slides.length)

    const startAuto = () => {
      stopAuto()
      if (!playing) return
      timer = setInterval(() => {
        if (!pausedTemporarily) next()
      }, 5000)
    }

    const stopAuto = () => {
      if (timer) { clearInterval(timer); timer = null }
    }

    const io = new IntersectionObserver(
      (entries) => {
        let best = { ratio: 0, idx: current }
        entries.forEach((e) => {
          if (e.intersectionRatio > best.ratio) {
            const idx = parseInt((e.target as HTMLElement).dataset.index || '0')
            best = { ratio: e.intersectionRatio, idx }
          }
        })
        if (best.ratio > 0.6) setActive(best.idx)
      },
      { root: track, threshold: [0.4, 0.6, 0.8] }
    )
    slides.forEach((s) => io.observe(s))

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const i = parseInt(dot.dataset.dotIndex || '0')
        goTo(i)
        startAuto()
      })
    })

    toggle?.addEventListener('click', () => {
      playing = !playing
      if (playing) {
        startAuto()
        pauseIcon?.classList.remove('hidden')
        playIcon?.classList.add('hidden')
        toggle.setAttribute('aria-label', 'Pause highlights')
      } else {
        stopAuto()
        pauseIcon?.classList.add('hidden')
        playIcon?.classList.remove('hidden')
        toggle.setAttribute('aria-label', 'Play highlights')
      }
    })

    track.addEventListener('mouseenter', () => { pausedTemporarily = true })
    track.addEventListener('mouseleave', () => { pausedTemporarily = false })
    track.addEventListener('touchstart', () => { pausedTemporarily = true }, { passive: true })
    track.addEventListener('touchend', () => {
      if (scrollPauseTO) clearTimeout(scrollPauseTO)
      scrollPauseTO = setTimeout(() => { pausedTemporarily = false }, 1200)
    })
    track.addEventListener('scroll', () => {
      pausedTemporarily = true
      if (scrollPauseTO) clearTimeout(scrollPauseTO)
      scrollPauseTO = setTimeout(() => { pausedTemporarily = false }, 900)
    }, { passive: true })

    setActive(0)
    startAuto()
  }
</script>
