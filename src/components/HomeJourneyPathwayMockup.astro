---
export interface Props {
  image?: string
  mobileImage?: string
  ctaHref?: string
  ctaLabel?: string
}

const contactHref = 'https://joner-football-website-88z3bgl1r-leejones-6826s-projects.vercel.app/contact'

const {
  image = '/images/homepage/jfp-journey-photo.webp',
  mobileImage = '/images/homepage/jfp-journey-photo-mobile.webp',
  ctaHref = contactHref,
  ctaLabel = 'Start Your Journey',
} = Astro.props

const chips = [
  { label: '10-week terms', icon: 'calendar' },
  { label: 'Player reports', icon: 'bars' },
  { label: 'Elite coaching', icon: 'key' },
]

const stages = [
  { tag: 'Stage 1', title: 'Joners Juniors', age: 'Ages 4 to 6', icon: 'shirt' },
  { tag: 'Stage 2', title: 'Joner 6-8 Year Old Program', age: 'Ages 6 to 8', icon: 'ball' },
  { tag: 'Flagship', title: 'Joner Football Performance', age: 'Ages 9 to 18', icon: 'jf' },
]

const unlocks = [
  { label: 'Joner App', icon: 'phone' },
  { label: 'S&C (FPA)', icon: 'dumbbell' },
  { label: 'FullNinety', icon: 'fn' },
  { label: 'Game Analysis', icon: 'analysis' },
  { label: 'Mentorship', icon: 'people' },
  { label: 'High Level Training', icon: 'chevrons' },
]

const icons: Record<string, string> = {
  calendar: '<svg viewBox="0 0 24 24"><path d="M7 3v4M17 3v4M4 8h16M6 5h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z"/><path d="M8 12h2M12 12h2M16 12h1M8 16h2M12 16h2M16 16h1"/></svg>',
  bars: '<svg viewBox="0 0 24 24"><path d="M5 20V10M12 20V5M19 20V14"/></svg>',
  key: '<svg viewBox="0 0 24 24"><circle cx="8" cy="14" r="4"/><path d="M12 14h9M17 14v-3M20 14v-2"/></svg>',
  shirt: '<svg viewBox="0 0 24 24"><path d="M8 4l-5 3 2 4 3-1v10h8V10l3 1 2-4-5-3-3 2h-2z"/></svg>',
  ball: '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7l4 3-1.5 5h-5L8 10zM12 7V3M16 10l4-1M14.5 15l2.5 4M9.5 15L7 19M8 10L4 9"/></svg>',
  jf: '<svg viewBox="0 0 24 24"><path d="M12 3l8 2.8v6.9c0 4.1-3.1 7.2-8 8.8-4.9-1.6-8-4.7-8-8.8V5.8z"/><text x="12" y="14.7" text-anchor="middle" font-size="7.4" font-family="Anton, Impact, sans-serif" font-weight="900" fill="currentColor">JF</text></svg>',
  phone: '<svg viewBox="0 0 24 24"><rect x="7" y="3" width="10" height="18" rx="2"/><path d="M11 18h2"/></svg>',
  dumbbell: '<svg viewBox="0 0 24 24"><path d="M3 9v6M7 7v10M17 7v10M21 9v6M7 12h10"/></svg>',
  fn: '<svg viewBox="0 0 48 24"><path d="M3 17h9l5-10h9l-5 10h8l5-10h11"/><path d="M18 7h9M29 17h9"/></svg>',
  analysis: '<svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M8 15l3-3 3 2 3-5M16 9h2v2"/></svg>',
  people: '<svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.3"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M15.2 14.2c2.7.4 4.8 2.7 4.8 5.8"/></svg>',
  chevrons: '<svg viewBox="0 0 24 24"><path d="M6 15l6-6 6 6M6 21l6-6 6 6"/></svg>',
  star: '<svg viewBox="0 0 24 24"><path d="M12 2.8l2.8 5.7 6.3.9-4.55 4.45 1.08 6.28L12 17.15l-5.63 2.98 1.08-6.28L2.9 9.4l6.3-.9z"/></svg>',
  flag: '<svg viewBox="0 0 24 24"><path d="M5 3v18"/><path d="M6 4h11.5l-1.85 4.1 1.85 4.1H6z"/></svg>',
}
---

<section class="jfp-journey" aria-labelledby="jfp-journey-title">
  <picture class="jfp-journey-bg">
    <source media="(max-width: 720px)" srcset={mobileImage} />
    <img
      src={image}
      alt="Lee Jones at the Joner Football indoor training facility holding a football"
      loading="lazy"
      decoding="async"
    />
  </picture>

  <div class="jfp-journey-shade" aria-hidden="true"></div>

  <div class="jfp-journey-inner">
    <header class="jfp-journey-head">
      <p class="jfp-title-small">The</p>
      <h2 id="jfp-journey-title">Journey</h2>
      <span class="jfp-red-rule" aria-hidden="true"></span>
      <p class="jfp-subtitle">JFP Player Pathway</p>
    </header>

    <ul class="jfp-chips" aria-label="JFP program features">
      {chips.map((chip) => (
        <li>
          <a href={contactHref} aria-label={`${chip.label}: contact Joner Football`}>
            <span class="chip-icon" aria-hidden="true" set:html={icons[chip.icon]}></span>
            <span>{chip.label}</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="jfp-map" aria-label="JFP pathway stages">
      <svg class="jfp-map-lines" viewBox="0 0 760 370" preserveAspectRatio="none" aria-hidden="true">
        <path class="line-white" d="M126 185 C126 230 258 214 288 238" />
        <path class="line-white" d="M380 185 L380 238" />
        <path class="line-white" d="M634 185 C634 230 502 214 472 238" />
        <path class="line-red line-dash" d="M128 208 C270 255 488 255 632 208" />
      </svg>

      {stages.map((stage, index) => (
        <a class:list={['jfp-stage', `jfp-stage--${index + 1}`]} href={contactHref} aria-label={`${stage.title}: contact Joner Football`}>
          <span class="jfp-stage-tag">{stage.tag}</span>
          <span class="jfp-stage-icon" aria-hidden="true" set:html={icons[stage.icon]}></span>
          <strong>{stage.title}</strong>
          <small>{stage.age}</small>
        </a>
      ))}

      <a class="jfp-hub" href={contactHref} aria-label="JFP Player Pathway: contact Joner Football">
        <strong>JFP</strong>
        <span>Player Pathway</span>
      </a>
    </div>

    <span class="jfp-program-connector" aria-hidden="true"></span>
    <span class="jfp-goal-connector" aria-hidden="true"></span>

    <div class="jfp-right-stack">
      <a class="jfp-program-card" href={contactHref} aria-label="The complete development program: contact Joner Football">
        <span class="program-star" aria-hidden="true" set:html={icons.star}></span>
        <strong>The complete<br />development program.</strong>
        <span>Ages 8+</span>
        <span>Max 6 per group</span>
        <em>Since 2013</em>
      </a>

      <a class="jfp-goal-card" href={contactHref} aria-label="The goal, a career in football: contact Joner Football">
        <span class="goal-flag" aria-hidden="true" set:html={icons.flag}></span>
        <span>The Goal</span>
        <strong>A Career In Football</strong>
      </a>

      <a class="jfp-cta" href={ctaHref} aria-label={`${ctaLabel}: contact Joner Football`}>
        <span>{ctaLabel}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12h13M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>

    <footer class="jfp-unlocks" aria-label="What JFP unlocks">
      <a class="jfp-unlocks-head" href={contactHref} aria-label="What JFP unlocks: contact Joner Football">
        <span>What JFP</span>
        <strong>Unlocks</strong>
      </a>
      <ul>
        {unlocks.map((item) => (
          <li>
            <a href={contactHref} aria-label={`${item.label}: contact Joner Football`}>
              <span class="unlock-icon" aria-hidden="true" set:html={icons[item.icon]}></span>
              <span>{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </footer>
  </div>
</section>

<style>
  .jfp-journey {
    --jfp-red: #e30613;
    position: relative;
    min-height: clamp(48rem, 56.25vw, 61rem);
    overflow: hidden;
    isolation: isolate;
    background: #030303;
    color: #fff;
  }

  .jfp-journey-bg,
  .jfp-journey-bg img,
  .jfp-journey-shade {
    position: absolute;
    inset: 0;
  }

  .jfp-journey-bg {
    z-index: 0;
    display: block;
  }

  .jfp-journey-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    filter: saturate(0.96) contrast(1.12) brightness(0.72);
  }

  .jfp-journey-shade {
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(circle at 47% 40%, rgba(255,255,255,0.08), transparent 17rem),
      radial-gradient(circle at 82% 75%, rgba(227,6,19,0.16), transparent 18rem),
      linear-gradient(90deg, rgba(0,0,0,0.66), rgba(0,0,0,0.18) 46%, rgba(0,0,0,0.7)),
      linear-gradient(180deg, rgba(0,0,0,0.5), rgba(0,0,0,0.06) 45%, rgba(0,0,0,0.74));
    box-shadow: inset 0 0 6.5rem rgba(0,0,0,0.72);
  }

  .jfp-journey-inner {
    position: relative;
    z-index: 2;
    width: min(100%, 100rem);
    min-height: inherit;
    margin: 0 auto;
    padding: clamp(4.4rem, 6vw, 6.6rem) clamp(1.25rem, 4.2vw, 4.5rem) clamp(3.6rem, 5vw, 4.7rem);
  }

  .jfp-journey-head {
    position: absolute;
    left: clamp(6.8rem, 6.9vw, 7.15rem);
    top: clamp(4.8rem, 5.1vw, 5.3rem);
    width: clamp(17rem, 25vw, 28rem);
    text-transform: uppercase;
    text-shadow: 0 1.2rem 2.7rem rgba(0,0,0,0.72);
  }

  .jfp-title-small,
  .jfp-journey-head h2,
  .jfp-subtitle,
  .jfp-stage strong,
  .jfp-hub,
  .jfp-goal-card,
  .jfp-cta,
  .jfp-unlocks-head {
    font-family: 'Anton', Impact, 'Arial Narrow Bold', sans-serif;
  }

  .jfp-title-small {
    margin: 0 0 0.35rem clamp(6.7rem, 6.8vw, 7.15rem);
    font-size: clamp(2.75rem, 4vw, 4.15rem);
    font-style: italic;
    line-height: 1;
    letter-spacing: 0.05em;
  }

  .jfp-journey-head h2 {
    margin: 0;
    font-size: clamp(5.15rem, 7.3vw, 7.45rem);
    font-style: italic;
    line-height: 0.88;
    letter-spacing: 0.018em;
  }

  .jfp-red-rule {
    display: block;
    width: 7.7rem;
    height: 0.22rem;
    margin: 1rem 0 0.85rem;
    background: var(--jfp-red);
    box-shadow: 0 0 1.3rem rgba(227,6,19,0.42);
  }

  .jfp-subtitle {
    margin: 0;
    font-size: clamp(0.9rem, 1.2vw, 1.08rem);
    font-style: italic;
    letter-spacing: 0.32em;
  }

  .jfp-chips {
    position: absolute;
    left: clamp(1.9rem, 2vw, 2.1rem);
    top: clamp(24rem, 24.8vw, 24.8rem);
    display: grid;
    gap: 1rem;
    width: clamp(17rem, 17.6vw, 17.9rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .jfp-chips a {
    display: grid;
    grid-template-columns: 2.2rem 1fr;
    align-items: center;
    gap: 1rem;
    min-height: 3.7rem;
    padding: 0 1.45rem;
    border: 1px solid rgba(255,255,255,0.32);
    border-radius: 999px;
    background: rgba(5,5,5,0.55);
    color: #fff;
    backdrop-filter: blur(15px);
    font-size: clamp(0.85rem, 1vw, 1rem);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
  }

  .jfp-chips a:hover,
  .jfp-chips a:focus-visible {
    transform: translateY(-0.18rem);
    border-color: rgba(227,6,19,0.88);
    box-shadow: 0 0 1.4rem rgba(227,6,19,0.18);
    outline: none;
  }

  .chip-icon {
    color: var(--jfp-red);
    width: 2.1rem;
    height: 2.1rem;
    filter: drop-shadow(0 0 0.65rem rgba(227,6,19,0.5));
  }

  .jfp-map {
    position: absolute;
    left: clamp(28.4rem, 28.8vw, 29rem);
    top: clamp(21.8rem, 22.3vw, 22.35rem);
    width: clamp(45.8rem, 45vw, 47rem);
    height: clamp(22.75rem, 22.95vw, 23rem);
  }

  .jfp-map-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .jfp-map-lines path {
    fill: none;
    stroke-width: 3;
    vector-effect: non-scaling-stroke;
  }

  .line-white {
    stroke: rgba(255,255,255,0.82);
  }

  .line-red {
    stroke: var(--jfp-red);
  }

  .line-dash {
    stroke-dasharray: 5 10;
    opacity: 0.92;
  }

  .jfp-stage {
    position: absolute;
    top: 0;
    display: grid;
    place-items: center;
    width: 10.35rem;
    min-height: 11.45rem;
    padding: 2.4rem 1rem 1.25rem;
    border: 1px solid rgba(255,255,255,0.34);
    border-radius: 0.58rem;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.01)),
      rgba(6,6,6,0.72);
    color: #fff;
    text-align: center;
    text-decoration: none;
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.18),
      0 1.5rem 3.4rem rgba(0,0,0,0.38);
    backdrop-filter: blur(18px);
    transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
  }

  .jfp-stage:hover,
  .jfp-stage:focus-visible {
    transform: translateY(-0.25rem);
    border-color: rgba(227,6,19,0.88);
    box-shadow:
      inset 0 0 0 1px rgba(227,6,19,0.5),
      0 1.75rem 3.8rem rgba(0,0,0,0.44),
      0 0 2rem rgba(227,6,19,0.24);
    outline: none;
  }

  .jfp-stage--1 { left: 0; }
  .jfp-stage--2 { left: 50%; transform: translateX(-50%); }
  .jfp-stage--2:hover,
  .jfp-stage--2:focus-visible { transform: translateX(-50%) translateY(-0.25rem); }
  .jfp-stage--3 {
    right: 0;
    transform: translateY(-0.45rem) scale(1.06);
    border-color: rgba(227,6,19,0.92);
    box-shadow:
      inset 0 0 0 1px rgba(227,6,19,0.36),
      0 1.8rem 3.8rem rgba(0,0,0,0.44),
      0 0 2.4rem rgba(227,6,19,0.24);
  }

  .jfp-stage--3:hover,
  .jfp-stage--3:focus-visible {
    transform: translateY(-0.7rem) scale(1.08);
  }

  .jfp-stage-tag {
    position: absolute;
    top: -0.8rem;
    left: 50%;
    transform: translateX(-50%);
    min-width: 7.3rem;
    padding: 0.45rem 0.8rem 0.42rem;
    border-radius: 0.34rem;
    background: var(--jfp-red);
    font-family: 'Anton', Impact, sans-serif;
    font-size: 0.74rem;
    font-style: italic;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
  }

  .jfp-stage--3 .jfp-stage-tag {
    min-width: 8.2rem;
    padding-block: 0.52rem 0.48rem;
    background: linear-gradient(180deg, #ff2029, var(--jfp-red));
    font-size: 0.82rem;
    box-shadow: 0 0 1.45rem rgba(227,6,19,0.48);
  }

  .jfp-stage-icon {
    display: grid;
    place-items: center;
    width: 3.35rem;
    height: 3.35rem;
    margin-bottom: 0.7rem;
    filter: drop-shadow(0 0 0.7rem rgba(255,255,255,0.16));
  }

  .jfp-stage strong {
    display: block;
    max-width: 8.5rem;
    font-size: 1.24rem;
    line-height: 0.95;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .jfp-stage small {
    margin-top: 0.7rem;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.66);
  }

  .jfp-hub {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.7rem;
    width: min(19.1rem, 50%);
    min-height: 8.55rem;
    padding: 1.1rem 1.5rem;
    border: 1px solid rgba(227,6,19,0.92);
    border-radius: 0.68rem;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.08), transparent),
      rgba(4,4,4,0.78);
    color: #fff;
    text-decoration: none;
    text-transform: uppercase;
    box-shadow: 0 1.4rem 3rem rgba(0,0,0,0.42), 0 0 2.3rem rgba(227,6,19,0.2);
    backdrop-filter: blur(18px);
    transition: transform 220ms ease, background-color 220ms ease, box-shadow 220ms ease;
  }

  .jfp-hub strong {
    color: var(--jfp-red);
    font-size: clamp(3rem, 4vw, 4.05rem);
    font-style: italic;
    line-height: 0.9;
  }

  .jfp-hub span {
    font-size: clamp(1.2rem, 1.52vw, 1.55rem);
    font-style: italic;
    letter-spacing: 0.08em;
  }

  .jfp-hub:hover,
  .jfp-hub:focus-visible {
    transform: translateX(-50%) translateY(-0.2rem);
    background-color: rgba(15,4,4,0.84);
    box-shadow: 0 1.55rem 3.4rem rgba(0,0,0,0.48), 0 0 2.6rem rgba(227,6,19,0.32);
    outline: none;
  }

  .jfp-right-stack {
    position: absolute;
    right: clamp(1.4rem, 2.8vw, 3rem);
    top: clamp(13.5rem, 14.4vw, 14.6rem);
    display: grid;
    justify-items: end;
    gap: clamp(0.9rem, 1.1vw, 1.15rem);
    width: clamp(21rem, 21vw, 21.35rem);
  }

  .jfp-program-card,
  .jfp-goal-card {
    border: 1px solid rgba(227,6,19,0.88);
    border-radius: 0.7rem;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.06), transparent),
      rgba(4,4,4,0.62);
    color: #fff;
    text-decoration: none;
    backdrop-filter: blur(16px);
    box-shadow: 0 1.3rem 3rem rgba(0,0,0,0.36);
    transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
  }

  .jfp-program-card:hover,
  .jfp-program-card:focus-visible,
  .jfp-goal-card:hover,
  .jfp-goal-card:focus-visible {
    transform: translateY(-0.22rem);
    border-color: rgba(255,46,57,0.96);
    box-shadow: 0 1.55rem 3.3rem rgba(0,0,0,0.42), 0 0 2rem rgba(227,6,19,0.24);
    outline: none;
  }

  .jfp-program-card {
    width: clamp(15.5rem, 15.9vw, 16.2rem);
    padding: 1.05rem 1.15rem 1.1rem;
    display: grid;
    gap: 0.68rem;
    text-transform: uppercase;
  }

  .program-star {
    color: #fff;
    width: 1.6rem;
    height: 1.6rem;
    filter: drop-shadow(0 0 0.55rem rgba(255,255,255,0.28));
  }

  .jfp-program-card strong {
    font-size: 0.92rem;
    letter-spacing: 0.08em;
    line-height: 1.45;
  }

  .jfp-program-card span:not(.program-star) {
    border-bottom: 1px solid rgba(227,6,19,0.48);
    padding-bottom: 0.58rem;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.84);
  }

  .jfp-program-card em {
    color: var(--jfp-red);
    font-style: normal;
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  .jfp-goal-card {
    width: 100%;
    min-height: clamp(9.7rem, 10.7vw, 11.1rem);
    padding: 1rem 1.45rem 1.1rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    text-transform: uppercase;
  }

  .goal-flag {
    color: var(--jfp-red);
    width: 2.25rem;
    height: 2.25rem;
    filter: drop-shadow(0 0 0.75rem rgba(227,6,19,0.55));
  }

  .jfp-goal-card span:not(.goal-flag) {
    margin-top: 0.62rem;
    font-size: 0.98rem;
    font-style: italic;
    letter-spacing: 0.16em;
  }

  .jfp-goal-card span:not(.goal-flag)::after {
    content: "";
    display: block;
    width: 2rem;
    height: 0.16rem;
    margin: 0.46rem auto 0;
    background: var(--jfp-red);
  }

  .jfp-goal-card strong {
    margin-top: 0.52rem;
    max-width: 15rem;
    font-size: clamp(2.05rem, 3vw, 3rem);
    font-style: italic;
    line-height: 0.92;
    letter-spacing: 0.04em;
  }

  .jfp-unlocks {
    position: absolute;
    left: clamp(0.35rem, 0.5vw, 0.55rem);
    bottom: clamp(2.65rem, 2.9vw, 2.95rem);
    width: min(71rem, 68vw);
    min-height: 10rem;
    display: grid;
    grid-template-columns: 12.4rem 1fr;
    align-items: stretch;
    border: 1px solid rgba(255,255,255,0.28);
    border-radius: 0.64rem;
    background: rgba(4,4,4,0.66);
    backdrop-filter: blur(18px);
    box-shadow: 0 1.2rem 3.4rem rgba(0,0,0,0.38);
    overflow: hidden;
  }

  .jfp-unlocks-head {
    position: relative;
    display: grid;
    align-content: center;
    padding: 1.1rem 1.4rem;
    border-right: 1px solid rgba(255,255,255,0.32);
    color: #fff;
    text-decoration: none;
