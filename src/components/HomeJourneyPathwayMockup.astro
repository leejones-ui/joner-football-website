---
export interface Props {
  image?: string
  mobileImage?: string
  ctaHref?: string
  ctaLabel?: string
}

const {
  image = '/images/homepage/jfp-journey-pathway.webp',
  mobileImage = '/images/homepage/jfp-journey-pathway-mobile.webp',
  ctaHref = '/training#jfp-form',
  ctaLabel = 'Start Your Journey',
} = Astro.props
---

<section class="journey-pathway" aria-labelledby="journey-pathway-title">
  <h2 id="journey-pathway-title" class="journey-pathway-heading">
    The Journey - JFP Player Pathway
  </h2>

  <picture class="journey-pathway-art">
    <source media="(max-width: 700px)" srcset={mobileImage} />
    <img
      src={image}
      alt="The Journey JFP Player Pathway showing Joners Juniors, Joner 6-8 Year Old Program, Joner Football Performance, and the goal of a career in football"
      loading="lazy"
      decoding="async"
    />
  </picture>

  <a class="journey-pathway-cta" href={ctaHref} aria-label={`${ctaLabel}: enquire about JFP`}>
    <span>{ctaLabel}</span>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 12h13M13 6l6 6-6 6" />
    </svg>
  </a>
</section>

<style>
  .journey-pathway {
    position: relative;
    width: 100%;
    overflow: hidden;
    isolation: isolate;
    background: #020202;
    color: #fff;
    aspect-ratio: 1672 / 941;
    min-height: clamp(33rem, 56vw, 58rem);
    box-shadow: inset 0 0 5rem rgba(0,0,0,0.45);
  }

  .journey-pathway-heading {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .journey-pathway-art {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
  }

  .journey-pathway-art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .journey-pathway::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(circle at 86% 90%, rgba(227,6,19,0.18), transparent 20rem),
      linear-gradient(180deg, rgba(0,0,0,0.08), rgba(0,0,0,0.28));
  }

  .journey-pathway-cta {
    position: absolute;
    z-index: 2;
    right: 3.95%;
    bottom: 4.65%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.85rem, 1.25vw, 1.3rem);
    width: min(23.4%, 24.5rem);
    min-width: 18rem;
    min-height: clamp(3.35rem, 4.7vw, 4.7rem);
    padding: clamp(0.95rem, 1.2vw, 1.2rem) clamp(1.35rem, 1.8vw, 1.85rem);
    border: 1px solid rgba(255,255,255,0.22);
    border-radius: 0.42rem;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.18), rgba(255,255,255,0)),
      linear-gradient(135deg, #ff171f 0%, #e30613 52%, #b90008 100%);
    color: #fff;
    font-family: 'Anton', Impact, 'Arial Narrow Bold', sans-serif;
    font-size: clamp(1.2rem, 1.55vw, 1.55rem);
    line-height: 1;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    text-decoration: none;
    text-shadow: 0 0.45rem 1rem rgba(0,0,0,0.35);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.24),
      0 1.1rem 2.6rem rgba(0,0,0,0.42),
      0 0 1.8rem rgba(227,6,19,0.28);
    transform: translateZ(0);
    transition:
      transform 240ms cubic-bezier(.22,1,.36,1),
      border-color 240ms ease,
      box-shadow 240ms ease,
      background-color 240ms ease;
  }

  .journey-pathway-cta::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.22), transparent);
    opacity: 0;
    transform: translateX(-35%);
    transition: opacity 240ms ease, transform 420ms cubic-bezier(.22,1,.36,1);
    pointer-events: none;
  }

  .journey-pathway-cta span,
  .journey-pathway-cta svg {
    position: relative;
    z-index: 1;
  }

  .journey-pathway-cta svg {
    width: clamp(1.35rem, 1.7vw, 1.75rem);
    height: clamp(1.35rem, 1.7vw, 1.75rem);
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 240ms cubic-bezier(.22,1,.36,1);
  }

  .journey-pathway-cta:hover,
  .journey-pathway-cta:focus-visible {
    transform: translateY(-0.22rem);
    border-color: rgba(255,255,255,0.5);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.32),
      0 1.45rem 3.1rem rgba(0,0,0,0.48),
      0 0 2.4rem rgba(227,6,19,0.42);
    outline: none;
  }

  .journey-pathway-cta:hover::before,
  .journey-pathway-cta:focus-visible::before {
    opacity: 1;
    transform: translateX(35%);
  }

  .journey-pathway-cta:hover svg,
  .journey-pathway-cta:focus-visible svg {
    transform: translateX(0.35rem);
  }

  .journey-pathway-cta:active {
    transform: translateY(0);
    transition-duration: 80ms;
  }

  @media (max-width: 900px) {
    .journey-pathway {
      min-height: auto;
    }

    .journey-pathway-cta {
      right: 3.5%;
      bottom: 4%;
      width: 27%;
      min-width: 14rem;
      min-height: 3.25rem;
      font-size: 1rem;
      letter-spacing: 0.1em;
    }
  }

  @media (max-width: 700px) {
    .journey-pathway {
      aspect-ratio: 900 / 507;
      min-height: 20rem;
    }

    .journey-pathway::after {
      background:
        linear-gradient(180deg, rgba(0,0,0,0), rgba(0,0,0,0.26) 62%, rgba(0,0,0,0.62));
    }

    .journey-pathway-cta {
      left: 1rem;
      right: 1rem;
      bottom: 1rem;
      width: auto;
      min-width: 0;
      min-height: 3.25rem;
      padding: 0.92rem 1.15rem;
      border-radius: 0.36rem;
      font-size: clamp(1rem, 4.6vw, 1.2rem);
    }
  }

  @media (max-width: 430px) {
    .journey-pathway {
      min-height: 18rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .journey-pathway-cta,
    .journey-pathway-cta::before,
    .journey-pathway-cta svg {
      transition: none;
    }
  }
</style>
