---
export interface Props {
  image?: string
  mobileImage?: string
  ctaHref?: string
  ctaLabel?: string
}

const contactHref = '/contact?type=training-sydney'

const {
  image = '/images/homepage/jfp-journey-photo.webp',
  mobileImage = '/images/homepage/jfp-journey-photo-mobile.webp',
  ctaHref = contactHref,
  ctaLabel = 'Start Your Journey',
} = Astro.props

const chips = [
  { label: '10-week terms', icon: 'calendar' },
  { label: 'Player reports', icon: 'bars' },
  { label: 'Elite coaching', icon: 'key' },
]

const stages = [
  { tag: 'Stage 1', title: 'Joners Juniors', age: 'Ages 4 to 6', icon: 'shirt' },
  { tag: 'Stage 2', title: 'Joner 6-8 Year Old Program', age: 'Ages 6 to 8', icon: 'ball' },
  { tag: 'Flagship', title: 'Joner Football Performance', age: 'Ages 9 to 18', icon: 'jf' },
]

const unlocks = [
  { label: 'Joner App', icon: 'phone' },
  { label: 'S&C (FPA)', icon: 'dumbbell' },
  { label: 'FullNinety', icon: 'fn' },
  { label: 'Game Analysis', icon: 'analysis' },
  { label: 'Mentorship', icon: 'people' },
  { label: 'High Level Training', icon: 'chevrons' },
]

const icons: Record<string, string> = {
  calendar: '<svg viewBox="0 0 24 24"><path d="M7 3v4M17 3v4M4 8h16M6 5h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z"/><path d="M8 12h2M12 12h2M16 12h1M8 16h2M12 16h2M16 16h1"/></svg>',
  bars: '<svg viewBox="0 0 24 24"><path d="M5 20V10M12 20V5M19 20V14"/></svg>',
  key: '<svg viewBox="0 0 24 24"><circle cx="8" cy="14" r="4"/><path d="M12 14h9M17 14v-3M20 14v-2"/></svg>',
  shirt: '<svg viewBox="0 0 24 24"><path d="M8 4l-5 3 2 4 3-1v10h8V10l3 1 2-4-5-3-3 2h-2z"/></svg>',
  ball: '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7l4 3-1.5 5h-5L8 10zM12 7V3M16 10l4-1M14.5 15l2.5 4M9.5 15L7 19M8 10L4 9"/></svg>',
  jf: '<svg viewBox="0 0 24 24"><path d="M12 3l8 2.8v6.9c0 4.1-3.1 7.2-8 8.8-4.9-1.6-8-4.7-8-8.8V5.8z"/><text x="12" y="14.7" text-anchor="middle" font-size="7.4" font-family="Anton, Impact, sans-serif" font-weight="900" fill="currentColor">JF</text></svg>',
  phone: '<svg viewBox="0 0 24 24"><rect x="7" y="3" width="10" height="18" rx="2"/><path d="M11 18h2"/></svg>',
  dumbbell: '<svg viewBox="0 0 24 24"><path d="M3 9v6M7 7v10M17 7v10M21 9v6M7 12h10"/></svg>',
  fn: '<svg viewBox="0 0 48 24"><path d="M3 17h9l5-10h9l-5 10h8l5-10h11"/><path d="M18 7h9M29 17h9"/></svg>',
  analysis: '<svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M8 15l3-3 3 2 3-5M16 9h2v2"/></svg>',
  people: '<svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.3"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M15.2 14.2c2.7.4 4.8 2.7 4.8 5.8"/></svg>',
  chevrons: '<svg viewBox="0 0 24 24"><path d="M6 15l6-6 6 6M6 21l6-6 6 6"/></svg>',
  star: '<svg viewBox="0 0 24 24"><path d="M12 2.8l2.8 5.7 6.3.9-4.55 4.45 1.08 6.28L12 17.15l-5.63 2.98 1.08-6.28L2.9 9.4l6.3-.9z"/></svg>',
  flag: '<svg viewBox="0 0 24 24"><path d="M5 3v18"/><path d="M6 4h11.5l-1.85 4.1 1.85 4.1H6z"/></svg>',
}
---

<section class="jfp-journey" aria-labelledby="jfp-journey-title">
  <picture class="jfp-bg">
    <source media="(max-width: 720px)" srcset={mobileImage} />
    <img src={image} alt="Lee Jones at the Joner Football indoor training facility" loading="lazy" decoding="async" />
  </picture>
  <div class="jfp-shade" aria-hidden="true"></div>

  <div class="jfp-inner">
    <header class="jfp-head">
      <p>The</p>
      <h2 id="jfp-journey-title">Journey</h2>
      <span aria-hidden="true"></span>
      <small>JFP Player Pathway</small>
    </header>

    <ul class="jfp-chips" aria-label="JFP program features">
      {chips.map((chip) => (
        <li>
          <a href={contactHref}>
            <span aria-hidden="true" set:html={icons[chip.icon]}></span>
            <strong>{chip.label}</strong>
          </a>
        </li>
      ))}
    </ul>

    <div class="jfp-map" aria-label="JFP pathway stages">
      <svg class="jfp-lines jfp-lines-desktop" viewBox="0 0 1000 420" preserveAspectRatio="none" aria-hidden="true">
        <path class="white" d="M150 156 C220 282 372 286 500 330" />
        <path class="white" d="M500 156 L500 330" />
        <path class="white" d="M850 156 C780 282 628 286 500 330" />
        <path class="red dashed" d="M150 230 C325 292 675 292 850 230" />
        <path class="red" d="M850 156 L982 156" />
        <path class="red" d="M850 236 L982 236" />
      </svg>

      <div class="jfp-stage-row">
        {stages.map((stage, index) => (
          <a class:list={['jfp-stage', index === 2 && 'featured']} href={contactHref}>
            <span class="stage-tag">{stage.tag}</span>
            <span class="stage-icon" aria-hidden="true" set:html={icons[stage.icon]}></span>
            <strong>{stage.title}</strong>
            <small>{stage.age}</small>
          </a>
        ))}
      </div>

      <a class="jfp-hub" href={contactHref}>
        <strong>JFP</strong>
        <span>Player Pathway</span>
      </a>
    </div>

    <aside class="jfp-side" aria-label="JFP destination">
      <a class="jfp-program-card" href={contactHref}>
        <span class="program-star" aria-hidden="true" set:html={icons.star}></span>
        <strong>The complete<br />development program.</strong>
        <span>Ages 8+</span>
        <span>Max 6 per group</span>
        <em>Since 2013</em>
      </a>

      <a class="jfp-goal-card" href={contactHref}>
        <span aria-hidden="true" set:html={icons.flag}></span>
        <small>The Goal</small>
        <strong>A Career In Football</strong>
      </a>

      <a class="jfp-cta" href={ctaHref}>
        <span>{ctaLabel}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
      </a>
    </aside>

    <footer class="jfp-unlocks" aria-label="What JFP unlocks">
      <a class="jfp-unlocks-head" href={contactHref}>
        <span>What JFP</span>
        <strong>Unlocks</strong>
      </a>
      <ul>
        {unlocks.map((item) => (
          <li>
            <a href={contactHref}>
              <span aria-hidden="true" set:html={icons[item.icon]}></span>
              <strong>{item.label}</strong>
            </a>
          </li>
        ))}
      </ul>
    </footer>
  </div>
</section>

<style>
  .jfp-journey {
    --jfp-red: #e30613;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: #030303;
    color: #fff;
  }

  .jfp-bg,
  .jfp-bg img,
  .jfp-shade {
    position: absolute;
    inset: 0;
  }

  .jfp-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    filter: saturate(0.96) contrast(1.12) brightness(0.74);
  }

  .jfp-shade {
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(circle at 48% 43%, rgba(255,255,255,0.08), transparent 17rem),
      radial-gradient(circle at 78% 68%, rgba(227,6,19,0.17), transparent 19rem),
      linear-gradient(90deg, rgba(0,0,0,0.78), rgba(0,0,0,0.22) 48%, rgba(0,0,0,0.82)),
      linear-gradient(180deg, rgba(0,0,0,0.58), rgba(0,0,0,0.08) 44%, rgba(0,0,0,0.86));
    box-shadow: inset 0 0 6rem rgba(0,0,0,0.74);
  }

  .jfp-inner {
    position: relative;
    z-index: 2;
    width: min(100%, 104rem);
    min-height: clamp(48rem, 56.25vw, 62rem);
    margin: 0 auto;
    padding: clamp(3.5rem, 5vw, 5.7rem) clamp(1.15rem, 4vw, 4.5rem) clamp(2.1rem, 3vw, 3.2rem);
    display: grid;
    grid-template-columns: minmax(14rem, 0.9fr) minmax(37rem, 2.1fr) minmax(16rem, 0.95fr);
    grid-template-rows: auto 1fr auto;
    grid-template-areas:
      "head map side"
      "chips map side"
      "unlocks unlocks unlocks";
    gap: clamp(1.5rem, 2vw, 2.3rem);
    align-items: center;
  }

  .jfp-head {
    grid-area: head;
    align-self: start;
    text-transform: uppercase;
    text-shadow: 0 1.2rem 2.7rem rgba(0,0,0,0.72);
  }

  .jfp-head p,
  .jfp-head h2,
  .jfp-head small,
  .jfp-stage strong,
  .jfp-hub,
  .jfp-goal-card,
  .jfp-cta,
  .jfp-unlocks-head,
  .jfp-chips strong {
    font-family: 'Anton', Impact, 'Arial Narrow Bold', sans-serif;
  }

  .jfp-head p {
    margin: 0 0 0.25rem 4.7rem;
    font-size: clamp(2.2rem, 3.2vw, 4.1rem);
    font-style: italic;
    line-height: 1;
    letter-spacing: 0.05em;
  }

  .jfp-head h2 {
    margin: 0;
    font-size: clamp(4.5rem, 6.5vw, 7.5rem);
    font-style: italic;
    line-height: 0.88;
    letter-spacing: 0.015em;
  }

  .jfp-head > span {
    display: block;
    width: clamp(5.2rem, 8vw, 8.4rem);
    height: 0.22rem;
    margin: 1.05rem 0 0.9rem;
    background: var(--jfp-red);
    box-shadow: 0 0 1.2rem rgba(227,6,19,0.54);
  }

  .jfp-head small {
    display: block;
    font-size: clamp(0.72rem, 1vw, 0.94rem);
    font-style: italic;
    letter-spacing: 0.42em;
    color: rgba(255,255,255,0.9);
  }

  .jfp-chips {
    grid-area: chips;
    align-self: center;
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .jfp-chips a,
  .jfp-stage,
  .jfp-program-card,
  .jfp-goal-card,
  .jfp-cta,
  .jfp-unlocks-head,
  .jfp-unlocks li a,
  .jfp-hub {
    color: #fff;
    text-decoration: none;
  }

  .jfp-chips a {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4.7rem;
    padding: 0.95rem 1.2rem;
    border: 1px solid rgba(255,255,255,0.22);
    border-radius: 999px;
    background: rgba(5,5,5,0.62);
    box-shadow: 0 1rem 2.6rem rgba(0,0,0,0.28);
    backdrop-filter: blur(16px);
  }

  .jfp-chips svg,
  .jfp-stage svg,
  .jfp-side svg,
  .jfp-unlocks svg,
  .jfp-cta svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .jfp-chips a > span {
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    color: var(--jfp-red);
    filter: drop-shadow(0 0 0.65rem rgba(227,6,19,0.5));
  }

  .jfp-chips strong {
    font-size: clamp(0.86rem, 1vw, 1rem);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .jfp-map {
    grid-area: map;
    position: relative;
    min-height: clamp(25rem, 30vw, 32rem);
    align-self: center;
    padding: clamp(1.7rem, 2vw, 2.2rem) 0 0;
  }

  .jfp-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    overflow: visible;
  }

  .jfp-lines path {
    fill: none;
    stroke-width: 2.5;
    vector-effect: non-scaling-stroke;
  }

  .jfp-lines .white { stroke: rgba(255,255,255,0.78); }
  .jfp-lines .red { stroke: var(--jfp-red); }
  .jfp-lines .dashed { stroke-dasharray: 5 10; opacity: 0.9; }

  .jfp-stage-row {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.1rem, 2.1vw, 2rem);
    align-items: start;
  }

  .jfp-stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(10.5rem, 12vw, 12rem);
    padding: 2.5rem 0.85rem 1.2rem;
    border: 1px solid rgba(255,255,255,0.34);
    border-radius: 0.62rem;
    background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.01)), rgba(6,6,6,0.78);
    text-align: center;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.18), 0 1.4rem 3.3rem rgba(0,0,0,0.4);
    backdrop-filter: blur(18px);
    transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
  }

  .jfp-stage:hover,
  .jfp-stage:focus-visible {
    transform: translateY(-0.25rem);
    border-color: rgba(227,6,19,0.9);
    box-shadow: inset 0 0 0 1px rgba(227,6,19,0.45), 0 1.75rem 3.8rem rgba(0,0,0,0.46), 0 0 2rem rgba(227,6,19,0.24);
    outline: none;
  }

  .jfp-stage.featured {
    margin-top: -0.6rem;
    transform: scale(1.04);
    border-color: rgba(227,6,19,0.92);
    box-shadow: inset 0 0 0 1px rgba(227,6,19,0.36), 0 1.8rem 3.8rem rgba(0,0,0,0.44), 0 0 2.4rem rgba(227,6,19,0.24);
  }

  .jfp-stage.featured:hover,
  .jfp-stage.featured:focus-visible {
    transform: translateY(-0.25rem) scale(1.04);
  }

  .stage-tag {
    position: absolute;
    top: -0.75rem;
    left: 50%;
    transform: translateX(-50%);
    min-width: 7.2rem;
    padding: 0.48rem 0.72rem 0.42rem;
    border-radius: 0.34rem;
    background: var(--jfp-red);
    font-family: 'Anton', Impact, sans-serif;
    font-size: clamp(0.64rem, 0.75vw, 0.78rem);
    font-style: italic;
    letter-spacing: 0.11em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .stage-icon {
    display: grid;
    place-items: center;
    width: clamp(2.6rem, 3.5vw, 3.35rem);
    height: clamp(2.6rem, 3.5vw, 3.35rem);
    margin-bottom: 0.65rem;
  }

  .jfp-stage strong {
    display: block;
    max-width: 9rem;
    font-size: clamp(1rem, 1.35vw, 1.35rem);
    line-height: 0.96;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .jfp-stage small {
    margin-top: 0.7rem;
    font-size: clamp(0.55rem, 0.7vw, 0.7rem);
    font-weight: 800;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.68);
  }

  .jfp-hub {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.7rem;
    width: min(21rem, 72%);
    min-height: clamp(7.5rem, 9vw, 9rem);
    margin: clamp(4.2rem, 6vw, 6.2rem) auto 0;
    padding: 1.2rem 1.4rem;
    border: 1px solid rgba(227,6,19,0.94);
    border-radius: 0.72rem;
    background: linear-gradient(180deg, rgba(255,255,255,0.08), transparent), rgba(4,4,4,0.8);
    text-transform: uppercase;
    box-shadow: 0 1.4rem 3rem rgba(0,0,0,0.42), 0 0 2.3rem rgba(227,6,19,0.2);
    backdrop-filter: blur(18px);
  }

  .jfp-hub strong {
    color: var(--jfp-red);
    font-size: clamp(3rem, 4.2vw, 4.4rem);
    font-style: italic;
    line-height: 0.9;
  }

  .jfp-hub span {
    max-width: 7rem;
    font-size: clamp(1rem, 1.35vw, 1.35rem);
    font-style: italic;
    line-height: 1.08;
  }

  .jfp-side {
    grid-area: side;
    display: grid;
    gap: 1rem;
    align-self: center;
  }

  .jfp-program-card,
  .jfp-goal-card {
    display: grid;
    gap: 0.9rem;
    border: 1px solid rgba(227,6,19,0.42);
    border-radius: 0.74rem;
    background: rgba(6,6,6,0.64);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.12), 0 1.4rem 3rem rgba(0,0,0,0.35);
    backdrop-filter: blur(18px);
  }

  .jfp-program-card {
    padding: 1.25rem 1.2rem;
    text-transform: uppercase;
  }

  .program-star,
  .jfp-goal-card > span:first-child {
    display: grid;
    place-items: center;
    width: 1.55rem;
    height: 1.55rem;
    color: #fff;
  }

  .jfp-program-card strong {
    font-family: 'Anton', Impact, sans-serif;
    font-size: clamp(0.96rem, 1.05vw, 1.15rem);
    line-height: 1.2;
    letter-spacing: 0.08em;
  }

  .jfp-program-card span:not(.program-star) {
    padding-top: 0.85rem;
    border-top: 1px solid rgba(255,255,255,0.13);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  .jfp-program-card em {
    color: var(--jfp-red);
    font-family: 'Anton', Impact, sans-serif;
    font-style: italic;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .jfp-goal-card {
    min-height: 11rem;
    place-items: center;
    padding: 1.5rem 1.2rem;
    text-align: center;
    text-transform: uppercase;
  }

  .jfp-goal-card small {
    font-size: 0.72rem;
    font-style: italic;
    letter-spacing: 0.26em;
  }

  .jfp-goal-card strong {
    font-size: clamp(2rem, 2.55vw, 2.75rem);
    font-style: italic;
    line-height: 0.95;
  }

  .jfp-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    min-height: 4.6rem;
    padding: 1rem 1.2rem;
    border-radius: 0.42rem;
    background: linear-gradient(180deg, #ff353d, var(--jfp-red));
    font-size: clamp(1rem, 1.35vw, 1.25rem);
    font-style: italic;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    box-shadow: 0 1.25rem 2.6rem rgba(0,0,0,0.36), 0 0 1.6rem rgba(227,6,19,0.34);
    transition: transform 220ms ease, filter 220ms ease;
  }

  .jfp-cta:hover,
  .jfp-cta:focus-visible {
    transform: translateY(-0.18rem);
    filter: brightness(1.08);
    outline: none;
  }

  .jfp-cta svg {
    width: 1.55rem;
    height: 1.55rem;
    stroke-width: 2.4;
  }

  .jfp-unlocks {
    grid-area: unlocks;
    display: grid;
    grid-template-columns: minmax(9rem, 0.9fr) minmax(0, 5fr);
    align-items: stretch;
    margin-top: 0.6rem;
    border: 1px solid rgba(255,255,255,0.14);
    background: rgba(4,4,4,0.62);
    box-shadow: 0 -1rem 3rem rgba(0,0,0,0.18);
    backdrop-filter: blur(16px);
  }

  .jfp-unlocks-head {
    display: grid;
    align-content: center;
    padding: 1.4rem 1.6rem;
    border-right: 1px solid rgba(255,255,255,0.14);
    text-transform: uppercase;
  }

  .jfp-unlocks-head span,
  .jfp-unlocks-head strong {
    display: block;
    font-style: italic;
    line-height: 0.96;
  }

  .jfp-unlocks-head span { font-size: clamp(0.82rem, 1.1vw, 1.08rem); }
  .jfp-unlocks-head strong { font-size: clamp(1.35rem, 1.9vw, 2rem); }

  .jfp-unlocks ul {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .jfp-unlocks li a {
    display: grid;
    place-items: center;
    min-height: 6.3rem;
    padding: 0.95rem 0.8rem;
    border-right: 1px solid rgba(255,255,255,0.12);
    text-align: center;
  }

  .jfp-unlocks li:last-child a { border-right: 0; }

  .jfp-unlocks li a > span {
    width: 2.15rem;
    height: 2.15rem;
    color: var(--jfp-red);
    filter: drop-shadow(0 0 0.85rem rgba(227,6,19,0.42));
  }

  .jfp-unlocks li strong {
    margin-top: 0.55rem;
    font-family: 'Anton', Impact, sans-serif;
    font-size: clamp(0.62rem, 0.75vw, 0.74rem);
    letter-spacing: 0.12em;
    line-height: 1.08;
    text-transform: uppercase;
  }

  @media (max-width: 1220px) {
    .jfp-inner {
      grid-template-columns: minmax(13rem, 0.85fr) minmax(31rem, 1.75fr) minmax(14rem, 0.85fr);
      gap: 1.25rem;
    }

    .jfp-stage-row { gap: 1rem; }
    .jfp-stage { padding-inline: 0.7rem; }
  }

  @media (max-width: 1040px) {
    .jfp-inner {
      min-height: auto;
      grid-template-columns: 1fr;
      grid-template-areas:
