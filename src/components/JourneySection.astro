---
const stages = [
  {
    tag: 'Stage 1',
    title: 'Joners Juniors',
    age: 'Ages 4 to 6',
    href: '/training#joners-juniors',
    icon: 'shirt',
  },
  {
    tag: 'Stage 2',
    title: 'Joner 6-8 Year Old Program',
    age: 'Ages 6 to 8',
    href: '/training#joners-juniors',
    icon: 'people',
  },
  {
    tag: 'Flagship',
    title: 'Joner Football Performance',
    age: 'Ages 9 to 18',
    href: '/training#jfp',
    icon: 'jf',
  },
]

const chips = ['10-week terms', 'Player reports', 'Elite coaching']

const unlocks = [
  { label: 'Joner App',         icon: 'phone' },
  { label: 'S&C (FFA)',         icon: 'flame' },
  { label: 'Mentality',         icon: 'brain' },
  { label: 'Game Analysis',     icon: 'film' },
  { label: 'Mentorship',        icon: 'whistle' },
  { label: 'High Level Training', icon: 'arrow' },
]
---

<section class="jrn" aria-label="The Journey: JFP Player Pathway">
  <div class="jrn-photo" aria-hidden="true">
    <img src="/images/home-storyboard/05-global-camps.webp" alt="" loading="lazy" decoding="async" />
  </div>
  <div class="jrn-shade" aria-hidden="true"></div>

  <div class="jrn-inner">
    <header class="jrn-head">
      <h2 class="jrn-title">
        <span class="jrn-title-row">The</span>
        <span class="jrn-title-row jrn-title-row--big">Journey</span>
      </h2>
      <span class="jrn-rule" aria-hidden="true"></span>
      <p class="jrn-eyebrow">JFP Player Pathway</p>
      <ul class="jrn-chips">
        {chips.map((chip) => (
          <li class="jrn-chip">{chip}</li>
        ))}
      </ul>
    </header>

    <div class="jrn-stages-row">
      {stages.map((stage, idx) => (
        <a class:list={['jrn-stage', idx === 2 && 'jrn-stage--flagship']} href={stage.href} aria-label={stage.title}>
          <span class="jrn-stage-tag">{stage.tag}</span>
          <span class="jrn-stage-icon" aria-hidden="true">
            {stage.icon === 'shirt' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 4l-5 3 2 4 3-1v10h8V10l3 1 2-4-5-3-3 2-2 0-3-2z" />
              </svg>
            )}
            {stage.icon === 'people' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="8" r="3.2" />
                <path d="M3 19c0-3.3 2.7-6 6-6s6 2.7 6 6" />
                <circle cx="17" cy="9" r="2.4" />
                <path d="M15.6 13.6c2.6.5 4.4 2.7 4.4 5.4" />
              </svg>
            )}
            {stage.icon === 'jf' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linejoin="round">
                <path d="M3.5 4h17v3.5l-1.5 1v9l-7 3-7-3v-9l-1.5-1z" />
                <path d="M9 8.5v5a2 2 0 0 1-2 2" stroke-linecap="round" />
                <path d="M13 8.5h4M13 11.5h3" stroke-linecap="round" />
              </svg>
            )}
          </span>
          <span class="jrn-stage-title">{stage.title}</span>
          <span class="jrn-stage-age">{stage.age}</span>
        </a>
      ))}
    </div>

    <svg class="jrn-connectors" viewBox="0 0 100 30" preserveAspectRatio="none" aria-hidden="true">
      <path d="M16,2 C16,15 50,15 50,28" />
      <path d="M50,2 L50,28" />
      <path d="M84,2 C84,15 50,15 50,28" />
    </svg>

    <a class="jrn-hub" href="/training#jfp" aria-label="JFP Player Pathway">
      <span class="jrn-hub-mark">JFP</span>
      <span class="jrn-hub-label">Player Pathway</span>
    </a>

    <aside class="jrn-goal">
      <span class="jrn-goal-flag" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <line x1="6" y1="3" x2="6" y2="21" />
          <path d="M6 4h11l-2 4 2 4H6z" fill="currentColor" stroke="none" />
        </svg>
      </span>
      <span class="jrn-goal-label">The Goal</span>
      <strong class="jrn-goal-line">A Career In Football</strong>
    </aside>

    <footer class="jrn-footer">
      <div class="jrn-unlocks">
        <div class="jrn-unlocks-head">
          <span class="jrn-unlocks-eyebrow">What JFP</span>
          <strong class="jrn-unlocks-title">Unlocks</strong>
        </div>
        <ul class="jrn-unlocks-list">
          {unlocks.map((item) => (
            <li class="jrn-unlock">
              <span class="jrn-unlock-icon" aria-hidden="true">
                {item.icon === 'phone' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="6" y="2.5" width="12" height="19" rx="2.4" />
                    <line x1="11" y1="18.5" x2="13" y2="18.5" />
                  </svg>
                )}
                {item.icon === 'flame' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3c1 4 5 5 5 10a5 5 0 0 1-10 0c0-2 1-3 1-5 1 1 1 2 2 2 0-3 1-5 2-7z" />
                  </svg>
                )}
                {item.icon === 'brain' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 4a3 3 0 0 0-3 3v1a3 3 0 0 0-2 3v1a3 3 0 0 0 2 3v1a3 3 0 0 0 3 3h1V4z" />
                    <path d="M15 4a3 3 0 0 1 3 3v1a3 3 0 0 1 2 3v1a3 3 0 0 1-2 3v1a3 3 0 0 1-3 3h-1V4z" />
                  </svg>
                )}
                {item.icon === 'film' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <line x1="3" y1="9.5" x2="21" y2="9.5" />
                    <line x1="3" y1="14.5" x2="21" y2="14.5" />
                    <line x1="8" y1="5" x2="8" y2="19" />
                    <line x1="16" y1="5" x2="16" y2="19" />
                  </svg>
                )}
                {item.icon === 'whistle' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 13a5 5 0 0 1 5-5h9l4-2v9a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5z" />
                    <circle cx="8.5" cy="13" r="1.6" fill="currentColor" />
                  </svg>
                )}
                {item.icon === 'arrow' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 14 12 8 18 14" />
                    <polyline points="6 19 12 13 18 19" />
                  </svg>
                )}
              </span>
              <span class="jrn-unlock-label">{item.label}</span>
            </li>
          ))}
        </ul>
      </div>

      <a class="jrn-cta" href="/training#jfp-form" aria-label="Start Your Journey: enquire about JFP">
        Start Your Journey
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
          <line x1="6" y1="12" x2="17" y2="12" />
          <polyline points="12 7 17 12 12 17" />
        </svg>
      </a>
    </footer>
  </div>
</section>

<style>
  .jrn {
    --rail: 80px;
    position: relative;
    isolation: isolate;
    width: 100%;
    background: #000;
    color: #fff;
    overflow: hidden;
    padding: clamp(4rem, 7vw, 7rem) clamp(1.25rem, 4vw, 4rem) clamp(4rem, 6vw, 5.5rem);
    padding-left: max(var(--rail), clamp(1.25rem, 4vw, 4rem));
  }

  .jrn-photo {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .jrn-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
    opacity: 0.45;
  }

  .jrn-shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(0,0,0,0.78) 0%, rgba(0,0,0,0.45) 35%, rgba(0,0,0,0.78) 100%),
      radial-gradient(ellipse at 50% 50%, rgba(0,0,0,0) 0%, rgba(0,0,0,0.55) 80%);
  }

  .jrn-inner {
    position: relative;
    z-index: 2;
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr) minmax(0, 1fr);
    grid-template-rows: auto auto auto auto;
    column-gap: clamp(1rem, 2vw, 2rem);
    row-gap: clamp(1.2rem, 2.2vw, 2rem);
    align-items: start;
  }

  .jrn-head {
    grid-column: 1 / 2;
    grid-row: 1 / 3;
  }

  .jrn-title {
    margin: 0;
    font-family: 'Anton', Impact, 'Arial Narrow Bold', sans-serif;
    font-style: italic;
    font-weight: 900;
    text-transform: uppercase;
    line-height: 0.82;
    letter-spacing: 0.02em;
    text-shadow: 0 1.4rem 3rem rgba(0,0,0,0.55);
  }
  .jrn-title-row {
    display: block;
    font-size: clamp(2.4rem, 4.8vw, 4.4rem);
  }
  .jrn-title-row--big {
    font-size: clamp(3.6rem, 7.4vw, 6.8rem);
  }

  .jrn-rule {
    display: block;
    width: 64px;
    height: 4px;
    background: #cc0000;
    margin: clamp(0.7rem, 1.2vw, 1rem) 0;
  }

  .jrn-eyebrow {
    margin: 0 0 clamp(1rem, 1.5vw, 1.4rem);
    font-family: 'Anton', Impact, sans-serif;
    font-style: italic;
    font-size: clamp(0.78rem, 0.95vw, 0.95rem);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.78);
  }

  .jrn-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .jrn-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid rgba(255,255,255,0.16);
    background: rgba(8,8,8,0.78);
    color: rgba(255,255,255,0.86);
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    width: max-content;
  }
  .jrn-chip::before {
    content: "";
    width: 14px;
    height: 2px;
    background: #cc0000;
    flex-shrink: 0;
  }

  .jrn-stages-row {
    grid-column: 2 / 3;
    grid-row: 1 / 2;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.7rem, 1.1vw, 1.1rem);
    align-items: stretch;
  }

  .jrn-stage {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    padding: clamp(2.2rem, 2.6vw, 2.6rem) clamp(0.95rem, 1.3vw, 1.2rem) clamp(0.95rem, 1.3vw, 1.2rem);
    background:
      linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0)),
      rgba(8,8,8,0.88);
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 12px;
    color: #fff;
    text-decoration: none;
    transition:
      transform 280ms cubic-bezier(.2,.7,.2,1),
      border-color 280ms cubic-bezier(.2,.7,.2,1),
      box-shadow 280ms cubic-bezier(.2,.7,.2,1);
  }

  .jrn-stage:hover,
  .jrn-stage:focus-visible {
    transform: translateY(-2px);
    border-color: rgba(204,0,0,0.85);
    box-shadow: 0 16px 40px -16px rgba(204,0,0,0.55);
    outline: none;
  }

  .jrn-stage-tag {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    background: #cc0000;
    color: #fff;
    font-family: 'Anton', Impact, sans-serif;
    font-style: italic;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 0.42rem 0.75rem;
    border-radius: 4px;
    white-space: nowrap;
  }

  .jrn-stage-icon {
    width: 36px;
    height: 36px;
    color: #fff;
    align-self: center;
  }
  .jrn-stage-icon svg { width: 100%; height: 100%; }

  .jrn-stage-title {
    font-family: 'Anton', Impact, sans-serif;
    font-style: italic;
    font-size: clamp(0.95rem, 1.15vw, 1.18rem);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.05;
    text-align: center;
    width: 100%;
  }

  .jrn-stage-age {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.54);
    text-align: center;
    width: 100%;
  }

  .jrn-connectors {
    grid-column: 2 / 3;
    grid-row: 2 / 3;
    width: 100%;
    height: clamp(2rem, 3.4vw, 3.2rem);
    fill: none;
    stroke: rgba(204,0,0,0.55);
    stroke-width: 0.45;
    stroke-dasharray: 1.4 1.4;
  }

  .jrn-hub {
    grid-column: 2 / 3;
    grid-row: 3 / 4;
    justify-self: center;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: clamp(0.9rem, 1.2vw, 1.15rem) clamp(1.4rem, 2vw, 2rem);
    background: #cc0000;
    color: #fff;
    text-decoration: none;
    border-radius: 8px;
    box-shadow: 0 18px 48px -16px rgba(204,0,0,0.7);
    transition: transform 280ms cubic-bezier(.2,.7,.2,1), background-color 280ms cubic-bezier(.2,.7,.2,1);
  }
  .jrn-hub:hover { transform: translateY(-2px); background: #e60000; }

  .jrn-hub-mark {
    font-family: 'Anton', Impact, sans-serif;
    font-style: italic;
    font-size: clamp(2rem, 2.6vw, 2.6rem);
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .jrn-hub-label {
    font-family: 'Anton', Impact, sans-serif;
    font-style: italic;
    font-size: clamp(0.85rem, 1.1vw, 1.1rem);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1;
    align-self: center;
  }

  .jrn-goal {
    grid-column: 3 / 4;
    grid-row: 1 / 4;
    align-self: center;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: clamp(1rem, 1.4vw, 1.4rem) clamp(1.1rem, 1.6vw, 1.6rem);
    border: 2px solid #cc0000;
    background: rgba(8,8,8,0.84);
    border-radius: 8px;
    box-shadow: 0 24px 56px -20px rgba(204,0,0,0.45);
  }

  .jrn-goal-flag {
    width: 24px;
    height: 24px;
    color: #cc0000;
  }
  .jrn-goal-flag svg { width: 100%; height: 100%; }

  .jrn-goal-label {
    font-family: 'Anton', Impact, sans-serif;
    font-style: italic;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
  }

  .jrn-goal-line {
    font-family: 'Anton', Impact, sans-serif;
    font-style: italic;
    font-size: clamp(1.5rem, 2.2vw, 2.4rem);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1;
    color: #fff;
  }

  .jrn-footer {
    grid-column: 1 / 4;
    grid-row: 4 / 5;
    display: grid;
    grid-template-columns: minmax(0, 2.4fr) minmax(0, 1fr);
    gap: clamp(1rem, 2vw, 2rem);
    align-items: center;
    margin-top: clamp(0.5rem, 1vw, 1rem);
  }

  .jrn-unlocks {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: clamp(1rem, 1.4vw, 1.5rem);
    padding: clamp(0.85rem, 1.1vw, 1.1rem) clamp(1.1rem, 1.5vw, 1.5rem);
    background: rgba(8,8,8,0.86);
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 10px;
  }

  .jrn-unlocks-head {
    display: flex;
    flex-direction: column;
    gap: 2px;
    line-height: 1;
    border-right: 1px solid rgba(255,255,255,0.18);
    padding-right: clamp(0.9rem, 1.2vw, 1.2rem);
  }

  .jrn-unlocks-eyebrow {
    font-family: 'Anton', Impact, sans-serif;
    font-style: italic;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.62);
  }

  .jrn-unlocks-title {
    font-family: 'Anton', Impact, sans-serif;
    font-style: italic;
    font-size: clamp(1.4rem, 1.9vw, 2rem);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #fff;
  }

  .jrn-unlocks-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.55rem;
  }

  .jrn-unlock {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.4rem;
  }

  .jrn-unlock-icon {
    width: 22px;
    height: 22px;
    color: #cc0000;
  }
  .jrn-unlock-icon svg { width: 100%; height: 100%; }

  .jrn-unlock-label {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.78);
    text-align: center;
    line-height: 1.1;
  }

  .jrn-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: clamp(1rem, 1.4vw, 1.3rem) clamp(1.4rem, 2vw, 2rem);
    background: #cc0000;
    color: #fff;
    text-decoration: none;
    border-radius: 8px;
    font-family: 'Anton', Impact, sans-serif;
    font-style: italic;
    font-size: clamp(1rem, 1.25vw, 1.25rem);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1;
    box-shadow: 0 18px 48px -16px rgba(204,0,0,0.7);
    transition: transform 280ms cubic-bezier(.2,.7,.2,1), background-color 280ms cubic-bezier(.2,.7,.2,1);
  }
  .jrn-cta svg { width: 18px; height: 18px; }
  .jrn-cta:hover {
    transform: translateY(-2px);
    background: #e60000;
  }

  @media (max-width: 1100px) {
    .jrn-inner {
      grid-template-columns: 1fr 1fr;
    }
    .jrn-head { grid-column: 1 / 3; grid-row: 1 / 2; }
    .jrn-stages-row { grid-column: 1 / 3; grid-row: 2 / 3; }
    .jrn-connectors { display: none; }
    .jrn-hub { grid-column: 1 / 2; grid-row: 3 / 4; }
    .jrn-goal { grid-column: 2 / 3; grid-row: 3 / 4; align-self: stretch; }
    .jrn-footer { grid-column: 1 / 3; grid-row: 4 / 5; grid-template-columns: 1fr; }
  }

  @media (max-width: 720px) {
    .jrn { padding-left: clamp(1.25rem, 5vw, 2.5rem); }
    .jrn-stages-row { grid-template-columns: 1fr; }
    .jrn-unlocks { grid-template-columns: 1fr; }
    .jrn-unlocks-head { border-right: 0; border-bottom: 1px solid rgba(255,255,255,0.18); padding: 0 0 0.7rem; }
    .jrn-unlocks-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .jrn-stage,
    .jrn-cta,
    .jrn-hub { transition: none; }
  }
</style>
