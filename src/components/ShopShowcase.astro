---
interface ProductImage {
  src: string
  href: string
  title: string
}

interface Category {
  id: string
  title: string
  eyebrow: string
  description: string
  cta: string
  href: string
  images: ProductImage[]
}

// Pull real apparel products from Shopify at build time, like
// /shop/off-field-apparel does. Each image links to its product page.
const shopifyStore = 'https://jonerfootball.myshopify.com'
let apparelImages: ProductImage[] = [
  { src: '/images/shop/shop-apparel.webp', href: '/shop/off-field-apparel', title: 'Off Field Apparel' },
]
try {
  const response = await fetch(`${shopifyStore}/products.json?limit=20`)
  if (response.ok) {
    const data = await response.json()
    const products = Array.isArray(data?.products) ? data.products : []
    const built: ProductImage[] = products
      .map((p: any) => {
        const src = p?.images?.[0]?.src
        const handle = p?.handle
        const title = p?.title
        if (typeof src !== 'string' || !src || typeof handle !== 'string' || !handle) return null
        return { src, href: `${shopifyStore}/products/${handle}`, title: typeof title === 'string' && title ? title : 'Joner Football apparel' } as ProductImage
      })
      .filter((p: ProductImage | null): p is ProductImage => p !== null)
      .slice(0, 8)
    if (built.length) apparelImages = built
  }
} catch {
  // keep fallback
}

const categories: Category[] = [
  {
    id: 'apparel',
    title: 'Off Field Apparel',
    eyebrow: 'Apparel',
    description: 'Kit and apparel.',
    cta: 'Shop',
    href: '/shop/off-field-apparel',
    images: apparelImages,
  },
  {
    id: 'training',
    title: 'Training Programs',
    eyebrow: 'Digital',
    description: 'Eight self-paced programs.',
    cta: 'Browse',
    href: '/shop/training-programs',
    images: [
      { src: '/images/shop/training-programs/fast-feet-program.webp', href: 'https://app.jonerfootball.com/checkout/new?o=228903', title: 'Fast Feet Program' },
      { src: '/images/shop/training-programs/dribbling-7-day-program.webp', href: 'https://app.jonerfootball.com/checkout/new?o=228825', title: '7 Day Dribbling Program' },
      { src: '/images/shop/training-programs/juggling-program.webp', href: 'https://app.jonerfootball.com/checkout/new?o=228824', title: 'Juggling Program' },
      { src: '/images/shop/training-programs/six-weeks-passing-first-touch.webp', href: 'https://app.jonerfootball.com/checkout/new?o=228901', title: '6 Weeks Passing & 1st Touch' },
      { src: '/images/shop/training-programs/weak-foot-program.webp', href: 'https://app.jonerfootball.com/checkout/new?o=228822', title: 'Weak Foot Program' },
      { src: '/images/shop/training-programs/score-more-goals.webp', href: 'https://app.jonerfootball.com/checkout/new?o=228823', title: 'Score More Goals' },
      { src: '/images/shop/training-programs/strength-conditioning.webp', href: 'https://app.jonerfootball.com/checkout/new?o=228904', title: 'Strength & Conditioning' },
      { src: '/images/shop/training-programs/hundred-day-transformation-bundle.webp', href: 'https://app.jonerfootball.com/checkout/new?o=227739', title: '100 Day Transformation Pack' },
    ],
  },
  {
    id: 'resources',
    title: 'Resources & Accessories',
    eyebrow: 'Books & Tools',
    description: 'Shop the new books, then browse training-day essentials.',
    cta: 'Shop',
    href: '/shop/resources-accessories',
    images: [
      { src: '/images/shop/greatest-goal-scorers/cover.jpg', href: '/shop/greatest-goal-scorers', title: 'Joner Football Presents: Greatest Goal Scorers!' },
      { src: '/images/books/midfield-masters/cover.jpg', href: '/shop/midfield-masters', title: 'Joner Football Presents: Midfield Masters!' },
      { src: '/images/shop/resources-accessories/scanning-training-tool.webp', href: 'https://buy.stripe.com/bJe00icKA49l35ZfpqgEg09', title: 'Scanning Training Tool' },
      { src: '/images/shop/resources-accessories/numbers-training-tool.webp', href: 'https://buy.stripe.com/cNieVccKA0X921VgtugEg0a', title: 'Numbers Tool' },
    ],
  },
]
---

<section class="bg-joner-black py-12 md:py-20 overflow-hidden" data-shop-showcase>
  <div class="max-w-[1680px] mx-auto px-4 sm:px-6 lg:px-10">

    <!-- Header -->
    <div class="text-center mb-10 md:mb-14">
      <h1 class="font-heading text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-white uppercase leading-none">
        Browse Joner Football
      </h1>
    </div>

    <!-- Showcase grid -->
    <div class="grid grid-cols-1 lg:grid-cols-[1.05fr_1fr] gap-8 lg:gap-14 items-center">

      <!-- Image stage (top on mobile, right on desktop). Each image is a link
           to its product. Only the active image is clickable; others fade out
           with pointer-events disabled. -->
      <div class="relative order-1 lg:order-2 aspect-square bg-joner-gray rounded-2xl overflow-hidden">
        {categories.map((cat) => (
          cat.images.map((img, i) => (
            <a
              href={img.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Open ${img.title}`}
              class="shop-stage-link"
              data-stage-link
              data-category-id={cat.id}
              data-image-index={i}
            >
              <img
                src={img.src}
                alt={img.title}
                class="shop-stage-image"
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            </a>
          ))
        ))}
        <div class="absolute left-4 top-4 md:left-5 md:top-5 inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-black/55 backdrop-blur border border-white/10 z-10 pointer-events-none">
          <span class="w-1.5 h-1.5 rounded-full bg-joner-red"></span>
          <span class="shop-stage-label font-heading text-[10px] md:text-xs uppercase tracking-[0.2em] text-white">Training Programs</span>
        </div>
      </div>

      <!-- Category cards (below on mobile, left on desktop) -->
      <div class="flex flex-col gap-3 order-2 lg:order-1">
        {categories.map((cat) => (
          <a
            href={cat.href}
            class="shop-card group relative block overflow-hidden rounded-xl border border-white/10 bg-white/[0.03] p-4 md:p-5"
            data-category-card
            data-category-id={cat.id}
          >
            <div class="flex items-start gap-3 md:gap-4">
              <span class="shop-card-bullet flex-shrink-0 w-9 h-9 md:w-11 md:h-11 rounded-full bg-white/10 grid place-items-center">
                <span class="shop-card-bullet-dot w-2 h-2 rounded-full bg-white/50"></span>
              </span>
              <div class="flex-1 min-w-0">
                <p class="text-joner-red font-heading text-[10px] md:text-xs uppercase tracking-[0.24em] mb-1">{cat.eyebrow}</p>
                <h3 class="font-heading text-xl md:text-2xl text-white uppercase leading-tight">{cat.title}</h3>
                <p class="font-body text-sm text-gray-400 mt-1.5 max-w-md leading-relaxed">{cat.description}</p>

                <!-- Progress bar -->
                <div class="shop-card-progress mt-3 h-[3px] bg-white/10 rounded-full overflow-hidden">
                  <div class="shop-card-progress-fill h-full bg-joner-red rounded-full" data-progress-fill style="width: 0%"></div>
                </div>

                <!-- CTA arrow -->
                <span class="shop-card-cta inline-flex items-center gap-2 mt-3 text-white font-heading text-[11px] md:text-xs uppercase tracking-[0.2em]">
                  {cat.cta}
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7" /></svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>

    </div>

  </div>
</section>

<style>
  /* Each image is wrapped in a clickable link layer. Only the active link
     fades in and accepts pointer events. iOS-style easing on the fade. */
  .shop-stage-link {
    position: absolute;
    inset: 0;
    display: block;
    opacity: 0;
    transform: scale(1.03);
    pointer-events: none;
    will-change: opacity, transform;
    transition:
      opacity 380ms cubic-bezier(0.32, 0.72, 0, 1),
      transform 600ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .shop-stage-link[data-active='true'] {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
    cursor: pointer;
  }
  .shop-stage-link img.shop-stage-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    transition: transform 400ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .shop-stage-link[data-active='true']:hover img.shop-stage-image { transform: scale(1.02); }

  /* Card visuals + active state */
  .shop-card {
    transition:
      background-color 320ms cubic-bezier(0.32, 0.72, 0, 1),
      border-color 320ms cubic-bezier(0.32, 0.72, 0, 1),
      transform 320ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .shop-card:hover { background: rgba(255, 255, 255, 0.06); border-color: rgba(255, 255, 255, 0.2); }
  .shop-card[data-active='true'] {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(227, 6, 19, 0.5);
  }

  .shop-card-bullet,
  .shop-card-bullet-dot {
    transition:
      background-color 320ms cubic-bezier(0.32, 0.72, 0, 1),
      transform 320ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .shop-card[data-active='true'] .shop-card-bullet { background: rgba(227, 6, 19, 0.95); }
  .shop-card[data-active='true'] .shop-card-bullet-dot { background: #fff; transform: scale(1.4); }

  .shop-card-cta {
    opacity: 0.55;
    transition: opacity 320ms cubic-bezier(0.32, 0.72, 0, 1), color 320ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .shop-card:hover .shop-card-cta,
  .shop-card[data-active='true'] .shop-card-cta { opacity: 1; }
  .shop-card[data-active='true'] .shop-card-cta { color: #fff; }

  .shop-card-progress-fill { transition: width 80ms linear; }

  @media (prefers-reduced-motion: reduce) {
    .shop-stage-link,
    .shop-stage-image,
    .shop-card,
    .shop-card-bullet,
    .shop-card-bullet-dot,
    .shop-card-cta,
    .shop-card-progress-fill { transition: none !important; }
    .shop-stage-link { transform: none; }
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-shop-showcase]');
    if (!root) return;
    var cards = Array.prototype.slice.call(root.querySelectorAll('[data-category-card]'));
    var links = Array.prototype.slice.call(root.querySelectorAll('[data-stage-link]'));
    var label = root.querySelector('.shop-stage-label');
    if (!cards.length) return;

    var ROTATE_MS = 6000;   // total time per category before auto-advancing
    var FLASH_MS = 700;     // time per image within a category
    var activeIndex = 0;
    var progress = 0;
    var flashIndex = 0;
    var lastTick = 0;
    var lastFlashAt = 0;
    var rafId = 0;
    var running = false;
    var hoverLocked = false;   // hovering a card pauses auto-advance ONLY; image flash keeps going

    var categoryIds = cards.map(function (c) { return c.dataset.categoryId; });
    var labels = {};
    cards.forEach(function (c) {
      var id = c.dataset.categoryId;
      var title = c.querySelector('h3');
      labels[id] = title ? title.textContent : id;
    });

    function linksFor(id) {
      return links.filter(function (a) { return a.dataset.categoryId === id; });
    }

    function setImage() {
      var activeId = categoryIds[activeIndex];
      var pool = linksFor(activeId);
      links.forEach(function (a) { a.dataset.active = 'false'; });
      if (pool.length) {
        pool[flashIndex % pool.length].dataset.active = 'true';
      }
      if (label) label.textContent = labels[activeId] || 'Live Preview';
    }

    function setActive(idx) {
      activeIndex = idx;
      progress = 0;
      flashIndex = 0;
      cards.forEach(function (card, i) {
        card.dataset.active = i === idx ? 'true' : 'false';
        var fill = card.querySelector('[data-progress-fill]');
        if (fill) fill.style.width = '0%';
      });
      setImage();
    }

    function tick(now) {
      rafId = 0;
      if (!running) return;

      var dt = lastTick === 0 ? 0 : now - lastTick;
      lastTick = now;

      // Image flash always cycles while the section is in view, even when a
      // tab is being hovered. This is what makes the right column keep
      // scrolling through products when the user hovers a tab on the left.
      if (now - lastFlashAt > FLASH_MS) {
        flashIndex++;
        setImage();
        lastFlashAt = now;
      }

      // Progress bar + auto-advance to next category only when NOT hovered.
      // Hovering a tab locks the active category so the user can keep
      // browsing its products on the right.
      if (!hoverLocked) {
        progress += (dt / ROTATE_MS) * 100;
        if (progress >= 100) {
          setActive((activeIndex + 1) % cards.length);
        } else {
          var fill = cards[activeIndex].querySelector('[data-progress-fill]');
          if (fill) fill.style.width = progress.toFixed(2) + '%';
        }
      }

      rafId = requestAnimationFrame(tick);
    }

    function start() {
      if (running) return;
      running = true;
      lastTick = 0;
      lastFlashAt = performance.now();
      if (!rafId) rafId = requestAnimationFrame(tick);
    }
    function stop() {
      running = false;
      if (rafId) { cancelAnimationFrame(rafId); rafId = 0; }
    }

    var isTouch = window.matchMedia('(hover: none) and (pointer: coarse)').matches;
    cards.forEach(function (card, i) {
      if (!isTouch) {
        // Desktop: hover locks the category, image flash keeps cycling, auto
        // advance pauses. Mouseleave unlocks and resumes the rotation.
        card.addEventListener('mouseenter', function () {
          if (i !== activeIndex) setActive(i);
          hoverLocked = true;
          progress = 0; // reset progress so when user leaves, full duration restarts
        });
        card.addEventListener('mouseleave', function () { hoverLocked = false; });
        card.addEventListener('focus', function () {
          if (i !== activeIndex) setActive(i);
        });
      } else {
        // Touch: first tap activates without navigating, second tap navigates.
        card.addEventListener('click', function (event) {
          if (i !== activeIndex) {
            event.preventDefault();
            setActive(i);
          }
        });
      }
    });

    // Run loop only while the section is on screen.
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) start();
        else stop();
      });
    }, { threshold: 0.1 });
    io.observe(root);

    setActive(0);
  })();
</script>
