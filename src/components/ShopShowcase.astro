---
interface Category {
  id: string
  title: string
  eyebrow: string
  description: string
  cta: string
  href: string
  images: string[]
}

const categories: Category[] = [
  {
    id: 'apparel',
    title: 'Off Field Apparel',
    eyebrow: 'Apparel',
    description: 'Training tops, hoodies, and limited Joner Football kit. Built for off the pitch.',
    cta: 'Shop Apparel',
    href: '/shop/off-field-apparel',
    images: [
      '/images/shop/shop-apparel.webp',
    ],
  },
  {
    id: 'training',
    title: 'Training Programs',
    eyebrow: 'Digital Training',
    description: 'Eight self-paced programs. Ball mastery, weak foot, finishing, conditioning and more.',
    cta: 'Browse Programs',
    href: '/shop/training-programs',
    images: [
      '/images/shop/training-programs/fast-feet-program.webp',
      '/images/shop/training-programs/dribbling-7-day-program.webp',
      '/images/shop/training-programs/juggling-program.webp',
      '/images/shop/training-programs/six-weeks-passing-first-touch.webp',
      '/images/shop/training-programs/weak-foot-program.webp',
      '/images/shop/training-programs/score-more-goals.webp',
      '/images/shop/training-programs/strength-conditioning.webp',
      '/images/shop/training-programs/hundred-day-transformation-bundle.webp',
    ],
  },
  {
    id: 'resources',
    title: 'Resources & Accessories',
    eyebrow: 'Tools & Downloads',
    description: 'Coaching tools, scanning trainers, and training-day essentials.',
    cta: 'Shop Resources',
    href: '/shop/resources-accessories',
    images: [
      '/images/shop/resources-accessories/scanning-training-tool.webp',
      '/images/shop/resources-accessories/numbers-training-tool.webp',
    ],
  },
]
---

<section class="bg-joner-black py-12 md:py-20 overflow-hidden" data-shop-showcase>
  <div class="max-w-[1680px] mx-auto px-4 sm:px-6 lg:px-10">

    <!-- Header -->
    <div class="text-center mb-10 md:mb-14">
      <p class="text-joner-red font-heading text-xs md:text-sm uppercase tracking-[0.24em] mb-3">The Shop</p>
      <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-white uppercase leading-none">
        Joner Football<br />Store
      </h1>
      <p class="font-body text-sm md:text-base text-gray-400 mt-4 max-w-xl mx-auto">
        Apparel, training programs, and the tools we use. Tap a category to lock the preview.
      </p>
    </div>

    <!-- Showcase grid -->
    <div class="grid grid-cols-1 lg:grid-cols-[1.05fr_1fr] gap-8 lg:gap-14 items-center">

      <!-- Image stage (top on mobile, right on desktop) -->
      <div class="relative order-1 lg:order-2 aspect-[5/4] sm:aspect-[4/3] lg:aspect-[5/4] bg-joner-gray rounded-2xl overflow-hidden">
        {categories.map((cat) => (
          cat.images.map((img, i) => (
            <img
              src={img}
              alt={`${cat.title} preview ${i + 1}`}
              class="shop-stage-image absolute inset-0 w-full h-full object-cover"
              data-stage-image
              data-category-id={cat.id}
              data-image-index={i}
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          ))
        ))}
        <!-- Subtle gradient + corner label -->
        <div class="absolute inset-0 pointer-events-none bg-gradient-to-tr from-black/30 via-transparent to-transparent"></div>
        <div class="absolute left-4 top-4 md:left-5 md:top-5 inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-black/55 backdrop-blur border border-white/10">
          <span class="w-1.5 h-1.5 rounded-full bg-joner-red"></span>
          <span class="shop-stage-label font-heading text-[10px] md:text-xs uppercase tracking-[0.2em] text-white">Live Preview</span>
        </div>
      </div>

      <!-- Category cards (below on mobile, left on desktop) -->
      <div class="flex flex-col gap-3 order-2 lg:order-1">
        {categories.map((cat) => (
          <a
            href={cat.href}
            class="shop-card group relative block overflow-hidden rounded-xl border border-white/10 bg-white/[0.03] p-4 md:p-5"
            data-category-card
            data-category-id={cat.id}
          >
            <div class="flex items-start gap-3 md:gap-4">
              <span class="shop-card-bullet flex-shrink-0 w-9 h-9 md:w-11 md:h-11 rounded-full bg-white/10 grid place-items-center">
                <span class="shop-card-bullet-dot w-2 h-2 rounded-full bg-white/50"></span>
              </span>
              <div class="flex-1 min-w-0">
                <p class="text-joner-red font-heading text-[10px] md:text-xs uppercase tracking-[0.24em] mb-1">{cat.eyebrow}</p>
                <h3 class="font-heading text-xl md:text-2xl text-white uppercase leading-tight">{cat.title}</h3>
                <p class="font-body text-sm text-gray-400 mt-1.5 max-w-md leading-relaxed">{cat.description}</p>

                <!-- Progress bar -->
                <div class="shop-card-progress mt-3 h-[3px] bg-white/10 rounded-full overflow-hidden">
                  <div class="shop-card-progress-fill h-full bg-joner-red rounded-full" data-progress-fill style="width: 0%"></div>
                </div>

                <!-- CTA arrow -->
                <span class="shop-card-cta inline-flex items-center gap-2 mt-3 text-white font-heading text-[11px] md:text-xs uppercase tracking-[0.2em]">
                  {cat.cta}
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7" /></svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>

    </div>

  </div>
</section>

<style>
  /* Image transitions — same iOS-style easing as /app's closer-look */
  .shop-stage-image {
    opacity: 0;
    transform: scale(1.03);
    transition:
      opacity 380ms cubic-bezier(0.32, 0.72, 0, 1),
      transform 600ms cubic-bezier(0.32, 0.72, 0, 1);
    pointer-events: none;
    will-change: opacity, transform;
  }
  .shop-stage-image[data-active='true'] {
    opacity: 1;
    transform: scale(1);
  }

  /* Card visuals + active state */
  .shop-card {
    transition:
      background-color 320ms cubic-bezier(0.32, 0.72, 0, 1),
      border-color 320ms cubic-bezier(0.32, 0.72, 0, 1),
      transform 320ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .shop-card:hover { background: rgba(255, 255, 255, 0.06); border-color: rgba(255, 255, 255, 0.2); }
  .shop-card[data-active='true'] {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(227, 6, 19, 0.5);
  }

  .shop-card-bullet,
  .shop-card-bullet-dot {
    transition:
      background-color 320ms cubic-bezier(0.32, 0.72, 0, 1),
      transform 320ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .shop-card[data-active='true'] .shop-card-bullet { background: rgba(227, 6, 19, 0.95); }
  .shop-card[data-active='true'] .shop-card-bullet-dot { background: #fff; transform: scale(1.4); }

  .shop-card-cta {
    opacity: 0.55;
    transition: opacity 320ms cubic-bezier(0.32, 0.72, 0, 1), color 320ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .shop-card:hover .shop-card-cta,
  .shop-card[data-active='true'] .shop-card-cta { opacity: 1; }
  .shop-card[data-active='true'] .shop-card-cta { color: #fff; }

  .shop-card-progress-fill { transition: width 80ms linear; }

  @media (prefers-reduced-motion: reduce) {
    .shop-stage-image,
    .shop-card,
    .shop-card-bullet,
    .shop-card-bullet-dot,
    .shop-card-cta,
    .shop-card-progress-fill { transition: none !important; }
    .shop-stage-image { transform: none; }
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-shop-showcase]');
    if (!root) return;
    var cards = Array.prototype.slice.call(root.querySelectorAll('[data-category-card]'));
    var images = Array.prototype.slice.call(root.querySelectorAll('[data-stage-image]'));
    var label = root.querySelector('.shop-stage-label');
    if (!cards.length) return;

    var ROTATE_MS = 6000;   // total time per category
    var FLASH_MS = 700;     // time per image within a category
    var activeIndex = 0;
    var progress = 0;
    var flashIndex = 0;
    var lastTick = 0;
    var lastFlashAt = 0;
    var rafId = 0;
    var running = false;
    var paused = false;
    var manualLock = false;
    var manualUntil = 0;

    var categoryIds = cards.map(function (c) { return c.dataset.categoryId; });
    var labels = {};
    cards.forEach(function (c) {
      var id = c.dataset.categoryId;
      var title = c.querySelector('h3');
      labels[id] = title ? title.textContent : id;
    });

    function imagesFor(id) {
      return images.filter(function (img) { return img.dataset.categoryId === id; });
    }

    function setImage() {
      var activeId = categoryIds[activeIndex];
      var pool = imagesFor(activeId);
      images.forEach(function (img) { img.dataset.active = 'false'; });
      if (pool.length) {
        pool[flashIndex % pool.length].dataset.active = 'true';
      }
      if (label) label.textContent = labels[activeId] || 'Live Preview';
    }

    function setActive(idx, opts) {
      activeIndex = idx;
      progress = 0;
      flashIndex = 0;
      cards.forEach(function (card, i) {
        card.dataset.active = i === idx ? 'true' : 'false';
        var fill = card.querySelector('[data-progress-fill]');
        if (fill) fill.style.width = '0%';
      });
      setImage();
      if (opts && opts.manual) {
        manualLock = true;
        manualUntil = performance.now() + 1800;
      }
    }

    function tick(now) {
      rafId = 0;
      if (!running) return;

      if (manualLock && now >= manualUntil) manualLock = false;
      var advance = !paused && !manualLock;

      var dt = lastTick === 0 ? 0 : now - lastTick;
      lastTick = now;

      if (advance) {
        progress += (dt / ROTATE_MS) * 100;
        if (progress >= 100) {
          setActive((activeIndex + 1) % cards.length);
        } else {
          var fill = cards[activeIndex].querySelector('[data-progress-fill]');
          if (fill) fill.style.width = progress.toFixed(2) + '%';
        }
        if (now - lastFlashAt > FLASH_MS) {
          flashIndex++;
          setImage();
          lastFlashAt = now;
        }
      }

      rafId = requestAnimationFrame(tick);
    }

    function start() {
      if (running) return;
      running = true;
      lastTick = 0;
      lastFlashAt = performance.now();
      if (!rafId) rafId = requestAnimationFrame(tick);
    }
    function stop() {
      running = false;
      if (rafId) { cancelAnimationFrame(rafId); rafId = 0; }
    }

    // Pause on hover/focus (desktop), advance on enter (mouse only)
    var isTouch = window.matchMedia('(hover: none) and (pointer: coarse)').matches;
    cards.forEach(function (card, i) {
      if (!isTouch) {
        card.addEventListener('mouseenter', function () {
          if (i !== activeIndex) setActive(i, { manual: true });
          paused = true;
        });
        card.addEventListener('mouseleave', function () { paused = false; });
        card.addEventListener('focus', function () {
          if (i !== activeIndex) setActive(i, { manual: true });
        });
      } else {
        // On touch, first tap activates without navigating, second tap navigates.
        card.addEventListener('click', function (event) {
          if (i !== activeIndex) {
            event.preventDefault();
            setActive(i, { manual: true });
          }
          // If already active, default <a> behaviour navigates.
        });
      }
    });

    // Run loop only while in view
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) start();
        else stop();
      });
    }, { threshold: 0.1 });
    io.observe(root);

    setActive(0);
  })();
</script>
