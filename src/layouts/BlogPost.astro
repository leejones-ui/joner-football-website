---
import BaseLayout from './BaseLayout.astro'
import EmailCapture from '../components/EmailCapture.astro'

export interface Props {
  title: string
  seoTitle?: string
  description: string
  date: string
  category: string
  readTime: string
  image?: string
  imageAlt?: string
}

const { title, seoTitle, description, date, category, readTime, image, imageAlt } = Astro.props
const metaTitle = seoTitle || `${title} | Joner Football Blog`
const siteUrl = 'https://jonerfootball.com'
const canonicalURL = `${siteUrl}${Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`}`
const absoluteImage = image?.startsWith('http') ? image : image ? `${siteUrl}${image}` : undefined
const hubCaptureUrl = `/hub?next=${encodeURIComponent(Astro.url.pathname)}`

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "datePublished": date,
  "mainEntityOfPage": canonicalURL,
  ...(absoluteImage ? { "image": absoluteImage } : {}),
  "author": {
    "@type": "Organization",
    "name": "Joner Football"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Joner Football",
    "logo": { "@type": "ImageObject", "url": "https://jonerfootball.com/images/logo.png" }
  }
}
---

<BaseLayout
  title={metaTitle}
  description={description}
  canonical={canonicalURL}
  ogImage={absoluteImage}
  ogType="article"
  schema={articleSchema}
>
  <article class="bg-joner-black">
    <!-- Hero -->
    <div class="relative bg-joner-gray py-20 md:py-28">
      <div class="absolute top-0 left-0 right-0 h-1 bg-joner-red"></div>
      <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
        <div class="flex items-center justify-center gap-4 mb-4">
          <span class="bg-joner-red px-3 py-1 font-heading text-xs uppercase tracking-widest text-white">{category}</span>
          <span class="text-gray-500 text-sm font-body">{readTime}</span>
          <span class="text-gray-500 text-sm font-body">{date}</span>
        </div>
        <h1 class="font-heading text-3xl md:text-5xl font-bold text-white uppercase leading-tight">{title}</h1>
      </div>
    </div>

    {image && (
      <div class="max-w-4xl mx-auto px-4 -mt-8">
        <img src={image} alt={imageAlt || title} class="w-full aspect-video object-cover object-center" loading="eager" />
      </div>
    )}

    <!-- Hub Capture CTA -->
    <section class="bg-joner-black py-10 border-y border-white/10">
      <div class="max-w-3xl mx-auto px-4 sm:px-6">
        <div class="bg-white text-joner-black p-6 md:p-8 border-l-4 border-joner-red">
          <p class="font-heading text-xs uppercase tracking-[0.2em] text-joner-red mb-3">Free Joner Football Hub</p>
          <h2 class="font-heading text-2xl md:text-3xl font-bold uppercase mb-3">Want more free training ideas?</h2>
          <p class="font-body text-gray-700 mb-5">Enter the Hub for free blogs, challenges, coach resources, giveaways and weekly Joner Football ideas.</p>
          <a href={hubCaptureUrl} class="inline-flex bg-joner-red text-white px-6 py-3 font-heading uppercase tracking-wide hover:bg-red-700 transition-colors">
            Enter The Free Hub
          </a>
        </div>
      </div>
    </section>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12 md:py-16">
      <div class="prose prose-invert prose-lg max-w-none
        [&_h2]:font-heading [&_h2]:text-white [&_h2]:uppercase [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:mt-10 [&_h2]:mb-4
        [&_h3]:font-heading [&_h3]:text-white [&_h3]:uppercase [&_h3]:text-xl [&_h3]:font-bold [&_h3]:mt-8 [&_h3]:mb-3
        [&_p]:text-gray-300 [&_p]:font-body [&_p]:leading-relaxed [&_p]:mb-4
        [&_ul]:space-y-2 [&_li]:text-gray-300 [&_li]:font-body
        [&_a]:text-joner-red [&_a]:hover:underline
        [&_strong]:text-white
        [&_ol]:space-y-2 [&_ol]:list-decimal [&_ol]:pl-6
        [&_ul]:list-disc [&_ul]:pl-6
      ">
        <slot />
      </div>
    </div>

    <!-- Money page internal links -->
    <section class="bg-joner-black py-10 border-t border-white/10">
      <div class="max-w-3xl mx-auto px-4 sm:px-6">
        <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-6 md:p-8">
          <p class="font-heading text-xs uppercase tracking-[0.22em] text-joner-red mb-3">Keep improving</p>
          <h2 class="font-heading text-2xl md:text-3xl font-bold uppercase text-white mb-4">Choose your next training step.</h2>
          <p class="font-body text-gray-300 mb-6">Use the guides below to move from reading into proper Joner Football training.</p>
          <div class="grid gap-3 sm:grid-cols-2">
            <a href="/app/" class="rounded-xl border border-white/10 bg-black/40 p-4 font-body text-sm text-gray-200 hover:border-joner-red hover:text-white transition-colors">
              <span class="block font-heading text-white uppercase mb-1">Football training app</span>
              Drills, programmes and a clearer plan for players.
            </a>
            <a href="/app/for-coaches/" class="rounded-xl border border-white/10 bg-black/40 p-4 font-body text-sm text-gray-200 hover:border-joner-red hover:text-white transition-colors">
              <span class="block font-heading text-white uppercase mb-1">Football drills for coaches</span>
              Session plans and coaching detail for better training.
            </a>
            <a href="/teams/" class="rounded-xl border border-white/10 bg-black/40 p-4 font-body text-sm text-gray-200 hover:border-joner-red hover:text-white transition-colors">
              <span class="block font-heading text-white uppercase mb-1">Team football app subscriptions</span>
              Give your whole squad a clearer training pathway.
            </a>
            <a href="/camps/" class="rounded-xl border border-white/10 bg-black/40 p-4 font-body text-sm text-gray-200 hover:border-joner-red hover:text-white transition-colors">
              <span class="block font-heading text-white uppercase mb-1">Elite football camps</span>
              Train in person with Joner Football coaches.
            </a>
            <a href="/training/" class="rounded-xl border border-white/10 bg-black/40 p-4 font-body text-sm text-gray-200 hover:border-joner-red hover:text-white transition-colors sm:col-span-2">
              <span class="block font-heading text-white uppercase mb-1">Sydney football training</span>
              JFP, juniors, professional training and The HQ.
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Hub Mid-Article CTA -->
    <section class="bg-joner-gray py-10">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
        <h2 class="font-heading text-2xl md:text-3xl font-bold text-white uppercase mb-3">Get The Free Hub</h2>
        <p class="text-gray-300 font-body mb-6">Drop your email once and get free Joner Football blogs, challenges and coaching resources.</p>
        <a href={hubCaptureUrl} class="inline-flex bg-joner-red text-white px-6 py-3 font-heading uppercase tracking-wide hover:bg-red-700 transition-colors">
          Enter The Free Hub
        </a>
      </div>
    </section>

    <!-- App CTA -->
    <section class="bg-joner-red py-12">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
        <h2 class="font-heading text-2xl md:text-3xl font-bold text-white uppercase mb-3">
          Take Your Training Further
        </h2>
        <p class="text-white/80 font-body mb-6">
          For 1,500+ drills like these, download the Joner Football App.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="https://apps.apple.com/au/app/joner-football-app/id6737069275" target="_blank" rel="noopener" class="btn-outline border-white text-white hover:bg-white hover:text-joner-red px-6 py-3">
            Download on App Store
          </a>
          <a href="https://play.google.com/store/apps/details?id=tv.uscreen.jonerfootball" target="_blank" rel="noopener" class="btn-outline border-white text-white hover:bg-white hover:text-joner-red px-6 py-3">
            Get on Google Play
          </a>
        </div>
      </div>
    </section>
  </article>

  <EmailCapture />
</BaseLayout>
