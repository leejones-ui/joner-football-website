---
import '../styles/global.css'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import Analytics from '../components/Analytics.astro'

export interface Props {
  title?: string
  description?: string
  canonical?: string
  ogImage?: string
  schema?: object | object[]
}

const {
  title = 'Joner Football | Technique Above Everything',
  description = 'Elite football training, global camps, and the #1 football coaching app. Train with 2.1 million footballers worldwide.',
  canonical,
  ogImage = 'https://jonerfootball.com/images/og-default.jpg',
  schema,
} = Astro.props

const canonicalURL = canonical || `https://jonerfootball.com${Astro.url.pathname}`
const hideMobileStickyAppCta = Astro.url.pathname === '/' || Astro.url.pathname.startsWith('/hub')
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY || ''

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Joner Football",
  "url": "https://jonerfootball.com",
  "logo": "https://jonerfootball.com/images/logo.png",
  "sameAs": [
    "https://www.instagram.com/jonerfootball/",
    "https://www.youtube.com/@jonerfootball",
    "https://www.facebook.com/Jonerfootball/",
    "https://www.tiktok.com/@jonerfootball"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+61-404-780-351",
    "contactType": "customer service",
    "email": "leejones@jonerfootball.com"
  }
}

const allSchemas = schema
  ? Array.isArray(schema) ? [orgSchema, ...schema] : [orgSchema, schema]
  : [orgSchema]
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Joner Football" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Schema.org JSON-LD -->
    {allSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <slot name="head" />

    <!-- LEE: Paste your GA4 Measurement ID into Vercel env var PUBLIC_GA4_ID (starts with G-) -->
    <Analytics />

    <!-- Meta Pixel -->
    <script>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '232666285545279');
      fbq('track', 'PageView');
    </script>
    <noscript>
      <img height="1" width="1" style="display:none"
        src="https://www.facebook.com/tr?id=232666285545279&ev=PageView&noscript=1"/>
    </noscript>
    {recaptchaSiteKey && (
      <script src={`https://www.google.com/recaptcha/api.js?render=${recaptchaSiteKey}`} async defer></script>
    )}
    {recaptchaSiteKey && <meta name="recaptcha-site-key" content={recaptchaSiteKey} />}
  </head>
  <body class="bg-joner-black text-white">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:bg-red-600 focus:text-white focus:px-4 focus:py-2 focus:z-50 focus:rounded">
      Skip to content
    </a>
    <Nav />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      (function () {
        var TRACKING_PARAM_PREFIXES = ['utm_'];
        var TRACKING_PARAM_KEYS = ['fbclid', 'gclid', 'ttclid', 'msclkid'];
        var STORAGE_KEY = 'joner_tracking_params';

        function isTrackingParam(key) {
          if (TRACKING_PARAM_KEYS.indexOf(key) !== -1) return true;
          for (var i = 0; i < TRACKING_PARAM_PREFIXES.length; i++) {
            if (key.indexOf(TRACKING_PARAM_PREFIXES[i]) === 0) return true;
          }
          return false;
        }

        function collectTrackingParams() {
          var params = new URLSearchParams(window.location.search || '');
          var trackingParams = new URLSearchParams();
          params.forEach(function (value, key) {
            if (value && isTrackingParam(key)) trackingParams.set(key, value);
          });
          if (trackingParams.toString()) {
            try { window.sessionStorage.setItem(STORAGE_KEY, trackingParams.toString()); } catch (e) {}
            return trackingParams;
          }
          try {
            var stored = window.sessionStorage.getItem(STORAGE_KEY);
            if (stored) return new URLSearchParams(stored);
          } catch (e) {}
          return new URLSearchParams();
        }

        function paramsToObject(params) {
          var obj = {};
          if (!params) return obj;
          params.forEach(function (value, key) { obj[key] = value; });
          return obj;
        }

        function appendTrackingParams(href, trackingParams) {
          if (!href || !trackingParams || !trackingParams.toString()) return href;
          try {
            var url = new URL(href, window.location.href);
            trackingParams.forEach(function (value, key) {
              if (value && !url.searchParams.has(key)) url.searchParams.set(key, value);
            });
            return url.toString();
          } catch (e) {
            return href;
          }
        }

        function isAppOutboundLink(anchor) {
          if (!anchor || !anchor.href) return false;
          try { return new URL(anchor.href, window.location.href).hostname === 'app.jonerfootball.com'; }
          catch (e) { return false; }
        }

        function getCookie(name) {
          var match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
          return match ? decodeURIComponent(match[2]) : '';
        }

        function getEventId(eventName) {
          if (window.crypto && typeof window.crypto.randomUUID === 'function') return eventName + '.' + window.crypto.randomUUID();
          return eventName + '.' + Date.now() + '.' + Math.random().toString(16).slice(2);
        }

        function trackEvent(eventName, options) {
          options = options || {};
          var eventId = options.event_id || getEventId(eventName);
          var trackingParams = collectTrackingParams();
          var customData = Object.assign({}, paramsToObject(trackingParams), options.custom_data || {});
          var userData = Object.assign({
            fbp: getCookie('_fbp'),
            fbc: getCookie('_fbc')
          }, options.user_data || {});

          if (typeof window.fbq === 'function') {
            if (eventName === 'Lead' || eventName === 'CompleteRegistration' || eventName === 'InitiateCheckout' || eventName === 'ViewContent') {
              window.fbq('track', eventName, customData, { eventID: eventId });
            } else {
              window.fbq('trackCustom', eventName, customData, { eventID: eventId });
            }
          }

          try {
            var body = JSON.stringify({
              event_name: eventName,
              event_id: eventId,
              event_source_url: window.location.href,
              user_data: userData,
              custom_data: customData
            });
            if (navigator.sendBeacon) {
              var blob = new Blob([body], { type: 'application/json' });
              navigator.sendBeacon('/api/track-event', blob);
            } else {
              fetch('/api/track-event', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: body,
                keepalive: true
              }).catch(function () {});
            }
          } catch (e) {}

          return eventId;
        }

        function getCheckoutEventName(anchor) {
          if (anchor && anchor.dataset && anchor.dataset.metaCheckoutEvent) return anchor.dataset.metaCheckoutEvent;
          var path = window.location.pathname || '';
          var href = anchor && anchor.href ? anchor.href : '';
          if (path.indexOf('/workshops/coaches-course') === 0 || path.indexOf('/app/for-coaches') === 0 || href.indexOf('o=202578') !== -1) return 'CoachesPageClickToCheckout';
          return 'WebsiteClickToCheckout';
        }

        function getDeepScrollEventName() {
          var path = window.location.pathname || '';
          if (path.indexOf('/workshops/coaches-course') === 0 || path.indexOf('/app/for-coaches') === 0) return 'CoachesPageDeepScroll';
          return 'WebsiteDeepScroll';
        }

        function initTracking() {
          window.JonerTracking = {
            collectTrackingParams: collectTrackingParams,
            appendTrackingParams: appendTrackingParams,
            trackEvent: trackEvent
          };

          var trackingParams = collectTrackingParams();

          document.querySelectorAll('a[href]').forEach(function (anchor) {
            if (!isAppOutboundLink(anchor)) return;
            anchor.href = appendTrackingParams(anchor.href, trackingParams);
          });

          document.addEventListener('click', function (event) {
            var anchor = event.target && event.target.closest ? event.target.closest('a[href]') : null;
            if (!isAppOutboundLink(anchor)) return;
            anchor.href = appendTrackingParams(anchor.href, collectTrackingParams());
            if (anchor.href.indexOf('/checkout/new') !== -1) {
              trackEvent(getCheckoutEventName(anchor), {
                custom_data: {
                  destination_url: anchor.href,
                  content_name: anchor.textContent ? anchor.textContent.trim().slice(0, 120) : 'checkout-link'
                }
              });
            }
          }, true);

          var deepScrollTracked = false;
          function trackDeepScroll() {
            if (deepScrollTracked) return;
            var doc = document.documentElement;
            var scrollable = Math.max(doc.scrollHeight, document.body.scrollHeight) - window.innerHeight;
            if (scrollable <= 0) return;
            var percent = (window.scrollY || window.pageYOffset || 0) / scrollable;
            if (percent >= 0.75) {
              deepScrollTracked = true;
              trackEvent(getDeepScrollEventName(), { custom_data: { scroll_percent: 75 } });
              window.removeEventListener('scroll', trackDeepScroll);
            }
          }
          window.addEventListener('scroll', trackDeepScroll, { passive: true });
          trackDeepScroll();
        }

        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initTracking);
        else initTracking();
      })();
    </script>

    {!hideMobileStickyAppCta && (
      <div class="fixed bottom-0 left-0 right-0 z-50 md:hidden bg-joner-black border-t border-gray-800 p-3">
        <a href="/app" class="btn-red w-full text-center block text-sm">
          Download the App
        </a>
      </div>
    )}

    <script is:inline>
      (function () {
        var COMMON_DOMAINS = [
          'gmail.com', 'hotmail.com', 'outlook.com', 'icloud.com', 'yahoo.com', 'live.com',
          'bigpond.com', 'me.com', 'mac.com', 'aol.com', 'yahoo.com.au', 'hotmail.com.au', 'outlook.com.au'
        ];

        function levenshtein(a, b) {
          var matrix = [];
          for (var i = 0; i <= b.length; i++) matrix[i] = [i];
          for (var j = 0; j <= a.length; j++) matrix[0][j] = j;
          for (var i2 = 1; i2 <= b.length; i2++) {
            for (var j2 = 1; j2 <= a.length; j2++) {
              if (b.charAt(i2 - 1) === a.charAt(j2 - 1)) matrix[i2][j2] = matrix[i2 - 1][j2 - 1];
              else matrix[i2][j2] = Math.min(matrix[i2 - 1][j2 - 1] + 1, matrix[i2][j2 - 1] + 1, matrix[i2 - 1][j2] + 1);
            }
          }
          return matrix[b.length][a.length];
        }

        function getEmailSuggestion(email) {
          var trimmed = String(email || '').trim().toLowerCase();
          if (!trimmed || trimmed.indexOf('@') === -1) return null;
          var parts = trimmed.split('@');
          if (parts.length !== 2) return null;
          var local = parts[0];
          var domain = parts[1];
          if (!local || !domain) return null;

          var exactFixes = {
            'gmal.com': 'gmail.com', 'gmial.com': 'gmail.com', 'gmai.com': 'gmail.com', 'gmail.con': 'gmail.com', 'gmail,com': 'gmail.com', 'gnail.com': 'gmail.com',
            'hotmial.com': 'hotmail.com', 'hotmal.com': 'hotmail.com', 'hotmail.con': 'hotmail.com',
            'outlok.com': 'outlook.com', 'outloo.com': 'outlook.com', 'outlook.con': 'outlook.com',
            'iclod.com': 'icloud.com', 'icloud.con': 'icloud.com',
            'yaho.com': 'yahoo.com', 'yahoo.con': 'yahoo.com',
            'bigpond.con': 'bigpond.com', 'live.con': 'live.com'
          };

          if (exactFixes[domain]) return local + '@' + exactFixes[domain];

          for (var i = 0; i < COMMON_DOMAINS.length; i++) {
            if (levenshtein(domain, COMMON_DOMAINS[i]) <= 2) return local + '@' + COMMON_DOMAINS[i];
          }
          return null;
        }

        function validateEmail(email) {
          var trimmed = String(email || '').trim().toLowerCase();
          var basicPattern = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
          if (!trimmed) return { valid: false, message: 'Email is required.' };
          if (!basicPattern.test(trimmed)) return { valid: false, message: 'Enter a valid email address.' };
          if (trimmed.indexOf('..') !== -1) return { valid: false, message: 'Enter a valid email address.' };
          var domain = trimmed.split('@')[1] || '';
          var tld = domain.split('.').pop();
          if (!tld || tld.length < 2) return { valid: false, message: 'Enter a valid email address.' };
          var suggestion = getEmailSuggestion(trimmed);
          if (suggestion && suggestion !== trimmed) return { valid: false, message: 'Did you mean ' + suggestion + '?', suggestion: suggestion };
          return { valid: true, email: trimmed };
        }

        function ensureFeedbackNode(input) {
          var next = input.nextElementSibling;
          if (next && next.classList && next.classList.contains('email-feedback')) return next;
          var node = document.createElement('p');
          node.className = 'email-feedback text-xs font-body mt-2';
          input.insertAdjacentElement('afterend', node);
          return node;
        }

        function setFeedback(input, state) {
          if (!input) return state;
          var node = ensureFeedbackNode(input);
          if (state.valid) {
            node.textContent = '';
            node.className = 'email-feedback text-xs font-body mt-2';
            input.setCustomValidity('');
          } else {
            node.textContent = state.message || 'Enter a valid email address.';
            node.className = 'email-feedback text-xs font-body mt-2 text-amber-400';
            input.setCustomValidity(state.message || 'Enter a valid email address.');
          }
          return state;
        }

        function protectEmailInput(input) {
          if (!input || input._emailGuardInit) return;
          input._emailGuardInit = true;
          function runValidation() {
            var value = String(input.value || '').trim();
            if (!value) {
              input.setCustomValidity('');
              var node = input.nextElementSibling;
              if (node && node.classList && node.classList.contains('email-feedback')) node.textContent = '';
              return { valid: true };
            }
            return setFeedback(input, validateEmail(value));
          }
          input.addEventListener('blur', runValidation);
          input.addEventListener('input', function () {
            input.setCustomValidity('');
            var node = input.nextElementSibling;
            if (node && node.classList && node.classList.contains('email-feedback')) node.textContent = '';
          });
        }

        window.JonerEmailGuard = { validateEmail: validateEmail, setFeedback: setFeedback, protectEmailInput: protectEmailInput };

        function getRecaptchaToken(action) {
          var meta = document.querySelector('meta[name="recaptcha-site-key"]');
          var siteKey = meta && meta.getAttribute('content');
          if (!siteKey || !window.grecaptcha || !window.grecaptcha.execute) return Promise.resolve('');
          return new Promise(function (resolve) {
            window.grecaptcha.ready(function () {
              window.grecaptcha.execute(siteKey, { action: action || 'submit' }).then(resolve).catch(function () { resolve(''); });
            });
          });
        }

        window.JonerRecaptcha = { getToken: getRecaptchaToken };

        function initBrevoForms() {
          document.querySelectorAll('[data-brevo-form] input[type="email"], [data-brevo-form] input[name="email"]').forEach(protectEmailInput);
          document.querySelectorAll('[data-brevo-form]').forEach(function (form) {
            if (form._brevoInit || form.hasAttribute('data-brevo-custom')) return;
            form._brevoInit = true;
            form.addEventListener('submit', function (e) {
              e.preventDefault();
              var btn = form.querySelector('button[type="submit"]');
              var originalText = btn ? btn.textContent : 'Submit';
              var formData = new FormData(form);
              var emailInput = form.querySelector('input[name="email"], input[type="email"]');
              var rawEmail = formData.get('email') || '';
              var validation = validateEmail(rawEmail);
              var firstName = formData.get('first_name') || formData.get('firstName') || formData.get('parent_name') || formData.get('name') || '';
              var listId = Number(formData.get('listId') || formData.get('list_id') || form.getAttribute('data-list-id') || '2');
              var source = form.getAttribute('data-form-name') || formData.get('source') || 'website-form';

              if (emailInput) setFeedback(emailInput, validation);
              if (!validation.valid) {
                if (emailInput && typeof emailInput.reportValidity === 'function') emailInput.reportValidity();
                return;
              }

              if (btn) {
                btn.disabled = true;
                btn.textContent = 'Sending...';
                btn.classList.add('opacity-70', 'cursor-not-allowed');
              }

              getRecaptchaToken('subscribe').then(function (recaptchaToken) {
                return fetch('/api/subscribe', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ email: validation.email, firstName: firstName, listId: listId, source: source, recaptchaToken: recaptchaToken })
                });
              })
              .then(function (r) { return r.json(); })
              .then(function (data) {
                if (data && data.success) {
                  if (window.JonerTracking && typeof window.JonerTracking.trackEvent === 'function') {
                    var capiEventName = form.getAttribute('data-capi-event') || (String(source).indexOf('coach') !== -1 ? 'Lead' : 'Lead');
                    window.JonerTracking.trackEvent(capiEventName, {
                      user_data: { email: validation.email },
                      custom_data: {
                        form_name: source,
                        list_id: listId,
                        lead_type: String(source).indexOf('coach') !== -1 ? 'coaches_lead' : 'website_lead'
                      }
                    });
                  }
                  form.innerHTML = '<p style="color:#4ade80;font-size:14px;padding:8px 0;">Done. Welcome to the team.</p>';
                } else {
                  throw new Error((data && data.error) || 'Something went wrong');
                }
              })
              .catch(function (err) {
                if (emailInput && err && err.message) setFeedback(emailInput, { valid: false, message: err.message });
                if (btn) {
                  btn.disabled = false;
                  btn.textContent = originalText;
                  btn.classList.remove('opacity-70', 'cursor-not-allowed');
                }
              });
            });
          });
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initBrevoForms);
        else initBrevoForms();
      })();
    </script>
  </body>
</html>
