---
import '../styles/global.css'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import Analytics from '../components/Analytics.astro'

export interface Props {
  title?: string
  description?: string
  canonical?: string
  ogImage?: string
  ogType?: 'website' | 'article'
  keywords?: string
  noindex?: boolean
  schema?: object | object[]
  hideChrome?: boolean
  hideMobileAppCta?: boolean
}

const {
  title = 'Joner Football',
  description = 'Elite football training, global camps, and the #1 football coaching app. Train with 2.1 million footballers worldwide.',
  canonical,
  ogImage = 'https://jonerfootball.com/images/og-default.jpg',
  ogType = 'website',
  keywords,
  noindex = false,
  schema,
  hideChrome = false,
  hideMobileAppCta = false,
} = Astro.props

const siteUrl = 'https://jonerfootball.com'
const path = Astro.url.pathname
const canonicalPath = path === '/' ? '/' : path.endsWith('/') ? path : `${path}/`
const canonicalURL = canonical || `${siteUrl}${canonicalPath}`
const mobileStickyAllowedPath = Astro.url.pathname.startsWith('/app') || Astro.url.pathname.startsWith('/camps')
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY || ''

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Joner Football",
  "url": siteUrl,
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${siteUrl}/blog/?q={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
}

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteUrl}/#organization`,
  "name": "Joner Football",
  "alternateName": [
    "Coach Joner",
    "Joner Football App",
    "JF APP",
    "football training app",
    "soccer training app",
    "football drills app"
  ],
  "url": siteUrl,
  "logo": "https://jonerfootball.com/images/logo.png",
  "description": "Joner Football is a technical football coaching brand founded by Lee Jones in Sydney, Australia. It helps players, parents and coaches improve technique through training, camps and the Joner Football App.",
  "founder": {
    "@type": "Person",
    "@id": `${siteUrl}/about/#lee-jones`,
    "name": "Lee Jones",
    "alternateName": ["Coach Joner", "Lee Joner Jones"],
    "jobTitle": "Founder and Head Coach"
  },
  "knowsAbout": [
    "technical football training",
    "soccer coaching",
    "youth soccer coaching",
    "football training app",
    "soccer training app",
    "football drills app",
    "football training app for kids",
    "football training app for coaches",
    "ball mastery",
    "first touch",
    "striking technique",
    "1v1 football training",
    "football camps",
    "coach education"
  ],
  "areaServed": ["Sydney", "Australia", "United States", "Worldwide"],
  "sameAs": [
    "https://www.instagram.com/jonerfootball/",
    "https://www.instagram.com/leejonerjones",
    "https://www.youtube.com/@jonerfootball",
    "https://www.facebook.com/Jonerfootball/",
    "https://www.tiktok.com/@jonerfootball",
    "https://apps.apple.com/au/app/joner-football-app/id6737069275",
    "https://play.google.com/store/apps/details?id=tv.uscreen.jonerfootball"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+61-404-780-351",
    "contactType": "customer service",
    "email": "leejones@jonerfootball.com"
  }
}

const baseSchemas = [orgSchema, websiteSchema]
const allSchemas = schema
  ? Array.isArray(schema) ? [...baseSchemas, ...schema] : [...baseSchemas, schema]
  : baseSchemas
---

<!DOCTYPE html>
<html lang="en" prefix="og: http://ogp.me/ns#">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <meta name="application-name" content="Joner Football" />
    <meta name="apple-mobile-web-app-title" content="Joner Football" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260526-original-logo-v2" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png?v=20260526-original-logo-v2" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png?v=20260526-original-logo-v2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=20260526-original-logo-v2" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png?v=20260526-original-logo-v2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=20260526-original-logo-v2" />
    <link rel="manifest" href="/site.webmanifest?v=20260526-original-logo-v2" />
    <meta name="theme-color" content="#000000" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta name="msapplication-TileImage" content="/mstile-150x150.png?v=20260526-original-logo-v2" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=20260526-original-logo-v2" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="text/plain" title="Joner Football AI / LLM reference" href="/llms.txt" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Joner Football" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content="@jonerfootball" />

    <!-- Google Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Schema.org JSON-LD -->
    {allSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <slot name="head" />
    {recaptchaSiteKey && (
      <style is:inline>
        .grecaptcha-badge {
          visibility: hidden !important;
        }
      </style>
    )}

    <!-- LEE: Paste your GA4 Measurement ID into Vercel env var PUBLIC_GA4_ID (starts with G-) -->
    <Analytics />

    <!-- Meta Pixel -->
    <script>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '232666285545279');
      fbq('track', 'PageView');
    </script>
    <noscript>
      <img height="1" width="1" style="display:none" alt="" aria-hidden="true"
        src="https://www.facebook.com/tr?id=232666285545279&ev=PageView&noscript=1"/>
    </noscript>

    <!-- ManyChat widget -->
    <script src="https://widget.manychat.com/1628774_7b942.js" defer="defer"></script>
    <script src="https://mccdn.me/assets/js/widget.js" defer="defer"></script>

    <!-- Brevo JS Tracker -->
    <script src="https://cdn.brevo.com/js/sdk-loader.js" async></script>
    <script is:inline>
      window.Brevo = window.Brevo || [];
      window.Brevo.push([
        'init',
        {
          client_key: 'y128oimodw93f1ayr0z0w6tr',
        },
      ]);
    </script>

    {recaptchaSiteKey && (
      <script src={`https://www.google.com/recaptcha/api.js?render=${recaptchaSiteKey}`} async defer></script>
    )}
    {recaptchaSiteKey && <meta name="recaptcha-site-key" content={recaptchaSiteKey} />}
  </head>
  <body class="bg-joner-black text-white" data-home={(Astro.url.pathname === '/' || Astro.url.pathname === '') ? '' : undefined}>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:bg-red-600 focus:text-white focus:px-4 focus:py-2 focus:z-50 focus:rounded">
      Skip to content
    </a>
    {!hideChrome && <Nav />}
    <main id="main-content">
      <slot />
    </main>
    {!hideChrome && <Footer />}

    <script is:inline src="/tracking-attribution.js"></script>
    <script is:inline>
      (function () {
        var TRACKING_PARAM_PREFIXES = ['utm_'];
        var TRACKING_PARAM_KEYS = ['fbclid', 'gclid', 'ttclid', 'msclkid'];
        var STORAGE_KEY = 'joner_tracking_params';
        var META_TEST_EVENT_STORAGE_KEY = 'joner_meta_test_event_code';

        function isTrackingParam(key) {
          if (TRACKING_PARAM_KEYS.indexOf(key) !== -1) return true;
          for (var i = 0; i < TRACKING_PARAM_PREFIXES.length; i++) {
            if (key.indexOf(TRACKING_PARAM_PREFIXES[i]) === 0) return true;
          }
          return false;
        }

        function collectTrackingParams() {
          var params = new URLSearchParams(window.location.search || '');
          var trackingParams = new URLSearchParams();
          params.forEach(function (value, key) {
            if (value && isTrackingParam(key)) trackingParams.set(key, value);
          });
          if (trackingParams.toString()) {
            try { window.sessionStorage.setItem(STORAGE_KEY, trackingParams.toString()); } catch (e) {}
            return trackingParams;
          }
          try {
            var stored = window.sessionStorage.getItem(STORAGE_KEY);
            if (stored) return new URLSearchParams(stored);
          } catch (e) {}
          return new URLSearchParams();
        }

        function paramsToObject(params) {
          var obj = {};
          if (!params) return obj;
          params.forEach(function (value, key) { obj[key] = value; });
          return obj;
        }

        function collectMetaTestEventCode() {
          var params = new URLSearchParams(window.location.search || '');
          var code = params.get('meta_test_event_code') || params.get('test_event_code') || '';
          if (code) {
            try { window.sessionStorage.setItem(META_TEST_EVENT_STORAGE_KEY, code); } catch (e) {}
            return code;
          }
          try { return window.sessionStorage.getItem(META_TEST_EVENT_STORAGE_KEY) || ''; } catch (e) {}
          return '';
        }

        function getPathname() {
          var path = window.location.pathname || '/';
          return path.replace(/\/+$/, '') || '/';
        }

        function getViewContentForPath() {
          var path = getPathname();
          var pageMap = {
            '/app': 'Joner Football App',
            '/app/for-coaches': 'Joner Football App For Coaches',
            '/programmes': 'Joner Football Programmes',
            '/teams': 'Joner Football Teams',
            '/join': 'Joner Football Join'
          };
          if (!pageMap[path]) return null;
          return {
            content_name: pageMap[path],
            content_type: 'landing_page',
            page_path: path
          };
        }

        function getCheckoutOfferId(anchor) {
          try { return new URL(anchor.href, window.location.href).searchParams.get('o') || ''; }
          catch (e) { return ''; }
        }

        function getPlanType(anchor) {
          if (!anchor) return '';
          if (anchor.dataset && anchor.dataset.metaPlanType) return anchor.dataset.metaPlanType;
          var offerId = getCheckoutOfferId(anchor);
          if (offerId === '183092') return 'annual';
          if (offerId === '183083') return 'monthly';
          var text = (anchor.textContent || '').toLowerCase();
          if (text.indexOf('annual') !== -1 || text.indexOf('year') !== -1) return 'annual';
          if (text.indexOf('monthly') !== -1 || text.indexOf('month') !== -1) return 'monthly';
          return '';
        }

        function buildCheckoutCustomData(anchor) {
          var offerId = getCheckoutOfferId(anchor);
          var planType = getPlanType(anchor);
          var data = {
            destination_url: anchor.href,
            content_name: anchor.textContent ? anchor.textContent.trim().slice(0, 120) : 'checkout-link',
            content_type: 'checkout_link'
          };
          if (offerId) data.offer_id = offerId;
          if (planType) data.plan_type = planType;
          return data;
        }

        function trackStandardCheckoutEvents(anchor) {
          var checkoutData = buildCheckoutCustomData(anchor);
          var planType = checkoutData.plan_type || '';
          if (planType === 'annual' || planType === 'monthly') {
            trackEvent('AddToCart', {
              custom_data: Object.assign({}, checkoutData, {
                content_name: planType === 'annual' ? 'Annual plan button' : 'Monthly plan button'
              })
            });
          }
          trackEvent('InitiateCheckout', { custom_data: checkoutData });
        }

        function trackLandingPageViewContent() {
          var viewContentData = getViewContentForPath();
          if (!viewContentData) return;
          trackEvent('ViewContent', { custom_data: viewContentData });
        }

        function appendTrackingParams(href, trackingParams) {
          if (!href || !trackingParams || !trackingParams.toString()) return href;
          try {
            var url = new URL(href, window.location.href);
            trackingParams.forEach(function (value, key) {
              if (value && !url.searchParams.has(key)) url.searchParams.set(key, value);
            });
            return url.toString();
          } catch (e) {
            return href;
          }
        }

        function appendUscreenTrackingParams(href, trackingParams) {
          var decoratedHref = appendTrackingParams(href, trackingParams);
          if (!window.JonerAttribution || typeof window.JonerAttribution.encodeForUscreen !== 'function') {
            return decoratedHref;
          }
          try {
            var url = new URL(decoratedHref, window.location.href);
            var encoded = window.JonerAttribution.encodeForUscreen(url.searchParams);
            var encodedSource = encoded.get('utm_source');
            if (encodedSource) url.searchParams.set('utm_source', encodedSource);
            return url.toString();
          } catch (e) {
            return decoratedHref;
          }
        }

        function isAppOutboundLink(anchor) {
          if (!anchor || !anchor.href) return false;
          try { return new URL(anchor.href, window.location.href).hostname === 'app.jonerfootball.com'; }
          catch (e) { return false; }
        }

        function getCookie(name) {
          var match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
          return match ? decodeURIComponent(match[2]) : '';
        }

        function isJonerDomain() {
          return /(^|\.)jonerfootball\.com$/.test(window.location.hostname || '');
        }

        function setSharedCookie(name, value) {
          if (!value || !isJonerDomain()) return;
          var maxAgeSeconds = 90 * 24 * 60 * 60;
          var secure = window.location.protocol === 'https:' ? '; Secure' : '';
          document.cookie = name + '=' + value + '; domain=.jonerfootball.com; path=/; max-age=' + maxAgeSeconds + '; SameSite=Lax' + secure;
        }

        // Share the Meta click-id (_fbc) and browser-id (_fbp) across .jonerfootball.com so the Uscreen
        // checkout on app.jonerfootball.com reports Purchase/Subscribe/CompleteRegistration WITH the click-id.
        function ensureSharedMetaCookies() {
          if (!isJonerDomain()) return;
          var fbclid = new URLSearchParams(window.location.search || '').get('fbclid');
          var existingFbc = getCookie('_fbc');
          if (fbclid && !existingFbc) {
            setSharedCookie('_fbc', 'fb.1.' + Date.now() + '.' + fbclid);
          } else if (existingFbc) {
            setSharedCookie('_fbc', existingFbc);
          }
          var fbp = getCookie('_fbp');
          if (fbp) setSharedCookie('_fbp', fbp);
        }

        function getEventId(eventName) {
          if (window.crypto && typeof window.crypto.randomUUID === 'function') return eventName + '.' + window.crypto.randomUUID();
          return eventName + '.' + Date.now() + '.' + Math.random().toString(16).slice(2);
        }

        function getGa4ConversionAliases(eventName) {
          var aliasMap = {
            Lead: ['generate_lead'],
            CompleteRegistration: ['sign_up'],
            InitiateCheckout: ['begin_checkout'],
            AddToCart: ['add_to_cart'],
            Purchase: ['purchase'],
            app_checkout_click: ['begin_checkout'],
            camp_form_submit: ['generate_lead'],
            club_pricing_click: ['generate_lead'],
            free_section_click: ['select_content'],
            lead_magnet_click: ['generate_lead'],
            team_subscription_interest: ['generate_lead']
          };
          return aliasMap[eventName] || [];
        }

        function trackGa4Event(eventName, customData, eventId) {
          if (typeof window.gtag !== 'function') return;
          try {
            window.gtag('event', eventName, Object.assign({
              event_id: eventId || getEventId(eventName),
              page_path: window.location.pathname || '/',
              transport_type: 'beacon'
            }, customData || {}));
          } catch (e) {}
        }

        function trackEvent(eventName, options) {
          options = options || {};
          var eventId = options.event_id || getEventId(eventName);
          var trackingParams = collectTrackingParams();
          var customData = Object.assign({}, paramsToObject(trackingParams), options.custom_data || {});
          var userData = Object.assign({
            fbp: getCookie('_fbp'),
            fbc: getCookie('_fbc')
          }, options.user_data || {});

          if (typeof window.fbq === 'function') {
            if (eventName === 'Lead' || eventName === 'Purchase' || eventName === 'CompleteRegistration' || eventName === 'AddToCart' || eventName === 'InitiateCheckout' || eventName === 'ViewContent') {
              window.fbq('track', eventName, customData, { eventID: eventId });
            } else {
              window.fbq('trackCustom', eventName, customData, { eventID: eventId });
            }
          }

          if (typeof window.gtag === 'function') {
            trackGa4Event(eventName, customData, eventId);
            getGa4ConversionAliases(eventName).forEach(function (aliasName) {
              if (aliasName === eventName) return;
              trackGa4Event(aliasName, Object.assign({}, customData, {
                source_event_name: eventName
              }), eventId + '.' + aliasName);
            });
          }

          try {
            var body = JSON.stringify({
              event_name: eventName,
              event_id: eventId,
              event_source_url: window.location.href,
              test_event_code: collectMetaTestEventCode(),
              user_data: userData,
              custom_data: customData
            });
            if (navigator.sendBeacon) {
              var blob = new Blob([body], { type: 'application/json' });
              navigator.sendBeacon('/api/track-event', blob);
            } else {
              fetch('/api/track-event', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: body,
                keepalive: true
              }).catch(function () {});
            }
          } catch (e) {}

          return eventId;
        }

        function getCheckoutEventName(anchor) {
          if (anchor && anchor.dataset && anchor.dataset.metaCheckoutEvent) return anchor.dataset.metaCheckoutEvent;
          var path = window.location.pathname || '';
          var href = anchor && anchor.href ? anchor.href : '';
          if (path.indexOf('/workshops/coaches-course') === 0 || path.indexOf('/app/for-coaches') === 0 || href.indexOf('o=202578') !== -1) return 'CoachesPageClickToCheckout';
          return 'WebsiteClickToCheckout';
        }

        function getDeepScrollEventName() {
          var path = window.location.pathname || '';
          if (path.indexOf('/workshops/coaches-course') === 0 || path.indexOf('/app/for-coaches') === 0) return 'CoachesPageDeepScroll';
          return 'WebsiteDeepScroll';
        }

        function getMoneyClickEventName(anchor) {
          if (!anchor || !anchor.href) return '';
          if (anchor.dataset && anchor.dataset.gaEvent) return anchor.dataset.gaEvent;
          var path = getPathname();
          var text = (anchor.textContent || '').trim().toLowerCase();
          var href = anchor.href || '';
          var host = '';
          try { host = new URL(href, window.location.href).hostname; } catch (e) {}

          if (host === 'apps.apple.com') return 'app_store_click';
          if (host === 'play.google.com') return 'google_play_click';
          if (href.indexOf('app.jonerfootball.com/categories/category-vpi8uazway4') !== -1) return 'free_section_click';
          if (href.indexOf('/free-bundle') !== -1 || text.indexOf('free videos') !== -1 || text.indexOf('lead magnet') !== -1) return 'lead_magnet_click';
          if (href.indexOf('#register') !== -1 || text.indexOf('book your spot') !== -1 || text.indexOf('book now') !== -1 || text.indexOf('camp') !== -1 && text.indexOf('sign') !== -1) return 'camp_signup_click';
          if (path === '/join') {
            if (href.indexOf('/teams/#team-subscription-form') !== -1 || text.indexOf('club') !== -1 || text.indexOf('team') !== -1) return 'club_pricing_click';
            if (text.indexOf('starter') !== -1 || href.indexOf('o=183083') !== -1 || href.indexOf('o=230697') !== -1) return 'join_starter_click';
            if (text.indexOf('plus') !== -1 || href.indexOf('o=230699') !== -1 || href.indexOf('o=183092') !== -1) return 'join_plus_click';
            if (text.indexOf('max') !== -1 || href.indexOf('o=230698') !== -1 || href.indexOf('o=202578') !== -1) return 'join_max_click';
          }
          if (path === '/teams' && text.indexOf('club pricing') !== -1) return 'club_pricing_click';
          if (href.indexOf('app.jonerfootball.com/checkout/new') !== -1) return 'app_checkout_click';
          return '';
        }

        function trackMoneyClick(anchor) {
          var eventName = getMoneyClickEventName(anchor);
          if (!eventName) return;
          trackEvent(eventName, {
            custom_data: {
              link_url: anchor.href,
              link_text: (anchor.textContent || '').trim().slice(0, 120),
              page_path: getPathname()
            }
          });
        }

        function initFormIntentTracking() {
          document.querySelectorAll('form').forEach(function (form) {
            var path = getPathname();
            var id = form.id || '';
            var isCampForm = path.indexOf('/camps/') === 0 || id === 'houForm' || id === 'camp-registration-form';
            if (isCampForm) {
              var started = false;
              form.addEventListener('focusin', function () {
                if (started) return;
                started = true;
                trackEvent('camp_form_start', { custom_data: { form_id: id || 'camp-form', page_path: path } });
              }, true);
              form.addEventListener('submit', function () {
                trackEvent('camp_form_submit', { custom_data: { form_id: id || 'camp-form', page_path: path } });
              }, true);
            }

          });
        }

        function initTracking() {
          window.JonerTracking = {
            collectTrackingParams: collectTrackingParams,
            appendTrackingParams: appendTrackingParams,
            trackGa4Event: trackGa4Event,
            trackEvent: trackEvent
          };

          trackLandingPageViewContent();

          // Share _fbc/_fbp to .jonerfootball.com now, and again once Meta's async pixel has set _fbp.
          ensureSharedMetaCookies();
          window.setTimeout(ensureSharedMetaCookies, 2000);

          var trackingParams = collectTrackingParams();

          function decorateAppOutboundLinks(params) {
            document.querySelectorAll('a[href]').forEach(function (anchor) {
              if (!isAppOutboundLink(anchor)) return;
              anchor.href = appendUscreenTrackingParams(anchor.href, params);
            });
          }

          decorateAppOutboundLinks(trackingParams);
          window.addEventListener('load', function () {
            decorateAppOutboundLinks(collectTrackingParams());
          }, { once: true });

          document.addEventListener('click', function (event) {
            var anchor = event.target && event.target.closest ? event.target.closest('a[href]') : null;
            if (!anchor) return;
            trackMoneyClick(anchor);
            if (!isAppOutboundLink(anchor)) return;
            // Guarantee the shared click-id/browser-id cookies exist at the moment we hand off to Uscreen.
            ensureSharedMetaCookies();
            anchor.href = appendUscreenTrackingParams(anchor.href, collectTrackingParams());
            if (anchor.href.indexOf('/checkout/new') !== -1) {
              trackStandardCheckoutEvents(anchor);
              trackEvent(getCheckoutEventName(anchor), {
                custom_data: buildCheckoutCustomData(anchor)
              });
            }
          }, true);

          initFormIntentTracking();

          var deepScrollTracked = false;
          function trackDeepScroll() {
            if (deepScrollTracked) return;
            var doc = document.documentElement;
            var scrollable = Math.max(doc.scrollHeight, document.body.scrollHeight) - window.innerHeight;
            if (scrollable <= 0) return;
            var percent = (window.scrollY || window.pageYOffset || 0) / scrollable;
            if (percent >= 0.75) {
              deepScrollTracked = true;
              trackEvent(getDeepScrollEventName(), { custom_data: { scroll_percent: 75 } });
              window.removeEventListener('scroll', trackDeepScroll);
            }
          }
          window.addEventListener('scroll', trackDeepScroll, { passive: true });
          trackDeepScroll();
        }

        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initTracking);
        else initTracking();
      })();
    </script>

    {mobileStickyAllowedPath && !hideChrome && !hideMobileAppCta && (
      <div
        id="mobile-sticky-app-cta"
        class="fixed bottom-0 left-0 right-0 z-50 md:hidden bg-joner-black border-t border-gray-800 p-3 opacity-0 translate-y-full pointer-events-none transition-all duration-300 ease-out"
        aria-hidden="true"
      >
        <a href="/app" class="btn-red w-full text-center block text-sm">
          Download the App
        </a>
      </div>
    )}

    {mobileStickyAllowedPath && !hideChrome && !hideMobileAppCta && (
      <script is:inline>
        {`
          (function () {
            var stickyCta = document.getElementById('mobile-sticky-app-cta');
            if (!stickyCta) return;

            function updateStickyCta() {
              var hasScrolled = (window.scrollY || window.pageYOffset || 0) > 24;
              stickyCta.classList.toggle('opacity-0', !hasScrolled);
              stickyCta.classList.toggle('translate-y-full', !hasScrolled);
              stickyCta.classList.toggle('pointer-events-none', !hasScrolled);
              stickyCta.setAttribute('aria-hidden', hasScrolled ? 'false' : 'true');
            }

            window.addEventListener('scroll', updateStickyCta, { passive: true });
            window.addEventListener('resize', updateStickyCta);
            updateStickyCta();
          })();
        `}
      </script>
    )}

    <script is:inline>
      (function () {
        var COMMON_DOMAINS = [
          'gmail.com', 'hotmail.com', 'outlook.com', 'icloud.com', 'yahoo.com', 'live.com',
          'bigpond.com', 'me.com', 'mac.com', 'aol.com', 'yahoo.com.au', 'hotmail.com.au', 'outlook.com.au'
        ];

        function levenshtein(a, b) {
          var matrix = [];
          for (var i = 0; i <= b.length; i++) matrix[i] = [i];
          for (var j = 0; j <= a.length; j++) matrix[0][j] = j;
          for (var i2 = 1; i2 <= b.length; i2++) {
            for (var j2 = 1; j2 <= a.length; j2++) {
              if (b.charAt(i2 - 1) === a.charAt(j2 - 1)) matrix[i2][j2] = matrix[i2 - 1][j2 - 1];
              else matrix[i2][j2] = Math.min(matrix[i2 - 1][j2 - 1] + 1, matrix[i2][j2 - 1] + 1, matrix[i2 - 1][j2] + 1);
            }
          }
          return matrix[b.length][a.length];
        }

        function getEmailSuggestion(email) {
          var trimmed = String(email || '').trim().toLowerCase();
          if (!trimmed || trimmed.indexOf('@') === -1) return null;
          var parts = trimmed.split('@');
          if (parts.length !== 2) return null;
          var local = parts[0];
          var domain = parts[1];
          if (!local || !domain) return null;

          var exactFixes = {
            'gmal.com': 'gmail.com', 'gmial.com': 'gmail.com', 'gmai.com': 'gmail.com', 'gmail.con': 'gmail.com', 'gmail,com': 'gmail.com', 'gnail.com': 'gmail.com',
            'hotmial.com': 'hotmail.com', 'hotmal.com': 'hotmail.com', 'hotmail.con': 'hotmail.com',
            'outlok.com': 'outlook.com', 'outloo.com': 'outlook.com', 'outlook.con': 'outlook.com',
            'iclod.com': 'icloud.com', 'icloud.con': 'icloud.com',
            'yaho.com': 'yahoo.com', 'yahoo.con': 'yahoo.com',
            'bigpond.con': 'bigpond.com', 'live.con': 'live.com'
          };

          if (exactFixes[domain]) return local + '@' + exactFixes[domain];

          for (var i = 0; i < COMMON_DOMAINS.length; i++) {
            if (levenshtein(domain, COMMON_DOMAINS[i]) <= 2) return local + '@' + COMMON_DOMAINS[i];
          }
          return null;
        }

        var DISPOSABLE_DOMAINS = {
          '10minutemail.com': true, '10minutemail.net': true, '20minutemail.com': true, 'anonaddy.com': true,
          'burnermail.io': true, 'dispostable.com': true, 'emailondeck.com': true, 'fakeinbox.com': true,
          'getnada.com': true, 'guerrillamail.com': true, 'guerrillamail.net': true, 'guerrillamail.org': true,
          'maildrop.cc': true, 'mailinator.com': true, 'mailinator.net': true, 'mailnesia.com': true,
          'moakt.com': true, 'sharklasers.com': true, 'temp-mail.org': true, 'tempmail.com': true,
          'tempmail.net': true, 'throwawaymail.com': true, 'trashmail.com': true, 'yopmail.com': true
        };

        function validateEmail(email) {
          var trimmed = String(email || '').trim().toLowerCase();
          var basicPattern = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
          if (!trimmed) return { valid: false, message: 'Email is required.' };
          if (!basicPattern.test(trimmed)) return { valid: false, message: 'Enter a valid email address.' };
          if (trimmed.indexOf('..') !== -1) return { valid: false, message: 'Enter a valid email address.' };
          var parts = trimmed.split('@');
          var local = parts[0] || '';
          var domain = parts[1] || '';
          var tld = domain.split('.').pop();
          if (!local || !domain || local.length > 64 || domain.length > 253) return { valid: false, message: 'Enter a valid email address.' };
          if (local.charAt(0) === '.' || local.charAt(local.length - 1) === '.') return { valid: false, message: 'Enter a valid email address.' };
          if (!tld || tld.length < 2) return { valid: false, message: 'Enter a valid email address.' };
          if (DISPOSABLE_DOMAINS[domain]) return { valid: false, message: 'Please use your real email address, not a temporary email.' };
          var suggestion = getEmailSuggestion(trimmed);
          if (suggestion && suggestion !== trimmed) return { valid: false, message: 'Did you mean ' + suggestion + '?', suggestion: suggestion };
          return { valid: true, email: trimmed };
        }

        function ensureFeedbackNode(input) {
          var next = input.nextElementSibling;
          if (next && next.classList && next.classList.contains('email-feedback')) return next;
          var node = document.createElement('p');
          node.className = 'email-feedback text-xs font-body mt-2';
          input.insertAdjacentElement('afterend', node);
          return node;
        }

        function setFeedback(input, state) {
          if (!input) return state;
          var node = ensureFeedbackNode(input);
          if (state.valid) {
            node.textContent = '';
            node.className = 'email-feedback text-xs font-body mt-2';
            input.setCustomValidity('');
          } else {
            node.textContent = state.message || 'Enter a valid email address.';
            node.className = 'email-feedback text-xs font-body mt-2 text-amber-400';
            input.setCustomValidity(state.message || 'Enter a valid email address.');
          }
          return state;
        }

        function protectEmailInput(input) {
          if (!input || input._emailGuardInit) return;
          input._emailGuardInit = true;
          function runValidation() {
            var value = String(input.value || '').trim();
            if (!value) {
              input.setCustomValidity('');
              var node = input.nextElementSibling;
              if (node && node.classList && node.classList.contains('email-feedback')) node.textContent = '';
              return { valid: true };
            }
            return setFeedback(input, validateEmail(value));
          }
          input.addEventListener('blur', runValidation);
          input.addEventListener('input', function () {
            input.setCustomValidity('');
            var node = input.nextElementSibling;
            if (node && node.classList && node.classList.contains('email-feedback')) node.textContent = '';
          });
        }

        window.JonerEmailGuard = { validateEmail: validateEmail, setFeedback: setFeedback, protectEmailInput: protectEmailInput };

        function getRecaptchaToken(action) {
          var meta = document.querySelector('meta[name="recaptcha-site-key"]');
          var siteKey = meta && meta.getAttribute('content');
          if (!siteKey || !window.grecaptcha || !window.grecaptcha.execute) return Promise.resolve('');
          return new Promise(function (resolve) {
            window.grecaptcha.ready(function () {
              window.grecaptcha.execute(siteKey, { action: action || 'submit' }).then(resolve).catch(function () { resolve(''); });
            });
          });
        }

        window.JonerRecaptcha = { getToken: getRecaptchaToken };

        function initBrevoForms() {
          document.querySelectorAll('[data-brevo-form] input[type="email"], [data-brevo-form] input[name="email"]').forEach(protectEmailInput);
          document.querySelectorAll('[data-brevo-form]').forEach(function (form) {
            if (form._brevoInit || form.hasAttribute('data-brevo-custom')) return;
            form._brevoInit = true;
            form.addEventListener('submit', function (e) {
              e.preventDefault();
              var btn = form.querySelector('button[type="submit"]');
              var originalText = btn ? btn.textContent : 'Submit';
              var formData = new FormData(form);
              var emailInput = form.querySelector('input[name="email"], input[type="email"]');
              var rawEmail = formData.get('email') || '';
              var validation = validateEmail(rawEmail);
              var firstName = formData.get('first_name') || formData.get('firstName') || formData.get('parent_name') || formData.get('name') || '';
              var listId = Number(formData.get('listId') || formData.get('list_id') || form.getAttribute('data-list-id') || '2');
              var listIds = formData.get('listIds') || formData.get('list_ids') || form.getAttribute('data-list-ids') || String(listId);
              var source = form.getAttribute('data-form-name') || formData.get('source') || 'website-form';

              if (emailInput) setFeedback(emailInput, validation);
              if (!validation.valid) {
                if (emailInput && typeof emailInput.reportValidity === 'function') emailInput.reportValidity();
                return;
              }

              if (btn) {
                btn.disabled = true;
                btn.textContent = 'Sending...';
                btn.classList.add('opacity-70', 'cursor-not-allowed');
              }

              getRecaptchaToken('subscribe').then(function (recaptchaToken) {
                var payload = { email: validation.email, firstName: firstName, listId: listId, listIds: listIds, source: source, recaptchaToken: recaptchaToken };
                formData.forEach(function (value, key) {
                  if (!(value instanceof File) && payload[key] === undefined) payload[key] = value;
                });
                return fetch('/api/subscribe', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify(payload)
                });
              })
              .then(function (r) { return r.json(); })
              .then(function (data) {
                if (data && data.success) {
                  if (window.JonerTracking && typeof window.JonerTracking.trackEvent === 'function') {
                    var capiEventName = form.getAttribute('data-capi-event') || (String(source).indexOf('coach') !== -1 ? 'Lead' : 'Lead');
                    window.JonerTracking.trackEvent(capiEventName, {
                      user_data: { email: validation.email },
                      custom_data: {
                        form_name: source,
                        list_id: listId,
                        lead_type: String(source).indexOf('coach') !== -1 ? 'coaches_lead' : 'website_lead'
                      }
                    });
                  }
                  form.innerHTML = '<p style="color:#4ade80;font-size:14px;padding:8px 0;">Done. Welcome to the team.</p>';
                } else {
                  throw new Error((data && data.error) || 'Something went wrong');
                }
              })
              .catch(function (err) {
                if (emailInput && err && err.message) setFeedback(emailInput, { valid: false, message: err.message });
                if (btn) {
                  btn.disabled = false;
                  btn.textContent = originalText;
                  btn.classList.remove('opacity-70', 'cursor-not-allowed');
                }
              });
            });
          });
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initBrevoForms);
        else initBrevoForms();
      })();
    </script>
  </body>
</html>
