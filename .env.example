# Stripe digital download webhook
STRIPE_DOWNLOAD_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# Stripe camp checkout and payment webhook
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx
STRIPE_CAMP_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# Vercel KV / Upstash Redis REST storage for private download tokens
KV_REST_API_URL=https://example.upstash.io
KV_REST_API_TOKEN=xxxxxxxxxxxxxxxxxxxxx

# Brevo transactional email
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=leejones@jonerfootball.com

# Airtable player waiver form
AIRTABLE_API_TOKEN=patxxxxxxxxxxxxxxxxxxxxx
AIRTABLE_BASE_ID=appxxxxxxxxxxxxxx
AIRTABLE_WAIVER_TABLE=Player Onboarding & Waiver

# School holiday bookings (/holiday-bookings, /holiday-admin)
# Parents enter this one shared password. Change it to log everyone out.
HOLIDAY_BOOKING_PASSWORD=
# Signs the parent access cookie. `openssl rand -hex 32`
HOLIDAY_SIGNING_SECRET=
# Lee's admin page secret. Long and random.
HOLIDAY_ADMIN_SECRET=
# Stripe Sydney account -> Developers -> Webhooks -> endpoint
# https://jonerfootball.com/api/holiday-payment-webhook
# (events: checkout.session.completed, checkout.session.expired)
STRIPE_HOLIDAY_WEBHOOK_SECRET_SYDNEY=
# Optional. Overrides STRIPE_SECRET_KEY_SYDNEY, e.g. a test key for a dry run.
STRIPE_HOLIDAY_SECRET_KEY=
# Optional. Roster sheet id; defaults to the camp registration sheet.
HOLIDAY_SHEET_ID=
# Optional. Where new-booking alerts go; defaults to CAMP_SIGNUP_EMAIL.
HOLIDAY_ADMIN_EMAIL=
